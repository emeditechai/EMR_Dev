<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!-- IPD screens (SQLScripts/2422+): their Razor views compile into this assembly, not EMR.Web.dll, which is at the .NET
       limit for string literals (CS8103). EMR.Web references this project; the views keep their /Views/... paths, so the
       controllers in EMR.Web find them as before, and publishing EMR.Web carries EMR.Web.Ipd.dll along. -->
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
    <RootNamespace>EMR.Web.Ipd</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>
