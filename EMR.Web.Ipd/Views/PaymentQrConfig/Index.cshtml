@{
    // Settings > Payment QR Configuration (SQLScripts/2452)
    ViewData["Title"] = "Payment QR Configuration";
    bool Can(string c) => ViewData["Can" + c] as bool? ?? false;
}
@Html.AntiForgeryToken()
<style>
    .pq-card { background:#fff; border:1px solid #e2e8f0; border-radius:12px; }
    .pq-qr { width:190px; height:190px; border:1px solid #e2e8f0; border-radius:10px; display:flex; align-items:center; justify-content:center; background:#fff; margin:0 auto; }
    .pq-qr img { width:180px; height:180px; image-rendering:pixelated; }
    .pq-link { font-family:ui-monospace,Menlo,monospace; font-size:.72rem; word-break:break-all; background:#f8fafc; border-radius:8px; padding:.4rem .5rem; }
</style>
<div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-3">
    <div>
        <h1 class="h3 fw-bold mb-0"><i class="bi bi-qr-code me-2 text-primary"></i>Payment QR Configuration</h1>
        <small class="text-muted">The UPI QR of each branch, printed on documents so the payer can scan and pay with any UPI app.
            B2B tax invoices show it when Hospital Settings &gt; OPD &gt; <b>Show QR on B2B Invoice</b> is Yes.</small>
    </div>
</div>

<div class="pq-card"><div class="table-responsive"><table class="table table-hover align-middle mb-0">
    <thead class="table-light"><tr><th>Branch</th><th>UPI ID</th><th>Payee name</th><th>Amount on QR</th><th>QR</th><th>On B2B invoice</th><th>Last changed</th><th class="text-end"></th></tr></thead>
    <tbody id="pqRows"><tr><td colspan="8" class="text-center text-muted py-4">Loading…</td></tr></tbody>
</table></div></div>

<div class="modal fade" id="pqModal" tabindex="-1" aria-labelledby="pqTitle" aria-hidden="true" data-bs-backdrop="static"><div class="modal-dialog modal-lg modal-dialog-centered"><div class="modal-content">
    <div class="modal-header"><h5 class="modal-title fw-bold" id="pqTitle">Payment QR</h5><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div>
    <form id="pqForm" novalidate autocomplete="off"><div class="modal-body"><div class="row g-3">
        <div class="col-md-7"><div class="row g-3">
            <input type="hidden" id="pqBranch" />
            <div class="col-12"><label class="form-label fw-semibold" for="pqUpi">UPI ID <span class="text-danger">*</span></label>
                <input id="pqUpi" class="form-control" maxlength="100" placeholder="e.g. clinicname@okhdfcbank" />
                <div class="invalid-feedback">Enter a valid UPI ID (name@bank, e.g. 9876543210@ybl).</div>
                <div class="form-text">The business UPI ID the money should reach (from your bank or UPI app).</div></div>
            <div class="col-12"><label class="form-label fw-semibold" for="pqPayee">Payee name <span class="text-danger">*</span></label>
                <input id="pqPayee" class="form-control" maxlength="60" /><div class="invalid-feedback">Enter the account holder name (2-60, no &amp; = ? # %).</div>
                <div class="form-text">Shown to the payer in the UPI app; use the name the UPI ID is registered to.</div></div>
            <div class="col-md-5"><label class="form-label fw-semibold" for="pqMcc">Merchant category code</label>
                <input id="pqMcc" class="form-control" maxlength="4" inputmode="numeric" placeholder="optional, e.g. 8071" /><div class="invalid-feedback">4 digits, or empty.</div></div>
            <div class="col-md-7"><label class="form-label fw-semibold d-block">Amount on the QR</label>
                <div class="btn-group btn-group-sm w-100" role="group">
                    <input type="radio" class="btn-check" name="pqMode" id="pqModeDue" value="DUE" checked><label class="btn btn-outline-primary" for="pqModeDue">Amount due (fixed)</label>
                    <input type="radio" class="btn-check" name="pqMode" id="pqModeOpen" value="OPEN"><label class="btn btn-outline-primary" for="pqModeOpen">Payer enters amount</label>
                </div></div>
            <div class="col-12"><div class="form-check form-switch"><input class="form-check-input" type="checkbox" id="pqRef" checked>
                <label class="form-check-label" for="pqRef">Put the invoice no in the UPI payment note (helps match the payment)</label></div></div>
            <div class="col-12"><label class="form-label fw-semibold" for="pqCaption">Caption under the QR</label>
                <input id="pqCaption" class="form-control" maxlength="120" placeholder="e.g. Scan with any UPI app to pay this invoice" /></div>
            <div class="col-12"><div class="form-check form-switch"><input class="form-check-input" type="checkbox" id="pqActive" checked>
                <label class="form-check-label" for="pqActive">QR in use for this branch</label></div></div>
        </div></div>
        <div class="col-md-5 text-center">
            <div class="small fw-semibold text-muted mb-2">Preview (sample invoice of ₹1,250.00)</div>
            <div class="pq-qr" id="pqImg"><span class="text-muted small">Enter UPI ID and payee</span></div>
            <div class="small mt-2" id="pqCap"></div>
            <div class="pq-link mt-2 text-start" id="pqLink"></div>
            <div class="small text-muted mt-2">Test it: scan with a UPI app and check the payee name shown - do not pay.</div>
        </div>
    </div></div>
    <div class="modal-footer"><button type="button" class="btn btn-light border" data-bs-dismiss="modal">Close</button>
        <button type="submit" class="btn btn-primary" id="pqSave"><i class="bi bi-check2 me-1"></i>Save</button></div></form>
</div></div></div>

@section Scripts {
    <script src="~/js/ipd.js" asp-append-version="true"></script>
    <script>window.PqPage = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(new { @base = Url.Content("~/PaymentQrConfig/"), hs = Url.Action("Edit", "HospitalSettings"), canEdit = Can("EDIT"), canStatus = Can("STATUS") }));</script>
    <script src="~/js/settings/payment-qr.js" asp-append-version="true"></script>
}
