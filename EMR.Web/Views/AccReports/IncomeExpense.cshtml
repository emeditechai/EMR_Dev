@model EMR.Web.Models.ViewModels.AccReportViewModel
@using EMR.Web.Models.ViewModels
@{
    ViewData["Title"] = Model.Title;
    ViewData["AccIcon"] = "bi-graph-up-arrow";
    // movement of the period: income is credit-side, expense is debit-side
    var income = Model.Trial.Where(x => x.GroupType == "Income").Select(x => (Row: x, Amount: x.PeriodCredit - x.PeriodDebit)).Where(x => x.Amount != 0).ToList();
    var expense = Model.Trial.Where(x => x.GroupType == "Expense").Select(x => (Row: x, Amount: x.PeriodDebit - x.PeriodCredit)).Where(x => x.Amount != 0).ToList();
    var totalIncome = income.Sum(x => x.Amount);
    var totalExpense = expense.Sum(x => x.Amount);
    var surplus = totalIncome - totalExpense;
}

<div class="container-fluid px-4 py-3 acc-rpt">
    <div class="mb-3 acc-noprint"><partial name="_AccHeader" /></div>
    <partial name="_AccAlerts" />
    <partial name="_Filter" model="Model" />

    <div class="row g-3 mb-3">
        <div class="col-md-4"><div class="card border-0 shadow-sm"><div class="card-body py-3"><div class="text-muted small text-uppercase fw-semibold">Income</div><div class="fs-4 fw-bold font-monospace text-success">₹@totalIncome.ToString("N2")</div></div></div></div>
        <div class="col-md-4"><div class="card border-0 shadow-sm"><div class="card-body py-3"><div class="text-muted small text-uppercase fw-semibold">Expense</div><div class="fs-4 fw-bold font-monospace text-danger">₹@totalExpense.ToString("N2")</div></div></div></div>
        <div class="col-md-4"><div class="card border-0 shadow-sm"><div class="card-body py-3"><div class="text-muted small text-uppercase fw-semibold">@(surplus >= 0 ? "Surplus" : "Deficit")</div><div class="fs-4 fw-bold font-monospace @(surplus >= 0 ? "text-primary" : "text-danger")">₹@Math.Abs(surplus).ToString("N2")</div></div></div></div>
    </div>

    <div class="row g-3">
        @foreach (var side in new[] { (Title: "Income", Rows: income, Total: totalIncome), (Title: "Expense", Rows: expense, Total: totalExpense) })
        {
            <div class="col-lg-6">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-header bg-white py-2 fw-bold">@side.Title</div>
                    <table class="table table-sm table-hover align-middle mb-0">
                        <tbody>
                            @if (side.Rows.Count == 0)
                            {
                                <tr><td class="text-center py-4 text-muted" colspan="2">Nothing in this period.</td></tr>
                            }
                            @foreach (var g in side.Rows.GroupBy(x => x.Row.GroupName))
                            {
                                <tr class="acc-group"><td class="ps-3">@g.Key</td><td class="num pe-3">@g.Sum(x => x.Amount).ToString("N2")</td></tr>
                                foreach (var x in g)
                                {
                                    <tr>
                                        <td class="ps-4"><a asp-action="LedgerStatement" asp-route-ledgerId="@x.Row.LedgerId" asp-route-fromDate="@Model.FromDate.ToString("yyyy-MM-dd")" asp-route-toDate="@Model.ToDate.ToString("yyyy-MM-dd")" asp-route-branchId="@Model.BranchId">@x.Row.LedgerName</a></td>
                                        <td class="num pe-3">@x.Amount.ToString("N2")</td>
                                    </tr>
                                }
                            }
                        </tbody>
                        <tfoot><tr><td class="ps-3">Total @side.Title</td><td class="num pe-3">@side.Total.ToString("N2")</td></tr></tfoot>
                    </table>
                </div>
            </div>
        }
    </div>
</div>
