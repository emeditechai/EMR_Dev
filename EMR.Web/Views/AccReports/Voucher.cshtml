@model List<EMR.Web.Models.ViewModels.AccDayBookRow>
@{
    var h = Model[0];
    ViewData["Title"] = "Voucher " + h.VoucherNo;
    ViewData["AccIcon"] = "bi-journal-text";
    // where the entry came from, in plain words
    var source = h.ReferenceType switch
    {
        "PETTY_EXP" => "Petty expense", "PETTY_FLOAT" => "Petty cash float", "PETTY_CLOSE" => "Petty cash closing", "MANUAL_VCH" => "Manual voucher",
        "LAB_BILL" => "Lab bill", "OPD_BILL" => "OPD bill", null or "" => null, var x => x.Replace('_', ' ')
    };
}

<div class="container-fluid px-4 py-3 acc-rpt">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div><partial name="_AccHeader" /></div>
        <div class="d-flex gap-2 acc-noprint">
            @if (h.ReferenceType == "PETTY_EXP" && h.ReferenceId.HasValue) { <a asp-controller="PettyExpense" asp-action="Details" asp-encrypted-id="@h.ReferenceId" asp-permission="UTILITY.ACCOUNTS.PETTYEXPENSE" class="btn btn-outline-primary"><i class="bi bi-receipt me-1"></i>Open Petty Expense</a> }
            @if (h.ReferenceType == "MANUAL_VCH" && h.ReferenceId.HasValue) { <a asp-controller="AccVouchers" asp-action="Details" asp-encrypted-id="@h.ReferenceId" asp-permission="UTILITY.ACCOUNTS.VOUCHERS" class="btn btn-outline-primary"><i class="bi bi-journal-plus me-1"></i>Open Voucher</a> }
            <button type="button" class="btn btn-outline-secondary" onclick="history.back()"><i class="bi bi-arrow-left me-1"></i>Back</button>
        </div>
    </div>

    <div class="card border-0 shadow-sm" style="max-width:900px;">
        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
            <div><span class="font-monospace fw-bold fs-5">@h.VoucherNo</span> <span class="badge bg-primary-subtle text-primary-emphasis border border-primary-subtle ms-2">@h.VoucherTypeName</span></div>
            <div>
                @if (h.IsReversal) { <span class="badge bg-secondary">Reversal entry</span> }
                else if (h.Status == "C") { <span class="badge bg-secondary">Cancelled (reversed)</span> }
                else { <span class="badge bg-success">Posted</span> }
            </div>
        </div>
        <div class="card-body">
            <div class="row g-3 mb-3 small">
                <div class="col-md-3"><div class="text-muted">Date</div><div class="fw-semibold">@h.TransactionDate.ToString("dd-MMM-yyyy HH:mm")</div></div>
                <div class="col-md-3"><div class="text-muted">Branch</div><div class="fw-semibold">@(h.BranchName ?? "-")</div></div>
                <div class="col-md-3"><div class="text-muted">Source</div><div class="fw-semibold">@(source ?? "-") @(h.ReferenceId.HasValue ? "#" + h.ReferenceId : "")</div></div>
                <div class="col-md-3"><div class="text-muted">Entered By</div><div class="fw-semibold">@(h.EnteredBy ?? "System")</div></div>
                @if (!string.IsNullOrEmpty(h.PayeeName)) { <div class="col-md-3"><div class="text-muted">Party</div><div class="fw-semibold">@h.PayeeName</div></div> }
                @if (!string.IsNullOrEmpty(h.PaymentMode)) { <div class="col-md-3"><div class="text-muted">Mode</div><div class="fw-semibold">@h.PaymentMode @h.InstrumentNo</div></div> }
                <div class="col-12"><div class="text-muted">Narration</div><div>@h.VoucherNarration</div></div>
            </div>
            <table class="table table-sm align-middle mb-0">
                <thead><tr><th>Ledger</th><th class="num">Debit</th><th class="num">Credit</th></tr></thead>
                <tbody>
                    @foreach (var l in Model)
                    {
                        <tr><td class="@(l.CreditAmount > 0 ? "ps-4" : "fw-semibold")">@l.LedgerName</td><td class="num">@(l.DebitAmount != 0 ? l.DebitAmount.ToString("N2") : "")</td><td class="num">@(l.CreditAmount != 0 ? l.CreditAmount.ToString("N2") : "")</td></tr>
                    }
                </tbody>
                <tfoot><tr><td>Total</td><td class="num">@Model.Sum(l => l.DebitAmount).ToString("N2")</td><td class="num">@Model.Sum(l => l.CreditAmount).ToString("N2")</td></tr></tfoot>
            </table>
        </div>
    </div>
</div>
<style>.acc-rpt .num { text-align: right; font-variant-numeric: tabular-nums; }</style>
