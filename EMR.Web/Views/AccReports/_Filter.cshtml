@model EMR.Web.Models.ViewModels.AccReportViewModel
@* Filter bar of every Accounts report: period, branch (head office only), and the ledger / voucher type where the report has one.
   Excel and PDF export repeat the same filters. Print uses the browser (the bar and the menu are hidden on paper). *@
@{
    var action = Model.Report is "CashBook" or "BankBook" or "PettyCashBook" ? "LedgerStatement" : Model.Report == "VoucherRegister" ? "DayBook" : Model.Report;
    var isBook = action == "LedgerStatement";
    var export = new Dictionary<string, string?>
    {
        ["report"] = action, ["book"] = isBook ? Model.Report : null, ["ledgerId"] = Model.LedgerId?.ToString(), ["fromDate"] = Model.FromDate.ToString("yyyy-MM-dd"),
        ["toDate"] = Model.ToDate.ToString("yyyy-MM-dd"), ["branchId"] = Model.BranchId?.ToString(), ["voucherTypeId"] = Model.VoucherTypeId?.ToString(),
        ["manualOnly"] = Model.Report == "VoucherRegister" ? "true" : null
    };
    var pdf = new Dictionary<string, string?>(export) { ["format"] = "pdf" };
}
<style>
    .acc-rpt .num { text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }
    .acc-rpt thead th { background: #f8fafc; font-size: .72rem; text-transform: uppercase; letter-spacing: .4px; color: #64748b; white-space: nowrap; }
    .acc-rpt tbody td { font-size: .85rem; }
    .acc-rpt tfoot td, .acc-rpt tr.acc-total td { font-weight: 700; background: #f8fafc; }
    .acc-rpt tr.acc-group td { background: #eef2ff; font-weight: 700; font-size: .8rem; }
    .acc-print-head { display: none; }
    @@media print {
        nav, .navbar, footer, .acc-noprint, .breadcrumb { display: none !important; }
        .acc-print-head { display: block; text-align: center; margin-bottom: 8px; }
        .card { box-shadow: none !important; border: 0 !important; }
        .container-fluid { padding: 0 !important; }
        .acc-rpt tbody td, .acc-rpt thead th { font-size: 10.5px; padding: 3px 5px; }
        a { color: inherit !important; text-decoration: none !important; }
    }
</style>

<div class="acc-print-head">
    <div style="font-size:16px;font-weight:700;">@User.GetCompanyName()</div>
    <div style="font-size:13px;font-weight:700;">@Model.Title@(Model.Statement is null ? "" : " - " + Model.Statement.LedgerName)</div>
    <div style="font-size:11px;">@Model.FromDate.ToString("dd-MMM-yyyy") to @Model.ToDate.ToString("dd-MMM-yyyy") | @Model.BranchName</div>
</div>

<div class="card border-0 shadow-sm mb-3 acc-noprint">
    <div class="card-body p-3">
        <form method="get" asp-action="@action" class="row g-3 align-items-end">
            @if (isBook) { <input type="hidden" name="book" value="@Model.Report" /> }
            @if (Model.Report == "VoucherRegister") { <input type="hidden" name="manualOnly" value="true" /> }
            @if (isBook)
            {
                <div class="col-md-3">
                    <label class="form-label small fw-semibold text-muted">@(Model.Report == "PettyCashBook" ? "Counter" : "Ledger")</label>
                    <select name="ledgerId" class="form-select" required>
                        @if (Model.Report == "LedgerStatement") { <option value="">-- Select ledger --</option> }
                        @foreach (var l in Model.Ledgers)
                        {
                            <option value="@l.Id" selected="@(Model.LedgerId == l.Id)">@l.Name</option>
                        }
                    </select>
                </div>
            }
            <div class="col-md-2"><label class="form-label small fw-semibold text-muted">From</label><input type="date" name="fromDate" class="form-control" value="@Model.FromDate.ToString("yyyy-MM-dd")" /></div>
            <div class="col-md-2"><label class="form-label small fw-semibold text-muted">To</label><input type="date" name="toDate" class="form-control" value="@Model.ToDate.ToString("yyyy-MM-dd")" /></div>
            @if (Model.CanPickBranch)
            {
                <div class="col-md-2">
                    <label class="form-label small fw-semibold text-muted">Branch</label>
                    <select name="branchId" class="form-select">
                        <option value="">All branches</option>
                        @foreach (var b in Model.Branches)
                        {
                            <option value="@b.Id" selected="@(Model.BranchId == b.Id)">@b.Name</option>
                        }
                    </select>
                </div>
            }
            @if (action == "DayBook")
            {
                <div class="col-md-2">
                    <label class="form-label small fw-semibold text-muted">Voucher Type</label>
                    <select name="voucherTypeId" class="form-select">
                        <option value="">All types</option>
                        @foreach (var t in Model.VoucherTypes)
                        {
                            <option value="@t.Id" selected="@(Model.VoucherTypeId == t.Id)">@t.Name</option>
                        }
                    </select>
                </div>
            }
            <div class="col-md-auto d-flex gap-2 ms-auto">
                <button type="submit" class="btn btn-secondary fw-semibold"><i class="bi bi-funnel me-1"></i>Show</button>
                <a asp-permission="REPORTS.ACCOUNTS:EXPORT" asp-action="Export" asp-all-route-data="export" class="btn btn-outline-success"><i class="bi bi-file-earmark-excel me-1"></i>Excel</a>
                <a asp-permission="REPORTS.ACCOUNTS:EXPORT" asp-action="Export" asp-all-route-data="pdf" class="btn btn-outline-danger"><i class="bi bi-file-earmark-pdf me-1"></i>PDF</a>
                <button type="button" class="btn btn-outline-secondary" onclick="window.print()"><i class="bi bi-printer me-1"></i>Print</button>
                <a asp-action="Index" class="btn btn-outline-secondary" title="All accounts reports"><i class="bi bi-grid"></i></a>
            </div>
        </form>
    </div>
</div>
