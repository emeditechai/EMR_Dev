@model EMR.Web.Models.ViewModels.AccVoucherIndexViewModel
@using EMR.Web.Models.ViewModels
@using EMR.Web.Controllers
@{
    ViewData["Title"] = "Voucher Entry";
    ViewData["AccIcon"] = "bi-journal-plus";
    ViewData["AccSubtitle"] = "Payment, Receipt, Contra and Journal vouchers for what the system does not post on its own.";
    const string Page = "UTILITY.ACCOUNTS.VOUCHERS";
}

<div class="container-fluid px-4 py-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div><partial name="_AccHeader" /></div>
        <div class="btn-group shadow-sm" asp-permission="@(Page + ":CREATE")">
            <a asp-action="Create" asp-route-type="PMT" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>New Voucher</a>
            <button type="button" class="btn btn-primary dropdown-toggle dropdown-toggle-split" data-bs-toggle="dropdown" aria-expanded="false"></button>
            <ul class="dropdown-menu dropdown-menu-end">
                @foreach (var t in AccVouchersController.Types)
                {
                    <li><a class="dropdown-item" asp-action="Create" asp-route-type="@t.Code">@t.Name</a></li>
                }
            </ul>
        </div>
    </div>
    <partial name="_AccAlerts" />

    <div class="card border-0 shadow-sm mb-3">
        <div class="card-body p-3">
            <form method="get" asp-action="Index" class="row g-3 align-items-end">
                <div class="col-md-2"><label class="form-label small fw-semibold text-muted">From</label><input type="date" name="fromDate" class="form-control" value="@Model.FromDate.ToString("yyyy-MM-dd")" /></div>
                <div class="col-md-2"><label class="form-label small fw-semibold text-muted">To</label><input type="date" name="toDate" class="form-control" value="@Model.ToDate.ToString("yyyy-MM-dd")" /></div>
                <div class="col-md-2">
                    <label class="form-label small fw-semibold text-muted">Type</label>
                    <select name="typeCode" class="form-select">
                        <option value="">All types</option>
                        @foreach (var t in AccVouchersController.Types)
                        {
                            <option value="@t.Code" selected="@(Model.TypeCode == t.Code)">@t.Name</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label small fw-semibold text-muted">Status</label>
                    <select name="status" class="form-select">
                        <option value="">All</option>
                        @foreach (var s in new[] { AccStatus.Submitted, AccStatus.Approved, AccStatus.Rejected, AccStatus.Cancelled })
                        {
                            <option value="@s" selected="@(Model.Status == s)">@(s == AccStatus.Approved ? "Posted" : AccStatus.Name(s))</option>
                        }
                    </select>
                </div>
                @if (Model.CanPickBranch)
                {
                    <div class="col-md-2">
                        <label class="form-label small fw-semibold text-muted">Branch</label>
                        <select name="branchId" class="form-select">
                            <option value="">All branches</option>
                            @foreach (var b in Model.Branches)
                            {
                                <option value="@b.Id" selected="@(Model.BranchId == b.Id)">@b.Name</option>
                            }
                        </select>
                    </div>
                }
                <div class="col-md"><label class="form-label small fw-semibold text-muted">Search</label><input type="text" name="search" class="form-control" value="@Model.Search" placeholder="Voucher, payee, narration..." /></div>
                <div class="col-md-auto d-flex gap-2">
                    <button type="submit" class="btn btn-secondary fw-semibold"><i class="bi bi-funnel me-1"></i>Filter</button>
                    <a asp-action="Index" class="btn btn-outline-secondary" title="Reset"><i class="bi bi-arrow-counterclockwise"></i></a>
                </div>
            </form>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light border-bottom">
                    <tr><th class="ps-4">Date</th><th>Voucher No.</th><th>Type</th><th>Branch</th><th>Payee / Narration</th><th class="text-end">Amount</th><th class="text-center">Status</th><th>Entered By</th><th class="text-end pe-4">Actions</th></tr>
                </thead>
                <tbody>
                    @if (Model.Vouchers.Count == 0)
                    {
                        <tr><td colspan="9" class="text-center py-5 text-muted"><i class="bi bi-inbox display-6 d-block mb-2 text-secondary"></i>No vouchers for this period.</td></tr>
                    }
                    @foreach (var v in Model.Vouchers)
                    {
                        <tr>
                            <td class="ps-4">@v.VoucherDate.ToString("dd-MMM-yyyy")</td>
                            <td class="font-monospace small fw-semibold">@v.DisplayNo</td>
                            <td><span class="badge bg-primary-subtle text-primary-emphasis border border-primary-subtle">@v.VoucherTypeName</span></td>
                            <td>@v.BranchName</td>
                            <td><div class="fw-semibold">@v.PayeeName</div><div class="small text-muted text-truncate" style="max-width:320px;" title="@v.Narration">@v.Narration</div></td>
                            <td class="text-end font-monospace fw-semibold">₹@v.TotalAmount.ToString("N2")</td>
                            <td class="text-center"><span class="badge @AccStatus.Badge(v.Status) rounded-pill px-3">@(v.Status == AccStatus.Approved ? "Posted" : AccStatus.Name(v.Status))</span></td>
                            <td class="small">@v.CreatedByName</td>
                            <td class="text-end pe-4">
                                <div class="btn-group btn-group-sm shadow-sm">
                                    <a asp-action="Details" asp-encrypted-id="@v.VoucherId" class="btn btn-outline-info" title="View"><i class="bi bi-eye"></i></a>
                                    <a asp-permission="@(Page + ":PRINT")" asp-action="Print" asp-encrypted-id="@v.VoucherId" target="_blank" class="btn btn-outline-secondary" title="Print"><i class="bi bi-printer"></i></a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
