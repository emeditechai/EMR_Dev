@model EMR.Web.Models.ViewModels.AccVoucherPrintViewModel
@{
    Layout = null;
    var hasCredit = Model.Lines.Any(l => l.CreditAmount > 0);
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@Model.Title @Model.VoucherNo</title>
    <style>
        @@page { size: A5 landscape; margin: 8mm; }
        * { box-sizing: border-box; }
        body { font-family: Arial, Helvetica, sans-serif; font-size: 12px; color: #111; margin: 0; padding: 12px; }
        .sheet { max-width: 190mm; margin: 0 auto; border: 1px solid #333; padding: 10px 14px; }
        h1 { font-size: 17px; margin: 0; text-align: center; }
        .sub { text-align: center; font-size: 11px; color: #444; }
        .title { text-align: center; font-weight: bold; letter-spacing: 1px; text-transform: uppercase; border-top: 1px solid #333; border-bottom: 1px solid #333; padding: 4px 0; margin: 8px 0; }
        .meta { display: flex; justify-content: space-between; gap: 12px; margin-bottom: 6px; }
        .meta div { line-height: 1.6; }
        table { width: 100%; border-collapse: collapse; margin-top: 4px; }
        th, td { border: 1px solid #333; padding: 4px 6px; vertical-align: top; }
        th { background: #eee; text-align: left; font-size: 11px; }
        .num { text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }
        .words { margin-top: 6px; }
        .sign { display: flex; justify-content: space-between; margin-top: 34px; text-align: center; }
        .sign div { width: 30%; border-top: 1px solid #333; padding-top: 3px; font-size: 11px; }
        .stamp { color: #b91c1c; border: 2px solid #b91c1c; display: inline-block; padding: 1px 8px; font-weight: bold; text-transform: uppercase; transform: rotate(-4deg); }
        .bar { text-align: center; margin: 10px 0; }
        .bar button { padding: 6px 18px; font-size: 13px; cursor: pointer; }
        @@media print { .bar { display: none; } body { padding: 0; } }
    </style>
</head>
<body>
    <div class="bar"><button onclick="window.print()">Print</button> <button onclick="window.close()">Close</button></div>
    <div class="sheet">
        <h1>@Model.CompanyName</h1>
        <div class="sub">@Model.BranchName</div>
        <div class="title">@Model.Title</div>
        <div class="meta">
            <div>
                <strong>Voucher No.:</strong> @Model.VoucherNo<br />
                @if (!string.IsNullOrEmpty(Model.PayeeName)) { <span><strong>Party:</strong> @Model.PayeeName</span><br /> }
                @if (!string.IsNullOrEmpty(Model.PaymentMode)) { <span><strong>Mode:</strong> @Model.PaymentMode @Model.InstrumentNo</span> }
            </div>
            <div style="text-align:right;">
                <strong>Date:</strong> @Model.VoucherDate.ToString("dd-MMM-yyyy")<br />
                @if (Model.StatusName != "Approved") { <span class="stamp">@Model.StatusName</span> }
            </div>
        </div>
        <table>
            <thead>
                <tr><th>Particulars</th>@if (hasCredit) { <th class="num" style="width:95px;">Debit (₹)</th><th class="num" style="width:95px;">Credit (₹)</th> } else { <th class="num" style="width:110px;">Amount (₹)</th> }</tr>
            </thead>
            <tbody>
                @foreach (var l in Model.Lines)
                {
                    <tr>
                        <td>@l.LedgerName @if (!string.IsNullOrEmpty(l.Narration)) { <span style="color:#555;"> - @l.Narration</span> }</td>
                        <td class="num">@(l.DebitAmount > 0 ? l.DebitAmount.ToString("N2") : "")</td>
                        @if (hasCredit) { <td class="num">@(l.CreditAmount > 0 ? l.CreditAmount.ToString("N2") : "")</td> }
                    </tr>
                }
                <tr>
                    <td style="text-align:right;"><strong>Total</strong></td>
                    <td class="num"><strong>@Model.TotalAmount.ToString("N2")</strong></td>
                    @if (hasCredit) { <td class="num"><strong>@Model.TotalAmount.ToString("N2")</strong></td> }
                </tr>
            </tbody>
        </table>
        <div class="words"><strong>Amount in words:</strong> @Model.AmountInWords</div>
        @if (!string.IsNullOrEmpty(Model.Narration)) { <div class="words"><strong>Narration:</strong> @Model.Narration</div> }
        <div class="sign">
            <div>Prepared by<br />@Model.PreparedBy</div>
            <div>Approved by<br />@Model.ApprovedBy</div>
            <div>Receiver's signature</div>
        </div>
    </div>
</body>
</html>
