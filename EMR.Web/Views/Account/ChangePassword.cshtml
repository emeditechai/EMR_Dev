@model EMR.Web.Models.ViewModels.ChangePasswordViewModel
@{
    ViewData["Title"] = "Change Password";
}

<div class="d-flex align-items-center mb-4">
    <i class="bi bi-key-fill fs-4 me-2" style="color:var(--emr-primary)"></i>
    <h1 class="h3 mb-0">Change Password</h1>
</div>

<div class="row">
    <div class="col-12 col-md-8 col-lg-5">
        <div class="dashboard-panel">
            <p class="text-muted small mb-3">
                @if (Model.PasswordLastChanged.HasValue)
                {
                    <span><i class="bi bi-clock-history me-1"></i>Last changed on @Model.PasswordLastChanged.Value.ToString("dd MMM yyyy").</span>
                }
                else
                {
                    <span><i class="bi bi-info-circle me-1"></i>No password change recorded for this account yet.</span>
                }
            </p>

            <form asp-action="ChangePassword" method="post" novalidate autocomplete="off">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-3"></div>

                <div class="mb-3">
                    <label asp-for="CurrentPassword" class="form-label fw-semibold"></label>
                    <input asp-for="CurrentPassword" class="form-control" autocomplete="current-password" autofocus />
                    <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="NewPassword" class="form-label fw-semibold"></label>
                    <input asp-for="NewPassword" class="form-control" autocomplete="new-password" />
                    <div class="form-text">At least @EMR.Web.Models.ViewModels.ChangePasswordViewModel.MinLength characters, with a letter and a number.</div>
                    <span asp-validation-for="NewPassword" class="text-danger small"></span>
                </div>
                <div class="mb-4">
                    <label asp-for="ConfirmPassword" class="form-label fw-semibold"></label>
                    <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary px-4"><i class="bi bi-check-lg me-1"></i>Change Password</button>
                    <a asp-controller="Dashboard" asp-action="Index" class="btn btn-outline-secondary px-4"><i class="bi bi-x-lg me-1"></i>Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
