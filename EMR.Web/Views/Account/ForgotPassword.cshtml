@model EMR.Web.Models.ViewModels.ForgotPasswordViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Forgot Password";
}

<div class="auth-card auth-login">
    <div class="row g-0 h-100">
        <partial name="_AuthBrandPanel" />

        <div class="col-12 col-lg-6 auth-right">
            <div class="auth-right-inner">
                <partial name="_AuthMobileBrand" />

                <div class="ar-step-ico"><i class="bi bi-key"></i></div>
                <div class="auth-welcome">
                    <h2 class="auth-right-title">Forgot your password?</h2>
                    <p class="auth-right-sub">Enter your user name or the email address on your account. We will email you a link to set a new password.</p>
                </div>

                <form asp-action="ForgotPassword" method="post" novalidate id="forgotForm">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger ar-alert ar-summary"></div>

                    <div class="ar-field">
                        <label asp-for="UserNameOrEmail" class="ar-label"></label>
                        <div class="ar-control">
                            <i class="bi bi-person ar-lead-ico"></i>
                            <input asp-for="UserNameOrEmail" class="form-control ar-input" placeholder="User name or name@example.com" autocomplete="username" autofocus />
                        </div>
                        <span asp-validation-for="UserNameOrEmail" class="ar-error"></span>
                    </div>

                    <button type="submit" class="btn auth-signin-btn w-100 mt-2" id="submitBtn">
                        <i class="bi bi-envelope me-2"></i>Send Reset Link
                    </button>
                </form>

                <div class="ar-back">
                    <a asp-action="Login" class="ar-link-strong"><i class="bi bi-arrow-left me-1"></i>Back to sign in</a>
                </div>

                <div class="ar-secure">
                    <i class="bi bi-shield-lock-fill"></i>
                    <span>The link works once and expires in 30 minutes</span>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <partial name="_AuthFormScripts" />
}
