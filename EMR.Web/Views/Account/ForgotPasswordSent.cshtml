@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Check Your Email";
}

<div class="auth-card auth-login">
    <div class="row g-0 h-100">
        <partial name="_AuthBrandPanel" />

        <div class="col-12 col-lg-6 auth-right">
            <div class="auth-right-inner">
                <partial name="_AuthMobileBrand" />

                <div class="ar-step-ico ar-step-ok"><i class="bi bi-envelope-check"></i></div>
                <div class="auth-welcome">
                    <h2 class="auth-right-title">Check your email</h2>
                    <p class="auth-right-sub">
                        If an account matches <strong class="text-break">@ViewData["Requested"]</strong>, a password reset link
                        has been sent to the email address registered on it.
                    </p>
                </div>

                <ul class="ar-tips">
                    <li><i class="bi bi-clock"></i>The link expires in 30 minutes and works once.</li>
                    <li><i class="bi bi-inbox"></i>Not in your inbox? Check the Spam or Junk folder.</li>
                    <li><i class="bi bi-person-gear"></i>No email on your account? Ask your administrator to reset your password.</li>
                </ul>

                <a asp-action="Login" class="btn auth-signin-btn w-100">
                    <i class="bi bi-box-arrow-in-right me-2"></i>Back to Sign In
                </a>

                <div class="ar-back">
                    Didn't get it? <a asp-action="ForgotPassword" class="ar-link-strong">Send another link</a>
                </div>
            </div>
        </div>
    </div>
</div>
