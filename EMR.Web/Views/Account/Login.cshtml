@model EMR.Web.Models.ViewModels.LoginViewModel
@inject EMR.Web.Services.Licensing.ILicensingService Licensing
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Login";
}

<div class="auth-card auth-login">
    <div class="row g-0 h-100">

        <partial name="_AuthBrandPanel" />

        @* RIGHT PANEL: sign-in form *@
        <div class="col-12 col-lg-6 auth-right">
            <div class="auth-right-inner">

                <partial name="_AuthMobileBrand" />

                <div class="auth-welcome">
                    <h2 class="auth-right-title">Welcome back</h2>
                    <p class="auth-right-sub">Sign in to your eCare360Plus+ account to continue.</p>
                </div>

                @if (TempData["AuthMessage"] is string authMessage)
                {
                    <div class="alert alert-success ar-alert"><i class="bi bi-check-circle-fill"></i><span>@authMessage</span></div>
                }
                @if (TempData["LicenseMessage"] is string licenseMessage)
                {
                    <div class="alert alert-success ar-alert"><i class="bi bi-patch-check-fill"></i><span>@licenseMessage</span></div>
                }

                @* shown here, where the user signs in again - reading it also stops it reappearing on the page after sign-in *@
                @if (TempData["Warning"] is string signInWarning)
                {
                    <div class="alert alert-warning ar-alert"><i class="bi bi-clock-history"></i><span>@signInWarning</span></div>
                }

                <form asp-action="Login" method="post" novalidate id="loginForm" autocomplete="on">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger ar-alert ar-summary"></div>

                    <div class="ar-field">
                        <label asp-for="Email" class="ar-label"></label>
                        <div class="ar-control">
                            <i class="bi bi-envelope ar-lead-ico"></i>
                            <input asp-for="Email" type="email" class="form-control ar-input" placeholder="name@example.com" autocomplete="username" autocorrect="off" spellcheck="false" autofocus />
                        </div>
                        <span asp-validation-for="Email" class="ar-error"></span>
                    </div>

                    <div class="ar-field">
                        <label asp-for="Password" class="ar-label"></label>
                        <div class="ar-control">
                            <i class="bi bi-lock ar-lead-ico"></i>
                            <input asp-for="Password" type="password" id="passwordInput" class="form-control ar-input ar-input-pw" placeholder="Enter your password" autocomplete="current-password" autocorrect="off" autocapitalize="off" spellcheck="false" />
                            <button type="button" class="ar-eye" onclick="togglePassword()" aria-label="Show password" title="Show password" id="eyeBtn">
                                <i class="bi bi-eye" id="eyeIcon"></i>
                            </button>
                        </div>
                        <span asp-validation-for="Password" class="ar-error"></span>
                        <div class="ar-caps" id="capsWarn" hidden><i class="bi bi-capslock-fill"></i> Caps Lock is on</div>
                    </div>

                    <div class="ar-row">
                        <div class="form-check m-0">
                            <input asp-for="RememberMe" class="form-check-input" />
                            <label asp-for="RememberMe" class="form-check-label ar-remember">Remember me</label>
                        </div>
                        <a asp-action="ForgotPassword" class="ar-link-strong">Forgot password?</a>
                    </div>

                    <button type="submit" class="btn auth-signin-btn w-100" id="signInBtn">
                        <span class="ar-btn-text"><i class="bi bi-box-arrow-in-right me-2"></i>Sign In</span>
                    </button>
                </form>

                <div class="ar-secure">
                    <i class="bi bi-shield-lock-fill"></i>
                    <span>Secured &amp; HIPAA-compliant access</span>
                </div>
                <div class="ar-credit">
                    <span class="ar-credit-label">Developed &amp; Powered by</span>
                    <span class="ar-credit-name">EMeditech Plus LLP</span>
                </div>

                @if (Licensing.Enabled)
                {
                    @* checks every licence value with the licence server now (registration / renewal OTP if needed) *@
                    <form asp-controller="License" asp-action="Revalidate" method="post" class="text-center mt-2" id="licRevalidateForm">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-link btn-sm p-0 text-decoration-none ar-link" id="licRevalidateBtn">
                            <i class="bi bi-arrow-repeat me-1"></i>Re-validate licence with the licence server
                        </button>
                    </form>
                }
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // "Remember me": the app keeps the e-mail in this browser (the last one is filled in, up to 5 are offered as you
        // type) and lets the browser's own password manager save the password - encrypted by the browser, never by the app.
        // Not ticked: the e-mail is forgotten and the password is not offered to the password manager.
        // Unticking: the remembered e-mail is forgotten at once and both boxes are cleared.
        (function () {
            const KEY = 'emr.rememberedEmails';
            const email = document.querySelector('#loginForm input[name="Email"]');
            const remember = document.querySelector('#loginForm input[name="RememberMe"][type="checkbox"]');
            const pw = document.getElementById('passwordInput');
            let list = [];
            try {
                list = JSON.parse(localStorage.getItem(KEY) || '[]');
                const old = localStorage.getItem('emr.rememberedEmail');   // earlier single-e-mail key
                if (old && !list.includes(old)) list.unshift(old);
                localStorage.removeItem('emr.rememberedEmail');
            } catch { list = []; }
            if (email) {
                const dl = document.createElement('datalist');
                dl.id = 'rememberedEmails';
                list.forEach(e => { const o = document.createElement('option'); o.value = e; dl.appendChild(o); });
                email.after(dl);
                email.setAttribute('list', dl.id);
                if (list.length && !email.value) { email.value = list[0]; if (remember) remember.checked = true; pw?.focus(); }
            }
            const save = () => { try { localStorage.setItem(KEY, JSON.stringify(list.slice(0, 5))); } catch { } };
            remember?.addEventListener('change', () => {
                if (remember.checked) return;
                const v = email?.value.trim().toLowerCase();
                if (v) { list = list.filter(e => e.toLowerCase() !== v); save(); }
                document.getElementById('rememberedEmails')?.querySelectorAll('option').forEach(o => { if (o.value.toLowerCase() === v) o.remove(); });
                if (email) email.value = '';
                if (pw) pw.value = '';
                email?.focus();
            });
            const form = document.getElementById('loginForm');
            form?.addEventListener('submit', () => {
                const $f = window.jQuery ? jQuery(form) : null;
                if ($f && $f.valid && !$f.valid()) return;
                const v = email?.value.trim().toLowerCase();
                if (v) {
                    list = list.filter(e => e.toLowerCase() !== v);
                    if (remember?.checked) list.unshift(email.value.trim());
                    save();
                }
                // not remembered: post the password from a hidden field and empty the password box, so the browser
                // has no password to offer to save
                if (pw && !remember?.checked) {
                    const h = document.createElement('input');
                    h.type = 'hidden'; h.name = pw.name; h.value = pw.value;
                    form.appendChild(h);
                    pw.removeAttribute('name'); pw.value = '';
                }
            });
        })();

        document.getElementById('licRevalidateForm')?.addEventListener('submit', function () {
            const b = document.getElementById('licRevalidateBtn');
            b.disabled = true;
            b.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Checking with the licence server...';
        });
        function togglePassword() {
            const input = document.getElementById('passwordInput');
            const icon  = document.getElementById('eyeIcon');
            const btn   = document.getElementById('eyeBtn');
            const show  = input.type === 'password';
            input.type = show ? 'text' : 'password';
            icon.classList.replace(show ? 'bi-eye' : 'bi-eye-slash', show ? 'bi-eye-slash' : 'bi-eye');
            btn.setAttribute('aria-label', show ? 'Hide password' : 'Show password');
            btn.title = show ? 'Hide password' : 'Show password';
            input.focus();
        }

        // Caps Lock hint on the password field
        (function () {
            const pw = document.getElementById('passwordInput'), warn = document.getElementById('capsWarn');
            const check = e => { if (e.getModifierState) warn.hidden = !e.getModifierState('CapsLock'); };
            pw.addEventListener('keydown', check);
            pw.addEventListener('keyup', check);
            pw.addEventListener('blur', () => warn.hidden = true);
        })();

        // empty validation summary takes no space; busy state on Sign In once the form is valid
        (function () {
            const sum = document.querySelector('.ar-summary');
            const syncSummary = () => { if (sum) sum.style.display = sum.querySelector('li') && sum.textContent.trim() ? '' : 'none'; };
            syncSummary();
            const form = document.getElementById('loginForm');
            form.addEventListener('submit', function () {
                const $f = window.jQuery ? jQuery(form) : null;
                if ($f && $f.valid && !$f.valid()) return;
                const b = document.getElementById('signInBtn');
                setTimeout(() => { b.disabled = true; b.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Signing in...'; }, 0);
            });
        })();
    </script>
}
