@model EMR.Web.Models.ViewModels.ResetPasswordViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Reset Password";
}

<div class="auth-card auth-login">
    <div class="row g-0 h-100">
        <partial name="_AuthBrandPanel" />

        <div class="col-12 col-lg-6 auth-right">
            <div class="auth-right-inner">
                <partial name="_AuthMobileBrand" />

                <div class="ar-step-ico"><i class="bi bi-shield-lock"></i></div>
                <div class="auth-welcome">
                    <h2 class="auth-right-title">Set a new password</h2>
                    <p class="auth-right-sub">For account <strong>@Model.UserName</strong>. Choose a password you have not used here before.</p>
                </div>

                <form asp-action="ResetPassword" method="post" novalidate id="resetForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Token" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger ar-alert ar-summary"></div>

                    <div class="ar-field">
                        <label asp-for="NewPassword" class="ar-label"></label>
                        <div class="ar-control">
                            <i class="bi bi-lock ar-lead-ico"></i>
                            <input asp-for="NewPassword" class="form-control ar-input ar-input-pw" placeholder="At least 8 characters" autocomplete="new-password" autofocus data-pw />
                            <button type="button" class="ar-eye" data-eye-for="NewPassword" aria-label="Show password" title="Show password"><i class="bi bi-eye"></i></button>
                        </div>
                        <span asp-validation-for="NewPassword" class="ar-error"></span>
                        <div class="ar-caps" hidden><i class="bi bi-capslock-fill"></i> Caps Lock is on</div>
                        <ul class="ar-rules" id="pwRules">
                            <li data-rule="len"><i class="bi bi-circle"></i>At least 8 characters</li>
                            <li data-rule="letter"><i class="bi bi-circle"></i>At least one letter</li>
                            <li data-rule="digit"><i class="bi bi-circle"></i>At least one number</li>
                        </ul>
                    </div>

                    <div class="ar-field">
                        <label asp-for="ConfirmPassword" class="ar-label"></label>
                        <div class="ar-control">
                            <i class="bi bi-lock ar-lead-ico"></i>
                            <input asp-for="ConfirmPassword" class="form-control ar-input ar-input-pw" placeholder="Type the new password again" autocomplete="new-password" data-pw />
                            <button type="button" class="ar-eye" data-eye-for="ConfirmPassword" aria-label="Show password" title="Show password"><i class="bi bi-eye"></i></button>
                        </div>
                        <span asp-validation-for="ConfirmPassword" class="ar-error"></span>
                    </div>

                    <button type="submit" class="btn auth-signin-btn w-100 mt-2" id="submitBtn">
                        <i class="bi bi-check2-circle me-2"></i>Reset Password
                    </button>
                </form>

                <div class="ar-back">
                    <a asp-action="Login" class="ar-link-strong"><i class="bi bi-arrow-left me-1"></i>Back to sign in</a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <partial name="_AuthFormScripts" />
    <script>
        (function () {
            const pw = document.getElementById('NewPassword');
            const rules = { len: v => v.length >= 8, letter: v => /[A-Za-z]/.test(v), digit: v => /\d/.test(v) };
            const paint = () => document.querySelectorAll('#pwRules li').forEach(li => {
                const ok = rules[li.dataset.rule](pw.value);
                li.classList.toggle('ok', ok);
                li.querySelector('i').className = ok ? 'bi bi-check-circle-fill' : 'bi bi-circle';
            });
            pw.addEventListener('input', paint);
            paint();
        })();
    </script>
}
