@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Link Expired";
}

<div class="auth-card auth-login">
    <div class="row g-0 h-100">
        <partial name="_AuthBrandPanel" />

        <div class="col-12 col-lg-6 auth-right">
            <div class="auth-right-inner">
                <partial name="_AuthMobileBrand" />

                <div class="ar-step-ico ar-step-warn"><i class="bi bi-link-45deg"></i></div>
                <div class="auth-welcome">
                    <h2 class="auth-right-title">This link is no longer valid</h2>
                    <p class="auth-right-sub">
                        Password reset links work once and expire after 30 minutes. A newer link also replaces the earlier ones.
                        Ask for a new link to continue.
                    </p>
                </div>

                <a asp-action="ForgotPassword" class="btn auth-signin-btn w-100">
                    <i class="bi bi-envelope me-2"></i>Send a New Link
                </a>

                <div class="ar-back">
                    <a asp-action="Login" class="ar-link-strong"><i class="bi bi-arrow-left me-1"></i>Back to sign in</a>
                </div>
            </div>
        </div>
    </div>
</div>
