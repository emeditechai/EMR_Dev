@model EMR.Web.Models.ViewModels.RoleSelectionViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Select Role";
}

<style>
    /* Select Role: what the picked role lets the user do here (filled from Account/SelectRoleSummaryJson) */
    .role-left .auth-left-title { font-size: 1.85rem; }
    .role-left .auth-medical-cross { width: 72px; height: 72px; }
    .role-left .auth-left-divider { margin: .8rem auto; }
    .role-sum { width: min(370px, 100%); margin: 0 auto; text-align: left; background: rgba(255,255,255,.1);
                border: 1px solid rgba(255,255,255,.2); border-radius: 14px; padding: .8rem .9rem; }
    .role-sum-kicker { font-size: .72rem; letter-spacing: .08em; text-transform: uppercase; color: rgba(255,255,255,.72); font-weight: 600; }
    .role-sum-head { font-size: 1rem; font-weight: 700; margin: .1rem 0 .55rem; line-height: 1.3; }
    .role-sum-head b { color: #ffd6e7; }
    .role-sum-mods { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .35rem; }
    .role-sum-mod { display: flex; align-items: center; gap: .45rem; background: rgba(255,255,255,.1); border-radius: 9px;
                    padding: .32rem .5rem; font-size: .8rem; min-width: 0; cursor: default; }
    .role-sum-mod > i { color: #7de8c8; font-size: .9rem; flex-shrink: 0; }
    .role-sum-mod .m-title { font-weight: 700; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; min-width: 0; flex: 1; }
    .role-sum-mod .m-count { font-size: .72rem; font-weight: 700; color: rgba(255,255,255,.85); font-variant-numeric: tabular-nums; }
    .role-sum-acts { display: flex; flex-wrap: wrap; gap: .3rem; margin-top: .65rem; padding-top: .6rem; border-top: 1px dashed rgba(255,255,255,.22); }
    .role-sum-acts span { font-size: .72rem; font-weight: 600; background: rgba(255,255,255,.14); border: 1px solid rgba(255,255,255,.22);
                          border-radius: 999px; padding: .12rem .55rem; white-space: nowrap; }
    .role-sum-acts span i { margin-right: .25rem; color: #ffd6e7; }
    .role-sum-empty { font-size: .86rem; color: rgba(255,255,255,.78); }
    .role-sum-foot { font-size: .78rem; color: rgba(255,255,255,.7); margin-top: .8rem; text-align: center; }
    .role-sum-mini { font-size: .8rem; color: #475569; background: #f5f3fb; border-radius: 10px; padding: .5rem .7rem; margin: -.5rem 0 1rem; }
    .role-sum-mini b { color: #644098; }
</style>

<div class="auth-card">
    <div class="row g-0 h-100">

        @* LEFT PANEL *@
        <div class="col-lg-6 auth-left role-left d-none d-lg-flex">
            <div class="auth-icon-float" style="top:7%;left:8%"><i class="bi bi-heart-pulse-fill"></i></div>
            <div class="auth-icon-float" style="top:12%;right:10%"><i class="bi bi-capsule"></i></div>
            <div class="auth-icon-float" style="top:38%;left:5%"><i class="bi bi-bandaid-fill"></i></div>
            <div class="auth-icon-float" style="top:62%;right:8%"><i class="bi bi-thermometer-half"></i></div>
            <div class="auth-icon-float" style="bottom:14%;left:12%"><i class="bi bi-lungs-fill"></i></div>
            <div class="auth-icon-float" style="bottom:8%;right:14%"><i class="bi bi-activity"></i></div>

            <div class="auth-left-content">
                <div class="auth-medical-cross">
                    <img src="@(string.IsNullOrWhiteSpace(Model.ProfilePicturePath) ? "/Images/default-avatar.svg" : Model.ProfilePicturePath)"
                         alt="Profile"
                         class="role-left-profile-img"
                         onerror="this.src='/Images/default-avatar.svg'" />
                </div>
                <h1 class="auth-left-title">Hello,<br /><span>@Model.DisplayName</span>!</h1>
                <p class="auth-left-sub">Role Selection</p>
                <hr class="auth-left-divider" />
                @* What the picked role lets the user do in this branch - summarised, filled by the script below *@
                <div class="role-sum" id="roleSummary" aria-live="polite">
                    <div class="role-sum-kicker"><i class="bi bi-building me-1"></i>@Model.BranchName</div>
                    <div class="role-sum-empty mt-1">Pick a role to see what it lets you do here.</div>
                </div>
                <div class="role-sum-foot"><i class="bi bi-arrow-left-right me-1"></i>Switch roles anytime from your profile</div>
            </div>
        </div>

        @* RIGHT PANEL *@
        <div class="col-12 col-lg-6 auth-right">
            <div class="auth-right-inner">

                <div class="role-top-profile">
                    <img src="@(string.IsNullOrWhiteSpace(Model.ProfilePicturePath) ? "/Images/default-avatar.svg" : Model.ProfilePicturePath)"
                         alt="Profile"
                         class="role-top-profile-img"
                         onerror="this.src='/Images/default-avatar.svg'" />
                    <div>
                        <div class="role-top-profile-name">@Model.DisplayName</div>
                        <div class="role-top-profile-branch"><i class="bi bi-building me-1"></i>@Model.BranchName</div>
                    </div>
                </div>

                <div class="auth-logo-badge d-flex d-lg-none">
                    <i class="bi bi-plus-lg"></i>
                </div>

                <div class="auth-welcome">
                    <h2 class="auth-right-title">Select Your Role <i class="bi bi-person-badge"></i></h2>
                    <p class="auth-right-sub"><i class="bi bi-building me-1"></i>@Model.BranchName</p>
                </div>

                <form asp-action="SelectRole" method="post" novalidate id="roleForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="rememberMe" value="@Model.RememberMe.ToString().ToLower()" />
                    <input type="hidden" name="selectedRole" id="selectedRoleInput" value="@Model.LastRoleName" />

                    <div class="role-card-grid mb-4" role="radiogroup" aria-label="Role">
                        @foreach (var role in Model.Roles)
                        {
                            var isLastUsed = string.Equals(role.Name, Model.LastRoleName, StringComparison.OrdinalIgnoreCase);
                            <button type="button" class="role-card@(isLastUsed ? " selected" : "")" role="radio" aria-checked="@(isLastUsed ? "true" : "false")"
                                    title="@role.Name" onclick="selectRole('@role.Name', this)">
                                <span class="role-card-icon-wrap"><i class="bi @role.Icon role-card-icon"></i></span>
                                <span class="role-card-text">
                                    <span class="role-card-name">@role.Name</span>
                                    @if (isLastUsed)
                                    {
                                        <span class="role-card-meta"><i class="bi bi-clock-history me-1"></i>Last used</span>
                                    }
                                </span>
                                <i class="bi bi-check-circle-fill role-card-check"></i>
                            </button>
                        }
                    </div>

                    <div class="role-sum-mini d-lg-none" id="roleSummaryMini" hidden></div>

                    <button type="submit" id="continueBtn" class="btn auth-signin-btn w-100" @(Model.LastRoleName is null ? "disabled" : null)>
                        <i class="bi bi-arrow-right-circle me-2"></i>Continue to Dashboard
                    </button>
                </form>

                <form asp-controller="Account" asp-action="Logout" method="post" class="mt-3 text-center">
                    @Html.AntiForgeryToken()
                    <button class="btn btn-link text-decoration-none auth-back-link" type="submit">
                        <i class="bi bi-box-arrow-left me-1"></i>Back to Login
                    </button>
                </form>

                <p class="auth-footer-note">
                    <i class="bi bi-shield-lock-fill me-1"></i>
                    Secured &amp; HIPAA-compliant access
                </p>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // ---- what the picked role lets the user do in this branch (Account/SelectRoleSummaryJson), cached per role ----
        const summaryUrl = '@Url.Action("SelectRoleSummaryJson", "Account")';
        const branchName = @Json.Serialize(Model.BranchName);
        const summaries = {};
        let summaryFor = null;

        function esc(t) { return String(t ?? '').replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]); }
        function plural(n, word) { return n + ' ' + word + (n === 1 ? '' : 's'); }

        function renderSummary(role, s) {
            const box = document.getElementById('roleSummary');
            const mini = document.getElementById('roleSummaryMini');
            let html = '<div class="role-sum-kicker"><i class="bi bi-building me-1"></i>' + esc(branchName) + '</div>';
            if (!s) {
                html += '<div class="role-sum-empty mt-1">Could not load what ' + esc(role) + ' can do. You can still continue.</div>';
                box.innerHTML = html; mini.hidden = true; return;
            }
            if (s.fullAccess) {
                html += '<div class="role-sum-head">As <b>' + esc(role) + '</b> you have full access</div>' +
                        '<div class="role-sum-empty">Super admin: every screen and action in ' + esc(branchName) + ' is open.</div>';
            } else if (!s.screenCount) {
                html += '<div class="role-sum-head">As <b>' + esc(role) + '</b></div>' +
                        '<div class="role-sum-empty">No screens are granted to this role here yet. Ask an administrator to set its permissions.</div>';
            } else {
                html += '<div class="role-sum-head">As <b>' + esc(role) + '</b> you can use ' + plural(s.screenCount, 'screen') +
                        (s.actionCount ? ' &middot; ' + plural(s.actionCount, 'action') : '') + '</div>';
                // modules as compact tiles; a few of their screens on hover
                html += '<div class="role-sum-mods">' + s.modules.map(m =>
                    '<div class="role-sum-mod" title="' + esc(m.examples.join(', ') + (m.screenCount > m.examples.length ? ' and more' : '')) + '">' +
                    '<i class="' + esc(m.icon || 'bi bi-grid') + '"></i><span class="m-title">' + esc(m.title) + '</span>' +
                    '<span class="m-count">' + m.screenCount + '</span></div>').join('') + '</div>';
                if (s.keyActions.length) {
                    const shown = s.keyActions.slice(0, 8), rest = s.keyActions.slice(8);
                    html += '<div class="role-sum-acts">' + shown.map(a => '<span><i class="bi ' + esc(a.icon) + '"></i>' + esc(a.label) + '</span>').join('') +
                        (rest.length ? '<span title="' + esc(rest.map(a => a.label).join(', ')) + '">+' + rest.length + ' more</span>' : '') + '</div>';
                }
            }
            box.innerHTML = html;
            mini.innerHTML = s.fullAccess
                ? '<i class="bi bi-shield-check me-1"></i><b>' + esc(role) + '</b>: full access'
                : '<i class="bi bi-grid me-1"></i><b>' + esc(role) + '</b>: ' + plural(s.screenCount, 'screen') +
                  (s.modules.length ? ' in ' + esc(s.modules.map(m => m.title).join(', ')) : '');
            mini.hidden = false;
        }

        async function showRoleSummary(role) {
            summaryFor = role;
            if (!(role in summaries)) {
                document.getElementById('roleSummary').innerHTML =
                    '<div class="role-sum-kicker"><i class="bi bi-building me-1"></i>' + esc(branchName) + '</div>' +
                    '<div class="role-sum-empty mt-1"><span class="spinner-border spinner-border-sm me-2"></span>Checking what ' + esc(role) + ' can do…</div>';
                try {
                    const r = await fetch(summaryUrl + '?role=' + encodeURIComponent(role), { headers: { 'Accept': 'application/json' } });
                    summaries[role] = r.ok ? await r.json() : null;
                } catch (e) { summaries[role] = null; }
            }
            if (summaryFor === role) renderSummary(role, summaries[role]);   // the user may have picked another role meanwhile
        }

        const preselected = document.getElementById('selectedRoleInput').value;
        if (preselected) showRoleSummary(preselected);

        // the last used role may sit below the fold of a long list
        document.querySelector('.role-card.selected')?.scrollIntoView({ block: 'nearest' });

        function selectRole(name, el) {
            document.querySelectorAll('.role-card').forEach(c => { c.classList.remove('selected'); c.setAttribute('aria-checked', 'false'); });
            el.classList.add('selected');
            el.setAttribute('aria-checked', 'true');
            document.getElementById('selectedRoleInput').value = name;
            showRoleSummary(name);
            document.getElementById('continueBtn').disabled = false;
        }
    </script>
}
