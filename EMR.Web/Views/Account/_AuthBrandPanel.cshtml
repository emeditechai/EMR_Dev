@* Login / Forgot password / Reset password: the brand panel on the left (hidden on phones). *@
<div class="col-lg-6 auth-left d-none d-lg-flex">
    <div class="al-pattern" aria-hidden="true"></div>

    <div class="al-top">
        <span class="al-mark"><i class="bi bi-plus-lg"></i></span>
        <span class="al-mark-text">Hospital Information System</span>
    </div>

    <div class="al-body">
        <h1 class="auth-left-title"><span class="brand-eclinic">eCare360</span><span class="brand-plus">Plus</span><span class="brand-plussign">+</span></h1>
        <p class="auth-left-sub">Electronic Medical Records</p>
        <p class="al-lead">One secure workspace for patient care, diagnostics and billing across all your branches.</p>

        <ul class="al-features">
            <li><span class="al-ico"><i class="bi bi-diagram-3-fill"></i></span><div><strong>Multi-branch access</strong><small>Work across branches with one login</small></div></li>
            <li><span class="al-ico"><i class="bi bi-shield-check"></i></span><div><strong>Role-based permissions</strong><small>Every user sees only what they need</small></div></li>
            <li><span class="al-ico"><i class="bi bi-person-vcard-fill"></i></span><div><strong>Centralized patient records</strong><small>One history from registration to report</small></div></li>
            <li><span class="al-ico"><i class="bi bi-hospital-fill"></i></span><div><strong>OPD, IPD &amp; LAB management</strong><small>Clinical and billing workflows together</small></div></li>
        </ul>
    </div>

    <div class="al-foot">&copy; @DateTime.Now.Year eCare360Plus+ &middot; All rights reserved</div>
</div>
