@* Forgot / Reset password: show-hide buttons, Caps Lock hint, empty summary hidden, busy submit button *@
<script>
    (function () {
        document.querySelectorAll('[data-eye-for]').forEach(btn => btn.addEventListener('click', () => {
            const input = document.getElementById(btn.dataset.eyeFor), icon = btn.querySelector('i');
            const show = input.type === 'password';
            input.type = show ? 'text' : 'password';
            icon.className = show ? 'bi bi-eye-slash' : 'bi bi-eye';
            btn.setAttribute('aria-label', show ? 'Hide password' : 'Show password');
            btn.title = show ? 'Hide password' : 'Show password';
            input.focus();
        }));

        document.querySelectorAll('[data-pw]').forEach(pw => {
            const warn = pw.closest('.ar-field')?.querySelector('.ar-caps');
            if (!warn) return;
            const check = e => { if (e.getModifierState) warn.hidden = !e.getModifierState('CapsLock'); };
            pw.addEventListener('keydown', check);
            pw.addEventListener('keyup', check);
            pw.addEventListener('blur', () => warn.hidden = true);
        });

        const sum = document.querySelector('.ar-summary');
        if (sum && !(sum.querySelector('li') && sum.textContent.trim())) sum.style.display = 'none';

        const form = document.querySelector('form[id$="Form"]'), btn = document.getElementById('submitBtn');
        form?.addEventListener('submit', function () {
            const $f = window.jQuery ? jQuery(form) : null;
            if ($f && $f.valid && !$f.valid()) return;
            const label = btn.textContent.trim();
            setTimeout(() => { btn.disabled = true; btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>' + (label.startsWith('Send') ? 'Sending...' : 'Saving...'); }, 0);
        });
    })();
</script>
