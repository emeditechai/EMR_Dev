@model EMR.Web.Models.ViewModels.AnalyzerFormViewModel
@{
    ViewData["Title"] = "Edit Analyzer / Instrument";
}

<div class="d-flex align-items-center mb-4">
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm me-3 rounded-3" title="Back to List">
        <i class="bi bi-arrow-left"></i>
    </a>
    <div>
        <h1 class="h3 mb-0 fw-bold text-dark">Edit Analyzer / Instrument</h1>
        <small class="text-muted">Modify instrument specifications, lab department or interface protocol</small>
    </div>
</div>

<form asp-action="Edit" asp-route-id="@Model.Analyzer_ID" method="post" novalidate>
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Analyzer_ID" />
    <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3 rounded-3"></div>
    <partial name="_Form" model="Model" />

    <div class="mt-3 d-flex gap-2">
        <button type="submit" class="btn btn-primary px-4 rounded-3">
            <i class="bi bi-check-lg me-1"></i>Update Analyzer
        </button>
        <a asp-action="Index" class="btn btn-outline-secondary px-4 rounded-3">
            <i class="bi bi-x-lg me-1"></i>Cancel
        </a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
