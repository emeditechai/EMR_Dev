@model EMR.Web.Models.ViewModels.AnalyzerListViewModel
@{
    ViewData["Title"] = "Analyzer / Instrument Master";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4 gap-3">
    <div>
        <div class="d-flex align-items-center gap-2 mb-1">
            <span class="badge" style="background:#e0f2fe;color:#0369a1;font-size:0.8rem;padding:4px 10px;border-radius:20px;">
                <i class="bi bi-cpu-fill me-1"></i>Master &bull; General
            </span>
        </div>
        <h1 class="h3 mb-0 fw-bold text-dark">Analyzer / Instrument Master</h1>
        <p class="text-muted small mb-0">Manage laboratory diagnostic instruments, analyzers, department assignments & interface protocols</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Create" class="btn btn-primary shadow-sm px-3 rounded-3 d-flex align-items-center gap-2">
            <i class="bi bi-plus-circle-fill"></i>
            <span>Add Analyzer</span>
        </a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm rounded-3 d-flex align-items-center gap-2" role="alert">
        <i class="bi bi-check-circle-fill fs-5 text-success"></i>
        <div>@TempData["Success"]</div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show shadow-sm rounded-3 d-flex align-items-center gap-2" role="alert">
        <i class="bi bi-exclamation-triangle-fill fs-5 text-danger"></i>
        <div>@TempData["Error"]</div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Stats Overview Cards -->
<div class="row g-3 mb-4">
    <div class="col-6 col-md-4 col-xl-2">
        <div class="card shadow-sm border-0 rounded-4 p-3 h-100 bg-white">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <span class="text-muted small fw-semibold">Total Instruments</span>
                <div class="rounded-circle p-2 d-flex align-items-center justify-content-center bg-primary bg-opacity-10 text-primary" style="width:34px;height:34px;">
                    <i class="bi bi-cpu"></i>
                </div>
            </div>
            <h3 class="fw-bold mb-0 text-dark">@Model.TotalCount</h3>
        </div>
    </div>
    <div class="col-6 col-md-4 col-xl-2">
        <div class="card shadow-sm border-0 rounded-4 p-3 h-100 bg-white">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <span class="text-muted small fw-semibold">Active</span>
                <div class="rounded-circle p-2 d-flex align-items-center justify-content-center bg-success bg-opacity-10 text-success" style="width:34px;height:34px;">
                    <i class="bi bi-check2-circle"></i>
                </div>
            </div>
            <h3 class="fw-bold mb-0 text-success">@Model.ActiveCount</h3>
        </div>
    </div>
    <div class="col-6 col-md-4 col-xl-2">
        <div class="card shadow-sm border-0 rounded-4 p-3 h-100 bg-white">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <span class="text-muted small fw-semibold">HL7 Protocol</span>
                <div class="rounded-circle p-2 d-flex align-items-center justify-content-center" style="background:#ede9fe;color:#7c3aed;width:34px;height:34px;">
                    <i class="bi bi-diagram-3-fill"></i>
                </div>
            </div>
            <h3 class="fw-bold mb-0" style="color:#7c3aed;">@Model.Hl7Count</h3>
        </div>
    </div>
    <div class="col-6 col-md-4 col-xl-2">
        <div class="card shadow-sm border-0 rounded-4 p-3 h-100 bg-white">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <span class="text-muted small fw-semibold">ASTM Protocol</span>
                <div class="rounded-circle p-2 d-flex align-items-center justify-content-center" style="background:#ccfbf1;color:#0f766e;width:34px;height:34px;">
                    <i class="bi bi-hdd-network"></i>
                </div>
            </div>
            <h3 class="fw-bold mb-0 text-teal" style="color:#0f766e;">@Model.AstmCount</h3>
        </div>
    </div>
    <div class="col-6 col-md-4 col-xl-2">
        <div class="card shadow-sm border-0 rounded-4 p-3 h-100 bg-white">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <span class="text-muted small fw-semibold">Manual Entry</span>
                <div class="rounded-circle p-2 d-flex align-items-center justify-content-center bg-secondary bg-opacity-10 text-secondary" style="width:34px;height:34px;">
                    <i class="bi bi-keyboard"></i>
                </div>
            </div>
            <h3 class="fw-bold mb-0 text-secondary">@Model.ManualCount</h3>
        </div>
    </div>
    <div class="col-6 col-md-4 col-xl-2">
        <div class="card shadow-sm border-0 rounded-4 p-3 h-100 bg-white">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <span class="text-muted small fw-semibold">Inactive</span>
                <div class="rounded-circle p-2 d-flex align-items-center justify-content-center bg-danger bg-opacity-10 text-danger" style="width:34px;height:34px;">
                    <i class="bi bi-x-circle"></i>
                </div>
            </div>
            <h3 class="fw-bold mb-0 text-danger">@Model.InactiveCount</h3>
        </div>
    </div>
</div>

<!-- Search & Filter Card -->
<div class="card shadow-sm border-0 rounded-4 mb-4 bg-white">
    <div class="card-body p-3 p-md-4">
        <form method="get" asp-action="Index" class="row g-3">
            <div class="col-md-3">
                <label class="form-label small fw-semibold text-muted mb-1">Search Instrument / Department</label>
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" name="search" value="@Model.SearchTerm" class="form-control form-control-sm border-start-0 ps-0" placeholder="e.g. Cobas, Sysmex, Pathology..." />
                </div>
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-semibold text-muted mb-1">Branch</label>
                <select name="branchId" class="form-select form-select-sm" asp-items="Model.BranchOptions">
                    <option value="">All Branches</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-semibold text-muted mb-1">Lab Department (TYPE=LAB)</label>
                <select name="departmentId" class="form-select form-select-sm" asp-items="Model.DepartmentOptions">
                    <option value="">All Lab Departments</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-semibold text-muted mb-1">Protocol</label>
                <select name="interfaceProtocol" class="form-select form-select-sm" asp-items="Model.InterfaceProtocolOptions">
                    <option value="">All Protocols</option>
                </select>
            </div>
            <div class="col-md-2 d-flex align-items-end gap-2">
                <button type="submit" class="btn btn-sm btn-primary px-3 rounded-3 flex-grow-1">
                    <i class="bi bi-funnel-fill me-1"></i>Filter
                </button>
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary rounded-3" title="Reset Filters">
                    <i class="bi bi-arrow-clockwise"></i>
                </a>
            </div>
        </form>
    </div>
</div>

<!-- Main Table Card -->
<div class="card shadow-sm border-0 rounded-4 overflow-hidden bg-white mb-4">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="bg-light text-muted small text-uppercase">
                <tr>
                    <th class="ps-4 py-3" style="width: 80px;">ID</th>
                    <th class="py-3">Analyzer / Instrument Name</th>
                    <th class="py-3">Branch</th>
                    <th class="py-3">Department (LAB)</th>
                    <th class="py-3">Interface Protocol</th>
                    <th class="py-3 text-center" style="width: 120px;">Status</th>
                    <th class="pe-4 py-3 text-end" style="width: 140px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Items.Any())
                {
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td class="ps-4 fw-bold text-muted" style="font-size:0.85rem;">
                                #@item.Analyzer_ID
                            </td>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="rounded-circle p-2 d-flex align-items-center justify-content-center" style="background:#f0f9ff;color:#0284c7;width:34px;height:34px;">
                                        <i class="bi bi-cpu fs-6"></i>
                                    </div>
                                    <div>
                                        <a asp-action="Details" asp-route-id="@item.Analyzer_ID" class="fw-bold text-dark text-decoration-none hover-primary">
                                            @item.Analyzer_Name
                                        </a>
                                        <div class="text-muted small" style="font-size:0.75rem;">
                                            Created: @item.CreatedDate.ToString("dd MMM yyyy")
                                        </div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <span class="badge text-bg-light border text-dark">
                                    <i class="bi bi-hospital me-1 text-primary"></i>@item.BranchName
                                </span>
                            </td>
                            <td>
                                <span class="badge text-bg-light border text-dark">
                                    <i class="bi bi-building-gear me-1 text-info"></i>@item.DepartmentName
                                </span>
                            </td>
                            <td>
                                @if (string.Equals(item.Interface_Protocol, "HL7", StringComparison.OrdinalIgnoreCase))
                                {
                                    <span class="badge" style="background:#ede9fe;color:#7c3aed;border:1px solid #ddd6fe;">
                                        <i class="bi bi-diagram-3-fill me-1"></i>HL7
                                    </span>
                                }
                                else if (string.Equals(item.Interface_Protocol, "ASTM", StringComparison.OrdinalIgnoreCase))
                                {
                                    <span class="badge" style="background:#ccfbf1;color:#0f766e;border:1px solid #99f6e4;">
                                        <i class="bi bi-hdd-network me-1"></i>ASTM
                                    </span>
                                }
                                else
                                {
                                    <span class="badge" style="background:#f1f5f9;color:#475569;border:1px solid #e2e8f0;">
                                        <i class="bi bi-keyboard me-1"></i>Manual Entry
                                    </span>
                                }
                            </td>
                            <td class="text-center">
                                <form asp-action="ToggleStatus" asp-route-id="@item.Analyzer_ID" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm py-0 px-2 rounded-pill border-0 @(item.Status ? "btn-success" : "btn-secondary")" style="font-size:0.75rem;">
                                        <i class="bi @(item.Status ? "bi-check-circle-fill" : "bi-dash-circle-fill") me-1"></i>@(item.Status ? "Active" : "Inactive")
                                    </button>
                                </form>
                            </td>
                            <td class="pe-4 text-end">
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="Details" asp-route-id="@item.Analyzer_ID" class="btn btn-outline-secondary" title="View Details">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@item.Analyzer_ID" class="btn btn-outline-primary" title="Edit">
                                        <i class="bi bi-pencil-square"></i>
                                    </a>
                                    <button type="button" class="btn btn-outline-danger" title="Delete" data-bs-toggle="modal" data-bs-target="#deleteModal-@item.Analyzer_ID">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>

                                <!-- Delete Confirmation Modal -->
                                <div class="modal fade" id="deleteModal-@item.Analyzer_ID" tabindex="-1" aria-hidden="true">
                                    <div class="modal-dialog modal-dialog-centered modal-sm text-start">
                                        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
                                            <div class="modal-body p-4 text-center">
                                                <div class="rounded-circle p-3 d-inline-flex bg-danger bg-opacity-10 text-danger mb-3">
                                                    <i class="bi bi-trash3-fill fs-3"></i>
                                                </div>
                                                <h6 class="fw-bold mb-1">Delete Analyzer?</h6>
                                                <p class="text-muted small mb-3">Are you sure you want to delete <strong>@item.Analyzer_Name</strong>? This action cannot be undone.</p>
                                                <form asp-action="Delete" asp-route-id="@item.Analyzer_ID" method="post">
                                                    @Html.AntiForgeryToken()
                                                    <div class="d-flex gap-2">
                                                        <button type="button" class="btn btn-sm btn-outline-secondary w-50" data-bs-dismiss="modal">Cancel</button>
                                                        <button type="submit" class="btn btn-sm btn-danger w-50">Delete</button>
                                                    </div>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center py-5">
                            <div class="text-muted">
                                <i class="bi bi-cpu fs-1 d-block mb-2 text-secondary opacity-50"></i>
                                <h6 class="fw-semibold">No Analyzers Found</h6>
                                <p class="small mb-3">No instruments match the selected filter criteria or no analyzers have been registered yet.</p>
                                <a asp-action="Create" class="btn btn-sm btn-primary rounded-3">
                                    <i class="bi bi-plus-circle me-1"></i>Add First Analyzer
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
