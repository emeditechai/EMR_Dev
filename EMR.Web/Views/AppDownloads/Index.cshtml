@model List<EMR.Web.Services.AppApkRelease>
@{
    ViewData["Title"] = "App Downloads";
    // an open link (SQLScripts/2394): signed-in users see it in the app, everyone else on a plain page
    Layout = User.Identity?.IsAuthenticated == true ? "_Layout" : "_EmbedLayout";
    string Size(long b) => b >= 1048576 ? $"{b / 1048576.0:0.0} MB" : $"{Math.Max(1, b / 1024)} KB";
    var apps = Model.GroupBy(r => r.AppName).OrderBy(g => g.Key).ToList();
}
<style>
    .apk-card { border:1px solid #e2e8f0; border-radius:.9rem; background:#fff; }
    .apk-icon { width:52px; height:52px; border-radius:.8rem; background:#dcfce7; color:#15803d; display:flex; align-items:center; justify-content:center; font-size:1.7rem; }
    .apk-hist td, .apk-hist th { font-size:.8rem; }
</style>

<div class="container-fluid py-3">
    <div class="d-flex align-items-center gap-2 mb-1">
        <i class="bi bi-android2 fs-3 text-success"></i>
        <h4 class="mb-0 fw-bold">App Downloads</h4>
    </div>
    <p class="text-muted small mb-3">Android apps uploaded in Hospital Settings &gt; Lab &gt; App (APK) Upload. Download the latest version, or an earlier one when needed.</p>

    @if (apps.Count == 0)
    {
        <div class="apk-card p-5 text-center text-muted">
            <i class="bi bi-inbox fs-1 d-block mb-2 opacity-50"></i>No app has been uploaded yet.
        </div>
    }

    <div class="row g-3">
    @foreach (var app in apps)
    {
        var latest = app.FirstOrDefault(r => r.IsLatest) ?? app.First();
        var older = app.Where(r => r.ApkId != latest.ApkId).ToList();
        <div class="col-12 col-xl-6">
            <div class="apk-card p-3 h-100">
                <div class="d-flex align-items-start gap-3">
                    <div class="apk-icon"><i class="bi bi-android2"></i></div>
                    <div class="flex-grow-1">
                        <div class="fw-bold fs-5">@app.Key</div>
                        <div class="small text-muted">
                            <span class="badge bg-success">Latest</span>
                            v@(latest.VersionName)@(latest.VersionCode is null ? "" : $" ({latest.VersionCode})") ·
                            @Size(latest.FileSizeBytes) · @latest.UploadedDate.ToString("dd MMM yyyy, hh:mm tt")@(string.IsNullOrWhiteSpace(latest.UploadedByName) ? "" : " · " + latest.UploadedByName)
                        </div>
                        @if (!string.IsNullOrWhiteSpace(latest.ReleaseNotes))
                        {
                            <div class="small mt-1">@latest.ReleaseNotes</div>
                        }
                        <div class="small text-muted mt-1 font-monospace text-break" title="SHA-256 checksum, to check the downloaded file">SHA-256: @(latest.Sha256 ?? "—")</div>
                    </div>
                    <a class="btn btn-success btn-apk-dl text-nowrap" asp-action="Download" asp-route-id="@latest.ApkId">
                        <i class="bi bi-download me-1"></i>Download
                    </a>
                </div>

                @if (older.Count > 0)
                {
                    <details class="mt-3">
                        <summary class="small fw-semibold text-secondary">Earlier versions (@older.Count)</summary>
                        <div class="table-responsive mt-2">
                            <table class="table table-sm align-middle mb-0 apk-hist">
                                <thead class="table-light"><tr><th>Version</th><th>Uploaded</th><th class="text-end">Size</th><th>Notes</th><th></th></tr></thead>
                                <tbody>
                                @foreach (var r in older)
                                {
                                    <tr>
                                        <td class="text-nowrap">v@(r.VersionName)@(r.VersionCode is null ? "" : $" ({r.VersionCode})")</td>
                                        <td class="text-nowrap">@r.UploadedDate.ToString("dd MMM yyyy, hh:mm tt")</td>
                                        <td class="text-end text-nowrap">@Size(r.FileSizeBytes)</td>
                                        <td>@r.ReleaseNotes</td>
                                        <td class="text-end"><a class="btn btn-outline-success btn-sm py-0 px-2 btn-apk-dl" asp-action="Download" asp-route-id="@r.ApkId" title="Download this version"><i class="bi bi-download"></i></a></td>
                                    </tr>
                                }
                                </tbody>
                            </table>
                        </div>
                    </details>
                }
            </div>
        </div>
    }
    </div>
</div>

@section Scripts {
<script src="~/js/views/AppDownloads/Index.js" asp-append-version="true"></script>
}
