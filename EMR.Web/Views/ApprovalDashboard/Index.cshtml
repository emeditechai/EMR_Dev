@{
    ViewData["Title"] = "Approval Dashboard";
    var modules = (List<(string Code, string Name)>)ViewBag.Modules;
    var isHo = (bool)ViewBag.IsHo;
}

<style>
    .ad-kpi { cursor: pointer; transition: transform .12s, box-shadow .12s; border: 2px solid transparent !important; }
    .ad-kpi:hover { transform: translateY(-2px); }
    .ad-kpi.active { border-color: var(--bs-primary) !important; }
    .ad-kpi .ad-ico { width: 48px; height: 48px; display: flex; align-items: center; justify-content: center; border-radius: .75rem; }
    tr.ad-row { cursor: pointer; }
    .ad-diff td { vertical-align: top; font-size: .86rem; }
    .ad-diff tr.changed td { background: #fffbeb; }
    .ad-diff tr.changed td.ad-new { color: #166534; font-weight: 600; }
    .ad-diff tr.changed td.ad-old { color: #991b1b; text-decoration: line-through; text-decoration-color: rgba(153, 27, 27, .45); }
</style>

<div class="container-fluid px-4 py-3">
    <div class="d-flex flex-wrap justify-content-between align-items-end gap-2 mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                    <li class="breadcrumb-item text-muted">Utility</li>
                    <li class="breadcrumb-item active" aria-current="page">Approval Dashboard</li>
                </ol>
            </nav>
            <h4 class="fw-bold mb-0 text-primary"><i class="bi bi-clipboard-check me-2"></i>Approval Dashboard</h4>
            <div class="text-muted small mt-1">
                @ViewBag.BranchName:
                @(isHo ? "company-wise approvals and this branch's branch-wise approvals." : "this branch's branch-wise approvals. Company-wise approvals are on the head-office branch.")
            </div>
        </div>
        <div class="d-flex flex-wrap gap-2 align-items-end">
            <div>
                <label class="form-label small fw-semibold text-muted mb-1">Module</label>
                <select class="form-select form-select-sm" id="adModule">
                    <option value="">All modules</option>
                    @foreach (var m in modules) { <option value="@m.Code">@m.Name</option> }
                </select>
            </div>
            <div>
                <label class="form-label small fw-semibold text-muted mb-1">From</label>
                <input type="date" class="form-control form-control-sm" id="adFrom" value="@DateTime.Today.AddMonths(-3).ToString("yyyy-MM-dd")" />
            </div>
            <div>
                <label class="form-label small fw-semibold text-muted mb-1">To</label>
                <input type="date" class="form-control form-control-sm" id="adTo" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
            </div>
            <button class="btn btn-sm btn-primary" id="adGo"><i class="bi bi-arrow-repeat me-1"></i>Refresh</button>
        </div>
    </div>

    <div class="row g-3 mb-4">
        @foreach (var k in new[] {
            (Key: "",  Label: "Total",      Id: "kTotal",    Css: "primary", Icon: "bi-collection"),
            (Key: "P", Label: "Pending",    Id: "kPending",  Css: "warning", Icon: "bi-hourglass-split"),
            (Key: "A", Label: "Approved",   Id: "kApproved", Css: "success", Icon: "bi-check2-circle"),
            (Key: "S", Label: "Sent Back",  Id: "kSentBack", Css: "danger",  Icon: "bi-arrow-return-left") })
        {
            <div class="col-xl-3 col-md-6">
                <div class="card shadow-sm h-100 ad-kpi @(k.Key == "P" ? "active" : "")" data-status="@k.Key">
                    <div class="card-body p-3 d-flex align-items-center justify-content-between">
                        <div>
                            <span class="text-muted small fw-semibold text-uppercase d-block">@k.Label</span>
                            <h3 class="fw-bold mb-0 text-@k.Css" id="@k.Id">–</h3>
                        </div>
                        <div class="ad-ico bg-@k.Css-subtle text-@k.Css"><i class="bi @k.Icon fs-4"></i></div>
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white d-flex justify-content-between align-items-center">
            <span class="fw-semibold" id="adListTitle">Pending</span>
            <span class="small text-muted">Click a row to see the old and new values</span>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light small text-uppercase text-muted">
                    <tr><th>#</th><th>Module</th><th>Record</th><th>Type</th><th>Branch</th><th>Submitted by</th><th>Submitted on</th><th>Status</th><th>Acted by</th></tr>
                </thead>
                <tbody id="adBody"><tr><td colspan="9" class="text-center text-muted py-5">Loading…</td></tr></tbody>
            </table>
        </div>
    </div>
</div>

<div class="modal fade" id="adModal" tabindex="-1">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <div>
                    <h5 class="modal-title fw-bold mb-0" id="admTitle"></h5>
                    <div class="small text-muted" id="admSub"></div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div id="admAlert"></div>
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="fw-semibold" id="admCompareTitle"></span>
                    <div class="form-check form-switch small mb-0" id="admOnlyWrap">
                        <input class="form-check-input" type="checkbox" id="admOnly" checked>
                        <label class="form-check-label" for="admOnly">Changed fields only</label>
                    </div>
                </div>
                <table class="table table-sm table-bordered ad-diff mb-3">
                    <thead class="table-light"><tr><th style="width:28%">Field</th><th class="ad-oldh">Old value</th><th>New value</th></tr></thead>
                    <tbody id="admFields"></tbody>
                </table>
                <div class="small text-muted mb-1" id="admApprovers"></div>
                <div id="admHistory"></div>

                <div id="admAction" class="border-top pt-3 mt-3 d-none">
                    <label class="form-label small fw-semibold">Remarks <span class="text-muted fw-normal">(needed to send back)</span></label>
                    <textarea class="form-control" id="admRemarks" rows="2" maxlength="500" placeholder="For Send Back, explain what must be corrected"></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <span class="me-auto small text-muted" id="admCannot"></span>
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn btn-outline-danger d-none" id="admSendBack"><i class="bi bi-arrow-return-left me-1"></i>Send Back</button>
                <button type="button" class="btn btn-success d-none" id="admApprove"><i class="bi bi-check2-circle me-1"></i>Approve</button>
            </div>
        </div>
    </div>
</div>
@Html.AntiForgeryToken()

@section Scripts {
<script>
(function () {
    const esc = s => String(s ?? '').replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
    const dt = s => s ? new Date(s).toLocaleString('en-GB', { day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' }) : '';
    const statusBadge = s => ({
        P: '<span class="badge bg-warning text-dark">Pending</span>',
        A: '<span class="badge bg-success">Approved</span>',
        S: '<span class="badge bg-danger">Sent Back</span>',
        X: '<span class="badge bg-secondary">Replaced</span>'
    }[s] || s);
    const typeBadge = t => t === 'CREATE'
        ? '<span class="badge bg-primary-subtle text-primary-emphasis">New record</span>'
        : '<span class="badge bg-info-subtle text-info-emphasis">Change</span>';
    const labels = { '': 'All requests', P: 'Pending', A: 'Approved', S: 'Sent Back' };
    let status = 'P', current = null;
    const modal = new bootstrap.Modal(document.getElementById('adModal'));

    async function load() {
        const body = document.getElementById('adBody');
        body.innerHTML = '<tr><td colspan="9" class="text-center text-muted py-5"><span class="spinner-border spinner-border-sm me-2"></span>Loading…</td></tr>';
        const qs = new URLSearchParams({ status, module: adModule.value, fromDate: adFrom.value, toDate: adTo.value });
        try {
            const res = await (await fetch('@Url.Action("Data")?' + qs)).json();
            kTotal.textContent = res.summary.total; kPending.textContent = res.summary.pending;
            kApproved.textContent = res.summary.approved; kSentBack.textContent = res.summary.sentBack;
            adListTitle.textContent = labels[status] + ' (' + res.rows.length + ')';
            body.innerHTML = res.rows.length ? res.rows.map(r => `
                <tr class="ad-row" data-id="${r.Request_ID}">
                    <td class="text-muted">${r.Request_ID}</td>
                    <td>${esc(r.Module_Name)}</td>
                    <td class="fw-semibold">${esc(r.Entity_Name)}</td>
                    <td>${typeBadge(r.Action_Type)}</td>
                    <td class="small">${r.Scope === 'C' ? '<i class="bi bi-buildings me-1 text-muted"></i>' : ''}${esc(r.BranchName)}</td>
                    <td>${esc(r.Requested_By_Name)}</td>
                    <td class="small text-nowrap">${dt(r.Requested_Date)}</td>
                    <td>${statusBadge(r.Status)}${r.Status === 'P' && r.IsApprover ? ' <i class="bi bi-person-check text-success" title="You can act on this"></i>' : ''}</td>
                    <td class="small">${esc(r.Actioned_By_Name)}${r.Actioned_Date ? '<div class="text-muted">' + dt(r.Actioned_Date) + '</div>' : ''}</td>
                </tr>`).join('')
                : '<tr><td colspan="9" class="text-center text-muted py-5"><i class="bi bi-inbox fs-3 d-block mb-1"></i>Nothing here.</td></tr>';
        } catch {
            body.innerHTML = '<tr><td colspan="9" class="text-center text-danger py-5">Could not load the requests.</td></tr>';
        }
    }

    function renderFields() {
        const only = admOnly.checked && current.request.Action_Type === 'UPDATE';
        const rows = current.fields.filter(f => !only || f.changed);
        admFields.innerHTML = rows.length ? rows.map(f => `
            <tr class="${f.changed ? 'changed' : ''}">
                <td class="fw-semibold">${esc(f.field)}</td>
                ${current.request.Action_Type === 'UPDATE' ? `<td class="ad-old">${esc(f.oldValue)}</td>` : ''}
                <td class="ad-new">${esc(f.newValue)}</td>
            </tr>`).join('')
            : '<tr><td colspan="3" class="text-muted text-center">No field differs.</td></tr>';
    }

    async function open(id) {
        const res = await (await fetch('@Url.Action("Detail")?id=' + id)).json();
        if (!res.success) { Swal.fire({ icon: 'error', text: res.message }); return; }
        current = res;
        const r = res.request, isNew = r.Action_Type === 'CREATE';
        admTitle.innerHTML = esc(r.Entity_Name) + ' ' + statusBadge(r.Status);
        admSub.textContent = `${r.Module_Name} · ${isNew ? 'New record' : 'Change'} · #${r.Request_ID} · submitted by ${r.Requested_By_Name || ''} on ${dt(r.Requested_Date)} · ${r.Scope === 'C' ? 'company-wise' : 'branch ' + (r.BranchName || '')}`;
        adModal.querySelector('.ad-oldh').classList.toggle('d-none', isNew);
        admOnlyWrap.classList.toggle('d-none', isNew);
        admCompareTitle.textContent = isNew ? 'Values of the new record' : `${res.changedCount} field(s) changed`;
        let alert = '';
        if (r.Status === 'S') alert = `<div class="alert alert-danger py-2"><b>Sent back</b> by ${esc(r.Actioned_By_Name)} on ${dt(r.Actioned_Date)}: ${esc(r.Remarks)}</div>`;
        else if (r.Status === 'A') alert = `<div class="alert alert-success py-2"><b>Approved</b> by ${esc(r.Actioned_By_Name)} on ${dt(r.Actioned_Date)}${r.Remarks ? ': ' + esc(r.Remarks) : ''}</div>`;
        else if (isNew) alert = '<div class="alert alert-warning py-2 small mb-3">This record is saved inactive. Approving makes it available (and enables its login, if it has one).</div>';
        else alert = '<div class="alert alert-info py-2 small mb-3">The record still works on its old values. Approving applies the new values.</div>';
        admAlert.innerHTML = alert;
        admApprovers.innerHTML = '<i class="bi bi-people me-1"></i>Approvers: ' + esc((res.approvers || []).join(', '));
        admHistory.innerHTML = (res.history || []).length
            ? '<div class="small fw-semibold mt-2">Earlier submissions of this record</div><ul class="small mb-0">' + res.history.map(h =>
                `<li>#${h.Request_ID} ${statusBadge(h.Status)} by ${esc(h.Requested_By_Name)} on ${dt(h.Requested_Date)}${h.Remarks ? ' - ' + esc(h.Remarks) : ''}${h.Actioned_By_Name ? ' (' + esc(h.Actioned_By_Name) + ')' : ''}</li>`).join('') + '</ul>'
            : '';
        admAction.classList.toggle('d-none', !res.canAct);
        admApprove.classList.toggle('d-none', !res.canAct);
        admSendBack.classList.toggle('d-none', !res.canAct);
        admCannot.textContent = !res.canAct && r.Status === 'P' ? (res.cannotActReason || '') : '';
        admRemarks.value = '';
        admRemarks.classList.remove('is-invalid');
        renderFields();
        modal.show();
    }

    async function act(url, extra) {
        const body = new FormData();
        body.append('id', current.request.Request_ID);
        body.append('__RequestVerificationToken', document.querySelector('input[name="__RequestVerificationToken"]').value);
        Object.entries(extra).forEach(([k, v]) => body.append(k, v));
        admApprove.disabled = admSendBack.disabled = true;
        try {
            const res = await (await fetch(url, { method: 'POST', body })).json();
            if (res.success) modal.hide();
            await Swal.fire({ icon: res.success ? 'success' : 'error', text: res.message });
            if (res.success) load();
        } catch { Swal.fire({ icon: 'error', text: 'Could not reach the server. Please try again.' }); }
        finally { admApprove.disabled = admSendBack.disabled = false; }
    }

    admApprove.addEventListener('click', async () => {
        const ok = await Swal.fire({ icon: 'question', title: 'Approve?', text: current.request.Action_Type === 'CREATE' ? 'The record becomes available.' : 'The new values are applied now.', showCancelButton: true, confirmButtonText: 'Approve', confirmButtonColor: '#198754' });
        if (ok.isConfirmed) act('@Url.Action("Approve")', { remarks: admRemarks.value });
    });
    admSendBack.addEventListener('click', () => {
        if (admRemarks.value.trim().length < 5) {
            admRemarks.classList.add('is-invalid');
            admRemarks.focus();
            Swal.fire({ icon: 'warning', text: 'Give the reason for sending it back (at least 5 characters).' });
            return;
        }
        act('@Url.Action("SendBack")', { reason: admRemarks.value });
    });
    admOnly.addEventListener('change', renderFields);

    document.querySelectorAll('.ad-kpi').forEach(k => k.addEventListener('click', () => {
        document.querySelectorAll('.ad-kpi').forEach(x => x.classList.toggle('active', x === k));
        status = k.dataset.status;
        load();
    }));
    adBody.addEventListener('click', e => { const tr = e.target.closest('tr.ad-row'); if (tr) open(tr.dataset.id); });
    adGo.addEventListener('click', load);
    [adModule, adFrom, adTo].forEach(el => el.addEventListener('change', load));
    load();
})();
</script>
}
