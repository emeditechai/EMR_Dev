@{
    ViewData["Title"] = "Audit Notification Setup";
}
@* Settings > Audit Notification Setup (SQLScripts/2397, 2528): notification areas, their events, who gets them and how *@
<link rel="stylesheet" href="~/lib/select2/dist/css/select2.min.css" asp-append-version="true" />
<link rel="stylesheet" href="~/lib/select2-bootstrap-5-theme/dist/select2-bootstrap-5-theme.min.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/views/AuditNotificationSetup/Index.css" asp-append-version="true" />

<div class="container-fluid py-3 an-wrap" id="anRoot"
     data-data-url="@Url.Action("Data")" data-save-url="@Url.Action("Save")" data-test-url="@Url.Action("SendTest")" data-now-url="@Url.Action("SendNow")">
    @Html.AntiForgeryToken()
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
        <div>
            <h4 class="mb-0 fw-bold text-dark"><i class="bi bi-bell-fill text-primary me-2"></i>Notification Setup
                <span class="badge bg-primary-subtle text-primary border border-primary-subtle fs-6 align-middle ms-1" id="anBranch"><i class="bi bi-building me-1"></i>@(User.FindFirst("BranchName")?.Value ?? "Branch")</span></h4>
            <div class="text-muted small">Choose, area by area, who is told and how (<b>WhatsApp</b> / <b>e-mail</b>). Set up <b>per branch</b> - the branch you are signed in to. Messages go out after the action is done and never hold it up.</div>
        </div>
        <button type="button" class="btn btn-outline-secondary btn-sm" id="anReload"><i class="bi bi-arrow-clockwise me-1"></i>Refresh</button>
    </div>

    <div class="row g-3 mb-3">
        <div class="col-6 col-lg-3"><div class="an-card an-kpi"><div class="l">Areas</div><div class="v" id="kAreas">–</div></div></div>
        <div class="col-6 col-lg-3"><div class="an-card an-kpi"><div class="l">Notifications on</div><div class="v text-success" id="kOn">–</div></div></div>
        <div class="col-6 col-lg-3"><div class="an-card an-kpi"><div class="l">Users chosen</div><div class="v text-primary" id="kUsers">–</div></div></div>
        <div class="col-6 col-lg-3"><div class="an-card an-kpi"><div class="l">Sent (last 50)</div><div class="v" id="kSent">–</div></div></div>
    </div>

    <div class="row g-3">
        @* the areas - one per notification group; a new area is rows in dbo.AuditNotifyArea *@
        <div class="col-12 col-lg-3">
            <div class="an-card p-2 an-areas-card">
                <div class="an-areas-h px-2 pt-1 pb-2">Notification areas</div>
                <div class="d-flex flex-lg-column gap-2 an-areas" id="anAreas"><div class="text-muted small p-2">Loading…</div></div>
            </div>
        </div>

        <div class="col-12 col-lg-9">
            <div class="an-card an-area-head p-3 mb-3" id="anAreaHead"></div>
            <div class="row g-3" id="anEvents"><div class="col-12 text-muted small">Loading…</div></div>

            <div class="an-card mt-3">
                <div class="d-flex align-items-center justify-content-between px-3 py-2 border-bottom flex-wrap gap-2">
                    <div class="fw-bold"><i class="bi bi-clock-history me-1 text-secondary"></i>Recent notifications</div>
                    <div class="btn-group btn-group-sm" role="group" aria-label="Which notifications">
                        <input type="radio" class="btn-check" name="anLogScope" id="anLogArea" value="area" checked>
                        <label class="btn btn-outline-secondary" for="anLogArea">This area</label>
                        <input type="radio" class="btn-check" name="anLogScope" id="anLogAll" value="all">
                        <label class="btn btn-outline-secondary" for="anLogAll">All</label>
                    </div>
                </div>
                <div class="table-responsive">
                    <table class="table table-sm align-middle mb-0 an-log">
                        <thead class="table-light"><tr><th class="ps-3">When</th><th>Notification</th><th>Ref</th><th>To</th><th>By</th><th>Status</th><th>Detail</th></tr></thead>
                        <tbody id="anLog"><tr><td colspan="7" class="ps-3 text-muted">Nothing sent yet.</td></tr></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script src="~/lib/select2/dist/js/select2.min.js" asp-append-version="true"></script>
<script src="~/js/views/AuditNotificationSetup/index.js" asp-append-version="true"></script>
}
