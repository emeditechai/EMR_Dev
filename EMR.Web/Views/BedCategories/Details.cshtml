@model EMR.Web.Models.ViewModels.BedCategoryDetailsViewModel
@{
    ViewData["Title"] = $"{Model.CategoryName} - Details";
}

<div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-2">
    <div class="d-flex align-items-center gap-2">
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left"></i></a>
        <div>
            <h1 class="h3 mb-0 fw-bold">@Model.CategoryName</h1>
            <small class="text-muted">Code: <strong class="font-monospace text-primary">@(Model.CategoryCode ?? "—")</strong></small>
        </div>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.BedCategoryId" class="btn btn-outline-primary btn-sm px-3">
            <i class="bi bi-pencil me-1"></i> Edit Category
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm px-3">
            <i class="bi bi-list me-1"></i> All Categories
        </a>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-header bg-white border-bottom py-3">
                <h6 class="mb-0 fw-bold text-primary"><i class="bi bi-bookmark-star me-2"></i>Bed Category Overview</h6>
            </div>
            <div class="card-body p-4">
                <div class="row g-4">
                    <div class="col-md-6">
                        <p class="text-muted small mb-1 text-uppercase fw-semibold">Category Code</p>
                        <p class="fw-bold font-monospace fs-5 mb-0">
                            <span class="badge text-bg-light border text-dark">@(Model.CategoryCode ?? "—")</span>
                        </p>
                    </div>

                    <div class="col-md-6">
                        <p class="text-muted small mb-1 text-uppercase fw-semibold">Category Name</p>
                        <p class="fw-semibold fs-5 mb-0 text-dark">
                            @Model.CategoryName
                        </p>
                    </div>

                    <div class="col-md-6">
                        <p class="text-muted small mb-1 text-uppercase fw-semibold">Status</p>
                        @if (Model.IsActive)
                        {
                            <span class="badge text-bg-success px-3 py-2">Active Category</span>
                        }
                        else
                        {
                            <span class="badge text-bg-secondary px-3 py-2">Inactive</span>
                        }
                    </div>

                    <div class="col-12">
                        <p class="text-muted small mb-1 text-uppercase fw-semibold">Description & Amenities</p>
                        <p class="text-dark bg-light p-3 rounded-2 mb-0">
                            @(string.IsNullOrWhiteSpace(Model.Description) ? "No description provided." : Model.Description)
                        </p>
                    </div>

                    <div class="col-12 pt-3 border-top text-muted small d-flex justify-content-between flex-wrap gap-2">
                        <div>Created: @Model.CreatedDate.ToString("dd MMM yyyy, HH:mm")</div>
                        @if (Model.ModifiedDate.HasValue)
                        {
                            <div>Last Modified: @Model.ModifiedDate.Value.ToString("dd MMM yyyy, HH:mm")</div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
