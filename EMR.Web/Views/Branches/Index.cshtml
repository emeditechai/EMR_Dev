@model IEnumerable<EMR.Web.Models.Entities.BranchMaster>
@{
    ViewData["Title"] = "Branch Master";
    var total    = Model.Count();
    var active   = Model.Count(x => x.IsActive);
    var inactive = total - active;
    var ho       = Model.Count(x => x.IsHOBranch);
    var companies = ViewBag.Companies as List<SelectListItem> ?? [];
    var selectedCompanyId = ViewBag.SelectedCompanyId as int?;
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h4 class="mb-1 fw-bold text-dark"><i class="bi bi-diagram-3-fill me-2 text-primary"></i>Branch Master</h4>
        <p class="text-muted small mb-0">Manage and configure hospital and clinic operating branches under each parent organization.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Create" asp-route-companyId="@selectedCompanyId" class="btn btn-primary d-flex align-items-center gap-2 px-3 shadow-sm">
            <i class="bi bi-building-add"></i> Add Branch
        </a>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card stat-blue">
            <div class="stat-icon"><i class="bi bi-building-fill"></i></div>
            <div>
                <div class="stat-value">@total</div>
                <div class="stat-label">Total Branches</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card stat-green">
            <div class="stat-icon"><i class="bi bi-check-circle-fill"></i></div>
            <div>
                <div class="stat-value">@active</div>
                <div class="stat-label">Active</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card stat-red">
            <div class="stat-icon"><i class="bi bi-x-circle-fill"></i></div>
            <div>
                <div class="stat-value">@inactive</div>
                <div class="stat-label">Inactive</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card stat-yellow">
            <div class="stat-icon"><i class="bi bi-star-fill"></i></div>
            <div>
                <div class="stat-value">@ho</div>
                <div class="stat-label">Head Office</div>
            </div>
        </div>
    </div>
</div>

@if (companies.Count > 1 || User.IsSuperAdmin())
{
    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-body p-3">
            <form method="get" class="row g-2 align-items-center">
                <div class="col-md-5 col-lg-4">
                    <select name="companyId" class="form-select bg-light" onchange="this.form.submit()">
                        <option value="">-- All Companies / Organizations --</option>
                        @foreach (var c in companies)
                        {
                            <option value="@c.Value" selected="@(selectedCompanyId.ToString() == c.Value)">@c.Text</option>
                        }
                    </select>
                </div>
                @if (selectedCompanyId.HasValue)
                {
                    <div class="col-auto">
                        <a asp-action="Index" class="btn btn-link text-muted text-decoration-none px-2"><i class="bi bi-x-circle me-1"></i> Clear Filter</a>
                    </div>
                }
            </form>
        </div>
    </div>
}

<div class="card border-0 shadow-sm rounded-3 overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="bg-light text-muted small text-uppercase">
                <tr>
                    <th class="ps-4">Parent Company</th>
                    <th>Branch Name</th>
                    <th>Code</th>
                    <th>Location</th>
                    <th class="text-center">HO</th>
                    <th class="text-center">Status</th>
                    <th class="text-end pe-4">Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var branch in Model)
                {
                    <tr>
                        <td class="ps-4">
                            <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 px-2 py-1">
                                <i class="bi bi-buildings me-1"></i>@(branch.Company?.CompanyName ?? "Primary Healthcare Network")
                            </span>
                        </td>
                        <td class="fw-semibold">
                            <a asp-action="Details" asp-route-id="@branch.BranchId" class="text-decoration-none text-dark">
                                @branch.BranchName
                            </a>
                        </td>
                        <td><code>@branch.BranchCode</code></td>
                        <td class="small text-muted">@string.Join(", ", new[] { branch.City, branch.State, branch.Country }.Where(x => !string.IsNullOrWhiteSpace(x)))</td>
                        <td class="text-center">
                            @if (branch.IsHOBranch)
                            {
                                <span class="badge bg-warning text-dark border">HO</span>
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>
                        <td class="text-center">
                            @if (branch.IsActive)
                            {
                                <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle rounded-pill">Inactive</span>
                            }
                        </td>
                        <td class="text-end pe-4">
                            <div class="btn-group btn-group-sm">
                                <a asp-action="Details" asp-route-id="@branch.BranchId" class="btn btn-outline-secondary" title="View"><i class="bi bi-eye-fill"></i></a>
                                <a asp-action="Edit" asp-route-id="@branch.BranchId" class="btn btn-outline-primary ms-1" title="Edit"><i class="bi bi-pencil-fill"></i></a>
                            </div>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="7" class="text-center text-muted py-5"><i class="bi bi-building-x fs-3 d-block mb-2 text-secondary opacity-50"></i>No branches found.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
