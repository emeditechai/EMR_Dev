@model IEnumerable<EMR.Web.Models.Entities.BranchMaster>
@{
    ViewData["Title"] = "Branch Master";
    var branches = Model.ToList();
    var total    = branches.Count;
    var active   = branches.Count(x => x.IsActive);
    var inactive = total - active;
    var ho       = branches.Count(x => x.IsHOBranch);
    var labCount = branches.Count(x => x.IsLab);
    var companyCount = branches.Select(x => x.CompanyId).Distinct().Count();
    var companies = ViewBag.Companies as List<SelectListItem> ?? [];
    var selectedCompanyId = ViewBag.SelectedCompanyId as int?;
    var tileColors = new[] { "#2563eb", "#7c3aed", "#0d9488", "#d97706", "#db2777", "#0891b2" };
}

<style>
    .bm-tile { width: 40px; height: 40px; border-radius: .6rem; flex-shrink: 0; display: inline-flex; align-items: center; justify-content: center; color: #fff; font-weight: 700; font-size: .8rem; letter-spacing: .02em; box-shadow: 0 1px 3px rgba(15,23,42,.18); }
    .bm-name { font-weight: 600; color: #0f172a; line-height: 1.2; }
    .bm-sub { font-size: .76rem; color: #64748b; }
    .bm-code { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: .74rem; background: #f1f5f9; color: #be185d; border: 1px solid #e2e8f0; border-radius: .35rem; padding: .05rem .4rem; }
    .bm-chip { display: inline-flex; align-items: center; gap: .25rem; font-size: .74rem; background: #eff6ff; color: #1d4ed8; border: 1px solid #dbeafe; border-radius: 1rem; padding: .1rem .55rem; white-space: nowrap; }
    .bm-ho { display: inline-flex; align-items: center; gap: .25rem; font-size: .7rem; font-weight: 700; background: #fef3c7; color: #92400e; border: 1px solid #fde68a; border-radius: 1rem; padding: .1rem .55rem; white-space: nowrap; }
    .bm-lab { display: inline-flex; align-items: center; gap: .25rem; font-size: .7rem; font-weight: 700; background: #ecfdf5; color: #047857; border: 1px solid #a7f3d0; border-radius: 1rem; padding: .1rem .55rem; white-space: nowrap; }
    .bm-table thead th { background: #f8fafc; font-size: .72rem; text-transform: uppercase; letter-spacing: .05em; color: #64748b; font-weight: 700; border-bottom: 1px solid #e2e8f0; white-space: nowrap; }
    .bm-table tbody tr { transition: background .12s; }
    .bm-table tbody tr.bm-inactive td { opacity: .62; }
    .bm-table tbody tr.bm-inactive td:last-child { opacity: 1; }
    .bm-table tbody tr.bm-is-ho > td:first-child { box-shadow: inset 3px 0 0 #f59e0b; }
    .bm-kpi { border: 0; border-left: 4px solid var(--k); border-radius: .75rem; }
    .bm-kpi .bm-kpi-icon { width: 46px; height: 46px; border-radius: .75rem; background: var(--kb); color: var(--k); display: flex; align-items: center; justify-content: center; font-size: 1.35rem; }
    .bm-kpi .bm-kpi-num { font-size: 1.75rem; font-weight: 800; line-height: 1; color: var(--k); }
    .bm-kpi .bm-kpi-label { font-size: .72rem; font-weight: 700; letter-spacing: .05em; text-transform: uppercase; color: #64748b; }
</style>

<div class="container-fluid px-4 py-3">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                    <li class="breadcrumb-item text-muted">Master</li>
                    <li class="breadcrumb-item active" aria-current="page">Branch Master</li>
                </ol>
            </nav>
            <h4 class="fw-bold mb-0 text-primary"><i class="bi bi-diagram-3-fill me-2"></i>Branch Master</h4>
            <div class="text-muted small mt-1">Operating branches of each parent organization. One Head Office per company.</div>
        </div>
        <a asp-action="Create" asp-route-companyId="@selectedCompanyId" class="btn btn-primary px-3 shadow-sm">
            <i class="bi bi-building-add me-1"></i> Add Branch
        </a>
    </div>

    <!-- KPI cards -->
    <div class="row g-3 mb-4">
        <div class="col-xl col-md-4 col-6">
            <div class="card shadow-sm bm-kpi h-100" style="--k:#2563eb;--kb:#dbeafe;"><div class="card-body p-3 d-flex align-items-center justify-content-between">
                <div>
                    <div class="bm-kpi-label">Total Branches</div>
                    <div class="bm-kpi-num mt-1">@total</div>
                    <div class="bm-sub mt-1">across @companyCount compan@(companyCount == 1 ? "y" : "ies")</div>
                </div>
                <div class="bm-kpi-icon"><i class="bi bi-buildings-fill"></i></div>
            </div></div>
        </div>
        <div class="col-xl col-md-4 col-6">
            <div class="card shadow-sm bm-kpi h-100" style="--k:#16a34a;--kb:#dcfce7;"><div class="card-body p-3 d-flex align-items-center justify-content-between">
                <div>
                    <div class="bm-kpi-label">Active</div>
                    <div class="bm-kpi-num mt-1">@active</div>
                    <div class="bm-sub mt-1">operating now</div>
                </div>
                <div class="bm-kpi-icon"><i class="bi bi-check-circle-fill"></i></div>
            </div></div>
        </div>
        <div class="col-xl col-md-4 col-6">
            <div class="card shadow-sm bm-kpi h-100" style="--k:#dc2626;--kb:#fee2e2;"><div class="card-body p-3 d-flex align-items-center justify-content-between">
                <div>
                    <div class="bm-kpi-label">Inactive</div>
                    <div class="bm-kpi-num mt-1">@inactive</div>
                    <div class="bm-sub mt-1">not in use</div>
                </div>
                <div class="bm-kpi-icon"><i class="bi bi-x-circle-fill"></i></div>
            </div></div>
        </div>
        <div class="col-xl col-md-4 col-6">
            <div class="card shadow-sm bm-kpi h-100" style="--k:#d97706;--kb:#fef3c7;"><div class="card-body p-3 d-flex align-items-center justify-content-between">
                <div>
                    <div class="bm-kpi-label">Head Office</div>
                    <div class="bm-kpi-num mt-1">@ho</div>
                    <div class="bm-sub mt-1">one per company</div>
                </div>
                <div class="bm-kpi-icon"><i class="bi bi-star-fill"></i></div>
            </div></div>
        </div>
        <div class="col-xl col-md-4 col-6">
            <div class="card shadow-sm bm-kpi h-100" style="--k:#059669;--kb:#d1fae5;"><div class="card-body p-3 d-flex align-items-center justify-content-between">
                <div>
                    <div class="bm-kpi-label">Lab Branches</div>
                    <div class="bm-kpi-num mt-1">@labCount</div>
                    <div class="bm-sub mt-1">lab-enabled</div>
                </div>
                <div class="bm-kpi-icon"><i class="bi bi-droplet-half"></i></div>
            </div></div>
        </div>
    </div>

    <!-- Filters: company reloads the list, the rest apply instantly -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-3">
            <div class="row g-3 align-items-end">
                <div class="col-md-4">
                    <label class="form-label small fw-semibold text-muted mb-1">Search</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
                        <input type="text" id="bmSearch" class="form-control border-start-0" placeholder="Branch name, code, city or state..." autocomplete="off" />
                    </div>
                </div>
                @if (companies.Count > 1 || User.IsSuperAdmin())
                {
                    <div class="col-md-3">
                        <label class="form-label small fw-semibold text-muted mb-1">Company / Organization</label>
                        <form method="get" id="bmCompanyForm">
                            <select name="companyId" class="form-select" onchange="this.form.submit()">
                                <option value="">All companies</option>
                                @foreach (var c in companies)
                                {
                                    <option value="@c.Value" selected="@(selectedCompanyId.ToString() == c.Value)">@c.Text</option>
                                }
                            </select>
                        </form>
                    </div>
                }
                <div class="col-md-2 col-6">
                    <label class="form-label small fw-semibold text-muted mb-1">Status</label>
                    <select id="bmStatus" class="form-select">
                        <option value="">All statuses</option>
                        <option value="active">Active</option>
                        <option value="inactive">Inactive</option>
                    </select>
                </div>
                <div class="col-md-2 col-6">
                    <label class="form-label small fw-semibold text-muted mb-1">Type</label>
                    <select id="bmType" class="form-select">
                        <option value="">All branches</option>
                        <option value="ho">Head Office</option>
                        <option value="branch">Other branches</option>
                    </select>
                </div>
                <div class="col-md-2 col-6">
                    <label class="form-label small fw-semibold text-muted mb-1">Lab</label>
                    <select id="bmLab" class="form-select">
                        <option value="">All branches</option>
                        <option value="lab">Lab branches</option>
                        <option value="nonlab">Non-lab branches</option>
                    </select>
                </div>
                <div class="col-md-1 col-12">
                    <button type="button" id="bmReset" class="btn btn-outline-secondary w-100" title="Reset filters"><i class="bi bi-arrow-counterclockwise"></i></button>
                </div>
            </div>
        </div>
    </div>

    <!-- Branches table -->
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
            <span class="fw-bold text-dark"><i class="bi bi-list-ul text-primary me-2"></i>Branches</span>
            <span class="text-muted small" id="bmCount">Showing @total of @total</span>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 bm-table" id="bmTable">
                    <thead>
                        <tr>
                            <th class="ps-4">Branch</th>
                            <th>Parent Company</th>
                            <th>Location</th>
                            <th class="text-center">Type</th>
                            <th class="text-center">Status</th>
                            <th class="text-end pe-4" style="width:120px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var b in branches)
                        {
                            var initials = string.Concat((b.BranchCode ?? b.BranchName ?? "?").Where(char.IsLetterOrDigit).Take(3)).ToUpperInvariant();
                            if (string.IsNullOrEmpty(initials)) { initials = "?"; }
                            var color = b.IsHOBranch ? "#d97706" : tileColors[b.BranchId % tileColors.Length];
                            var location = string.Join(", ", new[] { b.City, b.State, b.Country }.Where(x => !string.IsNullOrWhiteSpace(x)));
                            var company = b.Company?.CompanyName ?? "Primary Healthcare Network";
                            var search = $"{b.BranchName} {b.BranchCode} {b.City} {b.State} {b.Country} {company} {b.Pincode}".ToLowerInvariant();
                            <tr class="@(b.IsActive ? "" : "bm-inactive") @(b.IsHOBranch ? "bm-is-ho" : "")"
                                data-search="@search" data-status="@(b.IsActive ? "active" : "inactive")" data-type="@(b.IsHOBranch ? "ho" : "branch")" data-lab="@(b.IsLab ? "lab" : "nonlab")">
                                <td class="ps-4">
                                    <div class="d-flex align-items-center gap-3">
                                        <span class="bm-tile" style="background:@color;">@initials</span>
                                        <div>
                                            <a asp-action="Details" asp-route-id="@b.BranchId" class="bm-name text-decoration-none">@b.BranchName</a>
                                            <div class="bm-sub mt-1"><span class="bm-code">@b.BranchCode</span></div>
                                        </div>
                                    </div>
                                </td>
                                <td><span class="bm-chip"><i class="bi bi-buildings"></i>@company</span></td>
                                <td>
                                    @if (string.IsNullOrWhiteSpace(location))
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                    else
                                    {
                                        <div class="small text-dark"><i class="bi bi-geo-alt text-muted me-1"></i>@location</div>
                                        @if (!string.IsNullOrWhiteSpace(b.Pincode))
                                        {
                                            <div class="bm-sub">PIN @b.Pincode</div>
                                        }
                                    }
                                </td>
                                <td class="text-center">
                                    <div class="d-flex flex-column align-items-center gap-1">
                                        @if (b.IsHOBranch)
                                        {
                                            <span class="bm-ho"><i class="bi bi-star-fill"></i>Head Office</span>
                                        }
                                        @if (b.IsLab)
                                        {
                                            <span class="bm-lab"><i class="bi bi-droplet-half"></i>Lab</span>
                                        }
                                        @if (!b.IsHOBranch && !b.IsLab)
                                        {
                                            <span class="bm-sub">Branch</span>
                                        }
                                    </div>
                                </td>
                                <td class="text-center">
                                    @if (b.IsActive)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill"><i class="bi bi-circle-fill me-1" style="font-size:.45rem;vertical-align:middle;"></i>Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle rounded-pill"><i class="bi bi-circle-fill me-1" style="font-size:.45rem;vertical-align:middle;"></i>Inactive</span>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Details" asp-route-id="@b.BranchId" class="btn btn-outline-secondary" title="View"><i class="bi bi-eye-fill"></i></a>
                                        <a asp-action="Edit" asp-route-id="@b.BranchId" class="btn btn-outline-primary ms-1" title="Edit"><i class="bi bi-pencil-fill"></i></a>
                                    </div>
                                </td>
                            </tr>
                        }
                        <tr id="bmEmpty" style="display:none;">
                            <td colspan="6" class="text-center text-muted py-5">
                                <i class="bi bi-funnel fs-3 d-block mb-2 text-secondary opacity-50"></i>No branch matches these filters.
                            </td>
                        </tr>
                        @if (!branches.Any())
                        {
                            <tr><td colspan="6" class="text-center text-muted py-5"><i class="bi bi-building-x fs-3 d-block mb-2 text-secondary opacity-50"></i>No branches found.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const rows = [...document.querySelectorAll('#bmTable tbody tr[data-search]')];
            const $search = document.getElementById('bmSearch');
            const $status = document.getElementById('bmStatus');
            const $type = document.getElementById('bmType');
            const $lab = document.getElementById('bmLab');
            const $count = document.getElementById('bmCount');
            const $empty = document.getElementById('bmEmpty');

            function apply() {
                const term = $search.value.toLowerCase().trim();
                const status = $status.value;
                const type = $type.value;
                const lab = $lab.value;
                let shown = 0;

                rows.forEach(r => {
                    const ok = (!term || r.dataset.search.includes(term))
                        && (!status || r.dataset.status === status)
                        && (!type || r.dataset.type === type)
                        && (!lab || r.dataset.lab === lab);
                    r.style.display = ok ? '' : 'none';
                    if (ok) shown++;
                });

                $count.textContent = 'Showing ' + shown + ' of ' + rows.length;
                $empty.style.display = (rows.length > 0 && shown === 0) ? '' : 'none';
            }

            $search.addEventListener('input', apply);
            $status.addEventListener('change', apply);
            $type.addEventListener('change', apply);
            $lab.addEventListener('change', apply);
            document.getElementById('bmReset').addEventListener('click', () => {
                $search.value = ''; $status.value = ''; $type.value = ''; $lab.value = ''; apply(); $search.focus();
            });
        })();
    </script>
}
