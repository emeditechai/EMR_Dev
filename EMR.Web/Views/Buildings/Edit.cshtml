@model EMR.Web.Models.ViewModels.BuildingFormViewModel
@{
    ViewData["Title"] = "Edit Building";
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h1 class="h3 mb-0 fw-bold">Edit Building</h1>
        <small class="text-muted">Update building information</small>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm px-3">
        <i class="bi bi-arrow-left me-1"></i> Back to List
    </a>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-header bg-white border-bottom py-3">
                <h6 class="mb-0 fw-bold text-primary"><i class="bi bi-pencil-square me-2"></i>Edit Building Details</h6>
            </div>
            <div class="card-body p-4">
                <form asp-action="Edit" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="BuildingId" />
                    <input type="hidden" asp-for="CompanyId" />
                    <input type="hidden" asp-for="BranchId" />

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="BuildingCode" class="form-label fw-semibold required-label">
                                Building Code <span class="badge bg-primary bg-opacity-10 text-primary ms-1">4 Digits / Chars</span>
                            </label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="bi bi-qr-code text-muted"></i></span>
                                <input asp-for="BuildingCode" class="form-control text-uppercase font-monospace" maxlength="4" placeholder="e.g. BLD1" required />
                            </div>
                            <span asp-validation-for="BuildingCode" class="text-danger small d-block mt-1"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="BuildingName" class="form-label fw-semibold required-label">Building Name</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="bi bi-building text-muted"></i></span>
                                <input asp-for="BuildingName" class="form-control" placeholder="e.g. Main Hospital Block" required />
                            </div>
                            <span asp-validation-for="BuildingName" class="text-danger small d-block mt-1"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="NumberOfFloors" class="form-label fw-semibold required-label">Number of Floors</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="bi bi-layers text-muted"></i></span>
                                <input asp-for="NumberOfFloors" type="number" min="1" max="200" class="form-control" required />
                            </div>
                            <span asp-validation-for="NumberOfFloors" class="text-danger small d-block mt-1"></span>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Status</label>
                            <div class="form-check form-switch p-2 border rounded bg-light mt-1">
                                <input class="form-check-input ms-0 me-2" type="checkbox" role="switch" asp-for="IsActive">
                                <label class="form-check-label fw-semibold" asp-for="IsActive">Active Building</label>
                            </div>
                        </div>

                        <div class="col-12">
                            <label asp-for="Description" class="form-label fw-semibold">Description / Notes</label>
                            <textarea asp-for="Description" class="form-control" rows="3" placeholder="Additional details..."></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>
                    </div>

                    <hr class="my-4" />

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-outline-secondary px-3">Cancel</a>
                        <button type="submit" class="btn btn-primary px-4 shadow-sm">
                            <i class="bi bi-floppy-fill me-1"></i> Update Building
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
