@model EMR.Web.Models.ViewModels.ClinicalUnitDetailsViewModel
@{
    ViewData["Title"] = $"{Model.UnitName} - Details";
}

<div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-2">
    <div class="d-flex align-items-center gap-2">
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left"></i></a>
        <div>
            <h1 class="h3 mb-0 fw-bold">@Model.UnitName</h1>
            <small class="text-muted">Unit Code: <strong class="font-monospace text-primary">@Model.UnitCode</strong></small>
        </div>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.UnitId" class="btn btn-outline-primary btn-sm px-3">
            <i class="bi bi-pencil me-1"></i> Edit Unit
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm px-3">
            <i class="bi bi-list me-1"></i> All Units
        </a>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-lg-9">
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-header bg-white border-bottom py-3">
                <h6 class="mb-0 fw-bold text-primary"><i class="bi bi-diagram-3-fill me-2"></i>Clinical Unit Overview</h6>
            </div>
            <div class="card-body p-4">
                <div class="row g-4">
                    <div class="col-md-6">
                        <p class="text-muted small mb-1 text-uppercase fw-semibold">Unit Code</p>
                        <p class="fw-bold font-monospace fs-5 mb-0">
                            <span class="badge text-bg-light border text-dark">@Model.UnitCode</span>
                        </p>
                    </div>
                    <div class="col-md-6">
                        <p class="text-muted small mb-1 text-uppercase fw-semibold">Unit Name</p>
                        <p class="fw-semibold fs-5 mb-0 text-dark">
                            <i class="bi bi-diagram-3 text-primary me-2"></i>@Model.UnitName
                        </p>
                    </div>

                    <div class="col-md-6">
                        <p class="text-muted small mb-1 text-uppercase fw-semibold">Department</p>
                        <p class="fw-semibold fs-5 mb-0">
                            <span class="badge bg-secondary bg-opacity-10 text-dark border px-3 py-2">
                                <i class="bi bi-building me-1"></i>@Model.DepartmentName (@Model.DepartmentCode)
                            </span>
                        </p>
                    </div>
                    <div class="col-md-6">
                        <p class="text-muted small mb-1 text-uppercase fw-semibold">Speciality</p>
                        <p class="fw-semibold fs-5 mb-0">
                            <a asp-controller="DoctorSpecialities" asp-action="Details" asp-route-id="@Model.SpecialityId" class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 text-decoration-none px-3 py-2">
                                <i class="bi bi-award me-1"></i>@Model.SpecialityName (@Model.SpecialityCode)
                            </a>
                        </p>
                    </div>

                    <div class="col-md-6">
                        <p class="text-muted small mb-1 text-uppercase fw-semibold">Consultant-in-Charge</p>
                        @if (!string.IsNullOrWhiteSpace(Model.ConsultantName))
                        {
                            <div class="p-3 border rounded bg-light">
                                <div class="fw-bold text-dark fs-6">
                                    <i class="bi bi-person-badge-fill text-primary me-2"></i>@Model.ConsultantName
                                </div>
                                @if (!string.IsNullOrWhiteSpace(Model.ConsultantPhoneNumber))
                                {
                                    <div class="small text-muted mt-1"><i class="bi bi-telephone me-1"></i>@Model.ConsultantPhoneNumber</div>
                                }
                                @if (!string.IsNullOrWhiteSpace(Model.ConsultantEmail))
                                {
                                    <div class="small text-muted"><i class="bi bi-envelope me-1"></i>@Model.ConsultantEmail</div>
                                }
                            </div>
                        }
                        else
                        {
                            <p class="text-muted mb-0">No Consultant assigned.</p>
                        }
                    </div>

                    <div class="col-md-6">
                        <p class="text-muted small mb-1 text-uppercase fw-semibold">Operational Status</p>
                        @if (Model.IsActive)
                        {
                            <span class="badge text-bg-success px-3 py-2 fs-6">Active Unit</span>
                        }
                        else
                        {
                            <span class="badge text-bg-secondary px-3 py-2 fs-6">Inactive Unit</span>
                        }
                    </div>

                    <div class="col-12">
                        <p class="text-muted small mb-1 text-uppercase fw-semibold">Description / Clinical Focus</p>
                        <p class="text-dark bg-light p-3 rounded-2 mb-0">
                            @(string.IsNullOrWhiteSpace(Model.Description) ? "No description provided." : Model.Description)
                        </p>
                    </div>

                    <div class="col-12 pt-3 border-top text-muted small d-flex justify-content-between flex-wrap gap-2">
                        <div>Created: @Model.CreatedDate.ToString("dd MMM yyyy, HH:mm")</div>
                        @if (Model.ModifiedDate.HasValue)
                        {
                            <div>Last Modified: @Model.ModifiedDate.Value.ToString("dd MMM yyyy, HH:mm")</div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
