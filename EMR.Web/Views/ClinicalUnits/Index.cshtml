@model IEnumerable<EMR.Web.Models.ViewModels.ClinicalUnitListItemViewModel>
@{
    ViewData["Title"] = "Clinical Unit Master";
    var total = Model.Count();
    var active = Model.Count(x => x.IsActive);
    var inactive = total - active;
    var departmentsCount = Model.Select(x => x.DepartmentId).Distinct().Count();
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h1 class="h3 mb-0 fw-bold">Clinical Unit Master</h1>
        <small class="text-muted">Manage clinical care units, surgical units, and assigned consultant in-charges</small>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Create" asp-route-departmentId="@ViewBag.DepartmentId" asp-route-specialityId="@ViewBag.SpecialityId" class="btn btn-primary shadow-sm">
            <i class="bi bi-plus-lg me-1"></i>Add Clinical Unit
        </a>
    </div>
</div>

<!-- Stat Cards -->
<div class="row g-3 mb-4">
    <div class="col-12 col-sm-6 col-lg-3">
        <div class="stat-card stat-blue">
            <div class="stat-icon"><i class="bi bi-diagram-3-fill"></i></div>
            <div>
                <div class="stat-value">@total</div>
                <div class="stat-label">Total Clinical Units</div>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-lg-3">
        <div class="stat-card stat-green">
            <div class="stat-icon"><i class="bi bi-check-circle-fill"></i></div>
            <div>
                <div class="stat-value">@active</div>
                <div class="stat-label">Active Units</div>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-lg-3">
        <div class="stat-card stat-red">
            <div class="stat-icon"><i class="bi bi-x-circle-fill"></i></div>
            <div>
                <div class="stat-value">@inactive</div>
                <div class="stat-label">Inactive</div>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-lg-3">
        <div class="stat-card stat-cyan">
            <div class="stat-icon"><i class="bi bi-building"></i></div>
            <div>
                <div class="stat-value">@departmentsCount</div>
                <div class="stat-label">Departments Covered</div>
            </div>
        </div>
    </div>
</div>

<!-- Filter Bar -->
<div class="card border-0 shadow-sm rounded-3 mb-4">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-auto">
                <label class="form-label mb-0 fw-semibold text-muted small"><i class="bi bi-funnel me-1"></i>Filters:</label>
            </div>
            <div class="col-md-3">
                <select name="departmentId" class="form-select form-select-sm" onchange="this.form.submit()">
                    <option value="">-- All Departments --</option>
                    @if (ViewBag.DepartmentOptions != null)
                    {
                        foreach (var opt in (IEnumerable<SelectListItem>)ViewBag.DepartmentOptions)
                        {
                            <option value="@opt.Value" selected="@(opt.Value == (ViewBag.DepartmentId?.ToString()))">@opt.Text</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-3">
                <select name="specialityId" class="form-select form-select-sm" onchange="this.form.submit()">
                    <option value="">-- All Specialities --</option>
                    @if (ViewBag.SpecialityOptions != null)
                    {
                        foreach (var opt in (IEnumerable<SelectListItem>)ViewBag.SpecialityOptions)
                        {
                            <option value="@opt.Value" selected="@(opt.Value == (ViewBag.SpecialityId?.ToString()))">@opt.Text</option>
                        }
                    }
                </select>
            </div>
            @if (ViewBag.DepartmentId != null || ViewBag.SpecialityId != null)
            {
                <div class="col-auto">
                    <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Clear Filters</a>
                </div>
            }
        </form>
    </div>
</div>

<!-- Data Table -->
<div class="dashboard-panel table-responsive shadow-sm border rounded-3 bg-white">
    <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
            <tr>
                <th style="width: 50px;">#</th>
                <th>Unit Code</th>
                <th>Unit Name</th>
                <th>Department</th>
                <th>Speciality</th>
                <th>Consultant In-Charge</th>
                <th>Status</th>
                <th>Created</th>
                <th class="text-end" style="width: 140px;">Actions</th>
            </tr>
        </thead>
        <tbody>
            @{int i = 1;}
            @foreach (var item in Model)
            {
                <tr>
                    <td class="text-muted small">@(i++)</td>
                    <td>
                        <span class="badge text-bg-light border text-dark font-monospace fs-6">
                            @item.UnitCode
                        </span>
                    </td>
                    <td class="fw-semibold">
                        <i class="bi bi-diagram-3 text-primary me-2"></i>@item.UnitName
                    </td>
                    <td>
                        <span class="badge bg-secondary bg-opacity-10 text-dark border">
                            <i class="bi bi-building me-1"></i>@item.DepartmentName
                        </span>
                    </td>
                    <td>
                        <a asp-controller="DoctorSpecialities" asp-action="Details" asp-route-id="@item.SpecialityId" class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 text-decoration-none px-2 py-1">
                            <i class="bi bi-award me-1"></i>@item.SpecialityName
                        </a>
                    </td>
                    <td>
                        @if (!string.IsNullOrWhiteSpace(item.ConsultantName))
                        {
                            <span class="badge bg-info bg-opacity-10 text-info border border-info border-opacity-25 px-2 py-1">
                                <i class="bi bi-person-badge-fill me-1"></i>@item.ConsultantName
                            </span>
                        }
                        else
                        {
                            <span class="text-muted small">—</span>
                        }
                    </td>
                    <td>
                        @if (item.IsActive)
                        {
                            <span class="badge text-bg-success">Active</span>
                        }
                        else
                        {
                            <span class="badge text-bg-secondary">Inactive</span>
                        }
                    </td>
                    <td class="text-muted small">@item.CreatedDate.ToString("dd MMM yyyy")</td>
                    <td class="text-end">
                        <a asp-action="Details" asp-route-id="@item.UnitId"
                           class="btn btn-sm btn-outline-secondary me-1" title="View Details">
                            <i class="bi bi-eye"></i>
                        </a>
                        <a asp-action="Edit" asp-route-id="@item.UnitId"
                           class="btn btn-sm btn-outline-primary me-1" title="Edit">
                            <i class="bi bi-pencil"></i>
                        </a>
                        <form asp-action="Delete" asp-route-id="@item.UnitId" method="post" class="d-inline"
                              onsubmit="return confirm('Are you sure you want to delete @item.UnitName?');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete">
                                <i class="bi bi-trash"></i>
                            </button>
                        </form>
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="9" class="text-center text-muted py-5">
                        <i class="bi bi-diagram-3 fs-1 d-block mb-2 opacity-50"></i>
                        No clinical units found. <a asp-action="Create" class="fw-bold">Create your first unit.</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
