@model IEnumerable<EMR.Web.Models.ViewModels.CompanyListItemViewModel>
@{
    ViewData["Title"] = "Company Master";
    var totalCompanies = Model.Count();
    var activeCompanies = Model.Count(x => x.IsActive);
    var totalBranches = Model.Sum(x => x.TotalBranches);
    var totalUsers = Model.Sum(x => x.TotalUsers);
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h4 class="mb-1 fw-bold text-dark"><i class="bi bi-buildings me-2 text-primary"></i>Company Master</h4>
        <p class="text-muted small mb-0">Manage parent healthcare organizations, corporate entities, and multi-tenant groups.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Create" class="btn btn-primary d-flex align-items-center gap-2 px-3 shadow-sm">
            <i class="bi bi-plus-circle-fill"></i> Add New Company
        </a>
    </div>
</div>

<!-- Metrics Cards -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm rounded-3 h-100 bg-primary bg-opacity-10 border-start border-primary border-4">
            <div class="card-body p-3 d-flex align-items-center justify-content-between">
                <div>
                    <div class="text-muted small fw-semibold text-uppercase">Total Companies</div>
                    <h3 class="mb-0 fw-bold text-primary mt-1">@totalCompanies</h3>
                </div>
                <div class="bg-primary text-white rounded-circle p-3 d-flex align-items-center justify-content-center" style="width:48px;height:48px;">
                    <i class="bi bi-buildings-fill fs-5"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm rounded-3 h-100 bg-success bg-opacity-10 border-start border-success border-4">
            <div class="card-body p-3 d-flex align-items-center justify-content-between">
                <div>
                    <div class="text-muted small fw-semibold text-uppercase">Active Companies</div>
                    <h3 class="mb-0 fw-bold text-success mt-1">@activeCompanies</h3>
                </div>
                <div class="bg-success text-white rounded-circle p-3 d-flex align-items-center justify-content-center" style="width:48px;height:48px;">
                    <i class="bi bi-check-circle-fill fs-5"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm rounded-3 h-100 bg-info bg-opacity-10 border-start border-info border-4">
            <div class="card-body p-3 d-flex align-items-center justify-content-between">
                <div>
                    <div class="text-muted small fw-semibold text-uppercase">Total Branches</div>
                    <h3 class="mb-0 fw-bold text-info mt-1">@totalBranches</h3>
                </div>
                <div class="bg-info text-white rounded-circle p-3 d-flex align-items-center justify-content-center" style="width:48px;height:48px;">
                    <i class="bi bi-diagram-3-fill fs-5"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm rounded-3 h-100 bg-warning bg-opacity-10 border-start border-warning border-4">
            <div class="card-body p-3 d-flex align-items-center justify-content-between">
                <div>
                    <div class="text-muted small fw-semibold text-uppercase">Mapped Users</div>
                    <h3 class="mb-0 fw-bold text-warning mt-1">@totalUsers</h3>
                </div>
                <div class="bg-warning text-white rounded-circle p-3 d-flex align-items-center justify-content-center" style="width:48px;height:48px;">
                    <i class="bi bi-people-fill fs-5"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Search & Filters -->
<div class="card border-0 shadow-sm rounded-3 mb-4">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-6 col-lg-5">
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" name="search" value="@ViewBag.Search" class="form-control bg-light border-start-0" placeholder="Search by Company Name, Code, City..." />
                </div>
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-outline-primary px-3"><i class="bi bi-funnel-fill me-1"></i> Filter</button>
            </div>
            @if (!string.IsNullOrWhiteSpace(ViewBag.Search as string))
            {
                <div class="col-auto">
                    <a asp-action="Index" class="btn btn-link text-muted text-decoration-none px-2"><i class="bi bi-x-circle me-1"></i> Clear</a>
                </div>
            }
        </form>
    </div>
</div>

<!-- Companies List -->
<div class="card border-0 shadow-sm rounded-3 overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="bg-light text-muted small text-uppercase">
                <tr>
                    <th class="ps-4" style="width: 70px;">Logo</th>
                    <th>Company Code & Name</th>
                    <th>Contact & Location</th>
                    <th class="text-center">Branches</th>
                    <th class="text-center">Users</th>
                    <th class="text-center">Status</th>
                    <th class="text-end pe-4">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center py-5 text-muted">
                            <i class="bi bi-buildings display-6 d-block mb-3 text-secondary opacity-50"></i>
                            <div class="fw-semibold">No companies found</div>
                            <div class="small">Click 'Add New Company' to create your first organization.</div>
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4">
                                @if (!string.IsNullOrWhiteSpace(item.LogoPath))
                                {
                                    <img src="@item.LogoPath" alt="@item.CompanyName" class="rounded border shadow-sm" style="width: 44px; height: 44px; object-fit: contain; background: #fff;" />
                                }
                                else
                                {
                                    <div class="rounded bg-primary bg-opacity-10 text-primary d-flex align-items-center justify-content-center fw-bold shadow-sm" style="width: 44px; height: 44px; font-size: 1.1rem;">
                                        @item.CompanyName.Substring(0, 1).ToUpper()
                                    </div>
                                }
                            </td>
                            <td>
                                <div class="fw-bold text-dark">
                                    <a asp-action="Details" asp-route-id="@item.CompanyId" class="text-decoration-none text-dark hover-primary">
                                        @item.CompanyName
                                    </a>
                                </div>
                                <div class="small text-muted d-flex align-items-center gap-2 mt-1">
                                    <span class="badge bg-secondary bg-opacity-10 text-secondary border">@item.CompanyCode</span>
                                    @if (!string.IsNullOrWhiteSpace(item.LegalName))
                                    {
                                        <span class="text-truncate" style="max-width: 250px;" title="@item.LegalName">@item.LegalName</span>
                                    }
                                </div>
                            </td>
                            <td>
                                <div class="small text-dark"><i class="bi bi-envelope me-1 text-muted"></i>@(item.Email ?? "—")</div>
                                <div class="small text-muted mt-1"><i class="bi bi-geo-alt me-1 text-muted"></i>@string.Join(", ", new[] { item.City, item.State }.Where(s => !string.IsNullOrWhiteSpace(s)))</div>
                            </td>
                            <td class="text-center">
                                <a asp-controller="Branches" asp-action="Index" asp-route-companyId="@item.CompanyId" class="badge bg-info bg-opacity-10 text-info text-decoration-none px-3 py-2 border border-info border-opacity-25 rounded-pill fw-semibold">
                                    <i class="bi bi-diagram-3-fill me-1"></i>@item.TotalBranches Branches
                                </a>
                            </td>
                            <td class="text-center">
                                <span class="badge bg-light text-dark px-3 py-2 border rounded-pill fw-semibold">
                                    <i class="bi bi-people-fill me-1 text-muted"></i>@item.TotalUsers Users
                                </span>
                            </td>
                            <td class="text-center">
                                @if (item.IsActive)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1 rounded-pill">
                                        <i class="bi bi-check-circle-fill me-1"></i>Active
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1 rounded-pill">
                                        <i class="bi bi-x-circle-fill me-1"></i>Inactive
                                    </span>
                                }
                            </td>
                            <td class="text-end pe-4">
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="Details" asp-route-id="@item.CompanyId" class="btn btn-outline-secondary" title="View Details">
                                        <i class="bi bi-eye-fill"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@item.CompanyId" class="btn btn-outline-primary" title="Edit Company">
                                        <i class="bi bi-pencil-fill"></i>
                                    </a>
                                    <a asp-controller="Branches" asp-action="Create" asp-route-companyId="@item.CompanyId" class="btn btn-outline-success" title="Add Branch">
                                        <i class="bi bi-plus-lg"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
