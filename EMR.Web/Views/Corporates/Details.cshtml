@model EMR.Web.Models.ViewModels.CorporateListItemViewModel
@{
    ViewData["Title"] = "Corporate Master Details";
    var isExpired = Model.Effective_To < DateTime.Today;
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h1 class="h3 mb-0 fw-bold">@Model.Corporate_Name</h1>
        <small class="text-muted">Corporate partner code: <span class="font-monospace fw-bold">@(Model.Corporate_Code ?? "—")</span></small>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Corporate_ID" class="btn btn-primary btn-sm px-3 shadow-sm">
            <i class="bi bi-pencil me-1"></i> Edit Corporate
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm px-3">
            <i class="bi bi-arrow-left me-1"></i> Back to List
        </a>
    </div>
</div>

<div class="row g-4">
    <!-- Left Column: Primary Details -->
    <div class="col-lg-8">
        <!-- Overview Card -->
        <div class="card border-0 shadow-sm rounded-3 mb-4">
            <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
                <h6 class="mb-0 fw-bold text-primary"><i class="bi bi-briefcase-fill me-2"></i>Institutional Overview</h6>
                <div>
                    @if (Model.Status)
                    {
                        <span class="badge text-bg-success px-3 py-2">Active</span>
                    }
                    else
                    {
                        <span class="badge text-bg-secondary px-3 py-2">Inactive</span>
                    }
                </div>
            </div>
            <div class="card-body p-4">
                <div class="row g-3">
                    <div class="col-sm-6">
                        <label class="text-muted small fw-semibold">Corporate Name</label>
                        <div class="fs-5 fw-bold text-dark">@Model.Corporate_Name</div>
                    </div>
                    <div class="col-sm-6">
                        <label class="text-muted small fw-semibold">Corporate Code</label>
                        <div>
                            <span class="badge bg-light text-dark border font-monospace fs-6">
                                @(Model.Corporate_Code ?? "—")
                            </span>
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <label class="text-muted small fw-semibold">Department Type Scope</label>
                        <div>
                            @{
                                var badgeClass = Model.Corporate_Type switch
                                {
                                    "IPD" => "bg-primary text-white",
                                    "OPD" => "bg-info text-dark",
                                    "LAB" => "bg-warning text-dark",
                                    "MED" => "bg-success text-white",
                                    "GENERAL" => "bg-secondary text-white",
                                    _ => "bg-dark text-white"
                                };
                            }
                            <span class="badge @badgeClass fs-6 px-3 py-1">@Model.Corporate_Type</span>
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <label class="text-muted small fw-semibold">Billing Cycle</label>
                        <div>
                            <span class="badge bg-secondary bg-opacity-10 text-dark border fs-6 px-3 py-1">
                                <i class="bi bi-calendar-cycle me-1"></i>@Model.BillingCycle
                            </span>
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <label class="text-muted small fw-semibold">Branch Scoped</label>
                        <div class="fw-semibold text-dark"><i class="bi bi-building me-1 text-muted"></i>@(Model.BranchName ?? $"Branch #{Model.Branch_ID}")</div>
                    </div>
                    <div class="col-sm-6">
                        <label class="text-muted small fw-semibold">Validity Status</label>
                        <div>
                            @if (isExpired)
                            {
                                <span class="badge text-bg-danger px-2 py-1"><i class="bi bi-exclamation-octagon me-1"></i>Validity Expired</span>
                            }
                            else
                            {
                                <span class="badge text-bg-success px-2 py-1"><i class="bi bi-shield-check me-1"></i>Within Valid Range</span>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Financial & Credit Limits Card -->
        <div class="card border-0 shadow-sm rounded-3 mb-4">
            <div class="card-header bg-white border-bottom py-3">
                <h6 class="mb-0 fw-bold text-primary"><i class="bi bi-cash-stack me-2"></i>Credit & Financial Terms</h6>
            </div>
            <div class="card-body p-4">
                <div class="row g-3">
                    <div class="col-sm-6">
                        <div class="p-3 bg-light rounded-3 border">
                            <label class="text-muted small fw-semibold d-block">Configured Credit Limit</label>
                            <div class="fs-4 fw-bold text-success">
                                @(Model.Credit_Limit.HasValue && Model.Credit_Limit.Value > 0 ? $"₹{Model.Credit_Limit.Value:N2}" : "No Credit Limit")
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="p-3 bg-light rounded-3 border">
                            <label class="text-muted small fw-semibold d-block">Credit Grace Period</label>
                            <div class="fs-4 fw-bold text-dark">
                                @(Model.Credit_Days.HasValue ? $"{Model.Credit_Days.Value} Days" : "—")
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <label class="text-muted small fw-semibold">Effective From</label>
                        <div class="fw-semibold text-dark"><i class="bi bi-calendar-check text-success me-1"></i>@Model.Effective_From.ToString("dd MMMM yyyy")</div>
                    </div>
                    <div class="col-sm-6">
                        <label class="text-muted small fw-semibold">Effective To</label>
                        <div class="fw-semibold @(isExpired ? "text-danger" : "text-dark")">
                            <i class="bi bi-calendar-x @(isExpired ? "text-danger" : "text-primary") me-1"></i>@Model.Effective_To.ToString("dd MMMM yyyy")
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Right Column: Contact & Audit Trail -->
    <div class="col-lg-4">
        <!-- Contact & Address Card -->
        <div class="card border-0 shadow-sm rounded-3 mb-4">
            <div class="card-header bg-white border-bottom py-3">
                <h6 class="mb-0 fw-bold text-primary"><i class="bi bi-pin-map-fill me-2"></i>Contact Details</h6>
            </div>
            <div class="card-body p-3">
                <ul class="list-group list-group-flush">
                    <li class="list-group-item px-0 py-2 border-0">
                        <div class="text-muted small">Mobile / Phone Number</div>
                        <div class="fw-bold fs-6"><i class="bi bi-telephone-fill text-primary me-2"></i>@Model.Contact_No</div>
                    </li>
                    <li class="list-group-item px-0 py-2 border-0">
                        <div class="text-muted small">Official Email Address</div>
                        <div class="fw-medium">
                            @if (!string.IsNullOrWhiteSpace(Model.Email))
                            {
                                <a href="mailto:@Model.Email" class="text-decoration-none"><i class="bi bi-envelope-at me-2 text-info"></i>@Model.Email</a>
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </div>
                    </li>
                    <li class="list-group-item px-0 py-2 border-0">
                        <div class="text-muted small">Premises Address</div>
                        <div class="small text-dark mt-1">
                            <i class="bi bi-geo-alt-fill text-danger me-1"></i>@(Model.Address ?? "No address recorded")
                        </div>
                    </li>
                    <li class="list-group-item px-0 py-2 border-0">
                        <div class="text-muted small">Pincode</div>
                        <div class="fw-semibold">@(string.IsNullOrWhiteSpace(Model.Pincode) ? "—" : Model.Pincode)</div>
                    </li>
                </ul>
            </div>
        </div>

        <!-- Audit Details Card -->
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-header bg-white border-bottom py-3">
                <h6 class="mb-0 fw-bold text-primary"><i class="bi bi-clock-history me-2"></i>Audit Information</h6>
            </div>
            <div class="card-body p-3">
                <ul class="list-group list-group-flush small">
                    <li class="list-group-item px-0 py-2 border-0 d-flex justify-content-between">
                        <span class="text-muted">Created On:</span>
                        <span class="fw-medium">@Model.CreatedDate.ToString("dd MMM yyyy, hh:mm tt")</span>
                    </li>
                    @if (Model.ModifiedDate.HasValue)
                    {
                        <li class="list-group-item px-0 py-2 border-0 d-flex justify-content-between">
                            <span class="text-muted">Last Modified:</span>
                            <span class="fw-medium">@Model.ModifiedDate.Value.ToString("dd MMM yyyy, hh:mm tt")</span>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </div>
</div>
