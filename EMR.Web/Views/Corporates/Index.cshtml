@model EMR.Web.Models.ViewModels.CorporateIndexViewModel
@{
    ViewData["Title"] = "Corporate Master";
    var total = Model.Corporates.Count;
    var active = Model.Corporates.Count(x => x.Status);
    var inactive = total - active;
    var totalCreditExposure = Model.Corporates.Sum(x => x.Credit_Limit ?? 0);
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h1 class="h3 mb-0 fw-bold">Corporate Master</h1>
        <small class="text-muted">Manage corporate tie-ups, institutional billing, rate agreements, credit limits, and terms</small>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Create" class="btn btn-primary shadow-sm">
            <i class="bi bi-plus-lg me-1"></i>Add Corporate
        </a>
    </div>
</div>

<!-- Stat Cards -->
<div class="row g-3 mb-4">
    <div class="col-12 col-sm-6 col-lg-3">
        <div class="stat-card stat-blue">
            <div class="stat-icon"><i class="bi bi-briefcase-fill"></i></div>
            <div>
                <div class="stat-value">@total</div>
                <div class="stat-label">Total Corporates</div>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-lg-3">
        <div class="stat-card stat-green">
            <div class="stat-icon"><i class="bi bi-check-circle-fill"></i></div>
            <div>
                <div class="stat-value">@active</div>
                <div class="stat-label">Active Tie-ups</div>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-lg-3">
        <div class="stat-card stat-red">
            <div class="stat-icon"><i class="bi bi-x-circle-fill"></i></div>
            <div>
                <div class="stat-value">@inactive</div>
                <div class="stat-label">Inactive</div>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-lg-3">
        <div class="stat-card stat-purple">
            <div class="stat-icon"><i class="bi bi-cash-stack"></i></div>
            <div>
                <div class="stat-value">₹@totalCreditExposure.ToString("N0")</div>
                <div class="stat-label">Total Credit Limit</div>
            </div>
        </div>
    </div>
</div>

<!-- Filter Bar -->
<div class="card border-0 shadow-sm rounded-3 mb-4">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-auto">
                <label class="form-label mb-0 fw-semibold text-muted small"><i class="bi bi-funnel me-1"></i>Filters:</label>
            </div>
            <div class="col-md-3">
                <select name="type" class="form-select form-select-sm" onchange="this.form.submit()">
                    <option value="">-- All Types (IPD/OPD/LAB/MED) --</option>
                    @foreach (var opt in Model.TypeOptions)
                    {
                        <option value="@opt.Value" selected="@opt.Selected">@opt.Text</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <select name="status" class="form-select form-select-sm" onchange="this.form.submit()">
                    <option value="">-- All Status --</option>
                    @foreach (var opt in Model.StatusOptions)
                    {
                        <option value="@opt.Value" selected="@opt.Selected">@opt.Text</option>
                    }
                </select>
            </div>
            <div class="col-md-4">
                <div class="input-group input-group-sm">
                    <input type="text" name="search" class="form-control" placeholder="Search by name, code, contact, billing cycle..." value="@Model.SearchTerm" />
                    <button class="btn btn-outline-primary" type="submit"><i class="bi bi-search"></i> Search</button>
                </div>
            </div>
            @if (!string.IsNullOrWhiteSpace(Model.SelectedType) || Model.SelectedStatus.HasValue || !string.IsNullOrWhiteSpace(Model.SearchTerm))
            {
                <div class="col-auto">
                    <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Clear</a>
                </div>
            }
        </form>
    </div>
</div>

<!-- Data Table -->
<div class="dashboard-panel table-responsive shadow-sm border rounded-3 bg-white">
    <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
            <tr>
                <th style="width: 40px;">#</th>
                <th>Corporate Code</th>
                <th>Corporate Name</th>
                <th>Type</th>
                <th>Validity (From - To)</th>
                <th>Hospital Rates</th>
                <th>Credit Limit</th>
                <th>Credit Days</th>
                <th>Billing Cycle</th>
                <th>Contact</th>
                <th>Status</th>
                <th class="text-end" style="width: 170px;">Actions</th>
            </tr>
        </thead>
        <tbody>
            @{int i = 1;}
            @foreach (var item in Model.Corporates)
            {
                var isExpired = item.Effective_To < DateTime.Today;
                <tr>
                    <td class="text-muted small">@(i++)</td>
                    <td>
                        <span class="badge text-bg-light border text-dark font-monospace">
                            @(string.IsNullOrWhiteSpace(item.Corporate_Code) ? "—" : item.Corporate_Code)
                        </span>
                    </td>
                    <td>
                        <div class="fw-semibold text-dark">
                            <i class="bi bi-briefcase text-primary me-1"></i>@item.Corporate_Name
                        </div>
                        @if (!string.IsNullOrWhiteSpace(item.Address))
                        {
                            <small class="text-muted d-block text-truncate" style="max-width: 200px;" title="@item.Address">
                                <i class="bi bi-geo-alt me-1"></i>@item.Address @(string.IsNullOrWhiteSpace(item.Pincode) ? "" : $"({item.Pincode})")
                            </small>
                        }
                    </td>
                    <td>
                        @{
                            var badgeClass = item.Corporate_Type switch
                            {
                                "IPD" => "bg-primary text-white",
                                "OPD" => "bg-info text-dark",
                                "LAB" => "bg-warning text-dark",
                                "MED" => "bg-success text-white",
                                "GENERAL" => "bg-secondary text-white",
                                _ => "bg-dark text-white"
                            };
                        }
                        <span class="badge @badgeClass">@item.Corporate_Type</span>
                    </td>
                    <td>
                        <div class="small">
                            <span class="fw-medium">@item.Effective_From.ToString("dd MMM yyyy")</span>
                            <span class="text-muted"> to </span>
                            <span class="fw-medium @(isExpired ? "text-danger fw-bold" : "")">
                                @item.Effective_To.ToString("dd MMM yyyy")
                            </span>
                        </div>
                        @if (isExpired)
                        {
                            <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 mt-1">
                                <i class="bi bi-exclamation-triangle me-1"></i>Expired
                            </span>
                        }
                    </td>
                    <td>
                        <!-- Corporate Rates Button with Count Badge -->
                        <button type="button" 
                                class="btn btn-sm btn-outline-info rounded-pill px-2 py-1 shadow-sm d-inline-flex align-items-center gap-1"
                                onclick="openCorporateRatesModal(@item.Corporate_ID, '@Html.Raw(Html.Encode(item.Corporate_Name))', '@item.Corporate_Code')"
                                title="Manage Corporate Hospital Rates">
                            <i class="bi bi-tag-fill text-info"></i>
                            <span class="fw-semibold">Rates</span>
                            <span class="badge bg-info text-dark rounded-pill" id="badge-rate-count-@item.Corporate_ID">
                                @item.RatesCount
                            </span>
                        </button>
                    </td>
                    <td>
                        @if (item.Credit_Limit.HasValue && item.Credit_Limit.Value > 0)
                        {
                            <span class="fw-semibold text-success">₹@item.Credit_Limit.Value.ToString("N2")</span>
                        }
                        else
                        {
                            <span class="text-muted small">No Limit</span>
                        }
                    </td>
                    <td>
                        @if (item.Credit_Days.HasValue && item.Credit_Days.Value > 0)
                        {
                            <span class="badge bg-light text-dark border font-monospace">@item.Credit_Days Days</span>
                        }
                        else
                        {
                            <span class="text-muted small">—</span>
                        }
                    </td>
                    <td>
                        <span class="badge bg-secondary bg-opacity-10 text-dark border">
                            <i class="bi bi-arrow-repeat me-1"></i>@item.BillingCycle
                        </span>
                    </td>
                    <td>
                        <div class="small fw-semibold"><i class="bi bi-telephone text-muted me-1"></i>@item.Contact_No</div>
                        @if (!string.IsNullOrWhiteSpace(item.Email))
                        {
                            <div class="small text-muted text-truncate" style="max-width: 130px;" title="@item.Email">
                                <i class="bi bi-envelope me-1"></i>@item.Email
                            </div>
                        }
                    </td>
                    <td>
                        @if (item.Status)
                        {
                            <span class="badge text-bg-success">Active</span>
                        }
                        else
                        {
                            <span class="badge text-bg-secondary">Inactive</span>
                        }
                    </td>
                    <td class="text-end">
                        <a asp-action="Details" asp-route-id="@item.Corporate_ID"
                           class="btn btn-sm btn-outline-secondary me-1" title="View Details">
                            <i class="bi bi-eye"></i>
                        </a>
                        <a asp-action="Edit" asp-route-id="@item.Corporate_ID"
                           class="btn btn-sm btn-outline-primary me-1" title="Edit Corporate">
                            <i class="bi bi-pencil"></i>
                        </a>
                        <form asp-action="Delete" asp-route-id="@item.Corporate_ID" method="post" class="d-inline"
                              onsubmit="return confirm('Are you sure you want to delete @item.Corporate_Name?');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete">
                                <i class="bi bi-trash"></i>
                            </button>
                        </form>
                    </td>
                </tr>
            }
            @if (!Model.Corporates.Any())
            {
                <tr>
                    <td colspan="12" class="text-center text-muted py-5">
                        <i class="bi bi-briefcase fs-1 d-block mb-2 opacity-50"></i>
                        No corporate tie-ups found. <a asp-action="Create" class="fw-bold">Add your first corporate tie-up.</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- ========================================================================= -->
<!-- CORPORATE HOSPITAL RATE MASTER INTEGRATED MODAL (No separate page needed) -->
<!-- ========================================================================= -->
<div class="modal fade" id="corporateRatesModal" tabindex="-1" aria-labelledby="corporateRatesModalLabel" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content border-0 shadow-lg">
            
            <!-- Modal Header -->
            <div class="modal-header bg-primary text-white py-3 px-4">
                <div class="d-flex align-items-center gap-2 overflow-hidden me-auto">
                    <i class="bi bi-tag-fill fs-4 text-warning flex-shrink-0"></i>
                    <div class="text-truncate">
                        <h5 class="modal-title fw-bold mb-0 text-truncate" id="corporateRatesModalLabel">Corporate Hospital Rate Master</h5>
                        <small class="text-white-50 d-block text-truncate" id="modalCorpSubtitle">Managing rate agreements</small>
                    </div>
                </div>
                <button type="button" class="btn-close btn-close-white ms-3 flex-shrink-0" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <!-- Modal Body -->
            <div class="modal-body p-4 bg-light">

                <!-- Alert Message container -->
                <div id="rateModalAlert" class="alert d-none py-2 px-3 mb-3 small" role="alert"></div>

                <!-- ADD / EDIT RATE FORM CARD (Accordion / Toggleable) -->
                <div class="card border-0 shadow-sm rounded-3 mb-4 d-none" id="rateFormCard">
                    <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
                        <div class="fw-bold text-primary" id="formCardTitle">
                            <i class="bi bi-plus-square-fill me-2"></i>New Corporate Hospital Rate Rule
                        </div>
                        <button type="button" class="btn btn-sm btn-link text-muted p-0 text-decoration-none" onclick="toggleRateForm(false)">
                            <i class="bi bi-x-lg"></i> Close Form
                        </button>
                    </div>
                    <div class="card-body p-4 bg-white">
                        <form id="corporateRateForm" onsubmit="handleSaveCorporateRate(event)">
                            <input type="hidden" id="formCorpRateId" value="0" />
                            <input type="hidden" id="formCorporateId" value="0" />

                            <div class="row g-3">
                                <!-- 1. Rate Service Type (Head: Room, Procedure, OT, ICU, HospitalService, Package) -->
                                <div class="col-md-4">
                                    <label class="form-label fw-bold small text-dark">
                                        Rate Service Type (Head) <span class="text-danger">*</span>
                                    </label>
                                    <select id="formRateServiceType" class="form-select form-select-sm" onchange="onRateServiceTypeChange()" required>
                                        <option value="Procedure" selected>Procedure (Surgical & Clinical)</option>
                                        <option value="Room">Room (Bed / Accommodation)</option>
                                        <option value="OT">OT (Operation Theatre)</option>
                                        <option value="ICU">ICU (Intensive Care)</option>
                                        <option value="HospitalService">Hospital Service (General / Diagnostics)</option>
                                        <option value="Package">Package (Comprehensive Hospital Packages)</option>
                                    </select>
                                    <small class="text-muted extra-small">Select the service department / category head</small>
                                </div>

                                <!-- 2. Reference Master Item (Dynamic Dropdown from selected Head) -->
                                <div class="col-md-5">
                                    <label class="form-label fw-bold small text-dark">
                                        Master Service Item <span class="text-danger">*</span>
                                    </label>
                                    <select id="formReferenceMasterId" class="form-select form-select-sm" onchange="onMasterItemSelectChange()" required>
                                        <option value="">-- Loading items... --</option>
                                    </select>
                                    <small class="text-muted extra-small" id="selectedBaseRateNote">
                                        Standard Rate: <span class="fw-bold text-dark" id="baseRateDisplay">₹0.00</span>
                                    </small>
                                </div>

                                <!-- 3. Rate Type (Percentage / Rate / Both) -->
                                <div class="col-md-3">
                                    <label class="form-label fw-bold small text-dark">
                                        Rate Type <span class="text-danger">*</span>
                                    </label>
                                    <select id="formRateType" class="form-select form-select-sm" onchange="onRateTypeChange()" required>
                                        <option value="Percentage" selected>Percentage (Discount %)</option>
                                        <option value="Rate">Rate (Fixed Contracted ₹)</option>
                                        <option value="Both">Both (Contracted ₹ & Discount %)</option>
                                    </select>
                                    <small class="text-muted extra-small">Determines billing discount/fixed rate</small>
                                </div>

                                <!-- 4. Contracted Rate Input (Visible if Rate or Both) -->
                                <div class="col-md-3" id="colRateInput">
                                    <label class="form-label fw-bold small text-dark">
                                        Contracted Rate (₹) <span class="text-danger">*</span>
                                    </label>
                                    <div class="input-group input-group-sm">
                                        <span class="input-group-text bg-light fw-bold">₹</span>
                                        <input type="number" id="formRate" class="form-control" placeholder="0.00" step="0.01" min="0" />
                                    </div>
                                    <small class="text-muted extra-small">Special agreed amount</small>
                                </div>

                                <!-- 5. Discount Percent Input (Visible if Percentage or Both) -->
                                <div class="col-md-3" id="colDiscountPercentInput">
                                    <label class="form-label fw-bold small text-dark">
                                        Discount Percent (%) <span class="text-danger">*</span>
                                    </label>
                                    <div class="input-group input-group-sm">
                                        <input type="number" id="formDiscountPercent" class="form-control" placeholder="0.00" step="0.01" min="0" max="100" />
                                        <span class="input-group-text bg-light fw-bold">%</span>
                                    </div>
                                    <small class="text-muted extra-small">Discount off standard rate</small>
                                </div>

                                <!-- 6. Effective From -->
                                <div class="col-md-3">
                                    <label class="form-label fw-bold small text-dark">
                                        Effective From <span class="text-danger">*</span>
                                    </label>
                                    <input type="date" id="formEffectiveFrom" class="form-control form-control-sm" required />
                                </div>

                                <!-- 7. Effective To -->
                                <div class="col-md-3">
                                    <label class="form-label fw-bold small text-dark">
                                        Effective To <span class="text-danger">*</span>
                                    </label>
                                    <input type="date" id="formEffectiveTo" class="form-control form-control-sm" required />
                                </div>

                                <!-- 8. Status & Action Buttons -->
                                <div class="col-12 d-flex justify-content-between align-items-center pt-2 border-top">
                                    <div class="form-check form-switch">
                                        <input class="form-check-input" type="checkbox" role="switch" id="formStatus" checked />
                                        <label class="form-check-label fw-semibold small" for="formStatus">Rule Active</label>
                                    </div>
                                    <div class="d-flex gap-2">
                                        <button type="button" class="btn btn-sm btn-outline-secondary" onclick="toggleRateForm(false)">
                                            Cancel
                                        </button>
                                        <button type="submit" class="btn btn-sm btn-primary px-4 fw-semibold shadow-sm" id="btnSaveRate">
                                            <i class="bi bi-check2-circle me-1"></i>Save Rate Rule
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>

                <!-- KPI Summary Pills for Rates -->
                <div class="row g-2 mb-3">
                    <div class="col-auto">
                        <span class="badge bg-white text-dark border px-3 py-2 shadow-sm fs-7">
                            Total Rules: <strong class="text-primary ms-1" id="statTotalRates">0</strong>
                        </span>
                    </div>
                    <div class="col-auto">
                        <span class="badge bg-white text-dark border px-3 py-2 shadow-sm fs-7">
                            Discount Rules (%): <strong class="text-info ms-1" id="statDiscountRates">0</strong>
                        </span>
                    </div>
                    <div class="col-auto">
                        <span class="badge bg-white text-dark border px-3 py-2 shadow-sm fs-7">
                            Fixed Rate Rules (₹): <strong class="text-success ms-1" id="statFixedRates">0</strong>
                        </span>
                    </div>
                    <div class="col-auto">
                        <span class="badge bg-white text-dark border px-3 py-2 shadow-sm fs-7">
                            Active Rules: <strong class="text-success ms-1" id="statActiveRates">0</strong>
                        </span>
                    </div>
                </div>

                <!-- Rate Rules List Filter Tabs & Action Toolbar -->
                <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                    <ul class="nav nav-pills nav-pills-sm bg-white p-1 rounded border shadow-sm" id="rateHeadTabs">
                        <li class="nav-item">
                            <a class="nav-link active py-1 px-3 small fw-medium" href="javascript:void(0)" onclick="filterRatesByHead('ALL', this)">All Heads</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link py-1 px-3 small fw-medium" href="javascript:void(0)" onclick="filterRatesByHead('Procedure', this)">Procedure</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link py-1 px-3 small fw-medium" href="javascript:void(0)" onclick="filterRatesByHead('Room', this)">Room</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link py-1 px-3 small fw-medium" href="javascript:void(0)" onclick="filterRatesByHead('OT', this)">OT</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link py-1 px-3 small fw-medium" href="javascript:void(0)" onclick="filterRatesByHead('ICU', this)">ICU</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link py-1 px-3 small fw-medium" href="javascript:void(0)" onclick="filterRatesByHead('HospitalService', this)">Hospital Service</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link py-1 px-3 small fw-medium" href="javascript:void(0)" onclick="filterRatesByHead('Package', this)">Package</a>
                        </li>
                    </ul>

                    <div class="d-flex align-items-center gap-2">
                        <div class="input-group input-group-sm" style="width: 200px;">
                            <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                            <input type="text" id="rateSearchInput" class="form-control border-start-0" placeholder="Filter items..." onkeyup="filterRateTableRows()" />
                        </div>
                        <button type="button" class="btn btn-primary btn-sm fw-semibold shadow-sm d-flex align-items-center gap-1" id="btnToggleRateForm" onclick="toggleRateForm(true)">
                            <i class="bi bi-plus-circle-fill me-1"></i>Add Rate Rule
                        </button>
                    </div>
                </div>

                <!-- Rate Rules Data Table -->
                <div class="table-responsive bg-white rounded-3 border shadow-sm">
                    <table class="table table-hover align-middle mb-0" id="corporateRatesTable">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 40px;">#</th>
                                <th>Service Head</th>
                                <th>Service Item Code & Name</th>
                                <th>Hospital Base Rate</th>
                                <th>Rate Type</th>
                                <th>Agreed Rate / Discount</th>
                                <th>Validity Period</th>
                                <th>Status</th>
                                <th class="text-end" style="width: 120px;">Actions</th>
                            </tr>
                        </thead>
                        <tbody id="ratesTableBody">
                            <tr>
                                <td colspan="9" class="text-center py-4 text-muted">
                                    <div class="spinner-border spinner-border-sm text-primary me-2" role="status"></div>
                                    Loading corporate rates...
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>

            </div>

            <!-- Modal Footer -->
            <div class="modal-footer bg-white border-top py-2">
                <button type="button" class="btn btn-outline-secondary btn-sm px-3" data-bs-dismiss="modal">
                    Close
                </button>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <style>
        .fs-7 { font-size: 0.85rem; }
        .extra-small { font-size: 0.75rem; }
        .nav-pills .nav-link.active {
            background-color: var(--bs-primary);
            color: #fff;
        }
        .nav-pills .nav-link {
            color: #495057;
            border-radius: 4px;
        }
    </style>

    <script>
        let currentCorporateId = 0;
        let currentCorporateName = '';
        let currentCorporateCode = '';
        let masterItemsCache = {};
        let loadedRates = [];
        let currentHeadFilter = 'ALL';

        // 1. Open Corporate Rates Modal
        function openCorporateRatesModal(corporateId, corporateName, corporateCode) {
            currentCorporateId = corporateId;
            currentCorporateName = corporateName;
            currentCorporateCode = corporateCode;

            document.getElementById('corporateRatesModalLabel').innerHTML = 
                `Corporate Rates: <span class="text-warning">${corporateName}</span>`;
            document.getElementById('modalCorpSubtitle').innerText = 
                `Corporate Code: ${corporateCode || '—'} | Scoped Rates & Discounts`;

            toggleRateForm(false);
            loadCorporateRates();

            const modal = new bootstrap.Modal(document.getElementById('corporateRatesModal'));
            modal.show();
        }

        // 2. Load Rates for Current Corporate via AJAX
        async function loadCorporateRates() {
            const tbody = document.getElementById('ratesTableBody');
            tbody.innerHTML = `
                <tr>
                    <td colspan="9" class="text-center py-4 text-muted">
                        <div class="spinner-border spinner-border-sm text-primary me-2" role="status"></div>
                        Loading agreed rates...
                    </td>
                </tr>`;

            try {
                const response = await fetch(`/Corporates/GetCorporateRates?corporateId=${currentCorporateId}`);
                const result = await response.json();

                if (result.success) {
                    loadedRates = result.data || [];
                    renderRatesTable();
                    updateRatesKPIs();
                    // Update count badge on parent table
                    const badge = document.getElementById(`badge-rate-count-${currentCorporateId}`);
                    if (badge) badge.innerText = loadedRates.length;
                } else {
                    tbody.innerHTML = `<tr><td colspan="9" class="text-center text-danger py-3">${result.message || 'Failed to load rates.'}</td></tr>`;
                }
            } catch (err) {
                tbody.innerHTML = `<tr><td colspan="9" class="text-center text-danger py-3">Error connecting to server.</td></tr>`;
            }
        }

        // 3. Render Rates Table with Filters
        function renderRatesTable() {
            const tbody = document.getElementById('ratesTableBody');
            const search = (document.getElementById('rateSearchInput').value || '').toLowerCase();

            const filtered = loadedRates.filter(r => {
                const matchHead = (currentHeadFilter === 'ALL' || r.rateServiceType.toLowerCase() === currentHeadFilter.toLowerCase());
                const matchSearch = !search || 
                    (r.itemName && r.itemName.toLowerCase().includes(search)) ||
                    (r.itemCode && r.itemCode.toLowerCase().includes(search)) ||
                    (r.rateServiceType && r.rateServiceType.toLowerCase().includes(search)) ||
                    (r.rateType && r.rateType.toLowerCase().includes(search));
                return matchHead && matchSearch;
            });

            if (filtered.length === 0) {
                tbody.innerHTML = `
                    <tr>
                        <td colspan="9" class="text-center py-5 text-muted">
                            <i class="bi bi-tag fs-2 d-block mb-1 opacity-50"></i>
                            No rate rules configured for this filter. Click <strong>"Add Rate Rule"</strong> to create one.
                        </td>
                    </tr>`;
                return;
            }

            let html = '';
            filtered.forEach((r, idx) => {
                const headBadgeClass = getHeadBadgeClass(r.rateServiceType);
                const rateTypeBadgeClass = r.rateType === 'Percentage' ? 'bg-info text-dark' : (r.rateType === 'Rate' ? 'bg-success text-white' : 'bg-primary text-white');
                const fromDate = new Date(r.effective_From).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });
                const toDate = new Date(r.effective_To).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });
                const isExpired = new Date(r.effective_To) < new Date();

                // Format Agreed Value
                let agreedValueHtml = '';
                if (r.rateType === 'Percentage') {
                    agreedValueHtml = `<span class="badge bg-info bg-opacity-10 text-info border border-info fw-bold fs-7">${r.discountPercent || 0}% OFF</span>`;
                } else if (r.rateType === 'Rate') {
                    agreedValueHtml = `<span class="fw-bold text-success fs-7">₹${(r.rate || 0).toLocaleString('en-IN', { minimumFractionDigits: 2 })}</span>`;
                } else {
                    agreedValueHtml = `
                        <div class="fw-bold text-success fs-7">₹${(r.rate || 0).toLocaleString('en-IN', { minimumFractionDigits: 2 })}</div>
                        <small class="text-info fw-semibold">(${r.discountPercent || 0}% Disc)</small>`;
                }

                html += `
                    <tr>
                        <td class="text-muted small">${idx + 1}</td>
                        <td>
                            <span class="badge ${headBadgeClass}">${r.rateServiceType}</span>
                        </td>
                        <td>
                            <div class="fw-semibold text-dark">${r.itemName || 'Service Item #' + r.referenceMaster_ID}</div>
                            <span class="badge bg-light text-dark border font-monospace extra-small">${r.itemCode || '—'}</span>
                        </td>
                        <td>
                            <span class="text-muted small">₹${(r.standardBaseRate || 0).toLocaleString('en-IN', { minimumFractionDigits: 2 })}</span>
                        </td>
                        <td>
                            <span class="badge ${rateTypeBadgeClass}">${r.rateType}</span>
                        </td>
                        <td>
                            ${agreedValueHtml}
                        </td>
                        <td>
                            <div class="small">
                                <span class="text-dark">${fromDate}</span>
                                <span class="text-muted"> to </span>
                                <span class="${isExpired ? 'text-danger fw-bold' : 'text-dark'}">${toDate}</span>
                            </div>
                        </td>
                        <td>
                            <div class="form-check form-switch m-0">
                                <input class="form-check-input" type="checkbox" role="switch" ${r.status ? 'checked' : ''} 
                                       onchange="handleToggleRateStatus(${r.corpRate_ID})" title="${r.status ? 'Deactivate' : 'Activate'}" />
                            </div>
                        </td>
                        <td class="text-end">
                            <button type="button" class="btn btn-sm btn-outline-primary me-1" onclick="editRateRule(${r.corpRate_ID})" title="Edit Rate Rule">
                                <i class="bi bi-pencil"></i>
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-danger" onclick="deleteRateRule(${r.corpRate_ID})" title="Delete Rate Rule">
                                <i class="bi bi-trash"></i>
                            </button>
                        </td>
                    </tr>`;
            });

            tbody.innerHTML = html;
        }

        function getHeadBadgeClass(head) {
            switch (head) {
                case 'Room': return 'bg-secondary text-white';
                case 'Procedure': return 'bg-primary text-white';
                case 'OT': return 'bg-warning text-dark';
                case 'ICU': return 'bg-danger text-white';
                case 'HospitalService': return 'bg-info text-dark';
                case 'Package': return 'bg-success text-white';
                default: return 'bg-dark text-white';
            }
        }

        // 4. Update Summary KPIs
        function updateRatesKPIs() {
            document.getElementById('statTotalRates').innerText = loadedRates.length;
            document.getElementById('statDiscountRates').innerText = loadedRates.filter(r => r.rateType === 'Percentage' || r.rateType === 'Both').length;
            document.getElementById('statFixedRates').innerText = loadedRates.filter(r => r.rateType === 'Rate' || r.rateType === 'Both').length;
            document.getElementById('statActiveRates').innerText = loadedRates.filter(r => r.status).length;
        }

        // 5. Head Filter Tabs
        function filterRatesByHead(head, el) {
            currentHeadFilter = head;
            document.querySelectorAll('#rateHeadTabs .nav-link').forEach(l => l.classList.remove('active'));
            el.classList.add('active');
            renderRatesTable();
        }

        function filterRateTableRows() {
            renderRatesTable();
        }

        // 6. Form Visibility & State
        function toggleRateForm(show, isEdit = false) {
            const card = document.getElementById('rateFormCard');
            const btn = document.getElementById('btnToggleRateForm');

            if (show) {
                card.classList.remove('d-none');
                btn.classList.add('d-none');
                if (!isEdit) {
                    resetRateForm();
                }
            } else {
                card.classList.add('d-none');
                btn.classList.remove('d-none');
                resetRateForm();
            }
        }

        function resetRateForm() {
            document.getElementById('formCorpRateId').value = '0';
            document.getElementById('formCorporateId').value = currentCorporateId;
            document.getElementById('formCardTitle').innerHTML = '<i class="bi bi-plus-square-fill me-2"></i>New Corporate Hospital Rate Rule';
            document.getElementById('formRateServiceType').value = 'Procedure';
            document.getElementById('formRateType').value = 'Percentage';
            document.getElementById('formRate').value = '';
            document.getElementById('formDiscountPercent').value = '';
            
            // Set today to 1 year
            const today = new Date().toISOString().split('T')[0];
            const nextYear = new Date();
            nextYear.setFullYear(nextYear.getFullYear() + 1);
            document.getElementById('formEffectiveFrom').value = today;
            document.getElementById('formEffectiveTo').value = nextYear.toISOString().split('T')[0];
            document.getElementById('formStatus').checked = true;

            onRateServiceTypeChange();
            onRateTypeChange();
        }

        // 7. Dynamic Service Head selection -> load Master Items
        async function onRateServiceTypeChange(preSelectId = null) {
            const head = document.getElementById('formRateServiceType').value;
            const select = document.getElementById('formReferenceMasterId');
            select.innerHTML = '<option value="">Loading services...</option>';

            if (!masterItemsCache[head]) {
                try {
                    const res = await fetch(`/Corporates/GetMasterServiceItems?serviceType=${encodeURIComponent(head)}`);
                    const json = await res.json();
                    if (json.success) {
                        masterItemsCache[head] = json.data || [];
                    } else {
                        masterItemsCache[head] = [];
                    }
                } catch {
                    masterItemsCache[head] = [];
                }
            }

            const items = masterItemsCache[head] || [];
            if (items.length === 0) {
                select.innerHTML = '<option value="">No items found for this head</option>';
                document.getElementById('baseRateDisplay').innerText = '₹0.00';
                return;
            }

            let optHtml = '<option value="">-- Select Service Item --</option>';
            items.forEach(it => {
                const sel = (preSelectId && it.referenceMaster_ID === preSelectId) ? 'selected' : '';
                optHtml += `<option value="${it.referenceMaster_ID}" data-rate="${it.baseRate}" ${sel}>${it.itemCode ? '[' + it.itemCode + '] ' : ''}${it.itemName} (₹${it.baseRate.toLocaleString('en-IN')})</option>`;
            });
            select.innerHTML = optHtml;

            onMasterItemSelectChange();
        }

        function onMasterItemSelectChange() {
            const select = document.getElementById('formReferenceMasterId');
            const selectedOpt = select.options[select.selectedIndex];
            const baseRate = selectedOpt ? parseFloat(selectedOpt.getAttribute('data-rate') || '0') : 0;
            document.getElementById('baseRateDisplay').innerText = `₹${baseRate.toLocaleString('en-IN', { minimumFractionDigits: 2 })}`;
        }

        // 8. Rate Type Change (Percentage vs Rate vs Both)
        function onRateTypeChange() {
            const type = document.getElementById('formRateType').value;
            const colRate = document.getElementById('colRateInput');
            const colDisc = document.getElementById('colDiscountPercentInput');
            const rateInput = document.getElementById('formRate');
            const discInput = document.getElementById('formDiscountPercent');

            if (type === 'Rate') {
                colRate.classList.remove('d-none');
                colDisc.classList.add('d-none');
                rateInput.required = true;
                discInput.required = false;
                discInput.value = '';
            } else if (type === 'Percentage') {
                colRate.classList.add('d-none');
                colDisc.classList.remove('d-none');
                rateInput.required = false;
                discInput.required = true;
                rateInput.value = '';
            } else { // Both
                colRate.classList.remove('d-none');
                colDisc.classList.remove('d-none');
                rateInput.required = true;
                discInput.required = true;
            }
        }

        // 9. Save Rate Rule (Create / Update)
        async function handleSaveCorporateRate(e) {
            e.preventDefault();

            const corpRateId = parseInt(document.getElementById('formCorpRateId').value) || 0;
            const refMasterId = parseInt(document.getElementById('formReferenceMasterId').value) || 0;
            const rateType = document.getElementById('formRateType').value;
            const rateVal = document.getElementById('formRate').value ? parseFloat(document.getElementById('formRate').value) : null;
            const discVal = document.getElementById('formDiscountPercent').value ? parseFloat(document.getElementById('formDiscountPercent').value) : null;
            const effFrom = document.getElementById('formEffectiveFrom').value;
            const effTo = document.getElementById('formEffectiveTo').value;

            if (!refMasterId) {
                showAlert('Please select a master service item.', 'danger');
                return;
            }

            if (effTo < effFrom) {
                showAlert('Effective To date cannot be earlier than Effective From date.', 'danger');
                return;
            }

            const payload = {
                CorpRate_ID: corpRateId,
                Corporate_ID: currentCorporateId,
                RateServiceType: document.getElementById('formRateServiceType').value,
                ReferenceMaster_ID: refMasterId,
                RateType: rateType,
                Rate: rateVal,
                DiscountPercent: discVal,
                Effective_From: effFrom,
                Effective_To: effTo,
                Status: document.getElementById('formStatus').checked
            };

            const btn = document.getElementById('btnSaveRate');
            const originalHtml = btn.innerHTML;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Saving...';
            btn.disabled = true;

            try {
                const res = await fetch('/Corporates/SaveCorporateRate', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
                const result = await res.json();

                if (result.success) {
                    showAlert(result.message || 'Corporate rate rule saved successfully!', 'success');
                    toggleRateForm(false);
                    await loadCorporateRates();
                } else {
                    showAlert(result.message || 'Failed to save rate rule.', 'danger');
                }
            } catch (err) {
                showAlert('Error submitting request: ' + err.message, 'danger');
            } finally {
                btn.innerHTML = originalHtml;
                btn.disabled = false;
            }
        }

        // 10. Edit Rate Rule
        async function editRateRule(rateId) {
            try {
                const res = await fetch(`/Corporates/GetCorporateRate?id=${rateId}`);
                const result = await res.json();
                if (!result.success || !result.data) {
                    showAlert('Failed to retrieve rate rule details.', 'danger');
                    return;
                }

                const r = result.data;
                toggleRateForm(true, true);

                document.getElementById('formCorpRateId').value = r.corpRate_ID;
                document.getElementById('formCorporateId').value = r.corporate_ID;
                document.getElementById('formCardTitle').innerHTML = `<i class="bi bi-pencil-square me-2"></i>Edit Rate Rule [#${r.corpRate_ID}]`;
                document.getElementById('formRateServiceType').value = r.rateServiceType;
                document.getElementById('formRateType').value = r.rateType;
                document.getElementById('formRate').value = r.rate != null ? r.rate : '';
                document.getElementById('formDiscountPercent').value = r.discountPercent != null ? r.discountPercent : '';
                document.getElementById('formEffectiveFrom').value = r.effective_From.split('T')[0];
                document.getElementById('formEffectiveTo').value = r.effective_To.split('T')[0];
                document.getElementById('formStatus').checked = r.status;

                onRateTypeChange();
                await onRateServiceTypeChange(r.referenceMaster_ID);

                // Scroll smoothly to form
                document.getElementById('rateFormCard').scrollIntoView({ behavior: 'smooth' });
            } catch (err) {
                showAlert('Error: ' + err.message, 'danger');
            }
        }

        // 11. Toggle Status
        async function handleToggleRateStatus(rateId) {
            try {
                const res = await fetch(`/Corporates/ToggleRateStatus?id=${rateId}`, { method: 'POST' });
                const result = await res.json();
                if (result.success) {
                    await loadCorporateRates();
                } else {
                    showAlert(result.message || 'Failed to toggle status.', 'danger');
                }
            } catch (err) {
                showAlert('Error updating status: ' + err.message, 'danger');
            }
        }

        // 12. Delete Rate Rule
        async function deleteRateRule(rateId) {
            if (!confirm('Are you sure you want to delete this Corporate Rate rule?')) return;

            try {
                const res = await fetch(`/Corporates/DeleteCorporateRate?id=${rateId}`, { method: 'POST' });
                const result = await res.json();
                if (result.success) {
                    showAlert(result.message || 'Rate rule deleted successfully.', 'success');
                    await loadCorporateRates();
                } else {
                    showAlert(result.message || 'Failed to delete rate rule.', 'danger');
                }
            } catch (err) {
                showAlert('Error deleting rate rule: ' + err.message, 'danger');
            }
        }

        // Alert helper
        function showAlert(msg, type = 'info') {
            const alertBox = document.getElementById('rateModalAlert');
            alertBox.className = `alert alert-${type} py-2 px-3 mb-3 small`;
            alertBox.innerHTML = `<i class="bi ${type === 'success' ? 'bi-check-circle-fill' : 'bi-exclamation-triangle-fill'} me-2"></i>${msg}`;
            alertBox.classList.remove('d-none');
            setTimeout(() => { alertBox.classList.add('d-none'); }, 5000);
        }
    </script>
}
