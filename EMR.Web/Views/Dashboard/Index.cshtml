@model EMR.Web.Models.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="dashboard-page">
    <div class="dashboard-hero-card mb-4">
        <div class="dashboard-hero-content">
            <div>
                @if (!string.IsNullOrWhiteSpace(Model.CompanyName))
                {
                    <div class="text-white-50 small mb-1 fw-semibold text-uppercase d-flex align-items-center gap-2" style="font-size: 0.82rem; letter-spacing: 0.05em;">
                        <span><i class="bi bi-buildings-fill text-warning me-1"></i>@Model.CompanyName</span>
                        @if (!string.IsNullOrWhiteSpace(Model.CompanyCode))
                        {
                            <span class="badge bg-white bg-opacity-25 text-white border border-white border-opacity-25 font-monospace" style="font-size: 0.72rem;">@Model.CompanyCode</span>
                        }
                    </div>
                }
                <h1 class="dashboard-title text-white mb-2">@Model.CurrentHospitalName Dashboard</h1>
                <p class="dashboard-hero-subtitle mb-3">Welcome back, @Model.UserDisplayName!</p>
                <div class="d-flex flex-wrap align-items-center gap-3">
                    <div class="d-flex align-items-center gap-2">
                        <span class="dashboard-hero-label" style="font-size: 0.95rem;">Company:</span>
                        <span class="dashboard-hero-pill" style="font-size: 0.92rem; padding: 0.2rem 0.75rem; background: rgba(255, 255, 255, 0.18); color: #ffffff; border: 1px solid rgba(255, 255, 255, 0.3);">
                            <i class="bi bi-buildings me-1 text-warning"></i>@Model.CompanyName
                        </span>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <span class="dashboard-hero-label" style="font-size: 0.95rem;">Active Branch:</span>
                        <span class="dashboard-hero-pill" style="font-size: 0.92rem; padding: 0.2rem 0.75rem;">
                            <i class="bi bi-geo-alt-fill me-1"></i>@Model.CurrentBranchName
                        </span>
                    </div>
                </div>
            </div>

        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-12 col-md-6 col-xl-3">
            <div class="kpi-card kpi-blue">
                <div class="d-flex justify-content-between align-items-start mb-4">
                    <span>Total Patients</span>
                    <i class="bi bi-people-fill"></i>
                </div>
                <h2>@Model.TotalUsers</h2>
                <small>Registered users in EMR</small>
            </div>
        </div>
        <div class="col-12 col-md-6 col-xl-3">
            <div class="kpi-card kpi-red">
                <div class="d-flex justify-content-between align-items-start mb-4">
                    <span>OPD Visits</span>
                    <i class="bi bi-clipboard2-pulse-fill"></i>
                </div>
                <h2>@(Model.ActiveMappings + Model.TotalBranches)</h2>
                <small>Today consultation queue</small>
            </div>
        </div>
        <div class="col-12 col-md-6 col-xl-3">
            <div class="kpi-card kpi-yellow">
                <div class="d-flex justify-content-between align-items-start mb-4">
                    <span>IPD Admissions</span>
                    <i class="bi bi-hospital-fill"></i>
                </div>
                <h2>@Model.TotalBranches</h2>
                <small>Active branches admitting</small>
            </div>
        </div>
        <div class="col-12 col-md-6 col-xl-3">
            <div class="kpi-card kpi-green">
                <div class="d-flex justify-content-between align-items-start mb-4">
                    <span>Active Mappings</span>
                    <i class="bi bi-diagram-3-fill"></i>
                </div>
                <h2>@Model.ActiveMappings</h2>
                <small>User-branch assignments</small>
            </div>
        </div>
    </div>

    <div class="dashboard-panel">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h3 class="h5 m-0">Today's Checkouts</h3>
            <a class="link-primary text-decoration-none fw-semibold" href="#">View All</a>
        </div>
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Patient ID</th>
                        <th>Name</th>
                        <th>Department</th>
                        <th>Doctor</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>EMR-1021</td>
                        <td>Rohit Sharma</td>
                        <td>OPD</td>
                        <td>Dr. Mehta</td>
                        <td><span class="badge text-bg-success">Completed</span></td>
                    </tr>
                    <tr>
                        <td>EMR-1022</td>
                        <td>Anita Das</td>
                        <td>IPD</td>
                        <td>Dr. Khan</td>
                        <td><span class="badge text-bg-warning">In Progress</span></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>
