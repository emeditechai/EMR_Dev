@model EMR.Web.Models.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}


@functions {
    /// <summary>"12 minutes ago", "3 hours ago", "2 days ago" - plain words, no library.</summary>
    public static string Ago(DateTime when)
    {
        var span = DateTime.Now - when;
        if (span.TotalSeconds < 0) { return when.ToString("dd MMM yyyy, hh:mm tt"); }
        if (span.TotalMinutes < 1) { return "just now"; }
        if (span.TotalMinutes < 60) { var m = (int)span.TotalMinutes; return $"{m} minute{(m == 1 ? "" : "s")} ago"; }
        if (span.TotalHours < 24) { var h = (int)span.TotalHours; return $"{h} hour{(h == 1 ? "" : "s")} ago"; }
        if (span.TotalDays < 30) { var d = (int)span.TotalDays; return $"{d} day{(d == 1 ? "" : "s")} ago"; }
        return when.ToString("dd MMM yyyy");
    }

    /// <summary>Names the address people would recognise instead of showing a bare loopback or private IP.</summary>
    public static string WhereFrom(string? ip)
    {
        if (string.IsNullOrWhiteSpace(ip)) { return "Not recorded"; }
        ip = ip.Trim();
        if (ip is "::1" or "0:0:0:0:0:0:0:1") { ip = "127.0.0.1"; }
        if (ip.StartsWith("::ffff:", StringComparison.OrdinalIgnoreCase)) { ip = ip[7..]; }

        if (ip == "127.0.0.1" || ip.StartsWith("127.")) { return "This computer (127.0.0.1)"; }
        if (ip.StartsWith("10.") || ip.StartsWith("192.168.")) { return $"{ip} · office network"; }
        if (ip.StartsWith("172."))
        {
            var parts = ip.Split('.');
            if (parts.Length > 1 && int.TryParse(parts[1], out var second) && second >= 16 && second <= 31)
            {
                return $"{ip} · office network";
            }
        }
        return ip;
    }
}

<style>
    .info-card { display: flex; flex-direction: column; gap: .5rem; }
    .info-head { display: flex; align-items: center; gap: .75rem; padding-bottom: .75rem; border-bottom: 1px solid #eef1f7; margin-bottom: .25rem; }
    .info-icon { width: 42px; height: 42px; border-radius: 12px; display: inline-flex; align-items: center; justify-content: center; font-size: 1.2rem; flex-shrink: 0; }
    .info-value { font-size: 1.55rem; font-weight: 700; color: #0f172a; line-height: 1.2; font-variant-numeric: tabular-nums; }
    .info-value span { font-size: 1.05rem; font-weight: 600; color: #475569; margin-left: .5rem; }
    .info-ago { font-size: .82rem; color: #64748b; }
    .info-desc { margin: .35rem 0 0; font-size: .88rem; color: #1e293b; }
    .info-list { display: grid; grid-template-columns: auto 1fr; gap: .3rem .9rem; margin: .65rem 0 0; font-size: .85rem; }
    .info-list dt { color: #64748b; font-weight: 600; }
    .info-list dd { margin: 0; color: #0f172a; }
</style>

<div class="dashboard-page">
    <div class="dashboard-hero-card mb-4">
        <div class="dashboard-hero-content">
            <div>
                @if (!string.IsNullOrWhiteSpace(Model.CompanyName))
                {
                    <div class="text-white-50 small mb-1 fw-semibold text-uppercase d-flex align-items-center gap-2" style="font-size: 0.82rem; letter-spacing: 0.05em;">
                        <span><i class="bi bi-buildings-fill text-warning me-1"></i>@Model.CompanyName</span>
                        @if (!string.IsNullOrWhiteSpace(Model.CompanyCode))
                        {
                            <span class="badge bg-white bg-opacity-25 text-white border border-white border-opacity-25 font-monospace" style="font-size: 0.72rem;">@Model.CompanyCode</span>
                        }
                    </div>
                }
                <h1 class="dashboard-title text-white mb-2">@Model.CurrentHospitalName Dashboard</h1>
                <p class="dashboard-hero-subtitle mb-3">Welcome back, @Model.UserDisplayName!</p>
                <div class="d-flex flex-wrap align-items-center gap-3">
                    <div class="d-flex align-items-center gap-2">
                        <span class="dashboard-hero-label" style="font-size: 0.95rem;">Company:</span>
                        <span class="dashboard-hero-pill" style="font-size: 0.92rem; padding: 0.2rem 0.75rem; background: rgba(255, 255, 255, 0.18); color: #ffffff; border: 1px solid rgba(255, 255, 255, 0.3);">
                            <i class="bi bi-buildings me-1 text-warning"></i>@Model.CompanyName
                        </span>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <span class="dashboard-hero-label" style="font-size: 0.95rem;">Active Branch:</span>
                        <span class="dashboard-hero-pill" style="font-size: 0.92rem; padding: 0.2rem 0.75rem;">
                            <i class="bi bi-geo-alt-fill me-1"></i>@Model.CurrentBranchName
                        </span>
                    </div>
                </div>
            </div>

        </div>
    </div>

    @* Two facts about the person looking at the page: when they signed in, and what they last did. *@
    <div class="row g-3">
        <div class="col-12 col-lg-6">
            <div class="dashboard-panel h-100 info-card">
                <div class="info-head">
                    <span class="info-icon bg-primary-subtle text-primary"><i class="bi bi-box-arrow-in-right"></i></span>
                    <div>
                        <h2 class="h6 mb-0 fw-bold">Your sign-in</h2>
                        <div class="text-muted small">This session &middot; @Model.CurrentBranchName</div>
                    </div>
                </div>
                @if (Model.SignedInAt.HasValue)
                {
                    <div class="info-value">@Model.SignedInAt.Value.ToString("dd MMM yyyy")<span>@Model.SignedInAt.Value.ToString("hh:mm tt")</span></div>
                    <div class="info-ago">@Ago(Model.SignedInAt.Value)</div>
                    <dl class="info-list">
                        <dt>Branch</dt><dd>@Model.CurrentBranchName</dd>
                        @if (!string.IsNullOrWhiteSpace(Model.SignedInFromIp))
                        {
                            <dt>From</dt><dd title="@Model.SignedInFromIp">@WhereFrom(Model.SignedInFromIp)</dd>
                        }
                        <dt>Previous sign-in<div class="fw-normal text-muted" style="font-size:.76rem;">to this branch</div></dt>
                        <dd>
                            @if (Model.PreviousSignInAt.HasValue)
                            {
                                @Model.PreviousSignInAt.Value.ToString("dd MMM yyyy, hh:mm tt")
                                <span class="text-muted">&middot; @Ago(Model.PreviousSignInAt.Value)</span>
                            }
                            else
                            {
                                <span class="text-muted">First recorded sign-in to this branch</span>
                            }
                        </dd>
                    </dl>
                }
                else
                {
                    <div class="text-muted py-3">No sign-in recorded yet.</div>
                }
            </div>
        </div>

        <div class="col-12 col-lg-6">
            <div class="dashboard-panel h-100 info-card">
                <div class="info-head">
                    <span class="info-icon bg-success-subtle text-success"><i class="bi bi-clock-history"></i></span>
                    <div>
                        <h2 class="h6 mb-0 fw-bold">Your last activity</h2>
                        <div class="text-muted small">The last thing you did in @Model.CurrentBranchName</div>
                    </div>
                </div>
                @if (Model.LastActivityAt.HasValue)
                {
                    <div class="info-value">@Model.LastActivityAt.Value.ToString("dd MMM yyyy")<span>@Model.LastActivityAt.Value.ToString("hh:mm tt")</span></div>
                    <div class="info-ago">@Ago(Model.LastActivityAt.Value)</div>
                    <p class="info-desc">@Model.LastActivityDescription</p>
                    <dl class="info-list">
                        @if (!string.IsNullOrWhiteSpace(Model.LastActivityModule))
                        {
                            <dt>Module</dt><dd><span class="badge text-bg-light border">@Model.LastActivityModule</span></dd>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.LastActivityScreen))
                        {
                            <dt>Screen</dt><dd class="font-monospace small">@Model.LastActivityScreen</dd>
                        }
                    </dl>
                }
                else
                {
                    <div class="text-muted py-3">Nothing recorded in @Model.CurrentBranchName yet. Your next booking, entry or approval in this branch will appear here.</div>
                }
            </div>
        </div>
    </div>
</div>
