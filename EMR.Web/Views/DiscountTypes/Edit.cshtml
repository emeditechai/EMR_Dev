@model EMR.Web.Models.ViewModels.DiscountTypeFormViewModel

@{
    ViewData["Title"] = "Edit Discount Type";
    ViewData["PageIcon"] = "bi-pencil-square";
    ViewData["Breadcrumb"] = new[] { "Master", "General", "Discount Type", "Edit" };
}

<div class="card emr-card">
    <div class="card-body">
        <form asp-action="Edit" method="post" id="editForm">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
            
            <partial name="_Form" model="Model" />

            <div class="mt-4 pt-3 border-top d-flex gap-2">
                <button type="submit" class="btn btn-primary"><i class="bi bi-check-circle me-1"></i>Save Changes</button>
                <a asp-action="Index" class="btn btn-light">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
