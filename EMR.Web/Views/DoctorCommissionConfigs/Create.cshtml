@model EMR.Web.Models.ViewModels.DoctorCommissionConfigFormViewModel
@{
    ViewData["Title"] = "Add Doctor Commission Profile";
}

<div class="container-fluid px-0">
    <div class="row justify-content-center">
        <div class="col-12 col-xl-10">
            <nav aria-label="breadcrumb" class="mb-3">
                <ol class="breadcrumb mb-1 small">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                    <li class="breadcrumb-item"><a href="#">Master</a></li>
                    <li class="breadcrumb-item"><a href="#">OPD Master</a></li>
                    <li class="breadcrumb-item"><a asp-action="Index">Doctor Commission Configuration</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Add Commission Profile</li>
                </ol>
            </nav>

            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-header bg-white py-3 border-bottom d-flex align-items-center justify-content-between">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-percent fs-4 text-success"></i>
                        <div>
                            <h5 class="card-title mb-0 fw-bold">Add Doctor Commission Profile</h5>
                            <small class="text-muted">One scope with all its shares - consultation, services and more - saved together</small>
                        </div>
                    </div>
                    <a asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left me-1"></i>Back to List</a>
                </div>
                <div class="card-body p-4">
                    <partial name="_ProfileForm" model="Model" />
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="~/lib/tom-select/dist/css/tom-select.bootstrap5.min.css" />
    <link rel="stylesheet" href="~/css/views/DoctorCommissionConfigs/profile-form.css" asp-append-version="true" />
    <script src="~/lib/tom-select/dist/js/tom-select.complete.min.js"></script>
    <script src="~/js/views/DoctorCommissionConfigs/profile-form.js" asp-append-version="true"></script>
}
