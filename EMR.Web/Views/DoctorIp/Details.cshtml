@model EMR.Web.ApiClients.Models.DoctorIpDetailModel
@{
    ViewData["Title"] = "Doctor IP Details";
    var h = Model.Header;
}

<div class="container-fluid px-4 py-3">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                    <li class="breadcrumb-item text-muted">IPD Master</li>
                    <li class="breadcrumb-item"><a asp-action="Index">Doctor IP</a></li>
                    <li class="breadcrumb-item active">Details</li>
                </ol>
            </nav>
            <h4 class="fw-bold mb-0 text-primary"><i class="bi bi-eye me-2"></i>Doctor IP - @h.Doctor_Name</h4>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Edit" asp-encrypted-id="@h.Doctor_IP_Hdr_ID" asp-permission="MASTER.DOCTORIP:EDIT" class="btn btn-primary"><i class="bi bi-pencil me-1"></i>Edit</a>
            <a asp-action="Copy" asp-encrypted-id="@h.Doctor_IP_Hdr_ID" asp-permission="MASTER.DOCTORIP:ADD" class="btn btn-outline-secondary"><i class="bi bi-files me-1"></i>Copy to another doctor</a>
            <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Back</a>
        </div>
    </div>

    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-3"><div class="text-muted small text-uppercase fw-semibold">Speciality</div><div class="fw-semibold">@(h.Speciality_Name ?? "-")</div></div>
                <div class="col-md-3"><div class="text-muted small text-uppercase fw-semibold">Doctor</div><div class="fw-semibold">@h.Doctor_Name</div></div>
                <div class="col-md-2"><div class="text-muted small text-uppercase fw-semibold">Branch</div><div class="fw-semibold">@(h.Branch_Name ?? "-")</div></div>
                <div class="col-md-2"><div class="text-muted small text-uppercase fw-semibold">Effective Period</div><div class="fw-semibold">@h.Effective_From.ToString("dd-MMM-yyyy") to @h.Effective_To.ToString("dd-MMM-yyyy")</div></div>
                <div class="col-md-1"><div class="text-muted small text-uppercase fw-semibold">Frequency</div><div class="fw-semibold">@(h.Frequency_Of_Disbursal ?? "Monthly")</div></div>
                <div class="col-md-1"><div class="text-muted small text-uppercase fw-semibold">Status</div>
                    @if (h.IsActive) { <span class="badge bg-success">Active</span> } else { <span class="badge bg-secondary">Inactive</span> }
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white d-flex justify-content-between align-items-center">
            <h6 class="mb-0 fw-bold"><i class="bi bi-list-check me-1"></i>Tests & Commission</h6>
            <span class="badge bg-secondary">@Model.Details.Count tests</span>
        </div>
        <div class="table-responsive">
            <table class="table table-sm table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr><th class="ps-3">#</th><th>Department</th><th>Category</th><th>Sub Category</th><th>Code</th><th>Test / Profile</th><th class="text-end">MRP (₹)</th><th class="text-end">Commission %</th><th class="text-end pe-3">Commission (₹)</th></tr>
                </thead>
                <tbody>
                    @{ var i = 0; }
                    @foreach (var d in Model.Details)
                    {
                        i++;
                        <tr>
                            <td class="ps-3 text-muted">@i</td>
                            <td>@d.Department_Name</td>
                            <td>@d.Category_Name</td>
                            <td>@d.Sub_Category_Name</td>
                            <td class="font-monospace small">@d.Test_Code</td>
                            <td>@d.Test_Name @if (d.Item_Type == "Profile") { <span class="badge bg-primary-subtle text-primary border border-primary-subtle ms-1">Profile</span> }</td>
                            <td class="text-end">@d.MRP.ToString("N2")</td>
                            <td class="text-end fw-semibold">@d.Commission_Rate.ToString("0.##")</td>
                            <td class="text-end pe-3">@((d.MRP * d.Commission_Rate / 100).ToString("N2"))</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
