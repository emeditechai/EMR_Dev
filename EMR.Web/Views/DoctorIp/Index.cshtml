@model EMR.Web.Models.ViewModels.DoctorIpIndexViewModel
@{
    ViewData["Title"] = "Doctor IP";
}

<div class="container-fluid px-4 py-3">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                    <li class="breadcrumb-item text-muted">IPD Master</li>
                    <li class="breadcrumb-item active" aria-current="page">Doctor IP</li>
                </ol>
            </nav>
            <h4 class="fw-bold mb-0 text-primary"><i class="bi bi-shield-lock me-2"></i>Doctor IP</h4>
            <small class="text-muted">Referral doctor commission by test @(string.IsNullOrEmpty(Model.BranchName) ? "" : "- " + Model.BranchName)</small>
        </div>
        <div class="d-flex align-items-center gap-2">
            <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2" title="Locks again after this long without activity">
                <i class="bi bi-unlock me-1"></i>Unlocked - @Model.UnlockMinutesLeft min
            </span>
            @if (Model.IsSuperAdmin)
            {
                <a asp-action="SetAccessCode" class="btn btn-outline-secondary btn-sm"><i class="bi bi-key me-1"></i>Access Code</a>
            }
            <form asp-action="Lock" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-danger btn-sm"><i class="bi bi-lock me-1"></i>Lock</button>
            </form>
            <a asp-action="Create" asp-permission="MASTER.DOCTORIP:ADD" class="btn btn-primary px-3 shadow-sm"><i class="bi bi-plus-lg me-1"></i> Add Doctor IP</a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-3">
            <form method="get" asp-action="Index" class="row g-3 align-items-end">
                <div class="col-md-3">
                    <label class="form-label small fw-semibold text-muted">Status</label>
                    <select name="status" class="form-select" asp-items="Model.StatusOptions"><option value="">-- All --</option></select>
                </div>
                <div class="col-md-6">
                    <label class="form-label small fw-semibold text-muted">Search</label>
                    <input type="text" name="search" class="form-control" value="@Model.SearchTerm" placeholder="Doctor or speciality..." />
                </div>
                <div class="col-md-3 d-flex gap-2">
                    <button type="submit" class="btn btn-secondary w-100"><i class="bi bi-funnel me-1"></i>Filter</button>
                    <a asp-action="Index" class="btn btn-outline-secondary" title="Reset"><i class="bi bi-arrow-counterclockwise"></i></a>
                </div>
            </form>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4" style="width:50px">#</th>
                        <th>Doctor</th>
                        <th>Speciality</th>
                        <th>Effective Period</th>
                        <th class="text-center">Tests</th>
                        <th class="text-center">Avg %</th>
                        <th class="text-center">Status</th>
                        <th class="text-end pe-4" style="width:200px">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Items.Any())
                    {
                        <tr><td colspan="8" class="text-center text-muted py-5"><i class="bi bi-inbox display-6 d-block mb-2"></i>No Doctor IP found.</td></tr>
                    }
                    else
                    {
                        var n = 0;
                        var today = DateTime.Today;
                        foreach (var item in Model.Items)
                        {
                            n++;
                            var current = item.IsActive && item.Effective_From <= today && item.Effective_To >= today;
                            <tr>
                                <td class="ps-4 text-muted">@n</td>
                                <td class="fw-semibold">@item.Doctor_Name</td>
                                <td>@(item.Speciality_Name ?? "-")</td>
                                <td>
                                    @item.Effective_From.ToString("dd-MMM-yyyy") <span class="text-muted">to</span> @item.Effective_To.ToString("dd-MMM-yyyy")
                                    @if (current) { <span class="badge bg-info-subtle text-info border border-info-subtle ms-1">Current</span> }
                                </td>
                                <td class="text-center"><span class="badge bg-secondary rounded-pill px-3">@item.Item_Count</span></td>
                                <td class="text-center">@(item.Avg_Rate?.ToString("0.##") ?? "-")</td>
                                <td class="text-center">
                                    <form asp-action="ToggleStatus" asp-encrypted-id="@item.Doctor_IP_Hdr_ID" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="isActive" value="@(!item.IsActive ? "true" : "false")" />
                                        <button type="submit" class="btn btn-link p-0 text-decoration-none" title="Click to toggle status">
                                            @if (item.IsActive)
                                            {
                                                <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-1 rounded-pill">Active</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-3 py-1 rounded-pill">Inactive</span>
                                            }
                                        </button>
                                    </form>
                                </td>
                                <td class="text-end pe-4">
                                    <div class="btn-group btn-group-sm shadow-sm">
                                        <a asp-action="Details" asp-encrypted-id="@item.Doctor_IP_Hdr_ID" asp-permission="MASTER.DOCTORIP:DETAILS" class="btn btn-outline-info" title="Details"><i class="bi bi-eye"></i></a>
                                        <a asp-action="Edit" asp-encrypted-id="@item.Doctor_IP_Hdr_ID" asp-permission="MASTER.DOCTORIP:EDIT" class="btn btn-outline-primary" title="Edit"><i class="bi bi-pencil"></i></a>
                                        <a asp-action="Copy" asp-encrypted-id="@item.Doctor_IP_Hdr_ID" asp-permission="MASTER.DOCTORIP:ADD" class="btn btn-outline-secondary" title="Copy to another doctor"><i class="bi bi-files"></i></a>
                                        <button type="button" asp-permission="MASTER.DOCTORIP:DELETE" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#del-@item.Doctor_IP_Hdr_ID" title="Delete"><i class="bi bi-trash"></i></button>
                                    </div>
                                    <div class="modal fade text-start" id="del-@item.Doctor_IP_Hdr_ID" tabindex="-1" aria-hidden="true">
                                        <div class="modal-dialog modal-dialog-centered">
                                            <div class="modal-content">
                                                <div class="modal-header bg-danger text-white">
                                                    <h5 class="modal-title"><i class="bi bi-exclamation-triangle-fill me-2"></i>Delete Doctor IP</h5>
                                                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                                                </div>
                                                <div class="modal-body">Delete the Doctor IP of <strong>@item.Doctor_Name</strong> (@item.Effective_From.ToString("dd-MMM-yyyy") to @item.Effective_To.ToString("dd-MMM-yyyy"), @item.Item_Count tests)?</div>
                                                <div class="modal-footer">
                                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                                    <form asp-action="Delete" asp-encrypted-id="@item.Doctor_IP_Hdr_ID" method="post">
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit" class="btn btn-danger">Delete</button>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
