@model EMR.Web.Models.ViewModels.DoctorIpSetCodeViewModel
@{
    ViewData["Title"] = "Doctor IP - Access Code";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card border-0 shadow">
                <div class="card-header bg-primary text-white py-3">
                    <h5 class="mb-0"><i class="bi bi-key me-2"></i>@(Model.IsConfigured ? "Change" : "Set") Doctor IP Access Code</h5>
                </div>
                <div class="card-body p-4">
                    <p class="text-muted small">The code is stored as a salted hash and cannot be read back. Share it only with the people who manage doctor commission. Codes must be typed; pasting is disabled.</p>
                    <form asp-action="SetAccessCode" method="post" autocomplete="off">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>
                        @if (Model.IsConfigured)
                        {
                            <div class="mb-3">
                                <label for="currentEntry" class="form-label fw-semibold">@Html.DisplayNameFor(m => m.CurrentCode)</label>
                                <div class="input-group">
                                    <input type="text" id="currentEntry" class="form-control secure-code" data-target="CurrentCode" />
                                    <button type="button" class="btn btn-outline-secondary" data-reveal="currentEntry" title="Show / hide"><i class="bi bi-eye"></i></button>
                                </div>
                                <input type="hidden" asp-for="CurrentCode" value="" />
                                <span asp-validation-for="CurrentCode" class="text-danger small"></span>
                            </div>
                        }
                        <div class="mb-3">
                            <label for="newEntry" class="form-label fw-semibold">@Html.DisplayNameFor(m => m.NewCode)</label>
                                <div class="input-group">
                                    <input type="text" id="newEntry" class="form-control secure-code" data-target="NewCode" />
                                    <button type="button" class="btn btn-outline-secondary" data-reveal="newEntry" title="Show / hide"><i class="bi bi-eye"></i></button>
                                </div>
                                <input type="hidden" asp-for="NewCode" value="" />
                            <span asp-validation-for="NewCode" class="text-danger small"></span>
                        </div>
                        <div class="mb-4">
                            <label for="confirmEntry" class="form-label fw-semibold">@Html.DisplayNameFor(m => m.ConfirmCode)</label>
                                <div class="input-group">
                                    <input type="text" id="confirmEntry" class="form-control secure-code" data-target="ConfirmCode" />
                                    <button type="button" class="btn btn-outline-secondary" data-reveal="confirmEntry" title="Show / hide"><i class="bi bi-eye"></i></button>
                                </div>
                                <input type="hidden" asp-for="ConfirmCode" value="" />
                            <span asp-validation-for="ConfirmCode" class="text-danger small"></span>
                        </div>
                        <div class="d-flex justify-content-end gap-2">
                            <a asp-action="Unlock" class="btn btn-outline-secondary">Cancel</a>
                            <button type="submit" class="btn btn-primary"><i class="bi bi-save me-1"></i>Save Code</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/secure-code-input.js" asp-append-version="true"></script>
}
