@model EMR.Web.Models.ViewModels.DoctorIpUnlockViewModel
@{
    ViewData["Title"] = "Doctor IP - Restricted";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success shadow-sm"><i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]</div>
            }
            <div class="card border-0 shadow">
                <div class="card-body p-4 p-md-5 text-center">
                    <div class="rounded-circle bg-primary-subtle text-primary d-inline-flex align-items-center justify-content-center mb-3" style="width:72px;height:72px;">
                        <i class="bi bi-shield-lock fs-1"></i>
                    </div>
                    <h4 class="fw-bold mb-1">Doctor IP</h4>
                    <p class="text-muted small mb-4">This page holds confidential doctor commission data.<br />Enter the access code to continue.</p>

                    @if (!Model.IsConfigured)
                    {
                        <div class="alert alert-warning text-start small mb-0">
                            <i class="bi bi-exclamation-triangle-fill me-1"></i>No access code has been set for this company yet.
                            @if (Model.IsSuperAdmin)
                            {
                                <div class="mt-2"><a asp-action="SetAccessCode" class="btn btn-sm btn-warning"><i class="bi bi-key me-1"></i>Set access code</a></div>
                            }
                            else
                            {
                                <span>Ask a Super Admin to set it.</span>
                            }
                        </div>
                    }
                    else if (Model.IsLockedOut)
                    {
                        <div class="alert alert-danger text-start small mb-0">
                            <i class="bi bi-lock-fill me-1"></i>Too many incorrect attempts. Try again in about <strong>@Model.LockedMinutesLeft minute(s)</strong>.
                        </div>
                    }
                    else
                    {
                        <form asp-action="Unlock" method="post" autocomplete="off" class="text-start">
                            @Html.AntiForgeryToken()
                            <input type="hidden" asp-for="ReturnUrl" />
                            <label for="codeEntry" class="form-label fw-semibold">Access Code</label>
                            <div class="input-group mb-1">
                                <span class="input-group-text"><i class="bi bi-key"></i></span>
                                <input type="text" id="codeEntry" class="form-control secure-code" data-target="Code" autofocus />
                                <button type="button" class="btn btn-outline-secondary" data-reveal="codeEntry" title="Show / hide"><i class="bi bi-eye"></i></button>
                            </div>
                            <input type="hidden" asp-for="Code" value="" />
                            <small class="text-muted d-block mb-1">Type the code; pasting is disabled.</small>
                            <span asp-validation-for="Code" class="text-danger small d-block mb-2"></span>
                            <div asp-validation-summary="ModelOnly" class="text-danger small"></div>
                            <button type="submit" class="btn btn-primary w-100 mt-2"><i class="bi bi-unlock me-1"></i>Unlock</button>
                        </form>
                        @if (Model.IsSuperAdmin)
                        {
                            <div class="mt-3"><a asp-action="SetAccessCode" class="small text-decoration-none"><i class="bi bi-key me-1"></i>Change access code</a></div>
                        }
                    }
                </div>
            </div>
            <p class="text-center text-muted small mt-3"><i class="bi bi-info-circle me-1"></i>Every attempt is logged. The page locks again after a period without activity.</p>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/secure-code-input.js" asp-append-version="true"></script>
    <script>
        $('form[action*="Unlock"]').on('submit', function (e) {
            if (!$('#Code').val()) { e.preventDefault(); $('[data-valmsg-for="Code"]').text('Enter the access code.'); }
        });
    </script>
}
