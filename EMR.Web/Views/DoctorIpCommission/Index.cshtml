@model EMR.Web.Models.ViewModels.DoctorIpCommissionIndexViewModel
@{
    ViewData["Title"] = "Doctor IP Commission";
    var from = Model.FromDate.ToString("yyyy-MM-dd");
    var to = Model.ToDate.ToString("yyyy-MM-dd");
    var pendingActive = Model.ActiveTab != "computed";
}

<div class="container-fluid px-4 py-3">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                    <li class="breadcrumb-item text-muted">IPD Master</li>
                    <li class="breadcrumb-item"><a asp-controller="DoctorIp" asp-action="Index">Doctor IP</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Commission</li>
                </ol>
            </nav>
            <h4 class="fw-bold mb-0 text-primary"><i class="bi bi-calculator me-2"></i>Doctor IP Commission</h4>
            <small class="text-muted">Referral doctor commission from lab orders @(string.IsNullOrEmpty(Model.BranchName) ? "" : "- " + Model.BranchName)</small>
        </div>
        <div class="d-flex align-items-center gap-2">
            <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2" title="Locks again after this long without activity">
                <i class="bi bi-unlock me-1"></i>Unlocked - @Model.UnlockMinutesLeft min
            </span>
            <a asp-controller="DoctorIp" asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-shield-lock me-1"></i>Doctor IP Master</a>
            <form asp-controller="DoctorIp" asp-action="Lock" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-danger btn-sm"><i class="bi bi-lock me-1"></i>Lock</button>
            </form>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-warning alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="alert alert-light border shadow-sm py-2 small d-flex flex-wrap align-items-center gap-2">
        <i class="bi bi-gear-fill text-secondary"></i>
        <span>Commission run: <strong>@Model.ComputeMode</strong></span>
        @if (Model.ComputeMode == "Manual")
        {
            <span class="text-muted">- computed only from this screen.</span>
        }
        else
        {
            <span class="text-muted">- the scheduled job runs daily at <strong>@(Model.AutoRunTime?.ToString(@"hh\:mm") ?? "--:--")</strong> for doctors whose disbursal period has closed@(Model.ComputeMode == "Automatic" ? "; the Calculate button is switched off." : ", and you can also calculate from this screen.")</span>
        }
        <span class="text-muted ms-auto">Set in Hospital Settings &rsaquo; LAB.</span>
    </div>

    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-3">
            <form method="get" asp-action="Index" class="row g-3 align-items-end">
                <input type="hidden" name="tab" value="@Model.ActiveTab" />
                <div class="col-md-4">
                    <label class="form-label small fw-semibold text-muted">Referral Doctor</label>
                    <select name="doctorId" class="form-select" asp-items="Model.DoctorOptions"><option value="">-- All doctors with a Doctor IP --</option></select>
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-semibold text-muted">Order Date From</label>
                    <input type="date" name="fromDate" class="form-control" value="@from" required />
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-semibold text-muted">Order Date To</label>
                    <input type="date" name="toDate" class="form-control" value="@to" required />
                </div>
                <div class="col-md-2 d-flex gap-2">
                    <button type="submit" class="btn btn-secondary w-100"><i class="bi bi-funnel me-1"></i>Filter</button>
                    <a asp-action="Index" class="btn btn-outline-secondary" title="Reset"><i class="bi bi-arrow-counterclockwise"></i></a>
                </div>
            </form>
        </div>
    </div>

    <ul class="nav nav-tabs mb-0" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link @(pendingActive ? "active" : "")" data-bs-toggle="tab" data-bs-target="#tabPending" type="button" role="tab">
                <i class="bi bi-hourglass-split me-1"></i>Pending <span class="badge bg-warning text-dark ms-1">@Model.PendingItems.Sum(p => p.Pending_Items)</span>
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link @(pendingActive ? "" : "active")" data-bs-toggle="tab" data-bs-target="#tabComputed" type="button" role="tab">
                <i class="bi bi-check2-circle me-1"></i>Computed <span class="badge bg-secondary ms-1">@Model.ComputedItems.Count</span>
            </button>
        </li>
    </ul>

    <div class="tab-content">
        <div class="tab-pane fade @(pendingActive ? "show active" : "")" id="tabPending" role="tabpanel">
            <div class="card border-0 shadow-sm rounded-top-0">
                <div class="card-header bg-white d-flex flex-wrap justify-content-between align-items-center gap-2 py-3">
                    <div class="small text-muted">
                        Lab order tests from <strong>@Model.FromDate.ToString("dd-MMM-yyyy")</strong> to <strong>@Model.ToDate.ToString("dd-MMM-yyyy")</strong> whose commission is not yet computed.
                        <div class="mt-1"><i class="bi bi-list-check me-1"></i>Use <strong>Select tests</strong> to leave tests out before calculating. Omitted tests earn no IP in the manual or the scheduled run until they are included again.</div>
                    </div>
                    @if (Model.PendingItems.Any() && Model.ComputeMode != "Automatic")
                    {
                        <form asp-action="Calculate" method="post" class="d-inline"
                              onsubmit="return confirm('Calculate commission for the pending tests shown? Computed tests are locked and will not be calculated again.');">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="doctorId" value="@Model.SelectedDoctorId" />
                            <input type="hidden" name="fromDate" value="@from" />
                            <input type="hidden" name="toDate" value="@to" />
                            <button type="submit" asp-permission="MASTER.DOCTORIP_COMMISSION:CALCULATE" class="btn btn-primary">
                                <i class="bi bi-calculator me-1"></i>Calculate Commission
                            </button>
                        </form>
                    }
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4" style="width:50px">#</th>
                                <th>Doctor</th>
                                <th>Frequency</th>
                                <th>Orders Dated</th>
                                <th class="text-center">Orders</th>
                                <th class="text-center">Tests</th>
                                <th class="text-end">Billed (₹)</th>
                                <th class="text-end">Estimated Commission (₹)</th>
                                <th class="text-center">Omitted</th>
                                <th class="text-end pe-4"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.PendingItems.Any())
                            {
                                <tr><td colspan="10" class="text-center text-muted py-5"><i class="bi bi-inbox display-6 d-block mb-2"></i>Nothing pending for this period.</td></tr>
                            }
                            else
                            {
                                var n = 0;
                                foreach (var p in Model.PendingItems)
                                {
                                    n++;
                                    <tr>
                                        <td class="ps-4 text-muted">@n</td>
                                        <td class="fw-semibold">@p.Doctor_Name</td>
                                        <td>@(p.Frequency_Of_Disbursal ?? "-")</td>
                                        <td>@p.First_Order_Date.ToString("dd-MMM-yyyy") <span class="text-muted">to</span> @p.Last_Order_Date.ToString("dd-MMM-yyyy")</td>
                                        <td class="text-center">@p.Pending_Orders</td>
                                        <td class="text-center"><span class="badge bg-warning text-dark rounded-pill px-3">@p.Pending_Items</span></td>
                                        <td class="text-end">@p.Pending_Amount.ToString("N2")</td>
                                        <td class="text-end fw-semibold">@p.Estimated_Commission.ToString("N2")</td>
                                        <td class="text-center">
                                            @if (p.Omitted_Items > 0)
                                            {
                                                <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle rounded-pill px-3" title="Billed ₹@p.Omitted_Amount.ToString("N2"), commission ₹@p.Omitted_Commission.ToString("N2") left out">@p.Omitted_Items</span>
                                            }
                                            else { <span class="text-muted">-</span> }
                                        </td>
                                        <td class="text-end pe-4">
                                            <button type="button" class="btn btn-sm btn-outline-primary ip-select" data-doctor="@p.Doctor_ID" data-name="@p.Doctor_Name">
                                                <i class="bi bi-list-check me-1"></i>Select tests
                                            </button>
                                        </td>
                                    </tr>
                                }
                                <tr class="table-light fw-bold">
                                    <td colspan="4" class="ps-4">Total</td>
                                    <td class="text-center">@Model.PendingItems.Sum(p => p.Pending_Orders)</td>
                                    <td class="text-center">@Model.PendingItems.Sum(p => p.Pending_Items)</td>
                                    <td class="text-end">@Model.PendingItems.Sum(p => p.Pending_Amount).ToString("N2")</td>
                                    <td class="text-end">@Model.PendingItems.Sum(p => p.Estimated_Commission).ToString("N2")</td>
                                    <td class="text-center">@Model.PendingItems.Sum(p => p.Omitted_Items)</td>
                                    <td class="pe-4"></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="tab-pane fade @(pendingActive ? "" : "show active")" id="tabComputed" role="tabpanel">
            <div class="card border-0 shadow-sm rounded-top-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4">Ref #</th>
                                <th>Doctor</th>
                                <th>Period</th>
                                <th>Frequency</th>
                                <th class="text-center">Orders</th>
                                <th class="text-center">Tests</th>
                                <th class="text-end">Billed (₹)</th>
                                <th class="text-end">Commission (₹)</th>
                                <th>Computed On</th>
                                <th>By</th>
                                <th class="text-end pe-4"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.ComputedItems.Any())
                            {
                                <tr><td colspan="11" class="text-center text-muted py-5"><i class="bi bi-inbox display-6 d-block mb-2"></i>No commission computed for this period.</td></tr>
                            }
                            else
                            {
                                foreach (var c in Model.ComputedItems)
                                {
                                    <tr>
                                        <td class="ps-4 font-monospace small">@c.Commission_Hdr_ID</td>
                                        <td class="fw-semibold">@c.Doctor_Name</td>
                                        <td>@c.Period_From.ToString("dd-MMM-yyyy") <span class="text-muted">to</span> @c.Period_To.ToString("dd-MMM-yyyy")</td>
                                        <td>@(c.Frequency_Of_Disbursal ?? "-")</td>
                                        <td class="text-center">@c.Total_Orders</td>
                                        <td class="text-center"><span class="badge bg-secondary rounded-pill px-3">@c.Total_Items</span></td>
                                        <td class="text-end">@c.Total_Billed_Amount.ToString("N2")</td>
                                        <td class="text-end fw-semibold">@c.Total_Commission.ToString("N2")</td>
                                        <td>@c.Computed_Date.ToString("dd-MMM-yyyy HH:mm")</td>
                                        <td>
                                            @c.Computed_By_Name
                                            @if (c.Source == "AUTO") { <span class="badge bg-info-subtle text-info border border-info-subtle ms-1">Auto</span> }
                                        </td>
                                        <td class="text-end pe-4">
                                            <a asp-action="Details" asp-encrypted-id="@c.Commission_Hdr_ID" asp-permission="MASTER.DOCTORIP_COMMISSION:DETAILS" class="btn btn-sm btn-outline-info" title="Details"><i class="bi bi-eye"></i></a>
                                        </td>
                                    </tr>
                                }
                                <tr class="table-light fw-bold">
                                    <td colspan="4" class="ps-4">Total</td>
                                    <td class="text-center">@Model.ComputedItems.Sum(c => c.Total_Orders)</td>
                                    <td class="text-center">@Model.ComputedItems.Sum(c => c.Total_Items)</td>
                                    <td class="text-end">@Model.ComputedItems.Sum(c => c.Total_Billed_Amount).ToString("N2")</td>
                                    <td class="text-end">@Model.ComputedItems.Sum(c => c.Total_Commission).ToString("N2")</td>
                                    <td colspan="3"></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="ipTestsModal" tabindex="-1" aria-labelledby="ipTestsTitle" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <div>
                    <h5 class="modal-title fw-bold" id="ipTestsTitle"><i class="bi bi-list-check me-2"></i>Select tests</h5>
                    <div class="small text-muted">Orders @Model.FromDate.ToString("dd-MMM-yyyy") to @Model.ToDate.ToString("dd-MMM-yyyy"). Untick a test to omit it from the IP calculation.</div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-0">
                <div class="d-flex flex-wrap gap-2 align-items-center p-3 border-bottom bg-light">
                    <input type="search" id="ipFilter" class="form-control form-control-sm" style="max-width:280px" placeholder="Filter by bill, patient or test" />
                    <button type="button" class="btn btn-sm btn-outline-secondary ip-bulk" data-on="1"><i class="bi bi-check2-square me-1"></i>Include shown</button>
                    <button type="button" class="btn btn-sm btn-outline-secondary ip-bulk" data-on="0"><i class="bi bi-square me-1"></i>Omit shown</button>
                    <div class="ms-auto small" id="ipTotals"></div>
                </div>
                <div class="table-responsive">
                    <table class="table table-sm table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-3" style="width:40px"><input type="checkbox" class="form-check-input" id="ipAll" title="Include / omit all shown" /></th>
                                <th>Bill</th><th>Date</th><th>Patient</th><th>Test / Profile / Package</th>
                                <th class="text-end">Billed (₹)</th><th class="text-end">Rate %</th><th class="text-end pe-3">Commission (₹)</th>
                            </tr>
                        </thead>
                        <tbody id="ipTests"></tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer flex-wrap">
                <input type="text" id="ipReason" class="form-control form-control-sm me-auto" style="max-width:360px" maxlength="250" placeholder="Reason for omitting (optional)" />
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Close</button>
                <button type="button" id="ipSave" asp-permission="MASTER.DOCTORIP_COMMISSION:OMIT" class="btn btn-primary"><i class="bi bi-save me-1"></i>Save selection</button>
                @if (Model.ComputeMode != "Automatic")
                {
                    <button type="button" id="ipSaveCalc" asp-permission="MASTER.DOCTORIP_COMMISSION:CALCULATE" class="btn btn-success"><i class="bi bi-calculator me-1"></i>Save &amp; calculate</button>
                }
            </div>
            <form asp-action="Calculate" method="post" id="ipCalcForm" class="d-none">
                @Html.AntiForgeryToken()
                <input type="hidden" name="doctorId" id="ipCalcDoctor" />
                <input type="hidden" name="fromDate" value="@from" />
                <input type="hidden" name="toDate" value="@to" />
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
(function () {
    const from = '@from', to = '@to';
    const modalEl = document.getElementById('ipTestsModal');
    const modal = bootstrap.Modal.getOrCreateInstance(modalEl);
    const body = document.getElementById('ipTests');
    const saveBtn = document.getElementById('ipSave');
    const calcBtn = document.getElementById('ipSaveCalc');
    const canOmit = !!saveBtn;
    const esc = s => String(s ?? '').replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
    const money = n => Number(n || 0).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    const day = d => new Date(d).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });
    const token = () => document.querySelector('#ipCalcForm input[name="__RequestVerificationToken"]').value;
    let doctorId = null, tests = [], changed = false;

    document.querySelectorAll('.ip-select').forEach(b => b.addEventListener('click', () => open(b.dataset.doctor, b.dataset.name)));

    async function open(id, name) {
        doctorId = id; changed = false;
        document.getElementById('ipTestsTitle').innerHTML = '<i class="bi bi-list-check me-2"></i>Select tests - ' + esc(name);
        document.getElementById('ipFilter').value = '';
        document.getElementById('ipReason').value = '';
        body.innerHTML = '<tr><td colspan="8" class="text-center text-muted py-4"><span class="spinner-border spinner-border-sm me-2"></span>Loading tests...</td></tr>';
        document.getElementById('ipTotals').textContent = '';
        modal.show();
        try {
            const res = await fetch('@Url.Action("PendingTests")?' + new URLSearchParams({ doctorId: id, fromDate: from, toDate: to }));
            if (!(res.headers.get('content-type') || '').includes('json')) { location.reload(); return; }
            const data = await res.json();
            if (!data.success) { body.innerHTML = '<tr><td colspan="8" class="text-center text-danger py-4">' + esc(data.message) + '</td></tr>'; return; }
            tests = data.tests.map(t => ({ ...t, include: !t.Is_Omitted }));
            render();
        } catch { body.innerHTML = '<tr><td colspan="8" class="text-center text-danger py-4">Could not load the tests. Try again.</td></tr>'; }
    }

    function shown() {
        const q = document.getElementById('ipFilter').value.trim().toLowerCase();
        return tests.filter(t => !q || [t.BillNo, t.Patient_Name, t.Test_Code, t.Test_Name].some(v => String(v ?? '').toLowerCase().includes(q)));
    }

    function render() {
        const rows = shown();
        body.innerHTML = rows.length ? rows.map(t => `
            <tr class="${t.include ? '' : 'table-secondary text-muted'}">
                <td class="ps-3"><input type="checkbox" class="form-check-input ip-chk" data-id="${t.LabOrderItemId}" ${t.include ? 'checked' : ''} ${canOmit ? '' : 'disabled'}></td>
                <td class="small font-monospace">${esc(t.BillNo)}</td>
                <td class="small">${day(t.Order_Date)}</td>
                <td>${esc(t.Patient_Name)}</td>
                <td><div class="${t.include ? 'fw-semibold' : 'text-decoration-line-through'}">${esc(t.Test_Name)}</div>
                    <div class="small text-muted">${esc(t.Test_Code || '')} · ${esc(t.Item_Type)}${t.Is_Omitted ? ' · <span class="text-secondary"><i class="bi bi-slash-circle me-1"></i>omitted' + (t.Omitted_By_Name ? ' by ' + esc(t.Omitted_By_Name) : '') + (t.Omit_Reason ? ': ' + esc(t.Omit_Reason) : '') + '</span>' : ''}</div></td>
                <td class="text-end">${money(t.Billed_Amount)}</td>
                <td class="text-end">${money(t.Commission_Rate)}</td>
                <td class="text-end pe-3 fw-semibold">${t.include ? money(t.Commission_Amount) : '<span class="text-muted">0.00</span>'}</td>
            </tr>`).join('') : '<tr><td colspan="8" class="text-center text-muted py-4">No pending tests.</td></tr>';
        const inc = tests.filter(t => t.include), om = tests.filter(t => !t.include);
        document.getElementById('ipTotals').innerHTML =
            `<span class="me-3">Included <strong>${inc.length}</strong> · commission <strong>₹${money(inc.reduce((a, t) => a + t.Commission_Amount, 0))}</strong></span>` +
            `<span class="text-muted">Omitted <strong>${om.length}</strong> · ₹${money(om.reduce((a, t) => a + t.Commission_Amount, 0))}</span>`;
        const all = document.getElementById('ipAll');
        all.disabled = !canOmit || !rows.length;
        all.checked = rows.length > 0 && rows.every(t => t.include);
        all.indeterminate = rows.some(t => t.include) && !all.checked;
    }

    body.addEventListener('change', e => {
        const c = e.target.closest('.ip-chk'); if (!c) return;
        const t = tests.find(x => x.LabOrderItemId == c.dataset.id); if (t) { t.include = c.checked; changed = true; render(); }
    });
    const setShown = on => { if (!canOmit) return; shown().forEach(t => t.include = on); changed = true; render(); };
    document.getElementById('ipAll').addEventListener('change', e => setShown(e.target.checked));
    document.querySelectorAll('.ip-bulk').forEach(b => b.addEventListener('click', () => setShown(b.dataset.on === '1')));
    document.getElementById('ipFilter').addEventListener('input', render);

    async function save() {
        const omit = tests.filter(t => !t.include && !t.Is_Omitted).map(t => t.LabOrderItemId);
        const include = tests.filter(t => t.include && t.Is_Omitted).map(t => t.LabOrderItemId);
        if (!omit.length && !include.length) return { success: true, omitted: 0, restored: 0 };
        const fd = new FormData();
        fd.append('doctorId', doctorId); fd.append('fromDate', from); fd.append('toDate', to);
        fd.append('omitIds', omit.join(',')); fd.append('includeIds', include.join(','));
        fd.append('reason', document.getElementById('ipReason').value);
        fd.append('__RequestVerificationToken', token());
        const res = await fetch('@Url.Action("SaveOmitted")', { method: 'POST', body: fd });
        if (!(res.headers.get('content-type') || '').includes('json')) { location.reload(); return null; }
        return await res.json();
    }

    async function run(btn, thenCalculate) {
        const old = btn.innerHTML; btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Saving';
        try {
            const r = await save();
            if (!r) return;
            if (!r.success) { Swal.fire({ icon: 'error', text: r.message }); return; }
            if (thenCalculate) {
                const included = tests.filter(t => t.include).length;
                if (!included) { Swal.fire({ icon: 'warning', text: 'All tests are omitted, so there is nothing to calculate. The selection is saved.' }).then(() => location.reload()); return; }
                const ok = await Swal.fire({ icon: 'question', title: 'Calculate commission?', html: `${included} test(s) will be calculated for this doctor. Computed tests are locked and will not be calculated again.`, showCancelButton: true, confirmButtonText: 'Calculate' });
                if (!ok.isConfirmed) { if (r.omitted || r.restored) location.reload(); return; }
                document.getElementById('ipCalcDoctor').value = doctorId;
                document.getElementById('ipCalcForm').submit();
                return;
            }
            await Swal.fire({ icon: 'success', title: 'Selection saved', text: `${r.omitted} test(s) omitted, ${r.restored} included again.`, timer: 2200, showConfirmButton: false });
            location.reload();
        } catch { Swal.fire({ icon: 'error', text: 'Could not save the selection. Try again.' }); }
        finally { btn.disabled = false; btn.innerHTML = old; }
    }
    if (saveBtn) saveBtn.addEventListener('click', () => run(saveBtn, false));
    if (calcBtn) calcBtn.addEventListener('click', () => run(calcBtn, true));

    modalEl.addEventListener('hide.bs.modal', e => {
        if (changed && canOmit && !confirm('Close without saving the test selection?')) e.preventDefault();
    });
})();
</script>
}
