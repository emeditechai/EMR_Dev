@model EMR.Web.Models.ViewModels.BillingAdjustmentReportViewModel
@{
    ViewData["Title"] = "RPT-06: Billing Adjustments Report";
}

<div class="container-fluid px-0">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1 small">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                    <li class="breadcrumb-item"><a asp-action="Index">Reports</a></li>
                    <li class="breadcrumb-item active" aria-current="page">RPT-06: Billing Adjustments</li>
                </ol>
            </nav>
            <h1 class="h3 mb-0 fw-bold" style="color:var(--emr-primary, #1e3a8a);">
                <i class="bi bi-plus-slash-minus me-2 text-secondary"></i>RPT-06: Billing Adjustments Report
            </h1>
            <p class="text-muted small mb-0 mt-1">Audit log of doctor-level TDS deductions, incentives, penalties, and manual adjustments.</p>
        </div>
        <div class="d-flex gap-2">
            <button type="button" class="btn btn-outline-secondary btn-sm" onclick="window.print()">
                <i class="bi bi-printer-fill me-1"></i>Print Log
            </button>
        </div>
    </div>

    <!-- Filter Card -->
    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-body p-3">
            <form asp-action="BillingAdjustments" method="get" class="row g-2 align-items-center">
                <div class="col-md-4">
                    <select name="doctorId" asp-items="Model.DoctorOptions" class="form-select"></select>
                </div>
                <div class="col-md-3">
                    <input type="date" name="fromDate" value="@(Model.FromDate?.ToString("yyyy-MM-dd"))" class="form-control" />
                </div>
                <div class="col-md-3">
                    <input type="date" name="toDate" value="@(Model.ToDate?.ToString("yyyy-MM-dd"))" class="form-control" />
                </div>
                <div class="col-md-2 d-flex gap-1">
                    <button type="submit" class="btn btn-secondary w-100">
                        <i class="bi bi-filter me-1"></i>Filter
                    </button>
                    <a asp-action="BillingAdjustments" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-counterclockwise"></i>
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- Summary Metrics -->
    <div class="card border-0 shadow-sm rounded-3 p-3 bg-white mb-4 border-start border-4 border-secondary">
        <div class="text-muted small fw-semibold">NET TOTAL ADJUSTMENTS APPLIED</div>
        <div class="fs-4 fw-bold @(Model.TotalAdjustments >= 0 ? "text-success" : "text-danger") mt-1">
            @(Model.TotalAdjustments >= 0 ? "+" : "")₹@Model.TotalAdjustments.ToString("N2")
        </div>
    </div>

    <!-- Table Card -->
    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-3">Date</th>
                            <th>Visit #</th>
                            <th>Bill #</th>
                            <th>Doctor</th>
                            <th>Adjustment Type</th>
                            <th class="text-end">Amount (₹)</th>
                            <th>Reason / Justification</th>
                            <th>Requested By</th>
                            <th class="pe-3">Approved By</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Rows.Any())
                        {
                            foreach (var r in Model.Rows)
                            {
                                <tr>
                                    <td class="ps-3 text-muted">@r.Date.ToString("dd MMM yyyy HH:mm")</td>
                                    <td><span class="badge bg-light text-dark border">#@r.VisitNo</span></td>
                                    <td class="font-monospace">@(r.Bill ?? "—")</td>
                                    <td class="fw-semibold text-dark">@r.Doctor</td>
                                    <td><span class="badge bg-light text-dark border">@r.AdjustmentType</span></td>
                                    <td class="text-end fw-bold @(r.Amount >= 0 ? "text-success" : "text-danger")">
                                        @(r.Amount >= 0 ? "+" : "")₹@r.Amount.ToString("N2")
                                    </td>
                                    <td>@r.Reason</td>
                                    <td class="text-muted small">@r.RequestedBy</td>
                                    <td class="pe-3 text-muted small">@r.ApprovedBy</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="9" class="text-center py-5 text-muted">No billing adjustments recorded for selected filters.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
