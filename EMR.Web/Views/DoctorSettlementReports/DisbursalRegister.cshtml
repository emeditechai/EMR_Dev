@model EMR.Web.Models.ViewModels.DoctorDisbursalRegisterReportViewModel
@{
    ViewData["Title"] = "RPT-04: Doctor Disbursal Register";
}

<div class="container-fluid px-0">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1 small">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                    <li class="breadcrumb-item"><a asp-action="Index">Reports</a></li>
                    <li class="breadcrumb-item active" aria-current="page">RPT-04: Disbursal Register</li>
                </ol>
            </nav>
            <h1 class="h3 mb-0 fw-bold" style="color:var(--emr-primary, #1e3a8a);">
                <i class="bi bi-journal-bookmark me-2 text-info"></i>RPT-04: Doctor Disbursal Register
            </h1>
            <p class="text-muted small mb-0 mt-1">Official registry of generated vouchers, approved commissions, and disbursed bank payments.</p>
        </div>
        <div class="d-flex gap-2">
            <button type="button" class="btn btn-outline-secondary btn-sm" onclick="window.print()">
                <i class="bi bi-printer-fill me-1"></i>Print Register
            </button>
        </div>
    </div>

    <!-- Filter Card -->
    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-body p-3">
            <form asp-action="DisbursalRegister" method="get" class="row g-2 align-items-center">
                <div class="col-md-3">
                    <select name="doctorId" asp-items="Model.DoctorOptions" class="form-select"></select>
                </div>
                <div class="col-md-3">
                    <select name="period" asp-items="Model.PeriodOptions" class="form-select"></select>
                </div>
                <div class="col-md-2">
                    <input type="date" name="fromDate" value="@(Model.FromDate?.ToString("yyyy-MM-dd"))" class="form-control" />
                </div>
                <div class="col-md-2">
                    <input type="date" name="toDate" value="@(Model.ToDate?.ToString("yyyy-MM-dd"))" class="form-control" />
                </div>
                <div class="col-md-2 d-flex gap-1">
                    <button type="submit" class="btn btn-info text-white w-100">
                        <i class="bi bi-filter me-1"></i>Filter
                    </button>
                    <a asp-action="DisbursalRegister" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-counterclockwise"></i>
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- Metrics -->
    <div class="row g-3 mb-4">
        <div class="col-md-6">
            <div class="card border-0 shadow-sm rounded-3 p-3 bg-white">
                <div class="text-muted small fw-semibold">TOTAL APPROVED ENTITLEMENT</div>
                <div class="fs-4 fw-bold text-dark mt-1">₹@Model.TotalApproved.ToString("N2")</div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card border-0 shadow-sm rounded-3 p-3 bg-white border-start border-4 border-success">
                <div class="text-muted small fw-semibold">TOTAL DISBURSED / PAID</div>
                <div class="fs-4 fw-bold text-success mt-1">₹@Model.TotalPaid.ToString("N2")</div>
            </div>
        </div>
    </div>

    <!-- Table Card -->
    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-3">Disbursal #</th>
                            <th>Doctor</th>
                            <th>Period</th>
                            <th class="text-end">Eligible Collection</th>
                            <th class="text-end">Commission</th>
                            <th class="text-end">Approved Amount</th>
                            <th class="text-end">Paid Amount</th>
                            <th>Payment Ref</th>
                            <th>Paid Date</th>
                            <th class="text-end pe-3">Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Rows.Any())
                        {
                            foreach (var r in Model.Rows)
                            {
                                <tr>
                                    <td class="ps-3"><a asp-controller="DoctorDisbursal" asp-action="Details" asp-route-id="@r.DisbursalId" class="fw-bold">#@r.DisbursalId</a></td>
                                    <td class="fw-semibold text-dark">@r.Doctor</td>
                                    <td><span class="badge bg-light text-dark border">@r.Period</span></td>
                                    <td class="text-end">₹@r.EligibleAmount.ToString("N2")</td>
                                    <td class="text-end text-primary">₹@r.Commission.ToString("N2")</td>
                                    <td class="text-end fw-bold">₹@r.ApprovedAmount.ToString("N2")</td>
                                    <td class="text-end fw-bold text-success">₹@r.PaidAmount.ToString("N2")</td>
                                    <td class="font-monospace small">@r.PaymentRef</td>
                                    <td class="text-muted small">@(r.PaidDate?.ToString("dd MMM yyyy") ?? "—")</td>
                                    <td class="text-end pe-3">
                                        <span class="badge @(r.Status.Contains("Paid") ? "text-bg-success" : "text-bg-warning")">
                                            @r.Status
                                        </span>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="10" class="text-center py-5 text-muted">No disbursal register entries found.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
