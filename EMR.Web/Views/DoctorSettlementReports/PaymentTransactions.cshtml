@model EMR.Web.Models.ViewModels.PaymentTransactionReportViewModel
@{
    ViewData["Title"] = "RPT-05: Payment Transactions Report";
}

<div class="container-fluid px-0">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1 small">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                    <li class="breadcrumb-item"><a asp-action="Index">Reports</a></li>
                    <li class="breadcrumb-item active" aria-current="page">RPT-05: Payment Transactions</li>
                </ol>
            </nav>
            <h1 class="h3 mb-0 fw-bold" style="color:var(--emr-primary, #1e3a8a);">
                <i class="bi bi-credit-card-2-front me-2 text-primary"></i>RPT-05: Payment Transactions Audit Log
            </h1>
            <p class="text-muted small mb-0 mt-1">Audit log of all patient collections across cash, card, UPI, bank transfer, and cheque.</p>
        </div>
        <div class="d-flex gap-2">
            <button type="button" class="btn btn-outline-secondary btn-sm" onclick="window.print()">
                <i class="bi bi-printer-fill me-1"></i>Print Log
            </button>
        </div>
    </div>

    <!-- Filter Card -->
    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-body p-3">
            <form asp-action="PaymentTransactions" method="get" class="row g-2 align-items-center">
                <div class="col-md-4">
                    <select name="paymentMethodId" asp-items="Model.PaymentMethodOptions" class="form-select"></select>
                </div>
                <div class="col-md-3">
                    <input type="date" name="fromDate" value="@(Model.FromDate?.ToString("yyyy-MM-dd"))" class="form-control" />
                </div>
                <div class="col-md-3">
                    <input type="date" name="toDate" value="@(Model.ToDate?.ToString("yyyy-MM-dd"))" class="form-control" />
                </div>
                <div class="col-md-2 d-flex gap-1">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="bi bi-filter me-1"></i>Filter
                    </button>
                    <a asp-action="PaymentTransactions" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-counterclockwise"></i>
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- Summary Metrics -->
    <div class="card border-0 shadow-sm rounded-3 p-3 bg-white mb-4 border-start border-4 border-primary">
        <div class="text-muted small fw-semibold">TOTAL TRANSACTION COLLECTIONS</div>
        <div class="fs-4 fw-bold text-primary mt-1">₹@Model.TotalAmount.ToString("N2")</div>
    </div>

    <!-- Table Card -->
    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-3">Transaction Date & Time</th>
                            <th>Visit #</th>
                            <th>Bill #</th>
                            <th>Patient</th>
                            <th>Payment Mode</th>
                            <th class="text-end">Paid Amount (₹)</th>
                            <th>Reference / Receipt</th>
                            <th class="pe-3">Cashier / User</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Rows.Any())
                        {
                            foreach (var r in Model.Rows)
                            {
                                <tr>
                                    <td class="ps-3 text-muted">@r.DateTime.ToString("dd MMM yyyy HH:mm")</td>
                                    <td><span class="badge bg-light text-dark border">#@r.VisitNo</span></td>
                                    <td class="font-monospace">@r.Bill</td>
                                    <td class="fw-semibold text-dark">@r.Patient</td>
                                    <td>
                                        <span class="badge bg-info bg-opacity-10 text-dark border border-info border-opacity-25">
                                            @r.PaymentMode
                                        </span>
                                    </td>
                                    <td class="text-end fw-bold text-success">₹@r.Amount.ToString("N2")</td>
                                    <td class="font-monospace small">@r.TransactionReference</td>
                                    <td class="pe-3 text-muted small">@r.ReceivedBy</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="text-center py-5 text-muted">No payment transaction records found.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
