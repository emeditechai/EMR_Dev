@model EMR.Web.Models.ViewModels.RefundReversalReportViewModel
@{
    ViewData["Title"] = "RPT-07: Refund & Reversal Report";
}

<div class="container-fluid px-0">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1 small">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                    <li class="breadcrumb-item"><a asp-action="Index">Reports</a></li>
                    <li class="breadcrumb-item active" aria-current="page">RPT-07: Refund & Reversal</li>
                </ol>
            </nav>
            <h1 class="h3 mb-0 fw-bold" style="color:var(--emr-primary, #1e3a8a);">
                <i class="bi bi-arrow-counterclockwise me-2 text-danger"></i>RPT-07: Refund & Reversal Report
            </h1>
            <p class="text-muted small mb-0 mt-1">Audit log of patient refunds and corresponding commission reversals.</p>
        </div>
        <div class="d-flex gap-2">
            <button type="button" class="btn btn-outline-secondary btn-sm" onclick="window.print()">
                <i class="bi bi-printer-fill me-1"></i>Print Report
            </button>
        </div>
    </div>

    <!-- Filter Card -->
    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-body p-3">
            <form asp-action="RefundReversals" method="get" class="row g-2 align-items-center">
                <div class="col-md-5">
                    <input type="date" name="fromDate" value="@(Model.FromDate?.ToString("yyyy-MM-dd"))" class="form-control" />
                </div>
                <div class="col-md-5">
                    <input type="date" name="toDate" value="@(Model.ToDate?.ToString("yyyy-MM-dd"))" class="form-control" />
                </div>
                <div class="col-md-2 d-flex gap-1">
                    <button type="submit" class="btn btn-danger w-100">
                        <i class="bi bi-filter me-1"></i>Filter
                    </button>
                    <a asp-action="RefundReversals" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-counterclockwise"></i>
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- Summary Metrics -->
    <div class="row g-3 mb-4">
        <div class="col-md-6">
            <div class="card border-0 shadow-sm rounded-3 p-3 bg-white border-start border-4 border-danger">
                <div class="text-muted small fw-semibold">TOTAL PATIENT REFUND AMOUNT</div>
                <div class="fs-4 fw-bold text-danger mt-1">₹@Model.TotalRefunded.ToString("N2")</div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card border-0 shadow-sm rounded-3 p-3 bg-white border-start border-4 border-warning">
                <div class="text-muted small fw-semibold">COMMISSION REVERSED / CLAWED BACK</div>
                <div class="fs-4 fw-bold text-warning mt-1">₹@Model.TotalReversedCommission.ToString("N2")</div>
            </div>
        </div>
    </div>

    <!-- Table Card -->
    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-3">Reversal Date</th>
                            <th>Visit #</th>
                            <th>Bill #</th>
                            <th>Doctor</th>
                            <th class="text-end">Original Bill (₹)</th>
                            <th class="text-end">Refund Amount (₹)</th>
                            <th>Reason</th>
                            <th>Approved By</th>
                            <th class="text-end pe-3">Comm. Reversal (₹)</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Rows.Any())
                        {
                            foreach (var r in Model.Rows)
                            {
                                <tr>
                                    <td class="ps-3 text-muted">@(r.Date?.ToString("dd MMM yyyy") ?? "—")</td>
                                    <td><span class="badge bg-light text-dark border">#@r.VisitNo</span></td>
                                    <td class="font-monospace">@(r.Bill ?? "—")</td>
                                    <td class="fw-semibold text-dark">@r.Doctor</td>
                                    <td class="text-end">₹@r.OriginalAmount.ToString("N2")</td>
                                    <td class="text-end text-danger fw-bold">₹@r.RefundAmount.ToString("N2")</td>
                                    <td>@(r.Reason ?? "Cancelled Encounter")</td>
                                    <td class="text-muted small">@r.ApprovedBy</td>
                                    <td class="text-end pe-3 text-warning fw-bold">₹@r.CommissionReversal.ToString("N2")</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="9" class="text-center py-5 text-muted">No refund or reversal records found for selected dates.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
