@model EMR.Web.Models.ViewModels.DoctorSettlementSummaryReportViewModel
@{
    ViewData["Title"] = "RPT-08: Doctor Settlement Summary";
}

<div class="container-fluid px-0">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1 small">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                    <li class="breadcrumb-item"><a asp-action="Index">Reports</a></li>
                    <li class="breadcrumb-item active" aria-current="page">RPT-08: Settlement Summary</li>
                </ol>
            </nav>
            <h1 class="h3 mb-0 fw-bold" style="color:var(--emr-primary, #1e3a8a);">
                <i class="bi bi-pie-chart-fill me-2 text-dark"></i>RPT-08: Doctor Settlement Summary
            </h1>
            <p class="text-muted small mb-0 mt-1">Executive summary of departmental & doctor-wise revenue generation, doctor shares, disbursed and pending balances.</p>
        </div>
        <div class="d-flex gap-2">
            <button type="button" class="btn btn-outline-secondary btn-sm" onclick="window.print()">
                <i class="bi bi-printer-fill me-1"></i>Print Summary
            </button>
        </div>
    </div>

    <!-- Filter Card -->
    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-body p-3">
            <form asp-action="SettlementSummary" method="get" class="row g-2 align-items-center">
                <div class="col-md-5">
                    <select name="doctorId" asp-items="Model.DoctorOptions" class="form-select"></select>
                </div>
                <div class="col-md-5">
                    <select name="period" asp-items="Model.PeriodOptions" class="form-select"></select>
                </div>
                <div class="col-md-2 d-flex gap-1">
                    <button type="submit" class="btn btn-dark w-100">
                        <i class="bi bi-filter me-1"></i>Filter
                    </button>
                    <a asp-action="SettlementSummary" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-counterclockwise"></i>
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- Summary Metrics -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-3 p-3 bg-white">
                <div class="text-muted small fw-semibold">TOTAL COLLECTION</div>
                <div class="fs-4 fw-bold text-dark mt-1">₹@Model.TotalCollection.ToString("N2")</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-3 p-3 bg-white">
                <div class="text-muted small fw-semibold">TOTAL COMMISSION</div>
                <div class="fs-4 fw-bold text-primary mt-1">₹@Model.TotalCommission.ToString("N2")</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-3 p-3 bg-white border-start border-4 border-success">
                <div class="text-muted small fw-semibold">TOTAL DISBURSED</div>
                <div class="fs-4 fw-bold text-success mt-1">₹@Model.TotalPaid.ToString("N2")</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-3 p-3 bg-white border-start border-4 border-warning">
                <div class="text-muted small fw-semibold">PENDING SETTLEMENT</div>
                <div class="fs-4 fw-bold text-warning mt-1">₹@Model.TotalYetToPay.ToString("N2")</div>
            </div>
        </div>
    </div>

    <!-- Table Card -->
    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-3">Doctor</th>
                            <th>Specialty</th>
                            <th class="text-center">Visits</th>
                            <th class="text-end">Collection (₹)</th>
                            <th class="text-end">Commission (₹)</th>
                            <th class="text-end">Paid (₹)</th>
                            <th class="text-end pe-3">Yet to Pay (₹)</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Rows.Any())
                        {
                            foreach (var r in Model.Rows)
                            {
                                <tr>
                                    <td class="ps-3 fw-bold text-dark">@r.Doctor</td>
                                    <td><span class="badge bg-light text-dark border">@(r.Specialty ?? "General OPD")</span></td>
                                    <td class="text-center"><span class="badge bg-primary bg-opacity-10 text-primary border">@r.Visits</span></td>
                                    <td class="text-end fw-semibold">₹@r.Collection.ToString("N2")</td>
                                    <td class="text-end text-primary fw-semibold">₹@r.Commission.ToString("N2")</td>
                                    <td class="text-end text-success fw-bold">₹@r.Paid.ToString("N2")</td>
                                    <td class="text-end pe-3 text-warning fw-bold">₹@r.YetToPay.ToString("N2")</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center py-5 text-muted">No settlement summary records found.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
