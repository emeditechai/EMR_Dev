@model EMR.Web.Models.ViewModels.VisitPaymentStatusReportViewModel
@{
    ViewData["Title"] = "RPT-01: Visit Payment Status Report";
}

<div class="container-fluid px-0">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1 small">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                    <li class="breadcrumb-item"><a asp-action="Index">Reports</a></li>
                    <li class="breadcrumb-item active" aria-current="page">RPT-01: Visit Payment Status</li>
                </ol>
            </nav>
            <h1 class="h3 mb-0 fw-bold" style="color:var(--emr-primary, #1e3a8a);">
                <i class="bi bi-clipboard2-check me-2 text-primary"></i>RPT-01: Visit Payment Status Report
            </h1>
            <p class="text-muted small mb-0 mt-1">Visit-level patient billing status, payments received, and remaining outstanding balances.</p>
        </div>
        <div class="d-flex gap-2">
            <button type="button" class="btn btn-outline-secondary btn-sm" onclick="window.print()">
                <i class="bi bi-printer-fill me-1"></i>Print
            </button>
        </div>
    </div>

    <!-- Filter Card -->
    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-body p-3">
            <form asp-action="VisitPaymentStatus" method="get" class="row g-2 align-items-center">
                <div class="col-md-4">
                    <select name="doctorId" asp-items="Model.DoctorOptions" class="form-select"></select>
                </div>
                <div class="col-md-3">
                    <input type="date" name="fromDate" value="@(Model.FromDate?.ToString("yyyy-MM-dd"))" class="form-control" />
                </div>
                <div class="col-md-3">
                    <input type="date" name="toDate" value="@(Model.ToDate?.ToString("yyyy-MM-dd"))" class="form-control" />
                </div>
                <div class="col-md-2 d-flex gap-1">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="bi bi-filter me-1"></i>Filter
                    </button>
                    <a asp-action="VisitPaymentStatus" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-counterclockwise"></i>
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- Summary Metrics -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-3 p-3 bg-white">
                <div class="text-muted small fw-semibold">TOTAL BILLED AMOUNT</div>
                <div class="fs-4 fw-bold text-dark mt-1">₹@Model.TotalNet.ToString("N2")</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-3 p-3 bg-white border-start border-4 border-success">
                <div class="text-muted small fw-semibold">TOTAL PAID</div>
                <div class="fs-4 fw-bold text-success mt-1">₹@Model.TotalPaid.ToString("N2")</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-3 p-3 bg-white border-start border-4 border-warning">
                <div class="text-muted small fw-semibold">TOTAL OUTSTANDING</div>
                <div class="fs-4 fw-bold text-warning mt-1">₹@Model.TotalOutstanding.ToString("N2")</div>
            </div>
        </div>
    </div>

    <!-- Table Card -->
    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-3">Visit Date</th>
                            <th>Visit #</th>
                            <th>Patient (UHID / Name)</th>
                            <th>Doctor</th>
                            <th>Bill #</th>
                            <th class="text-end">Net Bill (₹)</th>
                            <th class="text-end">Paid (₹)</th>
                            <th class="text-end">Outstanding (₹)</th>
                            <th class="text-end pe-3">Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Rows.Any())
                        {
                            foreach (var r in Model.Rows)
                            {
                                <tr>
                                    <td class="ps-3 text-muted">@r.VisitDate.ToString("dd MMM yyyy")</td>
                                    <td><span class="badge bg-light text-dark border">#@r.VisitNo</span></td>
                                    <td class="fw-semibold text-dark">@r.Patient</td>
                                    <td>@r.Doctor</td>
                                    <td class="font-monospace">@(r.Bill ?? "—")</td>
                                    <td class="text-end fw-semibold">₹@r.NetAmount.ToString("N2")</td>
                                    <td class="text-end text-success fw-semibold">₹@r.Paid.ToString("N2")</td>
                                    <td class="text-end text-danger fw-semibold">₹@r.Outstanding.ToString("N2")</td>
                                    <td class="text-end pe-3">
                                        <span class="badge @(r.Status == "Paid" ? "text-bg-success" : (r.Status == "Partial" ? "text-bg-warning" : "text-bg-danger"))">
                                            @r.Status
                                        </span>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="9" class="text-center py-5 text-muted">No visit payment records found.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
