@model IEnumerable<EMR.Web.Models.ViewModels.DoctorListItemViewModel>
@{
    ViewData["Title"] = "Doctor Master";
    var doctors = Model.ToList();
    var total = doctors.Count;
    var active = doctors.Count(x => x.IsActive);
    var inactive = total - active;
    var withFees = doctors.Count(x => !string.IsNullOrWhiteSpace(x.ConsultingFeeNames));
    var opdDoctors = doctors.Count(x => x.HasOPDDept);
    var avatarColors = new[] { "#2563eb", "#7c3aed", "#0d9488", "#d97706", "#db2777", "#0891b2" };
    static string[] SplitList(string? s) => (s ?? string.Empty).Split(", ", StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
    var specialities = doctors.Select(d => d.PrimarySpecialityName).Where(s => !string.IsNullOrWhiteSpace(s)).Distinct().OrderBy(s => s).ToList();
    var deptTypes = ViewBag.DeptTypes as Dictionary<string, string> ?? new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
    var departments = doctors.SelectMany(d => SplitList(d.DepartmentNames)).Distinct(StringComparer.OrdinalIgnoreCase)
        .Select(n => new { Name = n, Type = deptTypes.TryGetValue(n, out var ty) ? ty : string.Empty })
        .OrderBy(d => d.Type).ThenBy(d => d.Name).ToList();
}
@section HeadStyles {
    <link href="~/lib/select2/dist/css/select2.min.css" rel="stylesheet" />
    <link href="~/lib/select2-bootstrap-5-theme/dist/select2-bootstrap-5-theme.min.css" rel="stylesheet" />
}

<style>
    .dm-avatar { width: 40px; height: 40px; border-radius: 50%; flex-shrink: 0; display: inline-flex; align-items: center; justify-content: center; color: #fff; font-weight: 700; font-size: .85rem; box-shadow: 0 1px 3px rgba(15,23,42,.18); }
    .dm-name { font-weight: 600; color: #0f172a; line-height: 1.2; }
    .dm-sub { font-size: .76rem; color: #64748b; }
    .dm-chip { display: inline-flex; align-items: center; gap: .25rem; font-size: .74rem; background: #f1f5f9; color: #334155; border: 1px solid #e2e8f0; border-radius: 1rem; padding: .1rem .55rem; margin: 0 .2rem .2rem 0; white-space: nowrap; }
    .dm-fee { display: inline-flex; align-items: center; font-size: .74rem; font-weight: 600; background: #ecfdf5; color: #047857; border: 1px solid #a7f3d0; border-radius: 1rem; padding: .1rem .55rem; white-space: nowrap; }
    .dm-table thead th { background: #f8fafc; font-size: .72rem; text-transform: uppercase; letter-spacing: .05em; color: #64748b; font-weight: 700; border-bottom: 1px solid #e2e8f0; white-space: nowrap; }
    .dm-table tbody tr { transition: background .12s; }
    .dm-table tbody tr.dm-inactive td { opacity: .62; }
    .dm-table tbody tr.dm-inactive td:last-child { opacity: 1; }
    .dm-kpi { border: 0; border-left: 4px solid var(--k); border-radius: .75rem; }
    .dm-kpi .dm-kpi-icon { width: 46px; height: 46px; border-radius: .75rem; background: var(--kb); color: var(--k); display: flex; align-items: center; justify-content: center; font-size: 1.35rem; }
    .dm-kpi .dm-kpi-num { font-size: 1.75rem; font-weight: 800; line-height: 1; color: var(--k); }
</style>

<div class="container-fluid px-4 py-3">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                    <li class="breadcrumb-item text-muted">Master</li>
                    <li class="breadcrumb-item active" aria-current="page">Doctor Master</li>
                </ol>
            </nav>
            <h4 class="fw-bold mb-0 text-primary"><i class="bi bi-person-vcard-fill me-2"></i>Doctor Master</h4>
            @if (ViewBag.BranchName is string bn)
            {
                <div class="text-muted small mt-1"><i class="bi bi-building me-1"></i>Branch: <strong class="text-dark">@bn</strong></div>
            }
        </div>
        <a asp-action="Create" class="btn btn-primary px-3 shadow-sm"><i class="bi bi-person-plus-fill me-1"></i> Add Doctor</a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- KPI cards -->
    <div class="row g-3 mb-4">
        <div class="col-xl col-md-4 col-6">
            <div class="card shadow-sm dm-kpi h-100" style="--k:#2563eb;--kb:#dbeafe;"><div class="card-body p-3 d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small fw-semibold text-uppercase d-block mb-1">Total Doctors</span>
                    <div class="dm-kpi-num">@total</div>
                </div>
                <div class="dm-kpi-icon"><i class="bi bi-person-vcard-fill"></i></div>
            </div></div>
        </div>
        <div class="col-xl col-md-4 col-6">
            <div class="card shadow-sm dm-kpi h-100" style="--k:#16a34a;--kb:#dcfce7;"><div class="card-body p-3 d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small fw-semibold text-uppercase d-block mb-1">Active</span>
                    <div class="dm-kpi-num">@active</div>
                </div>
                <div class="dm-kpi-icon"><i class="bi bi-person-check-fill"></i></div>
            </div></div>
        </div>
        <div class="col-xl col-md-4 col-6">
            <div class="card shadow-sm dm-kpi h-100" style="--k:#dc2626;--kb:#fee2e2;"><div class="card-body p-3 d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small fw-semibold text-uppercase d-block mb-1">Inactive</span>
                    <div class="dm-kpi-num">@inactive</div>
                </div>
                <div class="dm-kpi-icon"><i class="bi bi-person-x-fill"></i></div>
            </div></div>
        </div>
        <div class="col-xl col-md-6 col-6">
            <div class="card shadow-sm dm-kpi h-100" style="--k:#7c3aed;--kb:#ede9fe;"><div class="card-body p-3 d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small fw-semibold text-uppercase d-block mb-1">OPD Doctors</span>
                    <div class="dm-kpi-num">@opdDoctors</div>
                    <span class="badge mt-1" style="background:#ede9fe;color:#5b21b6;">schedulable in OPD</span>
                </div>
                <div class="dm-kpi-icon"><i class="bi bi-calendar-week"></i></div>
            </div></div>
        </div>
        <div class="col-xl col-md-6 col-6">
            <div class="card shadow-sm dm-kpi h-100" style="--k:#0d9488;--kb:#ccfbf1;"><div class="card-body p-3 d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small fw-semibold text-uppercase d-block mb-1">Fees Configured</span>
                    <div class="dm-kpi-num">@withFees</div>
                    @if (total - withFees > 0)
                    {
                        <span class="badge mt-1" style="background:#fff7ed;color:#c2410c;">@(total - withFees) without fees</span>
                    }
                </div>
                <div class="dm-kpi-icon"><i class="bi bi-currency-rupee"></i></div>
            </div></div>
        </div>
    </div>

    <!-- Filters (applied instantly in the browser) -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-3">
            <div class="row g-3 align-items-end">
                <div class="col-md-4">
                    <label class="form-label small fw-semibold text-muted mb-1" for="dmSearch">Search</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
                        <input type="text" id="dmSearch" class="form-control border-start-0" placeholder="Name, phone, email, speciality or department..." autocomplete="off" />
                    </div>
                </div>
                <div class="col-md-2 col-6">
                    <label class="form-label small fw-semibold text-muted mb-1" for="dmStatus">Status</label>
                    <select id="dmStatus" class="form-select">
                        <option value="">All statuses</option>
                        <option value="active">Active</option>
                        <option value="inactive">Inactive</option>
                    </select>
                </div>
                <div class="col-md-2 col-6">
                    <label class="form-label small fw-semibold text-muted mb-1" for="dmSpeciality">Speciality</label>
                    <select id="dmSpeciality" class="form-select">
                        <option value="">All specialities</option>
                        @foreach (var s in specialities)
                        {
                            <option value="@s.ToLowerInvariant()">@s</option>
                        }
                    </select>
                </div>
                <div class="col-md-2 col-6">
                    <label class="form-label small fw-semibold text-muted mb-1" for="dmDept">Department</label>
                    <select id="dmDept" class="form-select">
                        <option value="">All departments</option>
                        @foreach (var d in departments)
                        {
                            <option value="@d.Name.ToLowerInvariant()">@(string.IsNullOrEmpty(d.Type) || d.Name.EndsWith($"({d.Type})", StringComparison.OrdinalIgnoreCase) ? d.Name : $"{d.Name} ({d.Type})")</option>
                        }
                    </select>
                </div>
                <div class="col-md-2 col-6 d-flex gap-2">
                    <button type="button" id="dmReset" class="btn btn-outline-secondary w-100"><i class="bi bi-arrow-counterclockwise me-1"></i>Reset</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Doctors table -->
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
            <span class="fw-bold text-dark"><i class="bi bi-list-ul text-primary me-2"></i>Doctors</span>
            <span class="text-muted small" id="dmCount">Showing @total of @total</span>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 dm-table" id="dmTable">
                    <thead>
                        <tr>
                            <th class="ps-4">Doctor</th>
                            <th>Department(s)</th>
                            <th>Consulting Fees</th>
                            <th>Contact</th>
                            <th class="text-center">Status</th>
                            <th class="text-end pe-4" style="width:150px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in doctors)
                        {
                            var nameOnly = System.Text.RegularExpressions.Regex.Replace(item.FullName ?? "", @"^(Dr|Mr|Mrs|Ms|Prof)\.?\s+", "", System.Text.RegularExpressions.RegexOptions.IgnoreCase);
                            var initials = string.Concat(nameOnly.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(w => char.ToUpperInvariant(w[0])));
                            if (string.IsNullOrEmpty(initials)) { initials = "?"; }
                            var color = avatarColors[item.DoctorId % avatarColors.Length];
                            var depts = SplitList(item.DepartmentNames);
                            var cfFees = SplitList(item.ConsultingFeeNames);
                            var searchText = string.Join(' ', new[] { item.FullName, item.PhoneNumber, item.EmailId, item.PrimarySpecialityName, item.DepartmentNames }).ToLowerInvariant();

                            <tr class="@(item.IsActive ? "" : "dm-inactive")" data-search="@searchText" data-status="@(item.IsActive ? "active" : "inactive")"
                                data-speciality="@((item.PrimarySpecialityName ?? "").ToLowerInvariant())" data-depts="@string.Join('|', depts.Select(d => d.ToLowerInvariant()))">
                                <td class="ps-4">
                                    <div class="d-flex align-items-center gap-3">
                                        <span class="dm-avatar" style="background:@color">@initials</span>
                                        <div style="min-width:0;">
                                            <div class="dm-name">@item.FullName</div>
                                            <div class="dm-sub">
                                                <i class="bi bi-heart-pulse me-1"></i>@(string.IsNullOrWhiteSpace(item.PrimarySpecialityName) ? "—" : item.PrimarySpecialityName)
                                                @if (item.HasOPDDept)
                                                {
                                                    <span class="badge ms-1" style="background:#ede9fe;color:#5b21b6;font-size:.64rem;">OPD</span>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    @if (depts.Length > 0)
                                    {
                                        foreach (var d in depts.Take(2))
                                        {
                                            <span class="dm-chip"><i class="bi bi-diagram-2 text-primary"></i>@d</span>
                                        }
                                        if (depts.Length > 2)
                                        {
                                            <span class="dm-chip" title="@string.Join(", ", depts.Skip(2))">+@(depts.Length - 2)</span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted small">—</span>
                                    }
                                </td>
                                <td>
                                    @if (cfFees.Length == 0)
                                    {
                                        <span class="text-muted small">Not set</span>
                                    }
                                    else
                                    {
                                        <span class="dm-fee">@cfFees[0]</span>
                                        @if (cfFees.Length > 1)
                                        {
                                            <button type="button" class="btn btn-link btn-sm p-0 ms-1 align-baseline text-decoration-none small"
                                                    data-doctor="@item.FullName"
                                                    data-fees="@System.Text.Json.JsonSerializer.Serialize(cfFees)"
                                                    onclick="showAllFees(this)"
                                                    title="View all @cfFees.Length fees">+@(cfFees.Length - 1) more</button>
                                        }
                                    }
                                </td>
                                <td class="small">
                                    <div class="text-nowrap"><i class="bi bi-telephone text-muted me-1"></i>@(string.IsNullOrWhiteSpace(item.PhoneNumber) ? "—" : item.PhoneNumber)</div>
                                    @if (!string.IsNullOrWhiteSpace(item.EmailId))
                                    {
                                        <a href="mailto:@item.EmailId" class="text-decoration-none text-muted text-nowrap"><i class="bi bi-envelope me-1"></i>@item.EmailId</a>
                                    }
                                </td>
                                <td class="text-center">
                                    @if (item.IsActive)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-1 rounded-pill"><i class="bi bi-check-circle-fill me-1"></i>Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-3 py-1 rounded-pill"><i class="bi bi-x-circle-fill me-1"></i>Inactive</span>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    <div class="btn-group btn-group-sm shadow-sm doctor-action-dropdown" role="group">
                                        <a asp-action="Details" asp-route-id="@item.DoctorId" class="btn btn-outline-info" title="View Details"><i class="bi bi-eye"></i></a>
                                        <a asp-action="Edit" asp-route-id="@item.DoctorId" class="btn btn-outline-primary" title="Edit Doctor"><i class="bi bi-pencil"></i></a>
                                        <button type="button" class="btn btn-outline-secondary dropdown-toggle dropdown-toggle-split" title="More actions"
                                                data-bs-toggle="dropdown" data-bs-boundary="viewport" data-bs-strategy="fixed" aria-expanded="false">
                                            <span class="visually-hidden">More actions</span>
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                                            <li>
                                                <button type="button" class="dropdown-item"
                                                        onclick="openConsultingModal(@item.DoctorId, '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(item.FullName ?? ""))')">
                                                    <i class="bi bi-currency-rupee me-2 text-primary"></i>Consulting Charges
                                                </button>
                                            </li>
                                            @if (item.HasOPDDept)
                                            {
                                                <li>
                                                    <a class="dropdown-item" asp-controller="DoctorSchedules" asp-action="Configure" asp-route-doctorId="@item.DoctorId">
                                                        <i class="bi bi-calendar-week me-2 text-info"></i>Configure Scheduler
                                                    </a>
                                                </li>
                                            }
                                        </ul>
                                    </div>
                                </td>
                            </tr>
                        }
                        <tr id="dmEmpty" style="@(doctors.Any() ? "display:none;" : "")">
                            <td colspan="6" class="text-center py-5 text-muted">
                                <i class="bi bi-person-vcard display-6 d-block mb-2 text-secondary"></i>
                                <span>@(doctors.Any() ? "No doctors match your filters." : "No doctors found.")</span>
                                @if (!doctors.Any())
                                {
                                    <a asp-action="Create" class="ms-1">Add one now.</a>
                                }
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@* ═══════════════════ VIEW ALL FEES MODAL ═══════════════════ *@
<div class="modal fade" id="viewFeesModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-info text-white">
                <h5 class="modal-title">
                    <i class="bi bi-currency-rupee me-2"></i>Consulting Fees &mdash; <span id="vfDoctorName"></span>
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div id="vfFeesList" class="d-flex flex-wrap gap-2 py-1"></div>
            </div>
            <div class="modal-footer border-0 bg-light">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                    <i class="bi bi-x-lg me-1"></i>Close
                </button>
            </div>
        </div>
    </div>
</div>

@* ═══════════════════ CONSULTING FEES MODAL ═══════════════════ *@
<div class="modal fade" id="consultingFeeModal" tabindex="-1" aria-labelledby="consultingFeeModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="consultingFeeModalLabel">
                    <i class="bi bi-currency-rupee me-2"></i>
                    Consulting Charges &mdash; <span id="cfDoctorName"></span>
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">

                @* Search + Add row *@
                <div class="card mb-4 border-0 bg-light rounded-3">
                    <div class="card-body py-3">
                        <label class="form-label fw-semibold mb-2">
                            <i class="bi bi-search me-1 text-primary"></i>Search &amp; Add Consulting Fee
                        </label>
                        <div style="position:relative">
                            <div class="input-group">
                                <span class="input-group-text bg-white"><i class="bi bi-stethoscope text-primary"></i></span>
                                <input type="text" id="cfSearchInput" class="form-control"
                                       placeholder="Type item code or service name…" autocomplete="off" />
                                <div id="cfGraceTimeWrapper" class="d-none">
                                    <input type="number" id="cfGraceTimeInput" class="form-control" placeholder="Grace (mins)" style="width: 130px; border-radius: 0;" min="0" />
                                </div>
                                <button class="btn btn-primary px-3" id="cfAddBtn" disabled>
                                    <i class="bi bi-plus-lg me-1"></i>Add
                                </button>
                            </div>
                            <div id="cfSuggestions" class="list-group shadow"
                                 style="position:absolute;left:0;right:0;top:100%;z-index:1060;max-height:220px;overflow-y:auto;display:none"></div>
                        </div>
                        <div id="cfSelectedPreview" class="mt-2 d-none">
                            <span class="badge text-bg-primary px-3 py-2 fs-6" id="cfSelectedLabel"></span>
                        </div>
                        <div id="cfNoServices" class="alert alert-warning mt-2 mb-0 py-2 d-none">
                            <i class="bi bi-exclamation-triangle me-2"></i>
                            No consulting services available. Add them in
                            <a href="/Services/Index" target="_blank">Service Master</a> first.
                        </div>
                    </div>
                </div>

                @* Mapped fees table *@
                <h6 class="fw-bold mb-2">
                    <i class="bi bi-list-check me-2 text-primary"></i>Mapped Consulting Fees
                </h6>
                <div id="cfTableWrapper">
                    <p class="text-muted text-center py-3" id="cfLoadingMsg">
                        <span class="spinner-border spinner-border-sm me-2"></span>Loading…
                    </p>
                    <table class="table table-sm table-bordered table-hover align-middle mb-0 d-none" id="cfTable">
                        <thead class="table-light">
                            <tr>
                                <th>Item Code</th>
                                <th>Item Name</th>
                                <th class="text-end">Charges (₹)</th>
                                <th class="text-center" style="width:120px">Grace (mins)</th>
                                <th class="text-center" style="width:70px">Remove</th>
                            </tr>
                        </thead>
                        <tbody id="cfTableBody"></tbody>
                    </table>
                    <p class="text-muted text-center py-3 fst-italic d-none" id="cfEmptyMsg">
                        <i class="bi bi-inbox fs-4 d-block mb-1 opacity-50"></i>
                        No consulting fees mapped yet.
                    </p>
                </div>
            </div>
            <div class="modal-footer bg-light border-0">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                    <i class="bi bi-x-lg me-1"></i>Close
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
@Html.AntiForgeryToken()
<script>
(function () {
    'use strict';

    let currentDoctorId = 0;
    let allServices     = [];
    let selectedService = null;

    function antiForgeryToken() {
        return document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';
    }

    // ── View-all fees ──────────────────────────────────────────────
    window.showAllFees = function (btn) {
        const doctorName = btn.dataset.doctor;
        const fees = JSON.parse(btn.dataset.fees);
        document.getElementById('vfDoctorName').textContent = doctorName;
        const list = document.getElementById('vfFeesList');
        list.innerHTML = fees.map(f =>
            `<span class="badge text-bg-info fs-6 px-3 py-2">${f}</span>`
        ).join('');
        bootstrap.Modal.getOrCreateInstance(document.getElementById('viewFeesModal')).show();
    };

    const modalEl       = document.getElementById('consultingFeeModal');
    const bsModal       = new bootstrap.Modal(modalEl);
    const nameEl        = document.getElementById('cfDoctorName');
    const searchInput   = document.getElementById('cfSearchInput');
    const suggestions   = document.getElementById('cfSuggestions');
    const addBtn        = document.getElementById('cfAddBtn');
    const selectedPrev  = document.getElementById('cfSelectedPreview');
    const selectedLabel = document.getElementById('cfSelectedLabel');
    const noServices    = document.getElementById('cfNoServices');
    const loadingMsg    = document.getElementById('cfLoadingMsg');
    const cfTable       = document.getElementById('cfTable');
    const cfTableBody   = document.getElementById('cfTableBody');
    const emptyMsg      = document.getElementById('cfEmptyMsg');

    window.openConsultingModal = async function (doctorId, doctorName) {
        currentDoctorId   = doctorId;
        selectedService   = null;
        nameEl.textContent = doctorName;
        searchInput.value  = '';
        suggestions.style.display = 'none';
        suggestions.innerHTML = '';
        selectedPrev.classList.add('d-none');
        noServices.classList.add('d-none');
        addBtn.disabled = true;
        bsModal.show();
        await loadServices();
        await loadFees();
    };

    async function loadServices() {
        try {
            const res = await fetch('/Doctors/GetConsultingServices');
            allServices = await res.json();
            if (allServices.length === 0) noServices.classList.remove('d-none');
        } catch { noServices.classList.remove('d-none'); }
    }

    async function loadFees() {
        loadingMsg.classList.remove('d-none');
        cfTable.classList.add('d-none');
        emptyMsg.classList.add('d-none');
        const res  = await fetch('/Doctors/GetDoctorFees?doctorId=' + currentDoctorId);
        const fees = await res.json();
        renderFees(fees);
    }

    function renderFees(fees) {
        loadingMsg.classList.add('d-none');
        cfTableBody.innerHTML = '';
        if (!fees || fees.length === 0) {
            cfTable.classList.add('d-none');
            emptyMsg.classList.remove('d-none');
            return;
        }
        emptyMsg.classList.add('d-none');
        cfTable.classList.remove('d-none');
        fees.forEach(f => {
            const tr = document.createElement('tr');
            let graceTimeHtml = '<span class="text-muted small fst-italic">N/A</span>';
            if (f.consultingType === 'Video') {
                const val = f.graceTime !== null ? f.graceTime : '';
                graceTimeHtml = '<input type="number" class="form-control form-control-sm text-center mx-auto" style="width: 80px;" min="0" value="' + val + '" onchange="window.updateGraceTime(' + f.mappingId + ', this.value)" placeholder="--" />';
            }
            tr.innerHTML =
                '<td><span class="badge text-bg-light border font-monospace text-dark">' + f.itemCode + '</span></td>' +
                '<td class="fw-semibold">' + f.itemName + '</td>' +
                '<td class="text-end fw-semibold text-success">₹' + Number(f.itemCharges).toFixed(2) + '</td>' +
                '<td class="text-center">' + graceTimeHtml + '</td>' +
                '<td class="text-center"><button class="btn btn-sm btn-outline-danger" onclick="window.removeFee(' + f.mappingId + ')" title="Remove"><i class="bi bi-trash3"></i></button></td>';
            cfTableBody.appendChild(tr);
        });
    }

    window.updateGraceTime = async function(mappingId, val) {
        const graceTime = val ? parseInt(val) : null;
        try {
            await fetch('/Doctors/UpdateGraceTime', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': antiForgeryToken() },
                body: JSON.stringify({ mappingId: mappingId, doctorId: currentDoctorId, graceTime: graceTime })
            });
        } catch (e) {
            console.error('Failed to update grace time', e);
        }
    };

    searchInput.addEventListener('input', function () {
        const q = this.value.trim().toLowerCase();
        selectedService = null;
        addBtn.disabled = true;
        selectedPrev.classList.add('d-none');
        if (!q) { suggestions.style.display = 'none'; return; }
        const matches = allServices.filter(s =>
            s.itemCode.toLowerCase().includes(q) || s.itemName.toLowerCase().includes(q));
        if (!matches.length) {
            suggestions.innerHTML = '<div class="list-group-item text-muted fst-italic">No matches found</div>';
            suggestions.style.display = 'block';
            return;
        }
        suggestions.innerHTML = matches.map(s =>
            '<button type="button" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center" data-id="' + s.serviceId + '">' +
            '<span><span class="badge text-bg-light border font-monospace text-dark me-2">' + s.itemCode + '</span>' + s.itemName + '</span>' +
            '<span class="text-success fw-semibold">₹' + Number(s.itemCharges).toFixed(2) + '</span>' +
            '</button>'
        ).join('');
        suggestions.style.display = 'block';
    });

    suggestions.addEventListener('click', function (e) {
        const btn = e.target.closest('[data-id]');
        if (!btn) return;
        const svc = allServices.find(s => s.serviceId == btn.dataset.id);
        if (!svc) return;
        selectedService = svc;
        searchInput.value = svc.itemCode + ' — ' + svc.itemName;
        suggestions.style.display = 'none';
        selectedLabel.textContent = svc.itemCode + ' — ' + svc.itemName + ' (₹' + Number(svc.itemCharges).toFixed(2) + ')';
        selectedPrev.classList.remove('d-none');
        
        if (svc.consultingType === 'Video') {
            document.getElementById('cfGraceTimeWrapper').classList.remove('d-none');
            document.getElementById('cfGraceTimeInput').value = '';
        } else {
            document.getElementById('cfGraceTimeWrapper').classList.add('d-none');
            document.getElementById('cfGraceTimeInput').value = '';
        }
        
        addBtn.disabled = false;
    });

    document.addEventListener('click', function (e) {
        if (!suggestions.contains(e.target) && e.target !== searchInput)
            suggestions.style.display = 'none';
    });

    addBtn.addEventListener('click', async function () {
        if (!selectedService) return;
        
        let graceTime = null;
        if (selectedService.consultingType === 'Video') {
            const val = document.getElementById('cfGraceTimeInput').value;
            if (val) graceTime = parseInt(val);
        }

        addBtn.disabled = true;
        addBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Adding…';
        try {
            const res  = await fetch('/Doctors/AddConsultingFee', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': antiForgeryToken() },
                body: JSON.stringify({ doctorId: currentDoctorId, serviceId: selectedService.serviceId, graceTime: graceTime })
            });
            const data = await res.json();
            if (data.success) {
                renderFees(data.fees);
                searchInput.value = '';
                selectedService   = null;
                selectedPrev.classList.add('d-none');
                document.getElementById('cfGraceTimeWrapper').classList.add('d-none');
                document.getElementById('cfGraceTimeInput').value = '';
                refreshRowFees(currentDoctorId, data.fees);
            }
        } finally {
            addBtn.innerHTML = '<i class="bi bi-plus-lg me-1"></i>Add';
            addBtn.disabled  = true;
        }
    });

    window.removeFee = async function (mappingId) {
        const result = await Swal.fire({
            title: 'Remove Fee?',
            text: 'Remove this consulting fee from the doctor?',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#dc3545',
            cancelButtonColor: '#6c757d',
            confirmButtonText: 'Yes, remove it',
            cancelButtonText: 'Cancel'
        });
        if (!result.isConfirmed) return;
        const res  = await fetch('/Doctors/RemoveConsultingFee', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': antiForgeryToken() },
            body: JSON.stringify({ mappingId: mappingId, doctorId: currentDoctorId })
        });
        const data = await res.json();
        if (data.success) {
            renderFees(data.fees);
            refreshRowFees(currentDoctorId, data.fees);
        }
    };

    function refreshRowFees(doctorId, fees) {
        const btn = document.querySelector('button[onclick*="openConsultingModal(' + doctorId + ',"]');
        if (!btn) return;
        const row = btn.closest('tr');
        if (!row) return;
        const td = row.querySelectorAll('td')[4];
        if (!td) return;
        if (!fees || fees.length === 0) {
            td.innerHTML = '<span class="text-muted small fst-italic">None</span>';
        } else {
            td.innerHTML = fees.map(f =>
                '<span class="badge text-bg-info text-white me-1 mb-1">' + f.itemName + ' (₹' + Number(f.itemCharges).toFixed(0) + ')</span>'
            ).join('');
        }
    }

    // reset state when modal closes
    modalEl.addEventListener('hidden.bs.modal', function () {
        searchInput.value = '';
        suggestions.style.display = 'none';
        selectedPrev.classList.add('d-none');
        document.getElementById('cfGraceTimeWrapper').classList.add('d-none');
        document.getElementById('cfGraceTimeInput').value = '';
        addBtn.disabled = true;
        selectedService = null;
    });
})();
</script>
<script src="~/lib/select2/dist/js/select2.min.js"></script>
<script>
    // Instant filters (same behaviour as User Master)
    (function () {
        const rows = [...document.querySelectorAll('#dmTable tbody tr[data-search]')];
        const search = document.getElementById('dmSearch');
        const status = document.getElementById('dmStatus');
        const spec = document.getElementById('dmSpeciality');
        const dept = document.getElementById('dmDept');
        const count = document.getElementById('dmCount');
        const empty = document.getElementById('dmEmpty');

        function apply() {
            const term = search.value.toLowerCase().trim();
            let shown = 0;
            rows.forEach(r => {
                const ok = (!term || r.dataset.search.includes(term))
                    && (!status.value || r.dataset.status === status.value)
                    && (!spec.value || r.dataset.speciality === spec.value)
                    && (!dept.value || r.dataset.depts.split('|').includes(dept.value));
                r.style.display = ok ? '' : 'none';
                if (ok) shown++;
            });
            count.textContent = 'Showing ' + shown + ' of ' + rows.length;
            empty.style.display = (rows.length > 0 && shown === 0) ? '' : 'none';
        }

        // Speciality / Department: auto-suggest (type to search) dropdowns
        $('#dmSpeciality, #dmDept').each(function () {
            $(this).select2({ theme: 'bootstrap-5', width: '100%', allowClear: true,
                placeholder: this.id === 'dmDept' ? 'All departments' : 'All specialities' });
        });

        search.addEventListener('input', apply);
        $('#dmStatus, #dmSpeciality, #dmDept').on('change', apply);
        document.getElementById('dmReset').addEventListener('click', () => {
            search.value = ''; status.value = '';
            $('#dmSpeciality, #dmDept').val('').trigger('change.select2');
            apply(); search.focus();
        });
    })();
</script>
}
