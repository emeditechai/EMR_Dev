@model EMR.Web.Controllers.EmailTemplateEditViewModel
@{
    ViewData["Title"] = "Add Email Template";
    ViewData["PageName"] = "Email Templates";
}

<div class="d-flex justify-content-between align-items-start gap-3 mb-3">
    <div>
        <h1 class="h3 mb-0"><i class="bi bi-envelope-paper me-2" style="color:#644098"></i>Add Email Template</h1>
        <p class="text-muted small mb-0 mt-1">Choose the email, design it and check the preview before saving.</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary shadow-sm flex-shrink-0"><i class="bi bi-arrow-left me-1"></i>Back to List</a>
</div>

<partial name="_Designer" model="Model" />
