@model EMR.Web.Controllers.EmailTemplateEditViewModel
@{
    ViewData["Title"] = "Edit Email Template";
    ViewData["PageName"] = "Email Templates";
}

<div class="d-flex justify-content-between align-items-start gap-3 mb-3">
    <div>
        <h1 class="h3 mb-0"><i class="bi bi-envelope-paper me-2" style="color:#644098"></i>Edit Email Template</h1>
        <p class="text-muted small mb-0 mt-1">Change the wording, details and note - the preview on the right shows the email as the patient will see it.</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary shadow-sm flex-shrink-0"><i class="bi bi-arrow-left me-1"></i>Back to List</a>
</div>

<partial name="_Designer" model="Model" />
