@model IEnumerable<EMR.Web.Models.Entities.EmailTemplate>
@{
    ViewData["Title"] = "Email Templates";
    ViewData["PageName"] = "Email Templates";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-0 text-gray-800">
            <i class="bi bi-envelope-paper me-2 text-primary"></i>Email Templates
        </h1>
        <p class="text-muted small mb-0 mt-1">The emails sent to patients. Open one to change its wording in the designer and see a live preview.</p>
    </div>
    @if (ViewBag.MissingTypes is List<string> { Count: > 0 })
    {
        <a asp-permission="UTILITY.EMAILTEMPLATE:ADD" asp-action="Create" class="btn btn-primary shadow-sm">
            <i class="bi bi-plus-lg me-1"></i> Add Template
        </a>
    }
</div>

@if (ViewBag.MissingTypes is List<string> missing && missing.Count > 0)
{
    <div class="alert alert-warning d-flex align-items-start gap-2 py-2">
        <i class="bi bi-exclamation-triangle mt-1"></i>
        <div class="small">
            <strong>Not sent for this branch:</strong> @string.Join(", ", missing) - there is no template for @(missing.Count == 1 ? "it" : "them").
            @foreach (var m in missing)
            {
                <a asp-permission="UTILITY.EMAILTEMPLATE:ADD" asp-action="Create" asp-route-type="@m" class="ms-2 fw-semibold">Add @m</a>
            }
        </div>
    </div>
}

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Email</th>
                        <th>Subject</th>
                        <th>Status</th>
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="4" class="text-center py-4 text-muted">
                                <i class="bi bi-inbox fs-2 opacity-50 d-block mb-2"></i>
                                No templates found. Click "Add Template" to create one.
                            </td>
                        </tr>
                    }
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4">
                                <div class="fw-semibold text-primary">@item.TemplateName</div>
                                <div class="small text-muted">@(EMR.Web.Services.EmailTemplateDesigner.Find(item.TemplateName)?.Description ?? "Custom template")</div>
                            </td>
                            <td>@System.Text.RegularExpressions.Regex.Replace(item.Subject, @"\{\{\s*([A-Za-z0-9_]+)\s*\}\}",
                                    m => "[" + (EMR.Web.Services.EmailTemplateDesigner.Find(item.TemplateName)?.Fields.FirstOrDefault(f => f.Code == m.Groups[1].Value)?.Label ?? m.Groups[1].Value) + "]")</td>
                            <td>
                                @if (item.IsActive)
                                {
                                    <span class="badge bg-success rounded-pill px-3">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary rounded-pill px-3">Inactive</span>
                                }
                            </td>
                            <td class="text-end pe-4">
                                <a asp-permission="UTILITY.EMAILTEMPLATE:EDIT" asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary me-2">
                                    <i class="bi bi-pencil"></i> Edit / Preview
                                </a>
                                <form asp-permission="UTILITY.EMAILTEMPLATE:DELETE" asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this template?');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
