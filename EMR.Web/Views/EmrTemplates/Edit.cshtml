@model EMR.Web.Models.ViewModels.EmrTemplateViewModel
@{
    ViewData["Title"] = "Edit EMR Template";
}

@section HeadStyles {
    <link href="~/lib/select2/dist/css/select2.min.css" rel="stylesheet" />
    <link href="~/lib/select2-bootstrap-5-theme/dist/select2-bootstrap-5-theme.min.css" rel="stylesheet" />
    <link href="~/lib/quill/quill.snow.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/views/EmrTemplates/Edit.css" asp-append-version="true" />
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-0 fw-bold">Edit EMR Template</h1>
        <small class="text-muted">Modify EMR clinical structure using the right-side toolbox and drag-and-drop</small>
    </div>
    <div class="d-flex gap-2">
        <button type="button" class="btn btn-outline-primary" id="btnPreviewTemplate">
            <i class="bi bi-eye me-1"></i>Preview Template
        </button>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>Back to Templates
        </a>
    </div>
</div>

<form asp-action="Edit" method="post" id="templateForm">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="TemplateId" />
    <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3"></div>

    @* ── Template Details Panel ── *@
    <div class="card border-0 shadow-sm mb-4" style="border-radius: 12px;">
        <div class="card-header bg-white py-3 border-bottom-0">
            <h5 class="fw-bold mb-0 text-primary"><i class="bi bi-file-earmark-text me-2"></i>Template Information</h5>
        </div>
        <div class="card-body pt-1">
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="TemplateName" class="form-label fw-semibold">Template Name <span class="text-danger">*</span></label>
                    <input asp-for="TemplateName" class="form-control" placeholder="e.g. Paediatric EMR Template" maxlength="150" />
                    <span asp-validation-for="TemplateName" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="SelectedSpecialityIds" class="form-label fw-semibold">Map to Specialities <span class="text-danger">*</span></label>
                    <select asp-for="SelectedSpecialityIds" class="form-select select2-multiple" multiple asp-items="Model.SpecialityOptions" data-placeholder="Choose one or more specialities..."></select>
                    <span asp-validation-for="SelectedSpecialityIds" class="text-danger small"></span>
                </div>
                <div class="col-md-12">
                    <label asp-for="Description" class="form-label fw-semibold">Description</label>
                    <textarea asp-for="Description" class="form-control" rows="2" placeholder="Briefly describe the clinical use case of this template..." maxlength="500"></textarea>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>
                <div class="col-md-12">
                    <div class="form-check form-switch mt-1">
                        <input asp-for="IsActive" class="form-check-input" type="checkbox" role="switch" />
                        <label asp-for="IsActive" class="form-check-label fw-semibold">Active Status</label>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* ── 2-Column Drag and Drop Editor ── *@
    <div class="row">
        @* Left Column: Canvas *@
        <div class="col-lg-9">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h4 class="fw-bold mb-0 text-dark"><i class="bi bi-layout-three-columns me-2 text-primary"></i>EMR Sections & Fields Canvas</h4>
            </div>

            <div id="sectionsContainer" class="mb-4">
                @* Pre-render existing sections and fields from server *@
                @for (int sIdx = 0; sIdx < Model.Sections.Count; sIdx++)
                {
                    var sec = Model.Sections[sIdx];
                    var isActiveSection = sIdx == 0 ? "active-section" : "";
                    <div class="card border-0 shadow-sm mb-3 section-card @isActiveSection" data-section-index="@sIdx" onclick="selectSection(this)">
                        <input type="hidden" name="Sections[@sIdx].SectionId" value="@sec.SectionId" class="section-id-input" />
                        <div class="card-header bg-white py-2 px-3 border-bottom d-flex justify-content-between align-items-center">
                            <div class="d-flex align-items-center gap-2 flex-grow-1 me-3">
                                <i class="bi bi-grip-vertical text-muted fs-5"></i>
                                <input type="text" name="Sections[@sIdx].SectionName" value="@sec.SectionName" class="form-control form-control-sm fw-bold border-0 bg-transparent py-0 text-dark section-name-input" 
                                       placeholder="Section Name" required style="font-size: 1rem; border-bottom: 2px solid transparent !important;" />
                            </div>
                            <div class="d-flex gap-2">
                                <button type="button" class="btn btn-link btn-sm text-danger p-0 btn-remove-section" title="Delete Section">
                                    <i class="bi bi-trash-fill fs-5"></i>
                                </button>
                            </div>
                        </div>
                        <div class="card-body pt-2 px-3 pb-3">
                            <div class="fields-container drop-zone">
                                @for (int fIdx = 0; fIdx < sec.Fields.Count; fIdx++)
                                {
                                    var field = sec.Fields[fIdx];
                                    
                                    @if (field.FieldType == "Investigation" || field.FieldType == "Medication")
                                    {
                                        var fColor = field.FieldType == "Investigation" ? "success" : "warning";
                                        var fIcon = field.FieldType == "Investigation" ? "bi-eyedropper" : "bi-capsule";
                                        var placeholder = field.FieldType == "Investigation" ? "Search investigations..." : "Search medications...";
                                        var isMedField = (field.FieldType == "Medication");
                                        string[] freqOptsArr = ["Daily", "Weekly", "Monthly", "Yearly", "Alternate Day"];
                                        string[] procOptsArr = ["Before Food", "After Food", "After Breakfast", "Before Breakfast", "After Lunch", "After Dinner", "Before Dinner"];
                                        string medItems = "";
                                        string medOptionsJson = field.OptionsString ?? "";
                                        if (isMedField && !string.IsNullOrWhiteSpace(field.OptionsString))
                                        {
                                            try {
                                                var jo = System.Text.Json.JsonDocument.Parse(field.OptionsString).RootElement;
                                                if (jo.TryGetProperty("freqOptions", out var fq) && fq.ValueKind == System.Text.Json.JsonValueKind.Array)
                                                    freqOptsArr = fq.EnumerateArray().Select(x => x.GetString() ?? "").Where(x => x != "").ToArray();
                                                if (jo.TryGetProperty("procOptions", out var pq) && pq.ValueKind == System.Text.Json.JsonValueKind.Array)
                                                    procOptsArr = pq.EnumerateArray().Select(x => x.GetString() ?? "").Where(x => x != "").ToArray();
                                                if (jo.TryGetProperty("items", out var it))
                                                    medItems = it.GetString() ?? "";
                                            } catch { medItems = field.OptionsString; }
                                        } else if (!isMedField) { medItems = field.OptionsString ?? ""; }

                                        var freqOptsCsv = string.Join(", ", freqOptsArr);
                                        var procOptsCsv = string.Join(", ", procOptsArr);
<div class="field-row p-2 mb-2 border rounded-2 bg-white" data-field-index="@fIdx" data-field-type="@field.FieldType" draggable="true">
    <input type="hidden" name="Sections[@sIdx].Fields[@fIdx].FieldId" value="@field.FieldId" class="field-id-input" />
    <input type="hidden" name="Sections[@sIdx].Fields[@fIdx].FieldType" value="@field.FieldType" class="field-type-hidden-val" />
    <input type="hidden" name="Sections[@sIdx].Fields[@fIdx].OptionsString" value="@field.OptionsString" class="field-options-input" />
    @if (isMedField) {
        <input type="hidden" class="med-freq-options-store" value="@freqOptsCsv" />
        <input type="hidden" class="med-proc-options-store" value="@procOptsCsv" />
    }

    <div class="d-flex align-items-center justify-content-between mb-2">
        <div class="d-flex align-items-center gap-2">
            <i class="bi bi-grip-vertical text-muted fs-5" style="cursor: grab;"></i>
            <span class="badge bg-@fColor-subtle text-@fColor-emphasis border border-@fColor-subtle field-type-badge">
                <i class="@fIcon me-1"></i>@field.FieldType
            </span>
            <input type="text" name="Sections[@sIdx].Fields[@fIdx].FieldName" value="@field.FieldName" class="form-control form-control-sm field-name-input" placeholder="Section label" style="max-width: 220px;" required />
        </div>
        <div class="col-md-2 col-auto d-flex align-items-center ms-auto">
            <div class="form-check form-switch mb-0">
                <input name="Sections[@sIdx].Fields[@fIdx].IsRequired" value="true" class="form-check-input field-required-checkbox" type="checkbox" role="switch" checked="@(field.IsRequired ? "checked" : null)" />
                <input type="hidden" name="Sections[@sIdx].Fields[@fIdx].IsRequired" value="false" />
                <label class="form-check-label text-secondary small">Required</label>
            </div>
        </div>
        <button type="button" class="btn btn-sm btn-link text-danger p-1 btn-remove-field" title="Remove Field">
            <i class="bi bi-x-circle-fill fs-5"></i>
        </button>
    </div>

    @if (isMedField) {
    <!-- Medication Options Config Panel -->
    <div class="med-options-config bg-light border rounded p-2 mb-2" style="font-size:0.82rem;">
        <div class="fw-semibold text-secondary mb-1"><i class="bi bi-sliders me-1"></i>Dropdown Options (editable)</div>
        <div class="row g-2">
            <div class="col-md-6">
                <label class="form-label mb-1 small fw-semibold text-warning-emphasis"><i class="bi bi-clock me-1"></i>Frequency Options</label>
                <div class="tag-editor-wrap" data-target="med-freq-options-store">
                    <div class="tag-display d-flex flex-wrap gap-1 mb-1">
                        @foreach (var fo in freqOptsArr) {
                            <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle d-inline-flex align-items-center gap-1 tag-chip">
                                @fo <button type="button" class="btn-close btn-close" style="font-size:0.45rem;" data-tag="@fo"></button>
                            </span>
                        }
                    </div>
                    <div class="input-group input-group-sm">
                        <input type="text" class="form-control form-control-sm tag-input" placeholder="Add option... press Enter" />
                        <button class="btn btn-outline-warning btn-sm tag-add-btn" type="button">Add</button>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <label class="form-label mb-1 small fw-semibold text-primary-emphasis"><i class="bi bi-clock-history me-1"></i>Procedure Options</label>
                <div class="tag-editor-wrap" data-target="med-proc-options-store">
                    <div class="tag-display d-flex flex-wrap gap-1 mb-1">
                        @foreach (var po in procOptsArr) {
                            <span class="badge bg-primary-subtle text-primary-emphasis border border-primary-subtle d-inline-flex align-items-center gap-1 tag-chip">
                                @po <button type="button" class="btn-close" style="font-size:0.45rem;" data-tag="@po"></button>
                            </span>
                        }
                    </div>
                    <div class="input-group input-group-sm">
                        <input type="text" class="form-control form-control-sm tag-input" placeholder="Add option... press Enter" />
                        <button class="btn btn-outline-primary btn-sm tag-add-btn" type="button">Add</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- Medication column headers -->
    <div class="d-flex align-items-center gap-2 mb-1 px-1">
        <small class="text-muted fw-semibold" style="min-width:150px;">Medicine</small>
        <small class="text-muted fw-semibold" style="min-width:100px;">Dose</small>
        <small class="text-muted fw-semibold" style="min-width:130px;">Frequency</small>
        <small class="text-muted fw-semibold" style="min-width:155px;">Procedure</small>
    </div>
    }

    <div class="selected-items-container d-flex @(isMedField ? "flex-column" : "flex-wrap") gap-1 mb-2 p-1 border rounded bg-light" style="min-height: 32px;">
        @if (!string.IsNullOrWhiteSpace(medItems))
        {
            var items = medItems.Split(',', StringSplitOptions.RemoveEmptyEntries);
            foreach (var item in items)
            {
                var parts = item.Split('|');
                var itemId   = parts[0];
                var itemText = parts.Length > 1 ? parts[1] : parts[0];
                var itemDose = parts.Length > 2 ? parts[2] : "";
                var itemFreq = parts.Length > 3 ? parts[3] : "";
                var itemProc = parts.Length > 4 ? parts[4] : "";
                if (isMedField)
                {
                    <div class="selected-item-tag d-flex align-items-center gap-2 flex-wrap p-1 bg-white border rounded mb-1" data-item-id="@itemId" data-item-text="@itemText">
                        <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle">
                            <i class="bi bi-capsule me-1"></i>@itemText
                        </span>
                        <input type="text" class="form-control form-control-sm item-dose-input" placeholder="Dose" value="@itemDose" style="max-width:100px;" />
                        <select class="form-select form-select-sm item-freq-select" style="max-width:130px;">
                            <option value="">-- Frequency --</option>
                            @foreach (var fo in freqOptsArr) {
                                <option value="@fo" selected="@(fo == itemFreq ? "selected" : null)">@fo</option>
                            }
                        </select>
                        <select class="form-select form-select-sm item-proc-select" style="max-width:155px;">
                            <option value="">-- Procedure --</option>
                            @foreach (var po in procOptsArr) {
                                <option value="@po" selected="@(po == itemProc ? "selected" : null)">@po</option>
                            }
                        </select>
                        <button type="button" class="btn btn-sm btn-link text-danger p-0 ms-auto item-remove-btn" style="line-height:1;"><i class="bi bi-x-circle-fill"></i></button>
                    </div>
                }
                else
                {
                    <span class="badge bg-light text-dark border me-1 mb-1 d-inline-flex align-items-center gap-1 selected-item-tag" data-item-id="@itemId" data-item-text="@itemText">
                        @itemText
                        <button type="button" class="btn-close btn-close-dark" style="font-size:0.5rem;"></button>
                    </span>
                }
            }
        }
    </div>
    <div class="position-relative">
        <input type="text" class="form-control form-control-sm autosuggest-input" placeholder="@placeholder" autocomplete="off" />
        <div class="autosuggest-dropdown dropdown-menu w-100 p-0 border shadow-sm" style="display:none; max-height:200px; overflow-y:auto; position:absolute; z-index:1050;"></div>
    </div>
</div>
                                    }
                                    else if (field.FieldType == "ImageUpload" || field.FieldType == "Paint" || field.FieldType == "FileUpload" || field.FieldType == "RichText")
                                    {
                                        var mediaColor = field.FieldType == "ImageUpload" ? "info" : field.FieldType == "Paint" ? "danger" : field.FieldType == "FileUpload" ? "secondary" : "primary";
                                        var mediaIcon  = field.FieldType == "ImageUpload" ? "bi-image" : field.FieldType == "Paint" ? "bi-brush" : field.FieldType == "FileUpload" ? "bi-paperclip" : "bi-type-h1";
                                        var mediaLabel = field.FieldType == "ImageUpload" ? "Image Area" : field.FieldType == "Paint" ? "Paint / Annotate" : field.FieldType == "FileUpload" ? "File Attachment" : "Rich Text";
                                        <div class="field-row p-2 mb-2 border rounded-2 bg-white" data-field-index="@fIdx" data-field-type="@field.FieldType" draggable="true">
                                            <input type="hidden" name="Sections[@sIdx].Fields[@fIdx].FieldId" value="@field.FieldId" class="field-id-input" />
                                            <input type="hidden" name="Sections[@sIdx].Fields[@fIdx].FieldType" value="@field.FieldType" class="field-type-hidden-val" />
                                            <input type="hidden" name="Sections[@sIdx].Fields[@fIdx].OptionsString" value="@field.OptionsString" class="field-options-input" />
                                            <div class="d-flex align-items-center justify-content-between mb-2">
                                                <div class="d-flex align-items-center gap-2">
                                                    <i class="bi bi-grip-vertical text-muted fs-5" style="cursor:grab;"></i>
                                                    <span class="badge bg-@(mediaColor)-subtle text-@(mediaColor)-emphasis border border-@(mediaColor)-subtle field-type-badge">
                                                        <i class="@mediaIcon me-1"></i>@mediaLabel
                                                    </span>
                                                    <input type="text" name="Sections[@sIdx].Fields[@fIdx].FieldName" value="@field.FieldName" class="form-control form-control-sm field-name-input" placeholder="Field label" style="max-width: 220px;" required />
                                                </div>
                                                <div class="d-flex align-items-center gap-2">
                                                    <div class="form-check form-switch mb-0">
                                                        <input name="Sections[@sIdx].Fields[@fIdx].IsRequired" value="true" class="form-check-input field-required-checkbox" type="checkbox" role="switch" checked="@(field.IsRequired ? "checked" : null)" />
                                                        <input type="hidden" name="Sections[@sIdx].Fields[@fIdx].IsRequired" value="false" />
                                                        <label class="form-check-label text-secondary small">Required</label>
                                                    </div>
                                                    <button type="button" class="btn btn-sm btn-link text-danger p-1 btn-remove-field" title="Remove Field">
                                                        <i class="bi bi-x-circle-fill fs-5"></i>
                                                    </button>
                                                </div>
                                            </div>
                                            <div class="field-media-content">
                                                @if (field.FieldType == "ImageUpload")
                                                {
                                                    <div class="image-upload-area border border-2 border-dashed rounded-2 d-flex flex-column align-items-center justify-content-center p-3 text-muted bg-light-subtle" style="min-height: 100px;">
                                                        <i class="bi bi-cloud-upload fs-3 mb-1 text-info"></i>
                                                        <div class="small fw-semibold">Click to upload or drag image here</div>
                                                        <div style="font-size: 0.7rem;">PNG, JPG, GIF accepted</div>
                                                        @if (!string.IsNullOrWhiteSpace(field.OptionsString) && field.OptionsString.StartsWith("data:image"))
                                                        {
                                                            <img class="image-preview mt-2 rounded" src="@field.OptionsString" style="max-height: 150px; max-width: 100%;" />
                                                        }
                                                        else
                                                        {
                                                            <img class="image-preview mt-2 d-none rounded" style="max-height: 150px; max-width: 100%;" />
                                                        }
                                                        <input type="file" class="image-file-input d-none" accept="image/*" />
                                                    </div>
                                                }
                                                else if (field.FieldType == "Paint")
                                                {
                                                    <div class="paint-control-wrapper">
                                                        <div class="paint-toolbar p-2 bg-light rounded-top border border-bottom-0">
                                                            <div class="d-flex gap-1 align-items-center flex-wrap">
                                                                <div class="btn-group btn-group-sm" role="group">
                                                                    <button type="button" class="btn btn-sm btn-outline-secondary paint-tool-btn active" data-tool="pen" title="Pen (freehand)"><i class="bi bi-pencil-fill"></i></button>
                                                                    <button type="button" class="btn btn-sm btn-outline-secondary paint-tool-btn" data-tool="highlighter" title="Highlighter"><i class="bi bi-highlighter"></i></button>
                                                                    <button type="button" class="btn btn-sm btn-outline-secondary paint-tool-btn" data-tool="line" title="Straight line"><i class="bi bi-slash-lg"></i></button>
                                                                    <button type="button" class="btn btn-sm btn-outline-secondary paint-tool-btn" data-tool="arrow" title="Arrow"><i class="bi bi-arrow-right"></i></button>
                                                                    <button type="button" class="btn btn-sm btn-outline-secondary paint-tool-btn" data-tool="rect" title="Rectangle (outline)"><i class="bi bi-square"></i></button>
                                                                    <button type="button" class="btn btn-sm btn-outline-secondary paint-tool-btn" data-tool="filled-rect" title="Filled rectangle"><i class="bi bi-square-fill"></i></button>
                                                                    <button type="button" class="btn btn-sm btn-outline-secondary paint-tool-btn" data-tool="circle" title="Ellipse (outline)"><i class="bi bi-circle"></i></button>
                                                                    <button type="button" class="btn btn-sm btn-outline-secondary paint-tool-btn" data-tool="filled-circle" title="Filled ellipse"><i class="bi bi-circle-fill"></i></button>
                                                                    <button type="button" class="btn btn-sm btn-outline-secondary paint-tool-btn" data-tool="text" title="Text"><i class="bi bi-type"></i></button>
                                                                    <button type="button" class="btn btn-sm btn-outline-secondary paint-tool-btn" data-tool="eraser" title="Eraser"><i class="bi bi-eraser-fill"></i></button>
                                                                </div>
                                                                <input type="color" class="paint-color form-control form-control-color p-0" value="#000000" title="Colour" style="width:28px; height:28px; border:none;" />
                                                                <select class="paint-size form-select form-select-sm" style="width:auto;" title="Stroke width">
                                                                    <option value="1">1 px</option>
                                                                    <option value="2">2 px</option>
                                                                    <option value="4" selected>4 px</option>
                                                                    <option value="8">8 px</option>
                                                                    <option value="14">14 px</option>
                                                                    <option value="24">24 px</option>
                                                                </select>
                                                                <button type="button" class="btn btn-sm btn-outline-secondary paint-undo-btn" title="Undo"><i class="bi bi-arrow-counterclockwise"></i></button>
                                                                <button type="button" class="btn btn-sm btn-outline-secondary paint-redo-btn" title="Redo"><i class="bi bi-arrow-clockwise"></i></button>
                                                                <input type="file" class="paint-bg-input d-none" accept="image/*" />
                                                                <button type="button" class="btn btn-sm btn-outline-info paint-bg-btn" title="Upload background image"><i class="bi bi-image me-1"></i>BG</button>
                                                                <button type="button" class="btn btn-sm btn-outline-danger paint-clear-btn ms-auto" title="Clear canvas"><i class="bi bi-trash"></i></button>
                                                            </div>
                                                        </div>
                                                        <div class="position-relative">
                                                            <canvas class="paint-canvas border rounded-bottom w-100" height="260" style="cursor: crosshair; background: #fff;" data-saved="@field.OptionsString"></canvas>
                                                            <input type="text" class="paint-text-input form-control form-control-sm d-none" placeholder="Type text, press Enter to place..." style="position: absolute; top: 8px; left: 8px; max-width: 280px; z-index: 10;" />
                                                        </div>
                                                    </div>
                                                }
                                                else if (field.FieldType == "FileUpload")
                                                {
                                                    <div class="file-upload-area border border-2 border-dashed rounded-2 d-flex align-items-center justify-content-between p-3 bg-light-subtle" style="cursor: pointer;">
                                                        <div class="d-flex align-items-center gap-3">
                                                            <i class="bi bi-folder2-open fs-4 text-secondary"></i>
                                                            <div>
                                                                <div class="small fw-semibold">Click to browse files</div>
                                                                <div class="text-muted" style="font-size: 0.7rem;">PDF, DOC, DOCX, XLS, JPG, PNG</div>
                                                            </div>
                                                        </div>
                                                        <input type="file" class="file-browser-input d-none" multiple />
                                                        <button type="button" class="btn btn-sm btn-outline-secondary file-browse-btn"><i class="bi bi-folder-open me-1"></i>Browse</button>
                                                    </div>
                                                    <div class="selected-files-list mt-1 small text-muted">
                                                        @if (!string.IsNullOrWhiteSpace(field.OptionsString))
                                                        {
                                                            @foreach (var fname in field.OptionsString.Split(',', System.StringSplitOptions.RemoveEmptyEntries))
                                                            {
                                                                <span class="badge bg-secondary-subtle border me-1"><i class="bi bi-file-earmark me-1"></i>@fname.Trim()</span>
                                                            }
                                                        }
                                                    </div>
                                                }
                                                else if (field.FieldType == "RichText")
                                                {
                                                    <div class="rich-text-wrapper border rounded-2 overflow-hidden">
                                                        <div class="rich-text-editor" style="min-height: 120px; background: #fff;" data-content="@field.OptionsString"></div>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        var showOptionsClass = (field.FieldType == "Select" || field.FieldType == "MultiSelect") ? "" : "d-none";
                                        var isOptionsRequired = (field.FieldType == "Select" || field.FieldType == "MultiSelect");

                                        <div class="row g-2 align-items-center field-row" data-field-index="@fIdx" data-field-type="@field.FieldType" draggable="true">
                                            <input type="hidden" name="Sections[@sIdx].Fields[@fIdx].FieldId" value="@field.FieldId" class="field-id-input" />
                                            <input type="hidden" name="Sections[@sIdx].Fields[@fIdx].FieldType" value="@field.FieldType" class="field-type-hidden-val" />
                                            <div class="col-md-1.5 col-auto d-flex align-items-center">
                                                <i class="bi bi-grip-vertical text-muted fs-5 me-1" style="cursor: grab;"></i>
                                                <span class="badge bg-secondary-subtle text-secondary border field-type-badge text-uppercase small">@field.FieldType</span>
                                            </div>
                                            <div class="col-md-4">
                                                <input type="text" name="Sections[@sIdx].Fields[@fIdx].FieldName" value="@field.FieldName" class="form-control form-control-sm field-name-input" placeholder="Field Label" required />
                                            </div>
                                            <div class="col-md-3">
                                                <input type="text" name="Sections[@sIdx].Fields[@fIdx].OptionsString" value="@field.OptionsString" class="form-control form-control-sm field-options-input @showOptionsClass" placeholder="Options (comma separated)" required="@(isOptionsRequired ? "required" : null)" />
                                            </div>
                                            <div class="col-md-2 col-auto d-flex align-items-center ms-auto">
                                                <div class="form-check form-switch mb-0">
                                                    <input name="Sections[@sIdx].Fields[@fIdx].IsRequired" value="true" class="form-check-input field-required-checkbox" type="checkbox" role="switch" checked="@(field.IsRequired ? "checked" : null)" />
                                                    <input type="hidden" name="Sections[@sIdx].Fields[@fIdx].IsRequired" value="false" />
                                                    <label class="form-check-label text-secondary small">Required</label>
                                                </div>
                                            </div>
                                            <div class="col-auto text-end">
                                                <button type="button" class="btn btn-sm btn-link text-danger p-1 btn-remove-field" title="Remove Field">
                                                    <i class="bi bi-x-circle-fill fs-5"></i>
                                                </button>
                                            </div>
                                        </div>
                                    }
                                }
                            </div>
                            <div class="text-center py-3 border border-dashed rounded-3 mt-1 bg-light text-muted small empty-fields-msg @(sec.Fields.Any() ? "d-none" : "")">
                                <i class="bi bi-plus-square d-block fs-4 mb-1 opacity-75"></i>
                                Drag field types here from the toolbox
                            </div>
                        </div>
                    </div>
                }
            </div>
            
            <div class="d-flex gap-2 mb-5">
                <button type="submit" class="btn btn-primary px-4"><i class="bi bi-save me-1"></i>Save Changes</button>
                <button type="button" class="btn btn-outline-primary px-4" id="btnPreviewTemplateBottom"><i class="bi bi-eye me-1"></i>Preview</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </div>

        @* Right Column: Sticky Toolbox *@
        <div class="col-lg-3">
            <div class="card toolbox-card shadow-sm border-0">
                <div class="card-header bg-white py-3 border-bottom">
                    <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-tools text-primary me-2"></i>Toolbox</h5>
                    <small class="text-muted d-block mt-1">Drag fields to sections, or click to add them directly</small>
                </div>
                <div class="card-body">
                    <button type="button" class="btn btn-primary w-100 mb-4" id="btnAddSection">
                        <i class="bi bi-plus-circle me-1"></i>Add Section
                    </button>

                    <div class="text-uppercase fw-bold text-secondary small mb-2">Available Field Types</div>
                    
                    <div class="tool-item" draggable="true" data-type="Text" title="Single line text input">
                        <i class="bi bi-input-cursor-text"></i>
                        <span class="fw-semibold">Text Input</span>
                    </div>

                    <div class="tool-item" draggable="true" data-type="TextArea" title="Multi-line scrollable text field">
                        <i class="bi bi-textarea-t"></i>
                        <span class="fw-semibold">Multi-line Text</span>
                    </div>

                    <div class="tool-item" draggable="true" data-type="Select" title="Single-select dropdown choice menu">
                        <i class="bi bi-list-ul"></i>
                        <span class="fw-semibold">Dropdown Select</span>
                    </div>

                    <div class="tool-item" draggable="true" data-type="MultiSelect" title="Multi-select checkbox options menu">
                        <i class="bi bi-ui-checks-grid"></i>
                        <span class="fw-semibold">Multi-select Dropdown</span>
                    </div>

                    <div class="tool-item" draggable="true" data-type="Number" title="Numeric format input">
                        <i class="bi bi-hash"></i>
                        <span class="fw-semibold">Number Input</span>
                    </div>

                    <div class="tool-item" draggable="true" data-type="Checkbox" title="Binary true/false switch choice checkbox">
                        <i class="bi bi-toggle-on"></i>
                        <span class="fw-semibold">Checkbox / Switch</span>
                    </div>

                    <div class="tool-item" draggable="true" data-type="Date" title="Standard calendar date picker selection">
                        <i class="bi bi-calendar-date"></i>
                        <span class="fw-semibold">Date Picker</span>
                    </div>

                    <div class="text-uppercase fw-bold text-secondary small mb-2 mt-3 border-top pt-3">Clinical Lists</div>

                    <div class="tool-item border-success-subtle bg-success-subtle" draggable="true" data-type="Investigation" title="Auto-suggest investigation list backed by Investigation Master">
                        <i class="bi bi-eyedropper text-success"></i>
                        <div>
                            <div class="fw-semibold text-success-emphasis">Investigation List</div>
                            <div class="text-muted" style="font-size: 0.7rem;">Auto-suggest from DB</div>
                        </div>
                    </div>

                    <div class="tool-item border-warning-subtle bg-warning-subtle" draggable="true" data-type="Medication" title="Auto-suggest medication list backed by Medication Master">
                        <i class="bi bi-capsule text-warning-emphasis"></i>
                        <div>
                            <div class="fw-semibold text-warning-emphasis">Medication List</div>
                            <div class="text-muted" style="font-size: 0.7rem;">Auto-suggest from DB</div>
                        </div>
                    </div>

                    <div class="text-uppercase fw-bold text-secondary small mb-2 mt-3 border-top pt-3">Media &amp; Content</div>

                    <div class="tool-item border-info-subtle bg-info-subtle" draggable="true" data-type="ImageUpload" title="Image upload area for clinical photos and scans">
                        <i class="bi bi-image text-info"></i>
                        <div>
                            <div class="fw-semibold text-info-emphasis">Image Area</div>
                            <div class="text-muted" style="font-size: 0.7rem;">Upload &amp; display images</div>
                        </div>
                    </div>

                    <div class="tool-item border-danger-subtle bg-danger-subtle" draggable="true" data-type="Paint" title="Annotation canvas to mark on images and write text">
                        <i class="bi bi-brush text-danger"></i>
                        <div>
                            <div class="fw-semibold text-danger-emphasis">Paint / Annotate</div>
                            <div class="text-muted" style="font-size: 0.7rem;">Draw &amp; annotate</div>
                        </div>
                    </div>

                    <div class="tool-item" draggable="true" data-type="FileUpload" title="File attachment browser for documents">
                        <i class="bi bi-paperclip"></i>
                        <span class="fw-semibold">File Attachment</span>
                    </div>

                    <div class="tool-item border-primary-subtle bg-primary-subtle" draggable="true" data-type="RichText" title="Rich text editor with bold, italic, colour and formatting">
                        <i class="bi bi-type-h1 text-primary"></i>
                        <div>
                            <div class="fw-semibold text-primary-emphasis">Rich Text Editor</div>
                            <div class="text-muted" style="font-size: 0.7rem;">Bold, italic, colour</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>

@* ── Preview Modal ── *@
<div class="modal fade" id="previewModal" tabindex="-1" aria-labelledby="previewModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 14px;">
            <div class="modal-header bg-light border-bottom-0 py-3">
                <h5 class="modal-title fw-bold text-dark" id="previewModalLabel">
                    <i class="bi bi-eye-fill text-primary me-2"></i>EMR Template Preview
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body bg-light-subtle py-4 px-4" id="previewModalBody">
                <!-- Preview elements will render dynamically -->
            </div>
            <div class="modal-footer bg-light border-top-0 py-2">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close Preview</button>
            </div>
        </div>
    </div>
</div>

@* ── HTML TEMPLATE FOR SECTION ── *@
<div id="sectionTemplate" class="d-none">
    <div class="card border-0 shadow-sm mb-3 section-card" data-section-index="{sectionIndex}" onclick="selectSection(this)">
        <input type="hidden" class="section-id-input" />
        <div class="card-header bg-white py-2 px-3 border-bottom d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center gap-2 flex-grow-1 me-3">
                <i class="bi bi-grip-vertical text-muted fs-5"></i>
                <input type="text" class="form-control form-control-sm fw-bold border-0 bg-transparent py-0 text-dark section-name-input" 
                       placeholder="Section Name (e.g. History Taking)" style="font-size: 1rem; border-bottom: 2px solid transparent !important;" />
            </div>
            <div class="d-flex gap-2">
                <button type="button" class="btn btn-link btn-sm text-danger p-0 btn-remove-section" title="Delete Section">
                    <i class="bi bi-trash-fill fs-5"></i>
                </button>
            </div>
        </div>
        <div class="card-body pt-2 px-3 pb-3">
            <div class="fields-container drop-zone">
                @* Fields will go here *@
            </div>
            <div class="text-center py-3 border border-dashed rounded-3 mt-1 bg-light text-muted small empty-fields-msg">
                <i class="bi bi-plus-square d-block fs-4 mb-1 opacity-75"></i>
                Drag field types here from the toolbox
            </div>
        </div>
    </div>
</div>

@* ── HTML TEMPLATE FOR FIELD ── *@
<div id="fieldTemplate" class="d-none">
    <div class="row g-2 align-items-center field-row" data-field-index="{fieldIndex}" draggable="true">
        <input type="hidden" class="field-id-input" />
        <div class="col-md-1.5 col-auto d-flex align-items-center">
            <i class="bi bi-grip-vertical text-muted fs-5 me-1" style="cursor: grab;"></i>
            <span class="badge bg-secondary-subtle text-secondary border field-type-badge text-uppercase small">Text</span>
        </div>
        <div class="col-md-4">
            <input type="text" class="form-control form-control-sm field-name-input" placeholder="Field Label (e.g. Heart Rate)" required />
        </div>
        <div class="col-md-3">
            <input type="text" class="form-control form-control-sm field-options-input d-none" placeholder="Options (comma separated)" />
        </div>
        <div class="col-md-2 col-auto d-flex align-items-center ms-auto">
            <div class="form-check form-switch mb-0">
                <input class="form-check-input field-required-checkbox" type="checkbox" role="switch" value="true" />
                <input type="hidden" class="field-required-hidden" value="false" />
                <label class="form-check-label text-secondary small">Required</label>
            </div>
        </div>
        <div class="col-auto text-end">
            <button type="button" class="btn btn-sm btn-link text-danger p-1 btn-remove-field" title="Remove Field">
                <i class="bi bi-x-circle-fill fs-5"></i>
            </button>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    <script src="~/lib/select2/dist/js/select2.min.js"></script>
    <script src="~/lib/quill/quill.min.js"></script>
    <script src="~/js/emr-templates-edit.js" asp-append-version="true"></script>
}
