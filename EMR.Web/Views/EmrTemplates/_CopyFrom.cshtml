@* Create EMR Template: start from an existing template - by speciality and, if wanted, the template a doctor uses (SQLScripts/2480) *@
@{ var copied = ViewData["CopiedFrom"] as string; }
<div class="card border-0 shadow-sm mb-4 et-copy" id="etCopy" data-url="@Url.Action("CopySources", "EmrTemplates")" data-create="@Url.Action("Create", "EmrTemplates")">
    <div class="card-header bg-white py-3 border-bottom-0 d-flex justify-content-between align-items-center flex-wrap gap-2">
        <div>
            <h5 class="fw-bold mb-0"><i class="bi bi-files me-2 text-primary"></i>Start from an existing template <span class="badge text-bg-light border fw-normal ms-1">optional</span></h5>
            <small class="text-muted">@(string.IsNullOrEmpty(copied) ? "Copy the sections and fields of a template, then change what you need." : $"Now editing a copy of “{copied}”. Pick another template to start again from it.")</small>
        </div>
        <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-toggle="collapse" data-bs-target="#etCopyBody" aria-expanded="@(string.IsNullOrEmpty(copied) ? "true" : "false")">
            <i class="bi bi-chevron-expand me-1"></i>@(string.IsNullOrEmpty(copied) ? "Hide" : "Copy another")</button>
    </div>
    <div class="collapse @(string.IsNullOrEmpty(copied) ? "show" : "")" id="etCopyBody">
        <div class="card-body pt-0">
            <div class="row g-3 align-items-end">
                <div class="col-md-5"><label class="form-label fw-semibold mb-1" for="cfSpec">Speciality</label>
                    <select id="cfSpec" class="form-select" data-placeholder="Choose a speciality..."><option value="">Choose a speciality...</option></select></div>
                <div class="col-md-5"><label class="form-label fw-semibold mb-1" for="cfDoc">Doctor <span class="badge text-bg-light border fw-normal ms-1">optional</span></label>
                    <div class="form-text mt-0 mb-1">Doctors who have their own template in this speciality.</div>
                    <select id="cfDoc" class="form-select" disabled><option value="">Any doctor - all templates of the speciality</option></select></div>
                <div class="col-md-2"><button type="button" class="btn btn-primary w-100" id="cfCopy" disabled><i class="bi bi-files me-1"></i>Copy</button></div>
            </div>
            <div class="et-copy-list mt-3" id="cfList"><div class="text-muted small">Choose a speciality to see its templates.</div></div>
        </div>
    </div>
</div>
