@model EMR.Web.Models.ViewModels.EmrTemplateViewModel
@* Create / Edit EMR Template: name, description, who uses the template (specialities + optional doctors, SQLScripts/2483) *@
<div class="card border-0 shadow-sm mb-4 et-info">
    <div class="card-header bg-white py-3 border-bottom-0 d-flex justify-content-between align-items-center flex-wrap gap-2">
        <h5 class="fw-bold mb-0 text-primary"><i class="bi bi-file-earmark-text me-2"></i>Template Information</h5>
        <div class="form-check form-switch mb-0">
            <input asp-for="IsActive" class="form-check-input" type="checkbox" role="switch" />
            <label asp-for="IsActive" class="form-check-label fw-semibold">Active</label>
        </div>
    </div>
    <div class="card-body pt-1">
        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="TemplateName" class="form-label fw-semibold">Template Name <span class="text-danger">*</span></label>
                <input asp-for="TemplateName" class="form-control" placeholder="e.g. Paediatric EMR Template" maxlength="150" />
                <span asp-validation-for="TemplateName" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Description" class="form-label fw-semibold">Description</label>
                <textarea asp-for="Description" class="form-control" rows="1" placeholder="Briefly describe the clinical use case of this template..." maxlength="500"></textarea>
                <span asp-validation-for="Description" class="text-danger small"></span>
            </div>
        </div>

        <div class="et-applies mt-3">
            <div class="et-applies-head"><i class="bi bi-people me-2"></i>Who uses this template</div>
            <div class="row g-3">
                <div class="col-md-6">
                    <label for="SelectedSpecialityIds" class="form-label fw-semibold mb-1">1. Speciality <span class="text-danger">*</span></label>
                    @{ var specSel = Model.SelectedSpecialityIds.FirstOrDefault(); }
                    <select id="SelectedSpecialityIds" name="SelectedSpecialityIds" class="form-select et-speciality" data-placeholder="Choose the speciality...">
                        <option value="">Choose the speciality...</option>
                        @foreach (var o in Model.SpecialityOptions)
                        {
                            <option value="@o.Value" selected="@(o.Value == specSel.ToString())">@o.Text</option>
                        }
                    </select>
                    <div class="form-text">A template belongs to one speciality.</div>
                    <span asp-validation-for="SelectedSpecialityIds" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="SelectedDoctorIds" class="form-label fw-semibold mb-1">2. Doctors <span class="badge text-bg-light border fw-normal ms-1">optional</span></label>
                    <select asp-for="SelectedDoctorIds" class="form-select et-doctors" multiple data-placeholder="All doctors of the speciality (leave empty)"
                            data-url="@Url.Action("Doctors", "EmrTemplates")" data-template-id="@Model.TemplateId">
                        @foreach (var d in Model.DoctorOptions)
                        {
                            <option value="@d.DoctorId" selected="@(Model.SelectedDoctorIds.Contains(d.DoctorId))" data-spec="@d.SpecialityName" data-other="@d.OtherTemplate">@d.Name</option>
                        }
                    </select>
                    <span asp-validation-for="SelectedDoctorIds" class="text-danger small"></span>
                    <div class="form-text">Only doctors of the chosen speciality are listed.</div>
                </div>
            </div>
            <div class="et-summary mt-3" id="etSummary" aria-live="polite"></div>
        </div>
    </div>
</div>
