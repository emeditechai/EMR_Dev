@model EMR.Web.Models.ViewModels.FloorFormViewModel
@{
    ViewData["Title"] = "Edit Floor";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-0 fw-bold">Edit Floor</h1>
        <small class="text-muted">Update floor details and parent building mapping</small>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i>Back to List
    </a>
</div>

<div class="dashboard-panel" style="max-width:640px;">
    <form asp-action="Edit" method="post">
        @Html.AntiForgeryToken()
        <input asp-for="FloorId" type="hidden" />

        <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3"></div>

        <div class="mb-3">
            <label asp-for="BuildingId" class="form-label fw-semibold">
                Parent Building <span class="text-danger">*</span>
            </label>
            <div class="input-group">
                <span class="input-group-text bg-light"><i class="bi bi-building text-muted"></i></span>
                <select asp-for="BuildingId" asp-items="Model.BuildingOptions" class="form-select" required>
                    <option value="">-- Select Building --</option>
                </select>
            </div>
            <span asp-validation-for="BuildingId" class="text-danger small d-block mt-1"></span>
        </div>

        <div class="row g-3 mb-3">
            <div class="col-sm-5">
                <label asp-for="FloorCode" class="form-label fw-semibold">
                    Floor Code <span class="text-danger">*</span>
                </label>
                <div class="input-group">
                    <span class="input-group-text bg-light"><i class="bi bi-qr-code text-muted"></i></span>
                    <input asp-for="FloorCode" class="form-control text-uppercase"
                           maxlength="20" oninput="this.value=this.value.toUpperCase()" required />
                </div>
                <span asp-validation-for="FloorCode" class="text-danger small d-block mt-1"></span>
            </div>
            <div class="col-sm-7">
                <label asp-for="FloorName" class="form-label fw-semibold">
                    Floor Name <span class="text-danger">*</span>
                </label>
                <div class="input-group">
                    <span class="input-group-text bg-light"><i class="bi bi-layers text-muted"></i></span>
                    <input asp-for="FloorName" class="form-control" maxlength="100" required />
                </div>
                <span asp-validation-for="FloorName" class="text-danger small d-block mt-1"></span>
            </div>
        </div>

        <div class="mb-4">
            <div class="form-check form-switch p-2 border rounded bg-light">
                <input asp-for="IsActive" class="form-check-input ms-0 me-2" type="checkbox" role="switch" />
                <label asp-for="IsActive" class="form-check-label fw-semibold">Active Floor</label>
            </div>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary px-4 shadow-sm">
                <i class="bi bi-save me-1"></i>Update Floor
            </button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </form>
</div>

@section Scripts { 
    <partial name="_ValidationScriptsPartial" />
}
