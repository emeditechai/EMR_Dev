@model IEnumerable<EMR.Web.Models.Entities.FloorMaster>
@{
    ViewData["Title"] = "Floor Master";
    var total = Model.Count();
    var active = Model.Count(x => x.IsActive);
    var inactive = total - active;
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h1 class="h3 mb-0 fw-bold">Floor Master</h1>
        <small class="text-muted">Manage hospital floor definitions mapped to buildings</small>
    </div>
    <div class="d-flex gap-2">
        <a asp-controller="Buildings" asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-building me-1"></i>Building Master
        </a>
        <a asp-action="Create" asp-route-buildingId="@ViewBag.BuildingId" class="btn btn-primary shadow-sm">
            <i class="bi bi-plus-lg me-1"></i>Add Floor
        </a>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-12 col-sm-4">
        <div class="stat-card stat-blue">
            <div class="stat-icon"><i class="bi bi-layers-fill"></i></div>
            <div>
                <div class="stat-value">@total</div>
                <div class="stat-label">Total Floors</div>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-4">
        <div class="stat-card stat-green">
            <div class="stat-icon"><i class="bi bi-check-circle-fill"></i></div>
            <div>
                <div class="stat-value">@active</div>
                <div class="stat-label">Active Floors</div>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-4">
        <div class="stat-card stat-red">
            <div class="stat-icon"><i class="bi bi-x-circle-fill"></i></div>
            <div>
                <div class="stat-value">@inactive</div>
                <div class="stat-label">Inactive</div>
            </div>
        </div>
    </div>
</div>

<div class="dashboard-panel table-responsive shadow-sm border rounded-3 bg-white">
    <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
            <tr>
                <th style="width: 50px;">#</th>
                <th>Floor Code</th>
                <th>Floor Name</th>
                <th>Parent Building</th>
                <th>Status</th>
                <th>Created</th>
                <th class="text-end" style="width: 130px;">Actions</th>
            </tr>
        </thead>
        <tbody>
            @{int i = 1;}
            @foreach (var item in Model)
            {
                <tr>
                    <td class="text-muted small">@(i++)</td>
                    <td>
                        <span class="badge text-bg-light border text-dark font-monospace fs-6">@item.FloorCode</span>
                    </td>
                    <td class="fw-semibold">
                        <i class="bi bi-layers text-primary me-2"></i>@item.FloorName
                    </td>
                    <td>
                        @if (!string.IsNullOrWhiteSpace(item.BuildingName))
                        {
                            <a asp-controller="Buildings" asp-action="Details" asp-route-id="@item.BuildingId" class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 text-decoration-none px-2 py-1">
                                <i class="bi bi-building me-1"></i>@item.BuildingName (@item.BuildingCode)
                            </a>
                        }
                        else
                        {
                            <span class="text-muted small">—</span>
                        }
                    </td>
                    <td>
                        @if (item.IsActive)
                        {
                            <span class="badge text-bg-success">Active</span>
                        }
                        else
                        {
                            <span class="badge text-bg-secondary">Inactive</span>
                        }
                    </td>
                    <td class="text-muted small">@item.CreatedDate.ToString("dd MMM yyyy")</td>
                    <td class="text-end">
                        <a asp-action="Details" asp-route-id="@item.FloorId"
                           class="btn btn-sm btn-outline-secondary me-1" title="View Details">
                            <i class="bi bi-eye"></i>
                        </a>
                        <a asp-action="Edit" asp-route-id="@item.FloorId"
                           class="btn btn-sm btn-outline-primary" title="Edit">
                            <i class="bi bi-pencil"></i>
                        </a>
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="7" class="text-center text-muted py-5">
                        <i class="bi bi-layers fs-1 d-block mb-2 opacity-50"></i>
                        No floors found. <a asp-action="Create">Add one now.</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
