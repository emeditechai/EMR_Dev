@* Utility > Franchise Dashboard (SQLScripts/2251). A franchise login sees its own franchise only; lab staff may pick one. *@
@{
    ViewData["Title"] = "Franchise Dashboard";
    var franchises = ViewBag.Franchises as List<EMR.Web.Controllers.FranchiseDashboardController.FranchiseOption> ?? new();
    bool locked = ViewBag.Locked as bool? ?? false;
    int franchiseId = ViewBag.FranchiseId as int? ?? 0;
}
<style>
    .fd-wrap { --fd-line:#e2e8f0; --fd-muted:#64748b; --fd-ink:#0f172a; --fd-accent:#6d28d9; }
    .fd-wrap .fs-8 { font-size:.78rem !important; } .fd-wrap .fs-9 { font-size:.7rem !important; }
    .fd-card { background:#fff;border:1px solid var(--fd-line);border-radius:.75rem; }
    .fd-kpi { padding:.85rem 1rem;border-left:4px solid var(--k, var(--fd-accent));height:100%; }
    .fd-kpi .k-label { font-size:.66rem;font-weight:700;letter-spacing:.5px;text-transform:uppercase;color:var(--fd-muted); }
    .fd-kpi .k-val { font-size:1.35rem;font-weight:800;color:var(--fd-ink);line-height:1.2;font-variant-numeric:tabular-nums; }
    .fd-kpi .k-sub { font-size:.7rem;color:var(--fd-muted); }
    .fd-dl dt { font-size:.66rem;font-weight:700;letter-spacing:.4px;text-transform:uppercase;color:var(--fd-muted); }
    .fd-dl dd { font-size:.85rem;font-weight:600;color:var(--fd-ink);margin-bottom:.55rem; }
    .fd-table thead th { position:sticky;top:0;background:#f8fafc;color:var(--fd-muted);font-size:.66rem;font-weight:700;letter-spacing:.4px;
                         text-transform:uppercase;white-space:nowrap;border-bottom:1px solid var(--fd-line); }
    .fd-table tbody td { font-size:.78rem;vertical-align:middle;border-color:#eef2f6; }
    .fd-table tfoot td { font-size:.8rem;font-weight:800;background:#f8fafc; }
    .fd-wrap .amt { font-variant-numeric:tabular-nums;white-space:nowrap; }
    .fd-scroll { max-height:55vh;overflow:auto; }
    .fd-wrap .btn-quick.active { background:var(--fd-accent);border-color:var(--fd-accent);color:#fff; }
    @@media print { .emr-topbar, footer, .no-print { display:none !important; } .fd-scroll { max-height:none;overflow:visible; } }
</style>

<div class="container-fluid px-3 py-2 fd-wrap">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
        <div>
            <h1 class="h4 fw-bold mb-0"><i class="bi bi-shop-window me-2" style="color:var(--fd-accent)"></i>Franchise Dashboard</h1>
            <div class="text-muted fs-8">Utility &rsaquo; Franchise Dashboard &middot; <span id="fdName">&mdash;</span> &middot; <span id="fdRange"></span></div>
        </div>
        <div class="d-flex gap-2 no-print">
            <a class="btn btn-sm text-white" style="background:var(--fd-accent)" asp-controller="LabOrderBooking" asp-action="B2BBooking" asp-permission="LAB.LABORDERBOOKING.B2BBOOKING"><i class="bi bi-plus-circle me-1"></i>New B2B Bill</a>
            <button type="button" class="btn btn-sm btn-outline-success" id="fdExcel" disabled><i class="bi bi-file-earmark-excel me-1"></i>Excel</button>
            <button type="button" class="btn btn-sm btn-outline-secondary" id="fdPrint" disabled><i class="bi bi-printer me-1"></i>Print</button>
        </div>
    </div>

    <div class="fd-card p-2 px-3 mb-2 no-print">
        <div class="row g-2 align-items-end">
            <div class="col-12 col-md-3"><label class="form-label fs-9 fw-bold text-muted text-uppercase mb-0" for="fdFranchise">Franchise</label>
                <select id="fdFranchise" class="form-select form-select-sm" disabled="@(locked ? "disabled" : null)">
                    @if (!locked) { <option value="">-- Select franchise --</option> }
                    @foreach (var f in franchises)
                    {
                        <option value="@f.Id" selected="@(f.Id == franchiseId)">@f.Name</option>
                    }
                </select></div>
            <div class="col-6 col-md-2"><label class="form-label fs-9 fw-bold text-muted text-uppercase mb-0" for="fdFrom">From</label>
                <input type="date" id="fdFrom" class="form-control form-control-sm" autocomplete="off" /></div>
            <div class="col-6 col-md-2"><label class="form-label fs-9 fw-bold text-muted text-uppercase mb-0" for="fdTo">To</label>
                <input type="date" id="fdTo" class="form-control form-control-sm" autocomplete="off" /></div>
            <div class="col-12 col-md"><label class="form-label fs-9 fw-bold text-muted text-uppercase mb-0">Quick select</label>
                <div class="btn-group btn-group-sm w-100" role="group">
                    <button type="button" class="btn btn-outline-secondary btn-quick" data-range="today">Today</button>
                    <button type="button" class="btn btn-outline-secondary btn-quick" data-range="week">7 Days</button>
                    <button type="button" class="btn btn-outline-secondary btn-quick" data-range="month">This Month</button>
                    <button type="button" class="btn btn-outline-secondary btn-quick" data-range="lastmonth">Last Month</button>
                    <button type="button" class="btn btn-outline-secondary btn-quick" data-range="year">1 Year</button>
                </div></div>
        </div>
    </div>

    <div id="fdError" class="alert alert-danger fs-8 d-none"></div>
    <div id="fdPick" class="fd-card text-center text-muted py-5 d-none"><i class="bi bi-shop fs-1 d-block mb-2 opacity-50"></i>Choose a franchise to see its dashboard.</div>

    <div id="fdBody" class="d-none">
        @* widgets *@
        <div class="row g-2 mb-2">
            <div class="col-6 col-lg"><div class="fd-card fd-kpi" style="--k:#6d28d9"><div class="k-label">Sales</div><div class="k-val amt" id="kSales">&mdash;</div><div class="k-sub" id="kSalesSub"></div></div></div>
            <div class="col-6 col-lg"><div class="fd-card fd-kpi" style="--k:#15803d"><div class="k-label">Total realization</div><div class="k-val amt" id="kRealized">&mdash;</div><div class="k-sub">received in the period</div></div></div>
            <div class="col-6 col-lg"><div class="fd-card fd-kpi" style="--k:#b91c1c"><div class="k-label">Pending receivable</div><div class="k-val amt" id="kPending">&mdash;</div><div class="k-sub" id="kPendingSub"></div></div></div>
            <div class="col-6 col-lg"><div class="fd-card fd-kpi" style="--k:#0891b2"><div class="k-label">Wallet balance</div><div class="k-val amt" id="kWallet">&mdash;</div><div class="k-sub" id="kWalletSub"></div></div></div>
            <div class="col-6 col-lg"><div class="fd-card fd-kpi" style="--k:#d97706"><div class="k-label">Credit available</div><div class="k-val amt" id="kCredit">&mdash;</div><div class="k-sub" id="kCreditSub"></div></div></div>
        </div>

        @* graphs and details *@
        <div class="row g-2 mb-2">
            <div class="col-12 col-xl-7"><div class="fd-card p-3 h-100 fd-graph">
                <div class="fw-bold fs-8 mb-2"><i class="bi bi-bar-chart-line me-1" style="color:var(--fd-accent)"></i>Sales and realization by day</div>
                <div style="height:230px"><canvas id="fdTrend" role="img" aria-label="Sales and realization by day"></canvas></div>
                <div id="fdTrendEmpty" class="text-center text-muted fs-8 d-none">No sales or receipts in this period.</div>
            </div></div>
            <div class="col-12 col-xl-5"><div class="fd-card p-3 h-100 fd-graph">
                <div class="fw-bold fs-8 mb-2"><i class="bi bi-card-list me-1" style="color:var(--fd-accent)"></i>Franchise details <span id="fdStatus"></span></div>
                <dl class="row fd-dl mb-0">
                    <div class="col-6"><dt>Code</dt><dd id="dCode">&mdash;</dd></div>
                    <div class="col-6"><dt>Type</dt><dd id="dType">&mdash;</dd></div>
                    <div class="col-6"><dt>Parent branch</dt><dd id="dBranch">&mdash;</dd></div>
                    <div class="col-6"><dt>Contact</dt><dd id="dContact">&mdash;</dd></div>
                    <div class="col-6"><dt>Go-live</dt><dd id="dGoLive">&mdash;</dd></div>
                    <div class="col-6"><dt>Agreement</dt><dd id="dAgreement">&mdash;</dd></div>
                    <div class="col-6"><dt>Credit facility</dt><dd id="dFacility">&mdash;</dd></div>
                    <div class="col-6"><dt>Credit limit</dt><dd id="dLimit">&mdash;</dd></div>
                    <div class="col-6"><dt>Credit days</dt><dd id="dDays">&mdash;</dd></div>
                    <div class="col-6"><dt>Security deposit</dt><dd id="dDeposit">&mdash;</dd></div>
                </dl>
            </div></div>
        </div>

        @* lists *@
        <div class="fd-card fd-lists">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 px-3 py-2 border-bottom">
                <ul class="nav nav-pills nav-sm gap-1 no-print" id="fdTabs" role="tablist">
                    <li class="nav-item"><button class="nav-link active py-1 px-3 fs-8" data-tab="sales" type="button">Sale register</button></li>
                    <li class="nav-item"><button class="nav-link py-1 px-3 fs-8" data-tab="realization" type="button">Realization</button></li>
                    <li class="nav-item"><button class="nav-link py-1 px-3 fs-8" data-tab="pending" type="button">Pending receivable</button></li>
                </ul>
                <span class="fs-8 text-muted" id="fdCount"></span>
            </div>
            <div class="fd-scroll">
                <table class="table table-hover mb-0 fd-table" id="fdTable"><thead></thead><tbody></tbody><tfoot></tfoot></table>
            </div>
            <div id="fdEmpty" class="text-center text-muted py-5 d-none"><i class="bi bi-inbox fs-1 d-block mb-2 opacity-50"></i><span id="fdEmptyText">Nothing found.</span></div>
        </div>
    </div>
</div>

@section Scripts {
<script src="~/lib/chartjs/chart.umd.min.js" asp-append-version="true"></script>
<script src="~/js/emr-shimmer.js" asp-append-version="true"></script>
<script src="~/js/emr-export-libs.js" asp-append-version="true"></script>
<script>
(function () {
    const dataUrl = '@Url.Action("Data", "FranchiseDashboard")';
    const locked = @(locked ? "true" : "false");
    const esc = s => String(s ?? '').replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
    const money = n => '₹' + (Number(n) || 0).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    const num = n => (Number(n) || 0).toLocaleString('en-IN');
    const fmtD = s => { if (!s) return ''; const d = new Date(s); return isNaN(d) ? '' : d.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }); };
    const fmtDT = s => { if (!s) return ''; const d = new Date(s); return isNaN(d) ? '' : fmtD(s) + ', ' + d.toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit' }); };
    const pad = n => String(n).padStart(2, '0'), iso = d => d.getFullYear() + '-' + pad(d.getMonth() + 1) + '-' + pad(d.getDate());
    const pill = (t, cls) => `<span class="badge border ${cls}">${esc(t)}</span>`;
    const STATUS = { 'Paid': 'bg-success-subtle text-success border-success-subtle', 'Part paid': 'bg-warning-subtle text-warning-emphasis border-warning-subtle',
                     'Unpaid': 'bg-danger-subtle text-danger border-danger-subtle', 'Cancelled': 'bg-secondary-subtle text-secondary border-secondary-subtle' };

    let data = null, tab = 'sales', seq = 0, chart = null;
    const SK_KPIS = '#fdBody .fd-kpi', SK_GRAPHS = '#fdBody .fd-graph', SK_LISTS = '#fdBody .fd-lists';

    // the three lists: columns (text for export, html for the screen) and the amount columns that are totalled
    const TABS = {
        sales: {
            rows: () => data.sales || [], empty: 'No bills in this period.', sheet: 'Sale register',
            cols: [
                { label: 'Bill No', html: r => `<span class="fw-semibold font-monospace">${esc(r.BillNo)}</span>`, text: r => r.BillNo },
                { label: 'Bill date', html: r => fmtDT(r.BillDate), text: r => fmtDT(r.BillDate) },
                { label: 'Patient', html: r => `<div class="fw-semibold">${esc(r.PatientName)}</div><div class="text-muted fs-9">${esc(r.PatientCode)}</div>`, text: r => `${r.PatientName} (${r.PatientCode})` },
                { label: 'Tests', html: r => `<span title="${esc(r.TestNames)}">${num(r.TestCount)} test(s)</span><div class="text-muted fs-9 text-truncate" style="max-width:280px">${esc(r.TestNames)}</div>`, text: r => r.TestNames },
                { label: 'MRP', sum: 'MrpAmount' }, { label: 'Bill amount', sum: 'BillAmount' }, { label: 'Paid', sum: 'PaidAmount' }, { label: 'Due', sum: 'DueAmount' },
                { label: 'Status', html: r => pill(r.BillStatus, STATUS[r.BillStatus] || ''), text: r => r.BillStatus }
            ]
        },
        realization: {
            rows: () => data.realization || [], empty: 'No money received in this period.', sheet: 'Realization',
            cols: [
                { label: 'Received on', html: r => fmtDT(r.PaidOn), text: r => fmtDT(r.PaidOn) },
                { label: 'Receipt No', html: r => `<span class="font-monospace">${esc(r.ReceiptNo || '')}</span>`, text: r => r.ReceiptNo || '' },
                { label: 'Bill No', html: r => `<span class="fw-semibold font-monospace">${esc(r.BillNo)}</span>`, text: r => r.BillNo },
                { label: 'Bill date', html: r => fmtD(r.BillDate), text: r => fmtD(r.BillDate) },
                { label: 'Patient', html: r => esc(r.PatientName), text: r => r.PatientName },
                { label: 'Mode', html: r => pill(r.PaymentMode, 'bg-info-subtle text-info-emphasis border-info-subtle'), text: r => r.PaymentMode },
                { label: 'Amount received', sum: 'PaidAmount' }
            ]
        },
        pending: {
            rows: () => data.pending || [], empty: 'Nothing is pending. All bills are paid.', sheet: 'Pending receivable',
            cols: [
                { label: 'Bill No', html: r => `<span class="fw-semibold font-monospace">${esc(r.BillNo)}</span>`, text: r => r.BillNo },
                { label: 'Bill date', html: r => fmtD(r.BillDate), text: r => fmtD(r.BillDate) },
                { label: 'Age (days)', html: r => `<span class="${r.AgeDays > 30 ? 'text-danger fw-bold' : ''}">${num(r.AgeDays)}</span>`, text: r => r.AgeDays, cls: 'text-end' },
                { label: 'Patient', html: r => esc(r.PatientName), text: r => r.PatientName },
                { label: 'Bill amount', sum: 'BillAmount' }, { label: 'Paid', sum: 'PaidAmount' }, { label: 'Due', sum: 'DueAmount' }
            ]
        }
    };

    function setRange(r) {
        const t = new Date(); let f = new Date(t), to = new Date(t);
        if (r === 'week') f.setDate(t.getDate() - 6);
        else if (r === 'month') f = new Date(t.getFullYear(), t.getMonth(), 1);
        else if (r === 'lastmonth') { f = new Date(t.getFullYear(), t.getMonth() - 1, 1); to = new Date(t.getFullYear(), t.getMonth(), 0); }
        else if (r === 'year') f.setDate(t.getDate() - 364);
        $('#fdFrom').val(iso(f)); $('#fdTo').val(iso(to));
        $('.btn-quick').removeClass('active').filter(`[data-range="${r}"]`).addClass('active');
    }

    function clearShimmer() { EmrShimmer.off(SK_KPIS); EmrShimmer.off(SK_GRAPHS); EmrShimmer.off(SK_LISTS); }

    function load() {
        const my = ++seq, id = $('#fdFranchise').val(), from = $('#fdFrom').val(), to = $('#fdTo').val();
        $('#fdError').addClass('d-none');
        if (!id) { $('#fdBody').addClass('d-none'); $('#fdPick').removeClass('d-none'); return; }
        if (!from || !to) return;
        $('#fdPick').addClass('d-none'); $('#fdBody').removeClass('d-none');
        $('#fdRange').text(fmtD(from) + (from === to ? '' : ' – ' + fmtD(to)));
        $('#fdExcel, #fdPrint').prop('disabled', true);
        // shimmer over the three zones while loading
        EmrShimmer.on(SK_KPIS); EmrShimmer.on(SK_GRAPHS); EmrShimmer.on(SK_LISTS);

        $.get(dataUrl, { franchiseId: id, fromDate: from, toDate: to }).done(res => {
            if (my !== seq) return;
            if (!res || !res.success) { clearShimmer(); if (!data) $('#fdBody').addClass('d-none'); $('#fdError').text(res?.message || 'Unable to load the dashboard.').removeClass('d-none'); return; }
            data = res.data || {};
            // one paint each, in reading order: widgets, then the graph and details, then the lists
            EmrShimmer.stage([
                () => { renderKpis(); EmrShimmer.off(SK_KPIS); },
                () => { renderProfile(); renderTrend(); EmrShimmer.off(SK_GRAPHS); },
                () => { renderList(); EmrShimmer.off(SK_LISTS); $('#fdExcel, #fdPrint').prop('disabled', false); }
            ], () => my === seq);
        }).fail(xhr => {
            if (my !== seq) return;
            clearShimmer(); if (!data) $('#fdBody').addClass('d-none');
            $('#fdError').text(xhr.status === 403 ? 'You do not have access to this dashboard.' : 'Server error while loading the dashboard. Please try again.').removeClass('d-none');
        });
    }

    function renderKpis() {
        const s = data.summary || {}, p = data.profile || {};
        const limit = (Number(p.CreditLimit) || 0) + (Number(p.TemporaryLimit) || 0);
        $('#fdName').text(p.FranchiseName ? `${p.FranchiseName} (${p.FranchiseCode})` : '');
        $('#kSales').text(money(s.SalesAmount));
        $('#kSalesSub').text(`${num(s.Bills)} bill(s) · ${num(s.Patients)} patient(s)` + (Number(s.CancelledBills) ? ` · ${num(s.CancelledBills)} cancelled` : ''));
        $('#kRealized').text(money(s.RealizedAmount));
        $('#kPending').text(money(s.PendingTotal));
        $('#kPendingSub').text(`as of today · ${money(s.PendingOnPeriodBills)} on this period's bills`);
        $('#kWallet').text(money(p.WalletBalance));
        $('#kWalletSub').text(p.CreditFacility || '');
        $('#kCredit').text(limit > 0 ? money(Math.max(0, limit - (Number(p.OutstandingNow) || 0))) : '—');
        $('#kCreditSub').text(limit > 0 ? `of ${money(limit)} limit` : 'no credit limit set');
    }

    function renderProfile() {
        const p = data.profile || {};
        $('#fdStatus').html(p.IsSuspended ? pill('Suspended', 'bg-danger text-white border-danger ms-1') : (p.IsActive ? pill('Active', 'bg-success-subtle text-success border-success-subtle ms-1') : pill('Inactive', 'bg-secondary-subtle text-secondary border-secondary-subtle ms-1')));
        $('#dCode').text(p.FranchiseCode || '—'); $('#dType').text(p.FranchiseType || '—'); $('#dBranch').text(p.ParentBranch || '—');
        $('#dContact').html(esc(p.MobileNo || '—') + (p.Email ? `<div class="text-muted fs-9 fw-normal">${esc(p.Email)}</div>` : ''));
        $('#dGoLive').text(fmtD(p.GoLiveDate) || '—');
        $('#dAgreement').text(p.AgreementFrom || p.AgreementTo ? `${fmtD(p.AgreementFrom) || '…'} – ${fmtD(p.AgreementTo) || '…'}` : '—');
        $('#dFacility').text(p.CreditFacility || '—');
        $('#dLimit').text(money(p.CreditLimit) + (Number(p.TemporaryLimit) ? ` + ${money(p.TemporaryLimit)} temporary` : ''));
        $('#dDays').text(p.CreditDays != null ? `${num(p.CreditDays)} days` + (Number(p.GraceDays) ? ` + ${num(p.GraceDays)} grace` : '') : '—');
        $('#dDeposit').text(money(p.SecurityDeposit));
    }

    function renderTrend() {
        const rows = data.trend || [];
        $('#fdTrendEmpty').toggleClass('d-none', rows.length > 0);
        $('#fdTrend').parent().toggleClass('d-none', rows.length === 0);
        if (chart) { chart.destroy(); chart = null; }
        if (!rows.length) return;
        chart = new Chart(document.getElementById('fdTrend'), {
            type: 'bar',
            data: { labels: rows.map(r => fmtD(r.Day).replace(/ \d{4}$/, '')),
                    datasets: [{ label: 'Sales', data: rows.map(r => Number(r.Sales) || 0), backgroundColor: '#6d28d9', borderRadius: 3 },
                               { label: 'Realization', data: rows.map(r => Number(r.Realized) || 0), backgroundColor: '#f59e0b', borderRadius: 3 }] },
            options: { maintainAspectRatio: false, plugins: { legend: { position: 'bottom', labels: { boxWidth: 12 } },
                       tooltip: { callbacks: { label: c => `${c.dataset.label}: ${money(c.parsed.y)}` } } },
                       scales: { y: { beginAtZero: true, ticks: { callback: v => '₹' + Number(v).toLocaleString('en-IN') } }, x: { grid: { display: false } } } }
        });
    }

    function renderList() {
        const t = TABS[tab], rows = t.rows();
        $('#fdEmptyText').text(t.empty);
        $('#fdEmpty').toggleClass('d-none', rows.length > 0); $('#fdTable').toggleClass('d-none', rows.length === 0);
        $('#fdCount').text(rows.length ? `${rows.length} record(s)` : '');
        if (!rows.length) return;
        $('#fdTable thead').html('<tr><th class="ps-3">#</th>' + t.cols.map(c => `<th class="${c.sum ? 'text-end' : (c.cls || '')}">${esc(c.label)}</th>`).join('') + '</tr>');
        $('#fdTable tbody').html(rows.map((r, i) => `<tr><td class="ps-3 text-muted">${i + 1}</td>` +
            t.cols.map(c => c.sum ? `<td class="text-end amt">${money(r[c.sum])}</td>` : `<td class="${c.cls || ''}">${c.html(r)}</td>`).join('') + '</tr>').join(''));
        $('#fdTable tfoot').html('<tr><td></td>' + t.cols.map((c, i) => c.sum
            ? `<td class="text-end amt">${money(rows.reduce((a, r) => a + (Number(r[c.sum]) || 0), 0))}</td>`
            : (i === 0 ? `<td>Total (${rows.length})</td>` : '<td></td>')).join('') + '</tr>');
    }

    // Excel: one sheet per list plus the summary (the library is fetched on the first click)
    $('#fdExcel').on('click', function () { EmrExportLibs.run(this, 'excel', () => {
        const s = data.summary || {}, p = data.profile || {}, wb = XLSX.utils.book_new();
        XLSX.utils.book_append_sheet(wb, XLSX.utils.aoa_to_sheet([
            ['Franchise', `${p.FranchiseName || ''} (${p.FranchiseCode || ''})`], ['Period', $('#fdRange').text()],
            ['Sales', Number(s.SalesAmount) || 0], ['Bills', Number(s.Bills) || 0], ['Total realization', Number(s.RealizedAmount) || 0],
            ['Pending receivable (today)', Number(s.PendingTotal) || 0], ['Wallet balance', Number(p.WalletBalance) || 0], ['Credit limit', Number(p.CreditLimit) || 0]]), 'Summary');
        Object.keys(TABS).forEach(k => {
            const t = TABS[k];
            XLSX.utils.book_append_sheet(wb, XLSX.utils.aoa_to_sheet([t.cols.map(c => c.label)]
                .concat(t.rows().map(r => t.cols.map(c => c.sum ? (Number(r[c.sum]) || 0) : c.text(r))))), t.sheet);
        });
        XLSX.writeFile(wb, `Franchise_${(p.FranchiseCode || 'dashboard')}_${$('#fdFrom').val()}_to_${$('#fdTo').val()}.xlsx`);
    }); });
    $('#fdPrint').on('click', () => window.print());

    $('#fdTabs .nav-link').on('click', function () { tab = $(this).data('tab'); $('#fdTabs .nav-link').removeClass('active'); $(this).addClass('active'); if (data) renderList(); });
    $('.btn-quick').on('click', function () { setRange($(this).data('range')); load(); });
    $('#fdFrom, #fdTo').on('change', () => { $('.btn-quick').removeClass('active'); load(); });
    $('#fdFranchise').on('change', () => { data = null; load(); });

    setRange('month');
    load();
})();
</script>
}
