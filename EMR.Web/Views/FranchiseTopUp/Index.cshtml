@model EMR.Web.Models.ViewModels.FranchiseTopUpPageViewModel
@inject EMR.Shared.Security.IActionPermissionGuard PermissionGuard
@using EMR.Web.Controllers
@{
    ViewData["Title"] = "Franchise Top-Up";
    var canTopUp  = await PermissionGuard.ShowsAsync(Context, FranchiseTopUpController.PageCode, FranchiseTopUpController.TopUpControl);
    var canPrint  = await PermissionGuard.ShowsAsync(Context, FranchiseTopUpController.PageCode, EMR.Shared.Security.PermissionControls.Print);
    var canExport = await PermissionGuard.ShowsAsync(Context, FranchiseTopUpController.PageCode, EMR.Shared.Security.PermissionControls.Export);
    var methods = Model.PaymentMethods.Select(m => new { id = m.PaymentMethodId, name = m.MethodName, code = m.MethodCode,
        needsRef = m.RequiresRef || m.RequiresChequeNo || m.RequiresUPIRef }).ToList();
}

@section HeadStyles {
<style>
    .ft-wrap { --ft-line:#e2e8f0; --ft-muted:#64748b; --ft-ink:#0f172a; --ft-acc:#0f766e; --ft-acc-soft:#f0fdfa; }
    .ft-wrap .fs-8 { font-size:.78rem !important; } .ft-wrap .fs-9 { font-size:.7rem !important; }
    .ft-card { background:#fff;border:1px solid var(--ft-line);border-radius:.75rem; }
    .ft-kpi { padding:.85rem 1rem;border-left:4px solid var(--k);height:100%; }
    .ft-kpi .k-label { font-size:.66rem;font-weight:700;letter-spacing:.5px;text-transform:uppercase;color:var(--ft-muted); }
    .ft-kpi .k-val { font-size:1.35rem;font-weight:800;color:var(--ft-ink);line-height:1.2;font-variant-numeric:tabular-nums; }
    .ft-kpi .k-sub { font-size:.7rem;color:var(--ft-muted); }
    .btn-quick.active { background:var(--ft-acc);border-color:var(--ft-acc);color:#fff; }
    .ft-sec-title { font-size:.72rem;font-weight:800;letter-spacing:.5px;text-transform:uppercase;color:var(--ft-muted); }
    .amt { font-variant-numeric:tabular-nums;white-space:nowrap; }
    /* franchise wallets */
    .ft-wallets { max-height:430px;overflow:auto; }
    .ft-wallet { display:grid;grid-template-columns:minmax(0,1fr) auto;gap:.35rem .75rem;padding:.7rem .9rem;border-bottom:1px solid #eef2f6; }
    .ft-wallet:last-child { border-bottom:0; }
    .ft-wallet.is-off { background:#fafafa; }
    .ft-wallet .w-name { font-weight:700;font-size:.85rem;color:var(--ft-ink); }
    .ft-wallet .w-meta { font-size:.7rem;color:var(--ft-muted); }
    .ft-wallet .w-bal { font-size:1.05rem;font-weight:800;text-align:right;font-variant-numeric:tabular-nums; }
    .ft-wallet .w-actions { grid-column:1 / -1;display:flex;flex-wrap:wrap;gap:.4rem;align-items:center;justify-content:space-between; }
    .chip { font-size:.66rem;font-weight:700;padding:2px 8px;border-radius:999px;border:1px solid;white-space:nowrap; }
    .chip-pre { background:#ecfdf5;color:#047857;border-color:#a7f3d0; }
    .chip-post { background:#eff6ff;color:#1d4ed8;border-color:#bfdbfe; }
    .chip-hyb { background:#f5f3ff;color:#6d28d9;border-color:#ddd6fe; }
    .chip-warn { background:#fff7ed;color:#c2410c;border-color:#fed7aa; }
    .chip-bad { background:#fef2f2;color:#b91c1c;border-color:#fecaca; }
    .chip-mute { background:#f8fafc;color:#64748b;border-color:#e2e8f0; }
    .cover { height:5px;border-radius:3px;background:#f1f5f9;overflow:hidden;width:120px; }
    .cover > span { display:block;height:100%; }
    /* list */
    .ft-table thead th { position:sticky;top:0;z-index:1;background:#f8fafc;color:var(--ft-muted);font-size:.66rem;font-weight:700;
                         letter-spacing:.4px;text-transform:uppercase;white-space:nowrap;border-bottom:1px solid var(--ft-line); }
    .ft-table tbody td { font-size:.78rem;vertical-align:middle;border-color:#eef2f6; }
    .ft-table tfoot td { font-size:.8rem;font-weight:800;background:#f8fafc; }
    .tbl-scroll { max-height:55vh;overflow:auto; }
    .mode-row { display:grid;grid-template-columns:minmax(0,1fr) auto;gap:.15rem .5rem;font-size:.76rem;padding:.35rem 0;border-bottom:1px dashed #e2e8f0; }
    .mode-row:last-child { border-bottom:0; }
    .mode-bar { grid-column:1 / -1;height:4px;border-radius:2px;background:#f1f5f9;overflow:hidden; }
    .mode-bar > span { display:block;height:100%;background:var(--ft-acc); }
    .not-recorded { color:#94a3b8;font-style:italic; }
    /* top-up modal */
    .amt-input { font-size:1.4rem;font-weight:800;font-variant-numeric:tabular-nums; }
    .quick-amt .btn { font-size:.72rem; }
    .ft-preview { background:var(--ft-acc-soft);border:1px solid #99f6e4;border-radius:.6rem;padding:.6rem .8rem; }
    .ft-preview .row-l { display:flex;justify-content:space-between;font-size:.8rem; }
    .ft-preview .row-l.total { font-weight:800;font-size:.95rem;border-top:1px solid #99f6e4;padding-top:.3rem;margin-top:.3rem;color:var(--ft-acc); }
    /* statement */
    .st-row td { font-size:.76rem; }
    .st-in { color:#047857; } .st-out { color:#b91c1c; }
</style>
}

<div class="container-fluid px-3 py-2 ft-wrap">
    <!-- Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
        <div>
            <h1 class="h4 fw-bold mb-0"><i class="bi bi-wallet2 me-2" style="color:#0f766e;"></i>Franchise Top-Up</h1>
            <div class="text-muted fs-8">Utility &rsaquo; recharge the wallet of a <strong>Prepaid (Wallet)</strong> franchise; B2B Lab bills of that franchise are paid from it</div>
        </div>
        <div class="d-flex gap-2">
            <button type="button" class="btn btn-sm btn-outline-success" id="btnExport" asp-permission="UTILITY.FRANCHISETOPUP:EXPORT" disabled><i class="bi bi-file-earmark-excel me-1"></i>Excel</button>
            <button type="button" class="btn btn-sm text-white px-3" style="background:#0f766e;" id="btnNewTopUp" asp-permission="UTILITY.FRANCHISETOPUP:TOPUP"><i class="bi bi-plus-circle me-1"></i>New Top-Up</button>
        </div>
    </div>

    <!-- Filters -->
    <div class="ft-card p-2 px-3 mb-2">
        <div class="row g-2 align-items-end">
            <div class="col-6 col-md-2"><label class="form-label fs-9 fw-bold text-muted text-uppercase mb-0" for="txtFrom">From</label>
                <input type="date" id="txtFrom" class="form-control form-control-sm" autocomplete="off" /></div>
            <div class="col-6 col-md-2"><label class="form-label fs-9 fw-bold text-muted text-uppercase mb-0" for="txtTo">To</label>
                <input type="date" id="txtTo" class="form-control form-control-sm" autocomplete="off" /></div>
            <div class="col-12 col-md-4"><label class="form-label fs-9 fw-bold text-muted text-uppercase mb-0">Quick select</label>
                <div class="btn-group btn-group-sm w-100" role="group">
                    <button type="button" class="btn btn-outline-secondary btn-quick" data-range="today">Today</button>
                    <button type="button" class="btn btn-outline-secondary btn-quick" data-range="week">7 Days</button>
                    <button type="button" class="btn btn-outline-secondary btn-quick" data-range="month">This Month</button>
                    <button type="button" class="btn btn-outline-secondary btn-quick" data-range="lastmonth">Last Month</button>
                </div></div>
            <div class="col-6 col-md-2"><label class="form-label fs-9 fw-bold text-muted text-uppercase mb-0" for="selFranchise">Franchise</label>
                <select id="selFranchise" class="form-select form-select-sm" autocomplete="off"><option value="">All franchises</option></select></div>
            <div class="col-6 col-md-2"><label class="form-label fs-9 fw-bold text-muted text-uppercase mb-0" for="selMode">Payment mode</label>
                <select id="selMode" class="form-select form-select-sm" autocomplete="off">
                    <option value="">All modes</option>
                    @foreach (var m in Model.PaymentMethods) { <option value="@m.PaymentMethodId">@m.MethodName</option> }
                    <option value="0">Not recorded (older top-ups)</option>
                </select></div>
            <div class="col-12 col-md-9">
                <div class="input-group input-group-sm"><span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                    <input type="text" id="txtSearch" class="form-control" autocomplete="off" maxlength="100" placeholder="Receipt No, reference / UTR, franchise name or code, remarks..." /></div>
            </div>
            <div class="col-12 col-md-3 d-flex gap-2 justify-content-md-end">
                <button type="button" class="btn btn-sm btn-link text-danger text-decoration-none" id="btnReset"><i class="bi bi-x-circle me-1"></i>Reset</button>
                <button type="button" class="btn btn-sm text-white px-4" style="background:#0f766e;" id="btnApply"><i class="bi bi-funnel me-1"></i>Apply</button>
            </div>
        </div>
    </div>

    <div id="stateError" class="alert alert-danger fs-8 d-none"></div>

    <!-- KPIs -->
    <div class="row g-2 mb-2">
        <div class="col-6 col-lg"><div class="ft-card ft-kpi" style="--k:#0f766e;"><div class="k-label">Top-ups in period</div><div class="k-val" id="kTopUp">&mdash;</div><div class="k-sub"><span id="kTopUpCount">0</span> receipt(s) &middot; <span id="kToppedUp">0</span> franchise(s)</div></div></div>
        <div class="col-6 col-lg"><div class="ft-card ft-kpi" style="--k:#2563eb;"><div class="k-label">Wallet balance</div><div class="k-val" id="kBalance">&mdash;</div><div class="k-sub">held for <span id="kPrepaid">0</span> active prepaid franchise(s)</div></div></div>
        <div class="col-6 col-lg"><div class="ft-card ft-kpi" style="--k:#b45309;"><div class="k-label">Used from wallets</div><div class="k-val" id="kUsed">&mdash;</div><div class="k-sub">B2B Lab bills paid in the period</div></div></div>
        <div class="col-6 col-lg"><div class="ft-card ft-kpi" style="--k:#b91c1c;"><div class="k-label">Low balance</div><div class="k-val" id="kLow">&mdash;</div><div class="k-sub">empty, or under 7 days of use</div></div></div>
        <div class="col-12 col-lg"><div class="ft-card ft-kpi" style="--k:#7c3aed;"><div class="k-label">Highest top-up</div><div class="k-val" id="kHigh">&mdash;</div><div class="k-sub">single receipt in the period</div></div></div>
    </div>

    <div class="row g-2 mb-2">
        <!-- Franchise wallets -->
        <div class="col-lg-7">
            <div class="ft-card h-100">
                <div class="d-flex justify-content-between align-items-center px-3 py-2 border-bottom">
                    <div class="ft-sec-title"><i class="bi bi-shop me-1"></i>Franchise wallets</div>
                    <div class="form-check form-switch fs-8 mb-0">
                        <input class="form-check-input" type="checkbox" id="chkPrepaidOnly" checked>
                        <label class="form-check-label" for="chkPrepaidOnly">Prepaid (Wallet) only</label>
                    </div>
                </div>
                <div class="ft-wallets" id="walletList"></div>
            </div>
        </div>
        <!-- Trend + by mode -->
        <div class="col-lg-5">
            <div class="ft-card h-100 p-3">
                <div class="ft-sec-title mb-1"><i class="bi bi-graph-up me-1"></i>Top-ups vs wallet use</div>
                <div style="position:relative;height:190px;"><canvas id="chTrend" aria-label="Top-ups and wallet use per day"></canvas></div>
                <div class="ft-sec-title mt-3 mb-1"><i class="bi bi-credit-card-2-front me-1"></i>By payment mode</div>
                <div id="modeList"></div>
            </div>
        </div>
    </div>

    <!-- Top-ups list -->
    <div class="ft-card">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 px-3 py-2 border-bottom">
            <div class="ft-sec-title"><i class="bi bi-receipt me-1"></i>Top-up receipts</div>
            <div class="text-muted fs-8" id="lblCount"></div>
        </div>
        <div id="stateLoading" class="text-center text-muted py-4 fs-8"><span class="spinner-border spinner-border-sm me-2"></span>Loading...</div>
        <div id="stateEmpty" class="text-center text-muted py-4 fs-8 d-none"><i class="bi bi-inbox fs-4 d-block mb-1"></i>No top-ups for the selected filters.</div>
        <div class="tbl-scroll" id="tblWrap">
            <table class="table table-hover table-sm mb-0 ft-table d-none" id="tblTopUps">
                <thead><tr>
                    <th class="ps-3">#</th><th>Receipt No</th><th>Date &amp; time</th><th>Franchise</th><th class="text-end">Amount</th>
                    <th>Payment mode</th><th>Reference</th><th class="text-end">Balance after</th><th>Remarks</th><th>Received by</th><th class="text-center">Receipt</th>
                </tr></thead>
                <tbody id="tbTopUps"></tbody>
                <tfoot><tr><td class="ps-3" colspan="4">Total &middot; <span id="ftCount">0</span> top-up(s)</td><td class="text-end amt" id="ftAmount"></td><td colspan="6"></td></tr></tfoot>
            </table>
        </div>
    </div>
</div>

<!-- Top-up modal -->
<div class="modal fade" id="topUpModal" tabindex="-1" aria-labelledby="topUpModalLabel" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header text-white py-2" style="background:#0f766e;">
                <h6 class="modal-title fw-bold mb-0" id="topUpModalLabel"><i class="bi bi-wallet2 me-2"></i>Franchise Wallet Top-Up</h6>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="frmTopUp" novalidate>
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="mb-2">
                        <label class="form-label fw-semibold small mb-1" for="tuFranchise">Franchise <span class="text-danger">*</span></label>
                        <select class="form-select form-select-sm" id="tuFranchise" required></select>
                        <div class="form-text fs-9">Only active franchises with Credit Facility Type <strong>Prepaid (Wallet)</strong> can be topped up.</div>
                    </div>
                    <div class="mb-2">
                        <label class="form-label fw-semibold small mb-1" for="tuAmount">Top-up amount (&#8377;) <span class="text-danger">*</span></label>
                        <input type="number" step="0.01" min="1" max="9999999.99" inputmode="decimal" class="form-control amt-input" id="tuAmount" required placeholder="0.00" />
                        <div class="quick-amt d-flex flex-wrap gap-1 mt-1">
                            @foreach (var q in new[] { 5000, 10000, 25000, 50000 })
                            {
                                <button type="button" class="btn btn-sm btn-outline-secondary py-0" data-amt="@q">+ &#8377;@q.ToString("N0", System.Globalization.CultureInfo.GetCultureInfo("en-IN"))</button>
                            }
                        </div>
                    </div>
                    <div class="row g-2 mb-2">
                        <div class="col-6">
                            <label class="form-label fw-semibold small mb-1" for="tuMode">Payment mode <span class="text-danger">*</span></label>
                            <select class="form-select form-select-sm" id="tuMode" required>
                                <option value="">Select...</option>
                                @foreach (var m in Model.PaymentMethods) { <option value="@m.PaymentMethodId">@m.MethodName</option> }
                            </select>
                        </div>
                        <div class="col-6">
                            <label class="form-label fw-semibold small mb-1" for="tuRef">Reference / UTR / Cheque No <span class="text-danger d-none" id="tuRefReq">*</span></label>
                            <input type="text" class="form-control form-control-sm" id="tuRef" maxlength="100" autocomplete="off" />
                        </div>
                    </div>
                    <div class="mb-2">
                        <label class="form-label fw-semibold small mb-1" for="tuNarration">Remarks</label>
                        <input type="text" class="form-control form-control-sm" id="tuNarration" maxlength="500" autocomplete="off" placeholder="e.g. Advance deposit for October" />
                    </div>
                    <div class="ft-preview" id="tuPreview">
                        <div class="row-l"><span>Current balance</span><span class="amt" id="pvBefore">&#8377;0.00</span></div>
                        <div class="row-l"><span>Top-up</span><span class="amt" id="pvAmount">+ &#8377;0.00</span></div>
                        <div class="row-l total"><span>Balance after top-up</span><span class="amt" id="pvAfter">&#8377;0.00</span></div>
                    </div>
                    <div id="tuError" class="alert alert-danger py-1 px-2 small d-none mt-2 mb-0"></div>
                </div>
                <div class="modal-footer py-2">
                    <button type="button" class="btn btn-sm btn-light" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-sm text-white px-4 fw-bold" style="background:#0f766e;" id="btnSaveTopUp"><i class="bi bi-check2-circle me-1"></i>Top Up Wallet</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Wallet statement -->
<div class="offcanvas offcanvas-end" tabindex="-1" id="stmtPanel" aria-labelledby="stmtTitle" style="width:min(640px,100vw);">
    <div class="offcanvas-header border-bottom py-2">
        <div>
            <h6 class="offcanvas-title fw-bold mb-0" id="stmtTitle">Wallet statement</h6>
            <div class="text-muted fs-8" id="stmtSub"></div>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>
    <div class="offcanvas-body p-0">
        <div class="d-flex gap-3 px-3 py-2 border-bottom fs-8">
            <div>Top-ups <div class="fw-bold st-in amt" id="stIn">&#8377;0.00</div></div>
            <div>Bills paid <div class="fw-bold st-out amt" id="stOut">&#8377;0.00</div></div>
            <div class="ms-auto text-end">Balance now <div class="fw-bold amt" id="stBal">&#8377;0.00</div></div>
        </div>
        <div id="stmtBody" class="p-0"></div>
    </div>
</div>

@section Scripts {
<script src="~/lib/chartjs/chart.umd.min.js"></script>
<script>
(function () {
    const URLS = {
        data: '@Url.Action("Dashboard", "FranchiseTopUp")',
        statement: '@Url.Action("Statement", "FranchiseTopUp")',
        topUp: '@Url.Action("TopUp", "FranchiseTopUp")',
        receipt: '@Url.Action("Receipt", "FranchiseTopUp")',
        exportXl: '@Url.Action("Export", "FranchiseTopUp")'
    };
    const CAN = { topUp: @(canTopUp ? "true" : "false"), print: @(canPrint ? "true" : "false"), export: @(canExport ? "true" : "false") };
    const METHODS = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(methods));
    const MAX_AMOUNT = 9999999.99;
    let data = null, loadSeq = 0, chart = null, saving = false;

    const pad = n => String(n).padStart(2, '0');
    const iso = d => d.getFullYear() + '-' + pad(d.getMonth() + 1) + '-' + pad(d.getDate());
    const money = n => '₹' + (Number(n) || 0).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    const esc = s => String(s ?? '').replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
    const fmtD = s => { const d = new Date(s); return isNaN(d) ? '' : d.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }); };
    const fmtDT = s => { const d = new Date(s); return isNaN(d) ? '' : fmtD(s) + ', ' + d.toLocaleTimeString('en-IN', { hour: '2-digit', minute: '2-digit', hour12: true }); };
    const facilityChip = w => w.creditFacilityType === 1 ? '<span class="chip chip-pre">Prepaid (Wallet)</span>'
                         : w.creditFacilityType === 2 ? '<span class="chip chip-post">Postpaid (Credit)</span>'
                         : w.creditFacilityType === 3 ? '<span class="chip chip-hyb">Hybrid</span>' : '<span class="chip chip-mute">Not set</span>';
    const token = () => $('#frmTopUp input[name="__RequestVerificationToken"]').val();
    const filters = () => ({ fromDate: $('#txtFrom').val(), toDate: $('#txtTo').val(), franchiseId: $('#selFranchise').val() || '',
                             paymentMethodId: $('#selMode').val(), search: $('#txtSearch').val() || '' });

    function setRange(r) {
        const t = new Date(); let f = new Date(t), to = new Date(t);
        if (r === 'week') f.setDate(t.getDate() - 6);
        else if (r === 'month') f = new Date(t.getFullYear(), t.getMonth(), 1);
        else if (r === 'lastmonth') { f = new Date(t.getFullYear(), t.getMonth() - 1, 1); to = new Date(t.getFullYear(), t.getMonth(), 0); }
        $('#txtFrom').val(iso(f)); $('#txtTo').val(iso(to));
        $('.btn-quick').removeClass('active').filter(`[data-range="${r}"]`).addClass('active');
    }

    // ── load ──
    function load() {
        const seq = ++loadSeq;
        $('#stateError').addClass('d-none'); $('#stateLoading').removeClass('d-none'); $('#stateEmpty').addClass('d-none');
        $('#tblTopUps').addClass('d-none'); $('#btnExport').prop('disabled', true);
        $.get(URLS.data, filters())
            .done(res => {
                if (seq !== loadSeq) return;
                $('#stateLoading').addClass('d-none');
                if (!res || !res.success) { $('#stateError').text(res?.message || 'Unable to load the franchise top-ups.').removeClass('d-none'); return; }
                data = res.data;
                fillFranchises(); renderKpis(); renderWallets(); renderTrend(); renderModes(); renderList();
            })
            .fail(xhr => {
                if (seq !== loadSeq) return;
                $('#stateLoading').addClass('d-none');
                $('#stateError').text(xhr.status === 403 ? 'You do not have permission to open this screen.' : 'Server error while loading. Please try again.').removeClass('d-none');
            });
    }

    function fillFranchises() {
        const $s = $('#selFranchise'), cur = $s.val();
        if ($s.find('option').length <= 1 || !cur) {
            $s.find('option:not(:first)').remove();
            (data.franchises || []).slice().sort((a, b) => (a.franchise_Name || '').localeCompare(b.franchise_Name || ''))
                .forEach(w => $s.append(`<option value="${w.franchise_ID}">${esc(w.franchise_Name)} (${esc(w.franchise_Code)})</option>`));
            $s.val(cur);
        }
    }

    function renderKpis() {
        const s = data.summary || {};
        $('#kTopUp').text(money(s.topUpAmount)); $('#kTopUpCount').text(s.topUpCount || 0); $('#kToppedUp').text(s.franchisesToppedUp || 0);
        $('#kBalance').text(money(s.totalWalletBalance)); $('#kPrepaid').text(s.prepaidFranchiseCount || 0);
        $('#kUsed').text(money(s.periodUsage)); $('#kLow').text(s.lowBalanceCount || 0); $('#kHigh').text(money(s.highestTopUp));
    }

    function coverInfo(w) {
        if (w.creditFacilityType !== 1) return null;
        if (w.walletBalance <= 0) return { cls: 'chip-bad', text: 'Empty wallet', pct: 0, color: '#dc2626' };
        if (w.daysOfCover == null) return { cls: 'chip-mute', text: 'No use in last 30 days', pct: 100, color: '#94a3b8' };
        const d = Number(w.daysOfCover), pct = Math.min(100, d / 30 * 100);
        if (d < 7) return { cls: 'chip-warn', text: `≈ ${d.toFixed(1)} days of use left`, pct, color: '#ea580c' };
        return { cls: 'chip-pre', text: `≈ ${d >= 365 ? '365+' : d.toFixed(0)} days of use left`, pct, color: '#0f766e' };
    }

    function renderWallets() {
        const prepaidOnly = $('#chkPrepaidOnly').is(':checked');
        const rows = (data.franchises || []).filter(w => !prepaidOnly || w.creditFacilityType === 1);
        if (!rows.length) { $('#walletList').html('<div class="text-center text-muted py-4 fs-8">No franchises to show.</div>'); return; }
        $('#walletList').html(rows.map(w => {
            const c = coverInfo(w);
            const status = !w.isActive ? '<span class="chip chip-bad">Inactive</span>' : (w.isSuspended ? '<span class="chip chip-warn">Suspended</span>' : '');
            const topBtn = !CAN.topUp ? '' : (w.canTopUp
                ? `<button type="button" class="btn btn-sm text-white py-0 px-2 btn-wallet-topup" style="background:#0f766e;" data-id="${w.franchise_ID}"><i class="bi bi-plus-circle me-1"></i>Top-Up</button>`
                : `<span class="d-inline-block" tabindex="0" title="${esc(w.topUpBlockReason || '')}"><button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2" disabled><i class="bi bi-lock me-1"></i>Top-Up</button></span>`);
            return `<div class="ft-wallet ${w.canTopUp ? '' : 'is-off'}">
                <div class="min-w-0">
                    <div class="w-name text-truncate">${esc(w.franchise_Name)} <span class="text-muted fw-normal fs-9 font-monospace">${esc(w.franchise_Code)}</span></div>
                    <div class="d-flex flex-wrap gap-1 mt-1">${facilityChip(w)} ${status} ${c ? `<span class="chip ${c.cls}">${c.text}</span>` : ''}</div>
                </div>
                <div>
                    <div class="w-bal ${w.walletBalance > 0 ? 'text-success' : (w.creditFacilityType === 1 ? 'text-danger' : 'text-muted')}">${money(w.walletBalance)}</div>
                    ${c ? `<div class="cover ms-auto mt-1" title="${esc(c.text)}"><span style="width:${c.pct.toFixed(0)}%;background:${c.color};"></span></div>` : ''}
                </div>
                <div class="w-actions">
                    <div class="w-meta">${w.lastTopUpOn ? `Last top-up ${money(w.lastTopUpAmount)} on ${fmtD(w.lastTopUpOn)}` : 'No top-up yet'}
                        &middot; In period: <span class="text-success">+${money(w.periodTopUp)}</span> / <span class="text-danger">−${money(w.periodUsage)}</span></div>
                    <div class="d-flex gap-1">
                        <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2 btn-statement" data-id="${w.franchise_ID}"><i class="bi bi-list-columns-reverse me-1"></i>Statement</button>
                        ${topBtn}
                    </div>
                </div>
            </div>`;
        }).join(''));
        $('#walletList [title]').each(function () { if (this.title) new bootstrap.Tooltip(this); });
    }

    function renderTrend() {
        const t = data.trend || [];
        const labels = t.map(x => new Date(x.day).toLocaleDateString('en-GB', { day: '2-digit', month: 'short' }));
        const cfg = {
            type: 'bar',
            data: { labels, datasets: [
                { label: 'Top-ups', data: t.map(x => x.topUp), backgroundColor: '#0f766e', borderRadius: 3 },
                { label: 'Used for bills', data: t.map(x => x.used), backgroundColor: '#f59e0b', borderRadius: 3 }
            ] },
            options: { responsive: true, maintainAspectRatio: false, animation: false,
                plugins: { legend: { position: 'bottom', labels: { boxWidth: 10, font: { size: 11 } } },
                           tooltip: { callbacks: { label: c => `${c.dataset.label}: ${money(c.parsed.y)}` } } },
                scales: { x: { grid: { display: false }, ticks: { font: { size: 10 }, maxRotation: 0, autoSkip: true } },
                          y: { beginAtZero: true, ticks: { font: { size: 10 }, callback: v => '₹' + Number(v).toLocaleString('en-IN') } } } }
        };
        if (chart) chart.destroy();
        chart = new Chart(document.getElementById('chTrend'), cfg);
    }

    function renderModes() {
        const rows = data.byMode || [], tot = rows.reduce((a, r) => a + r.amount, 0);
        $('#modeList').html(rows.length ? rows.map(r => `<div class="mode-row">
                <div class="${r.paymentMethodId === 0 ? 'not-recorded' : 'fw-semibold'}">${esc(r.methodName)} <span class="text-muted fw-normal">· ${r.topUpCount}</span></div>
                <div class="amt fw-bold">${money(r.amount)}</div>
                <div class="mode-bar"><span style="width:${tot ? (r.amount / tot * 100).toFixed(1) : 0}%"></span></div></div>`).join('')
            : '<div class="text-muted fs-8">No top-ups in the period.</div>');
    }

    function renderList() {
        const rows = data.topUps || [];
        $('#stateEmpty').toggleClass('d-none', rows.length > 0);
        $('#tblTopUps').toggleClass('d-none', rows.length === 0);
        $('#btnExport').prop('disabled', rows.length === 0 && !(data.franchises || []).length);
        $('#lblCount').text(rows.length ? `${rows.length} receipt(s)` : '');
        $('#tbTopUps').html(rows.map((r, i) => `<tr>
            <td class="ps-3 text-muted">${i + 1}</td>
            <td class="font-monospace fw-semibold">${esc(r.receiptNo)}</td>
            <td class="text-nowrap">${fmtDT(r.createdDate)}</td>
            <td><div class="fw-semibold">${esc(r.franchise_Name)}</div><div class="text-muted fs-9 font-monospace">${esc(r.franchise_Code)}</div></td>
            <td class="text-end amt fw-bold text-success">${money(r.amount)}</td>
            <td>${r.methodName ? esc(r.methodName) : '<span class="not-recorded">Not recorded</span>'}</td>
            <td class="font-monospace fs-8">${r.transactionRef ? esc(r.transactionRef) : '<span class="text-muted">—</span>'}</td>
            <td class="text-end amt">${money(r.balanceAfter)}</td>
            <td class="fs-8">${r.narration ? esc(r.narration) : '<span class="text-muted">—</span>'}</td>
            <td class="text-nowrap fs-8">${esc(r.createdByName || '')}${r.branchName ? `<div class="text-muted fs-9">${esc(r.branchName)}</div>` : ''}</td>
            <td class="text-center">${CAN.print ? `<a class="btn btn-sm btn-outline-primary py-0 px-2" target="_blank" rel="noopener" title="Print receipt" href="${URLS.receipt}?receiptNo=${encodeURIComponent(r.receiptNo)}"><i class="bi bi-printer"></i></a>` : ''}</td>
        </tr>`).join(''));
        $('#ftCount').text(rows.length); $('#ftAmount').text(money(rows.reduce((a, r) => a + r.amount, 0)));
    }

    // ── statement ──
    function openStatement(id) {
        const w = (data.franchises || []).find(x => x.franchise_ID === id); if (!w) return;
        $('#stmtTitle').text(w.franchise_Name + ' — wallet statement');
        $('#stmtSub').text(`${w.franchise_Code} · ${fmtD($('#txtFrom').val())} – ${fmtD($('#txtTo').val())}`);
        $('#stBal').text(money(w.walletBalance)); $('#stIn, #stOut').text('…');
        $('#stmtBody').html('<div class="text-center text-muted py-4 fs-8"><span class="spinner-border spinner-border-sm me-2"></span>Loading...</div>');
        bootstrap.Offcanvas.getOrCreateInstance(document.getElementById('stmtPanel')).show();
        $.get(URLS.statement, { franchiseId: id, fromDate: $('#txtFrom').val(), toDate: $('#txtTo').val() })
            .done(res => {
                if (!res || !res.success) { $('#stmtBody').html(`<div class="alert alert-danger m-3 fs-8">${esc(res?.message || 'Unable to load the statement.')}</div>`); return; }
                const rows = res.data || [];
                const tin = rows.filter(r => r.transactionType === 'CREDIT').reduce((a, r) => a + r.amount, 0);
                const tout = rows.filter(r => r.transactionType === 'DEBIT').reduce((a, r) => a + r.amount, 0);
                $('#stIn').text(money(tin)); $('#stOut').text(money(tout));
                $('#stmtBody').html(rows.length ? `<table class="table table-sm mb-0 ft-table"><thead><tr><th class="ps-3">Date</th><th>Details</th><th class="text-end">Amount</th><th class="text-end pe-3">Balance</th></tr></thead><tbody>` +
                    rows.map(r => `<tr class="st-row">
                        <td class="ps-3 text-nowrap">${fmtDT(r.createdDate)}</td>
                        <td><div class="fw-semibold">${r.referenceType === 'TOPUP' ? 'Top-up' : (r.referenceType === 'LAB_BILL' ? 'Lab bill paid' : esc(r.referenceType))}</div>
                            <div class="text-muted fs-9">${esc(r.receiptNo || '')}${r.narration && r.narration !== 'Wallet balance recharged/top-up' ? ' · ' + esc(r.narration) : ''}</div></td>
                        <td class="text-end amt fw-bold ${r.transactionType === 'CREDIT' ? 'st-in' : 'st-out'}">${r.transactionType === 'CREDIT' ? '+' : '−'}${money(r.amount)}</td>
                        <td class="text-end amt pe-3">${money(r.balanceAfter)}</td></tr>`).join('') + '</tbody></table>'
                    : '<div class="text-center text-muted py-4 fs-8">No wallet transactions in the period.</div>');
            })
            .fail(() => $('#stmtBody').html('<div class="alert alert-danger m-3 fs-8">Server error while loading the statement.</div>'));
    }

    // ── top-up ──
    function eligible() { return (data?.franchises || []).filter(w => w.canTopUp); }
    function openTopUp(id) {
        if (!CAN.topUp) return;
        const list = eligible();
        if (!list.length) {
            Swal.fire({ icon: 'info', title: 'No franchise to top up', text: 'Only an active franchise whose Credit Facility Type is Prepaid (Wallet) can be topped up. Set it in Franchise Master.' });
            return;
        }
        $('#tuFranchise').html('<option value="">Select franchise...</option>' + list.map(w =>
            `<option value="${w.franchise_ID}">${esc(w.franchise_Name)} (${esc(w.franchise_Code)}) — ${money(w.walletBalance)}</option>`).join(''));
        $('#tuFranchise').val(id && list.some(w => w.franchise_ID === id) ? String(id) : '');
        $('#tuAmount, #tuRef, #tuNarration').val(''); $('#tuMode').val(''); $('#tuRefReq').addClass('d-none');
        $('#tuError').addClass('d-none').text('');
        preview();
        bootstrap.Modal.getOrCreateInstance(document.getElementById('topUpModal')).show();
    }
    function selectedFranchise() { const id = parseInt($('#tuFranchise').val()); return eligible().find(w => w.franchise_ID === id); }
    function preview() {
        const w = selectedFranchise(), amt = Math.max(0, parseFloat($('#tuAmount').val()) || 0), bal = w ? w.walletBalance : 0;
        $('#pvBefore').text(money(bal)); $('#pvAmount').text('+ ' + money(amt)); $('#pvAfter').text(money(bal + amt));
    }
    function methodNeedsRef() { const m = METHODS.find(x => x.id === parseInt($('#tuMode').val())); return !!(m && m.needsRef); }
    function validate() {
        const w = selectedFranchise(), raw = $('#tuAmount').val(), amt = parseFloat(raw);
        if (!w) return 'Select the franchise to top up.';
        if (!raw || isNaN(amt) || amt <= 0) return 'Enter a top-up amount greater than zero.';
        if (amt > MAX_AMOUNT) return 'Top-up amount cannot be more than ₹99,99,999.99 in one receipt.';
        if (Math.round(amt * 100) / 100 !== amt) return 'Top-up amount can have at most two decimals.';
        if (!$('#tuMode').val()) return 'Select the payment mode.';
        if (methodNeedsRef() && !$('#tuRef').val().trim()) return 'Enter the reference / UTR / cheque number for this payment mode.';
        return null;
    }
    async function submitTopUp(e) {
        e.preventDefault();
        if (saving) return;
        const err = validate();
        if (err) { $('#tuError').text(err).removeClass('d-none'); return; }
        $('#tuError').addClass('d-none');
        const w = selectedFranchise(), amt = parseFloat($('#tuAmount').val()), mode = $('#tuMode option:selected').text();
        const ok = await Swal.fire({ icon: 'question', title: 'Confirm top-up',
            html: `<div class="text-start fs-6">Add <b>${money(amt)}</b> to the wallet of <b>${esc(w.franchise_Name)}</b><br>Payment mode: <b>${esc(mode)}</b>${$('#tuRef').val().trim() ? `<br>Reference: <b>${esc($('#tuRef').val().trim())}</b>` : ''}<br>Balance after top-up: <b>${money(w.walletBalance + amt)}</b></div>`,
            showCancelButton: true, confirmButtonText: 'Yes, top up', cancelButtonText: 'Go back', confirmButtonColor: '#0f766e', focusCancel: true });
        if (!ok.isConfirmed) return;

        saving = true;
        const $b = $('#btnSaveTopUp').prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-1"></span>Saving...');
        $.ajax({ url: URLS.topUp, type: 'POST', contentType: 'application/json', headers: { 'RequestVerificationToken': token() },
                 data: JSON.stringify({ franchiseId: w.franchise_ID, amount: amt, paymentMethodId: parseInt($('#tuMode').val()),
                                        transactionRef: $('#tuRef').val().trim(), narration: $('#tuNarration').val().trim(),
                                        expectedBalance: w.walletBalance }) })
            .done(res => {
                if (!res || !res.success) { $('#tuError').text(res?.message || 'Wallet top-up failed.').removeClass('d-none'); return; }
                bootstrap.Modal.getInstance(document.getElementById('topUpModal'))?.hide();
                Swal.fire({ icon: 'success', title: 'Wallet topped up',
                    html: `<div class="fs-6">${money(amt)} added to <b>${esc(w.franchise_Name)}</b><br>Receipt <b class="font-monospace">${esc(res.receiptNo)}</b><br>New balance: <b>${money(res.newBalance)}</b></div>`,
                    showCancelButton: CAN.print, confirmButtonText: CAN.print ? '<i class="bi bi-printer me-1"></i>Print receipt' : 'OK',
                    cancelButtonText: 'Close', confirmButtonColor: '#0f766e' })
                    .then(r => { if (r.isConfirmed && CAN.print) window.open(`${URLS.receipt}?receiptNo=${encodeURIComponent(res.receiptNo)}`, '_blank', 'noopener'); });
                load();
            })
            .fail(xhr => $('#tuError').text(xhr.status === 403 ? 'You do not have permission to top up a franchise wallet.'
                                         : xhr.status === 400 ? 'The page has expired. Reload it and try again.' : 'Server error. The top-up was not saved; please try again.').removeClass('d-none'))
            .always(() => { saving = false; $b.prop('disabled', false).html('<i class="bi bi-check2-circle me-1"></i>Top Up Wallet'); });
    }

    // ── export ──
    async function exportExcel() {
        const $b = $('#btnExport'), html = $b.html();
        $b.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-1"></span>Excel');
        try {
            const res = await fetch(URLS.exportXl + '?' + new URLSearchParams(filters()).toString(), { credentials: 'same-origin' });
            const type = res.headers.get('content-type') || '';
            if (!res.ok || type.includes('json') || type.includes('text/html')) {
                let msg = res.status === 403 ? 'You do not have permission to export.' : 'Unable to export. Please try again.';
                if (type.includes('json')) { try { msg = (await res.json()).message || msg; } catch { } }
                $('#stateError').text(msg).removeClass('d-none'); return;
            }
            const cd = res.headers.get('content-disposition') || '';
            const m = /filename\*=UTF-8''([^;]+)|filename="?([^";]+)"?/i.exec(cd);
            const url = URL.createObjectURL(await res.blob());
            const a = document.createElement('a'); a.href = url; a.download = m ? decodeURIComponent(m[1] || m[2]) : 'Franchise_TopUps.xlsx';
            document.body.appendChild(a); a.click(); a.remove(); setTimeout(() => URL.revokeObjectURL(url), 10000);
        } catch { $('#stateError').text('Server error while exporting. Please try again.').removeClass('d-none'); }
        finally { $b.prop('disabled', false).html(html); }
    }

    // ── events ──
    $('.btn-quick').on('click', function () { setRange($(this).data('range')); load(); });
    $('#txtFrom, #txtTo').on('change', () => { $('.btn-quick').removeClass('active'); load(); });
    $('#selFranchise, #selMode').on('change', load);
    $('#btnApply').on('click', load);
    $('#txtSearch').on('keydown', e => { if (e.key === 'Enter') load(); });
    $('#btnReset').on('click', () => { $('#selFranchise, #selMode').val(''); $('#txtSearch').val(''); setRange('month'); load(); });
    $('#chkPrepaidOnly').on('change', () => data && renderWallets());
    $('#walletList').on('click', '.btn-statement', function () { openStatement(parseInt($(this).data('id'))); });
    $('#walletList').on('click', '.btn-wallet-topup', function () { openTopUp(parseInt($(this).data('id'))); });
    $('#btnNewTopUp').on('click', () => openTopUp(parseInt($('#selFranchise').val()) || null));
    $('#btnExport').on('click', exportExcel);
    $('#tuFranchise, #tuAmount').on('change input', preview);
    $('.quick-amt').on('click', '[data-amt]', function () {
        const cur = parseFloat($('#tuAmount').val()) || 0;
        $('#tuAmount').val((cur + Number($(this).data('amt'))).toFixed(2)); preview();
    });
    $('#tuMode').on('change', () => $('#tuRefReq').toggleClass('d-none', !methodNeedsRef()));
    $('#frmTopUp').on('submit', submitTopUp);

    setRange('month');
    load();
})();
</script>
}
