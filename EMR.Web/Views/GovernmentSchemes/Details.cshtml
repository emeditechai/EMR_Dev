@model EMR.Web.Models.ViewModels.GovernmentSchemeListItemViewModel
@{
    ViewData["Title"] = "Government Scheme Details";
    var rule = Model.ParsedRuleConfig;
    var typeBadgeClass = Model.SchemeType switch
    {
        "Central Government" => "bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25",
        "State Government" => "bg-success bg-opacity-10 text-success border border-success border-opacity-25",
        "Defence / Ex-Servicemen" => "bg-warning bg-opacity-10 text-dark border border-warning border-opacity-25",
        "PSU / Autonomous Body" => "bg-purple bg-opacity-10 text-purple border border-purple border-opacity-25",
        "Social Security / Labour" => "bg-info bg-opacity-10 text-dark border border-info border-opacity-25",
        _ => "bg-secondary bg-opacity-10 text-dark border"
    };
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h1 class="h3 mb-0 fw-bold">@Model.SchemeName</h1>
        <small class="text-muted">Scheme Code: <span class="font-monospace fw-bold">@Model.SchemeCode</span> | Nodal Authority: <span class="fw-semibold text-dark">@Model.AuthorityName</span></small>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Scheme_ID" class="btn btn-primary btn-sm px-3 shadow-sm">
            <i class="bi bi-pencil me-1"></i> Edit Scheme
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm px-3">
            <i class="bi bi-arrow-left me-1"></i> Back to List
        </a>
    </div>
</div>

<div class="row g-4">
    <!-- Left Column: Primary Details & Scheme Rules -->
    <div class="col-lg-8">
        <!-- Overview Card -->
        <div class="card border-0 shadow-sm rounded-3 mb-4">
            <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
                <h6 class="mb-0 fw-bold text-primary"><i class="bi bi-bank2 me-2"></i>Scheme Classification & Nodal Authority</h6>
                <div>
                    @if (Model.IsActive)
                    {
                        <span class="badge text-bg-success px-3 py-2">Active</span>
                    }
                    else
                    {
                        <span class="badge text-bg-secondary px-3 py-2">Inactive</span>
                    }
                </div>
            </div>
            <div class="card-body p-4">
                <div class="row g-3">
                    <div class="col-sm-6">
                        <label class="text-muted small fw-semibold">Scheme Code</label>
                        <div>
                            <span class="badge bg-light text-dark border font-monospace fs-6">
                                @Model.SchemeCode
                            </span>
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <label class="text-muted small fw-semibold">Scheme Type / Jurisdiction</label>
                        <div>
                            <span class="badge @typeBadgeClass fs-6 px-3 py-1">
                                @Model.SchemeType
                            </span>
                        </div>
                    </div>
                    <div class="col-12">
                        <label class="text-muted small fw-semibold">Full Scheme Name</label>
                        <div class="fs-5 fw-bold text-dark">@Model.SchemeName</div>
                    </div>
                    <div class="col-12">
                        <label class="text-muted small fw-semibold">Nodal Authority / Implementing Ministry</label>
                        <div class="fw-semibold text-dark"><i class="bi bi-building me-1 text-muted"></i>@Model.AuthorityName</div>
                    </div>
                    <div class="col-sm-6">
                        <label class="text-muted small fw-semibold">Scoped Branch</label>
                        <div class="fw-semibold text-dark">@(Model.BranchName ?? $"Branch #{Model.Branch_ID}") (@(Model.BranchCode ?? "—"))</div>
                    </div>
                    <div class="col-sm-6">
                        <label class="text-muted small fw-semibold">Validity Period</label>
                        <div class="fw-semibold text-dark">
                            @Model.Effective_From.ToString("dd MMM yyyy") to @Model.Effective_To.ToString("dd MMM yyyy")
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Indian Government Health Scheme Rule Configuration Card -->
        <div class="card border-0 shadow-sm rounded-3 mb-4">
            <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
                <h6 class="mb-0 fw-bold text-primary"><i class="bi bi-sliders me-2"></i>Indian Government Standard Rule Configuration</h6>
                @if (!string.IsNullOrWhiteSpace(rule?.TMSPortalUrl))
                {
                    <a href="@rule.TMSPortalUrl" target="_blank" class="btn btn-sm btn-outline-primary py-1 px-3">
                        <i class="bi bi-box-arrow-up-right me-1"></i>Open TMS Portal
                    </a>
                }
            </div>
            <div class="card-body p-4">
                <div class="row g-3">
                    <div class="col-sm-6">
                        <div class="p-3 bg-light rounded-3 border">
                            <label class="text-muted small fw-semibold d-block">Annual Family Sum Insured</label>
                            <div class="fs-4 fw-bold text-success">
                                @if (rule is not null && rule.AnnualCoverageLimit > 0)
                                {
                                    <span>₹@rule.AnnualCoverageLimit.ToString("N0")</span>
                                }
                                else
                                {
                                    <span class="text-dark">As Entitled / Unlimited</span>
                                }
                            </div>
                            <small class="text-muted">Per family per annum coverage</small>
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="p-3 bg-light rounded-3 border">
                            <label class="text-muted small fw-semibold d-block">Claim Submission Deadline</label>
                            <div class="fs-4 fw-bold text-primary font-monospace">
                                @(rule?.MaxClaimSubmissionDays ?? 7) Days
                            </div>
                            <small class="text-muted">Max window from discharge date</small>
                        </div>
                    </div>

                    <div class="col-sm-6">
                        <label class="text-muted small fw-semibold">Default Bed Entitlement</label>
                        <div class="fw-bold text-dark">@(rule?.DefaultBedCategory ?? "General Ward")</div>
                    </div>
                    <div class="col-sm-6">
                        <label class="text-muted small fw-semibold">Patient Co-Pay Percentage</label>
                        <div class="fw-bold text-dark">@(rule?.CoPayPercentage ?? 0)%</div>
                    </div>

                    <div class="col-sm-6">
                        <label class="text-muted small fw-semibold">Primary Beneficiary ID Type</label>
                        <div class="fw-bold text-dark">@(rule?.BeneficiaryIdType ?? "Aadhaar / Scheme Card")</div>
                    </div>
                    <div class="col-sm-6">
                        <label class="text-muted small fw-semibold">NHA / SHA Agency Code</label>
                        <div class="font-monospace fw-bold text-muted">@(rule?.NHA_SchemeCode ?? "—")</div>
                    </div>

                    <!-- Policy Flags -->
                    <div class="col-12 border-top pt-3">
                        <div class="row g-2">
                            <div class="col-sm-4">
                                <div class="p-2 rounded border @(rule?.PreAuthMandatory == true ? "bg-danger bg-opacity-10 border-danger border-opacity-25" : "bg-light")">
                                    <i class="bi @(rule?.PreAuthMandatory == true ? "bi-lock-fill text-danger" : "bi-unlock text-muted") me-1"></i>
                                    <strong class="@(rule?.PreAuthMandatory == true ? "text-danger" : "text-muted")">
                                        @(rule?.PreAuthMandatory == true ? "Pre-Auth Mandatory" : "Direct Admission")
                                    </strong>
                                </div>
                            </div>
                            <div class="col-sm-4">
                                <div class="p-2 rounded border @(rule?.BiometricAuthRequired == true ? "bg-primary bg-opacity-10 border-primary border-opacity-25" : "bg-light")">
                                    <i class="bi @(rule?.BiometricAuthRequired == true ? "bi-fingerprint text-primary" : "bi-slash-circle text-muted") me-1"></i>
                                    <strong class="@(rule?.BiometricAuthRequired == true ? "text-primary" : "text-muted")">
                                        @(rule?.BiometricAuthRequired == true ? "Biometric Auth Required" : "No Biometric")
                                    </strong>
                                </div>
                            </div>
                            <div class="col-sm-4">
                                <div class="p-2 rounded border @(rule?.AbhaCreationMandatory == true ? "bg-success bg-opacity-10 border-success border-opacity-25" : "bg-light")">
                                    <i class="bi @(rule?.AbhaCreationMandatory == true ? "bi-check2-circle text-success" : "bi-circle text-muted") me-1"></i>
                                    <strong class="@(rule?.AbhaCreationMandatory == true ? "text-success" : "text-muted")">
                                        @(rule?.AbhaCreationMandatory == true ? "Mandatory ABHA" : "Optional ABHA")
                                    </strong>
                                </div>
                            </div>
                        </div>
                    </div>

                    @if (rule?.MandatoryDocuments != null && rule.MandatoryDocuments.Any())
                    {
                        <div class="col-12 border-top pt-3">
                            <label class="text-muted small fw-semibold d-block mb-2"><i class="bi bi-file-earmark-check me-1"></i>Mandatory Documents Checklist:</label>
                            <div class="d-flex flex-wrap gap-2">
                                @foreach (var doc in rule.MandatoryDocuments)
                                {
                                    <span class="badge bg-light text-dark border px-3 py-2">
                                        <i class="bi bi-check-circle-fill text-success me-1"></i>@doc
                                    </span>
                                }
                            </div>
                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(rule?.SpecialRemarks))
                    {
                        <div class="col-12 border-top pt-3">
                            <label class="text-muted small fw-semibold d-block">Special Guidelines / Remarks</label>
                            <div class="p-3 bg-light rounded border small">
                                @rule.SpecialRemarks
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Raw RuleConfigJSON Viewer Card -->
        <div class="card border-0 shadow-sm rounded-3 mb-4">
            <div class="card-header bg-white border-bottom py-3">
                <h6 class="mb-0 fw-bold text-muted small"><i class="bi bi-code-slash me-2"></i>RuleConfigJSON Structure</h6>
            </div>
            <div class="card-body p-3 bg-dark rounded-bottom-3">
                <pre class="text-light mb-0 small" style="max-height: 250px; overflow-y: auto;"><code>@Model.RuleConfigJSON</code></pre>
            </div>
        </div>
    </div>

    <!-- Right Column: Audit Information -->
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-header bg-white border-bottom py-3">
                <h6 class="mb-0 fw-bold text-primary"><i class="bi bi-clock-history me-2"></i>Audit Information</h6>
            </div>
            <div class="card-body p-3">
                <ul class="list-group list-group-flush small">
                    <li class="list-group-item px-0 py-2 border-0 d-flex justify-content-between">
                        <span class="text-muted">Scheme ID:</span>
                        <span class="fw-bold font-monospace">#@Model.Scheme_ID</span>
                    </li>
                    <li class="list-group-item px-0 py-2 border-0 d-flex justify-content-between">
                        <span class="text-muted">Created On:</span>
                        <span class="fw-medium">@Model.CreatedDate.ToString("dd MMM yyyy, hh:mm tt")</span>
                    </li>
                    @if (Model.ModifiedDate.HasValue)
                    {
                        <li class="list-group-item px-0 py-2 border-0 d-flex justify-content-between">
                            <span class="text-muted">Last Modified:</span>
                            <span class="fw-medium">@Model.ModifiedDate.Value.ToString("dd MMM yyyy, hh:mm tt")</span>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </div>
</div>
