@model EMR.Web.Models.ViewModels.GovernmentSchemeIndexViewModel
@{
    ViewData["Title"] = "Government Scheme Master";
    var total = Model.SchemeList.Count;
    var active = Model.SchemeList.Count(x => x.IsActive);
    var inactive = total - active;
    var centralCount = Model.SchemeList.Count(x => x.SchemeType == "Central Government");
    var stateCount = Model.SchemeList.Count(x => x.SchemeType == "State Government");
    var defenceCount = Model.SchemeList.Count(x => x.SchemeType == "Defence / Ex-Servicemen");
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h1 class="h3 mb-0 fw-bold">Government Scheme Master</h1>
        <small class="text-muted">Manage CGHS, ECHS, Ayushman Bharat PM-JAY, State Health Schemes, PSU & Social Security healthcare programs</small>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Create" class="btn btn-primary shadow-sm">
            <i class="bi bi-plus-lg me-1"></i>Add Government Scheme
        </a>
    </div>
</div>

<!-- Stat Cards -->
<div class="row g-3 mb-4">
    <div class="col-12 col-sm-6 col-lg-3">
        <div class="stat-card stat-blue">
            <div class="stat-icon"><i class="bi bi-bank2"></i></div>
            <div>
                <div class="stat-value">@total</div>
                <div class="stat-label">Total Empaneled Schemes</div>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-lg-3">
        <div class="stat-card stat-green">
            <div class="stat-icon"><i class="bi bi-flag-fill"></i></div>
            <div>
                <div class="stat-value">@centralCount <span class="fs-6 fw-normal text-muted">/ @stateCount State</span></div>
                <div class="stat-label">Central & State Schemes</div>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-lg-3">
        <div class="stat-card stat-purple">
            <div class="stat-icon"><i class="bi bi-shield-shaded"></i></div>
            <div>
                <div class="stat-value">@defenceCount</div>
                <div class="stat-label">Defence / Ex-Servicemen</div>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-lg-3">
        <div class="stat-card stat-cyan">
            <div class="stat-icon"><i class="bi bi-check-circle-fill"></i></div>
            <div>
                <div class="stat-value">@active <span class="fs-6 fw-normal text-muted">(@inactive inactive)</span></div>
                <div class="stat-label">Active Schemes</div>
            </div>
        </div>
    </div>
</div>

<!-- Filter Bar -->
<div class="card border-0 shadow-sm rounded-3 mb-4">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-auto">
                <label class="form-label mb-0 fw-semibold text-muted small"><i class="bi bi-funnel me-1"></i>Filters:</label>
            </div>
            <div class="col-md-3">
                <select name="schemeType" class="form-select form-select-sm" onchange="this.form.submit()">
                    <option value="">-- All Scheme Types --</option>
                    @foreach (var opt in Model.SchemeTypeOptions)
                    {
                        <option value="@opt.Value" selected="@opt.Selected">@opt.Text</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <select name="status" class="form-select form-select-sm" onchange="this.form.submit()">
                    <option value="">-- All Status --</option>
                    @foreach (var opt in Model.StatusOptions)
                    {
                        <option value="@opt.Value" selected="@opt.Selected">@opt.Text</option>
                    }
                </select>
            </div>
            <div class="col-md-5">
                <div class="input-group input-group-sm">
                    <input type="text" name="search" class="form-control" placeholder="Search by scheme code, name, authority..." value="@Model.SearchTerm" />
                    <button class="btn btn-outline-primary" type="submit"><i class="bi bi-search"></i> Search</button>
                </div>
            </div>
            @if (!string.IsNullOrWhiteSpace(Model.SelectedSchemeType) || Model.SelectedStatus.HasValue || !string.IsNullOrWhiteSpace(Model.SearchTerm))
            {
                <div class="col-auto">
                    <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Clear</a>
                </div>
            }
        </form>
    </div>
</div>

<!-- Data Table -->
<div class="dashboard-panel table-responsive shadow-sm border rounded-3 bg-white">
    <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
            <tr>
                <th style="width: 40px;">#</th>
                <th>Scheme Code</th>
                <th>Scheme Name</th>
                <th>Scheme Type</th>
                <th>Nodal Authority / Ministry</th>
                <th>Coverage Limit</th>
                <th>Pre-Auth & Auth</th>
                <th>Validity Period</th>
                <th>Status</th>
                <th class="text-end" style="width: 150px;">Actions</th>
            </tr>
        </thead>
        <tbody>
            @{int i = 1;}
            @foreach (var item in Model.SchemeList)
            {
                var rule = item.ParsedRuleConfig;
                var typeBadgeClass = item.SchemeType switch
                {
                    "Central Government" => "bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25",
                    "State Government" => "bg-success bg-opacity-10 text-success border border-success border-opacity-25",
                    "Defence / Ex-Servicemen" => "bg-warning bg-opacity-10 text-dark border border-warning border-opacity-25",
                    "PSU / Autonomous Body" => "bg-purple bg-opacity-10 text-purple border border-purple border-opacity-25",
                    "Social Security / Labour" => "bg-info bg-opacity-10 text-dark border border-info border-opacity-25",
                    _ => "bg-secondary bg-opacity-10 text-dark border"
                };

                <tr>
                    <td class="text-muted small">@(i++)</td>
                    <td>
                        <span class="badge bg-light text-dark border font-monospace fw-bold">
                            @item.SchemeCode
                        </span>
                    </td>
                    <td>
                        <div class="fw-semibold text-dark">
                            @item.SchemeName
                        </div>
                        @if (!string.IsNullOrWhiteSpace(rule?.NHA_SchemeCode))
                        {
                            <small class="text-muted d-block">
                                <i class="bi bi-tag me-1"></i>NHA Tag: <span class="font-monospace">@rule.NHA_SchemeCode</span>
                            </small>
                        }
                    </td>
                    <td>
                        <span class="badge @typeBadgeClass">
                            @item.SchemeType
                        </span>
                    </td>
                    <td>
                        <div class="small fw-semibold text-dark">
                            @item.AuthorityName
                        </div>
                        @if (!string.IsNullOrWhiteSpace(rule?.TMSPortalUrl))
                        {
                            <a href="@rule.TMSPortalUrl" target="_blank" class="extra-small text-decoration-none text-muted" title="Open TMS / Portal">
                                <i class="bi bi-box-arrow-up-right me-1"></i>TMS Portal
                            </a>
                        }
                    </td>
                    <td>
                        @if (rule is not null && rule.AnnualCoverageLimit > 0)
                        {
                            <span class="fw-bold text-success">₹@rule.AnnualCoverageLimit.ToString("N0")</span>
                            <small class="text-muted d-block extra-small">per family / yr</small>
                        }
                        else
                        {
                            <span class="badge bg-light text-dark border">Comprehensive / As Entitled</span>
                        }
                    </td>
                    <td>
                        <div class="d-flex flex-column gap-1">
                            @if (rule?.PreAuthMandatory == true)
                            {
                                <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 extra-small">
                                    <i class="bi bi-lock-fill me-1"></i>Pre-Auth Mandatory
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-light text-muted border extra-small">
                                    Direct Billing
                                </span>
                            }
                            @if (rule?.BiometricAuthRequired == true)
                            {
                                <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 extra-small">
                                    <i class="bi bi-fingerprint me-1"></i>Biometric / ABHA
                                </span>
                            }
                        </div>
                    </td>
                    <td>
                        <div class="small">
                            <span class="text-dark">@item.Effective_From.ToString("dd MMM yyyy")</span>
                            <span class="text-muted"> to </span>
                            <span class="@(item.Effective_To < DateTime.Today ? "text-danger fw-bold" : "text-dark")">@item.Effective_To.ToString("dd MMM yyyy")</span>
                        </div>
                    </td>
                    <td>
                        @if (item.IsActive)
                        {
                            <span class="badge text-bg-success">Active</span>
                        }
                        else
                        {
                            <span class="badge text-bg-secondary">Inactive</span>
                        }
                    </td>
                    <td class="text-end">
                        <a asp-action="Details" asp-route-id="@item.Scheme_ID"
                           class="btn btn-sm btn-outline-secondary me-1" title="View Details">
                            <i class="bi bi-eye"></i>
                        </a>
                        <a asp-action="Edit" asp-route-id="@item.Scheme_ID"
                           class="btn btn-sm btn-outline-primary me-1" title="Edit">
                            <i class="bi bi-pencil"></i>
                        </a>
                        <form asp-action="Delete" asp-route-id="@item.Scheme_ID" method="post" class="d-inline"
                              onsubmit="return confirm('Are you sure you want to delete @item.SchemeName?');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete">
                                <i class="bi bi-trash"></i>
                            </button>
                        </form>
                    </td>
                </tr>
            }
            @if (!Model.SchemeList.Any())
            {
                <tr>
                    <td colspan="10" class="text-center text-muted py-5">
                        <i class="bi bi-bank2 fs-1 d-block mb-2 opacity-50"></i>
                        No Government Schemes found. <a asp-action="Create" class="fw-bold">Add your first Government Scheme.</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@section Scripts {
    <style>
        .extra-small { font-size: 0.72rem; }
    </style>
}
