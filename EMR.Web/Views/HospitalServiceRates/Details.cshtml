@model EMR.Web.Models.Entities.HospitalServiceRateMaster
@{
    ViewData["Title"] = "Hospital Service Rate Details";
}

<div class="row justify-content-center">
    <div class="col-12 col-lg-8">
        <nav aria-label="breadcrumb" class="mb-3">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-action="Index">Hospital Service Rate Master</a></li>
                <li class="breadcrumb-item active" aria-current="page">Rate Details</li>
            </ol>
        </nav>

        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                <h5 class="card-title mb-0 fw-bold"><i class="bi bi-info-circle me-2 text-primary"></i>Service Rate Details</h5>
                <div>
                    @if (Model.IsActive)
                    {
                        <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2">Active</span>
                    }
                    else
                    {
                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-3 py-2">Inactive</span>
                    }
                </div>
            </div>
            <div class="card-body p-4">
                <div class="row g-4">
                    <div class="col-sm-6">
                        <label class="text-muted small d-block">Tariff Category</label>
                        <span class="fs-5 fw-bold text-primary">@(Model.TariffCategory?.Name ?? "N/A")</span>
                        @if (!string.IsNullOrWhiteSpace(Model.TariffCategory?.PatientCategory))
                        {
                            <small class="text-muted d-block">@Model.TariffCategory.PatientCategory</small>
                        }
                    </div>

                    <div class="col-sm-6">
                        <label class="text-muted small d-block">Hospital Service</label>
                        <span class="fs-5 fw-semibold">@(Model.HospitalService?.ServiceName ?? "N/A")</span>
                        <small class="font-monospace text-muted d-block">@(Model.HospitalService?.ServiceCode)</small>
                    </div>

                    <div class="col-sm-6">
                        <label class="text-muted small d-block">Service Type & Department</label>
                        <span class="badge bg-info-subtle text-info-emphasis border">@(Model.HospitalService?.ServiceType)</span>
                        <span class="badge bg-secondary-subtle text-secondary border ms-1">@(Model.HospitalService?.Department?.DeptName)</span>
                    </div>

                    <div class="col-sm-6">
                        <label class="text-muted small d-block">Rate (Amount)</label>
                        <span class="fs-4 fw-bold text-success">@Model.Rate.ToString("C2")</span>
                        <span class="badge bg-light text-dark border ms-1">@Model.HospitalService?.UOM</span>
                    </div>

                    <div class="col-sm-6">
                        <label class="text-muted small d-block">Effective From</label>
                        <span class="fw-medium">@Model.EffectiveFrom.ToString("dd MMM yyyy")</span>
                    </div>

                    <div class="col-sm-6">
                        <label class="text-muted small d-block">Effective To</label>
                        <span class="fw-medium">@(Model.EffectiveTo.HasValue ? Model.EffectiveTo.Value.ToString("dd MMM yyyy") : "Ongoing")</span>
                    </div>

                    <div class="col-12">
                        <label class="text-muted small d-block">Description / Remarks</label>
                        <p class="mb-0 text-secondary">@(string.IsNullOrWhiteSpace(Model.Description) ? "No description provided." : Model.Description)</p>
                    </div>

                    <div class="col-sm-6">
                        <label class="text-muted small d-block">Branch</label>
                        <span class="text-muted">@(Model.Branch?.BranchName ?? "Current Branch")</span>
                    </div>

                    <div class="col-sm-6">
                        <label class="text-muted small d-block">Created Date</label>
                        <span class="text-muted">@Model.CreatedDate.ToString("dd MMM yyyy, hh:mm tt")</span>
                    </div>
                </div>

                <div class="d-flex justify-content-between gap-2 mt-4 pt-3 border-top">
                    <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Back to List</a>
                    <a asp-action="Edit" asp-route-id="@Model.ServiceRateId" class="btn btn-primary">
                        <i class="bi bi-pencil me-1"></i>Edit Rate
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
