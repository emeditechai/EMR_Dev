@model EMR.Web.Models.ViewModels.HospitalServiceRateFormViewModel
@{
    ViewData["Title"] = "Edit Hospital Service Rate";
}

<div class="row justify-content-center">
    <div class="col-12 col-lg-8">
        <nav aria-label="breadcrumb" class="mb-3">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-action="Index">Hospital Service Rate Master</a></li>
                <li class="breadcrumb-item active" aria-current="page">Edit Rate</li>
            </ol>
        </nav>

        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-header bg-white py-3 border-bottom">
                <h5 class="card-title mb-0 fw-bold"><i class="bi bi-pencil-square me-2 text-primary"></i>Edit Hospital Service Rate</h5>
            </div>
            <div class="card-body p-4">
                <form asp-action="Edit" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="ServiceRateId" />
                    <input type="hidden" asp-for="CompanyId" />
                    <input type="hidden" asp-for="BranchId" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3" role="alert"></div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="TariffCategoryId" class="form-label fw-semibold"></label> <span class="text-danger">*</span>
                            <select asp-for="TariffCategoryId" asp-items="Model.TariffCategoryOptions" class="form-select">
                                <option value="">-- Select Tariff Category --</option>
                            </select>
                            <span asp-validation-for="TariffCategoryId" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="HospitalServiceId" class="form-label fw-semibold"></label> <span class="text-danger">*</span>
                            <select asp-for="HospitalServiceId" asp-items="Model.HospitalServiceOptions" class="form-select">
                                <option value="">-- Select Hospital Service --</option>
                            </select>
                            <span asp-validation-for="HospitalServiceId" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="Rate" class="form-label fw-semibold"></label> <span class="text-danger">*</span>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-currency-rupee"></i></span>
                                <input asp-for="Rate" class="form-control" type="number" step="0.01" min="0" />
                            </div>
                            <span asp-validation-for="Rate" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="EffectiveFrom" class="form-label fw-semibold"></label> <span class="text-danger">*</span>
                            <input asp-for="EffectiveFrom" class="form-control" type="date" />
                            <span asp-validation-for="EffectiveFrom" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="EffectiveTo" class="form-label fw-semibold"></label>
                            <input asp-for="EffectiveTo" class="form-control" type="date" />
                            <span asp-validation-for="EffectiveTo" class="text-danger small"></span>
                            <small class="text-muted d-block mt-1">Leave empty for ongoing rate</small>
                        </div>

                        <div class="col-12">
                            <label asp-for="Description" class="form-label fw-semibold"></label>
                            <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <div class="form-check form-switch mt-2">
                                <input asp-for="IsActive" class="form-check-input" type="checkbox" role="switch" id="isActiveSwitch" />
                                <label class="form-check-label fw-semibold" for="isActiveSwitch">Active Status</label>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-primary px-4"><i class="bi bi-check-lg me-1"></i>Update Service Rate</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
