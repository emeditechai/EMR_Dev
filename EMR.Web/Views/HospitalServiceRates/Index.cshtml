@model IEnumerable<EMR.Web.Models.ViewModels.HospitalServiceRateListItemViewModel>
@{
    ViewData["Title"] = "Hospital Service Rate Master";
    var total = Model.Count();
    var active = Model.Count(x => x.IsActive);
    var inactive = total - active;
    var totalTariffCategories = Model.Select(x => x.TariffCategoryId).Distinct().Count();
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h1 class="h3 mb-0 fw-bold">Hospital Service Rate Master</h1>
        <small class="text-muted">Configure service tariffs by Branch &rarr; Tariff Category &rarr; Hospital Service &rarr; Effective Date &rarr; Rate</small>
    </div>
    <div class="d-flex gap-2">
        <a asp-controller="HospitalServices" asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-gear-wide-connected me-1"></i>Hospital Services
        </a>
        <a asp-action="Create" asp-route-tariffCategoryId="@ViewBag.TariffCategoryId" asp-route-hospitalServiceId="@ViewBag.HospitalServiceId" class="btn btn-primary shadow-sm">
            <i class="bi bi-plus-lg me-1"></i>Add Service Rate
        </a>
    </div>
</div>

<!-- Stat Cards -->
<div class="row g-3 mb-4">
    <div class="col-12 col-sm-6 col-lg-3">
        <div class="stat-card stat-blue">
            <div class="stat-icon"><i class="bi bi-cash-coin"></i></div>
            <div>
                <div class="stat-value">@total</div>
                <div class="stat-label">Total Rates Configured</div>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-lg-3">
        <div class="stat-card stat-green">
            <div class="stat-icon"><i class="bi bi-check-circle-fill"></i></div>
            <div>
                <div class="stat-value">@active</div>
                <div class="stat-label">Active Rates</div>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-lg-3">
        <div class="stat-card stat-red">
            <div class="stat-icon"><i class="bi bi-x-circle-fill"></i></div>
            <div>
                <div class="stat-value">@inactive</div>
                <div class="stat-label">Inactive</div>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-lg-3">
        <div class="stat-card stat-cyan">
            <div class="stat-icon"><i class="bi bi-tags-fill"></i></div>
            <div>
                <div class="stat-value">@totalTariffCategories</div>
                <div class="stat-label">Tariff Categories</div>
            </div>
        </div>
    </div>
</div>

<!-- Filter Bar -->
<div class="card border-0 shadow-sm rounded-3 mb-4">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-auto">
                <label class="form-label mb-0 fw-semibold text-muted small"><i class="bi bi-funnel me-1"></i>Filters:</label>
            </div>
            <div class="col-md-4">
                <select name="tariffCategoryId" class="form-select form-select-sm" onchange="this.form.submit()">
                    <option value="">-- All Tariff Categories --</option>
                    @if (ViewBag.TariffCategoryOptions != null)
                    {
                        foreach (var opt in (IEnumerable<SelectListItem>)ViewBag.TariffCategoryOptions)
                        {
                            <option value="@opt.Value" selected="@(opt.Value == (ViewBag.TariffCategoryId?.ToString()))">@opt.Text</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-4">
                <select name="hospitalServiceId" class="form-select form-select-sm" onchange="this.form.submit()">
                    <option value="">-- All Hospital Services --</option>
                    @if (ViewBag.HospitalServiceOptions != null)
                    {
                        foreach (var opt in (IEnumerable<SelectListItem>)ViewBag.HospitalServiceOptions)
                        {
                            <option value="@opt.Value" selected="@(opt.Value == (ViewBag.HospitalServiceId?.ToString()))">@opt.Text</option>
                        }
                    }
                </select>
            </div>
            @if (ViewBag.TariffCategoryId != null || ViewBag.HospitalServiceId != null)
            {
                <div class="col-auto">
                    <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Reset</a>
                </div>
            }
        </form>
    </div>
</div>

<!-- Data Table -->
<div class="card border-0 shadow-sm rounded-3">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" id="hospitalServiceRatesTable">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Tariff Category</th>
                        <th>Hospital Service</th>
                        <th>Department / Type</th>
                        <th>UOM</th>
                        <th class="text-end">Rate</th>
                        <th>Effective From</th>
                        <th>Effective To</th>
                        <th>Status</th>
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="9" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                                No service rates found. Click "Add Service Rate" to configure one.
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="fw-bold">@item.TariffCategoryName</div>
                                    @if (!string.IsNullOrWhiteSpace(item.PatientCategory))
                                    {
                                        <small class="text-muted">@item.PatientCategory</small>
                                    }
                                </td>
                                <td>
                                    <div class="fw-semibold">@item.ServiceName</div>
                                    <small class="font-monospace text-primary">@item.ServiceCode</small>
                                </td>
                                <td>
                                    <span class="badge bg-secondary-subtle text-secondary border">@item.DepartmentName</span>
                                    <span class="badge bg-info-subtle text-info-emphasis border ms-1">@item.ServiceType</span>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border">@item.UOM</span>
                                </td>
                                <td class="text-end">
                                    <span class="fw-bold fs-6 text-success">@item.Rate.ToString("C2")</span>
                                    @if (item.TaxPercentage > 0)
                                    {
                                        <small class="text-muted d-block">+@item.TaxPercentage:0.##% Tax</small>
                                    }
                                </td>
                                <td>
                                    @item.EffectiveFrom.ToString("dd MMM yyyy")
                                </td>
                                <td>
                                    @(item.EffectiveTo.HasValue ? item.EffectiveTo.Value.ToString("dd MMM yyyy") : "Active / Ongoing")
                                </td>
                                <td>
                                    @if (item.IsActive)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle">Inactive</span>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Details" asp-route-id="@item.ServiceRateId" class="btn btn-outline-info" title="View Details">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@item.ServiceRateId" class="btn btn-outline-primary" title="Edit Rate">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <form asp-action="ToggleStatus" asp-route-id="@item.ServiceRateId" method="post" class="d-inline" onsubmit="return confirm('Toggle status for this rate?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn @(item.IsActive ? "btn-outline-warning" : "btn-outline-success")" title="@(item.IsActive ? "Deactivate" : "Activate")">
                                                <i class="bi @(item.IsActive ? "bi-slash-circle" : "bi-check2-circle")"></i>
                                            </button>
                                        </form>
                                        <form asp-action="Delete" asp-route-id="@item.ServiceRateId" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this rate configuration?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-danger" title="Delete">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
