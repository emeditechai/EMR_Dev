@model EMR.Web.Models.ViewModels.HospitalServiceFormViewModel
@{
    ViewData["Title"] = "Add Hospital Service";
}

<div class="row justify-content-center">
    <div class="col-12 col-lg-8">
        <nav aria-label="breadcrumb" class="mb-3">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-action="Index">Hospital Service Master</a></li>
                <li class="breadcrumb-item active" aria-current="page">Add Service</li>
            </ol>
        </nav>

        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-header bg-white py-3 border-bottom">
                <h5 class="card-title mb-0 fw-bold"><i class="bi bi-plus-circle me-2 text-primary"></i>Add Hospital Service</h5>
            </div>
            <div class="card-body p-4">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3" role="alert"></div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="DepartmentId" class="form-label fw-semibold"></label> <span class="text-danger">*</span>
                            <select asp-for="DepartmentId" asp-items="Model.DepartmentOptions" class="form-select">
                                <option value="">-- Select IPD Department --</option>
                            </select>
                            <span asp-validation-for="DepartmentId" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="ServiceType" class="form-label fw-semibold"></label> <span class="text-danger">*</span>
                            <select asp-for="ServiceType" asp-items="Model.ServiceTypeOptions" class="form-select">
                                <option value="">-- Select Service Type --</option>
                            </select>
                            <span asp-validation-for="ServiceType" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="ServiceCode" class="form-label fw-semibold"></label> <span class="text-danger">*</span>
                            <input asp-for="ServiceCode" class="form-control font-monospace" placeholder="e.g. NUR-001, ICU-VENT, OT-GAS" />
                            <span asp-validation-for="ServiceCode" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="ServiceName" class="form-label fw-semibold"></label> <span class="text-danger">*</span>
                            <input asp-for="ServiceName" class="form-control" placeholder="e.g. Nursing Care Charges, Ventilator Support" />
                            <span asp-validation-for="ServiceName" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="UOM" class="form-label fw-semibold"></label> <span class="text-danger">*</span>
                            <select asp-for="UOM" asp-items="Model.UomOptions" class="form-select">
                                <option value="">-- Select UOM --</option>
                            </select>
                            <span asp-validation-for="UOM" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="TaxPercentage" class="form-label fw-semibold"></label>
                            <div class="input-group">
                                <input asp-for="TaxPercentage" class="form-control" type="number" step="0.01" min="0" max="100" placeholder="0.00" />
                                <span class="input-group-text">%</span>
                            </div>
                            <span asp-validation-for="TaxPercentage" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Description" class="form-label fw-semibold"></label>
                            <textarea asp-for="Description" class="form-control" rows="3" placeholder="Optional service notes or specifications..."></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <div class="form-check form-switch mt-2">
                                <input asp-for="IsActive" class="form-check-input" type="checkbox" role="switch" id="isActiveSwitch" checked />
                                <label class="form-check-label fw-semibold" for="isActiveSwitch">Active Status</label>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-primary px-4"><i class="bi bi-check-lg me-1"></i>Save Hospital Service</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
