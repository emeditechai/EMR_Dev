@model EMR.Web.Models.ViewModels.HospitalServiceDetailsViewModel
@{
    ViewData["Title"] = "Hospital Service Details";
    var service = Model.Service;
    var rates = Model.Rates;
}

<div class="row justify-content-center">
    <div class="col-12 col-lg-9">
        <nav aria-label="breadcrumb" class="mb-3">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-action="Index">Hospital Service Master</a></li>
                <li class="breadcrumb-item active" aria-current="page">Service Details</li>
            </ol>
        </nav>

        <!-- Service Details Card -->
        <div class="card border-0 shadow-sm rounded-3 mb-4">
            <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                <h5 class="card-title mb-0 fw-bold"><i class="bi bi-info-circle me-2 text-primary"></i>Service Details</h5>
                <div>
                    @if (service.IsActive)
                    {
                        <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2">Active</span>
                    }
                    else
                    {
                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-3 py-2">Inactive</span>
                    }
                </div>
            </div>
            <div class="card-body p-4">
                <div class="row g-4">
                    <div class="col-sm-6">
                        <label class="text-muted small d-block">Service Code</label>
                        <span class="font-monospace fs-5 fw-bold text-primary">@service.ServiceCode</span>
                    </div>
                    <div class="col-sm-6">
                        <label class="text-muted small d-block">Service Name</label>
                        <span class="fs-5 fw-semibold">@service.ServiceName</span>
                    </div>

                    <div class="col-sm-6">
                        <label class="text-muted small d-block">IPD Department</label>
                        <span class="fw-medium">@(service.Department?.DeptName ?? "N/A")</span>
                    </div>
                    <div class="col-sm-6">
                        <label class="text-muted small d-block">Service Type</label>
                        <span class="badge bg-info-subtle text-info-emphasis border fs-6">@service.ServiceType</span>
                    </div>

                    <div class="col-sm-6">
                        <label class="text-muted small d-block">Unit of Measurement (UOM)</label>
                        <span class="fw-medium">@service.UOM</span>
                    </div>
                    <div class="col-sm-6">
                        <label class="text-muted small d-block">Tax Percentage</label>
                        <span class="fw-medium">@(service.TaxPercentage > 0 ? $"{service.TaxPercentage:0.##}%" : "0%")</span>
                    </div>

                    <div class="col-12">
                        <label class="text-muted small d-block">Description / Remarks</label>
                        <p class="mb-0 text-secondary">@(string.IsNullOrWhiteSpace(service.Description) ? "No description provided." : service.Description)</p>
                    </div>

                    <div class="col-sm-6">
                        <label class="text-muted small d-block">Branch</label>
                        <span class="text-muted">@(service.Branch?.BranchName ?? "Current Branch")</span>
                    </div>
                    <div class="col-sm-6">
                        <label class="text-muted small d-block">Created Date</label>
                        <span class="text-muted">@service.CreatedDate.ToString("dd MMM yyyy, hh:mm tt")</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Configured Rates Card -->
        <div class="card border-0 shadow-sm rounded-3 mb-4">
            <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                <h6 class="card-title mb-0 fw-bold @(Model.HasConfiguredRates ? "text-success" : "text-secondary")">
                    <i class="bi bi-cash-coin me-2"></i>Configured Rates & Tariffs
                    @if (Model.HasConfiguredRates)
                    {
                        <span class="badge bg-success-subtle text-success border border-success-subtle ms-2">@rates.Count Configured</span>
                    }
                </h6>
            </div>
            <div class="card-body p-0">
                @if (Model.HasConfiguredRates)
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-4">Tariff Category</th>
                                    <th>Rate (Amount)</th>
                                    <th>Effective From</th>
                                    <th>Effective To</th>
                                    <th>Status</th>
                                    <th class="text-end pe-4">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var rate in rates)
                                {
                                    <tr>
                                        <td class="ps-4">
                                            <div class="fw-bold">@(rate.TariffCategory?.Name ?? "General")</div>
                                            @if (!string.IsNullOrWhiteSpace(rate.TariffCategory?.PatientCategory))
                                            {
                                                <small class="text-muted">@rate.TariffCategory.PatientCategory</small>
                                            }
                                        </td>
                                        <td>
                                            <span class="fs-6 fw-bold text-success">@rate.Rate.ToString("C2")</span>
                                            <span class="badge bg-light text-dark border ms-1">@service.UOM</span>
                                            @if (service.TaxPercentage > 0)
                                            {
                                                <small class="text-muted d-block">+@service.TaxPercentage:0.##% Tax</small>
                                            }
                                        </td>
                                        <td>
                                            @rate.EffectiveFrom.ToString("dd MMM yyyy")
                                        </td>
                                        <td>
                                            @(rate.EffectiveTo.HasValue ? rate.EffectiveTo.Value.ToString("dd MMM yyyy") : "Ongoing")
                                        </td>
                                        <td>
                                            @if (rate.IsActive)
                                            {
                                                <span class="badge bg-success-subtle text-success border border-success-subtle">Active</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger-subtle text-danger border border-danger-subtle">Inactive</span>
                                            }
                                        </td>
                                        <td class="text-end pe-4">
                                            <div class="btn-group btn-group-sm">
                                                <a asp-controller="HospitalServiceRates" asp-action="Details" asp-route-id="@rate.ServiceRateId" class="btn btn-outline-info" title="View Rate Details">
                                                    <i class="bi bi-eye"></i>
                                                </a>
                                                <a asp-controller="HospitalServiceRates" asp-action="Edit" asp-route-id="@rate.ServiceRateId" class="btn btn-outline-primary" title="Edit Rate">
                                                    <i class="bi bi-pencil me-1"></i>Edit Rate
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="p-4 text-center text-muted">
                        <i class="bi bi-cash-coin fs-1 d-block mb-2 text-secondary"></i>
                        <p class="mb-1 fw-semibold text-secondary">No rates configured yet for this service</p>
                        <small class="text-muted d-block mb-3">Click the "Configure Rate" button below to set tariff pricing for this service.</small>
                    </div>
                }
            </div>
        </div>

        <!-- Action Footer -->
        <div class="d-flex justify-content-between align-items-center gap-2 pt-2">
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i>Back to List
            </a>
            <div class="d-flex gap-2">
                @if (!Model.HasConfiguredRates)
                {
                    <a asp-controller="HospitalServiceRates" asp-action="Create" asp-route-hospitalServiceId="@service.HospitalServiceId" class="btn btn-success">
                        <i class="bi bi-plus-lg me-1"></i>Configure Rate
                    </a>
                }
                <a asp-action="Edit" asp-route-id="@service.HospitalServiceId" class="btn btn-primary">
                    <i class="bi bi-pencil me-1"></i>Edit Service
                </a>
            </div>
        </div>
    </div>
</div>
