@model IEnumerable<EMR.Web.Models.ViewModels.HospitalServiceListItemViewModel>
@{
    ViewData["Title"] = "Hospital Service Master";
    var total = Model.Count();
    var active = Model.Count(x => x.IsActive);
    var inactive = total - active;
    var serviceTypesCount = Model.Select(x => x.ServiceType).Distinct().Count();
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h1 class="h3 mb-0 fw-bold">Hospital Service Master</h1>
        <small class="text-muted">Manage hospital-specific clinical and support services (IPD, Nursing, ICU, OT, Ambulance, Diet, etc.)</small>
    </div>
    <div class="d-flex gap-2">
        <a asp-controller="HospitalServiceRates" asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-cash-coin me-1"></i>Service Rates
        </a>
        <a asp-action="Create" asp-route-departmentId="@ViewBag.DepartmentId" asp-route-serviceType="@ViewBag.ServiceType" class="btn btn-primary shadow-sm">
            <i class="bi bi-plus-lg me-1"></i>Add Hospital Service
        </a>
    </div>
</div>

<!-- Stat Cards -->
<div class="row g-3 mb-4">
    <div class="col-12 col-sm-6 col-lg-3">
        <div class="stat-card stat-blue">
            <div class="stat-icon"><i class="bi bi-gear-wide-connected"></i></div>
            <div>
                <div class="stat-value">@total</div>
                <div class="stat-label">Total Services</div>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-lg-3">
        <div class="stat-card stat-green">
            <div class="stat-icon"><i class="bi bi-check-circle-fill"></i></div>
            <div>
                <div class="stat-value">@active</div>
                <div class="stat-label">Active Services</div>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-lg-3">
        <div class="stat-card stat-red">
            <div class="stat-icon"><i class="bi bi-x-circle-fill"></i></div>
            <div>
                <div class="stat-value">@inactive</div>
                <div class="stat-label">Inactive</div>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-lg-3">
        <div class="stat-card stat-cyan">
            <div class="stat-icon"><i class="bi bi-tags-fill"></i></div>
            <div>
                <div class="stat-value">@serviceTypesCount</div>
                <div class="stat-label">Service Types</div>
            </div>
        </div>
    </div>
</div>

<!-- Filter Bar -->
<div class="card border-0 shadow-sm rounded-3 mb-4">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-auto">
                <label class="form-label mb-0 fw-semibold text-muted small"><i class="bi bi-funnel me-1"></i>Filters:</label>
            </div>
            <div class="col-md-4">
                <select name="departmentId" class="form-select form-select-sm" onchange="this.form.submit()">
                    <option value="">-- All IPD Departments --</option>
                    @if (ViewBag.DepartmentOptions != null)
                    {
                        foreach (var opt in (IEnumerable<SelectListItem>)ViewBag.DepartmentOptions)
                        {
                            <option value="@opt.Value" selected="@(opt.Value == (ViewBag.DepartmentId?.ToString()))">@opt.Text</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-4">
                <select name="serviceType" class="form-select form-select-sm" onchange="this.form.submit()">
                    <option value="">-- All Service Types --</option>
                    @if (ViewBag.ServiceTypeOptions != null)
                    {
                        foreach (var opt in (IEnumerable<SelectListItem>)ViewBag.ServiceTypeOptions)
                        {
                            <option value="@opt.Value" selected="@(opt.Value == (ViewBag.ServiceType?.ToString()))">@opt.Text</option>
                        }
                    }
                </select>
            </div>
            @if (ViewBag.DepartmentId != null || !string.IsNullOrWhiteSpace(ViewBag.ServiceType?.ToString()))
            {
                <div class="col-auto">
                    <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Reset</a>
                </div>
            }
        </form>
    </div>
</div>

<!-- Data Table -->
<div class="card border-0 shadow-sm rounded-3">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" id="hospitalServicesTable">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Service Code</th>
                        <th>Service Name</th>
                        <th>Department</th>
                        <th>Service Type</th>
                        <th>UOM</th>
                        <th>Tax (%)</th>
                        <th>Status</th>
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                                No hospital services found. Click "Add Hospital Service" to create one.
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-bold">
                                    <span class="badge bg-light text-primary border font-monospace">@item.ServiceCode</span>
                                </td>
                                <td>
                                    <div class="fw-semibold">@item.ServiceName</div>
                                    @if (!string.IsNullOrWhiteSpace(item.Description))
                                    {
                                        <small class="text-muted text-truncate d-block" style="max-width: 250px;">@item.Description</small>
                                    }
                                </td>
                                <td>
                                    <span class="badge bg-secondary-subtle text-secondary border">@item.DepartmentName</span>
                                </td>
                                <td>
                                    <span class="badge bg-info-subtle text-info-emphasis border">@item.ServiceType</span>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border">@item.UOM</span>
                                </td>
                                <td>
                                    @(item.TaxPercentage > 0 ? $"{item.TaxPercentage:0.##}%" : "0%")
                                </td>
                                <td>
                                    @if (item.IsActive)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle">Inactive</span>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Details" asp-route-id="@item.HospitalServiceId" class="btn btn-outline-info" title="View Details">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@item.HospitalServiceId" class="btn btn-outline-primary" title="Edit Service">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <form asp-action="Delete" asp-route-id="@item.HospitalServiceId" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this service?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-danger" title="Delete">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
