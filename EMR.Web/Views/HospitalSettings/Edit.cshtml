@section Scripts {
<script>
(function () {
    const $ = id => document.getElementById(id);
    if (!$('ftpBox')) return;
    const token = () => document.querySelector('input[name="__RequestVerificationToken"]').value;
    const status = (t, cls) => { $('ftpStatus').className = 'small mt-1 ' + (cls || 'text-muted'); $('ftpStatus').textContent = t; };
    function body() {
        const b = new FormData();
        b.append('host', $('ftpHost').value.trim()); b.append('port', $('ftpPort').value || '21');
        b.append('userName', $('ftpUser').value.trim()); b.append('password', $('ftpPassword').value);
        b.append('rootFolder', $('ftpRoot').value.trim());
        b.append('usePassive', $('ftpPassive').checked); b.append('useFtps', $('ftpFtps').checked);
        b.append('__RequestVerificationToken', token());
        return b;
    }
    async function load() {
        try {
            const r = await (await fetch('@Url.Action("FtpSettings")')).json();
            if (!r.success) return;
            $('ftpHost').value = r.host || ''; $('ftpPort').value = r.port || 21; $('ftpUser').value = r.userName || '';
            $('ftpRoot').value = r.rootFolder || 'emedidoc/reports'; $('ftpPassive').checked = r.usePassive; $('ftpFtps').checked = r.useFtps;
            $('ftpPassword').placeholder = r.hasPassword ? '•••••••• saved — leave blank to keep' : '';
            $('ftpPwdReq').classList.toggle('d-none', r.hasPassword);
            if (!r.own && r.inheritedFromBranchId) {
                $('ftpInherited').classList.remove('d-none');
                $('ftpInherited').textContent = ' This branch uses the FTP settings of another branch; save here to give it its own.';
            }
            if (r.modifiedDate) status('Last saved ' + new Date(r.modifiedDate).toLocaleString('en-GB'));
        } catch { }
    }
    async function post(url, btn) {
        btn.disabled = true; status('Working…');
        try {
            const r = await (await fetch(url, { method: 'POST', body: body() })).json();
            status(r.message, r.success ? 'text-success' : 'text-danger');
            return r.success;
        } catch { status('Could not reach the server.', 'text-danger'); return false; }
        finally { btn.disabled = false; }
    }
    $('ftpBox').addEventListener('keydown', e => { if (e.key === 'Enter') e.preventDefault(); });
    $('ftpTest').addEventListener('click', () => post('@Url.Action("TestFtpSettings")', $('ftpTest')));
    $('ftpSave').addEventListener('click', async () => {
        if (await post('@Url.Action("SaveFtpSettings")', $('ftpSave'))) { $('ftpPassword').value = ''; load(); }
    });
    load();
})();
</script>

    <script>
        // Critical value communication: the target minutes only matter while the feature is on
        $(function () {
            const $crit = $('#CriticalValueCommunicationRequired');
            const sync = () => $('#critInformMinutesBox').toggle($crit.is(':checked'));
            $crit.on('change', sync); sync();
        });
    </script>
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(function () {
            const urls = {
                list: '@Url.Action("GetSignatoriesJson", "HospitalSettings")',
                save: '@Url.Action("SaveSignatoriesJson", "HospitalSettings")'
            };
            const $toggle = $('#PathologistApprovalRequired');
            const $btn = $('#btnConfigSignatories');
            let candidates = [], current = [], departments = [], loaded = false;
            const MAX_SLOTS = 3;

            const esc = v => $('<div>').text(v == null ? '' : v).html();

            // the button only matters while approval is OFF
            function syncVisibility() {
                const off = !$toggle.is(':checked');
                $btn.toggle(off);
                if (off && !loaded) loadSignatories();
            }

            function slotLabel(n) {
                return n === 1 ? '1st Pathologist' : n === 2 ? '2nd Pathologist' : '3rd Pathologist';
            }

            function buildSlotRow(dept, slot) {
                // find saved entry for this dept + slot
                const saved = current.find(s => s.departmentId === dept.departmentId && s.slotNo === slot);

                const opts = ['<option value="">— Not set —</option>'].concat(candidates.map(c =>
                    `<option value="${c.userId}" ${saved && saved.userId === c.userId ? 'selected' : ''}>`
                    + esc(c.fullName) + (c.registrationNo ? ' — ' + esc(c.registrationNo) : '')
                    + (c.hasSignature ? '' : ' (no signature on profile)') + '</option>')).join('');

                const hasSig = saved && (saved.signaturePath || saved.userSignaturePath);
                const sigBadge = hasSig
                    ? '<span class="badge bg-success-subtle text-success border border-success-subtle ms-2" style="font-size:.62rem;"><i class="bi bi-check2 me-1"></i>Signature on file</span>'
                    : '';

                return `
                    <div class="row g-2 align-items-end mb-2 slot-row" data-dept="${dept.departmentId}" data-slot="${slot}">
                        <div class="col-12 col-md-1 text-center">
                            <span class="badge rounded-pill ${saved ? 'bg-primary' : 'bg-secondary-subtle text-secondary'}" style="font-size:.65rem;">${slot}</span>
                        </div>
                        <div class="col-12 col-md-5">
                            <label class="form-label text-muted mb-0" style="font-size:.65rem;font-weight:700;letter-spacing:.3px;text-transform:uppercase;">
                                ${slotLabel(slot)}${sigBadge}
                            </label>
                            <select class="form-select form-select-sm sig-user" data-dept="${dept.departmentId}" data-slot="${slot}">${opts}</select>
                        </div>
                        <div class="col-12 col-md-5">
                            <label class="form-label text-muted mb-0" style="font-size:.65rem;font-weight:700;letter-spacing:.3px;text-transform:uppercase;">Signature (optional)</label>
                            <input type="file" class="form-control form-control-sm sig-file" data-dept="${dept.departmentId}" data-slot="${slot}" accept=".png,.jpg,.jpeg" />
                        </div>
                        <div class="col-12 col-md-1 text-center">
                            ${saved ? '<i class="bi bi-check-circle-fill text-success" title="Configured"></i>' : '<i class="bi bi-dash-circle text-muted" title="Not configured"></i>'}
                        </div>
                    </div>`;
            }

            function deptCard(dept) {
                const deptSaved = current.filter(s => s.departmentId === dept.departmentId);
                const configuredCount = deptSaved.length;
                const statusBadge = configuredCount > 0
                    ? `<span class="badge bg-success-subtle text-success border border-success-subtle ms-auto" style="font-size:.66rem;"><i class="bi bi-check2 me-1"></i>${configuredCount} configured</span>`
                    : '<span class="badge bg-warning-subtle text-warning border border-warning-subtle ms-auto" style="font-size:.66rem;"><i class="bi bi-exclamation-triangle me-1"></i>Not configured</span>';

                let slotsHtml = '';
                for (let s = 1; s <= MAX_SLOTS; s++) {
                    slotsHtml += buildSlotRow(dept, s);
                }

                return `
                    <div class="card border-0 shadow-sm mb-3">
                        <div class="card-header bg-white py-2 px-3 border-bottom" style="cursor:pointer;" data-bs-toggle="collapse" data-bs-target="#deptCollapse_${dept.departmentId}">
                            <div class="d-flex align-items-center gap-2">
                                <i class="bi bi-chevron-down text-muted dept-chevron" style="transition:transform .2s;"></i>
                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle">
                                    <i class="bi bi-diagram-3 me-1"></i>${esc(dept.departmentName)}
                                </span>
                                ${statusBadge}
                            </div>
                        </div>
                        <div class="collapse show" id="deptCollapse_${dept.departmentId}">
                            <div class="card-body p-2 px-3">
                                <div class="text-muted mb-2" style="font-size:.68rem;">
                                    <i class="bi bi-people me-1"></i>Assign up to ${MAX_SLOTS} pathologists for <strong>${esc(dept.departmentName)}</strong>
                                </div>
                                ${slotsHtml}
                                <div class="form-text text-end" style="font-size:.62rem;">PNG or JPG, up to 2 MB each. Replaces the slot's signature.</div>
                            </div>
                        </div>
                    </div>`;
            }

            function render() {
                if (departments.length === 0) {
                    $('#sigDepartments').html('<div class="alert alert-warning py-2 px-3" style="font-size:.78rem;"><i class="bi bi-exclamation-triangle me-1"></i>No LAB departments found. Please add departments with Type = LAB in the Department Master first.</div>').removeClass('d-none');
                } else {
                    $('#sigDepartments').html(departments.map(deptCard).join('')).removeClass('d-none');
                }
                $('#sigLoading').addClass('d-none');
                $('#sigCountChip').text(current.length);
            }

            function loadSignatories() {
                $('#sigLoading').removeClass('d-none');
                $('#sigDepartments').addClass('d-none');
                $.getJSON(urls.list).done(function (res) {
                    if (!res || !res.success) { $('#sigAlert').text((res && res.message) || 'Unable to load.').removeClass('d-none'); return; }
                    candidates = res.candidates || [];
                    current = res.signatories || [];
                    departments = res.departments || [];
                    loaded = true;
                    render();
                }).fail(function () {
                    $('#sigAlert').text('Server error while loading the data.').removeClass('d-none');
                    $('#sigLoading').addClass('d-none');
                });
            }

            $toggle.on('change', function () {
                syncVisibility();
                // switching approval OFF is exactly when the signatories have to be named
                if (!$(this).is(':checked')) {
                    bootstrap.Modal.getOrCreateInstance(document.getElementById('modalSignatories')).show();
                }
            });
            $btn.on('click', function () {
                bootstrap.Modal.getOrCreateInstance(document.getElementById('modalSignatories')).show();
            });
            $('#modalSignatories').on('shown.bs.modal', function () { if (!loaded) loadSignatories(); });

            // collapse chevron rotation
            $('#sigDepartments').on('show.bs.collapse', '.collapse', function () {
                $(this).closest('.card').find('.dept-chevron').css('transform', 'rotate(0deg)');
            }).on('hide.bs.collapse', '.collapse', function () {
                $(this).closest('.card').find('.dept-chevron').css('transform', 'rotate(-90deg)');
            });

            // file size validation
            $('#sigDepartments').on('change', '.sig-file', function () {
                const f = this.files && this.files[0];
                if (f && f.size > 2 * 1024 * 1024) {
                    $('#sigAlert').text('Signature image size must be up to 2 MB.').removeClass('d-none');
                    $(this).val('');
                } else {
                    $('#sigAlert').addClass('d-none');
                }
            });

            $('#btnSaveSignatories').on('click', function () {
                const fd = new FormData();
                fd.append('__RequestVerificationToken', $('input[name="__RequestVerificationToken"]').first().val());
                let any = false;

                // Each sig-user has data-dept and data-slot attributes
                $('.sig-user').each(function () {
                    const deptId = $(this).data('dept');
                    const slot   = $(this).data('slot');
                    const userId = $(this).val();
                    if (!userId) return;
                    any = true;
                    // Form key format expected by server: userId_<deptId>_<slot>
                    fd.append('userId_' + deptId + '_' + slot, userId);
                    const fileInput = $(`.sig-file[data-dept="${deptId}"][data-slot="${slot}"]`)[0];
                    const file = fileInput && fileInput.files && fileInput.files[0];
                    if (file) fd.append('signature_' + deptId + '_' + slot, file);
                });

                if (!any && !confirm('No signatory is selected. Save and clear the configured signatories?')) return;

                const $b = $(this).prop('disabled', true);
                $('#sigSpinner').removeClass('d-none');
                $('#sigAlert').addClass('d-none');

                $.ajax({ url: urls.save, type: 'POST', data: fd, processData: false, contentType: false })
                    .done(function (res) {
                        if (res && res.success) {
                            bootstrap.Modal.getInstance(document.getElementById('modalSignatories')).hide();
                            if (typeof toastr !== 'undefined') toastr.success(res.message);
                            else if (typeof Swal !== 'undefined') Swal.fire({ icon: 'success', title: 'Saved', text: res.message, timer: 2200, showConfirmButton: false });
                            loaded = false;
                            loadSignatories();
                        } else {
                            $('#sigAlert').text((res && res.message) || 'Unable to save.').removeClass('d-none');
                        }
                    })
                    .fail(function () { $('#sigAlert').text('Server error while saving. Please try again.').removeClass('d-none'); })
                    .always(function () { $b.prop('disabled', false); $('#sigSpinner').addClass('d-none'); });
            });

            syncVisibility();
        });
    </script>
}