@model EMR.Web.Models.ViewModels.HospitalSettingsViewModel
@{
    ViewData["Title"] = "Hospital Settings";
}

@section HeadStyles {
<style>
    .hs-info-bar { background:#fff; border:1px solid #e2e8f0; border-radius:14px; padding:1.25rem 1.4rem; box-shadow:0 2px 8px rgba(0,0,0,.04); }
    .hs-meta-badge { font-size:0.75rem; font-weight:600; padding:0.35rem 0.65rem; border-radius:6px; }
    .hs-info-item { display:flex; flex-direction:column; min-width:0; }
    .hs-info-item .lbl { font-size:.68rem; text-transform:uppercase; letter-spacing:.06em; color:#64748b; font-weight:700; margin-bottom: 2px; }
    .hs-info-item .val { font-size:.92rem; font-weight:600; color:#1e293b; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
    .hs-divider { width:1px; background:#e2e8f0; align-self:stretch; margin:0 .35rem; }

    .module-tab-nav .nav-link { font-size:.82rem; font-weight:600; letter-spacing:.02em; padding:.6rem 1.4rem; border-radius:10px 10px 0 0; color:#64748b; border:1px solid transparent; }
    .module-tab-nav .nav-link.active { color:#fff; border-color: transparent; }
    .module-tab-nav .nav-link[data-tab="opd"].active  { background:#0d6efd; }
    .module-tab-nav .nav-link[data-tab="ipd"].active  { background:#198754; }
    .module-tab-nav .nav-link[data-tab="lab"].active  { background:#fd7e14; }
    .module-tab-nav .nav-link[data-tab="med"].active  { background:#6f42c1; }

    .module-tab-nav .nav-link[data-tab="opd"]:not(.active):hover { background:#e8f0fe; color:#0d6efd; }
    .module-tab-nav .nav-link[data-tab="ipd"]:not(.active):hover { background:#e6f4ea; color:#198754; }
    .module-tab-nav .nav-link[data-tab="lab"]:not(.active):hover { background:#fff3e0; color:#fd7e14; }
    .module-tab-nav .nav-link[data-tab="med"]:not(.active):hover { background:#f1ecff; color:#6f42c1; }

    .module-tab-pane { background:#fff; border:1px solid #e2e8f0; border-radius:0 14px 14px 14px; padding:1.5rem; min-height:260px; box-shadow:0 2px 6px rgba(0,0,0,.03); }
    .param-card { background:#f8fafc; border:1px solid #e2e8f0; border-radius:10px; padding:1rem 1.2rem; height:100%; }
    .param-card .param-label { font-size:.72rem; text-transform:uppercase; letter-spacing:.06em; color:#64748b; font-weight:700; margin-bottom:.35rem; }
    .param-card .param-value { font-size:.95rem; font-weight:600; color:#1e293b; }
    .param-soon { opacity:.55; }
    .coming-soon-badge { font-size:.65rem; background:#f1f5f9; color:#64748b; padding:2px 8px; border-radius:20px; font-weight:600; vertical-align:middle; margin-left:6px; border:1px solid #e2e8f0; }
</style>
}

@* ── Page header ── *@
<div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
    <div class="d-flex align-items-center gap-2">
        <i class="bi bi-hospital-fill fs-4 text-primary"></i>
        <div>
            <h4 class="h4 mb-0 fw-bold text-dark">Hospital Settings</h4>
            <small class="text-muted">Branch: <strong class="text-primary">@Model.BranchName</strong></small>
        </div>
    </div>
    <a asp-action="Edit" class="btn btn-primary btn-sm px-3 shadow-sm">
        <i class="bi bi-pencil-square me-1"></i> Edit Settings
    </a>
</div>

@if (Model.Id == 0)
{
    <div class="uf-section mb-3">
        <div class="uf-section-body text-center py-5">
            <i class="bi bi-exclamation-circle fs-1 text-warning d-block mb-3"></i>
            <h5 class="text-muted">No settings configured for this branch yet.</h5>
            <a asp-action="Edit" class="btn btn-primary mt-2"><i class="bi bi-plus-circle me-1"></i> Configure Now</a>
        </div>
    </div>
}
else
{
    @* ── Comprehensive Hospital Header Card ── *@
    <div class="card border-0 shadow-sm rounded-3 mb-4 overflow-hidden">
        <div class="card-body p-4">
            <div class="row align-items-center g-3">
                <div class="col-auto">
                    @if (!string.IsNullOrWhiteSpace(Model.LogoPath))
                    {
                        <img src="@Model.LogoPath" alt="Logo" class="rounded-3 border p-1 shadow-sm" style="height:68px;width:68px;object-fit:contain;background:#fff;" />
                    }
                    else
                    {
                        <div class="rounded-3 bg-primary bg-opacity-10 text-primary d-flex align-items-center justify-content-center fw-bold shadow-sm" style="width:68px;height:68px;font-size:1.8rem;">
                            <i class="bi bi-hospital"></i>
                        </div>
                    }
                </div>
                <div class="col-lg-6 col-md-5">
                    <div class="d-flex align-items-center gap-2 flex-wrap">
                        <h4 class="mb-0 fw-bold text-dark">@(Model.HospitalName ?? "Hospital Name Not Set")</h4>
                        @if (Model.IsActive)
                        {
                            <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2 py-1">Active</span>
                        }
                        else
                        {
                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-2 py-1">Inactive</span>
                        }
                    </div>
                    <div class="d-flex align-items-center gap-2 flex-wrap mt-2">
                        @if (!string.IsNullOrWhiteSpace(Model.HospitalType))
                        {
                            <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 px-2 py-1">
                                <i class="bi bi-tag-fill me-1"></i>@Model.HospitalType
                            </span>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.RegistrationNumber))
                        {
                            <span class="badge bg-secondary bg-opacity-10 text-dark border px-2 py-1" title="Registration / License Number">
                                <i class="bi bi-card-heading me-1 text-muted"></i>Reg: @Model.RegistrationNumber
                            </span>
                        }
                        @if (Model.IsTeachingHospital)
                        {
                            <span class="badge bg-info bg-opacity-10 text-info border border-info border-opacity-25 px-2 py-1">
                                <i class="bi bi-mortarboard-fill me-1"></i>Teaching Hospital
                            </span>
                        }
                    </div>
                </div>

                <!-- Emergency & Accreditation Badges -->
                <div class="col-lg-5 col-md-5">
                    <div class="d-flex flex-column gap-2 align-items-md-end">
                        @if (!string.IsNullOrWhiteSpace(Model.EmergencyNumber))
                        {
                            <div class="d-inline-flex align-items-center gap-2 bg-danger bg-opacity-10 border border-danger border-opacity-25 text-danger px-3 py-1 rounded-pill">
                                <i class="bi bi-telephone-plus-fill fs-6"></i>
                                <span class="small fw-bold">Emergency Helpline: @Model.EmergencyNumber</span>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.NabhStatus) && Model.NabhStatus != "Not Applied")
                        {
                            <div class="d-inline-flex align-items-center gap-2 bg-success bg-opacity-10 border border-success border-opacity-25 text-success px-3 py-1 rounded-pill">
                                <i class="bi bi-patch-check-fill fs-6"></i>
                                <span class="small fw-bold">NABH: @Model.NabhStatus</span>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <hr class="my-3 text-muted opacity-25" />

            <!-- Detailed Metadata Grid -->
            <div class="row g-3 small">
                <div class="col-sm-6 col-lg-3">
                    <div class="text-muted text-uppercase fw-semibold" style="font-size:0.7rem;"><i class="bi bi-geo-alt me-1 text-primary"></i>Address</div>
                    <div class="text-dark fw-medium mt-1">@(Model.Address ?? "—")</div>
                </div>
                <div class="col-sm-6 col-lg-2">
                    <div class="text-muted text-uppercase fw-semibold" style="font-size:0.7rem;"><i class="bi bi-telephone me-1 text-primary"></i>Contacts</div>
                    <div class="text-dark fw-medium mt-1">@(Model.ContactNumber1 ?? "—")</div>
                    @if (!string.IsNullOrWhiteSpace(Model.ContactNumber2))
                    {
                        <div class="text-muted small">@Model.ContactNumber2</div>
                    }
                </div>
                <div class="col-sm-6 col-lg-2">
                    <div class="text-muted text-uppercase fw-semibold" style="font-size:0.7rem;"><i class="bi bi-envelope me-1 text-primary"></i>Email & Web</div>
                    <div class="text-dark fw-medium mt-1 text-truncate" title="@Model.EmailAddress">@(Model.EmailAddress ?? "—")</div>
                    @if (!string.IsNullOrWhiteSpace(Model.Website))
                    {
                        <div class="text-truncate"><a href="@Model.Website" target="_blank" class="text-decoration-none small">@Model.Website</a></div>
                    }
                </div>
                <div class="col-sm-6 col-lg-2">
                    <div class="text-muted text-uppercase fw-semibold" style="font-size:0.7rem;"><i class="bi bi-receipt me-1 text-primary"></i>Taxation & Timings</div>
                    <div class="text-dark fw-medium mt-1">GST: @(Model.GSTCode ?? "—")</div>
                    <div class="text-muted small"><i class="bi bi-clock me-1"></i>@(Model.CheckInTime ?? "—") to @(Model.CheckOutTime ?? "—")</div>
                </div>
                <div class="col-sm-6 col-lg-3">
                    <div class="text-muted text-uppercase fw-semibold" style="font-size:0.7rem;"><i class="bi bi-shield-check me-1 text-primary"></i>NABH Accreditation</div>
                    <div class="text-dark fw-medium mt-1">
                        Cert No: @(string.IsNullOrWhiteSpace(Model.NabhCertificateNo) ? "—" : Model.NabhCertificateNo)
                    </div>
                    @if (!string.IsNullOrWhiteSpace(Model.NabhValidFrom) || !string.IsNullOrWhiteSpace(Model.NabhValidTo))
                    {
                        <div class="text-muted small">
                            Valid: @(Model.NabhValidFrom ?? "—") to @(Model.NabhValidTo ?? "—")
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    @* ── Module tabs ── *@
    <ul class="nav module-tab-nav mb-0" id="moduleTabs" role="tablist">
        <li class="nav-item">
            <button class="nav-link active" data-tab="opd" data-bs-toggle="tab" data-bs-target="#tabOpd" type="button" role="tab">
                <i class="bi bi-person-plus-fill me-1"></i>OPD Configuration
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link" data-tab="ipd" data-bs-toggle="tab" data-bs-target="#tabIpd" type="button" role="tab">
                <i class="bi bi-hospital me-1"></i>IPD
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link" data-tab="lab" data-bs-toggle="tab" data-bs-target="#tabLab" type="button" role="tab">
                <i class="bi bi-eyedropper me-1"></i>LAB
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link" data-tab="med" data-bs-toggle="tab" data-bs-target="#tabMed" type="button" role="tab">
                <i class="bi bi-capsule me-1"></i>MED / Pharmacy
            </button>
        </li>
    </ul>

    <div class="tab-content">

        @* ── OPD Tab ── *@
        <div class="tab-pane fade show active module-tab-pane" id="tabOpd" role="tabpanel">
            <div class="d-flex align-items-center mb-3 gap-2">
                <span class="fw-bold" style="color:#0d6efd"><i class="bi bi-person-plus-fill me-1"></i>OPD Module Settings</span>
                <span class="coming-soon-badge">More parameters coming soon</span>
            </div>
            <div class="row g-3">
                <div class="col-6 col-md-3">
                    <div class="param-card @(Model.OpdRegistrationValidityDays.HasValue ? "" : "param-soon")">
                        <div class="param-label"><i class="bi bi-calendar-check me-1"></i>Registration Charges Validity</div>
                        @if (Model.OpdRegistrationValidityDays.HasValue)
                        {
                            <div class="param-value text-primary fw-bold">@Model.OpdRegistrationValidityDays.Value <span class="fs-6 fw-normal text-muted">days</span></div>
                        }
                        else
                        {
                            <div class="param-value text-muted">—</div>
                        }
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="param-card">
                        <div class="param-label"><i class="bi bi-search me-1"></i>Global Patient Search Required</div>
                        @if (Model.GlobalPatientSearchRequired)
                        {
                            <div class="param-value text-success fw-bold"><i class="bi bi-check-circle-fill me-1"></i>Yes</div>
                        }
                        else
                        {
                            <div class="param-value text-secondary fw-bold"><i class="bi bi-x-circle-fill me-1"></i>No</div>
                        }
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="param-card">
                        <div class="param-label"><i class="bi bi-envelope me-1"></i>Email Notification Required</div>
                        @if (Model.EmailNotificationRequired)
                        {
                            <div class="param-value text-success fw-bold"><i class="bi bi-check-circle-fill me-1"></i>Yes</div>
                        }
                        else
                        {
                            <div class="param-value text-secondary fw-bold"><i class="bi bi-x-circle-fill me-1"></i>No</div>
                        }
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="param-card param-soon">
                        <div class="param-label">Token Prefix</div>
                        <div class="param-value text-muted">—</div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="param-card param-soon">
                        <div class="param-label">Auto Token Reset</div>
                        <div class="param-value text-muted">—</div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="param-card param-soon">
                        <div class="param-label">Default Consulting Fee</div>
                        <div class="param-value text-muted">—</div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="param-card param-soon">
                        <div class="param-label">Allow Walk-In</div>
                        <div class="param-value text-muted">—</div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="param-card param-soon">
                        <div class="param-label">Max Patients / Day</div>
                        <div class="param-value text-muted">—</div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="param-card param-soon">
                        <div class="param-label">Print Bill on Save</div>
                        <div class="param-value text-muted">—</div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="param-card param-soon">
                        <div class="param-label">GST on Services</div>
                        <div class="param-value text-muted">—</div>
                    </div>
                </div>
            </div>
        </div>

        @* ── IPD Tab ── *@
        <div class="tab-pane fade module-tab-pane" id="tabIpd" role="tabpanel">
            <div class="d-flex align-items-center mb-3 gap-2">
                <span class="fw-bold" style="color:#198754"><i class="bi bi-hospital me-1"></i>IPD Configuration</span>
                <span class="coming-soon-badge">Parameters coming soon</span>
            </div>
            <div class="row g-3">
                <div class="col-6 col-md-3">
                    <div class="param-card param-soon">
                        <div class="param-label">Admission Prefix</div>
                        <div class="param-value text-muted">—</div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="param-card param-soon">
                        <div class="param-label">Default Ward</div>
                        <div class="param-value text-muted">—</div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="param-card param-soon">
                        <div class="param-label">Bed Booking Advance (Days)</div>
                        <div class="param-value text-muted">—</div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="param-card param-soon">
                        <div class="param-label">Auto Discharge Reminder</div>
                        <div class="param-value text-muted">—</div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="param-card param-soon">
                        <div class="param-label">Diet Plan Enabled</div>
                        <div class="param-value text-muted">—</div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="param-card param-soon">
                        <div class="param-label">Nursing Notes</div>
                        <div class="param-value text-muted">—</div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="param-card param-soon">
                        <div class="param-label">OT Module</div>
                        <div class="param-value text-muted">—</div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="param-card param-soon">
                        <div class="param-label">Print Discharge Summary</div>
                        <div class="param-value text-muted">—</div>
                    </div>
                </div>
            </div>
        </div>

        @* ── LAB Tab ── *@
        <div class="tab-pane fade module-tab-pane" id="tabLab" role="tabpanel">
            <div class="d-flex align-items-center mb-3 gap-2">
                <span class="fw-bold" style="color:#fd7e14"><i class="bi bi-eyedropper me-1"></i>LAB Configuration</span>
                <span class="coming-soon-badge">Parameters coming soon</span>
            </div>
            <div class="row g-3">
                <div class="col-6 col-md-3">
                    <div class="param-card param-soon">
                        <div class="param-label">Report Prefix</div>
                        <div class="param-value text-muted">—</div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="param-card param-soon">
                        <div class="param-label">Default Sample Type</div>
                        <div class="param-value text-muted">—</div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="param-card param-soon">
                        <div class="param-label">Auto Report Delivery</div>
                        <div class="param-value text-muted">—</div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="param-card param-soon">
                        <div class="param-label">Report TAT (Hours)</div>
                        <div class="param-value text-muted">—</div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="param-card param-soon">
                        <div class="param-label">External Lab Integration</div>
                        <div class="param-value text-muted">—</div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="param-card param-soon">
                        <div class="param-label">Critical Alert</div>
                        <div class="param-value text-muted">—</div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="param-card param-soon">
                        <div class="param-label">Print Header on Report</div>
                        <div class="param-value text-muted">—</div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="param-card param-soon">
                        <div class="param-label">Barcode on Sample</div>
                        <div class="param-value text-muted">—</div>
                    </div>
                </div>
            </div>
        </div>

        @* ── MED Tab ── *@
        <div class="tab-pane fade module-tab-pane" id="tabMed" role="tabpanel">
            <div class="d-flex align-items-center mb-3 gap-2">
                <span class="fw-bold" style="color:#6f42c1"><i class="bi bi-capsule me-1"></i>MED / Pharmacy Configuration</span>
                <span class="coming-soon-badge">Parameters coming soon</span>
            </div>
            <div class="row g-3">
                <div class="col-6 col-md-3">
                    <div class="param-card param-soon">
                        <div class="param-label">Invoice Prefix</div>
                        <div class="param-value text-muted">—</div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="param-card param-soon">
                        <div class="param-label">GST Registration No.</div>
                        <div class="param-value text-muted">—</div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="param-card param-soon">
                        <div class="param-label">Drug License No.</div>
                        <div class="param-value text-muted">—</div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="param-card param-soon">
                        <div class="param-label">Low Stock Alert (Qty)</div>
                        <div class="param-value text-muted">—</div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="param-card param-soon">
                        <div class="param-label">Expiry Alert (Days)</div>
                        <div class="param-value text-muted">—</div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="param-card param-soon">
                        <div class="param-label">Return Policy (Days)</div>
                        <div class="param-value text-muted">—</div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="param-card param-soon">
                        <div class="param-label">Auto Reorder</div>
                        <div class="param-value text-muted">—</div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="param-card param-soon">
                        <div class="param-label">Print Prescription</div>
                        <div class="param-value text-muted">—</div>
                    </div>
                </div>
            </div>
        </div>

    </div>
}
