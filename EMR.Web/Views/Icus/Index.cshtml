<!-- MODAL: CONFIGURE DYNAMIC ICU TARIFF                                       -->
<!-- ========================================================================= -->
<div class="modal fade" id="addTariffModal" tabindex="-1" aria-labelledby="addTariffModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-light">
                <h5 class="modal-title fw-bold" id="addTariffModalLabel"><i class="bi bi-calculator me-2 text-primary"></i>Configure Dynamic ICU Tariff</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="CreateTariff" method="post" id="addTariffForm">
                @Html.AntiForgeryToken()
                <div class="modal-body p-4">
                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">ICU Unit (Header) <span class="text-danger">*</span></label>
                            <select name="IcuId" id="addTariffIcuId" class="form-select" required>
                                <option value="">-- Select ICU Unit --</option>
                                @foreach (var opt in Model.IcuOptions)
                                {
                                    <option value="@opt.Value">@opt.Text</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Tariff Category <span class="text-danger">*</span></label>
                            <select name="TariffCategoryId" class="form-select" required>
                                <option value="">-- Select Tariff Category --</option>
                                @foreach (var opt in Model.TariffCategoryOptions)
                                {
                                    <option value="@opt.Value">@opt.Text</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Effective From <span class="text-danger">*</span></label>
                            <input name="EffectiveFrom" class="form-control" type="date" value="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Effective To</label>
                            <input name="EffectiveTo" class="form-control" type="date" />
                            <small class="text-muted">Leave empty for ongoing rate</small>
                        </div>
                    </div>

                    <!-- Dynamic Rate Heads Section -->
                    <div class="card bg-light border-0 p-3 rounded-3 mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-2 flex-wrap gap-2">
                            <div>
                                <h6 class="fw-bold text-dark mb-0"><i class="bi bi-list-stars me-2 text-primary"></i>Dynamic Rate Heads & Components (Details)</h6>
                                <small class="text-muted">Add, remove, or customize any rate head name as required</small>
                            </div>
                            <button type="button" class="btn btn-sm btn-primary" onclick="addRateRow('addRateTable')">
                                <i class="bi bi-plus-circle me-1"></i>Add Custom Rate Head
                            </button>
                        </div>

                        <!-- Quick Presets -->
                        <div class="mb-3">
                            <span class="small text-muted me-2">Quick Add Presets:</span>
                            <button type="button" class="btn btn-xs btn-outline-secondary rounded-pill me-1 mb-1" onclick="addPresetRow('addRateTable', 'ICU Bed & Accommodation', 'BED', 4500, 'Per Day')">+ ICU Bed</button>
                            <button type="button" class="btn btn-xs btn-outline-secondary rounded-pill me-1 mb-1" onclick="addPresetRow('addRateTable', 'Critical Care Nursing', 'NUR', 3000, 'Per Day')">+ Nursing</button>
                            <button type="button" class="btn btn-xs btn-outline-secondary rounded-pill me-1 mb-1" onclick="addPresetRow('addRateTable', 'Mechanical Ventilator', 'VENT', 3500, 'Per Day')">+ Ventilator</button>
                            <button type="button" class="btn btn-xs btn-outline-secondary rounded-pill me-1 mb-1" onclick="addPresetRow('addRateTable', 'Multi-para Monitoring', 'MON', 1500, 'Per Day')">+ Monitoring</button>
                            <button type="button" class="btn btn-xs btn-outline-secondary rounded-pill me-1 mb-1" onclick="addPresetRow('addRateTable', 'Infusion Pump', 'INF', 1000, 'Per Day')">+ Infusion Pump</button>
                            <button type="button" class="btn btn-xs btn-outline-secondary rounded-pill me-1 mb-1" onclick="addPresetRow('addRateTable', 'Syringe Pump', 'SYR', 1000, 'Per Day')">+ Syringe Pump</button>
                            <button type="button" class="btn btn-xs btn-outline-secondary rounded-pill me-1 mb-1" onclick="addPresetRow('addRateTable', 'Central High-flow Oxygen', 'O2', 2000, 'Per Day')">+ Oxygen</button>
                            <button type="button" class="btn btn-xs btn-outline-secondary rounded-pill me-1 mb-1" onclick="addPresetRow('addRateTable', 'Negative Pressure Isolation', 'ISO', 1000, 'Per Day')">+ Isolation</button>
                            <button type="button" class="btn btn-xs btn-outline-secondary rounded-pill me-1 mb-1" onclick="addPresetRow('addRateTable', 'Critical-care Bedside Procedures', 'PROC', 1000, 'Per Day')">+ Critical Procedures</button>
                        </div>

                        <!-- Table -->
                        <div class="table-responsive bg-white rounded-3 border">
                            <table class="table table-sm align-middle mb-0" id="addRateTable">
                                <thead class="table-light">
                                    <tr>
                                        <th style="width: 35%;">Rate Head Component Name <span class="text-danger">*</span></th>
                                        <th style="width: 15%;">Code</th>
                                        <th style="width: 25%;">Rate Amount (₹) <span class="text-danger">*</span></th>
                                        <th style="width: 20%;">Billing Frequency</th>
                                        <th style="width: 5%;" class="text-center">Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <!-- Dynamic rows will be inserted here -->
                                </tbody>
                            </table>
                        </div>

                        <!-- Live Total -->
                        <div class="p-3 bg-white rounded-3 border d-flex justify-content-between align-items-center mt-3">
                            <div>
                                <span class="fw-bold text-dark">Total Dynamic Package Rate:</span>
                                <small class="text-muted d-block">Sum of all active rate head components</small>
                            </div>
                            <div class="fs-3 fw-bold text-success font-monospace" id="addTotalDisplay">₹0.00</div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Description / Remarks</label>
                        <textarea name="Description" class="form-control" rows="2" placeholder="Optional package description..."></textarea>
                    </div>

                    <div class="form-check form-switch">
                        <input name="IsActive" class="form-check-input" type="checkbox" role="switch" value="true" checked id="addTariffIsActive" />
                        <label class="form-check-label fw-semibold" for="addTariffIsActive">Active Status</label>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Save Dynamic Tariff</button>
                </div>
            </form>
        </div>
    </div>
</div>

