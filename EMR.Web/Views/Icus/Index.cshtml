@model EMR.Web.Models.ViewModels.IcuUnifiedViewModel
@{
    ViewData["Title"] = "ICU Configuration & Tariff Master";
    var icus = Model.Icus ?? [];
    var tariffs = Model.Tariffs ?? [];
    var isIcusActive = Model.ActiveTab != "tariffs";
}

<div class="container-fluid px-0">
    <!-- Header -->
    <div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-2">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                    <li class="breadcrumb-item">Master</li>
                    <li class="breadcrumb-item">IPD Master</li>
                    <li class="breadcrumb-item active" aria-current="page">ICU Master</li>
                </ol>
            </nav>
            <h1 class="h3 mb-0 fw-bold text-dark">
                <i class="bi bi-hospital-fill me-2 text-primary"></i>ICU Configuration & Dynamic Tariffs
            </h1>
        </div>
        <div class="d-flex gap-2">
            <button type="button" class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#addIcuModal">
                <i class="bi bi-plus-circle me-1"></i>Add ICU Configuration
            </button>
            <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addTariffModal">
                <i class="bi bi-plus-lg me-1"></i>Configure Dynamic Tariff
            </button>
        </div>
    </div>

    <!-- KPI Summary Row -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-md">
            <div class="card border-0 shadow-sm rounded-3 p-3 bg-white">
                <div class="d-flex align-items-center">
                    <div class="rounded-3 bg-primary-subtle text-primary p-3 me-3">
                        <i class="bi bi-hospital fs-4"></i>
                    </div>
                    <div>
                        <div class="text-muted small fw-semibold">ICU Units</div>
                        <div class="fs-4 fw-bold text-dark">@Model.TotalIcusCount</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md">
            <div class="card border-0 shadow-sm rounded-3 p-3 bg-white">
                <div class="d-flex align-items-center">
                    <div class="rounded-3 bg-success-subtle text-success p-3 me-3">
                        <i class="bi bi-check-circle fs-4"></i>
                    </div>
                    <div>
                        <div class="text-muted small fw-semibold">Active Units</div>
                        <div class="fs-4 fw-bold text-success">@Model.ActiveIcusCount</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md">
            <div class="card border-0 shadow-sm rounded-3 p-3 bg-white">
                <div class="d-flex align-items-center">
                    <div class="rounded-3 bg-info-subtle text-info-emphasis p-3 me-3">
                        <i class="bi bi-layout-wtf fs-4"></i>
                    </div>
                    <div>
                        <div class="text-muted small fw-semibold">Total Beds</div>
                        <div class="fs-4 fw-bold text-info-emphasis">@Model.TotalBedCapacity</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md">
            <div class="card border-0 shadow-sm rounded-3 p-3 bg-white">
                <div class="d-flex align-items-center">
                    <div class="rounded-3 bg-danger-subtle text-danger p-3 me-3">
                        <i class="bi bi-heart-pulse-fill fs-4"></i>
                    </div>
                    <div>
                        <div class="text-muted small fw-semibold">Ventilator Beds</div>
                        <div class="fs-4 fw-bold text-danger">@Model.TotalVentilatorCapacity</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md">
            <div class="card border-0 shadow-sm rounded-3 p-3 bg-white">
                <div class="d-flex align-items-center">
                    <div class="rounded-3 bg-warning-subtle text-warning-emphasis p-3 me-3">
                        <i class="bi bi-calculator fs-4"></i>
                    </div>
                    <div>
                        <div class="text-muted small fw-semibold">Active Tariffs</div>
                        <div class="fs-4 fw-bold text-warning-emphasis">@Model.ActiveTariffsCount</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Unified Master Card with Tabs -->
    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-header bg-white border-bottom pt-3 pb-0">
            <ul class="nav nav-tabs card-header-tabs" id="icuTabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link fw-semibold @(isIcusActive ? "active" : "")" id="icus-tab" data-bs-toggle="tab" data-bs-target="#icus-pane" type="button" role="tab">
                        <i class="bi bi-hospital me-2"></i>ICU Configurations (Header)
                        <span class="badge bg-primary-subtle text-primary border ms-2">@icus.Count</span>
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link fw-semibold @(!isIcusActive ? "active" : "")" id="tariffs-tab" data-bs-toggle="tab" data-bs-target="#tariffs-pane" type="button" role="tab">
                        <i class="bi bi-calculator me-2"></i>ICU Tariff Master (Header & Dynamic Details)
                        <span class="badge bg-secondary-subtle text-secondary border ms-2">@tariffs.Count</span>
                    </button>
                </li>
            </ul>
        </div>

        <div class="tab-content" id="icuTabsContent">
            <!-- TAB 1: ICU Configurations -->
            <div class="tab-pane fade @(isIcusActive ? "show active" : "") p-3" id="icus-pane" role="tabpanel">
                <!-- Filters -->
                <div class="bg-light p-3 rounded-3 mb-3">
                    <form method="get" asp-action="Index" class="row g-2 align-items-end">
                        <input type="hidden" name="tab" value="icus" />
                        <div class="col-md-5">
                            <label class="form-label small fw-semibold text-muted mb-1">Ward / Location</label>
                            <select name="wardId" class="form-select form-select-sm" onchange="this.form.submit()">
                                <option value="">-- All Wards --</option>
                                @foreach (var opt in Model.WardOptions)
                                {
                                    <option value="@opt.Value" selected="@(opt.Value == Model.SelectedWardId?.ToString())">@opt.Text</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold text-muted mb-1">ICU Type</label>
                            <select name="icuType" class="form-select form-select-sm" onchange="this.form.submit()">
                                <option value="">-- All Types (ICU, HDU, NICU, PICU, CCU) --</option>
                                @foreach (var opt in Model.IcuTypeOptions)
                                {
                                    <option value="@opt.Value" selected="@(opt.Value == Model.SelectedIcuType)">@opt.Text</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-3 d-flex gap-2">
                            <button type="submit" class="btn btn-sm btn-primary flex-grow-1">
                                <i class="bi bi-filter me-1"></i>Filter
                            </button>
                            @if (Model.SelectedWardId.HasValue || !string.IsNullOrWhiteSpace(Model.SelectedIcuType))
                            {
                                <a asp-action="Index" asp-route-tab="icus" class="btn btn-sm btn-outline-secondary" title="Clear Filters">
                                    <i class="bi bi-x-circle"></i>
                                </a>
                            }
                        </div>
                    </form>
                </div>

                <!-- Table -->
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-3">ICU Unit Details</th>
                                <th>Type</th>
                                <th>Ward & Location</th>
                                <th class="text-center">Bed Capacity</th>
                                <th class="text-center">Ventilators</th>
                                <th class="text-center">Isolation</th>
                                <th>Tariff Packages</th>
                                <th>Status</th>
                                <th class="text-end pe-3">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (icus.Count == 0)
                            {
                                <tr>
                                    <td colspan="9" class="text-center py-5 text-muted">
                                        <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                                        No ICU configurations found. Click "Add ICU Configuration" to setup an intensive care unit.
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var item in icus)
                                {
                                    <tr>
                                        <td class="ps-3">
                                            <div class="fw-semibold text-dark">@item.IcuName</div>
                                            <div class="small text-muted font-monospace text-primary fw-bold">@item.IcuCode</div>
                                        </td>
                                        <td>
                                            <span class="badge bg-primary-subtle text-primary border fs-6">
                                                @item.IcuType
                                            </span>
                                        </td>
                                        <td>
                                            <div class="fw-medium">@item.WardName</div>
                                            <div class="small text-muted">@(string.IsNullOrWhiteSpace(item.FloorName) ? "—" : item.FloorName)</div>
                                        </td>
                                        <td class="text-center">
                                            <span class="badge bg-light text-dark border px-3 py-2 fs-6">
                                                <i class="bi bi-layout-wtf me-1 text-primary"></i>@item.BedCapacity
                                            </span>
                                        </td>
                                        <td class="text-center">
                                            @if (item.VentilatorCapacity > 0)
                                            {
                                                <span class="badge bg-danger-subtle text-danger border px-2 py-1">
                                                    <i class="bi bi-heart-pulse-fill me-1"></i>@item.VentilatorCapacity
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="text-muted small">0</span>
                                            }
                                        </td>
                                        <td class="text-center">
                                            @if (item.IsolationCapacity > 0)
                                            {
                                                <span class="badge bg-warning-subtle text-warning-emphasis border px-2 py-1">
                                                    <i class="bi bi-shield-shaded me-1"></i>@item.IsolationCapacity
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="text-muted small">0</span>
                                            }
                                        </td>
                                        <td>
                                            <a asp-action="Index" asp-route-tab="tariffs" asp-route-icuId="@item.IcuId" class="badge bg-info-subtle text-info-emphasis border text-decoration-none" title="View configured tariffs">
                                                <i class="bi bi-cash-coin me-1"></i>@item.ActiveTariffsCount Active (@item.TotalTariffsCount Total)
                                            </a>
                                        </td>
                                        <td>
                                            @if (item.IsActive)
                                            {
                                                <span class="badge bg-success-subtle text-success border border-success-subtle">Active</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger-subtle text-danger border border-danger-subtle">Inactive</span>
                                            }
                                        </td>
                                        <td class="text-end pe-3">
                                            <div class="btn-group btn-group-sm">
                                                <button type="button" class="btn btn-outline-info" onclick="openViewIcuModal(@item.IcuId)" title="View ICU Details">
                                                    <i class="bi bi-eye"></i>
                                                </button>
                                                <button type="button" class="btn btn-outline-success" onclick="openAddTariffForIcu(@item.IcuId)" title="Configure Tariff">
                                                    <i class="bi bi-plus-lg"></i> Tariff
                                                </button>
                                                <button type="button" class="btn btn-outline-primary" onclick="openEditIcuModal(@item.IcuId)" title="Edit ICU">
                                                    <i class="bi bi-pencil"></i>
                                                </button>
                                                <form asp-action="ToggleIcuStatus" asp-route-id="@item.IcuId" method="post" class="d-inline" onsubmit="return confirm('Toggle active status for this ICU?');">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-outline-warning" title="@(item.IsActive ? "Deactivate" : "Activate")">
                                                        <i class="bi @(item.IsActive ? "bi-slash-circle" : "bi-check-circle")"></i>
                                                    </button>
                                                </form>
                                                <form asp-action="DeleteIcu" asp-route-id="@item.IcuId" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to remove this ICU configuration?');">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-outline-danger" title="Delete">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- TAB 2: Dynamic ICU Tariff Master -->
            <div class="tab-pane fade @(!isIcusActive ? "show active" : "") p-3" id="tariffs-pane" role="tabpanel">
                <!-- Filters -->
                <div class="bg-light p-3 rounded-3 mb-3">
                    <form method="get" asp-action="Index" class="row g-2 align-items-end">
                        <input type="hidden" name="tab" value="tariffs" />
                        <div class="col-md-5">
                            <label class="form-label small fw-semibold text-muted mb-1">ICU Unit</label>
                            <select name="icuId" class="form-select form-select-sm" onchange="this.form.submit()">
                                <option value="">-- All ICU Units --</option>
                                @foreach (var opt in Model.IcuOptions)
                                {
                                    <option value="@opt.Value" selected="@(opt.Value == Model.SelectedIcuId?.ToString())">@opt.Text</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold text-muted mb-1">Tariff Category</label>
                            <select name="tariffCategoryId" class="form-select form-select-sm" onchange="this.form.submit()">
                                <option value="">-- All Tariff Categories --</option>
                                @foreach (var opt in Model.TariffCategoryOptions)
                                {
                                    <option value="@opt.Value" selected="@(opt.Value == Model.SelectedTariffCategoryId?.ToString())">@opt.Text</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-3 d-flex gap-2">
                            <button type="submit" class="btn btn-sm btn-primary flex-grow-1">
                                <i class="bi bi-filter me-1"></i>Filter
                            </button>
                            @if (Model.SelectedIcuId.HasValue || Model.SelectedTariffCategoryId.HasValue)
                            {
                                <a asp-action="Index" asp-route-tab="tariffs" class="btn btn-sm btn-outline-secondary" title="Clear Filters">
                                    <i class="bi bi-x-circle"></i>
                                </a>
                            }
                        </div>
                    </form>
                </div>

                <!-- Tariffs Table -->
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-3">ICU Unit</th>
                                <th>Tariff Category</th>
                                <th>Dynamic Rate Heads Breakdown</th>
                                <th>Total Rate</th>
                                <th>Effective Period</th>
                                <th>Status</th>
                                <th class="text-end pe-3">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (tariffs.Count == 0)
                            {
                                <tr>
                                    <td colspan="7" class="text-center py-5 text-muted">
                                        <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                                        No ICU dynamic tariffs configured. Click "Configure Dynamic Tariff" to set rate heads.
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var item in tariffs)
                                {
                                    <tr>
                                        <td class="ps-3">
                                            <div class="fw-semibold text-dark">
                                                <a href="javascript:void(0)" onclick="openViewTariffModal(@item.IcuTariffId)" class="text-dark text-decoration-none fw-bold hover-primary">
                                                    @item.IcuName
                                                </a>
                                            </div>
                                            <div class="small text-muted">
                                                <span class="font-monospace text-primary fw-bold">@item.IcuCode</span>
                                                <span class="mx-1">•</span>
                                                <span class="badge bg-primary-subtle text-primary">@item.IcuType</span>
                                            </div>
                                        </td>
                                        <td>
                                            <span class="fw-bold text-primary">@item.TariffCategoryName</span>
                                            @if (!string.IsNullOrWhiteSpace(item.PatientCategory))
                                            {
                                                <span class="badge bg-secondary-subtle text-secondary ms-1">@item.PatientCategory</span>
                                            }
                                        </td>
                                        <td style="max-width: 380px;">
                                            <div class="d-flex align-items-center justify-content-between mb-1">
                                                <span class="fw-semibold text-dark"><i class="bi bi-list-stars me-1 text-primary"></i>@item.TotalRateHeadsCount Components:</span>
                                                <button type="button" class="btn btn-xs btn-outline-info py-0 px-2 rounded-pill" onclick="openViewTariffModal(@item.IcuTariffId)" title="View All Rate Heads">
                                                    <i class="bi bi-eye me-1"></i>View All
                                                </button>
                                            </div>
                                            <div class="small text-muted text-truncate" title="@item.RateHeadsSummary">
                                                @item.RateHeadsSummary
                                            </div>
                                        </td>
                                        <td>
                                            <span class="fs-5 fw-bold text-success font-monospace">@item.TotalRate.ToString("C2")</span>
                                        </td>
                                        <td>
                                            <div><i class="bi bi-calendar-event me-1 text-muted"></i>@item.EffectiveFrom.ToString("dd MMM yyyy")</div>
                                            <small class="text-muted">
                                                @(item.EffectiveTo.HasValue ? $"to {item.EffectiveTo.Value:dd MMM yyyy}" : "Ongoing")
                                            </small>
                                        </td>
                                        <td>
                                            @if (item.IsActive)
                                            {
                                                <span class="badge bg-success-subtle text-success border border-success-subtle">Active</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger-subtle text-danger border border-danger-subtle">Inactive</span>
                                            }
                                        </td>
                                        <td class="text-end pe-3">
                                            <div class="btn-group btn-group-sm">
                                                <button type="button" class="btn btn-outline-info" onclick="openViewTariffModal(@item.IcuTariffId)" title="View Details">
                                                    <i class="bi bi-eye"></i>
                                                </button>
                                                <button type="button" class="btn btn-outline-primary" onclick="openEditTariffModal(@item.IcuTariffId)" title="Edit Tariff">
                                                    <i class="bi bi-pencil"></i>
                                                </button>
                                                <form asp-action="ToggleTariffStatus" asp-route-id="@item.IcuTariffId" method="post" class="d-inline" onsubmit="return confirm('Toggle status for this tariff package?');">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-outline-warning" title="@(item.IsActive ? "Deactivate" : "Activate")">
                                                        <i class="bi @(item.IsActive ? "bi-slash-circle" : "bi-check-circle")"></i>
                                                    </button>
                                                </form>
                                                <form asp-action="DeleteTariff" asp-route-id="@item.IcuTariffId" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to remove this dynamic tariff package?');">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-outline-danger" title="Delete">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ========================================================================= -->
<!-- MODAL: ADD ICU CONFIGURATION                                              -->
<!-- ========================================================================= -->
<div class="modal fade" id="addIcuModal" tabindex="-1" aria-labelledby="addIcuModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-light">
                <h5 class="modal-title fw-bold" id="addIcuModalLabel"><i class="bi bi-hospital me-2 text-primary"></i>Add ICU Configuration</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="CreateIcu" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body p-4">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Ward / Location <span class="text-danger">*</span></label>
                            <select name="WardId" class="form-select" required>
                                <option value="">-- Select IPD Ward --</option>
                                @foreach (var opt in Model.WardOptions)
                                {
                                    <option value="@opt.Value">@opt.Text</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">ICU Type <span class="text-danger">*</span></label>
                            <select name="IcuType" class="form-select" required>
                                @foreach (var opt in Model.IcuTypeOptions)
                                {
                                    <option value="@opt.Value">@opt.Text</option>
                                }
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold">ICU Code <span class="text-danger">*</span></label>
                            <input name="IcuCode" class="form-control font-monospace" placeholder="e.g. ICU-MAIN-01, NICU-01" style="text-transform:uppercase" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">ICU Name <span class="text-danger">*</span></label>
                            <input name="IcuName" class="form-control" placeholder="e.g. Main Medical Intensive Care Unit" required />
                        </div>

                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Total Bed Capacity <span class="text-danger">*</span></label>
                            <input name="BedCapacity" class="form-control" type="number" min="1" max="500" value="10" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Ventilator Beds</label>
                            <input name="VentilatorCapacity" class="form-control" type="number" min="0" max="500" value="4" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Isolation Beds</label>
                            <input name="IsolationCapacity" class="form-control" type="number" min="0" max="500" value="1" />
                        </div>

                        <div class="col-12">
                            <label class="form-label fw-semibold">Clinical Scope / Description</label>
                            <textarea name="Description" class="form-control" rows="2" placeholder="Optional notes regarding medical capabilities..."></textarea>
                        </div>

                        <div class="col-12">
                            <div class="form-check form-switch">
                                <input name="IsActive" class="form-check-input" type="checkbox" role="switch" value="true" checked id="addIcuIsActive" />
                                <label class="form-check-label fw-semibold" for="addIcuIsActive">Active Status</label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Save Configuration</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ========================================================================= -->
<!-- MODAL: EDIT ICU CONFIGURATION                                             -->
<!-- ========================================================================= -->
<div class="modal fade" id="editIcuModal" tabindex="-1" aria-labelledby="editIcuModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-light">
                <h5 class="modal-title fw-bold" id="editIcuModalLabel"><i class="bi bi-pencil-square me-2 text-primary"></i>Edit ICU Configuration</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="EditIcu" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="IcuId" id="editIcuId" />
                <div class="modal-body p-4">
                    <div class="row g-3">
