@model EMR.Web.Models.ViewModels.IpdPatientView
@* IPD Patient > ICU Chart (Phase 8, SQLScripts/2493): hourly flowsheet, infusions, device use, ICU stays; js/ipd/icu.js *@
<div class="tab-pane fade @(Model.Tab == "icu" ? "show active" : "")" id="tab-icu" role="tabpanel">
    <div class="reg-section">
        <div class="reg-section-header"><div class="sec-icon violet"><i class="bi bi-activity"></i></div>
            <div class="flex-grow-1"><h6 class="fw-bold mb-0">ICU Chart</h6><small class="text-muted" id="icuSub">Flowsheet, infusions and devices while the patient is in an ICU bed; ICU days are charged from the ICU Tariff</small></div>
            <div class="d-flex gap-2 flex-wrap">
                <select id="icuWindow" class="form-select form-select-sm" style="width:auto"><option value="24">Last 24 h</option><option value="12">Last 12 h</option><option value="48">Last 48 h</option><option value="72">Last 72 h</option></select>
                <button type="button" class="btn btn-sm btn-outline-secondary" id="icuPrint"><i class="bi bi-printer me-1"></i>Print chart</button>
            </div></div>
    </div>
    <div id="icuBody"><div class="text-muted small p-3">Loading…</div></div>
</div>
