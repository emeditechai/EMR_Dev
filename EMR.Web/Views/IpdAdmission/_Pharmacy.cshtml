@model EMR.Web.Models.ViewModels.IpdPatientView
@{
    var panes = new (string Key, string Head, string Title, string Sub, string Icon, string Color)[]
    {
        ("indent", "PHARMACY", "Medicines", "Issue medicines from the pharmacy store against the IP number (FEFO batches); unused quantity can be returned before the final bill", "bi-capsule", "green"),
        ("consumables", "CONSUMABLE", "Consumables", "Ward and surgical consumables from the pharmacy store, charged to the IP bill", "bi-bandaid", "amber")
    };
}
@foreach (var p in panes)
{
    <div class="tab-pane fade @(Model.Tab == p.Key ? "show active" : "")" id="tab-@p.Key" role="tabpanel">
        <div class="reg-section">
            <div class="reg-section-header"><div class="sec-icon @p.Color"><i class="bi @p.Icon"></i></div>
                <div class="flex-grow-1"><h6 class="fw-bold mb-0">@p.Title</h6><small class="text-muted">@p.Sub</small></div></div>
            <div class="ipd-ph-form" data-head="@p.Head"></div>
        </div>
        <div class="ipdx-card mb-3"><div class="table-responsive"><table class="table ipdx-table mb-0">
            <thead><tr><th>Issued</th><th>Item / batch</th><th class="text-end">Qty</th><th class="text-end">Returned</th><th class="text-end">Rate</th><th class="text-end">Amount</th><th>By</th><th></th></tr></thead>
            <tbody class="ipd-ph-rows" data-head="@p.Head"><tr><td colspan="8" class="text-muted small">Loading…</td></tr></tbody>
        </table></div></div>
        <div class="ipdx-card"><div class="px-3 pt-2 small fw-bold text-muted text-uppercase">Returns</div><div class="table-responsive"><table class="table ipdx-table mb-0">
            <thead><tr><th>Return</th><th>Item / batch</th><th class="text-end">Qty</th><th class="text-end">Amount</th><th>Reason</th><th>By</th></tr></thead>
            <tbody class="ipd-ph-returns" data-head="@p.Head"></tbody>
        </table></div></div>
    </div>
}
