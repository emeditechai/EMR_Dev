@{
    // IPD > Discharges (Phase 7, SQLScripts/2557): discharges in progress with their milestones and TAT against the target,
    // the discharge register of a period, NABH indicators (discharge TAT, LAMA / DAMA %, mortality) and the death register.
    ViewData["Title"] = "Discharges";
}
@section HeadStyles {
    <link rel="stylesheet" href="~/css/ipd.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/ipd-discharge.css" asp-append-version="true" />
}
<div class="ipdx-section-head mb-3">
    <div><h2 class="fs-4"><i class="bi bi-door-open me-2 text-primary"></i>Discharges</h2><p>Discharge tracker, register and NABH indicators of this branch. <span id="asOf"></span></p></div>
    <div class="d-flex gap-2 flex-wrap align-items-end">
        <div><label class="form-label small mb-0" for="fFrom">From</label><input type="date" id="fFrom" class="form-control form-control-sm" /></div>
        <div><label class="form-label small mb-0" for="fTo">To</label><input type="date" id="fTo" class="form-control form-control-sm" /></div>
        <div><label class="form-label small mb-0" for="fType">Type</label><select id="fType" class="form-select form-select-sm"><option value="">All</option><option value="NORMAL">Normal</option><option value="LAMA">LAMA</option><option value="DAMA">DAMA</option><option value="ABSCONDED">Absconded</option><option value="TRANSFER">Transfer out</option><option value="DEATH">Death</option></select></div>
        <div><label class="form-label small mb-0" for="fSearch">Search</label><input id="fSearch" class="form-control form-control-sm" placeholder="Name, UHID, IP no., mobile" /></div>
        <button type="button" class="btn btn-sm btn-primary" id="go"><i class="bi bi-search"></i></button>
        <button type="button" class="btn btn-sm btn-light border" id="printView" title="Print this view"><i class="bi bi-printer"></i></button>
    </div>
</div>
<div class="ipdx-kpis mb-3 dis-kpis" id="kpis"></div>
<ul class="nav nav-tabs mb-0" role="tablist">
    <li class="nav-item"><button class="nav-link active" data-bs-toggle="tab" data-bs-target="#pProgress" type="button" role="tab">In progress <span class="badge bg-warning text-dark" id="nProgress">0</span></button></li>
    <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#pDone" type="button" role="tab">Discharged <span class="badge bg-secondary" id="nDone">0</span></button></li>
    <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#pDeath" type="button" role="tab">Death register <span class="badge bg-dark" id="nDeath">0</span></button></li>
</ul>
<div class="tab-content ipdx-card" style="border-top-left-radius:0">
    <div class="tab-pane fade show active" id="pProgress" role="tabpanel"><div class="table-responsive" id="tProgress"></div></div>
    <div class="tab-pane fade" id="pDone" role="tabpanel"><div class="table-responsive" id="tDone"></div></div>
    <div class="tab-pane fade" id="pDeath" role="tabpanel"><div class="table-responsive" id="tDeath"></div></div>
</div>
@section Scripts {
    <script src="~/js/ipd.js" asp-append-version="true"></script>
    <script>window.DisBoard = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(new { @base = Url.Content("~/IpdDischarge/"), canPatient = ViewData["CanPatient"] as bool? ?? false }));</script>
    <script src="~/js/ipd/discharge-board.js" asp-append-version="true"></script>
}
