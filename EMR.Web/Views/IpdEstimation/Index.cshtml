@{ ViewData["Title"] = "Current Billing Estimation"; }
@section HeadStyles { <link rel="stylesheet" href="~/css/ipd.css" asp-append-version="true" /> }
<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <div><h1 class="h3 mb-0 fw-bold"><i class="bi bi-calculator me-2 text-primary"></i>Current Billing Estimation</h1>
        <small class="text-muted">Every admitted patient's bill as it stands now, live · <span id="asOf"></span></small></div>
    <div class="d-flex gap-2"><a asp-action="PreAdmission" class="btn btn-outline-secondary"><i class="bi bi-file-earmark-medical me-1"></i>Pre-admission Estimates</a>
        <button type="button" id="refresh" class="btn btn-outline-secondary"><i class="bi bi-arrow-clockwise"></i></button></div>
</div>
<div class="row g-3 mb-3" id="tiles"></div>
<div class="reg-section"><div class="reg-section-body py-3"><div class="row g-2 align-items-end">
    <div class="col-12 col-md-4"><label class="form-label" for="fSearch">Search</label><input id="fSearch" class="form-control" placeholder="IP no., UHID, name, mobile, bed" /></div>
    <div class="col-6 col-md-3"><label class="form-label" for="fWard">Ward</label><select id="fWard" class="form-select"><option value="">All wards</option></select></div>
    <div class="col-6 col-md-3"><label class="form-label" for="fPayer">Payer</label><select id="fPayer" class="form-select"><option value="">All</option><option value="CASH">Cash</option><option value="CORPORATE">Corporate</option><option value="INSURANCE">Insurance / TPA</option><option value="SCHEME">Govt. scheme</option></select></div>
    <div class="col-12 col-md-2"><div class="form-check form-switch mb-2"><input class="form-check-input" type="checkbox" id="fAlert" /><label class="form-check-label" for="fAlert">Deposit alerts only</label></div></div>
</div></div></div>
<div class="reg-section"><div class="reg-section-body p-0"><div class="table-responsive"><table class="table table-hover ipd-table mb-0">
    <thead><tr><th>Patient</th><th>IP No.</th><th>Ward / bed</th><th>Payer</th><th class="text-end">Day</th><th class="text-end">Bill if discharged now</th><th class="text-end">Advance</th><th class="text-end">Balance due</th><th></th></tr></thead>
    <tbody id="rows"><tr><td colspan="9" class="text-center text-muted py-4">Loading…</td></tr></tbody>
</table></div></div></div>
@section Scripts {
<script src="~/js/ipd.js" asp-append-version="true"></script>
<script>window.IpdPage = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(new { @base = Url.Content("~/IpdEstimation/") }));</script>
<script src="~/js/ipd/due-list.js" asp-append-version="true"></script>
}
