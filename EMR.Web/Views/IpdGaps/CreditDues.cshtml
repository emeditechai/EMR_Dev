@{
    ViewData["Title"] = "IPD Credit Dues";
}
@section HeadStyles { <link rel="stylesheet" href="~/css/ipd.css" asp-append-version="true" /> }
@Html.AntiForgeryToken()
<div class="ipdx-section-head mb-3">
    <div><h2 class="fs-4"><i class="bi bi-hourglass-split me-2 text-danger"></i>Credit Dues</h2>
        <p>Discharged patients with a balance on the final bill: credit discharges, TPA disallowances moved to the patient, supplementary bills. Collect on the patient's Billing tab.</p></div>
</div>
<div class="ipdx-kpis mb-3" id="kpis" style="grid-template-columns:repeat(3, minmax(0, 1fr))"></div>
<div class="ipdx-card p-3 mb-3"><div class="row g-2 align-items-end">
    <div class="col-12 col-lg-6"><label class="form-label small fw-semibold" for="fSearch">Find</label><input id="fSearch" class="form-control form-control-sm" placeholder="IP no., UHID, mobile or name" /></div>
    <div class="col-12 col-lg-2"><button type="button" class="btn btn-sm btn-primary w-100" id="fLoad"><i class="bi bi-search me-1"></i>Show</button></div>
</div></div>
<div class="ipdx-card"><div class="table-responsive"><table class="table ipdx-table mb-0">
    <thead><tr><th>Patient</th><th>IP No. / bill</th><th>Discharged</th><th>Why due</th><th class="text-end">Balance due</th><th class="text-end">Days</th><th>Last payment</th><th></th></tr></thead>
    <tbody id="rows"><tr><td colspan="8" class="text-muted small">Loading…</td></tr></tbody>
</table></div></div>
@section Scripts {
    <script src="~/js/ipd.js" asp-append-version="true"></script>
    <script>window.IpdPage = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(new { @base = Url.Content("~/IpdGaps/") }));</script>
    <script src="~/js/ipd/credit-dues.js" asp-append-version="true"></script>
}
