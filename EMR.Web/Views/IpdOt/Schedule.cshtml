@{
    // IPD > OT Schedule (Phase 8, SQLScripts/2492, 2494): every OT of the branch for a day with its bookings; book / change / cancel.
    ViewData["Title"] = "OT Schedule";
    bool Can(string c) => ViewData["Can" + c] as bool? ?? false;
}
@section HeadStyles {
    <link rel="stylesheet" href="~/lib/select2/dist/css/select2.min.css" />
    <link rel="stylesheet" href="~/lib/select2-bootstrap-5-theme/dist/select2-bootstrap-5-theme.min.css" />
    <link rel="stylesheet" href="~/css/ipd.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/ipd-ot-icu.css" asp-append-version="true" />
}
@Html.AntiForgeryToken()
<div class="ipdx-section-head mb-3">
    <div><h2 class="fs-4"><i class="bi bi-calendar2-week me-2 text-danger"></i>OT Schedule</h2><p>Operation theatres of this branch: bookings, patients in OT, completed surgeries. <span id="asOf"></span></p></div>
    <div class="d-flex gap-2 flex-wrap align-items-center">
        <button type="button" class="btn btn-sm btn-light border" id="prevDay" title="Previous day"><i class="bi bi-chevron-left"></i></button>
        <input type="date" id="day" class="form-control form-control-sm" style="width:auto" />
        <button type="button" class="btn btn-sm btn-light border" id="nextDay" title="Next day"><i class="bi bi-chevron-right"></i></button>
        <button type="button" class="btn btn-sm btn-light border" id="today">Today</button>
        <select id="otFilter" class="form-select form-select-sm" style="width:auto"><option value="">All OTs</option></select>
        <label class="form-check-label small"><input type="checkbox" class="form-check-input me-1" id="showCancelled" />Cancelled</label>
        @if (Can("BOOK")) { <button type="button" class="btn btn-sm btn-danger" id="bookNew"><i class="bi bi-calendar-plus me-1"></i>Book OT</button> }
        <button type="button" class="btn btn-sm btn-outline-secondary" onclick="window.print()" title="Print"><i class="bi bi-printer"></i></button>
    </div>
</div>
<div class="ipdx-kpis mb-3" id="kpis" style="grid-template-columns:repeat(5, minmax(0, 1fr))"></div>
<div id="board" class="ot-board"><div class="text-muted small p-3">Loading…</div></div>
@section Scripts {
    <script src="~/lib/select2/dist/js/select2.min.js"></script>
    <script src="~/js/ipd.js" asp-append-version="true"></script>
    <script>window.OtPage = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(new { @base = Url.Content("~/IpdOt/"), patient = Url.Content("~/IpdAdmission/Patient/"), can = new { book = Can("BOOK"), cancel = Can("CANCEL"), patient = Can("PATIENT") } }));</script>
    <script src="~/js/ipd/ot-book.js" asp-append-version="true"></script>
    <script src="~/js/ipd/ot-schedule.js" asp-append-version="true"></script>
}
