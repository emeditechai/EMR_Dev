@model EMR.Web.Models.ViewModels.LabAntibioticIndexViewModel

@{
    ViewData["Title"] = "Antibiotic Master";
}

<div class="container-fluid px-4 py-3">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                    <li class="breadcrumb-item text-muted">Lab Master</li>
                    <li class="breadcrumb-item active" aria-current="page">Antibiotic Master</li>
                </ol>
            </nav>
            <h4 class="fw-bold mb-0 text-primary">
                <i class="bi bi-capsule-pill me-2"></i>Antibiotic Master
            </h4>
        </div>
        <div>
            <a asp-permission="MASTER.LABANTIBIOTICS:ADD" asp-action="Create" class="btn btn-primary px-3 shadow-sm">
                <i class="bi bi-plus-lg me-1"></i> Add New Antibiotic
            </a>
        </div>
    </div>

    @await Html.PartialAsync("_LabMasterDashboard", Model.Dashboard)

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-3">
            <form method="get" asp-action="Index" class="row g-3 align-items-end">
                <div class="col-md-3">
                    <label class="form-label small fw-semibold text-muted">Status</label>
                    <select name="status" class="form-select" asp-items="Model.StatusOptions">
                        <option value="">-- All Statuses --</option>
                    </select>
                </div>
                <div class="col-md-5">
                    <label class="form-label small fw-semibold text-muted">Search</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
                        <input type="text" name="search" class="form-control border-start-0" value="@Model.SearchTerm" placeholder="Antibiotic name, abbreviation, class..." />
                    </div>
                </div>
                <div class="col-md-3 d-flex gap-2">
                    <button type="submit" class="btn btn-secondary w-100 fw-semibold">
                        <i class="bi bi-funnel me-1"></i> Filter
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary" title="Reset Filters">
                        <i class="bi bi-arrow-counterclockwise"></i>
                    </a>
                </div>
            </form>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light border-bottom">
                        <tr>
                            <th class="ps-4" style="width: 60px;">#</th>
                            <th>Antibiotic Code</th>
                            <th>Antibiotic Name</th>
                            <th>Abbreviation</th>
                            <th>Antibiotic Class</th>
                            <th>Route</th>
                            <th class="text-center" style="width: 120px;">Status</th>
                            <th class="text-end pe-4" style="width: 160px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Items.Any())
                        {
                            <tr>
                                <td colspan="8" class="text-center py-5 text-muted">
                                    <i class="bi bi-inbox display-6 d-block mb-2 text-secondary"></i>
                                    No records found matching your search criteria.
                                </td>
                            </tr>
                        }
                        else
                        {
                            var rowNum = 0;
                            @foreach (var item in Model.Items)
                            {
                                rowNum++;
                                <tr>
                                    <td class="ps-4 fw-semibold text-muted">@rowNum</td>
                                    <td><span class="badge bg-light text-dark border font-monospace px-2 py-1">@item.Antibiotic_Code</span></td>
                                    <td>@(string.IsNullOrWhiteSpace(item.Antibiotic_Name) ? "—" : item.Antibiotic_Name)</td>
                                    <td>@(string.IsNullOrWhiteSpace(item.Abbreviation) ? "—" : item.Abbreviation)</td>
                                    <td><span class="badge bg-light text-dark border">@item.Antibiotic_Class</span></td>
                                    <td>@(string.IsNullOrWhiteSpace(item.Route) ? "—" : item.Route)</td>
                                    <td class="text-center">
                                        <form asp-permission="MASTER.LABANTIBIOTICS:STATUS" asp-action="ToggleStatus" asp-encrypted-id="@item.Antibiotic_ID" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="status" value="@(!item.Status ? "true" : "false")" />
                                            <button type="submit" class="btn btn-link p-0 text-decoration-none" title="Click to toggle status">
                                                @if (item.Status)
                                                {
                                                    <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-1 rounded-pill"><i class="bi bi-check-circle-fill me-1"></i>Active</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-3 py-1 rounded-pill"><i class="bi bi-x-circle-fill me-1"></i>Inactive</span>
                                                }
                                            </button>
                                        </form>
                                    </td>
                                    <td class="text-end pe-4">
                                        <div class="btn-group btn-group-sm shadow-sm" role="group">
                                            <a asp-permission="MASTER.LABANTIBIOTICS:DETAILS" asp-action="Details" asp-encrypted-id="@item.Antibiotic_ID" class="btn btn-outline-info" title="View Details"><i class="bi bi-eye"></i></a>
                                            <a asp-permission="MASTER.LABANTIBIOTICS:EDIT" asp-action="Edit" asp-encrypted-id="@item.Antibiotic_ID" class="btn btn-outline-primary" title="Edit"><i class="bi bi-pencil"></i></a>
                                            <button asp-permission="MASTER.LABANTIBIOTICS:DELETE" type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteModal-@item.Antibiotic_ID" title="Delete"><i class="bi bi-trash"></i></button>
                                        </div>

                                        <div class="modal fade text-start" id="deleteModal-@item.Antibiotic_ID" tabindex="-1" aria-hidden="true">
                                            <div class="modal-dialog modal-dialog-centered">
                                                <div class="modal-content">
                                                    <div class="modal-header bg-danger text-white">
                                                        <h5 class="modal-title"><i class="bi bi-exclamation-triangle-fill me-2"></i>Confirm Delete</h5>
                                                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                                                    </div>
                                                    <div class="modal-body">
                                                        Are you sure you want to delete <strong>@item.Antibiotic_Name</strong> (Code: <code>@item.Antibiotic_Code</code>)?
                                                    </div>
                                                    <div class="modal-footer">
                                                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                                        <form asp-permission="MASTER.LABANTIBIOTICS:DELETE" asp-action="Delete" asp-encrypted-id="@item.Antibiotic_ID" method="post">
                                                            @Html.AntiForgeryToken()
                                                            <button type="submit" class="btn btn-danger">Delete</button>
                                                        </form>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
