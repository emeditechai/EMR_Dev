@model EMR.Web.ApiClients.Models.LabApprovalFlowDetailModel

@{
    ViewData["Title"] = "Pathologist Approval Flow Details";
    var f = Model.Flow;
    var levelColors = new[] { "#0f766e", "#0369a1", "#7c3aed" };
}

<div class="container-fluid px-4 py-3">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                    <li class="breadcrumb-item text-muted">Settings</li>
                    <li class="breadcrumb-item"><a asp-action="Index">Pathologist Approval Flow</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Details</li>
                </ol>
            </nav>
            <h4 class="fw-bold mb-0 text-primary"><i class="bi bi-eye me-2"></i>Approval Flow Details</h4>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Edit" asp-encrypted-id="@f.Flow_ID" class="btn btn-primary px-3 shadow-sm"><i class="bi bi-pencil me-1"></i> Edit Flow</a>
            <a asp-action="Index" class="btn btn-outline-secondary px-3"><i class="bi bi-arrow-left me-1"></i> Back to List</a>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-9">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-primary text-white p-3">
                    <h5 class="card-title mb-0 fw-semibold"><i class="bi bi-diagram-3-fill me-2"></i>@f.Flow_Code · @f.Flow_Name</h5>
                </div>
                <div class="card-body p-4">
                    <div class="row g-4">
                        <div class="col-md-4">
                            <label class="text-muted small fw-semibold text-uppercase d-block mb-1">Branch</label>
                            @if (f.Branch_ID.HasValue)
                            {
                                <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle px-3 py-2"><i class="bi bi-building me-1"></i>@f.BranchName</span>
                            }
                            else
                            {
                                <span class="badge bg-light text-muted border px-3 py-2"><i class="bi bi-globe me-1"></i>All Branches</span>
                            }
                        </div>
                        <div class="col-md-4">
                            <label class="text-muted small fw-semibold text-uppercase d-block mb-1">Department</label>
                            <span class="fw-semibold">@(f.Department_ID.HasValue ? f.DepartmentName : "All Departments")</span>
                        </div>
                        <div class="col-md-4">
                            <label class="text-muted small fw-semibold text-uppercase d-block mb-1">Test Categories</label>
                            @if (f.CategoryNameList.Any())
                            {
                                <div class="d-flex flex-wrap gap-1">
                                    @foreach (var cn in f.CategoryNameList)
                                    {
                                        <span class="badge border" style="background:#f3e8ff;color:#6b21a8;"><i class="bi bi-tag-fill me-1"></i>@cn</span>
                                    }
                                </div>
                            }
                            else
                            {
                                <span class="fw-semibold">All Test Categories</span>
                            }
                        </div>
                        <div class="col-md-4">
                            <label class="text-muted small fw-semibold text-uppercase d-block mb-1">Approval Levels</label>
                            <span class="badge bg-primary rounded-pill px-3 py-2">@f.Required_Levels</span>
                        </div>
                        <div class="col-md-4">
                            <label class="text-muted small fw-semibold text-uppercase d-block mb-1">Same Approver On Several Levels</label>
                            <span class="fw-semibold">@(f.Allow_Same_Approver ? "Allowed" : "Not allowed")</span>
                        </div>
                        <div class="col-md-4">
                            <label class="text-muted small fw-semibold text-uppercase d-block mb-1">Status</label>
                            @if (f.Status)
                            {
                                <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-1 rounded-pill"><i class="bi bi-check-circle-fill me-1"></i>Active</span>
                            }
                            else
                            {
                                <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-3 py-1 rounded-pill"><i class="bi bi-x-circle-fill me-1"></i>Inactive</span>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white py-3 border-bottom">
                    <h6 class="card-title fw-bold mb-0 text-dark"><i class="bi bi-list-ol me-2 text-primary"></i>Approval Sequence</h6>
                </div>
                <div class="card-body p-4">
                    @foreach (var level in Model.Levels.OrderBy(l => l.Level_No))
                    {
                        var people = Model.Approvers.Where(a => a.Level_No == level.Level_No).ToList();
                        var color = levelColors[Math.Clamp(level.Level_No - 1, 0, 2)];
                        <div class="d-flex gap-3 mb-3 pb-3 @(level.Level_No < Model.Levels.Count ? "border-bottom" : "")">
                            <div class="rounded-circle text-white fw-bold d-flex align-items-center justify-content-center flex-shrink-0" style="width:40px;height:40px;background:@color">@level.Level_No</div>
                            <div class="flex-grow-1">
                                <div class="fw-bold text-dark">@level.Level_Title</div>
                                <div class="mt-2 d-flex flex-wrap gap-2">
                                    @foreach (var p in people)
                                    {
                                        var ok = p.UserIsActive && p.UserIsPathologist;
                                        <span class="badge border px-3 py-2 @(ok ? "bg-light text-dark" : "bg-warning-subtle text-warning-emphasis border-warning-subtle")"
                                              title="@(ok ? "" : "This user is no longer an active pathologist")">
                                            <i class="bi bi-person-badge-fill me-1" style="color:@color"></i>@p.FullName
                                            @if (!string.IsNullOrWhiteSpace(p.RegistrationNo))
                                            {
                                                <span class="text-muted ms-1">· Reg: @p.RegistrationNo</span>
                                            }
                                            @if (!ok)
                                            {
                                                <i class="bi bi-exclamation-triangle-fill ms-1"></i>
                                            }
                                        </span>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                    <div class="d-flex gap-3 align-items-center">
                        <div class="rounded-circle text-white d-flex align-items-center justify-content-center flex-shrink-0" style="width:40px;height:40px;background:#166534"><i class="bi bi-check2-all"></i></div>
                        <div class="fw-bold text-success">Report final</div>
                    </div>
                </div>
            </div>

            <div class="row g-3 text-muted small">
                <div class="col-md-6">Created: @f.CreatedDate.ToString("dd MMM yyyy, hh:mm tt")</div>
                <div class="col-md-6">Last modified: @(f.ModifiedDate.HasValue ? f.ModifiedDate.Value.ToString("dd MMM yyyy, hh:mm tt") : "—")</div>
            </div>
        </div>
    </div>
</div>
