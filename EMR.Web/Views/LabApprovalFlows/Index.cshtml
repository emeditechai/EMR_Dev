@model EMR.Web.Models.ViewModels.LabApprovalFlowIndexViewModel

@{
    ViewData["Title"] = "Pathologist Approval Flow";
    var levelColors = new[] { "#0f766e", "#0369a1", "#7c3aed" };
}

<style>
    .lvl-chip { display: inline-flex; align-items: center; gap: .35rem; border: 1px solid #e2e8f0; border-radius: 2rem; padding: .15rem .6rem .15rem .2rem; font-size: .74rem; background: #fff; margin: 0 .25rem .25rem 0; max-width: 260px; }
    .lvl-chip b { width: 20px; height: 20px; border-radius: 50%; color: #fff; display: inline-flex; align-items: center; justify-content: center; font-size: .68rem; flex-shrink: 0; }
    .lvl-chip span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
</style>

<div class="container-fluid px-4 py-3">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                    <li class="breadcrumb-item text-muted">Settings</li>
                    <li class="breadcrumb-item active" aria-current="page">Pathologist Approval Flow</li>
                </ol>
            </nav>
            <h4 class="fw-bold mb-0 text-primary"><i class="bi bi-diagram-3-fill me-2"></i>Pathologist Approval Flow</h4>
        </div>
        <a asp-action="Create" class="btn btn-primary px-3 shadow-sm"><i class="bi bi-plus-lg me-1"></i> Add New Flow</a>
    </div>

    <!-- KPI cards (whole company) -->
    <div class="row g-3 mb-4">
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm h-100"><div class="card-body p-3 d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small fw-semibold text-uppercase d-block">Total Flows</span>
                    <h3 class="fw-bold mb-0 text-primary">@Model.TotalCount</h3>
                    <span class="badge bg-success-subtle text-success mt-1">@Model.ActiveCount Active</span>
                </div>
                <div class="bg-primary text-white rounded-3 p-3 shadow-sm d-flex align-items-center justify-content-center" style="width:48px;height:48px;"><i class="bi bi-diagram-3-fill fs-4"></i></div>
            </div></div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm h-100"><div class="card-body p-3 d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small fw-semibold text-uppercase d-block">Company Default</span>
                    <h3 class="fw-bold mb-0 text-info">@Model.CompanyDefaultCount</h3>
                    <span class="badge bg-info-subtle text-info-emphasis mt-1">All branches &amp; tests</span>
                </div>
                <div class="bg-info text-white rounded-3 p-3 shadow-sm d-flex align-items-center justify-content-center" style="width:48px;height:48px;"><i class="bi bi-globe fs-4"></i></div>
            </div></div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm h-100"><div class="card-body p-3 d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small fw-semibold text-uppercase d-block">Overrides</span>
                    <h3 class="fw-bold mb-0 text-warning">@Model.OverrideCount</h3>
                    <span class="badge bg-warning-subtle text-warning-emphasis mt-1">Branch / Dept / Category</span>
                </div>
                <div class="bg-warning text-dark rounded-3 p-3 shadow-sm d-flex align-items-center justify-content-center" style="width:48px;height:48px;"><i class="bi bi-signpost-split-fill fs-4"></i></div>
            </div></div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm h-100 border-start border-4 border-success"><div class="card-body p-3">
                <span class="text-muted small fw-semibold text-uppercase d-block mb-1"><i class="bi bi-info-circle me-1"></i>How it applies</span>
                <div class="small text-secondary lh-sm">Most specific flow wins: <b>Category</b> &rarr; <b>Department</b> &rarr; <b>Branch</b> &rarr; <b>Company</b> default. No flow configured = single approval, as today.</div>
            </div></div>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Filter Card -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-3">
            <form method="get" asp-action="Index" class="row g-3 align-items-end">
                <div class="col-md-3">
                    <label class="form-label small fw-semibold text-muted">Branch</label>
                    <select name="branchScope" class="form-select flow-filter-select" asp-items="Model.BranchScopeOptions">
                        <option value="">-- All Scopes --</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-semibold text-muted">Department</label>
                    <select name="departmentId" class="form-select flow-filter-select" asp-items="Model.DepartmentOptions">
                        <option value="">-- All Departments --</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label small fw-semibold text-muted">Status</label>
                    <select name="status" class="form-select" asp-items="Model.StatusOptions">
                        <option value="">-- All --</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label small fw-semibold text-muted">Search</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
                        <input type="text" name="search" class="form-control border-start-0" value="@Model.SearchTerm" placeholder="Code, name..." />
                    </div>
                </div>
                <div class="col-md-2 d-flex gap-2">
                    <button type="submit" class="btn btn-secondary w-100 fw-semibold"><i class="bi bi-funnel me-1"></i> Filter</button>
                    <a asp-action="Index" class="btn btn-outline-secondary" title="Reset Filters"><i class="bi bi-arrow-counterclockwise"></i></a>
                </div>
            </form>
        </div>
    </div>

    <!-- Data Table Card -->
    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light border-bottom">
                        <tr>
                            <th class="ps-4" style="width: 100px;">Code</th>
                            <th style="width: 260px;">Flow &amp; Scope</th>
                            <th class="text-center" style="width: 90px;">Levels</th>
                            <th>Approvers</th>
                            <th class="text-center" style="width: 120px;">Status</th>
                            <th class="text-end pe-4" style="width: 180px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Flows.Any())
                        {
                            <tr>
                                <td colspan="6" class="text-center py-5 text-muted">
                                    <i class="bi bi-inbox display-6 d-block mb-2 text-secondary"></i>
                                    No approval flows found. Without a flow, reports keep the current single approval.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model.Flows)
                            {
                                var levels = (item.LevelsSummary ?? "").Split(" | ", StringSplitOptions.RemoveEmptyEntries);
                                <tr>
                                    <td class="ps-4 fw-semibold font-monospace text-muted">@item.Flow_Code</td>
                                    <td>
                                        <div class="fw-semibold text-dark">@item.Flow_Name</div>
                                        <div class="mt-1">
                                            @if (item.Branch_ID.HasValue)
                                            {
                                                <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle"><i class="bi bi-building me-1"></i>@item.BranchName</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-light text-muted border"><i class="bi bi-globe me-1"></i>All Branches</span>
                                            }
                                            @if (item.CategoryNameList.Any())
                                            {
                                                var catNames = item.CategoryNameList.ToList();
                                                @foreach (var cn in catNames.Take(2))
                                                {
                                                    <span class="badge border" style="background:#f3e8ff;color:#6b21a8;"><i class="bi bi-tag-fill me-1"></i>@cn</span>
                                                }
                                                @if (catNames.Count > 2)
                                                {
                                                    <span class="badge bg-light text-secondary border" title="@string.Join(", ", catNames.Skip(2))">+@(catNames.Count - 2) more</span>
                                                }
                                            }
                                            else if (item.Department_ID.HasValue)
                                            {
                                                <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle"><i class="bi bi-hospital me-1"></i>@item.DepartmentName</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-light text-muted border"><i class="bi bi-collection me-1"></i>All Tests</span>
                                            }
                                        </div>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge rounded-pill px-3 py-2 @(item.Required_Levels == 1 ? "bg-secondary" : item.Required_Levels == 2 ? "bg-primary" : "bg-success")">@item.Required_Levels</span>
                                    </td>
                                    <td>
                                        @for (int i = 0; i < levels.Length; i++)
                                        {
                                            var parts = levels[i].Split(": ", 2);
                                            var lvlNo = int.TryParse(parts[0].TrimStart('L'), out var ln) ? ln : i + 1;
                                            <span class="lvl-chip" title="@levels[i]">
                                                <b style="background:@levelColors[Math.Clamp(lvlNo - 1, 0, 2)]">@lvlNo</b>
                                                <span>@(parts.Length > 1 ? parts[1] : "")</span>
                                            </span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <form asp-action="ToggleStatus" asp-encrypted-id="@item.Flow_ID" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="status" value="@(!item.Status ? "true" : "false")" />
                                            <button type="submit" class="btn btn-link p-0 text-decoration-none" title="Click to toggle status">
                                                @if (item.Status)
                                                {
                                                    <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-1 rounded-pill"><i class="bi bi-check-circle-fill me-1"></i>Active</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-3 py-1 rounded-pill"><i class="bi bi-x-circle-fill me-1"></i>Inactive</span>
                                                }
                                            </button>
                                        </form>
                                    </td>
                                    <td class="text-end pe-4">
                                        <div class="btn-group btn-group-sm shadow-sm" role="group">
                                            <a asp-action="Details" asp-encrypted-id="@item.Flow_ID" class="btn btn-outline-info" title="View Details"><i class="bi bi-eye"></i></a>
                                            <a asp-action="Edit" asp-encrypted-id="@item.Flow_ID" class="btn btn-outline-primary" title="Edit Flow"><i class="bi bi-pencil"></i></a>
                                            <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteModal-@item.Flow_ID" title="Delete"><i class="bi bi-trash"></i></button>
                                        </div>

                                        <div class="modal fade text-start" id="deleteModal-@item.Flow_ID" tabindex="-1" aria-hidden="true">
                                            <div class="modal-dialog modal-dialog-centered">
                                                <div class="modal-content">
                                                    <div class="modal-header bg-danger text-white">
                                                        <h5 class="modal-title"><i class="bi bi-exclamation-triangle-fill me-2"></i>Confirm Delete</h5>
                                                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                                                    </div>
                                                    <div class="modal-body">
                                                        Are you sure you want to delete flow <strong>@item.Flow_Code</strong>?
                                                        <p class="mt-2 text-muted small border-start border-3 border-danger ps-2">@item.Flow_Name</p>
                                                    </div>
                                                    <div class="modal-footer">
                                                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                                        <form asp-action="Delete" asp-encrypted-id="@item.Flow_ID" method="post">
                                                            @Html.AntiForgeryToken()
                                                            <button type="submit" class="btn btn-danger">Delete Flow</button>
                                                        </form>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section HeadStyles {
    <link href="~/lib/select2/dist/css/select2.min.css" rel="stylesheet" />
    <style>
        .flow-filter-select + .select2-container { width: 100% !important; }
        .flow-filter-select + .select2-container .select2-selection--single { height: calc(2.375rem + 2px); border: 1px solid #ced4da; border-radius: .375rem; display: flex; align-items: center; }
        .flow-filter-select + .select2-container .select2-selection__rendered { padding-left: .75rem; padding-right: 2rem; color: #212529; line-height: 1.5; }
        .flow-filter-select + .select2-container .select2-selection__rendered { order: 1; flex: 1 1 auto; overflow: hidden; text-overflow: ellipsis; }
        .flow-filter-select + .select2-container .select2-selection__clear { order: 2; margin: 0 1.9rem 0 .25rem; float: none; color: #94a3b8; font-size: 1.15rem; line-height: 1; }
        .flow-filter-select + .select2-container .select2-selection__clear:hover { color: #dc3545; }
        .flow-filter-select + .select2-container .select2-selection__arrow { height: 100%; right: .5rem; }
        .select2-container--default .select2-results__option--highlighted[aria-selected] { background: #0d6efd; }
        .select2-search--dropdown .select2-search__field { border: 1px solid #ced4da; border-radius: .375rem; padding: .35rem .6rem; }
    </style>
}

@section Scripts {
    <script src="~/lib/select2/dist/js/select2.min.js"></script>
    <script>
        $(function () {
            // searchable filters (Select2, already used elsewhere in the app)
            $('.flow-filter-select').each(function () {
                const $el = $(this);
                $el.select2({
                    width: '100%', minimumResultsForSearch: 0, allowClear: true,
                    placeholder: $el.find('option[value=""]').first().text() || 'All',
                    language: { noResults: () => 'No match found' }
                })
                .on('select2:unselecting', function () { $(this).data('cleared', true); })
                .on('select2:opening', function (e) { if ($(this).data('cleared')) { $(this).removeData('cleared'); e.preventDefault(); } });
            });
            $(document).on('select2:open', () => setTimeout(() => { const f = document.querySelector('.select2-container--open .select2-search__field'); if (f) f.focus(); }, 0));
        });
    </script>
}
