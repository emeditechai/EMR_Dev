@model EMR.Web.Models.ViewModels.LabDashboardViewModel
@{
    ViewData["Title"] = "LAB Dashboard";
    var selectedDateStr = Model.SelectedDate;
    var parsedDate = DateTime.TryParse(selectedDateStr, out var d) ? d : DateTime.Today;
    var displayDate = parsedDate.ToString("dd MMM yyyy");
    var isToday = parsedDate.Date == DateTime.Today;

    var totalSamplesPipeline = Model.Data.Summary.PendingCollectionsToday +
                               Model.Data.Summary.CompletedCollectionsToday +
                               Model.Data.Summary.RecollectSamplesToday +
                               Model.Data.Summary.RejectedSamplesToday;

    var collectedPct = totalSamplesPipeline > 0 ? (int)Math.Round((double)Model.Data.Summary.CompletedCollectionsToday / totalSamplesPipeline * 100) : 0;
    var pendingPct = totalSamplesPipeline > 0 ? (int)Math.Round((double)Model.Data.Summary.PendingCollectionsToday / totalSamplesPipeline * 100) : 0;
    var alertPct = totalSamplesPipeline > 0 ? (int)Math.Round((double)(Model.Data.Summary.RecollectSamplesToday + Model.Data.Summary.RejectedSamplesToday) / totalSamplesPipeline * 100) : 0;
}

@section HeadStyles {
    <style>
        .lab-dashboard-page {
            margin-top: 0.25rem;
        }

        /* Hero Banner */
        .lab-hero-card {
            background: linear-gradient(135deg, #1e1b4b 0%, #312e81 40%, #4338ca 100%);
            border-radius: 18px;
            padding: 2.2rem 2.5rem;
            border: none;
            box-shadow: 0 12px 35px rgba(30, 27, 75, 0.25);
            position: relative;
            overflow: hidden;
        }

        .lab-hero-card::before {
            content: '';
            position: absolute;
            right: -5%;
            top: -20%;
            width: 420px;
            height: 420px;
            background: radial-gradient(circle, rgba(129, 140, 248, 0.15) 0%, rgba(129, 140, 248, 0) 70%);
            border-radius: 50%;
            pointer-events: none;
        }

        .lab-hero-card::after {
            content: '';
            position: absolute;
            left: 20%;
            bottom: -40%;
            width: 320px;
            height: 320px;
            background: radial-gradient(circle, rgba(244, 63, 94, 0.12) 0%, rgba(244, 63, 94, 0) 70%);
            border-radius: 50%;
            pointer-events: none;
        }

        .lab-hero-content {
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
            gap: 1.5rem;
            flex-wrap: wrap;
            position: relative;
            z-index: 1;
        }

        .lab-title {
            font-size: 2.25rem;
            font-weight: 800;
            color: #ffffff;
            letter-spacing: -0.02em;
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }

        .lab-title-icon {
            width: 48px;
            height: 48px;
            background: rgba(255, 255, 255, 0.15);
            backdrop-filter: blur(8px);
            border: 1px solid rgba(255, 255, 255, 0.25);
            border-radius: 12px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 1.6rem;
            color: #38bdf8;
        }

        .lab-hero-subtitle {
            color: rgba(255, 255, 255, 0.85);
            font-size: 1.05rem;
            font-weight: 400;
        }

        .lab-hero-pill {
            color: #fff;
            background: rgba(255, 255, 255, 0.15);
            border: 1px solid rgba(255, 255, 255, 0.22);
            border-radius: 8px;
            padding: 0.35rem 0.85rem;
            font-weight: 600;
            font-size: 0.92rem;
            backdrop-filter: blur(6px);
        }

        /* Stat Cards */
        .lab-kpi-card {
            background: #ffffff;
            border: 1px solid #e2e8f0;
            border-radius: 16px;
            padding: 1.4rem 1.5rem;
            box-shadow: 0 4px 18px rgba(15, 23, 42, 0.04);
            transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
            position: relative;
            overflow: hidden;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            height: 100%;
        }

        .lab-kpi-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 12px 30px rgba(15, 23, 42, 0.08);
            border-color: #cbd5e1;
        }

        .lab-kpi-card .kpi-top {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 0.85rem;
        }

        .lab-kpi-card .kpi-icon-wrap {
            width: 48px;
            height: 48px;
            border-radius: 12px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 1.45rem;
        }

        .lab-kpi-card .kpi-label {
            font-size: 0.82rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: #64748b;
        }

        .lab-kpi-card .kpi-value {
            font-size: 2.1rem;
            font-weight: 800;
            line-height: 1.15;
            letter-spacing: -0.02em;
            color: #0f172a;
        }

        .lab-kpi-card .kpi-subtext {
            font-size: 0.82rem;
            color: #64748b;
            margin-top: 0.35rem;
            display: flex;
            align-items: center;
            gap: 0.35rem;
        }

        /* Color variations */
        .card-purple .kpi-icon-wrap { background: #ede9fe; color: #6d28d9; }
        .card-purple::after { content: ''; position: absolute; bottom: 0; left: 0; right: 0; height: 4px; background: #6d28d9; }

        .card-emerald .kpi-icon-wrap { background: #d1fae5; color: #059669; }
        .card-emerald::after { content: ''; position: absolute; bottom: 0; left: 0; right: 0; height: 4px; background: #059669; }

        .card-rose .kpi-icon-wrap { background: #ffe4e6; color: #e11d48; }
        .card-rose::after { content: ''; position: absolute; bottom: 0; left: 0; right: 0; height: 4px; background: #e11d48; }

        .card-amber .kpi-icon-wrap { background: #fef3c7; color: #d97706; }
        .card-amber::after { content: ''; position: absolute; bottom: 0; left: 0; right: 0; height: 4px; background: #d97706; }

        .card-sky .kpi-icon-wrap { background: #e0f2fe; color: #0284c7; }
        .card-sky::after { content: ''; position: absolute; bottom: 0; left: 0; right: 0; height: 4px; background: #0284c7; }

        .card-indigo .kpi-icon-wrap { background: #e0e7ff; color: #4338ca; }
        .card-indigo::after { content: ''; position: absolute; bottom: 0; left: 0; right: 0; height: 4px; background: #4338ca; }

        /* Urgent Pulse Animation */
        .urgent-pulse {
            animation: pulse-red 2s infinite;
        }

        @@keyframes pulse-red {
            0% { box-shadow: 0 0 0 0 rgba(225, 29, 72, 0.4); }
            70% { box-shadow: 0 0 0 10px rgba(225, 29, 72, 0); }
            100% { box-shadow: 0 0 0 0 rgba(225, 29, 72, 0); }
        }

        .urgent-badge-glow {
            background: linear-gradient(135deg, #e11d48, #be123c);
            color: #ffffff;
            box-shadow: 0 2px 8px rgba(225, 29, 72, 0.4);
            font-weight: 700;
            padding: 0.25rem 0.6rem;
            border-radius: 6px;
            display: inline-flex;
            align-items: center;
            gap: 0.3rem;
            font-size: 0.76rem;
        }

        /* Panel Container */
        .lab-panel {
            background: #ffffff;
            border: 1px solid #e2e8f0;
            border-radius: 18px;
            padding: 1.5rem;
            box-shadow: 0 4px 20px rgba(15, 23, 42, 0.04);
            margin-bottom: 1.5rem;
        }

        .panel-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 1.25rem;
            flex-wrap: wrap;
            gap: 1rem;
        }

        .panel-title {
            font-size: 1.15rem;
            font-weight: 700;
            color: #0f172a;
            margin: 0;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        /* Filter Tabs */
        .nav-pills-custom .nav-link {
            border-radius: 10px;
            font-weight: 600;
            font-size: 0.88rem;
            padding: 0.45rem 1rem;
            color: #64748b;
            background: #f1f5f9;
            margin-right: 0.4rem;
            transition: all 0.2s;
            border: 1px solid transparent;
        }

        .nav-pills-custom .nav-link:hover {
            color: #1e293b;
            background: #e2e8f0;
        }

        .nav-pills-custom .nav-link.active {
            color: #ffffff;
            background: #4338ca;
            box-shadow: 0 4px 12px rgba(67, 56, 202, 0.3);
        }

        .nav-pills-custom .nav-link.active.tab-urgent {
            background: #e11d48;
            box-shadow: 0 4px 12px rgba(225, 29, 72, 0.3);
        }

        /* Table Design */
        .lab-table {
            margin-bottom: 0;
        }

        .lab-table th {
            background: #f8fafc;
            color: #475569;
            font-size: 0.78rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            padding: 0.9rem 1rem;
            border-bottom: 2px solid #e2e8f0;
            white-space: nowrap;
        }

        .lab-table td {
            padding: 0.9rem 1rem;
            vertical-align: middle;
            font-size: 0.88rem;
            border-bottom: 1px solid #f1f5f9;
        }

        .lab-table tr:hover td {
            background-color: #f8fafc;
        }

        .urgent-row td {
            background-color: #fff1f2 !important;
        }

        .urgent-row:hover td {
            background-color: #ffe4e6 !important;
        }

        /* Multi-segment Progress Bar */
        .pipeline-bar {
            height: 12px;
            border-radius: 99px;
            background: #e2e8f0;
            overflow: hidden;
            display: flex;
        }

        /* Leaderboard Item */
        .top-test-item {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0.75rem 0.5rem;
            border-bottom: 1px dashed #e2e8f0;
            transition: background 0.15s;
        }

        .top-test-item:last-child {
            border-bottom: none;
        }

        .top-test-item:hover {
            background: #f8fafc;
            border-radius: 8px;
        }

        .rank-circle {
            width: 26px;
            height: 26px;
            border-radius: 50%;
            background: #e2e8f0;
            color: #475569;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 0.78rem;
            font-weight: 700;
        }

        .rank-1 { background: #fef08a; color: #854d0e; }
        .rank-2 { background: #e2e8f0; color: #334155; }
        .rank-3 { background: #fed7aa; color: #9a3412; }

        /* Search Box */
        .search-input-group {
            position: relative;
            min-width: 260px;
        }

        .search-input-group i {
            position: absolute;
            left: 12px;
            top: 50%;
            transform: translateY(-50%);
            color: #94a3b8;
            pointer-events: none;
        }

        .search-input-group input {
            padding-left: 36px;
            border-radius: 10px;
            border: 1px solid #cbd5e1;
            font-size: 0.88rem;
        }

        .search-input-group input:focus {
            border-color: #6366f1;
            box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.15);
        }
    </style>
}

<div class="lab-dashboard-page">

    @* Hero Banner *@
    <div class="lab-hero-card mb-4">
        <div class="lab-hero-content">
            <div>
                <div class="lab-title mb-2">
                    <span class="lab-title-icon"><i class="bi bi-droplet-half"></i></span>
                    <span>@Model.CurrentHospitalName LAB</span>
                    <a asp-controller="SampleCollection" asp-action="Index" class="btn btn-sm btn-light rounded-circle shadow-sm d-flex align-items-center justify-content-center text-primary" style="width: 38px; height: 38px; transition: transform 0.2s;" onmouseover="this.style.transform='scale(1.1)';" onmouseout="this.style.transform='scale(1)';" title="Go to Sample Collection Queue" data-bs-toggle="tooltip">
                        <i class="bi bi-eyedropper fs-5 text-indigo"></i>
                    </a>
                </div>
                <p class="lab-hero-subtitle mb-3">Diagnostic Laboratory Overview, Workload Status & Urgent Priority Queue</p>
                <div class="d-flex flex-wrap align-items-center gap-2">
                    <span class="lab-hero-pill d-flex align-items-center gap-1">
                        <i class="bi bi-geo-alt-fill text-warning"></i> @Model.CurrentBranchName
                    </span>
                    <span class="lab-hero-pill d-flex align-items-center gap-1">
                        <i class="bi bi-calendar3 opacity-75"></i> Selected: <strong class="text-white">@displayDate</strong>
                    </span>
                    @if (isToday)
                    {
                        <span class="badge bg-success bg-opacity-75 text-white border border-white border-opacity-25 px-2 py-1">LIVE TODAY</span>
                    }
                </div>
            </div>

            @* Actions & Date Filter *@
            <div class="d-flex flex-wrap align-items-center gap-2">
                <a asp-controller="LabOrderBooking" asp-action="B2CBooking" class="btn btn-primary bg-indigo border-0 fw-semibold px-3 py-2 shadow-sm d-flex align-items-center gap-2" style="background-color: #6366f1;">
                    <i class="bi bi-plus-circle-fill"></i> New Lab Booking
                </a>

                <form method="get" asp-action="Index" id="dateFilterForm" class="d-flex align-items-center gap-2 bg-white bg-opacity-25 rounded-3 p-1 ps-3 border border-white border-opacity-25 shadow-sm backdrop-blur">
                    <label class="form-label small fw-semibold text-white mb-0 text-nowrap">
                        <i class="bi bi-calendar-event me-1 opacity-75"></i>Date:
                    </label>
                    <div class="input-group input-group-sm rounded bg-white shadow-sm overflow-hidden" style="width: auto;">
                        <input type="date" name="date" value="@selectedDateStr" class="form-control border-0 shadow-none fw-semibold text-dark px-2" style="font-size: 0.9rem;" onchange="document.getElementById('dateFilterForm').submit()" />
                    </div>
                </form>

                <a href="@Url.Action("Index", new { date = DateTime.Today.ToString("yyyy-MM-dd") })" class="btn btn-outline-light btn-sm fw-semibold px-3 py-2">
                    Today
                </a>
                <button type="button" class="btn btn-outline-light btn-sm rounded-circle p-2" title="Refresh Dashboard" onclick="location.reload();">
                    <i class="bi bi-arrow-clockwise fs-6"></i>
                </button>
            </div>
        </div>
    </div>

    @* KPI Cards Row *@
    <div class="row g-3 mb-4">
        
        <!-- Total Orders & Revenue -->
        <div class="col-12 col-sm-6 col-xl-2">
            <div class="lab-kpi-card card-purple">
                <div class="kpi-top">
                    <div class="kpi-label">Lab Orders</div>
                    <div class="kpi-icon-wrap"><i class="bi bi-receipt"></i></div>
                </div>
                <div>
                    <div class="kpi-value">@Model.Data.Summary.TotalOrdersToday</div>
                    <div class="kpi-subtext text-purple fw-semibold">
                        <i class="bi bi-currency-rupee"></i>@Model.Data.Summary.TotalRevenueToday.ToString("N0") Billed
                    </div>
                </div>
            </div>
        </div>

        <!-- Urgent / STAT Orders -->
        <div class="col-12 col-sm-6 col-xl-2">
            <div class="lab-kpi-card card-rose @(Model.Data.Summary.UrgentOrdersToday > 0 ? "urgent-pulse" : "")">
                <div class="kpi-top">
                    <div class="kpi-label">Urgent / STAT</div>
                    <div class="kpi-icon-wrap"><i class="bi bi-exclamation-triangle-fill"></i></div>
                </div>
                <div>
                    <div class="kpi-value text-danger">@Model.Data.Summary.UrgentOrdersToday</div>
                    <div class="kpi-subtext">
                        @if (Model.Data.Summary.UrgentOrdersToday > 0)
                        {
                            <span class="text-danger fw-bold"><i class="bi bi-lightning-fill"></i> High Priority Action</span>
                        }
                        else
                        {
                            <span>No urgent cases today</span>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Samples Pending Collection -->
        <div class="col-12 col-sm-6 col-xl-2">
            <div class="lab-kpi-card card-amber">
                <div class="kpi-top">
                    <div class="kpi-label">Pending Collection</div>
                    <div class="kpi-icon-wrap"><i class="bi bi-hourglass-split"></i></div>
                </div>
                <div>
                    <div class="kpi-value text-amber">@Model.Data.Summary.PendingCollectionsToday</div>
                    <div class="kpi-subtext">
                        <span>Awaiting Phlebotomy</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Samples Collected -->
        <div class="col-12 col-sm-6 col-xl-2">
            <div class="lab-kpi-card card-emerald">
                <div class="kpi-top">
                    <div class="kpi-label">Samples Collected</div>
                    <div class="kpi-icon-wrap"><i class="bi bi-check2-circle"></i></div>
                </div>
                <div>
                    <div class="kpi-value text-success">@Model.Data.Summary.CompletedCollectionsToday</div>
                    <div class="kpi-subtext text-success">
                        <i class="bi bi-shield-check"></i> Barcoded & Ready
                    </div>
                </div>
            </div>
        </div>

        <!-- Re-Collect / Rejected -->
        <div class="col-12 col-sm-6 col-xl-2">
            <div class="lab-kpi-card card-sky">
                <div class="kpi-top">
                    <div class="kpi-label">Re-Collect / Reject</div>
                    <div class="kpi-icon-wrap"><i class="bi bi-arrow-repeat"></i></div>
                </div>
                <div>
                    <div class="kpi-value">@(Model.Data.Summary.RecollectSamplesToday + Model.Data.Summary.RejectedSamplesToday)</div>
                    <div class="kpi-subtext">
                        <span>@(Model.Data.Summary.RecollectSamplesToday) Re-col | @(Model.Data.Summary.RejectedSamplesToday) Rej</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Total Tests Booked -->
        <div class="col-12 col-sm-6 col-xl-2">
            <div class="lab-kpi-card card-indigo">
                <div class="kpi-top">
                    <div class="kpi-label">Tests Booked</div>
                    <div class="kpi-icon-wrap"><i class="bi bi-clipboard2-pulse"></i></div>
                </div>
                <div>
                    <div class="kpi-value">@Model.Data.Summary.TotalTestsBookedToday</div>
                    <div class="kpi-subtext">
                        <span>Individual & Profiles</span>
                    </div>
                </div>
            </div>
        </div>

    </div>

    @* Analytics & Pipeline Row *@
    <div class="row g-4 mb-4">
        
        <!-- Left: Phlebotomy Pipeline & Mode Breakdown -->
        <div class="col-12 col-lg-7">
            <div class="lab-panel h-100">
                <div class="panel-header">
                    <div>
                        <h2 class="panel-title"><i class="bi bi-activity text-indigo"></i> Phlebotomy Collection Progress</h2>
                        <small class="text-muted">Status of all scheduled sample collections for @displayDate</small>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-2 py-1">
                            <i class="bi bi-check-circle-fill me-1"></i>@collectedPct% Collected
                        </span>
                    </div>
                </div>

                <!-- Segmented Progress Bar -->
                <div class="pipeline-bar mb-3">
                    <div style="width: @collectedPct%; background-color: #10b981;" title="Collected: @Model.Data.Summary.CompletedCollectionsToday (@collectedPct%)"></div>
                    <div style="width: @pendingPct%; background-color: #f59e0b;" title="Pending: @Model.Data.Summary.PendingCollectionsToday (@pendingPct%)"></div>
                    <div style="width: @alertPct%; background-color: #ef4444;" title="Re-Collect/Rejected: @(Model.Data.Summary.RecollectSamplesToday + Model.Data.Summary.RejectedSamplesToday) (@alertPct%)"></div>
                </div>

                <!-- Progress Legend & Counters -->
                <div class="row g-2 text-center pt-2 pb-3 border-bottom">
                    <div class="col-3">
                        <div class="small fw-bold text-success"><i class="bi bi-circle-fill fs-8 me-1"></i>Collected</div>
                        <div class="h5 mb-0 fw-bold">@Model.Data.Summary.CompletedCollectionsToday</div>
                        <small class="text-muted">@collectedPct%</small>
                    </div>
                    <div class="col-3">
                        <div class="small fw-bold text-warning"><i class="bi bi-circle-fill fs-8 me-1"></i>Pending</div>
                        <div class="h5 mb-0 fw-bold">@Model.Data.Summary.PendingCollectionsToday</div>
                        <small class="text-muted">@pendingPct%</small>
                    </div>
                    <div class="col-3">
                        <div class="small fw-bold text-info"><i class="bi bi-circle-fill fs-8 me-1"></i>Re-Collect</div>
                        <div class="h5 mb-0 fw-bold">@Model.Data.Summary.RecollectSamplesToday</div>
                        <small class="text-muted">Samples</small>
                    </div>
                    <div class="col-3">
                        <div class="small fw-bold text-danger"><i class="bi bi-circle-fill fs-8 me-1"></i>Rejected</div>
                        <div class="h5 mb-0 fw-bold">@Model.Data.Summary.RejectedSamplesToday</div>
                        <small class="text-muted">Samples</small>
                    </div>
                </div>

                <!-- Collection Channels -->
                <div class="d-flex justify-content-between align-items-center mt-3 pt-1">
                    <span class="small fw-bold text-uppercase text-muted">Collection Channel Split:</span>
                    <div class="d-flex gap-3">
                        <span class="badge bg-light text-dark border p-2 fw-semibold">
                            <i class="bi bi-hospital me-1 text-primary"></i> In-Lab Walk-ins: <strong class="ms-1">@Model.Data.Summary.InLabOrders</strong>
                        </span>
                        <span class="badge bg-light text-dark border p-2 fw-semibold">
                            <i class="bi bi-house-door me-1 text-success"></i> Home Collections: <strong class="ms-1">@Model.Data.Summary.HomeCollectionOrders</strong>
                        </span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right: Top Investigations Leaderboard -->
        <div class="col-12 col-lg-5">
            <div class="lab-panel h-100">
                <div class="panel-header">
                    <div>
                        <h2 class="panel-title"><i class="bi bi-trophy text-warning"></i> Top Booked Investigations</h2>
                        <small class="text-muted">Most requested tests & profiles today</small>
                    </div>
                    <a asp-controller="LabOrderBooking" asp-action="B2COrderList" class="small fw-semibold text-decoration-none">View All</a>
                </div>

                <div class="top-tests-list">
                    @if (Model.Data.TopInvestigations != null && Model.Data.TopInvestigations.Any())
                    {
                        var rank = 1;
                        foreach (var test in Model.Data.TopInvestigations)
                        {
                            <div class="top-test-item">
                                <div class="d-flex align-items-center gap-2">
                                    <span class="rank-circle @(rank == 1 ? "rank-1" : rank == 2 ? "rank-2" : rank == 3 ? "rank-3" : "")">@rank</span>
                                    <div>
                                        <div class="fw-semibold text-dark text-truncate" style="max-width: 200px;" title="@test.ItemName">
                                            @test.ItemName
                                        </div>
                                        <small class="text-muted">@test.CategoryName</small>
                                    </div>
                                </div>
                                <div class="text-end">
                                    <span class="badge bg-indigo-subtle text-indigo px-2 py-1 fw-bold" style="background:#e0e7ff; color:#4338ca;">
                                        @test.OrderCount Orders
                                    </span>
                                    <div class="small fw-semibold text-muted mt-1">₹@test.TotalRevenue.ToString("N0")</div>
                                </div>
                            </div>
                            rank++;
                        }
                    }
                    else
                    {
                        <div class="text-center py-4 text-muted">
                            <i class="bi bi-inbox fs-3 d-block mb-2 text-secondary"></i>
                            <span>No tests ordered for this date.</span>
                        </div>
                    }
                </div>
            </div>
        </div>

    </div>

    @* Patient / Lab Order Queue Panel *@
    <div class="lab-panel">
        
        <div class="panel-header">
            <div>
                <h2 class="panel-title">
                    <i class="bi bi-people-fill text-indigo"></i> Patient Lab Orders & Sample Status Queue
                </h2>
                <small class="text-muted">Live queue sorted by Urgent Priority, Booking Time, and Token Number</small>
            </div>

            <!-- Instant Search & Quick Actions -->
            <div class="d-flex align-items-center gap-2 flex-wrap">
                <div class="search-input-group">
                    <i class="bi bi-search"></i>
                    <input type="text" id="patientSearchInput" class="form-control" placeholder="Search by Patient, Bill, Token, Phone..." onkeyup="filterPatientTable()" />
                </div>
                <a asp-controller="SampleCollection" asp-action="Index" class="btn btn-outline-primary btn-sm fw-semibold px-3 py-2">
                    <i class="bi bi-eyedropper me-1"></i> Sample Collection Queue
                </a>
            </div>
        </div>

        <!-- Filter Tabs -->
        <ul class="nav nav-pills nav-pills-custom mb-3" id="pills-tab" role="tablist">
            <li class="nav-item">
                <button class="nav-link active" onclick="setTabFilter('all', this)">
                    All Orders <span class="badge bg-dark ms-1">@Model.Data.PatientOrders.Count</span>
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link tab-urgent" onclick="setTabFilter('urgent', this)">
                    <i class="bi bi-exclamation-triangle-fill me-1"></i> Urgent Only 
                    <span class="badge bg-white text-danger ms-1">@Model.Data.PatientOrders.Count(x => x.IsUrgent)</span>
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link" onclick="setTabFilter('pending', this)">
                    Pending Samples 
                    <span class="badge bg-secondary ms-1">@Model.Data.PatientOrders.Count(x => x.PendingCount > 0)</span>
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link" onclick="setTabFilter('collected', this)">
                    Collected 
                    <span class="badge bg-secondary ms-1">@Model.Data.PatientOrders.Count(x => x.OverallSampleStatus == "Collected")</span>
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link" onclick="setTabFilter('home', this)">
                    <i class="bi bi-house-door me-1"></i> Home Collections 
                    <span class="badge bg-secondary ms-1">@Model.Data.PatientOrders.Count(x => x.CollectionType.Contains("Home", StringComparison.OrdinalIgnoreCase))</span>
                </button>
            </li>
        </ul>

        <!-- Patient Orders Table -->
        <div class="table-responsive rounded-3 border">
            <table class="table lab-table align-middle" id="patientOrderTable">
                <thead>
                    <tr>
                        <th style="width: 130px;">Priority / Token</th>
                        <th>Bill No</th>
                        <th>Patient Information</th>
                        <th>Booking Time</th>
                        <th>Type</th>
                        <th>Investigations / Profiles</th>
                        <th>Sample Status</th>
                        <th>Amount</th>
                        <th class="text-center" style="width: 140px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Data.PatientOrders != null && Model.Data.PatientOrders.Any())
                    {
                        foreach (var order in Model.Data.PatientOrders)
                        {
                            var isUrgent = order.IsUrgent;
                            var isHome = order.CollectionType.Contains("Home", StringComparison.OrdinalIgnoreCase);
                            var statusClass = order.OverallSampleStatus switch
                            {
                                "Collected" => "bg-success-subtle text-success border border-success",
                                "Pending" => "bg-warning-subtle text-warning-emphasis border border-warning",
                                "Partially Collected" => "bg-info-subtle text-info border border-info",
                                _ => "bg-secondary-subtle text-secondary"
                            };

                            <tr class="patient-order-row @(isUrgent ? "urgent-row" : "")"
                                data-urgent="@(isUrgent ? "true" : "false")"
                                data-status="@order.OverallSampleStatus.ToLower()"
                                data-pending="@(order.PendingCount > 0 ? "true" : "false")"
                                data-type="@(isHome ? "home" : "lab")">
                                
                                <!-- Priority & Token -->
                                <td>
                                    @if (isUrgent)
                                    {
                                        <div class="mb-1">
                                            <span class="urgent-badge-glow">
                                                <i class="bi bi-exclamation-octagon-fill"></i> URGENT
                                            </span>
                                        </div>
                                    }
                                    <span class="badge bg-dark-subtle text-dark fw-bold font-monospace">
                                        @(order.TokenNo ?? "—")
                                    </span>
                                </td>

                                <!-- Bill No -->
                                <td>
                                    <span class="fw-semibold font-monospace text-primary">@order.BillNo</span>
                                </td>

                                <!-- Patient Information -->
                                <td>
                                    <div class="fw-bold text-dark">@order.PatientName</div>
                                    <div class="small text-muted d-flex align-items-center gap-2">
                                        <span><i class="bi bi-person-badge me-1"></i>@order.PatientCode</span>
                                        <span>•</span>
                                        <span>@(order.Age.HasValue ? $"{order.Age}y" : "") @(order.Gender ?? "")</span>
                                        @if (!string.IsNullOrWhiteSpace(order.PhoneNumber))
                                        {
                                            <span>•</span>
                                            <span><i class="bi bi-telephone me-1"></i>@order.PhoneNumber</span>
                                        }
                                    </div>
                                </td>

                                <!-- Booking Time -->
                                <td>
                                    <div class="fw-semibold">@order.BookingDate.ToString("hh:mm tt")</div>
                                    <small class="text-muted">@order.BookingDate.ToString("dd MMM")</small>
                                </td>

                                <!-- Collection Type -->
                                <td>
                                    @if (isHome)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle">
                                            <i class="bi bi-house-door-fill me-1"></i>Home
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">
                                            <i class="bi bi-hospital me-1"></i>In-Lab
                                        </span>
                                    }
                                </td>

                                <!-- Investigations / Profiles -->
                                <td>
                                    <div class="d-flex align-items-center gap-1 flex-wrap" style="max-width: 320px;">
                                        <span class="badge bg-indigo-subtle text-indigo fw-semibold" style="background:#e0e7ff; color:#4338ca;">
                                            @order.TotalItems @(order.TotalItems == 1 ? "Test" : "Tests")
                                        </span>
                                        <span class="small text-truncate text-secondary" style="max-width: 240px;" title="@order.TestSummary">
                                            @order.TestSummary
                                        </span>
                                    </div>
                                </td>

                                <!-- Sample Status -->
                                <td>
                                    <span class="badge @statusClass px-2 py-1 fw-bold">
                                        @order.OverallSampleStatus
                                    </span>
                                    <div class="small text-muted mt-1">
                                        <span>@order.CollectedCount/@order.TotalItems coll</span>
                                        @if (order.PendingCount > 0)
                                        {
                                            <span class="text-warning-emphasis ms-1">(@order.PendingCount pend)</span>
                                        }
                                    </div>
                                </td>

                                <!-- Total Amount & Payment -->
                                <td>
                                    <div class="fw-bold text-dark">₹@order.TotalAmount.ToString("N2")</div>
                                    @if (order.PaymentStatus == "P")
                                    {
                                        <span class="badge bg-success-subtle text-success" style="font-size: 0.72rem;">Paid</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger" style="font-size: 0.72rem;">Unpaid</span>
                                    }
                                </td>

                                <!-- Actions -->
                                <td class="text-center">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-controller="SampleCollection" asp-action="Index" class="btn btn-outline-primary" title="Go to Sample Collection" data-bs-toggle="tooltip">
                                            <i class="bi bi-eyedropper"></i>
                                        </a>
                                        <a href="/SampleCollection/PrintBarcodeLabel?labOrderId=@order.LabOrderId" target="_blank" class="btn btn-outline-dark" title="Print Barcode Labels" data-bs-toggle="tooltip">
                                            <i class="bi bi-upc-scan"></i>
                                        </a>
                                        <button type="button" class="btn btn-outline-secondary" onclick="viewOrderSummaryModal(@order.LabOrderId, '@order.BillNo', '@order.PatientName', '@order.TestSummary', '@order.OverallSampleStatus', '@order.TotalAmount')" title="Quick View" data-bs-toggle="tooltip">
                                            <i class="bi bi-eye"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="9" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-2 d-block mb-2 text-secondary"></i>
                                <h5 class="fw-normal">No Lab Orders found for @displayDate</h5>
                                <p class="small text-muted mb-3">Try changing the date or create a new booking.</p>
                                <a asp-controller="LabOrderBooking" asp-action="B2CBooking" class="btn btn-primary btn-sm px-3">
                                    <i class="bi bi-plus-circle me-1"></i> Create Lab Booking
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

    </div>

</div>

<!-- Quick View Modal -->
<div class="modal fade" id="orderSummaryModal" tabindex="-1" aria-labelledby="orderSummaryModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-indigo text-white" style="background-color: #4338ca;">
                <h5 class="modal-title fs-6" id="orderSummaryModalLabel"><i class="bi bi-file-earmark-medical me-2"></i>Lab Order Summary</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
                    <div>
                        <div class="small text-muted text-uppercase fw-bold">Bill Number</div>
                        <div class="h6 mb-0 font-monospace text-primary" id="modalBillNo"></div>
                    </div>
                    <div class="text-end">
                        <div class="small text-muted text-uppercase fw-bold">Status</div>
                        <span class="badge bg-primary" id="modalStatus"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <div class="small text-muted text-uppercase fw-bold">Patient Name</div>
                    <div class="fw-bold fs-6" id="modalPatientName"></div>
                </div>

                <div class="mb-3">
                    <div class="small text-muted text-uppercase fw-bold">Ordered Investigations / Profiles</div>
                    <div class="p-2 bg-light rounded border small" id="modalTests"></div>
                </div>

                <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                    <span class="fw-semibold text-muted">Total Bill Amount:</span>
                    <span class="h5 mb-0 fw-bold text-success" id="modalAmount"></span>
                </div>
            </div>
            <div class="modal-footer bg-light p-2">
                <a id="modalSampleColLink" href="/SampleCollection/Index" class="btn btn-primary btn-sm">
                    <i class="bi bi-eyedropper me-1"></i> Open Sample Collection
                </a>
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var currentTabFilter = 'all';

        function setTabFilter(filter, el) {
            currentTabFilter = filter;
            document.querySelectorAll('.nav-pills-custom .nav-link').forEach(btn => btn.classList.remove('active'));
            el.classList.add('active');
            filterPatientTable();
        }

        function filterPatientTable() {
            var search = document.getElementById('patientSearchInput').value.toLowerCase().trim();
            var rows = document.querySelectorAll('#patientOrderTable tbody tr.patient-order-row');

            rows.forEach(function (row) {
                var rowText = row.innerText.toLowerCase();
                var isUrgent = row.getAttribute('data-urgent') === 'true';
                var isPending = row.getAttribute('data-pending') === 'true';
                var status = row.getAttribute('data-status') || '';
                var type = row.getAttribute('data-type') || '';

                // Search query match
                var matchesSearch = !search || rowText.includes(search);

                // Tab filter match
                var matchesTab = true;
                if (currentTabFilter === 'urgent') {
                    matchesTab = isUrgent;
                } else if (currentTabFilter === 'pending') {
                    matchesTab = isPending;
                } else if (currentTabFilter === 'collected') {
                    matchesTab = status.includes('collected');
                } else if (currentTabFilter === 'home') {
                    matchesTab = type === 'home';
                }

                if (matchesSearch && matchesTab) {
                    row.style.display = '';
                } else {
                    row.style.display = 'none';
                }
            });
        }

        function viewOrderSummaryModal(orderId, billNo, patientName, testSummary, status, amount) {
            document.getElementById('modalBillNo').innerText = billNo;
            document.getElementById('modalPatientName').innerText = patientName;
            document.getElementById('modalTests').innerText = testSummary || 'No specific tests found.';
            document.getElementById('modalStatus').innerText = status;
            document.getElementById('modalAmount').innerText = '₹' + parseFloat(amount).toFixed(2);
            document.getElementById('modalSampleColLink').href = '/SampleCollection/Index';

            var modal = new bootstrap.Modal(document.getElementById('orderSummaryModal'));
            modal.show();
        }

        // Initialize tooltips
        document.addEventListener("DOMContentLoaded", function () {
            var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
            tooltipTriggerList.map(function (tooltipTriggerEl) {
                return new bootstrap.Tooltip(tooltipTriggerEl);
            });
        });
    </script>
}
