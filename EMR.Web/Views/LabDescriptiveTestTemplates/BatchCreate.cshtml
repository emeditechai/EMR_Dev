@model EMR.Web.Models.ViewModels.LabDescriptiveTestTemplateBatchFormViewModel

@{
    ViewData["Title"] = "Create Report Template (Multi-Section)";
}

@section HeadStyles {
<link rel="stylesheet" href="~/lib/select2/dist/css/select2.min.css" />
<link rel="stylesheet" href="~/lib/select2-bootstrap-5-theme/dist/select2-bootstrap-5-theme.min.css" />
<link rel="stylesheet" href="~/lib/quill/quill.snow.css" />
<style>
    .ql-editor { min-height: 120px; font-size: 0.9rem; }
    .ql-toolbar.ql-snow { border-radius: 0.375rem 0.375rem 0 0; padding: 4px 8px; }
    .ql-container.ql-snow { border-radius: 0 0 0.375rem 0.375rem; }
    .section-card { border-left: 3px solid #0d6efd; transition: all 0.2s; }
    .section-card:hover { box-shadow: 0 0.25rem 0.5rem rgba(0,0,0,.08); }
    .section-card .card-header { background: #f8f9fa; cursor: pointer; }
    .section-divider { border-top: 2px solid #e9ecef; margin: 1rem 0; }
    .contrast-fields { display: none; }
    .quick-insert-panel { background: #f8f9fa; border: 1px solid #dee2e6; border-radius: 0.375rem; padding: 0.75rem; }
    .quick-insert-panel .badge { cursor: pointer; font-size: 0.75rem; font-weight: 500; transition: all 0.15s; }
    .quick-insert-panel .badge:hover { transform: scale(1.05); opacity: 0.85; }
    .section-remove-btn { position: absolute; top: 0.5rem; right: 0.5rem; }
    .collapse-icon { transition: transform 0.2s; }
    .collapsed .collapse-icon { transform: rotate(-90deg); }
</style>
}

<div class="container-fluid px-4 py-3">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                    <li class="breadcrumb-item text-muted">Lab Master</li>
                    <li class="breadcrumb-item"><a asp-action="Index">Descriptive Test Template</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Create Template</li>
                </ol>
            </nav>
            <h4 class="fw-bold mb-0 text-primary">
                <i class="bi bi-file-earmark-medical me-2"></i>Create Report Template (Multi-Section)
            </h4>
            <small class="text-muted">Define all report sections for a radiology test in one template</small>
        </div>
    </div>

    <form asp-action="BatchCreate" method="post" id="batchForm">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="CompanyId" />

        @if (ViewData.ModelState.ErrorCount > 0)
        {
            <div class="alert alert-danger alert-dismissible fade show mb-3" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                <strong>Please correct the following:</strong>
                <ul class="mb-0 mt-1">
                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <li>@error.ErrorMessage</li>
                    }
                </ul>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <!-- Test & Radiology Details Card -->
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-transparent fw-semibold">
                <i class="bi bi-clipboard2-pulse me-1"></i> Test & Radiology Details
            </div>
            <div class="card-body p-4">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="Test_ID" class="form-label small fw-semibold text-muted">Test (Radiology) <span class="text-danger">*</span></label>
                        <select asp-for="Test_ID" class="form-select form-select-sm" id="testSelect">
                            <option value="">-- Select Test --</option>
                        </select>
                        <span asp-validation-message-for="Test_ID" class="text-danger small"></span>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="Modality" class="form-label small fw-semibold text-muted">Modality</label>
                        <select asp-for="Modality" class="form-select form-select-sm" id="modalitySelect">
                            <option value="">-- Select Modality --</option>
                            <option value="X-Ray">X-Ray</option>
                            <option value="CT">CT (Computed Tomography)</option>
                            <option value="MRI">MRI (Magnetic Resonance Imaging)</option>
                            <option value="USG">USG (Ultrasonography)</option>
                            <option value="Mammography">Mammography</option>
                            <option value="Fluoroscopy">Fluoroscopy</option>
                            <option value="PET-CT">PET-CT</option>
                            <option value="DEXA">DEXA (Bone Densitometry)</option>
                            <option value="Doppler">Doppler</option>
                            <option value="Angiography">Angiography</option>
                            <option value="Nuclear Medicine">Nuclear Medicine</option>
                            <option value="Interventional">Interventional Radiology</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="Body_Part" class="form-label small fw-semibold text-muted">Body Part / Region</label>
                        <select asp-for="Body_Part" class="form-select form-select-sm" id="bodyPartSelect">
                            <option value="">-- Select Body Part --</option>
                            <optgroup label="Head & Neck">
                                <option value="Brain">Brain</option>
                                <option value="Head">Head</option>
                                <option value="Face">Face</option>
                                <option value="Orbit">Orbit</option>
                                <option value="PNS">PNS (Paranasal Sinuses)</option>
                                <option value="Temporal Bone">Temporal Bone</option>
                                <option value="Neck">Neck</option>
                                <option value="Thyroid">Thyroid</option>
                            </optgroup>
                            <optgroup label="Spine">
                                <option value="Cervical Spine">Cervical Spine</option>
                                <option value="Thoracic Spine">Thoracic Spine</option>
                                <option value="Lumbar Spine">Lumbar Spine</option>
                                <option value="Sacrum">Sacrum</option>
                                <option value="Whole Spine">Whole Spine</option>
                            </optgroup>
                            <optgroup label="Chest & Thorax">
                                <option value="Chest">Chest</option>
                                <option value="HRCT Chest">HRCT Chest</option>
                                <option value="Mediastinum">Mediastinum</option>
                                <option value="Breast">Breast</option>
                            </optgroup>
                            <optgroup label="Abdomen & Pelvis">
                                <option value="Abdomen">Abdomen</option>
                                <option value="Pelvis">Pelvis</option>
                                <option value="Liver">Liver</option>
                                <option value="Kidney">Kidney</option>
                                <option value="KUB">KUB</option>
                                <option value="Whole Abdomen">Whole Abdomen</option>
                            </optgroup>
                            <optgroup label="Musculoskeletal">
                                <option value="Shoulder">Shoulder</option>
                                <option value="Elbow">Elbow</option>
                                <option value="Wrist">Wrist</option>
                                <option value="Hand">Hand</option>
                                <option value="Hip">Hip</option>
                                <option value="Knee">Knee</option>
                                <option value="Ankle">Ankle</option>
                                <option value="Foot">Foot</option>
                            </optgroup>
                            <optgroup label="Vascular">
                                <option value="Carotid">Carotid</option>
                                <option value="Aorta">Aorta</option>
                                <option value="Peripheral Vessels">Peripheral Vessels</option>
                                <option value="Renal Vessels">Renal Vessels</option>
                            </optgroup>
                            <optgroup label="Special">
                                <option value="Obstetric">Obstetric</option>
                                <option value="Gynaecological">Gynaecological</option>
                                <option value="Paediatric">Paediatric</option>
                                <option value="Whole Body">Whole Body</option>
                            </optgroup>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="Laterality" class="form-label small fw-semibold text-muted">Laterality</label>
                        <select asp-for="Laterality" class="form-select form-select-sm">
                            <option value="">-- Select --</option>
                            <option value="Left">Left</option>
                            <option value="Right">Right</option>
                            <option value="Bilateral">Bilateral</option>
                            <option value="N/A">N/A</option>
                        </select>
                    </div>
                    <div class="col-md-3 d-flex align-items-end">
                        <div class="form-check form-switch mb-2">
                            <input asp-for="Contrast_Required" class="form-check-input" type="checkbox" id="contrastToggle" />
                            <label asp-for="Contrast_Required" class="form-check-label small fw-semibold">Contrast Required</label>
                        </div>
                    </div>
                    <div class="col-md-3 contrast-fields" id="contrastFields">
                        <label asp-for="Contrast_Agent" class="form-label small fw-semibold text-muted">Contrast Agent</label>
                        <select asp-for="Contrast_Agent" class="form-select form-select-sm">
                            <option value="">-- Select Agent --</option>
                            <optgroup label="Iodinated (CT)">
                                <option value="Iohexol (Omnipaque)">Iohexol (Omnipaque)</option>
                                <option value="Iopamidol (Isovue)">Iopamidol (Isovue)</option>
                                <option value="Iodixanol (Visipaque)">Iodixanol (Visipaque)</option>
                            </optgroup>
                            <optgroup label="Gadolinium (MRI)">
                                <option value="Gadopentetate (Magnevist)">Gadopentetate (Magnevist)</option>
                                <option value="Gadobutrol (Gadavist)">Gadobutrol (Gadavist)</option>
                                <option value="Gadoterate (Dotarem)">Gadoterate (Dotarem)</option>
                            </optgroup>
                            <optgroup label="Barium / Other">
                                <option value="Barium Sulfate">Barium Sulfate</option>
                                <option value="Gastrografin">Gastrografin</option>
                                <option value="SonoVue (Sulphur Hexafluoride)">SonoVue</option>
                            </optgroup>
                            <option value="Other">Other</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="Views_Projections" class="form-label small fw-semibold text-muted">Views / Projections</label>
                        <input asp-for="Views_Projections" class="form-control form-control-sm" maxlength="200"
                               placeholder="e.g. AP, Lateral, Oblique" />
                    </div>
                    <div class="col-md-12">
                        <label asp-for="Preparation_Instructions" class="form-label small fw-semibold text-muted">Preparation Instructions</label>
                        <textarea asp-for="Preparation_Instructions" class="form-control form-control-sm" rows="2" maxlength="1000"
                                  placeholder="e.g. NPO 6 hours, Remove metallic objects, IV access required"></textarea>
                    </div>
                </div>
            </div>
        </div>

        <!-- Quick Insert Panel (shared across all sections) -->
        <div class="quick-insert-panel mb-3" id="quickInsertPanel">
            <div class="d-flex align-items-center mb-2">
                <small class="fw-bold text-secondary me-2"><i class="bi bi-lightning-fill"></i> Quick Insert:</small>
                <small class="text-muted">Click to insert into the active section editor</small>
            </div>
            <div class="d-flex flex-wrap gap-1 mb-1">
                <span class="badge bg-primary" data-insert="{{PatientName}}">Patient Name</span>
                <span class="badge bg-primary" data-insert="{{PatientAge}}">Patient Age</span>
                <span class="badge bg-primary" data-insert="{{PatientGender}}">Patient Gender</span>
                <span class="badge bg-primary" data-insert="{{UHID}}">UHID</span>
                <span class="badge bg-success" data-insert="{{StudyDate}}">Study Date</span>
                <span class="badge bg-success" data-insert="{{Modality}}">Modality</span>
                <span class="badge bg-success" data-insert="{{BodyPart}}">Body Part</span>
                <span class="badge bg-success" data-insert="{{Laterality}}">Laterality</span>
                <span class="badge bg-success" data-insert="{{ViewsProjections}}">Views</span>
                <span class="badge bg-success" data-insert="{{ContrastAgent}}">Contrast Agent</span>
                <span class="badge bg-success" data-insert="{{ReferringDoctor}}">Referring Doctor</span>
            </div>
            <div id="modalitySpecificTags" class="d-flex flex-wrap gap-1"></div>
        </div>

        <!-- Sections Container -->
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="fw-bold mb-0 text-secondary">
                <i class="bi bi-list-columns-reverse me-1"></i> Report Sections
            </h5>
            <button type="button" class="btn btn-outline-primary btn-sm" id="addSectionBtn">
                <i class="bi bi-plus-lg me-1"></i>Add Section
            </button>
        </div>

        <div id="sectionsContainer">
            @for (int i = 0; i < Model.Sections.Count; i++)
            {
                <div class="card section-card mb-3 position-relative" data-section-index="@i">
                    <div class="card-header py-2 d-flex justify-content-between align-items-center"
                         data-bs-toggle="collapse" data-bs-target="#sectionBody_@i">
                        <span class="fw-semibold small">
                            <i class="bi bi-chevron-down collapse-icon me-1"></i>
                            <span class="section-title">@(i + 1). @Model.Sections[i].Section_Name</span>
                            @if (Model.Sections[i].Is_Mandatory)
                            {
                                <span class="badge bg-danger-subtle text-danger ms-2" style="font-size:0.65rem">Required</span>
                            }
                        </span>
                    </div>
                    <button type="button" class="btn btn-sm btn-outline-danger section-remove-btn rounded-circle"
                            onclick="removeSection(this)" title="Remove Section" style="width:28px;height:28px;padding:0;">
                        <i class="bi bi-x"></i>
                    </button>
                    <div class="collapse show" id="sectionBody_@i">
                        <div class="card-body p-3">
                            <div class="row g-2">
                                <div class="col-md-5">
                                    <label class="form-label small fw-semibold text-muted">Section Name <span class="text-danger">*</span></label>
                                    <select name="Sections[@i].Section_Name" class="form-select form-select-sm section-name-select">
                                        <option value="">-- Select Section --</option>
                                        <option value="Clinical History" selected="@(Model.Sections[i].Section_Name == "Clinical History")">Clinical History</option>
                                        <option value="Technique" selected="@(Model.Sections[i].Section_Name == "Technique")">Technique</option>
                                        <option value="Comparison" selected="@(Model.Sections[i].Section_Name == "Comparison")">Comparison</option>
                                        <option value="Findings" selected="@(Model.Sections[i].Section_Name == "Findings")">Findings</option>
                                        <option value="Impression" selected="@(Model.Sections[i].Section_Name == "Impression")">Impression</option>
                                        <option value="Recommendation" selected="@(Model.Sections[i].Section_Name == "Recommendation")">Recommendation</option>
                                        <option value="Measurements" selected="@(Model.Sections[i].Section_Name == "Measurements")">Measurements</option>
                                        <option value="Conclusion" selected="@(Model.Sections[i].Section_Name == "Conclusion")">Conclusion</option>
                                        <option value="Addendum" selected="@(Model.Sections[i].Section_Name == "Addendum")">Addendum</option>
                                    </select>
                                </div>
                                <div class="col-md-2">
                                    <label class="form-label small fw-semibold text-muted">Sequence</label>
                                    <input name="Sections[@i].Section_Sequence" type="number" class="form-control form-control-sm"
                                           value="@Model.Sections[i].Section_Sequence" min="1" max="999" />
                                </div>
                                <div class="col-md-2 d-flex align-items-end">
                                    <div class="form-check form-switch mb-2">
                                        <input name="Sections[@i].Is_Mandatory" type="checkbox" class="form-check-input"
                                               value="true" @(Model.Sections[i].Is_Mandatory ? "checked" : "") />
                                        <label class="form-check-label small">Mandatory</label>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label small fw-semibold text-muted">Placeholder Tags</label>
                                    <input name="Sections[@i].Placeholder_Tags" class="form-control form-control-sm"
                                           value="@Model.Sections[i].Placeholder_Tags" maxlength="500" placeholder="e.g. {{PatientAge}}" />
                                </div>
                                <div class="col-12">
                                    <label class="form-label small fw-semibold text-muted">Default Content</label>
                                    <div class="quill-editor" data-index="@i"></div>
                                    <input type="hidden" name="Sections[@i].Default_Content_Html" class="hidden-content" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <hr class="my-3" />
        <div class="d-flex justify-content-between">
            <a asp-action="Create" class="btn btn-outline-info btn-sm px-3">
                <i class="bi bi-file-earmark-plus me-1"></i>Single Section Mode
            </a>
            <div class="d-flex gap-2">
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm px-3">
                    <i class="bi bi-x-circle me-1"></i>Cancel
                </a>
                <button type="submit" class="btn btn-primary btn-sm px-3" id="btnSave">
                    <i class="bi bi-check-circle me-1"></i>Save All Sections
                </button>
            </div>
        </div>
    </form>
</div>

<!-- Section Template (hidden, cloned by JS) -->
<template id="sectionTemplate">
    <div class="card section-card mb-3 position-relative" data-section-index="__INDEX__">
        <div class="card-header py-2 d-flex justify-content-between align-items-center"
             data-bs-toggle="collapse" data-bs-target="#sectionBody___INDEX__">
            <span class="fw-semibold small">
                <i class="bi bi-chevron-down collapse-icon me-1"></i>
                <span class="section-title">__NUM__. New Section</span>
            </span>
        </div>
        <button type="button" class="btn btn-sm btn-outline-danger section-remove-btn rounded-circle"
                onclick="removeSection(this)" title="Remove Section" style="width:28px;height:28px;padding:0;">
            <i class="bi bi-x"></i>
        </button>
        <div class="collapse show" id="sectionBody___INDEX__">
            <div class="card-body p-3">
                <div class="row g-2">
                    <div class="col-md-5">
                        <label class="form-label small fw-semibold text-muted">Section Name <span class="text-danger">*</span></label>
                        <select name="Sections[__INDEX__].Section_Name" class="form-select form-select-sm section-name-select">
                            <option value="">-- Select Section --</option>
                            <option value="Clinical History">Clinical History</option>
                            <option value="Technique">Technique</option>
                            <option value="Comparison">Comparison</option>
                            <option value="Findings">Findings</option>
                            <option value="Impression">Impression</option>
                            <option value="Recommendation">Recommendation</option>
                            <option value="Measurements">Measurements</option>
                            <option value="Conclusion">Conclusion</option>
                            <option value="Addendum">Addendum</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small fw-semibold text-muted">Sequence</label>
                        <input name="Sections[__INDEX__].Section_Sequence" type="number" class="form-control form-control-sm"
                               value="__NUM__" min="1" max="999" />
                    </div>
                    <div class="col-md-2 d-flex align-items-end">
                        <div class="form-check form-switch mb-2">
                            <input name="Sections[__INDEX__].Is_Mandatory" type="checkbox" class="form-check-input" value="true" />
                            <label class="form-check-label small">Mandatory</label>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small fw-semibold text-muted">Placeholder Tags</label>
                        <input name="Sections[__INDEX__].Placeholder_Tags" class="form-control form-control-sm"
                               maxlength="500" placeholder="e.g. {{PatientAge}}" />
                    </div>
                    <div class="col-12">
                        <label class="form-label small fw-semibold text-muted">Default Content</label>
                        <div class="quill-editor" data-index="__INDEX__"></div>
                        <input type="hidden" name="Sections[__INDEX__].Default_Content_Html" class="hidden-content" />
                    </div>
                </div>
            </div>
        </div>
    </div>
</template>

@section Scripts {
<script src="~/lib/select2/dist/js/select2.min.js"></script>
<script src="~/lib/quill/quill.min.js"></script>
<script>
$(function () {
    var quillInstances = {};
    var activeQuillIndex = 0;

    var quillToolbar = [
        [{ 'header': [1, 2, 3, false] }],
        ['bold', 'italic', 'underline'],
        [{ 'list': 'ordered' }, { 'list': 'bullet' }],
        [{ 'align': [] }],
        ['link'],
        [{ 'color': [] }],
        ['clean']
    ];

    function initQuill(container, index) {
        var quill = new Quill(container, {
            theme: 'snow',
            modules: { toolbar: quillToolbar, clipboard: { matchVisual: false } },
            placeholder: 'Enter default content for this section...'
        });

        quill.on('focus', function () {
            activeQuillIndex = index;
        });

        quillInstances[index] = quill;
        return quill;
    }

    // Initialize existing editors
    $('.quill-editor').each(function () {
        var idx = $(this).data('index');
        initQuill(this, idx);
    });

    // Select2
    $('#testSelect').select2({
        theme: 'bootstrap-5',
        placeholder: '-- Select Test --',
        allowClear: true,
        minimumInputLength: 1,
        ajax: {
            url: '@Url.Action("SearchRadiologyTests")',
            dataType: 'json',
            delay: 300,
            data: function (params) { return { term: params.term }; },
            processResults: function (data) { return { results: data }; }
        }
    });

    // Contrast toggle
    $('#contrastToggle').on('change', function () {
        if ($(this).is(':checked')) {
            $('#contrastFields').slideDown(200);
        } else {
            $('#contrastFields').slideUp(200);
            $('select[name="Contrast_Agent"]').val('');
        }
    });

    // Modality-specific tags
    var modalityTags = {
        'X-Ray': [{ tag: '{{KVP}}', label: 'KVP' }, { tag: '{{mAs}}', label: 'mAs' }],
        'CT': [
            { tag: '{{SliceThickness}}', label: 'Slice Thickness' },
            { tag: '{{ContrastVolume}}', label: 'Contrast Vol (ml)' },
            { tag: '{{ContrastPhase}}', label: 'Contrast Phase' },
            { tag: '{{DLP}}', label: 'DLP (mGy.cm)' },
            { tag: '{{CTDIvol}}', label: 'CTDIvol (mGy)' }
        ],
        'MRI': [
            { tag: '{{FieldStrength}}', label: 'Field Strength (T)' },
            { tag: '{{Sequences}}', label: 'Sequences' },
            { tag: '{{CoilUsed}}', label: 'Coil Used' },
            { tag: '{{DWI_ADC}}', label: 'DWI/ADC Values' }
        ],
        'USG': [
            { tag: '{{TransducerFrequency}}', label: 'Transducer Freq' },
            { tag: '{{TransducerType}}', label: 'Transducer Type' },
            { tag: '{{DopplerMode}}', label: 'Doppler Mode' },
            { tag: '{{FetalAge}}', label: 'Fetal Age' },
            { tag: '{{EDD}}', label: 'EDD' }
        ],
        'Mammography': [
            { tag: '{{BIRADSCategory}}', label: 'BI-RADS' },
            { tag: '{{BreastDensity}}', label: 'Breast Density' }
        ],
        'Doppler': [
            { tag: '{{PeakSystolicVelocity}}', label: 'PSV' },
            { tag: '{{ResistiveIndex}}', label: 'RI' },
            { tag: '{{PulsatilityIndex}}', label: 'PI' }
        ]
    };

    $('#modalitySelect').on('change', function () {
        var modality = $(this).val();
        var container = $('#modalitySpecificTags');
        container.empty();
        if (modality && modalityTags[modality]) {
            modalityTags[modality].forEach(function (item) {
                container.append('<span class="badge bg-info text-dark" data-insert="' + item.tag + '">' + item.label + '</span>');
            });
        }
    });

    // Quick Insert into active editor
    $(document).on('click', '[data-insert]', function () {
        var tag = $(this).data('insert');
        var quill = quillInstances[activeQuillIndex];
        if (quill) {
            var range = quill.getSelection(true);
            quill.insertText(range.index, tag, 'user');
            quill.setSelection(range.index + tag.length, 0);
        }
    });

    // Section name change → update header title
    $(document).on('change', '.section-name-select', function () {
        var card = $(this).closest('.section-card');
        var idx = card.index('.section-card') + 1;
        var name = $(this).val() || 'New Section';
        card.find('.section-title').text(idx + '. ' + name);
    });

    // Add section
    var sectionCount = @Model.Sections.Count;
    $('#addSectionBtn').on('click', function () {
        var template = $('#sectionTemplate').html();
        var html = template.replace(/__INDEX__/g, sectionCount).replace(/__NUM__/g, sectionCount + 1);
        var $card = $(html);
        $('#sectionsContainer').append($card);
        var editorEl = $card.find('.quill-editor')[0];
        initQuill(editorEl, sectionCount);
        sectionCount++;
        renumberSections();
    });

    // Remove section
    window.removeSection = function (btn) {
        var card = $(btn).closest('.section-card');
        var idx = card.find('.quill-editor').data('index');
        delete quillInstances[idx];
        card.slideUp(200, function () {
            $(this).remove();
            renumberSections();
        });
    };

    function renumberSections() {
        $('#sectionsContainer .section-card').each(function (i) {
            var name = $(this).find('.section-name-select').val() || 'New Section';
            $(this).find('.section-title').text((i + 1) + '. ' + name);
        });
    }

    // Sync all Quill editors on submit
    $('#batchForm').on('submit', function () {
        $('#sectionsContainer .section-card').each(function (i) {
            var $card = $(this);
            var idx = $card.find('.quill-editor').data('index');
            var quill = quillInstances[idx];
            if (quill) {
                var html = quill.root.innerHTML;
                if (html === '<p><br></p>') html = '';
                $card.find('.hidden-content').val(html);
            }

            // Re-index all form fields to ensure sequential indexing
            $card.find('[name]').each(function () {
                var name = $(this).attr('name');
                $(this).attr('name', name.replace(/Sections\[\d+\]/, 'Sections[' + i + ']'));
            });
        });
    });
});
</script>
}
