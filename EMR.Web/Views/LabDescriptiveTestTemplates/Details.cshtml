@model EMR.Web.ApiClients.Models.LabDescriptiveTestTemplateModel

@{
    ViewData["Title"] = "Descriptive Test Template Details";
}

<div class="container-fluid px-4 py-3">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                    <li class="breadcrumb-item text-muted">Lab Master</li>
                    <li class="breadcrumb-item"><a asp-action="Index">Descriptive Test Template</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Details</li>
                </ol>
            </nav>
            <h4 class="fw-bold mb-0 text-primary">
                <i class="bi bi-eye me-2"></i>Descriptive Test Template Details
            </h4>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Edit" asp-encrypted-id="@Model.Template_ID" class="btn btn-outline-primary px-3">
                <i class="bi bi-pencil-square me-1"></i>Edit
            </a>
            <a asp-action="Index" class="btn btn-outline-secondary px-3">
                <i class="bi bi-arrow-left me-1"></i>Back to List
            </a>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body p-4">
                    <dl class="row mb-0">
                        <dt class="col-sm-4 text-muted">Template ID</dt>
                        <dd class="col-sm-8 fw-semibold">#@Model.Template_ID</dd>

                        <dt class="col-sm-4 text-muted">Test</dt>
                        <dd class="col-sm-8 fw-semibold">@Model.Test_Name <code class="ms-1">(@Model.Test_Code)</code></dd>

                        <dt class="col-sm-4 text-muted">Section Name</dt>
                        <dd class="col-sm-8 fw-semibold">@Model.Section_Name</dd>

                        <dt class="col-sm-4 text-muted">Section Sequence</dt>
                        <dd class="col-sm-8">@Model.Section_Sequence</dd>

                        <dt class="col-sm-4 text-muted">Mandatory</dt>
                        <dd class="col-sm-8">
                            @if (Model.Is_Mandatory)
                            {
                                <span class="badge bg-primary-subtle text-primary rounded-pill px-3">Yes</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary-subtle text-secondary rounded-pill px-3">No</span>
                            }
                        </dd>

                        <dt class="col-sm-4 text-muted">Placeholder Tags</dt>
                        <dd class="col-sm-8">
                            @if (!string.IsNullOrEmpty(Model.Placeholder_Tags))
                            {
                                @foreach (var tag in Model.Placeholder_Tags.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
                                {
                                    <span class="badge bg-info-subtle text-info me-1 mb-1">@tag</span>
                                }
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </dd>

                        <dt class="col-sm-4 text-muted">Status</dt>
                        <dd class="col-sm-8">
                            @if (Model.IsActive)
                            {
                                <span class="badge bg-success-subtle text-success rounded-pill px-3">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-danger-subtle text-danger rounded-pill px-3">Inactive</span>
                            }
                        </dd>

                        <dt class="col-sm-4 text-muted">Created</dt>
                        <dd class="col-sm-8">@Model.CreatedDate.ToString("dd MMM yyyy HH:mm")</dd>

                        @if (Model.ModifiedDate.HasValue)
                        {
                            <dt class="col-sm-4 text-muted">Last Modified</dt>
                            <dd class="col-sm-8">@Model.ModifiedDate.Value.ToString("dd MMM yyyy HH:mm")</dd>
                        }
                    </dl>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(Model.Default_Content_Html))
            {
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-transparent fw-semibold">
                        <i class="bi bi-file-earmark-richtext me-1"></i>Default Content Preview
                    </div>
                    <div class="card-body p-4">
                        <div class="border rounded p-3 bg-light">
                            @Html.Raw(Model.Default_Content_Html)
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="col-lg-4">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-transparent fw-semibold">
                    <i class="bi bi-lightning me-1"></i>Quick Actions
                </div>
                <div class="card-body">
                    <form asp-action="ToggleStatus" method="post" class="mb-2">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Template_ID" />
                        <input type="hidden" name="isActive" value="@((!Model.IsActive).ToString().ToLower())" />
                        <button type="submit" class="btn btn-outline-warning w-100">
                            <i class="bi bi-toggle-@(Model.IsActive ? "on" : "off") me-1"></i>
                            @(Model.IsActive ? "Deactivate" : "Activate")
                        </button>
                    </form>
                    <form asp-action="Delete" method="post"
                          onsubmit="return confirm('Are you sure you want to delete this template section?');">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Template_ID" />
                        <button type="submit" class="btn btn-outline-danger w-100">
                            <i class="bi bi-trash me-1"></i>Delete
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
