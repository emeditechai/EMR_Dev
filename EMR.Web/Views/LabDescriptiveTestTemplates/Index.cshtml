@model EMR.Web.Models.ViewModels.LabDescriptiveTestTemplateIndexViewModel

@{
    ViewData["Title"] = "Descriptive Test Template";
}

<div class="container-fluid px-4 py-3">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                    <li class="breadcrumb-item text-muted">Lab Master</li>
                    <li class="breadcrumb-item active" aria-current="page">Descriptive Test Template</li>
                </ol>
            </nav>
            <h4 class="fw-bold mb-0 text-primary">
                <i class="bi bi-file-earmark-richtext me-2"></i>Descriptive Test Template
            </h4>
        </div>
        <div>
            <a asp-permission="MASTER.LABDESCRIPTIVETESTTEMPLATES:ADD" asp-action="BatchCreate" class="btn btn-primary px-3 shadow-sm">
                <i class="bi bi-file-earmark-medical me-1"></i> Create Report Template
            </a>
        </div>
    </div>

    @await Html.PartialAsync("_LabMasterDashboard", Model.Dashboard)

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-3">
            <form method="get" asp-action="Index" class="row g-3 align-items-end">
                <div class="col-md-4">
                    <label class="form-label small fw-semibold text-muted">Status</label>
                    <select name="status" class="form-select" asp-items="Model.StatusOptions">
                        <option value="">-- All --</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label small fw-semibold text-muted">Search</label>
                    <input type="text" name="search" class="form-control" placeholder="Search by test name..."
                           value="@Model.SearchTerm" />
                </div>
                <div class="col-md-4 d-flex gap-2">
                    <button type="submit" class="btn btn-outline-primary">
                        <i class="bi bi-search me-1"></i>Filter
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="bi bi-x-circle me-1"></i>Clear
                    </a>
                </div>
            </form>
        </div>
    </div>

    <div class="d-flex flex-wrap justify-content-between align-items-center mb-2 gap-2 pager-top">
        <div class="d-flex align-items-center gap-2">
            <label class="form-label mb-0 small fw-semibold text-muted">Page Size:</label>
            <select class="form-select form-select-sm page-size-select" style="width:80px;">
                <option value="10" selected>10</option>
                <option value="25">25</option>
                <option value="50">50</option>
                <option value="100">100</option>
            </select>
            <span class="text-muted small page-info"></span>
        </div>
        <div class="d-flex align-items-center gap-1">
            <button class="btn btn-sm btn-outline-secondary page-first" title="First"><i class="bi bi-chevron-double-left"></i></button>
            <button class="btn btn-sm btn-outline-secondary page-prev" title="Previous"><i class="bi bi-chevron-left"></i></button>
            <span class="page-numbers d-flex gap-1"></span>
            <button class="btn btn-sm btn-outline-secondary page-next" title="Next"><i class="bi bi-chevron-right"></i></button>
            <button class="btn btn-sm btn-outline-secondary page-last" title="Last"><i class="bi bi-chevron-double-right"></i></button>
            <input type="number" class="form-control form-control-sm page-goto-input" min="1" style="width:60px;" placeholder="Go" title="Go to page" />
            <button class="btn btn-sm btn-outline-primary page-goto-btn">Go</button>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover table-striped align-middle mb-0" id="templateTable">
                <thead class="table-light">
                    <tr>
                        <th style="width:50px">#</th>
                        <th>Test Name</th>
                        <th>Test Code</th>
                        <th>Modality</th>
                        <th>Body Part</th>
                        <th style="width:100px" class="text-center">Sections</th>
                        <th style="width:90px">Status</th>
                        <th style="width:120px">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Templates.Any())
                    {
                        var rowNum = 0;
                        @foreach (var item in Model.Templates)
                        {
                            rowNum++;
                            <tr class="data-row">
                                <td class="text-muted">@rowNum</td>
                                <td class="fw-semibold">@item.Test_Name</td>
                                <td><code>@item.Test_Code</code></td>
                                <td>@(item.Modality ?? "—")</td>
                                <td>@(item.Body_Part ?? "—")</td>
                                <td class="text-center">
                                    <span class="badge bg-info-subtle text-info rounded-pill px-2">@item.SectionCount sections</span>
                                </td>
                                <td>
                                    @if (item.IsActive)
                                    {
                                        <span class="badge bg-success-subtle text-success rounded-pill px-3">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger rounded-pill px-3">Inactive</span>
                                    }
                                </td>
                                <td>
                                    <div class="btn-group btn-group-sm">
                                        <a asp-permission="MASTER.LABDESCRIPTIVETESTTEMPLATES:EDIT" asp-action="Edit" asp-encrypted-id="@item.Test_ID"
                                           class="btn btn-outline-primary" title="Edit All Sections">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>
                                        <a asp-permission="MASTER.LABDESCRIPTIVETESTTEMPLATES:DETAILS" asp-action="Details" asp-encrypted-id="@item.Test_ID"
                                           class="btn btn-outline-info" title="View Details">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <form asp-permission="MASTER.LABDESCRIPTIVETESTTEMPLATES:DELETE" asp-action="DeleteByTestId" method="post" class="d-inline"
                                              onsubmit="return confirm('Are you sure you want to delete all @item.SectionCount section(s) for this test?')">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="testId" value="@item.Test_ID" />
                                            <button type="submit" class="btn btn-outline-danger btn-sm" title="Delete All Sections">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center text-muted py-5">
                                <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                                No descriptive test templates found.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="d-flex flex-wrap justify-content-between align-items-center mt-2 gap-2 pager-bottom">
        <div class="d-flex align-items-center gap-2">
            <label class="form-label mb-0 small fw-semibold text-muted">Page Size:</label>
            <select class="form-select form-select-sm page-size-select" style="width:80px;">
                <option value="10" selected>10</option>
                <option value="25">25</option>
                <option value="50">50</option>
                <option value="100">100</option>
            </select>
            <span class="text-muted small page-info"></span>
        </div>
        <div class="d-flex align-items-center gap-1">
            <button class="btn btn-sm btn-outline-secondary page-first" title="First"><i class="bi bi-chevron-double-left"></i></button>
            <button class="btn btn-sm btn-outline-secondary page-prev" title="Previous"><i class="bi bi-chevron-left"></i></button>
            <span class="page-numbers d-flex gap-1"></span>
            <button class="btn btn-sm btn-outline-secondary page-next" title="Next"><i class="bi bi-chevron-right"></i></button>
            <button class="btn btn-sm btn-outline-secondary page-last" title="Last"><i class="bi bi-chevron-double-right"></i></button>
            <input type="number" class="form-control form-control-sm page-goto-input" min="1" style="width:60px;" placeholder="Go" title="Go to page" />
            <button class="btn btn-sm btn-outline-primary page-goto-btn">Go</button>
        </div>
    </div>
</div>

@section Scripts {
<script src="~/js/views/LabDescriptiveTestTemplates/Index.js" asp-append-version="true"></script>
}
