@model EMR.Web.Models.ViewModels.LabFormulaParameterFormViewModel

@{
    ViewData["Title"] = "Create Formula Parameter";
}

@section HeadStyles {
<link rel="stylesheet" href="~/lib/select2/dist/css/select2.min.css" />
<link rel="stylesheet" href="~/lib/select2-bootstrap-5-theme/dist/select2-bootstrap-5-theme.min.css" />
<style>
    .formula-builder {
        border: 1px solid #dee2e6;
        border-radius: 0.375rem;
        padding: 0.5rem;
        min-height: 56px;
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 4px;
        cursor: text;
        background: #fff;
        transition: border-color 0.15s;
    }
    .formula-builder:focus-within {
        border-color: #86b7fe;
        box-shadow: 0 0 0 0.25rem rgba(13,110,253,.25);
    }
    .formula-builder .chip {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        padding: 2px 8px;
        border-radius: 1rem;
        font-size: 0.85rem;
        white-space: nowrap;
    }
    .formula-builder .chip-test {
        background: #e7f1ff;
        color: #0d6efd;
        border: 1px solid #b6d4fe;
    }
    .formula-builder .chip-op {
        background: #f8f9fa;
        color: #495057;
        border: 1px solid #dee2e6;
        font-weight: 600;
        font-family: monospace;
        font-size: 0.95rem;
    }
    .formula-builder .chip .chip-remove {
        cursor: pointer;
        font-size: 0.75rem;
        opacity: 0.6;
        margin-left: 2px;
    }
    .formula-builder .chip .chip-remove:hover { opacity: 1; }
    .formula-builder .formula-input {
        border: none;
        outline: none;
        flex: 1;
        min-width: 60px;
        font-size: 0.9rem;
        background: transparent;
    }
    .operator-bar {
        display: flex;
        gap: 4px;
        margin-top: 6px;
        flex-wrap: wrap;
    }
    .operator-bar .btn { padding: 2px 10px; font-family: monospace; font-weight: 600; }
    .formula-preview {
        background: #f8f9fa;
        border: 1px solid #e9ecef;
        border-radius: 0.375rem;
        padding: 0.5rem 0.75rem;
        font-family: monospace;
        font-size: 0.85rem;
        color: #6c757d;
        min-height: 36px;
        word-break: break-all;
    }
    .formula-validation {
        font-size: 0.8rem;
        margin-top: 4px;
    }
</style>
}

<div class="container-fluid px-4 py-2">
    <div class="d-flex justify-content-between align-items-center mb-2">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1 small">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                    <li class="breadcrumb-item text-muted">Lab Master</li>
                    <li class="breadcrumb-item"><a asp-action="Index">Lab Formula Component</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Create</li>
                </ol>
            </nav>
            <h5 class="fw-bold mb-0 text-primary">
                <i class="bi bi-plus-circle me-2"></i>Create Formula Parameter
            </h5>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-3">
            @if (ViewData.ModelState.ErrorCount > 0)
            {
                <div class="alert alert-danger py-2 small">
                    <ul class="mb-0">
                        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                        {
                            <li>@error.ErrorMessage</li>
                        }
                    </ul>
                </div>
            }

            <form asp-action="Create" method="post" id="formulaForm">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="CompanyId" />
                <input type="hidden" asp-for="Formula_Expression" id="formulaExpressionHidden" />

                <!-- Row 1: Target Test -->
                <div class="row g-2 mb-2">
                    <div class="col-md-8">
                        <label asp-for="Test_ID" class="form-label small fw-semibold mb-1"></label>
                        <select asp-for="Test_ID" id="testSelect" class="form-select form-select-sm">
                            <option value="">-- Select a numeric test --</option>
                        </select>
                        <span asp-validation-for="Test_ID" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Rounding_Precision" class="form-label small fw-semibold mb-1"></label>
                        <input asp-for="Rounding_Precision" class="form-control form-control-sm" type="number" min="0" max="10" />
                        <span asp-validation-for="Rounding_Precision" class="text-danger small"></span>
                    </div>
                </div>

                <!-- Row 2: Formula Expression Builder -->
                <div class="mb-2">
                    <label asp-for="Formula_Expression" class="form-label small fw-semibold mb-1"></label>
                    <div class="row g-2 mb-1">
                        <div class="col">
                            <select id="componentTestSearch" class="form-select form-select-sm" style="width:100%">
                                <option value="">Search test component to add...</option>
                            </select>
                        </div>
                    </div>
                    <div class="formula-builder" id="formulaBuilder">
                        <input type="text" class="formula-input" id="formulaDirectInput" placeholder="Type number or use buttons..." />
                    </div>
                    <div class="operator-bar">
                        <button type="button" class="btn btn-sm btn-outline-secondary op-btn" data-op="+">+</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary op-btn" data-op="-">−</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary op-btn" data-op="*">&times;</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary op-btn" data-op="/">&divide;</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary op-btn" data-op="(">(</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary op-btn" data-op=")">)</button>
                        <button type="button" class="btn btn-sm btn-outline-danger" id="formulaClearBtn" title="Clear all"><i class="bi bi-x-lg"></i></button>
                        <button type="button" class="btn btn-sm btn-outline-warning" id="formulaBackspaceBtn" title="Remove last"><i class="bi bi-backspace"></i></button>
                    </div>
                    <div class="d-flex align-items-center gap-2 mt-1">
                        <span class="small text-muted">Preview:</span>
                        <div class="formula-preview flex-grow-1" id="formulaPreview">—</div>
                        <span class="formula-validation" id="formulaValidation"></span>
                    </div>
                    <span asp-validation-for="Formula_Expression" class="text-danger small"></span>
                </div>

                <!-- Row 3: Validity Condition -->
                <div class="mb-2">
                    <label asp-for="Validity_Condition" class="form-label small fw-semibold mb-1"></label>
                    <input asp-for="Validity_Condition" class="form-control form-control-sm" placeholder="e.g. Not valid if Triglycerides > 400" />
                    <span asp-validation-for="Validity_Condition" class="text-danger small"></span>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-3">
                    <a asp-action="Index" class="btn btn-sm btn-outline-secondary px-3">
                        <i class="bi bi-arrow-left me-1"></i>Cancel
                    </a>
                    <button type="submit" class="btn btn-sm btn-primary px-3" id="submitBtn">
                        <i class="bi bi-check-lg me-1"></i>Save Formula
                    </button>
                </div>
            </form>
        </div>
    </div>

    <div class="card border-0 shadow-sm mt-2 bg-light">
        <div class="card-body py-2 px-3">
            <details>
                <summary class="small fw-semibold text-primary" style="cursor:pointer"><i class="bi bi-info-circle me-1"></i>Formula Builder Help</summary>
                <ul class="small text-muted mb-0 mt-1">
                    <li>Select a <strong>Target Test</strong> (the calculated parameter) and build its formula using component tests and operators.</li>
                    <li>Tests are stored by code (e.g. <code>[HDL]</code>) but displayed by name. Example: <code>[HDL] + [LDL] + ([TG] / 5)</code></li>
                    <li>Use +, −, ×, ÷ and parentheses. Type numeric constants directly in the input field.</li>
                </ul>
            </details>
        </div>
    </div>
</div>

@section Scripts {
<script src="~/lib/select2/dist/js/select2.min.js"></script>
<script>
$(function () {
    var formulaTokens = [];

    // Target test dropdown (Select2 AJAX)
    $('#testSelect').select2({
        theme: 'bootstrap-5',
        placeholder: '-- Select a numeric test --',
        allowClear: true,
        ajax: {
            url: '@Url.Action("SearchNumericTests", "LabFormulaParameters")',
            dataType: 'json',
            delay: 300,
            data: function (params) { return { term: params.term }; },
            processResults: function (data) { return { results: data }; }
        },
        minimumInputLength: 1
    });

    // Component test search (Select2 AJAX)
    $('#componentTestSearch').select2({
        theme: 'bootstrap-5',
        placeholder: 'Search test component to add...',
        allowClear: true,
        ajax: {
            url: '@Url.Action("SearchNumericTests", "LabFormulaParameters")',
            dataType: 'json',
            delay: 300,
            data: function (params) { return { term: params.term }; },
            processResults: function (data) { return { results: data }; }
        },
        minimumInputLength: 1
    });

    // When a component test is selected, add as chip
    $('#componentTestSearch').on('select2:select', function (e) {
        var d = e.params.data;
        addToken({ type: 'test', code: d.code, name: d.name, testId: d.id });
        $(this).val(null).trigger('change');
    });

    // Operator buttons
    $('.op-btn').on('click', function () {
        flushDirectInput();
        addToken({ type: 'op', value: $(this).data('op') });
    });

    // Direct input: only allow digits, decimal point, operators, and control keys
    $('#formulaDirectInput').on('keydown', function (e) {
        if (e.key === 'Enter') { e.preventDefault(); flushDirectInput(); return; }
        if (e.key === 'Backspace' && !$(this).val()) { e.preventDefault(); removeLastToken(); return; }
        var allowed = '0123456789.+-*/()';
        if (e.key.length === 1 && allowed.indexOf(e.key) === -1 && !e.ctrlKey && !e.metaKey) {
            e.preventDefault();
        }
    });
    $('#formulaDirectInput').on('input', function () {
        $(this).val($(this).val().replace(/[^0-9.+\-*/()]/g, ''));
    });

    $('#formulaBuilder').on('click', function () { $('#formulaDirectInput').focus(); });

    // Clear & backspace
    $('#formulaClearBtn').on('click', function () { formulaTokens = []; renderBuilder(); });
    $('#formulaBackspaceBtn').on('click', function () { removeLastToken(); });

    // Remove chip via X
    $(document).on('click', '.chip-remove', function () {
        var idx = $(this).closest('.chip').data('idx');
        formulaTokens.splice(idx, 1);
        renderBuilder();
    });

    function flushDirectInput() {
        var val = $.trim($('#formulaDirectInput').val()).replace(/[^0-9.+\-*/()]/g, '');
        if (!val) { $('#formulaDirectInput').val(''); return; }
        var parts = val.match(/(\d+\.?\d*|[+\-*/()])/g);
        if (parts) {
            for (var i = 0; i < parts.length; i++) {
                if (/^\d/.test(parts[i])) {
                    addToken({ type: 'num', value: parts[i] });
                } else {
                    addToken({ type: 'op', value: parts[i] });
                }
            }
        }
        $('#formulaDirectInput').val('');
    }

    function addToken(token) {
        formulaTokens.push(token);
        renderBuilder();
    }

    function removeLastToken() {
        if (formulaTokens.length) {
            formulaTokens.pop();
            renderBuilder();
        }
    }

    function renderBuilder() {
        var container = $('#formulaBuilder');
        container.find('.chip').remove();
        var input = container.find('.formula-input');

        for (var i = 0; i < formulaTokens.length; i++) {
            var t = formulaTokens[i];
            var chip;
            if (t.type === 'test') {
                chip = $('<span class="chip chip-test" data-idx="' + i + '"><i class="bi bi-flask me-1"></i>' + escHtml(t.name) + ' <small class="text-primary-emphasis">(' + escHtml(t.code) + ')</small><span class="chip-remove">&times;</span></span>');
            } else if (t.type === 'op') {
                chip = $('<span class="chip chip-op" data-idx="' + i + '">' + escHtml(t.value) + '<span class="chip-remove">&times;</span></span>');
            } else {
                chip = $('<span class="chip chip-op" data-idx="' + i + '">' + escHtml(t.value) + '<span class="chip-remove">&times;</span></span>');
            }
            input.before(chip);
        }

        updateExpression();
    }

    function updateExpression() {
        var expr = '';
        for (var i = 0; i < formulaTokens.length; i++) {
            var t = formulaTokens[i];
            if (t.type === 'test') {
                expr += '[' + t.code + ']';
            } else {
                expr += t.value;
            }
            if (i < formulaTokens.length - 1 &&
                formulaTokens[i].type !== 'op' && formulaTokens[i+1] && formulaTokens[i+1].type !== 'op') {
                expr += ' ';
            }
        }
        $('#formulaExpressionHidden').val(expr);
        $('#formulaPreview').text(expr || '—');
        validateFormula(expr);
    }

    function validateFormula(expr) {
        var el = $('#formulaValidation');
        if (!expr) { el.html(''); return; }

        var open = 0;
        for (var i = 0; i < expr.length; i++) {
            if (expr[i] === '(') open++;
            if (expr[i] === ')') open--;
            if (open < 0) { el.html('<span class="text-danger"><i class="bi bi-x-circle me-1"></i>Unmatched closing parenthesis</span>'); return; }
        }
        if (open > 0) { el.html('<span class="text-warning"><i class="bi bi-exclamation-triangle me-1"></i>' + open + ' unclosed parenthesis(es)</span>'); return; }

        var testRefs = expr.match(/\[[^\]]+\]/g);
        if (!testRefs || testRefs.length < 1) { el.html('<span class="text-warning"><i class="bi bi-exclamation-triangle me-1"></i>Formula should reference at least one test</span>'); return; }

        el.html('<span class="text-success"><i class="bi bi-check-circle me-1"></i>Formula looks valid</span>');
    }

    function escHtml(s) { return $('<span>').text(s).html(); }

    // Form submit: flush any pending input
    $('#formulaForm').on('submit', function () {
        flushDirectInput();
        updateExpression();
        var expr = $('#formulaExpressionHidden').val();
        if (!expr) {
            alert('Please build a formula expression before saving.');
            return false;
        }
    });

    var valSummary = $('[data-valmsg-summary]');
    if (valSummary.find('li').length) valSummary.removeAttr('hidden');
});
</script>
}
