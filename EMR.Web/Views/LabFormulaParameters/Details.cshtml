@model EMR.Web.ApiClients.Models.LabFormulaParameterModel

@{
    ViewData["Title"] = "Formula Parameter Details";
}

<div class="container-fluid px-4 py-3">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                    <li class="breadcrumb-item text-muted">Lab Master</li>
                    <li class="breadcrumb-item"><a asp-action="Index">Lab Formula Component</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Details</li>
                </ol>
            </nav>
            <h4 class="fw-bold mb-0 text-primary">
                <i class="bi bi-eye me-2"></i>Formula Parameter Details
            </h4>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Edit" asp-encrypted-id="@Model.Parameter_ID" class="btn btn-outline-primary px-3">
                <i class="bi bi-pencil-square me-1"></i>Edit
            </a>
            <a asp-action="Index" class="btn btn-outline-secondary px-3">
                <i class="bi bi-arrow-left me-1"></i>Back to List
            </a>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-4">
                    <dl class="row mb-0">
                        <dt class="col-sm-4 text-muted">Parameter ID</dt>
                        <dd class="col-sm-8 fw-semibold">#@Model.Parameter_ID</dd>

                        <dt class="col-sm-4 text-muted">Target Test</dt>
                        <dd class="col-sm-8 fw-semibold">@Model.Test_Name <code class="ms-1">(@Model.Test_Code)</code></dd>

                        <dt class="col-sm-4 text-muted">Formula Expression</dt>
                        <dd class="col-sm-8">
                            <div class="bg-light rounded p-2 font-monospace" id="formulaDisplay">
                                @Model.Formula_Expression
                            </div>
                        </dd>

                        <dt class="col-sm-4 text-muted">Rounding Precision</dt>
                        <dd class="col-sm-8">@Model.Rounding_Precision decimal place(s)</dd>

                        <dt class="col-sm-4 text-muted">Validity Condition</dt>
                        <dd class="col-sm-8">@(Model.Validity_Condition ?? "—")</dd>

                        <dt class="col-sm-4 text-muted">Status</dt>
                        <dd class="col-sm-8">
                            @if (Model.IsActive)
                            {
                                <span class="badge bg-success-subtle text-success rounded-pill px-3">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-danger-subtle text-danger rounded-pill px-3">Inactive</span>
                            }
                        </dd>

                        <dt class="col-sm-4 text-muted">Created</dt>
                        <dd class="col-sm-8">@Model.CreatedDate.ToString("dd MMM yyyy HH:mm")</dd>

                        @if (Model.ModifiedDate.HasValue)
                        {
                            <dt class="col-sm-4 text-muted">Last Modified</dt>
                            <dd class="col-sm-8">@Model.ModifiedDate.Value.ToString("dd MMM yyyy HH:mm")</dd>
                        }
                    </dl>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-transparent fw-semibold">
                    <i class="bi bi-lightning me-1"></i>Quick Actions
                </div>
                <div class="card-body">
                    <form asp-action="ToggleStatus" method="post" class="mb-2">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Parameter_ID" />
                        <input type="hidden" name="isActive" value="@((!Model.IsActive).ToString().ToLower())" />
                        <button type="submit" class="btn btn-outline-warning w-100">
                            <i class="bi bi-toggle-@(Model.IsActive ? "on" : "off") me-1"></i>
                            @(Model.IsActive ? "Deactivate" : "Activate")
                        </button>
                    </form>
                    <form asp-action="Delete" method="post"
                          onsubmit="return confirm('Are you sure you want to delete this formula parameter?');">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Parameter_ID" />
                        <button type="submit" class="btn btn-outline-danger w-100">
                            <i class="bi bi-trash me-1"></i>Delete
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
