@model EMR.Web.Models.ViewModels.LabFranchiseIndexViewModel

@{
    ViewData["Title"] = "Franchise Setup Master";
}

<div class="container-fluid px-4 py-3">
    <!-- Breadcrumb & Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                    <li class="breadcrumb-item text-muted">Lab Master</li>
                    <li class="breadcrumb-item active" aria-current="page">Franchise Setup</li>
                </ol>
            </nav>
            <h4 class="fw-bold mb-0 text-primary">
                <i class="bi bi-building-gear me-2"></i>Franchise Setup Master
            </h4>
        </div>
        <div>
            <a asp-action="Create" class="btn btn-primary px-3 shadow-sm">
                <i class="bi bi-plus-lg me-1"></i> Add New Franchise (Wizard)
            </a>
        </div>
    </div>

    <!-- Alert Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Summary Widgets Card -->
    <div class="row g-3 mb-4">
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm border-start border-4 border-primary">
                <div class="card-body py-3">
                    <div class="d-flex align-items-center">
                        <div class="flex-shrink-0 me-3 text-primary fs-3">
                            <i class="bi bi-buildings"></i>
                        </div>
                        <div>
                            <div class="text-muted small fw-semibold">Total Franchises</div>
                            <div class="fs-4 fw-bold text-dark">@Model.Franchises.Count</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm border-start border-4 border-success">
                <div class="card-body py-3">
                    <div class="d-flex align-items-center">
                        <div class="flex-shrink-0 me-3 text-success fs-3">
                            <i class="bi bi-check-circle"></i>
                        </div>
                        <div>
                            <div class="text-muted small fw-semibold">Active & Normal</div>
                            <div class="fs-4 fw-bold text-dark">@Model.Franchises.Count(x => x.IsActive && !x.Status)</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm border-start border-4 border-warning">
                <div class="card-body py-3">
                    <div class="d-flex align-items-center">
                        <div class="flex-shrink-0 me-3 text-warning fs-3">
                            <i class="bi bi-exclamation-triangle"></i>
                        </div>
                        <div>
                            <div class="text-muted small fw-semibold">Suspended</div>
                            <div class="fs-4 fw-bold text-dark">@Model.Franchises.Count(x => x.Status)</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm border-start border-4 border-info">
                <div class="card-body py-3">
                    <div class="d-flex align-items-center">
                        <div class="flex-shrink-0 me-3 text-info fs-3">
                            <i class="bi bi-wallet2"></i>
                        </div>
                        <div>
                            <div class="text-muted small fw-semibold">Total Credit Limits</div>
                            <div class="fs-4 fw-bold text-dark">₹@Model.Franchises.Sum(x => x.Credit_Limit).ToString("N0")</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Filter Card -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-3">
            <form method="get" asp-action="Index" class="row g-3 align-items-end">
                <div class="col-md-3">
                    <label class="form-label small fw-semibold text-muted">Franchise Type</label>
                    <select name="franchiseType" class="form-select" asp-items="Model.FranchiseTypeOptions">
                        <option value="">-- All Types --</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-semibold text-muted">Parent Branch</label>
                    <select name="parentBranchId" class="form-select" asp-items="Model.BranchOptions">
                        <option value="">-- All Branches --</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label small fw-semibold text-muted">Suspension Status</label>
                    <select name="status" class="form-select" asp-items="Model.StatusOptions">
                        <option value="">-- All --</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label small fw-semibold text-muted">Active Status</label>
                    <select name="isActive" class="form-select" asp-items="Model.IsActiveOptions">
                        <option value="">-- All --</option>
                    </select>
                </div>
                <div class="col-md-2 d-flex gap-2">
                    <button type="submit" class="btn btn-secondary w-100 fw-semibold">
                        <i class="bi bi-funnel me-1"></i> Filter
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary" title="Reset Filters">
                        <i class="bi bi-arrow-counterclockwise"></i>
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- Table Card -->
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-transparent border-0 pt-3 pb-0 d-flex justify-content-between align-items-center">
            <h6 class="fw-bold mb-0 text-dark">
                <i class="bi bi-table me-2 text-primary"></i>Franchise List
            </h6>
            <span class="badge bg-light text-dark border">Total: @Model.Franchises.Count Record(s)</span>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th class="ps-3" style="width: 110px;">Code</th>
                            <th>Franchise Name</th>
                            <th>Contact Info</th>
                            <th>Type</th>
                            <th>Parent Branch</th>
                            <th>Credit Facility</th>
                            <th class="text-end">Credit Limit</th>
                            <th class="text-center">Suspended?</th>
                            <th class="text-center">IsActive</th>
                            <th class="text-end pe-3" style="width: 200px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Franchises.Any())
                        {
                            <tr>
                                <td colspan="10" class="text-center py-5 text-muted">
                                    <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                                    No Franchise records found matching the criteria.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model.Franchises)
                            {
                                <tr>
                                    <td class="ps-3 fw-bold text-primary">@item.Franchise_Code</td>
                                    <td>
                                        <div class="fw-semibold text-dark">@item.Franchise_Name</div>
                                    </td>
                                    <td>
                                        <div><i class="bi bi-telephone text-muted me-1"></i>@item.Mobile_No</div>
                                        @if (!string.IsNullOrEmpty(item.Email))
                                        {
                                            <small class="text-muted"><i class="bi bi-envelope me-1"></i>@item.Email</small>
                                        }
                                    </td>
                                    <td>
                                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle">
                                            @item.Franchise_Type_Name
                                        </span>
                                    </td>
                                    <td><small class="fw-semibold">@item.Parent_Branch_Name</small></td>
                                    <td>
                                        <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle">
                                            @item.Credit_Facility_Type_Name
                                        </span>
                                    </td>
                                    <td class="text-end fw-bold text-dark">
                                        ₹@item.Credit_Limit.ToString("N2")
                                        @if (item.Temporary_Limit_Increase > 0)
                                        {
                                            <div class="small text-success">+₹@item.Temporary_Limit_Increase.ToString("N0") (Temp)</div>
                                        }
                                    </td>
                                    <td class="text-center">
                                        @if (item.Status)
                                        {
                                            <span class="badge bg-danger" title="@item.Suspension_Reason">
                                                <i class="bi bi-exclamation-triangle-fill me-1"></i>Suspended
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle">
                                                <i class="bi bi-check-circle me-1"></i>Normal
                                            </span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <form asp-action="ToggleStatus" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@item.Franchise_ID" />
                                            <input type="hidden" name="isActive" value="@(item.IsActive ? "false" : "true")" />
                                            <button type="submit" class="btn btn-sm p-0 border-0" title="Click to toggle Active state">
                                                @if (item.IsActive)
                                                {
                                                    <span class="badge bg-success fs-6"><i class="bi bi-toggle-on me-1"></i>Active</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary fs-6"><i class="bi bi-toggle-off me-1"></i>Inactive</span>
                                                }
                                            </button>
                                        </form>
                                    </td>
                                    <td class="text-end pe-3">
                                        <div class="btn-group btn-group-sm shadow-sm" role="group">
                                            <a asp-action="Details" asp-route-id="@item.Franchise_ID" class="btn btn-outline-info" title="View Details">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            <a asp-action="Edit" asp-route-id="@item.Franchise_ID" class="btn btn-outline-primary" title="Edit Franchise (Wizard)">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <!-- Suspension Button before Delete -->
                                            <button type="button" class="btn @(item.Status ? "btn-outline-success" : "btn-outline-warning")" data-bs-toggle="modal" data-bs-target="#suspensionModal_@item.Franchise_ID" title="@(item.Status ? "Unsuspend Franchise" : "Suspend Franchise")">
                                                <i class="bi @(item.Status ? "bi-play-circle" : "bi-slash-circle")"></i> @(item.Status ? "Unsuspend" : "Suspend")
                                            </button>
                                            <!-- Delete Button -->
                                            <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteModal_@item.Franchise_ID" title="Delete Franchise">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </div>

                                        <!-- Suspension Modal -->
                                        <div class="modal fade text-start" id="suspensionModal_@item.Franchise_ID" tabindex="-1" aria-hidden="true">
                                            <div class="modal-dialog">
                                                <div class="modal-content">
                                                    <form asp-action="ToggleSuspension" method="post">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="id" value="@item.Franchise_ID" />
                                                        <input type="hidden" name="status" value="@(item.Status ? "false" : "true")" />
                                                        <div class="modal-header @(item.Status ? "bg-success text-white" : "bg-warning text-dark")">
                                                            <h5 class="modal-title fw-bold">
                                                                <i class="bi bi-shield-exclamation me-2"></i>
                                                                @(item.Status ? "Unsuspend Franchise" : "Suspend Franchise")
                                                            </h5>
                                                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                        </div>
                                                        <div class="modal-body">
                                                            <p>Are you sure you want to @(item.Status ? "unsuspend" : "suspend") <strong>@item.Franchise_Name</strong> (@item.Franchise_Code)?</p>
                                                            @if (!item.Status)
                                                            {
                                                                <div class="mb-3">
                                                                    <label class="form-label fw-semibold">Suspension Reason</label>
                                                                    <textarea name="suspensionReason" class="form-control" rows="3" placeholder="Enter reason for suspending this franchise..." required></textarea>
                                                                </div>
                                                            }
                                                        </div>
                                                        <div class="modal-footer">
                                                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                                            <button type="submit" class="btn @(item.Status ? "btn-success" : "btn-warning")">
                                                                Confirm @(item.Status ? "Unsuspension" : "Suspension")
                                                            </button>
                                                        </div>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Delete Confirmation Modal -->
                                        <div class="modal fade text-start" id="deleteModal_@item.Franchise_ID" tabindex="-1" aria-hidden="true">
                                            <div class="modal-dialog">
                                                <div class="modal-content">
                                                    <form asp-action="Delete" method="post">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="id" value="@item.Franchise_ID" />
                                                        <div class="modal-header bg-danger text-white">
                                                            <h5 class="modal-title fw-bold"><i class="bi bi-exclamation-triangle-fill me-2"></i>Delete Franchise</h5>
                                                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                                                        </div>
                                                        <div class="modal-body">
                                                            Are you sure you want to delete franchise <strong>@item.Franchise_Name</strong> (@item.Franchise_Code)?
                                                        </div>
                                                        <div class="modal-footer">
                                                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                                            <button type="submit" class="btn btn-danger">Delete</button>
                                                        </div>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>

                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
