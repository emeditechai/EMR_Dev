            </button>
            <button type="button" class="btn btn-info text-white btn-sm px-3.5 fw-semibold shadow-xs btn-action-approve" id="btnStickyApprove" style="@(showApprove ? "" : "display:none;")">
                <i class="bi bi-patch-check-fill me-1"></i>Approve Report
