<!-- Template / Image Report Editor Modal                                      -->
<!-- ========================================================================= -->
<div class="modal fade" id="modalReportEditor" tabindex="-1" data-bs-backdrop="static" data-bs-keyboard="false" aria-labelledby="modalReportEditorTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xl">
        <div class="modal-content shadow-lg border-0">
            <!-- Modal Header -->
            <div class="modal-header bg-light py-2 px-3 border-bottom d-flex align-items-center justify-content-between">
                <div>
                    <h5 class="modal-title fw-bold text-dark fs-6 d-flex align-items-center gap-2" id="modalReportEditorTitle">
                        <i class="bi bi-file-earmark-richtext text-primary"></i>
                        <span id="editorTestName">Investigation Name</span>
                        <span class="badge badge-modality fs-9" id="editorModalityBadge">CT</span>
                    </h5>
                    <div class="text-muted fs-8 mt-0.5">
                        Patient: <strong>@d.PatientName</strong> | @(d.Age.HasValue ? $"{d.Age} Y" : "") · @d.Gender | UHID: <code>@d.PatientCode</code> | Bill: @(d.BillNo ?? "—")
                    </div>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <button type="button" class="btn btn-outline-danger btn-sm py-1 px-2.5 fs-9" id="btnResetToDefaultTemplate" title="Reset editor to default template">
                        <i class="bi bi-arrow-counterclockwise me-1"></i>Reload Original Template
                    </button>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
            </div>

            <!-- Modal Body -->
            <div class="modal-body p-3">
                <!-- Lock Notice if Approved -->
                <div class="alert alert-info py-2 px-3 fs-8 mb-2 d-none" id="alertApprovedNotice">
                    <i class="bi bi-lock-fill me-1.5 text-primary"></i>
                    <strong>Report Approved:</strong> This report has been finalized and approved. It is locked against further edits.
                </div>

                <!-- Quick Insert Panel -->
                <div class="card bg-light border-0 shadow-none mb-2.5 p-2 px-3 quick-tags-panel">
                    <div class="d-flex align-items-center gap-2 mb-1 flex-wrap">
                        <span class="fw-bold fs-9 text-uppercase text-secondary" style="letter-spacing: 0.4px;">
                            <i class="bi bi-lightning-charge-fill text-warning me-1"></i>Quick Insert:
                        </span>
                        <span class="badge bg-primary quick-tag-badge" data-tag="{{PatientName}}">Patient Name</span>
                        <span class="badge bg-primary quick-tag-badge" data-tag="{{PatientAge}}">Patient Age</span>
                        <span class="badge bg-primary quick-tag-badge" data-tag="{{PatientGender}}">Patient Gender</span>
                        <span class="badge bg-primary quick-tag-badge" data-tag="{{UHID}}">UHID</span>
                        <span class="badge bg-success quick-tag-badge" data-tag="{{StudyDate}}">Study Date</span>
                        <span class="badge bg-success quick-tag-badge" data-tag="{{Modality}}">Modality</span>
                        <span class="badge bg-success quick-tag-badge" data-tag="{{BodyPart}}">Body Part</span>
                        <span class="badge bg-success quick-tag-badge" data-tag="{{Laterality}}">Laterality</span>
                        <span class="badge bg-info text-dark quick-tag-badge" data-tag="{{ReferringDoctor}}">Referring Doctor</span>
                        <span class="badge bg-secondary quick-tag-badge" data-tag="{{SliceThickness}}">Slice Thickness</span>
                        <span class="badge bg-secondary quick-tag-badge" data-tag="{{DLP}}">DLP</span>
                        <span class="badge bg-secondary quick-tag-badge" data-tag="{{CTDIvol}}">CTDIvol</span>
                    </div>
                </div>

                <!-- Quill Rich Text Editor Container -->
                <div id="imageReportEditor"></div>
            </div>

            <!-- Modal Footer (Mirrors Submit & Approval Progression: No Save Draft) -->
            <div class="modal-footer bg-light py-2 px-3 border-top d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center gap-2">
                    <span class="text-muted fs-8">Current Status:</span>
                    <span id="editorCurrentStatusBadge" class="badge fs-8">Pending Entry</span>
                </div>
                <div class="d-flex align-items-center gap-2" id="modalActionButtons">
                    <button type="button" class="btn btn-outline-secondary btn-sm px-3" data-bs-dismiss="modal">
                        <i class="bi bi-x me-1"></i>Close
                    </button>

                    <!-- Submit Report (Status 2) -->
                    <button type="button" class="btn btn-primary btn-sm px-3.5 fw-semibold shadow-xs btn-action-save btn-modal-submit" data-status-id="2">
                        <i class="bi bi-send-check me-1"></i><span class="btn-submit-text">Submit Report</span>
                    </button>

                    <!-- Validate Report (Status 3) -->
                    <button type="button" class="btn btn-success btn-sm px-3.5 fw-semibold shadow-xs btn-action-validate btn-modal-validate" data-status-id="3" style="display:none;">
                        <i class="bi bi-check-circle-fill me-1"></i>Validate Report
                    </button>

                    <!-- Approve Report (Status 5) -->
                    <button type="button" class="btn btn-info text-white btn-sm px-3.5 fw-semibold shadow-xs btn-action-approve btn-modal-approve" data-status-id="5" style="display:none;">
                        <i class="bi bi-patch-check-fill me-1"></i>Approve Report
                    </button>

                    <!-- Pathologist Warning Badge in modal -->
                    <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle px-3 py-2 fs-8 badge-modal-pathologist d-none"
                          title="Hospital Settings > LAB > Pathologist approval required is switched on for this branch">
                        <i class="bi bi-shield-lock-fill me-1"></i>Approval by pathologist
                    </span>

                    <!-- Approved Badge in modal -->
                    <span class="badge bg-info-subtle text-info border border-info-subtle px-3 py-2 fs-8 badge-modal-approved d-none">
                        <i class="bi bi-patch-check-fill me-1"></i>Report Approved
                    </span>
                </div>
            </div>
        </div>
    </div>
</div>

