@model EMR.Web.Models.ViewModels.LabReportingEntryPageViewModel
@{
    var d = Model.Detail;
    ViewData["Title"] = $"Image Report Entry - {d.PatientName} ({d.TokenNo})";

    var latestDrafted = d.Items?.FirstOrDefault(x => x.DraftedDate.HasValue)?.DraftedDate;
    var latestSubmitted = d.Items?.FirstOrDefault(x => x.SubmittedDate.HasValue)?.SubmittedDate;
    var latestValidated = d.Items?.FirstOrDefault(x => x.ValidatedDate.HasValue)?.ValidatedDate;
    var latestApproved = d.Items?.FirstOrDefault(x => x.ApprovedDate.HasValue)?.ApprovedDate;

    var activeItems = d.Items?.Where(x => x.CollectionstatusID != 3 && x.CollectionstatusID != 4).ToList() ?? new();
    int totalCount = activeItems.Count;
    int enteredCount = activeItems.Count(x => !string.IsNullOrWhiteSpace(x.TemplateHtml) || !string.IsNullOrWhiteSpace(x.TestValue));
    int unenteredCount = totalCount - enteredCount;
    int submittedCount = activeItems.Count(x => x.ReportStatusId == 2);
    int validatedCount = activeItems.Count(x => x.ReportStatusId == 3);
    int approvedCount = activeItems.Count(x => x.ReportStatusId == 5);

    bool isAllApproved = (totalCount > 0 && approvedCount == totalCount);
    bool isPartialApproved = (approvedCount > 0 && approvedCount < totalCount);

    // Matching LabReporting/Entry logic:
    bool showSubmit = (unenteredCount > 0 || activeItems.Any(x => x.ReportStatusId < 2)) && !isAllApproved;
    bool showValidate = (submittedCount > 0) && !isAllApproved;
    bool pathologistApprovalRequired = Model.PathologistApprovalRequired;
    bool showApprove = (validatedCount > 0) && !isAllApproved && !pathologistApprovalRequired;
    bool showApprovedBadge = isAllApproved || isPartialApproved;
    bool showPrint = (validatedCount + approvedCount) > 0;

    var genderKey = (d.Gender ?? string.Empty).Trim().ToLowerInvariant() switch
    {
        "male" or "m" => "male",
        "female" or "f" => "female",
        _ => "other"
    };
}

@section HeadStyles {
    <link rel="stylesheet" href="~/lib/quill/quill.snow.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" />
    <style>
        .reporting-entry-wrapper, .sticky-action-bar {
            --brand: #4f46e5; --brand-2: #7c3aed;
            --st-pending:   #64748b; --st-pending-bg:   #f1f5f9; --st-pending-bd:   #cbd5e1;
            --st-draft:     #b45309; --st-draft-bg:     #fef3c7; --st-draft-bd:     #fcd34d;
            --st-submitted: #1d4ed8; --st-submitted-bg: #dbeafe; --st-submitted-bd: #93c5fd;
            --st-validated: #15803d; --st-validated-bg: #dcfce7; --st-validated-bd: #86efac;
            --st-approved:  #0f766e; --st-approved-bg:  #ccfbf1; --st-approved-bd:  #5eead4;
            --st-recollect: #c2410c; --st-recollect-bg: #ffedd5; --st-recollect-bd: #fdba74;
            --st-rejected:  #b91c1c; --st-rejected-bg:  #fee2e2; --st-rejected-bd:  #fca5a5;
        }
        .reporting-entry-wrapper {
            background: linear-gradient(180deg, #eef2ff 0%, #f8fafc 260px);
            min-height: calc(100vh - 60px);
            padding-bottom: 75px; /* space for sticky footer */
        }

        /* ── Patient banner ── */
        .reporting-entry-wrapper .patient-banner {
            position: relative;
            overflow: hidden;
            background: #ffffff;
            border: 1px solid #e0e7ff;
            border-radius: 14px;
            padding: 14px 18px 14px 24px;
            box-shadow: 0 6px 20px rgba(79, 70, 229, 0.09) !important;
        }
        .reporting-entry-wrapper .patient-banner::before {
            content: "";
            position: absolute; left: 0; top: 0; bottom: 0; width: 6px;
            background: linear-gradient(180deg, var(--brand), var(--brand-2) 55%, #0d9488);
        }
        .reporting-entry-wrapper .patient-avatar-box {
            width: 48px; height: 48px; border-radius: 12px; border: 0; color: #fff;
            box-shadow: 0 4px 10px rgba(79, 70, 229, 0.25);
            background: linear-gradient(135deg, #6366f1, #7c3aed);
            display: flex; align-items: center; justify-content: center; font-size: 1.4rem;
            margin-right: 12px;
            flex-shrink: 0;
        }
        .reporting-entry-wrapper .patient-avatar-box.gender-male   { background: linear-gradient(135deg, #38bdf8, #2563eb); box-shadow: 0 4px 10px rgba(37, 99, 235, 0.28); }
        .reporting-entry-wrapper .patient-avatar-box.gender-female { background: linear-gradient(135deg, #fb7185, #db2777); box-shadow: 0 4px 10px rgba(219, 39, 119, 0.28); }
        .reporting-entry-wrapper .patient-banner h6 { font-size: 1.05rem; color: #1e1b4b !important; }
        .reporting-entry-wrapper .patient-banner h6 + .btn-audit-info { margin-left: 8px; }
        .reporting-entry-wrapper .patient-banner .btn-audit-info + .badge { margin-left: 6px; }
        .reporting-entry-wrapper .patient-banner .btn-audit-info {
            border: 0;
            background: transparent;
            color: #4f46e5;
            padding: 0 4px;
            line-height: 1;
            font-size: 1.05rem;
            cursor: pointer;
            border-radius: 50%;
            transition: color .15s ease, transform .15s ease;
        }
        .reporting-entry-wrapper .patient-banner .btn-audit-info:hover {
            color: #3730a3;
            transform: scale(1.15);
        }
        .reporting-entry-wrapper .patient-banner .btn-audit-info:focus-visible {
            outline: 2px solid #818cf8;
            outline-offset: 2px;
        }
        .reporting-entry-wrapper .patient-banner .badge.font-monospace {
            background-color: #eef2ff !important; color: #4338ca !important; border-color: #c7d2fe !important;
        }

        /* ── Info pills: colour-coded by meaning ── */
        .reporting-entry-wrapper .info-pill {
            --pill: #64748b; --pill-bg: #f8fafc;
            border: 1px solid #e2e8f0;
            border-left: 3px solid var(--pill);
            border-radius: 8px;
            background: linear-gradient(180deg, #ffffff 0%, var(--pill-bg) 100%);
            box-shadow: 0 1px 2px rgba(15, 23, 42, 0.05);
            padding: 4px 10px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            min-height: 42px;
        }
        .reporting-entry-wrapper .info-pill .pill-label { color: var(--pill); letter-spacing: 0.03em; font-size: 0.65rem; text-transform: uppercase; font-weight: 600; line-height: 1.1; white-space: nowrap; }
        .reporting-entry-wrapper .info-pill .pill-val { font-size: 0.82rem; font-weight: 600; color: #0f172a; line-height: 1.2; white-space: nowrap; }
        .reporting-entry-wrapper .pill-token   { --pill: #4f46e5; --pill-bg: #eef2ff; }
        .reporting-entry-wrapper .pill-bill    { --pill: #7c3aed; --pill-bg: #f5f3ff; }
        .reporting-entry-wrapper .pill-client  { --pill: #0f766e; --pill-bg: #f0fdfa; }
        .reporting-entry-wrapper .pill-client .pill-val { max-width: 210px; }
        .reporting-entry-wrapper .pill-booking { --pill: #0284c7; --pill-bg: #f0f9ff; }
        .reporting-entry-wrapper .pill-collect { --pill: #0d9488; --pill-bg: #f0fdfa; }
        .reporting-entry-wrapper #pillPayment  { --pill: #16a34a; --pill-bg: #f0fdf4; }
        .reporting-entry-wrapper #pillPayment:has(.bg-danger-subtle) { --pill: #dc2626; --pill-bg: #fef2f2; }
        .reporting-entry-wrapper #pillOrderStatus { --pill: #4f46e5; --pill-bg: #eef2ff; }
        .reporting-entry-wrapper #pillDrafted   { --pill: var(--st-draft);     --pill-bg: #fffbeb; }
        .reporting-entry-wrapper #pillSubmitted { --pill: var(--st-submitted); --pill-bg: #eff6ff; }
        .reporting-entry-wrapper #pillValidated { --pill: var(--st-validated); --pill-bg: #f0fdf4; }
        .reporting-entry-wrapper #pillApproved  { --pill: var(--st-approved);  --pill-bg: #f0fdfa; }
        .reporting-entry-wrapper #pillDrafted   .pill-label, .reporting-entry-wrapper #pillDrafted   .pill-val, .reporting-entry-wrapper #pillDrafted   i { color: var(--st-draft) !important; }
        .reporting-entry-wrapper #pillSubmitted .pill-label, .reporting-entry-wrapper #pillSubmitted .pill-val, .reporting-entry-wrapper #pillSubmitted i { color: var(--st-submitted) !important; }
        .reporting-entry-wrapper #pillValidated .pill-label, .reporting-entry-wrapper #pillValidated .pill-val, .reporting-entry-wrapper #pillValidated i { color: var(--st-validated) !important; }
        .reporting-entry-wrapper #pillApproved  .pill-label, .reporting-entry-wrapper #pillApproved  .pill-val, .reporting-entry-wrapper #pillApproved  i { color: var(--st-approved) !important; }

        /* ── Progress + colour legend strip ── */
        .reporting-entry-wrapper .workflow-strip {
            background: #ffffff;
            border: 1px solid #e0e7ff;
            border-radius: 12px;
            padding: 10px 14px 12px;
            box-shadow: 0 2px 8px rgba(15, 23, 42, 0.05);
        }
        .workflow-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px; }
        .workflow-title { font-size: 0.74rem; font-weight: 700; color: #3730a3; text-transform: uppercase; letter-spacing: 0.05em; }
        .workflow-percent { font-size: 0.76rem; font-weight: 700; color: var(--st-approved); }
        .workflow-bar {
            display: flex; height: 9px; border-radius: 999px; overflow: hidden;
            background: #e2e8f0; margin-bottom: 9px;
        }
        .wf-seg { display: block; height: 100%; width: 0; transition: width 0.35s ease; }
        .wf-seg.wf-c-approved  { background: var(--st-approved); }
        .wf-seg.wf-c-validated { background: #22c55e; }
        .wf-seg.wf-c-submitted { background: #3b82f6; }
        .wf-seg.wf-c-draft     { background: #f59e0b; }
        .wf-seg.wf-c-pending   { background: #cbd5e1; }
        .workflow-legend { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; }
        .wf-chip {
            display: inline-flex; align-items: center; gap: 5px;
            font-size: 0.72rem; font-weight: 600;
            padding: 2px 10px 2px 8px; border-radius: 999px; border: 1px solid;
            transition: opacity 0.2s ease;
        }
        .wf-chip b { font-weight: 800; }
        .wf-chip.is-zero { opacity: 0.45; }
        .wf-dot { width: 8px; height: 8px; border-radius: 50%; background: currentColor; display: inline-block; }
        .wf-chip.wf-c-pending   { color: var(--st-pending);   background: var(--st-pending-bg);   border-color: var(--st-pending-bd); }
        .wf-chip.wf-c-draft     { color: var(--st-draft);     background: var(--st-draft-bg);     border-color: var(--st-draft-bd); }
        .wf-chip.wf-c-submitted { color: var(--st-submitted); background: var(--st-submitted-bg); border-color: var(--st-submitted-bd); }
        .wf-chip.wf-c-validated { color: var(--st-validated); background: var(--st-validated-bg); border-color: var(--st-validated-bd); }
        .wf-chip.wf-c-approved  { color: var(--st-approved);  background: var(--st-approved-bg);  border-color: var(--st-approved-bd); }

        /* ── Workspace header ── */
        .reporting-entry-wrapper .btn-outline-secondary { border-color: #c7d2fe; color: #4338ca; }
        .reporting-entry-wrapper .btn-outline-secondary:hover { background: #eef2ff; border-color: #a5b4fc; color: #3730a3; }
        .reporting-entry-wrapper .btn-outline-danger:hover { box-shadow: 0 2px 6px rgba(220, 38, 38, 0.25); }

        /* ── Action buttons (Submit = blue, Validate = green, Approve = teal) ── */
        .btn.btn-action-save, .btn.btn-action-validate, .btn.btn-action-approve {
            border: 0; color: #fff; box-shadow: 0 2px 6px rgba(15, 23, 42, 0.18);
            transition: transform 0.12s ease, box-shadow 0.12s ease, filter 0.12s ease;
        }
        .btn.btn-action-save     { background: linear-gradient(135deg, #3b82f6, #4f46e5); }
        .btn.btn-action-validate { background: linear-gradient(135deg, #22c55e, #15803d); }
        .btn.btn-action-approve  { background: linear-gradient(135deg, #14b8a6, #0f766e); }
        .btn.btn-action-save:hover, .btn.btn-action-validate:hover, .btn.btn-action-approve:hover {
            color: #fff; filter: brightness(1.07); transform: translateY(-1px); box-shadow: 0 5px 12px rgba(15, 23, 42, 0.25);
        }
        .btn.btn-action-save:disabled, .btn.btn-action-validate:disabled, .btn.btn-action-approve:disabled { filter: grayscale(0.4); transform: none; }

        /* ── Investigation cards ── */
        .investigation-card {
            background: #ffffff;
            border: 1px solid #e0e7ff;
            border-radius: 12px;
            transition: all 0.2s ease;
            box-shadow: 0 2px 8px rgba(15, 23, 42, 0.05);
        }
        .investigation-card:hover {
            box-shadow: 0 6px 16px rgba(15, 23, 42, 0.08);
            border-color: #c7d2fe;
        }
        .investigation-card.st-pending   { border-left: 4px solid var(--st-pending); }
        .investigation-card.st-draft     { border-left: 4px solid var(--st-draft); }
        .investigation-card.st-submitted { border-left: 4px solid var(--st-submitted); }
        .investigation-card.st-validated { border-left: 4px solid var(--st-validated); }
        .investigation-card.st-approved  { border-left: 4px solid var(--st-approved); }

        .badge-modality {
            background: #eef2ff;
            color: #4338ca;
            border: 1px solid #c7d2fe;
            font-weight: 600;
        }

        /* ── Sticky Action Bar ── */
        .sticky-action-bar {
            position: fixed;
            bottom: 0;
            left: 0;
            right: 0;
            background: #ffffff;
            border-top: 0;
            box-shadow: 0 -6px 18px rgba(15, 23, 42, 0.09);
            z-index: 1020;
            padding: 10px 24px;
        }
        .sticky-action-bar::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 3px;
            background: linear-gradient(90deg, #4f46e5, #7c3aed 45%, #0d9488);
        }

        /* ── Quill Editor modal customization ── */
        #modalReportEditor .modal-dialog {
            max-width: 940px;
        }
        #imageReportEditor {
            min-height: 380px;
            max-height: 520px;
            overflow-y: auto;
            font-size: 0.95rem;
            line-height: 1.6;
            background: #ffffff;
        }
        .ql-toolbar.ql-snow {
            border-radius: 0.5rem 0.5rem 0 0;
            background: #f8fafc;
            border-color: #cbd5e1;
        }
        .ql-container.ql-snow {
            border-radius: 0 0 0.5rem 0.5rem;
            border-color: #cbd5e1;
        }
        .quick-tag-badge {
            cursor: pointer;
            user-select: none;
            font-size: 0.75rem;
            font-weight: 500;
            transition: transform 0.1s ease, opacity 0.1s ease;
        }
        .quick-tag-badge:hover {
            transform: scale(1.04);
            opacity: 0.88;
        }
        .fs-7 { font-size: 0.875rem !important; }
        .fs-8 { font-size: 0.8rem !important; }
        .fs-9 { font-size: 0.72rem !important; }
    </style>
}

<div class="reporting-entry-wrapper px-3 py-3">
    <!-- Breadcrumb & Top Bar -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0 fs-8">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none">Home</a></li>
                <li class="breadcrumb-item"><a asp-controller="LabImageReporting" asp-action="Index" class="text-decoration-none">Image Reporting Entry</a></li>
                <li class="breadcrumb-item active text-dark fw-semibold" aria-current="page">Report Entry: @(d.BillNo ?? $"#{d.LabOrderId}")</li>
            </ol>
        </nav>
        <div class="d-flex gap-2">
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm px-3">
                <i class="bi bi-arrow-left me-1"></i>Back to List
            </a>
            <button type="button" class="btn btn-outline-danger btn-sm px-3" onclick="window.close()">
                <i class="bi bi-x-circle me-1"></i>Close Tab
            </button>
        </div>
    </div>

    <!-- Patient Header Banner (2 Compact Aligned Rows) -->
    <div class="patient-banner shadow-sm mb-3">
        <div class="row g-2 align-items-center">
            <!-- Patient Identity -->
            <div class="col-xl-3 col-lg-4 col-12 d-flex align-items-center gap-2.5">
                <div class="patient-avatar-box gender-@genderKey flex-shrink-0">
                    <i class="bi bi-person-fill"></i>
                </div>
                <div class="text-truncate">
                    <div class="d-flex align-items-center gap-1.5 flex-wrap">
                        <h6 class="mb-0 fw-bold text-dark text-truncate" style="max-width: 170px;" title="@d.PatientName">@d.PatientName</h6>
                        <button type="button" class="btn-audit-info" id="btnAuditHistory"
                                data-laborderid="@d.LabOrderId" data-patient="@d.PatientName" data-bill="@(d.BillNo ?? "—")"
                                data-bs-toggle="tooltip" data-bs-placement="bottom"
                                title="View audit history for this bill"
                                aria-label="View audit history for this bill">
                            <i class="bi bi-info-circle-fill"></i>
                        </button>
                        <span class="badge bg-secondary-subtle text-secondary border font-monospace fs-9 py-0.5 px-1.5">@d.PatientCode</span>
                        @if (d.IsUrgent)
                        {
                            <span class="badge bg-danger text-white fs-9 py-0.5 px-1.5"><i class="bi bi-lightning-fill me-0.5"></i>Urgent</span>
                        }
                    </div>
                    <div class="text-muted fs-9 mt-0.5 d-flex align-items-center gap-2 flex-wrap">
                        <span><i class="bi bi-gender-ambiguous me-0.5"></i>@(d.Age.HasValue ? $"{d.Age}Y / " : "")@(d.Gender ?? "—")</span>
                        <span><i class="bi bi-telephone me-0.5"></i>@(d.PhoneNumber ?? "—")</span>
                    </div>
                </div>
            </div>

            <!-- Order / Token identifiers & status pills (2 Rows) -->
            <div class="col-xl-9 col-lg-8 col-12">
                <div class="d-flex flex-column gap-1.5">
                    <!-- Row 1: Key Metadata Pills -->
                    <div class="d-flex flex-wrap gap-1.5 justify-content-lg-end align-items-center">
                        <div class="info-pill pill-token">
                            <span class="pill-label">Token No</span>
                            <span class="pill-val font-monospace">@(d.TokenNo ?? "LAB")</span>
                        </div>
                        <div class="info-pill pill-bill">
                            <span class="pill-label">Bill / Order No</span>
                            <span class="pill-val font-monospace">@(d.BillNo ?? "—")</span>
                        </div>
                        @if (Model.B2BClient != null)
                        {
                            var b2bIsFranchise = string.Equals(Model.B2BClient.ClientType, "FRANCHISE", StringComparison.OrdinalIgnoreCase);
                            var b2bName = string.Join(" · ", new[] { Model.B2BClient.Code, Model.B2BClient.Name }.Where(x => !string.IsNullOrWhiteSpace(x)));
                            var b2bTip = string.Join(" | ", new[] { Model.B2BClient.Name, Model.B2BClient.Phone, Model.B2BClient.Address }.Where(x => !string.IsNullOrWhiteSpace(x)));
                            <div class="info-pill pill-client" id="pillB2BClient">
                                <span class="pill-label"><i class="bi @(b2bIsFranchise ? "bi-shop" : "bi-building") me-0.5"></i>B2B @(b2bIsFranchise ? "Franchise" : "Company")</span>
                                <span class="pill-val text-truncate" title="@b2bTip">@(string.IsNullOrWhiteSpace(b2bName) ? "—" : b2bName)</span>
                            </div>
                        }
                        <div class="info-pill pill-booking">
                            <span class="pill-label">Booking Time</span>
                            <span class="pill-val">@((d.BookingDateTime ?? d.OrderDate).ToString("dd MMM yyyy, hh:mm tt"))</span>
                        </div>
                        <div class="info-pill pill-collect">
                            <span class="pill-label">Collection Type</span>
                            <span class="pill-val">@d.CollectionType</span>
                        </div>
                        <div class="info-pill pill-collect">
                            <span class="pill-label">Referred By</span>
                            <span class="pill-val text-truncate" style="max-width: 150px;" title="@(d.ReferralDoctorName ?? "Self")">@(string.IsNullOrWhiteSpace(d.ReferralDoctorName) ? "Self" : d.ReferralDoctorName)</span>
                        </div>
                        <div class="info-pill" id="pillPayment">
                            <span class="pill-label">Payment Status</span>
                            <div>
                                @if (d.PaymentStatus == "P" || d.BalanceDue <= 0)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle py-0.5 px-1.5 fs-9 fw-bold">Paid (₹@d.TotalPaid.ToString("0.00"))</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle py-0.5 px-1.5 fs-9 fw-bold">Due: ₹@d.BalanceDue.ToString("0.00")</span>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- Row 2: Workflow Milestones & Timestamps -->
                    <div class="d-flex flex-wrap flex-lg-nowrap gap-1.5 justify-content-lg-end align-items-center" id="rowBannerStatusTimeline">
                        <div class="info-pill" id="pillOrderStatus">
                            <span class="pill-label"><i class="bi bi-shield-check text-primary me-0.5"></i>Report Status</span>
                            <div>
                                <span class="badge @(d.ReportBadgeClass) py-0.5 px-1.5 fs-9 fw-semibold" id="badgeOrderStatus">@(isPartialApproved ? $"Partially Approved ({approvedCount}/{totalCount})" : d.ReportStatusName)</span>
                            </div>
                        </div>
                        @if (latestDrafted.HasValue)
                        {
                            <div class="info-pill" id="pillDrafted">
                                <span class="pill-label text-warning-emphasis"><i class="bi bi-pencil-square text-warning me-0.5"></i>Drafted Date</span>
                                <span class="pill-val text-warning-emphasis font-monospace" id="pillDraftedVal">@latestDrafted.Value.ToString("dd MMM yyyy, hh:mm tt")</span>
                            </div>
                        }
                        @if (latestSubmitted.HasValue)
                        {
                            <div class="info-pill" id="pillSubmitted">
                                <span class="pill-label text-primary"><i class="bi bi-send-check text-primary me-0.5"></i>Submitted Date</span>
                                <span class="pill-val text-primary font-monospace" id="pillSubmittedVal">@latestSubmitted.Value.ToString("dd MMM yyyy, hh:mm tt")</span>
                            </div>
                        }
                        @if (latestValidated.HasValue)
                        {
                            <div class="info-pill" id="pillValidated">
                                <span class="pill-label text-success"><i class="bi bi-check2-circle text-success me-0.5"></i>Validated Date</span>
                                <span class="pill-val text-success font-monospace" id="pillValidatedVal">@latestValidated.Value.ToString("dd MMM yyyy, hh:mm tt")</span>
                            </div>
                        }
                        @if (latestApproved.HasValue)
                        {
                            <div class="info-pill" id="pillApproved">
                                <span class="pill-label text-info"><i class="bi bi-patch-check-fill text-info me-0.5"></i>Approved Date</span>
                                <span class="pill-val text-info font-monospace" id="pillApprovedVal">@latestApproved.Value.ToString("dd MMM yyyy, hh:mm tt")</span>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Report progress & colour code (live: driven by investigation cards) -->
    <div class="workflow-strip mb-3" id="workflowStrip">
        <div class="workflow-head">
            <span class="workflow-title"><i class="bi bi-diagram-3-fill me-1"></i>Report Progress</span>
            <span class="workflow-percent" id="wfPercent">&mdash;</span>
        </div>
        <div class="workflow-bar" id="wfBar" role="progressbar" aria-label="Report progress" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
            <span class="wf-seg wf-c-approved"  data-wf="approved"></span>
            <span class="wf-seg wf-c-validated" data-wf="validated"></span>
            <span class="wf-seg wf-c-submitted" data-wf="submitted"></span>
            <span class="wf-seg wf-c-draft"     data-wf="draft"></span>
            <span class="wf-seg wf-c-pending"   data-wf="pending"></span>
        </div>
        <div class="workflow-legend">
            <span class="wf-chip wf-c-pending"   data-wf="pending"   title="No report entered yet"><i class="wf-dot"></i>Pending <b id="wfCount_pending">0</b></span>
            <span class="wf-chip wf-c-draft"     data-wf="draft"     title="Draft or entered report"><i class="wf-dot"></i>Draft / Unsubmitted <b id="wfCount_draft">0</b></span>
            <span class="wf-chip wf-c-submitted" data-wf="submitted" title="Submitted, awaiting validation"><i class="wf-dot"></i>Submitted <b id="wfCount_submitted">0</b></span>
            <span class="wf-chip wf-c-validated" data-wf="validated" title="Validated, awaiting approval"><i class="wf-dot"></i>Validated <b id="wfCount_validated">0</b></span>
            <span class="wf-chip wf-c-approved"  data-wf="approved"  title="Approved and locked"><i class="wf-dot"></i>Approved <b id="wfCount_approved">0</b></span>
        </div>
    </div>

    <!-- Workspace Header & Quick Actions -->
    <div class="d-flex justify-content-between align-items-center mb-2 flex-wrap gap-2">
        <div class="d-flex align-items-center gap-2 flex-wrap">
            <h5 class="mb-0 fw-bold text-dark d-flex align-items-center fs-7">
                <i class="bi bi-file-earmark-image text-primary me-2"></i>Eligible Image Investigations
            </h5>
            <span class="badge bg-primary-subtle text-primary border border-primary-subtle fs-8">
                @d.Items.Count Collected Image Tests
            </span>
        </div>
        <div class="d-flex align-items-center gap-2" id="headerActionButtons">
            <button type="button" class="btn btn-primary px-3.5 py-1.5 fs-8 fw-semibold shadow-xs btn-action-save" id="btnHeaderSave" style="@(showSubmit ? "" : "display:none;")">
                <i class="bi bi-send-check me-1"></i>Submit
            </button>
            <button type="button" class="btn btn-success px-3.5 py-1.5 fs-8 fw-semibold shadow-xs btn-action-validate" id="btnHeaderValidate" style="@(showValidate ? "" : "display:none;")">
                <i class="bi bi-check-circle-fill me-1"></i>Validate Report
            </button>
            <button type="button" class="btn btn-info text-white px-3.5 py-1.5 fs-8 fw-semibold shadow-xs btn-action-approve" id="btnHeaderApprove" style="@(showApprove ? "" : "display:none;")">
                <i class="bi bi-patch-check-fill me-1"></i>Approve Report
            </button>
            <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle px-3 py-1.5 fs-8 badge-pathologist-header @(pathologistApprovalRequired && !isAllApproved && validatedCount > 0 ? "" : "d-none")"
                  title="Hospital Settings > LAB > Pathologist approval required is switched on for this branch">
                <i class="bi bi-shield-lock-fill me-1"></i>Approval by pathologist
            </span>
            <span class="badge bg-info-subtle text-info border border-info-subtle px-3 py-1.5 fs-8 @(showApprovedBadge ? "" : "d-none")" id="badgeHeaderApproved">
                <i class="bi bi-patch-check-fill me-1"></i>@(isPartialApproved ? $"Partially Approved ({approvedCount}/{totalCount})" : "Report Approved")
            </span>
        </div>
    </div>

        <!-- Investigations Cards Container -->
        <div class="row g-3" id="investigationsContainer">
            @for (int i = 0; i < d.Items.Count; i++)
            {
                var item = d.Items[i];
                bool hasEntry = !string.IsNullOrWhiteSpace(item.TemplateHtml) || !string.IsNullOrWhiteSpace(item.TestValue);

                <div class="col-12 investigation-item-row" id="investigationRow_@item.SamplecollectionID"
                     data-samplecollection-id="@item.SamplecollectionID"
                     data-investigation-id="@item.InvestigationID"
                     data-test-name="@item.TestName"
                     data-report-status-id="@item.ReportStatusId"
                     data-has-entry="@(hasEntry ? "true" : "false")">
                    <div class="card investigation-card shadow-sm @(hasEntry ? "has-entry" : "pending-entry")">
                        <div class="card-body p-3">
                            <div class="row g-2 align-items-center">
                                <!-- Test Title and Badges -->
                                <div class="col-12 col-lg-5">
                                    <div class="d-flex align-items-center gap-2 flex-wrap">
                                        <h6 class="fw-bold mb-0 text-dark">
                                            @item.TestName
                                        </h6>
                                        <span class="badge bg-light text-muted border font-monospace fs-9">@item.TestCode</span>
                                        <span class="badge badge-modality fs-9">Image Report</span>
                                    </div>
                                    <div class="text-muted fs-8 d-flex align-items-center gap-2 mt-1 flex-wrap">
                                        @if (!string.IsNullOrEmpty(item.DepartmentName))
                                        {
                                            <span><i class="bi bi-hospital me-1"></i>@item.DepartmentName</span>
                                        }
                                        @if (!string.IsNullOrEmpty(item.BarcodeNo))
                                        {
                                            <span><i class="bi bi-upc me-1"></i>Barcode: <strong class="font-monospace">@item.BarcodeNo</strong></span>
                                        }
                                        <span><i class="bi bi-check-circle me-0.5 text-success"></i>Collected</span>
                                    </div>
                                </div>

                                <!-- Status Badge and Last Modified -->
                                <div class="col-6 col-lg-3 text-lg-center">
                                    <span class="badge @item.ReportBadgeClass fs-8 status-badge">
                                        @item.ReportStatusName
                                    </span>
                                    <div class="fs-9 text-muted mt-1 last-saved-time">
                                        @if (item.LastSavedDate.HasValue)
                                        {
                                            <span><i class="bi bi-clock me-0.5"></i>Saved @item.LastSavedDate.Value.ToString("dd-MMM HH:mm")</span>
                                        }
                                        else
                                        {
                                            <span>Not entered yet</span>
                                        }
                                    </div>
                                </div>

                                <!-- Action Buttons on Card -->
                                <div class="col-6 col-lg-4 text-end">
                                    <div class="d-flex align-items-center justify-content-end gap-2 card-action-buttons">
                                        <button type="button"
                                                class="btn btn-sm @(item.ReportStatusId == 5 ? "btn-outline-dark" : (hasEntry ? "btn-outline-primary" : "btn-primary")) px-3 d-inline-flex align-items-center gap-1.5 btn-start-entry"
                                                data-test-id="@item.InvestigationID"
                                                data-sample-id="@item.SamplecollectionID"
                                                data-test-name="@item.TestName"
                                                data-has-entry="@(hasEntry ? "true" : "false")">
                                            <i class="bi @(item.ReportStatusId == 5 ? "bi-eye" : "bi-pencil-square")"></i>
                                            <span class="btn-text">@(item.ReportStatusId == 5 ? "View Report" : (hasEntry ? "Edit Report" : "Start Entry"))</span>
                                        </button>

                                        @if (item.ReportStatusId == 2)
                                        {
                                            <button type="button"
                                                    class="btn btn-sm btn-outline-success px-2.5 d-inline-flex align-items-center gap-1 btn-card-validate"
                                                    data-sample-id="@item.SamplecollectionID"
                                                    data-test-id="@item.InvestigationID"
                                                    data-test-name="@item.TestName"
                                                    title="Validate this report">
                                                <i class="bi bi-check-circle-fill"></i>Validate
                                            </button>
                                        }
                                        else if (item.ReportStatusId == 3 && !pathologistApprovalRequired)
                                        {
                                            <button type="button"
                                                    class="btn btn-sm btn-outline-info text-info px-2.5 d-inline-flex align-items-center gap-1 btn-card-approve"
                                                    data-sample-id="@item.SamplecollectionID"
                                                    data-test-id="@item.InvestigationID"
                                                    data-test-name="@item.TestName"
                                                    title="Approve this report">
                                                <i class="bi bi-patch-check-fill"></i>Approve
                                            </button>
                                        }

                                        <button type="button"
                                                class="btn btn-sm btn-outline-secondary px-2.5 d-inline-flex align-items-center gap-1 btn-preview-report"
                                                data-sample-id="@item.SamplecollectionID"
                                                data-test-id="@item.InvestigationID"
                                                title="Preview report HTML">
                                            <i class="bi bi-eye"></i>Preview
                                        </button>

                                        <a asp-action="Print" asp-route-labOrderId="@d.LabOrderId" asp-route-sampleCollectionId="@item.SamplecollectionID"
                                           target="_blank"
                                           class="btn btn-sm btn-outline-dark px-2.5 d-inline-flex align-items-center gap-1"
                                           title="Print this report">
                                            <i class="bi bi-printer"></i>Print
                                        </a>
                                    </div>
                                </div>
                            </div>

                            @if (!string.IsNullOrWhiteSpace(item.TemplateHtml))
                            {
                                <div class="report-preview-box mt-3 p-3 bg-light rounded border fs-8 text-secondary d-none" id="previewBox_@item.SamplecollectionID">
                                    <div class="d-flex justify-content-between align-items-center mb-2 pb-1 border-bottom">
                                        <span class="fw-bold text-dark"><i class="bi bi-file-text me-1"></i>Saved Report Content Preview</span>
                                        <button type="button" class="btn-close btn-sm btn-close-preview" data-sample-id="@item.SamplecollectionID" aria-label="Close"></button>
                                    </div>
                                    <div class="preview-content">
                                        @Html.Raw(item.TemplateHtml)
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>


