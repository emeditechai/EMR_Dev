@section Scripts {
    <script src="~/lib/quill/quill.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
    <script>
        $(document).ready(function () {
            toastr.options = {
                closeButton: true,
                progressBar: true,
                positionClass: "toast-top-right",
                timeOut: "3000"
            };

            const labOrderId = @d.LabOrderId;
            const PATHOLOGIST_APPROVAL_REQUIRED = @(pathologistApprovalRequired.ToString().ToLower());

            let currentTestId = 0;
            let currentSampleCollectionId = 0;
            let currentTestName = '';
            let currentItemStatusId = 0;
            let currentPlaceholders = {};

            // Initialize Quill
            const quill = new Quill('#imageReportEditor', {
                theme: 'snow',
                modules: {
                    toolbar: [
                        [{ 'header': [1, 2, 3, false] }],
                        ['bold', 'italic', 'underline', 'strike'],
                        [{ 'color': [] }, { 'background': [] }],
                        [{ 'list': 'ordered' }, { 'list': 'bullet' }],
                        [{ 'align': [] }],
                        ['blockquote', 'code-block'],
                        ['clean']
                    ]
                },
                placeholder: 'Enter detailed findings, impression, and conclusion here...'
            });

            // ── Update Action Buttons Visibility Across Page (Header & Sticky Bar) ──
            function updateActionButtonsVisibility() {
                let totalActiveCount = 0;
                let unenteredCount = 0;
                let unsubmittedCount = 0;
                let submittedCount = 0;
                let validatedCount = 0;
                let approvedCount = 0;

                let draftCount = 0;
                let pendingCount = 0;

                $('.investigation-item-row').each(function () {
                    totalActiveCount++;
                    const repStatus = parseInt($(this).attr('data-report-status-id')) || 0;
                    const hasEntry = $(this).attr('data-has-entry') === 'true';
                    const $card = $(this).find('.investigation-card');

                    $card.removeClass('st-pending st-draft st-submitted st-validated st-approved has-entry pending-entry');

                    if (repStatus === 5) {
                        approvedCount++;
                        $card.addClass('st-approved');
                    } else if (repStatus === 3) {
                        validatedCount++;
                        $card.addClass('st-validated');
                    } else if (repStatus === 2) {
                        submittedCount++;
                        $card.addClass('st-submitted');
                    } else if (hasEntry) {
                        draftCount++;
                        unenteredCount++;
                        $card.addClass('st-draft');
                    } else {
                        pendingCount++;
                        unenteredCount++;
                        $card.addClass('st-pending');
                    }
                });

                const isAllApproved = (totalActiveCount > 0 && approvedCount === totalActiveCount);
                const isPartialApproved = (approvedCount > 0 && approvedCount < totalActiveCount);

                const filledCount = draftCount + submittedCount + validatedCount + approvedCount;
                $('#counterEntered').text(`${filledCount} / ${totalActiveCount} Reports Entered`);

                // ── Workflow Strip Update ──
                const wfCounts = {
                    approved: approvedCount,
                    validated: validatedCount,
                    submitted: submittedCount,
                    draft: draftCount,
                    pending: pendingCount
                };
                ['approved', 'validated', 'submitted', 'draft', 'pending'].forEach(function (k) {
                    $('#wfCount_' + k).text(wfCounts[k]);
                    $('.wf-chip[data-wf="' + k + '"]').toggleClass('is-zero', wfCounts[k] === 0);
                    $('.wf-seg[data-wf="' + k + '"]').css('width', totalActiveCount ? (wfCounts[k] / totalActiveCount * 100) + '%' : '0%');
                });
                const pct = totalActiveCount ? Math.round(approvedCount / totalActiveCount * 100) : 0;
                $('#wfPercent').text(totalActiveCount ? (approvedCount + ' of ' + totalActiveCount + ' tests approved (' + pct + '%)') : '');
                $('#wfBar').attr('aria-valuenow', pct);

                // 1. Submit Button (Visible if not all approved and any test is unentered or pending submission)
                const needsSubmit = !isAllApproved && (unenteredCount > 0 || unsubmittedCount > 0);
                if (needsSubmit) {
                    $('.btn-action-save').show();
                } else {
                    $('.btn-action-save').hide();
                }

                // 2. Validate Button (Visible if not all approved and there are submitted tests awaiting validation)
                const canValidate = !isAllApproved && (submittedCount > 0);
                if (canValidate) {
                    $('.btn-action-validate').show();
                } else {
                    $('.btn-action-validate').hide();
                }

                // 3. Approve Button (Visible if not all approved, validated tests exist, and pathologist approval not required)
                const canApprove = !isAllApproved && (validatedCount > 0) && !PATHOLOGIST_APPROVAL_REQUIRED;
                if (canApprove) {
                    $('.btn-action-approve').show();
                } else {
                    $('.btn-action-approve').hide();
                }

                // 4. Pathologist Warning Badge
                if (PATHOLOGIST_APPROVAL_REQUIRED && !isAllApproved && validatedCount > 0) {
                    $('.badge-pathologist-header, .badge-pathologist-footer').removeClass('d-none');
                } else {
                    $('.badge-pathologist-header, .badge-pathologist-footer').addClass('d-none');
                }

                // 5. Approved Badges
                if (isAllApproved) {
                    $('#badgeHeaderApproved, #badgeApprovedFooter')
                        .removeClass('d-none')
                        .html('<i class="bi bi-patch-check-fill me-1"></i>Report Approved');
                    $('.btn-action-save, .btn-action-validate, .btn-action-approve').hide();
                    $('#badgeOrderStatus').attr('class', 'badge bg-info-subtle text-info border border-info-subtle fs-9 fw-semibold').text('Report Approved');
                } else if (isPartialApproved) {
                    $('#badgeHeaderApproved')
                        .removeClass('d-none')
                        .html(`<i class="bi bi-patch-check-fill me-1"></i>Partially Approved (${approvedCount}/${totalActiveCount})`);
                    $('#badgeApprovedFooter').addClass('d-none');
                    $('#badgeOrderStatus').attr('class', 'badge bg-warning-subtle text-warning-emphasis border border-warning-subtle fs-9 fw-semibold').text(`Partially Approved (${approvedCount}/${totalActiveCount})`);
                } else {
                    $('#badgeHeaderApproved, #badgeApprovedFooter').addClass('d-none');
                }

                // Print button in sticky bar
                if (validatedCount + approvedCount > 0) {
                    $('#btnStickyPrint').removeClass('d-none');
                }
            }

            // ── Update Modal Action Buttons Visibility ───────────────────────
            function updateModalActionButtonsVisibility(statusId) {
                statusId = parseInt(statusId) || 0;
                currentItemStatusId = statusId;

                // Reset modal buttons & badges
                $('#editorCurrentStatusBadge').removeClass().addClass('badge fs-8');
                $('.btn-modal-submit, .btn-modal-validate, .btn-modal-approve').hide();
                $('.badge-modal-pathologist, .badge-modal-approved').addClass('d-none');

                if (statusId < 2) {
                    // Pending Entry
                    $('#editorCurrentStatusBadge').addClass('bg-secondary-subtle text-secondary border').text('Pending Entry');
                    $('.btn-modal-submit').html('<i class="bi bi-send-check me-1"></i>Submit Report').show();
                    quill.enable(true);
                    $('#btnResetToDefaultTemplate').removeClass('d-none');
                    $('.quick-tags-panel').removeClass('d-none');
                    $('#alertApprovedNotice').addClass('d-none');
                } else if (statusId === 2) {
                    // Report Entered (Submitted)
                    $('#editorCurrentStatusBadge').addClass('bg-primary-subtle text-primary border border-primary-subtle').text('Report Entered');
                    $('.btn-modal-submit').html('<i class="bi bi-send-check me-1"></i>Submit Changes').show();
                    $('.btn-modal-validate').show();
                    quill.enable(true);
                    $('#btnResetToDefaultTemplate').removeClass('d-none');
                    $('.quick-tags-panel').removeClass('d-none');
                    $('#alertApprovedNotice').addClass('d-none');
                } else if (statusId === 3) {
                    // Report Validated
                    $('#editorCurrentStatusBadge').addClass('bg-success-subtle text-success border border-success-subtle').text('Report Validated');
                    $('.btn-modal-submit').html('<i class="bi bi-send-check me-1"></i>Submit Changes').show();
                    if (!PATHOLOGIST_APPROVAL_REQUIRED) {
                        $('.btn-modal-approve').show();
                    } else {
                        $('.badge-modal-pathologist').removeClass('d-none');
                    }
                    quill.enable(true);
                    $('#btnResetToDefaultTemplate').removeClass('d-none');
                    $('.quick-tags-panel').removeClass('d-none');
                    $('#alertApprovedNotice').addClass('d-none');
                } else if (statusId === 5) {
                    // Report Approved
                    $('#editorCurrentStatusBadge').addClass('bg-info-subtle text-info border border-info-subtle').text('Report Approved');
                    $('.badge-modal-approved').removeClass('d-none');
                    quill.enable(false);
                    $('#btnResetToDefaultTemplate').addClass('d-none');
                    $('.quick-tags-panel').addClass('d-none');
                    $('#alertApprovedNotice').removeClass('d-none');
                }
            }

            // ── Open Editor Modal ────────────────────────────────────────────
            $(document).on('click', '.btn-start-entry', function () {
                currentTestId = $(this).data('test-id');
                currentSampleCollectionId = $(this).data('sample-id');
                currentTestName = $(this).data('test-name');

                $('#editorTestName').text(currentTestName);
                loadTemplateForEditor(false);
            });

            // Toggle Preview
            $(document).on('click', '.btn-preview-report', function () {
                const sampleId = $(this).data('sample-id');
                const $box = $('#previewBox_' + sampleId);
                if ($box.length) {
                    $box.toggleClass('d-none');
                } else {
                    $.get('@Url.Action("GetTemplateJson", "LabImageReporting")', {
                        testId: $(this).data('test-id'),
                        labOrderId: labOrderId,
                        sampleCollectionId: sampleId
                    }).done(function (res) {
                        if (res.success && res.html) {
                            let $container = $('#investigationRow_' + sampleId + ' .card-body');
                            let prevHtml = `
                                <div class="report-preview-box mt-3 p-3 bg-light rounded border fs-8 text-secondary" id="previewBox_${sampleId}">
                                    <div class="d-flex justify-content-between align-items-center mb-2 pb-1 border-bottom">
                                        <span class="fw-bold text-dark"><i class="bi bi-file-text me-1"></i>Report Content Preview</span>
                                        <button type="button" class="btn-close btn-sm btn-close-preview" data-sample-id="${sampleId}" aria-label="Close"></button>
                                    </div>
                                    <div class="preview-content">${res.html}</div>
                                </div>
                            `;
                            $container.append(prevHtml);
                        } else {
                            toastr.info('No report content entered yet.');
                        }
                    });
                }
            });

            $(document).on('click', '.btn-close-preview', function () {
                const sampleId = $(this).data('sample-id');
                $('#previewBox_' + sampleId).addClass('d-none');
            });

            // Load template via AJAX into Quill editor
            function loadTemplateForEditor(forceDefault) {
                quill.root.innerHTML = '<p class="text-muted">Loading report template...</p>';
                $('#modalReportEditor').modal('show');

                $.get('@Url.Action("GetTemplateJson", "LabImageReporting")', {
                    testId: currentTestId,
                    labOrderId: labOrderId,
                    sampleCollectionId: currentSampleCollectionId,
                    forceDefault: forceDefault
                }).done(function (res) {
                    if (res.success) {
                        quill.root.innerHTML = res.html || '';
                        if (res.modality) {
                            $('#editorModalityBadge').text(res.modality).show();
                        } else {
                            $('#editorModalityBadge').hide();
                        }
                        currentPlaceholders = res.placeholders || {};
                        updateModalActionButtonsVisibility(res.statusId);
                    } else {
                        toastr.error(res.message || 'Failed to load template.');
                        quill.root.innerHTML = '<p>Error loading template.</p>';
                    }
                }).fail(function () {
                    toastr.error('Server error loading template.');
                });
            }

            // Reset / Reload Original Template button
            $('#btnResetToDefaultTemplate').on('click', function () {
                Swal.fire({
                    title: 'Reload Original Template?',
                    text: 'Reloading the original template will overwrite any manual edits made in this session. Do you want to proceed?',
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#dc3545',
                    cancelButtonColor: '#6c757d',
                    confirmButtonText: 'Yes, Reload Template'
                }).then((result) => {
                    if (result.isConfirmed) {
                        loadTemplateForEditor(true);
                    }
                });
            });

            // Quick Insert Badges
            $('.quick-tag-badge').on('click', function () {
                const tag = $(this).data('tag');
                const val = (currentPlaceholders && currentPlaceholders[tag]) ? currentPlaceholders[tag] : tag;
                const range = quill.getSelection(true);
                if (range) {
                    quill.insertText(range.index, val, 'user');
                    quill.setSelection(range.index + val.length);
                }
            });

            // ── Core Save / Submit / Validate / Approve Function ───────────────
            function saveImageReporting(statusId, statusLabel, entries, onSuccess) {
                if (!entries || entries.length === 0) {
                    toastr.warning('No report entries found to process.');
                    return;
                }

                const payload = {
                    labOrderId: labOrderId,
                    reportStatusId: statusId,
                    entries: entries
                };

                const $btns = $('.btn-action-save, .btn-action-validate, .btn-action-approve, .btn-modal-submit, .btn-modal-validate, .btn-modal-approve');
                $btns.prop('disabled', true);

                $.ajax({
                    url: '@Url.Action("SaveReportJson", "LabImageReporting")',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(payload)
                }).done(function (res) {
                    $btns.prop('disabled', false);
                    if (res.success) {
                        toastr.success(res.message || `Report entries successfully saved as ${statusLabel}!`);

                        // Update each affected card in the DOM
                        entries.forEach(function (e) {
                            const sampleId = e.samplecollectionID;
                            const $row = $('#investigationRow_' + sampleId);
                            if ($row.length) {
                                $row.attr('data-report-status-id', statusId);
                                $row.attr('data-has-entry', 'true');

                                const $card = $row.find('.investigation-card');
                                $card.removeClass('pending-entry').addClass('has-entry');

                                let statusName = 'Report Entered';
                                let badgeCls = 'bg-primary-subtle text-primary border border-primary-subtle';
                                if (statusId === 3) {
                                    statusName = 'Report Validated';
                                    badgeCls = 'bg-success-subtle text-success border border-success-subtle';
                                } else if (statusId === 5) {
                                    statusName = 'Report Approve';
                                    badgeCls = 'bg-info-subtle text-info border border-info-subtle';
                                }

                                $row.find('.status-badge').removeClass().addClass('badge ' + badgeCls + ' fs-8 status-badge').text(statusName);
                                $row.find('.last-saved-time').html('<span><i class="bi bi-clock me-0.5"></i>Saved just now</span>');

                                // Re-render card action buttons
                                const $actContainer = $row.find('.card-action-buttons');
                                const testId = $row.data('investigation-id');
                                const testName = $row.data('test-name');

                                let btnsHtml = `
                                    <button type="button"
                                            class="btn btn-sm ${statusId === 5 ? 'btn-outline-dark' : 'btn-outline-primary'} px-3 d-inline-flex align-items-center gap-1.5 btn-start-entry"
                                            data-test-id="${testId}"
                                            data-sample-id="${sampleId}"
                                            data-test-name="${testName}"
                                            data-has-entry="true">
                                        <i class="bi ${statusId === 5 ? 'bi-eye' : 'bi-pencil-square'}"></i>
                                        <span class="btn-text">${statusId === 5 ? 'View Report' : 'Edit Report'}</span>
                                    </button>
                                `;

                                if (statusId === 2) {
                                    btnsHtml += `
                                        <button type="button"
                                                class="btn btn-sm btn-outline-success px-2.5 d-inline-flex align-items-center gap-1 btn-card-validate"
                                                data-sample-id="${sampleId}"
                                                data-test-id="${testId}"
                                                data-test-name="${testName}"
                                                title="Validate this report">
                                            <i class="bi bi-check-circle-fill"></i>Validate
                                        </button>
                                    `;
                                } else if (statusId === 3 && !PATHOLOGIST_APPROVAL_REQUIRED) {
                                    btnsHtml += `
                                        <button type="button"
                                                class="btn btn-sm btn-outline-info text-info px-2.5 d-inline-flex align-items-center gap-1 btn-card-approve"
                                                data-sample-id="${sampleId}"
                                                data-test-id="${testId}"
                                                data-test-name="${testName}"
                                                title="Approve this report">
                                            <i class="bi bi-patch-check-fill"></i>Approve
                                        </button>
                                    `;
                                }

                                btnsHtml += `
                                    <button type="button"
                                            class="btn btn-sm btn-outline-secondary px-2.5 d-inline-flex align-items-center gap-1 btn-preview-report"
                                            data-sample-id="${sampleId}"
                                            data-test-id="${testId}"
                                            title="Preview report HTML">
                                        <i class="bi bi-eye"></i>Preview
                                    </button>
                                    <a href="/LabImageReporting/Print?labOrderId=${labOrderId}&sampleCollectionId=${sampleId}"
                                       target="_blank"
                                       class="btn btn-sm btn-outline-dark px-2.5 d-inline-flex align-items-center gap-1"
                                       title="Print this report">
                                        <i class="bi bi-printer"></i>Print
                                    </a>
                                `;
                                $actContainer.html(btnsHtml);

                                // Update inline preview if open
                                if (e.templateHtml) {
                                    const $box = $('#previewBox_' + sampleId);
                                    if ($box.length) {
                                        $box.find('.preview-content').html(e.templateHtml);
                                    }
                                }
                            }
                        });

                        updateActionButtonsVisibility();

                        if (typeof onSuccess === 'function') {
                            onSuccess();
                        }
                    } else {
                        toastr.error(res.message || 'Failed to save report.');
                    }
                }).fail(function () {
                    $btns.prop('disabled', false);
                    toastr.error('Server error saving report.');
                });
            }

            // ── Modal Action Buttons ──────────────────────────────────────────

            // 1. Modal: Submit / Report Entry (Status 2)
            $('.btn-modal-submit').on('click', function () {
                const htmlContent = quill.root.innerHTML;
                if (!htmlContent || htmlContent.trim() === '' || htmlContent === '<p><br></p>') {
                    toastr.warning('Please enter report findings before submitting.');
                    return;
                }

                const entries = [{
                    samplecollectionID: currentSampleCollectionId,
                    investigationID: currentTestId,
                    reportingType: 'Image',
                    templateHtml: htmlContent,
                    testValue: 'Report Entered'
                }];

                saveImageReporting(2, 'Report Entry', entries, function () {
                    $('#modalReportEditor').modal('hide');
                });
            });

            // 2. Modal: Validate Report (Status 3) - with SweetAlert2 confirmation
            $('.btn-modal-validate').on('click', function () {
                const htmlContent = quill.root.innerHTML;
                if (!htmlContent || htmlContent.trim() === '' || htmlContent === '<p><br></p>') {
                    toastr.warning('Please enter report findings before validating.');
                    return;
                }

                Swal.fire({
                    title: 'Validate Report?',
                    text: 'Are you sure you want to validate this report? Once validated, it will advance to final approval.',
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonColor: '#198754',
                    cancelButtonColor: '#6c757d',
                    confirmButtonText: '<i class="bi bi-check-circle-fill me-1"></i>Yes, Validate Report'
                }).then((result) => {
                    if (result.isConfirmed) {
                        const entries = [{
                            samplecollectionID: currentSampleCollectionId,
                            investigationID: currentTestId,
                            reportingType: 'Image',
                            templateHtml: htmlContent,
                            testValue: 'Report Entered'
                        }];

                        saveImageReporting(3, 'Report Validated', entries, function () {
                            $('#modalReportEditor').modal('hide');
                        });
                    }
                });
            });

            // 3. Modal: Approve Report (Status 5) - with SweetAlert2 confirmation
            $('.btn-modal-approve').on('click', function () {
                const htmlContent = quill.root.innerHTML;
                if (!htmlContent || htmlContent.trim() === '' || htmlContent === '<p><br></p>') {
                    toastr.warning('Please enter report findings before approving.');
                    return;
                }

                Swal.fire({
                    title: 'Approve Report?',
                    text: 'Are you sure you want to approve this image report? This will finalize the report.',
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonColor: '#0dcaf0',
                    cancelButtonColor: '#6c757d',
                    confirmButtonText: '<i class="bi bi-patch-check-fill me-1"></i>Yes, Approve Report'
                }).then((result) => {
                    if (result.isConfirmed) {
                        const entries = [{
                            samplecollectionID: currentSampleCollectionId,
                            investigationID: currentTestId,
                            reportingType: 'Image',
                            templateHtml: htmlContent,
                            testValue: 'Report Entered'
                        }];

                        saveImageReporting(5, 'Report Approve', entries, function () {
                            $('#modalReportEditor').modal('hide');
                        });
                    }
                });
            });

            // ── Card Level Quick Action Buttons ──────────────────────────────
            $(document).on('click', '.btn-card-validate', function () {
                const sampleId = $(this).data('sample-id');
                const testId = $(this).data('test-id');
                const testName = $(this).data('test-name') || 'this report';

                Swal.fire({
                    title: `Validate ${testName}?`,
                    text: 'Are you sure you want to validate this report? Once validated, it will advance to final approval.',
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonColor: '#198754',
                    cancelButtonColor: '#6c757d',
                    confirmButtonText: '<i class="bi bi-check-circle-fill me-1"></i>Yes, Validate'
                }).then((result) => {
                    if (result.isConfirmed) {
                        saveImageReporting(3, 'Report Validated', [{
                            samplecollectionID: sampleId,
                            investigationID: testId,
                            reportingType: 'Image',
                            testValue: 'Report Entered'
                        }]);
                    }
                });
            });

            $(document).on('click', '.btn-card-approve', function () {
                const sampleId = $(this).data('sample-id');
                const testId = $(this).data('test-id');
                const testName = $(this).data('test-name') || 'this report';

                Swal.fire({
                    title: `Approve ${testName}?`,
                    text: 'Are you sure you want to approve this image report? This will finalize the report.',
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonColor: '#0dcaf0',
                    cancelButtonColor: '#6c757d',
                    confirmButtonText: '<i class="bi bi-patch-check-fill me-1"></i>Yes, Approve'
                }).then((result) => {
                    if (result.isConfirmed) {
                        saveImageReporting(5, 'Report Approve', [{
                            samplecollectionID: sampleId,
                            investigationID: testId,
                            reportingType: 'Image',
                            testValue: 'Report Entered'
                        }]);
                    }
                });
            });

            // ── Page Level Action Buttons (Header & Sticky Bar) ───────────────

            // Page Submit: Prompt to enter first pending test
            $('.btn-action-save').on('click', function () {
                const $pendingBtn = $('.btn-start-entry[data-has-entry="false"]').first();
                if ($pendingBtn.length) {
                    $pendingBtn.trigger('click');
                    toastr.info('Opening editor for pending investigation.');
                } else {
                    const $firstEntry = $('.btn-start-entry').first();
                    if ($firstEntry.length) {
                        $firstEntry.trigger('click');
                    }
                }
            });

            // Page Validate: Validates all submitted tests awaiting validation
            $('.btn-action-validate').on('click', function () {
                const submittedRows = $('.investigation-item-row[data-report-status-id="2"]');
                const count = submittedRows.length;
                const totalActive = $('.investigation-item-row').length;

                if (count === 0) {
                    toastr.warning('No submitted test records found to validate. Please enter and submit test results first.');
                    return;
                }

                const isPartial = count < totalActive;
                const confirmTitle = isPartial ? 'Partially Validate Report?' : 'Validate Report?';
                const confirmText = isPartial
                    ? `Are you sure you want to validate ${count} submitted report(s)? Remaining reports can be entered and submitted later.`
                    : 'Are you sure you want to validate this report? Once validated, it will advance to final approval.';

                Swal.fire({
                    title: confirmTitle,
                    text: confirmText,
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonColor: '#198754',
                    cancelButtonColor: '#6c757d',
                    confirmButtonText: '<i class="bi bi-check-circle-fill me-1"></i>Yes, Validate ' + (isPartial ? `(${count} Reports)` : 'Report')
                }).then((result) => {
                    if (result.isConfirmed) {
                        const entries = [];
                        submittedRows.each(function () {
                            entries.push({
                                samplecollectionID: $(this).data('samplecollection-id'),
                                investigationID: $(this).data('investigation-id'),
                                reportingType: 'Image',
                                testValue: 'Report Entered'
                            });
                        });
                        saveImageReporting(3, 'Report Validated', entries);
                    }
                });
            });

            // Page Approve: Approves all validated tests awaiting approval
            $('.btn-action-approve').on('click', function () {
                const validatedRows = $('.investigation-item-row[data-report-status-id="3"]');
                const count = validatedRows.length;
                const totalActive = $('.investigation-item-row').length;

                if (count === 0) {
                    toastr.warning('No validated test records found to approve. Please validate test results first.');
                    return;
                }

                const isPartial = count < totalActive;
                const confirmTitle = isPartial ? 'Partially Approve Report?' : 'Approve Report?';
                const confirmText = isPartial
                    ? `Are you sure you want to approve ${count} validated report(s)? This will finalize these ${count} report(s).`
                    : 'Are you sure you want to approve this lab report? This will finalize the report.';

                Swal.fire({
                    title: confirmTitle,
                    text: confirmText,
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonColor: '#0dcaf0',
                    cancelButtonColor: '#6c757d',
                    confirmButtonText: '<i class="bi bi-patch-check-fill me-1"></i>Yes, Approve ' + (isPartial ? `(${count} Reports)` : 'Report')
                }).then((result) => {
                    if (result.isConfirmed) {
                        const entries = [];
                        validatedRows.each(function () {
                            entries.push({
                                samplecollectionID: $(this).data('samplecollection-id'),
                                investigationID: $(this).data('investigation-id'),
                                reportingType: 'Image',
                                testValue: 'Report Entered'
                            });
                        });
                        saveImageReporting(5, 'Report Approve', entries);
                    }
                });
            });

            // Initial calculation of visibility
            updateActionButtonsVisibility();

            // Initialize tooltips
            const tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
            tooltipTriggerList.map(function (tooltipTriggerEl) {
                return new bootstrap.Tooltip(tooltipTriggerEl);
            });
        });
    </script>
    <partial name="_LabAuditHistoryScripts" />
}

