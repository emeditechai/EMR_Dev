@model EMR.Web.Models.ViewModels.LabReportingDashboardViewModel
@{
    ViewData["Title"] = "Image Report Entry";
}

@section HeadStyles {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" />
    <style>
        .reporting-wrapper {
            --lr-bg: #f1f5f9;
            --lr-line: #e2e8f0;
            --lr-ink: #0f172a;
            --lr-muted: #64748b;
            background: var(--lr-bg);
            min-height: calc(100vh - 60px);
        }
        .reporting-wrapper .fs-7 { font-size: 0.85rem !important; }
        .reporting-wrapper .fs-8 { font-size: 0.78rem !important; }
        .reporting-wrapper .fs-9 { font-size: 0.70rem !important; }
        .py-0\.5 { padding-top: 0.2rem !important; padding-bottom: 0.2rem !important; }
        .pt-1\.5 { padding-top: 0.45rem !important; }
        .mt-1\.5 { margin-top: 0.45rem !important; }
        .mb-1\.5 { margin-bottom: 0.45rem !important; }
        .mb-0\.5 { margin-bottom: 0.15rem !important; }

        /* ── page header ── */
        .lr-head { background: #fff; border: 1px solid var(--lr-line); border-radius: .75rem; }
        .lr-head-icon {
            width: 38px; height: 38px; border-radius: .6rem; display: flex; align-items: center; justify-content: center;
            background: linear-gradient(135deg, #e0e7ff, #c7d2fe); color: #4338ca; font-size: 1.05rem;
        }
        .lr-head h5 { letter-spacing: -.01em; }

        /* ── KPI cards ── */
        .stat-card {
            --c: #4f46e5; --bg: #eef2ff;
            position: relative; overflow: hidden; cursor: pointer; background: #fff;
            border: 1px solid var(--lr-line) !important; border-radius: .7rem;
            transition: transform .15s ease, box-shadow .15s ease, border-color .15s ease;
        }
        .stat-card::before { content: ""; position: absolute; left: 0; top: 0; bottom: 0; width: 3px; background: var(--c); }
        .stat-card::after {
            content: ""; position: absolute; right: -22px; top: -22px; width: 72px; height: 72px;
            border-radius: 50%; background: var(--bg); opacity: .5;
        }
        .stat-card:hover { transform: translateY(-2px); box-shadow: 0 .45rem .9rem rgba(15,23,42,.10) !important; border-color: var(--c) !important; }
        .stat-card.active-card { border-color: var(--c) !important; box-shadow: 0 0 0 2px color-mix(in srgb, var(--c) 22%, transparent) !important; background: linear-gradient(135deg, #fff 55%, var(--bg)); outline: none; }
        .stat-card .stat-label { font-size: .66rem; font-weight: 700; letter-spacing: .4px; text-transform: uppercase; color: var(--lr-muted); }
        .stat-card .stat-value { font-size: 1.45rem; font-weight: 800; line-height: 1.1; color: var(--c); letter-spacing: -.02em; }
        .stat-icon { width: 34px; height: 34px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: .95rem; background: var(--bg); color: var(--c); position: relative; z-index: 1; }
        .k-total { --c: #1d4ed8; --bg: #dbeafe; }
        .k-pending { --c: #64748b; --bg: #e2e8f0; }
        .k-draft { --c: #b45309; --bg: #fef3c7; }
        .k-entered { --c: #0369a1; --bg: #e0f2fe; }
        .k-validated { --c: #0f766e; --bg: #ccfbf1; }

        /* ── filter card ── */
        .lr-card { background: #fff; border: 1px solid var(--lr-line) !important; border-radius: .7rem; }
        .lr-label { font-size: .66rem; font-weight: 700; letter-spacing: .4px; text-transform: uppercase; color: var(--lr-muted); margin-bottom: .2rem; display: block; }
        .reporting-wrapper .form-control, .reporting-wrapper .form-select { border-color: #dbe2ea; font-size: .78rem; }
        .reporting-wrapper .form-control:focus, .reporting-wrapper .form-select:focus { border-color: #818cf8; box-shadow: 0 0 0 .18rem rgba(99,102,241,.14); }
        .lr-quick .btn { font-size: .7rem; font-weight: 600; color: var(--lr-muted); border-color: #dbe2ea; background: #fff; }
        .lr-quick .btn:hover { background: #eef2ff; color: #4338ca; border-color: #c7d2fe; }
        .lr-quick .btn.active { background: #4f46e5; border-color: #4f46e5; color: #fff; }
        .lr-filter-strip { background: #f8fafc; border-top: 1px dashed var(--lr-line); border-radius: 0 0 .7rem .7rem; }

        /* ── table ── */
        .table-responsive-custom { max-height: calc(100vh - 330px); min-height: 220px; overflow-y: auto; }
        .table-sticky-header thead th {
            position: sticky; top: 0; z-index: 10; background: #f8fafc; color: var(--lr-muted);
            font-size: .66rem; font-weight: 700; letter-spacing: .4px; text-transform: uppercase;
            border-bottom: 1px solid var(--lr-line); box-shadow: 0 1px 0 var(--lr-line); white-space: nowrap;
        }
        #tblReportingOrders tbody td { border-top: 1px solid #eef2f6; border-bottom: 0; padding-top: .6rem; padding-bottom: .6rem; vertical-align: middle; }

        /* ── row colour code by report status ── */
        .st-pending   { --st: #64748b; --st-bg: #f8fafc; --st-hover: #eef2f6; --st-bd: #cbd5e1; }
        .st-draft     { --st: #b45309; --st-bg: #fffbeb; --st-hover: #fef3c7; --st-bd: #fcd34d; }
        .st-entered   { --st: #1d4ed8; --st-bg: #eff6ff; --st-hover: #dbeafe; --st-bd: #93c5fd; }
        .st-validated { --st: #15803d; --st-bg: #f0fdf4; --st-hover: #dcfce7; --st-bd: #86efac; }
        .st-approved  { --st: #0f766e; --st-bg: #f0fdfa; --st-hover: #ccfbf1; --st-bd: #5eead4; }
        .st-recollect { --st: #c2410c; --st-bg: #fff7ed; --st-hover: #ffedd5; --st-bd: #fdba74; }
        .st-rejected  { --st: #b91c1c; --st-bg: #fef2f2; --st-hover: #fee2e2; --st-bd: #fca5a5; }

        #tblReportingOrders tbody tr { --bs-table-bg: var(--st-bg, #fff); transition: background .12s ease; }
        #tblReportingOrders tbody tr:hover > * { --bs-table-bg-state: var(--st-hover, #f8fafc); }
        #tblReportingOrders tbody tr > td:first-child { box-shadow: inset 3px 0 0 var(--st, transparent); }
        .st-badge { color: var(--st); background: var(--st-hover); border: 1px solid var(--st-bd); font-weight: 600; }

        /* ── legend ── */
        .lr-legend { display: flex; flex-wrap: wrap; align-items: center; gap: .35rem; }
        .lr-legend .lg-item {
            display: inline-flex; align-items: center; gap: .32rem; font-size: .68rem; font-weight: 600; color: var(--lr-muted);
            background: transparent; border: 1px solid transparent; border-radius: 999px; padding: .15rem .5rem;
            cursor: pointer; user-select: none; transition: background .12s ease, border-color .12s ease, color .12s ease;
        }
        .lr-legend .lg-item:hover { background: var(--st-bg); border-color: var(--st-bd); color: var(--st); }
        .lr-legend .lg-item:focus-visible { outline: 2px solid var(--st); outline-offset: 1px; }
        .lr-legend .lg-item.active { background: var(--st-hover); border-color: var(--st-bd); color: var(--st); }
        .lr-legend .lg-item.is-empty { opacity: .4; }
        .lr-legend .lg-dot { width: 9px; height: 9px; border-radius: 3px; background: var(--st); border: 1px solid var(--st-bd); flex: 0 0 9px; }
        .lr-legend .lg-count { font-weight: 700; opacity: .8; }
        .lr-legend .lg-clear { color: #64748b; border-color: #e2e8f0; }
        .lr-legend .lg-clear:hover { background: #f1f5f9; border-color: #cbd5e1; color: #334155; }
        .lr-avatar {
            width: 30px; height: 30px; border-radius: 50%; flex: 0 0 30px; display: flex; align-items: center; justify-content: center;
            font-size: .68rem; font-weight: 700; color: #4338ca; background: #eef2ff; border: 1px solid #e0e7ff;
        }
        .lr-avatar.female { color: #be185d; background: #fce7f3; border-color: #fbcfe8; }
        .lr-mono { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; }
        .lr-count-chip { background: #eef2ff; color: #4338ca; border: 1px solid #e0e7ff; border-radius: 999px; padding: .12rem .55rem; font-size: .68rem; font-weight: 700; }
        .btn-entry {
            background: #4f46e5; border: 1px solid #4f46e5; color: #fff; font-weight: 600; border-radius: .45rem;
            transition: background .12s ease, box-shadow .12s ease;
        }
        .btn-entry:hover { background: #4338ca; border-color: #4338ca; color: #fff; box-shadow: 0 .25rem .6rem rgba(79,70,229,.3); }
        .btn-icon { width: 32px; height: 32px; display: inline-flex; align-items: center; justify-content: center; border-radius: .5rem; }
    </style>
}

<div class="reporting-wrapper py-2">
<div class="container-fluid px-3">
    <!-- Top Header -->
    <div class="card lr-head shadow-sm mb-2">
        <div class="card-body p-2 px-3 d-flex flex-wrap align-items-center justify-content-between gap-2">
            <div class="d-flex align-items-center gap-2.5">
                <div class="lr-head-icon shadow-sm">
                    <i class="bi bi-file-earmark-image"></i>
                </div>
                <div>
                    <div class="d-flex align-items-center gap-2">
                        <h5 class="fw-bold mb-0 text-dark fs-7">Image Report Entry</h5>
                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle fs-9">Collected In-House Radiology / Image Tests</span>
                        @if (Model.DepartmentScopeRestricted)
                        {
                            <span class="badge bg-indigo-subtle text-indigo border border-indigo-subtle fs-9"
                                  title="Showing tests for your assigned departments: @string.Join(", ", Model.DepartmentScopeNames)">
                                <i class="bi bi-person-badge me-1"></i>@Model.DepartmentScopeNames.Count dept@(Model.DepartmentScopeNames.Count == 1 ? "" : "s")
                            </span>
                        }
                    </div>
                    <div class="text-muted fs-8">Enter, template-edit, and validate diagnostic imaging test reports (CT, MRI, X-Ray, USG, etc.)</div>
                </div>
            </div>
            <div class="d-flex align-items-center gap-2">
                <div class="auto-refresh-pill" data-ar-interval="120" data-ar-storage="ar_lab_image_reporting">
                    <button type="button" class="btn btn-outline-secondary btn-sm ar-toggle" title="Auto-refresh status and interval">
                        <span class="ar-indicator"></span>
                        <span class="ar-label">Auto 2m</span>
                    </button>
                    <div class="ar-menu d-none">
                        <div class="ar-menu-header">Auto-refresh</div>
                        <button type="button" class="ar-menu-item" data-interval="0">Off</button>
                        <button type="button" class="ar-menu-item" data-interval="30">Every 30s</button>
                        <button type="button" class="ar-menu-item" data-interval="60">Every 1m</button>
                        <button type="button" class="ar-menu-item active" data-interval="120">Every 2m</button>
                        <button type="button" class="ar-menu-item" data-interval="300">Every 5m</button>
                    </div>
                </div>
                <span class="text-muted fs-9 ar-last-updated d-none d-sm-inline">Updated just now</span>
                <span class="lr-count-chip" id="lblTotalOrdersCount">0 orders</span>
                <button type="button" class="btn btn-light border btn-sm btn-icon" id="btnManualRefresh" title="Refresh Now">
                    <i class="bi bi-arrow-clockwise"></i>
                </button>
            </div>
        </div>
    </div>

    <!-- KPI / Summary Cards -->
    <div class="row g-2 mb-2">
        <div class="col-6 col-md">
            <div class="card stat-card k-total shadow-sm h-100 active-card" data-status="All">
                <div class="card-body py-2 px-2.5 d-flex align-items-center justify-content-between">
                    <div>
                        <span class="stat-label d-block">Total Orders</span>
                        <div class="stat-value mt-0.5" id="statTotalOrders">@Model.Stats.TotalOrders</div>
                    </div>
                    <div class="stat-icon"><i class="bi bi-collection"></i></div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md">
            <div class="card stat-card k-pending shadow-sm h-100" data-status="Pending Entry">
                <div class="card-body py-2 px-2.5 d-flex align-items-center justify-content-between">
                    <div>
                        <span class="stat-label d-block">Pending Entry</span>
                        <div class="stat-value mt-0.5" id="statPendingOrders">@Model.Stats.PendingOrders</div>
                    </div>
                    <div class="stat-icon"><i class="bi bi-hourglass-split"></i></div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md">
            <div class="card stat-card k-draft shadow-sm h-100" data-status="Draft" title="Some tests further along than others on this bill (the image workflow has no separate Save Draft step)">
                <div class="card-body py-2 px-2.5 d-flex align-items-center justify-content-between">
                    <div>
                        <span class="stat-label d-block">In Progress</span>
                        <div class="stat-value mt-0.5" id="statDraftOrders">@Model.Stats.DraftOrders</div>
                    </div>
                    <div class="stat-icon"><i class="bi bi-pencil-square"></i></div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md">
            <div class="card stat-card k-entered shadow-sm h-100" data-status="Report Entry">
                <div class="card-body py-2 px-2.5 d-flex align-items-center justify-content-between">
                    <div>
                        <span class="stat-label d-block">Report Entered</span>
                        <div class="stat-value mt-0.5" id="statEnteredOrders">@Model.Stats.EnteredOrders</div>
                    </div>
                    <div class="stat-icon"><i class="bi bi-file-earmark-check"></i></div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md">
            <div class="card stat-card k-validated shadow-sm h-100" data-status="Report Validated">
                <div class="card-body py-2 px-2.5 d-flex align-items-center justify-content-between">
                    <div>
                        <span class="stat-label d-block">Validated</span>
                        <div class="stat-value mt-0.5" id="statValidatedOrders">@Model.Stats.ValidatedOrders</div>
                    </div>
                    <div class="stat-icon"><i class="bi bi-patch-check-fill"></i></div>
                </div>
            </div>
        </div>
    </div>

    <!-- Filters -->
    <div class="card lr-card shadow-sm mb-2">
        <div class="card-body p-2 px-3">
            <div class="row g-2 align-items-end">
                <div class="col-6 col-md-2">
                    <label class="lr-label" for="selDateFilterType">Filter By Date</label>
                    <select id="selDateFilterType" class="form-select form-select-sm">
                        <option value="BookingDate" selected="@(Model.DateFilterType == "BookingDate")">Booking Date Time</option>
                        <option value="OrderDate" selected="@(Model.DateFilterType == "OrderDate")">Order / Bill Date</option>
                    </select>
                </div>
                <div class="col-6 col-md-2">
                    <label class="lr-label" for="txtFromDate">From Date</label>
                    <input type="date" id="txtFromDate" class="form-control form-control-sm" value="@Model.FromDate.ToString("yyyy-MM-dd")" />
                </div>
                <div class="col-6 col-md-2">
                    <label class="lr-label" for="txtToDate">To Date</label>
                    <input type="date" id="txtToDate" class="form-control form-control-sm" value="@Model.ToDate.ToString("yyyy-MM-dd")" />
                </div>
                <div class="col-6 col-md-3">
                    <label class="lr-label">Quick Select</label>
                    <div class="btn-group btn-group-sm w-100 lr-quick" role="group" aria-label="Quick date range">
                        <button type="button" class="btn btn-quick-date" data-range="today">Today</button>
                        <button type="button" class="btn btn-quick-date" data-range="yesterday">Yesterday</button>
                        <button type="button" class="btn btn-quick-date" data-range="week">7 Days</button>
                        <button type="button" class="btn btn-quick-date" data-range="month">This Month</button>
                    </div>
                </div>
                <div class="col-12 col-md-3">
                    <label class="lr-label" for="txtSearch">Search Patient / Order</label>
                    <div class="input-group input-group-sm">
                        <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                        <input type="text" id="txtSearch" class="form-control border-start-0 ps-0" placeholder="Name, code, token, bill, phone&hellip;" value="@Model.Search" />
                    </div>
                </div>
            </div>
        </div>

        <div class="lr-filter-strip px-3 py-2">
            <div class="row g-2 align-items-end">
                <div class="col-12 col-md-auto d-flex align-items-center pb-1">
                    <span class="fw-semibold fs-9 text-secondary d-flex align-items-center gap-1 text-uppercase" style="letter-spacing:.4px;">
                        <i class="bi bi-funnel-fill text-primary"></i>Filter Investigations
                    </span>
                </div>
                <div class="col-12 col-md">
                    <label class="lr-label" for="ddlDepartment"><i class="bi bi-hospital me-1"></i>Department</label>
                    <select id="ddlDepartment" class="form-select form-select-sm" data-placeholder="-- All Departments --">
                        <option value="">-- All Departments --</option>
                        @foreach (var d in Model.DepartmentOptions)
                        {
                            <option value="@d.Value" selected="@(d.Value == Model.DepartmentId?.ToString() ? "selected" : null)">@d.Text</option>
                        }
                    </select>
                </div>
                <div class="col-12 col-md">
                    <label class="lr-label" for="ddlCategory"><i class="bi bi-tag me-1"></i>Category</label>
                    <select id="ddlCategory" class="form-select form-select-sm" data-placeholder="-- All Categories --">
                        <option value="">-- All Categories --</option>
                        @foreach (var c in Model.CategoryOptions)
                        {
                            <option value="@c.Value" selected="@(c.Value == Model.CategoryId?.ToString() ? "selected" : null)">@c.Text</option>
                        }
                    </select>
                </div>
                <div class="col-12 col-md">
                    <label class="lr-label" for="ddlSubCategory"><i class="bi bi-tags me-1"></i>Sub Category</label>
                    <select id="ddlSubCategory" class="form-select form-select-sm" data-placeholder="-- All Sub Categories --">
                        <option value="">-- All Sub Categories --</option>
                        @foreach (var sc in Model.SubCategoryOptions)
                        {
                            <option value="@sc.Value" selected="@(sc.Value == Model.SubCategoryId?.ToString() ? "selected" : null)">@sc.Text</option>
                        }
                    </select>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Orders List Card -->
    <div class="card lr-card shadow-sm">
        <div class="card-header bg-white border-bottom p-2 px-3 d-flex flex-wrap align-items-center justify-content-between gap-2">
            <div class="d-flex align-items-center gap-2">
                <span class="fw-bold text-dark fs-8 text-uppercase" style="letter-spacing: .4px;">
                    <i class="bi bi-list-task me-1 text-primary"></i>Image Orders
                </span>
                <span class="badge bg-light text-muted border fs-9" id="lblFilteredCount">0 shown</span>
            </div>

            <!-- Status colour-code legend (interactive toggle) -->
            <div class="lr-legend" id="statusLegend" role="toolbar" aria-label="Filter rows by status colour">
                <button type="button" class="lg-item st-pending" data-st="st-pending" title="Show only Pending Entry rows">
                    <span class="lg-dot"></span><span>Pending Entry</span><span class="lg-count"></span>
                </button>
                <button type="button" class="lg-item st-draft" data-st="st-draft" title="Show only In Progress rows">
                    <span class="lg-dot"></span><span>In Progress</span><span class="lg-count"></span>
                </button>
                <button type="button" class="lg-item st-entered" data-st="st-entered" title="Show only Report Entry rows">
                    <span class="lg-dot"></span><span>Report Entry</span><span class="lg-count"></span>
                </button>
                <button type="button" class="lg-item st-validated" data-st="st-validated" title="Show only Validated rows">
                    <span class="lg-dot"></span><span>Validated</span><span class="lg-count"></span>
                </button>
                <button type="button" class="lg-item st-approved" data-st="st-approved" title="Show only Approved rows">
                    <span class="lg-dot"></span><span>Approved</span><span class="lg-count"></span>
                </button>
                <button type="button" class="btn btn-outline-secondary btn-sm lg-clear d-none py-0 px-2 fs-9" id="btnClearLegend">
                    Show All
                </button>
            </div>
        </div>

        <div class="card-body p-0">
            <div class="table-responsive table-responsive-custom">
                <table class="table table-hover table-sticky-header align-middle mb-0" id="tblReportingOrders">
                    <thead>
                        <tr>
                            <th class="ps-3" style="width: 35px;">#</th>
                            <th style="min-width: 130px;">Order / Token</th>
                            <th style="min-width: 220px;">Patient Details</th>
                            <th style="min-width: 140px;">Contact</th>
                            <th style="min-width: 140px;">Booking Date</th>
                            <th class="text-center" style="min-width: 130px;">Collection Status</th>
                            <th class="text-center" style="min-width: 130px;">Report Status</th>
                            <th class="text-end pe-3" style="min-width: 130px;">Action</th>
                        </tr>
                    </thead>
                    <tbody id="tblReportingOrdersBody" class="fs-8">
                        <!-- Populated by JavaScript -->
                    </tbody>
                </table>
            </div>

            <!-- Empty state -->
            <div id="emptyOrdersState" class="text-center py-5 d-none">
                <div class="d-inline-flex align-items-center justify-content-center rounded-circle mb-2"
                     style="width:64px;height:64px;background:#eef2f6;color:#94a3b8;">
                    <i class="bi bi-file-earmark-image" style="font-size: 1.8rem;"></i>
                </div>
                <div class="fw-bold text-dark fs-7">No collected image orders found</div>
                <div class="text-muted fs-8 mt-1">No in-house collected image samples match the current filters. Try a wider date range or clear the filters.</div>
            </div>

            <!-- Loading state -->
            <div id="loadingOrdersState" class="text-center py-5">
                <div class="spinner-border spinner-border-sm text-primary" role="status">
                    <span class="visually-hidden">Loading&hellip;</span>
                </div>
                <div class="text-muted fs-8 mt-2">Fetching image orders for reporting&hellip;</div>
            </div>
        </div>
    </div>
</div>
</div>

<partial name="_LabAuditHistoryModal" />

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
    <partial name="_LabAuditHistoryScripts" />
    <script src="~/js/auto-refresh.js" asp-append-version="true"></script>
    <script>
        $(document).ready(function () {
            toastr.options = {
                closeButton: true,
                progressBar: true,
                positionClass: "toast-top-right",
                timeOut: "3000"
            };

            let currentOrders = [];
            let legendStatus = null;
            let currentStatusFilter = '@Model.StatusFilter' || 'All';
            let searchTimeout = null;

            function loadOrders(silent) {
                const prevIds = silent ? new Set(currentOrders.map(o => o.labOrderId)) : null;
                if (!silent) {
                    $('#loadingOrdersState').removeClass('d-none');
                    $('#emptyOrdersState').addClass('d-none');
                    $('#tblReportingOrdersBody').empty();
                }

                const params = {
                    fromDate: $('#txtFromDate').val(),
                    toDate: $('#txtToDate').val(),
                    dateFilterType: $('#selDateFilterType').val(),
                    statusFilter: currentStatusFilter,
                    search: $('#txtSearch').val(),
                    departmentId: $('#ddlDepartment').val() || null,
                    categoryId: $('#ddlCategory').val() || null,
                    subCategoryId: $('#ddlSubCategory').val() || null
                };

                const request = new Promise(function (resolve, reject) {
                    $.get('@Url.Action("GetHeadersJson", "LabImageReporting")', params)
                        .done(function (res) {
                            $('#loadingOrdersState').addClass('d-none');
                            if (res.success) {
                                currentOrders = res.headers || [];
                                updateStats(res.stats);
                                renderOrdersTable(currentOrders);
                                if (!silent && autoRefresh) autoRefresh.touch();
                                resolve(AutoRefresh.markNewRows(prevIds, currentOrders, o => o.labOrderId, id => '#orderRow_' + id));
                            } else {
                                if (!silent) toastr.error(res.message || 'Failed to load image reporting headers.');
                                reject();
                            }
                        })
                        .fail(function () {
                            $('#loadingOrdersState').addClass('d-none');
                            if (!silent) toastr.error('Server error while loading image reporting list.');
                            reject();
                        });
                });

                return request;
            }

            const autoRefresh = window.AutoRefresh ? AutoRefresh.init({
                storageKey: 'ar_lab_image_reporting',
                defaultInterval: 120,
                onTick: function () { return loadOrders(true); }
            }) : null;

            function updateStats(stats) {
                if (!stats) return;
                $('#statTotalOrders').text(stats.totalOrders || 0);
                $('#statPendingOrders').text(stats.pendingOrders || 0);
                $('#statDraftOrders').text(stats.draftOrders || 0);
                $('#statEnteredOrders').text(stats.enteredOrders || 0);
                $('#statValidatedOrders').text(stats.validatedOrders || 0);
                $('#lblTotalOrdersCount').text((stats.totalOrders || 0) + ' orders');
            }

            function getStatusCssClass(name) {
                const s = (name || '').toLowerCase();
                if (s.includes('approve')) return 'st-approved';
                if (s.includes('validat')) return 'st-validated';
                if (s.includes('entry') || s.includes('entered')) return 'st-entered';
                if (s.includes('draft') || s.includes('progress')) return 'st-draft';
                if (s.includes('re-collect') || s.includes('recollect')) return 'st-recollect';
                if (s.includes('reject')) return 'st-rejected';
                return 'st-pending';
            }

            function renderOrdersTable(orders) {
                const $tbody = $('#tblReportingOrdersBody');
                $tbody.empty();

                if (!orders || orders.length === 0) {
                    $('#emptyOrdersState').removeClass('d-none');
                    $('#lblFilteredCount').text('0 shown');
                    return;
                }

                $('#emptyOrdersState').addClass('d-none');
                $('#lblFilteredCount').text(orders.length + ' shown');

                let html = '';
                orders.forEach(function (o, index) {
                    const rowClass = getStatusCssClass(o.reportStatusName);
                    const genderCls = (o.gender || '').toLowerCase() === 'female' ? ' female' : '';
                    const initials = (o.patientName || 'P').split(' ').map(w => w[0]).filter(Boolean).slice(0, 2).join('').toUpperCase();

                    const sampleBadgeClass = o.sampleCollectionStatus === 'Collected'
                        ? 'bg-success-subtle text-success border border-success-subtle'
                        : 'bg-warning-subtle text-warning border border-warning-subtle';

                    // B2B-billed order (Franchise / Company): a real background/text colour, since
                    // "bg-purple-subtle" / "text-purple" are not Bootstrap classes and render with no
                    // colour at all - the washed-out, barely-readable badge this replaces.
                    const b2bBadge = o.isB2B
                        ? `<span class="badge fs-9 fw-semibold" style="background:#f5f3ff;color:#6d28d9;border:1px solid #ddd6fe;" title="${escapeHtml(o.clientName || 'B2B Client')}"><i class="bi bi-building me-1"></i>${escapeHtml(o.clientCode || 'B2B')}</span>`
                        : '';

                    const urgentBadge = o.isUrgent
                        ? '<span class="badge bg-danger text-white fs-9"><i class="bi bi-lightning-fill me-0.5"></i>Urgent</span>'
                        : '';

                    html += `
                        <tr class="${rowClass}" id="orderRow_${o.labOrderId}">
                            <td class="ps-3 text-muted fs-9 fw-semibold">${index + 1}</td>
                            <td>
                                <div class="d-flex align-items-center gap-1">
                                    <span class="badge bg-primary text-white lr-mono fs-9">${escapeHtml(o.tokenNo || 'LAB')}</span>
                                    ${b2bBadge}
                                    ${urgentBadge}
                                </div>
                                <div class="fs-9 text-muted lr-mono mt-1">${escapeHtml(o.billNo || '—')}</div>
                            </td>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <span class="lr-avatar${genderCls}">${escapeHtml(initials)}</span>
                                    <div class="min-w-0">
                                        <div class="d-flex align-items-center gap-1">
                                            <span class="fw-semibold text-dark fs-8 text-truncate" title="${escapeHtml(o.patientName)}">${escapeHtml(o.patientName)}</span>
                                            <button type="button" class="btn-audit-info"
                                                    data-laborderid="${o.labOrderId}"
                                                    data-patient="${escapeHtml(o.patientName)}"
                                                    data-bill="${escapeHtml(o.billNo || '—')}"
                                                    title="View audit history for this bill"
                                                    aria-label="View audit history for this bill">
                                                <i class="bi bi-info-circle-fill"></i>
                                            </button>
                                        </div>
                                        <div class="fs-9 text-muted d-flex align-items-center gap-1 mt-0.5">
                                            <span class="badge bg-light text-secondary border lr-mono fw-normal">${escapeHtml(o.patientCode)}</span>
                                            <span>${o.age ? o.age + ' Y' : ''}${o.age && o.gender ? ' · ' : ''}${escapeHtml(o.gender || '')}</span>
                                        </div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <div class="text-dark fs-8"><i class="bi bi-telephone text-muted me-1"></i>${escapeHtml(o.phoneNumber || '—')}</div>
                                <div class="fs-9 text-muted text-truncate" style="max-width: 210px;" title="${escapeHtml(o.emailId || '')}">
                                    <i class="bi bi-envelope me-1"></i>${escapeHtml(o.emailId || '—')}
                                </div>
                            </td>
                            <td>
                                <div class="text-dark fs-8">${formatDate(o.bookingDateTime || o.orderDate)}</div>
                                <div class="fs-9 text-muted"><i class="bi bi-clock me-1"></i>${formatTime(o.bookingDateTime || o.orderDate)}</div>
                            </td>
                            <td class="text-center">
                                <span class="badge ${sampleBadgeClass} fs-9">
                                    <i class="bi bi-eyedropper me-1"></i>${escapeHtml(o.sampleCollectionStatus)}
                                </span>
                                <div class="fs-9 text-muted mt-1">${o.collectedInHouseTests} / ${o.totalInHouseTests} Tests</div>
                            </td>
                            <td class="text-center">
                                <span class="badge st-badge fs-9">
                                    ${escapeHtml(o.reportStatusName)}
                                </span>
                            </td>
                            <td class="text-end pe-3">
                                <a href="@Url.Action("Entry", "LabImageReporting")?labOrderId=${o.labOrderId}"
                                   target="_blank"
                                   class="btn btn-entry btn-sm py-1 px-2.5 fs-8 d-inline-flex align-items-center"
                                   title="Open Image Report Entry in a new tab">
                                    <i class="bi bi-pencil-square me-1"></i>Report Entry
                                    <i class="bi bi-box-arrow-up-right ms-1.5 fs-9 text-white-50"></i>
                                </a>
                            </td>
                        </tr>
                    `;
                });

                $tbody.html(html);
                applyLegendFilter();
            }

            function applyLegendFilter() {
                const $rows = $('#tblReportingOrdersBody tr');
                const total = $rows.length;

                $('#statusLegend .lg-item[data-st]').each(function () {
                    const st = $(this).data('st');
                    const n = $rows.filter('.' + st).length;
                    $(this).find('.lg-count').text(n ? ' ' + n : '');
                    $(this).toggleClass('is-empty', n === 0);
                });

                if (legendStatus) {
                    $rows.each(function () {
                        $(this).toggle($(this).hasClass(legendStatus));
                    });
                    const visible = $rows.filter('.' + legendStatus).length;
                    $('#lblFilteredCount').text(visible + ' of ' + total + ' shown');
                    $('#btnClearLegend').removeClass('d-none');
                } else {
                    $rows.show();
                    $('#lblFilteredCount').text(total + ' shown');
                    $('#btnClearLegend').addClass('d-none');
                }
            }

            $('#statusLegend').on('click', '.lg-item', function () {
                const st = $(this).data('st');
                if (legendStatus === st) {
                    legendStatus = null;
                    $(this).removeClass('active');
                } else {
                    legendStatus = st;
                    $('#statusLegend .lg-item').removeClass('active');
                    $(this).addClass('active');
                }
                applyLegendFilter();
            });

            $('#btnClearLegend').on('click', function () {
                legendStatus = null;
                $('#statusLegend .lg-item').removeClass('active');
                applyLegendFilter();
            });

            $('.stat-card').on('click', function () {
                $('.stat-card').removeClass('active-card');
                $(this).addClass('active-card');
                currentStatusFilter = $(this).data('status');
                loadOrders();
            });

            $('.btn-quick-date').on('click', function () {
                $('.btn-quick-date').removeClass('active');
                $(this).addClass('active');

                const range = $(this).data('range');
                const today = new Date();
                let from = new Date();
                let to = new Date();

                if (range === 'today') {
                    // today
                } else if (range === 'yesterday') {
                    from.setDate(today.getDate() - 1);
                    to.setDate(today.getDate() - 1);
                } else if (range === 'week') {
                    from.setDate(today.getDate() - 6);
                } else if (range === 'month') {
                    from = new Date(today.getFullYear(), today.getMonth(), 1);
                }

                $('#txtFromDate').val(formatDateInput(from));
                $('#txtToDate').val(formatDateInput(to));
                loadOrders();
            });

            $('#txtFromDate, #txtToDate, #selDateFilterType').on('change', function () {
                loadOrders();
            });

            $('#txtSearch').on('input', function () {
                clearTimeout(searchTimeout);
                searchTimeout = setTimeout(function () {
                    loadOrders();
                }, 400);
            });

            $('#ddlDepartment').on('change', function () {
                const deptId = $(this).val();
                loadCategories(deptId);
                loadOrders();
            });

            $('#ddlCategory').on('change', function () {
                const catId = $(this).val();
                loadSubCategories(catId);
                loadOrders();
            });

            $('#ddlSubCategory').on('change', function () {
                loadOrders();
            });

            $('#btnManualRefresh').on('click', function () {
                loadOrders();
            });

            function loadCategories(deptId) {
                const $ddl = $('#ddlCategory');
                $ddl.empty().append('<option value="">-- All Categories --</option>');
                $('#ddlSubCategory').empty().append('<option value="">-- All Sub Categories --</option>');
                if (!deptId) return;

                $.get('@Url.Action("GetCategoriesForDropdown", "LabReporting")', { departmentId: deptId })
                    .done(function (items) {
                        items.forEach(function (c) {
                            $ddl.append(`<option value="${c.value}">${escapeHtml(c.text)}</option>`);
                        });
                    });
            }

            function loadSubCategories(catId) {
                const $ddl = $('#ddlSubCategory');
                $ddl.empty().append('<option value="">-- All Sub Categories --</option>');
                if (!catId) return;

                $.get('@Url.Action("GetSubCategoriesForDropdown", "LabReporting")', { categoryId: catId })
                    .done(function (items) {
                        items.forEach(function (s) {
                            $ddl.append(`<option value="${s.value}">${escapeHtml(s.text)}</option>`);
                        });
                    });
            }

            function formatDate(dt) {
                if (!dt) return '—';
                const d = new Date(dt);
                return d.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });
            }

            function formatTime(dt) {
                if (!dt) return '—';
                const d = new Date(dt);
                return d.toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit', hour12: true });
            }

            function formatDateInput(d) {
                const year = d.getFullYear();
                const month = String(d.getMonth() + 1).padStart(2, '0');
                const day = String(d.getDate()).padStart(2, '0');
                return `${year}-${month}-${day}`;
            }

            function escapeHtml(str) {
                if (!str) return '';
                return $('<div>').text(str).html();
            }

            // Initial load
            loadOrders();
        });
    </script>
}
