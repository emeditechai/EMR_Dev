@model EMR.Web.Models.DTOs.LabReportingOrderDetailDto
@{
    Layout = null;
    var d = Model;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Image Diagnostic Report - @d.PatientName (@d.TokenNo)</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <style>
        /* A4 portrait: 210 x 297 mm. The page margin is kept at 0 and the real margin is padded onto
           .report-page instead (see @@media print): a browser's own "Margins" dropdown overrides an
           @@page margin - picking "None" printed the report hard against the paper edge - but it can
           never strip padding that belongs to the content. Printable height = 297 - 12 - 12 = 273 mm. */
        @@page {
            size: A4 portrait;
            margin: 0;
        }
        body {
            font-family: 'Segoe UI', Arial, sans-serif;
            color: #111111;
            background: #f8fafc;
            font-size: 13px;
            line-height: 1.5;
        }
        .report-page {
            max-width: 800px;
            margin: 20px auto;
            background: #ffffff;
            padding: 24px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.08);
            border-radius: 8px;
        }
        
        /* Letterhead */
        .header-brand {
            border-bottom: 2px solid #0f3d6b;
            padding-bottom: 8px;
            margin-bottom: 12px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .hospital-name {
            font-size: 20px;
            font-weight: 800;
            color: #0f3d6b;
            margin-bottom: 2px;
        }
        .department-name {
            font-size: 10px;
            font-weight: 600;
            color: #475569;
            letter-spacing: 0.06em;
        }
        .hospital-contact {
            font-size: 10px;
            color: #475569;
            text-align: right;
            line-height: 1.4;
        }

        /* 3 Info Boxes */
        .info-boxes-container {
            display: flex;
            border: 1.5px solid #111111;
            margin-bottom: 16px;
        }
        .info-box {
            flex: 1;
            padding: 4px;
            border-right: 1.5px solid #111111;
        }
        .info-box:last-child {
            border-right: none;
        }
        .info-box-title {
            font-size: 11px;
            font-weight: 700;
            border-bottom: 1px solid #999999;
            padding-bottom: 3px;
            margin-bottom: 4px;
        }
        .info-row {
            display: flex;
            font-size: 10px;
            margin-bottom: 2px;
        }
        .info-label {
            width: 75px;
            color: #333333;
        }
        .info-val {
            flex: 1;
            font-weight: 600;
        }
        .status-val {
            color: #b45309; /* Amber for provisional */
        }
        .status-val.final {
            color: #166534; /* Green for final */
        }

        /* Content */
        .report-title-bar {
            background: #eef2f7;
            border: 1px solid #111111;
            color: #0f3d6b;
            padding: 4px 6px;
            font-weight: 700;
            font-size: 13px;
            margin-bottom: 12px;
            margin-top: 20px;
        }
        .report-html-content {
            font-size: 13px;
            line-height: 1.6;
            color: #111111;
            padding: 0 8px;
            min-height: 200px;
        }
        .report-html-content p {
            margin-bottom: 8px;
        }

        /* Footer */
        .signature-block {
            margin-top: 40px;
            display: flex;
            justify-content: space-between;
            margin-bottom: 20px;
        }
        .sig-box {
            width: 150px;
        }
        .sig-line {
            border-bottom: 1px solid #999999;
            margin-bottom: 4px;
            height: 30px; /* Space for signature image */
        }
        .sig-title {
            font-size: 9px;
            color: #475569;
            letter-spacing: 0.06em;
            margin-bottom: 4px;
        }
        .sig-name {
            font-size: 12px;
            font-weight: 700;
        }
        .sig-detail {
            font-size: 10px;
            color: #111111;
        }

        .page-footer {
            border-top: 1px solid #111111;
            padding-top: 4px;
            font-size: 10px;
        }
        .footer-note {
            font-weight: 600;
            margin-bottom: 2px;
        }
        .footer-meta {
            display: flex;
            justify-content: space-between;
            color: #475569;
        }

        @@media print {
            html, body {
                margin: 0 !important;
                padding: 0 !important;
                background: #ffffff;
            }
            .no-print {
                display: none !important;
            }
            /* One test starts a fresh A4 sheet. A short report sits on one page; a long one is
               allowed to run onto a second sheet of the SAME test rather than being squeezed or clipped -
               that is a real second page, not a stray blank one. */
            .report-page {
                box-sizing: border-box;
                width: 100%;
                max-width: none;
                margin: 0;
                /* the A4 margin itself - see the @@page note above. Bottom is a touch taller than the
                   other three sides so the footer band (see .sign-off-block below) has clear breathing
                   room instead of sitting flush against the paper edge. */
                padding: 12mm 12mm 14mm 12mm;
                box-shadow: none;
                border-radius: 0;
                break-inside: auto;
            }
            /* Break BEFORE every test except the first, instead of AFTER every test except the last:
               "after, except last" leaves a page break queued with nothing behind it whenever the final
               test's own content already ends exactly on a page boundary, which is what printed the
               trailing blank sheet. "before, except first" cannot produce a break with nothing after it. */
            .report-page.page-break {
                page-break-before: always;
                break-before: page;
            }
            /* Signature block + footer travel as ONE unit (.sign-off-block, wrapping both - see the
               markup): if they don't fit under the report on the current sheet, the whole unit moves to
               the next one together, so the footer can never be split off and left alone on a page of
               its own. Not forced to the bottom of the sheet - that reserved dead space is what used to
               push content past 275 mm and onto a needless extra page. */
            .report-page .sign-off-block {
                break-inside: avoid;
                page-break-inside: avoid;
                margin-top: 24px;
            }
            /* .signature-block's own top margin would otherwise collapse with the wrapper's above (the
               larger of the two wins), silently undoing the tighter print spacing - so it is zeroed here
               and the wrapper is the single source of that gap in print. */
            .report-page .signature-block {
                margin-top: 0;
            }
            .report-page .page-footer {
                margin-top: 16px;
            }
            .watermark { font-size: 6.5rem; }
            /* keep the whole letterhead / patient box together, never split across a page */
            .header-brand, .info-boxes-container { break-inside: avoid; page-break-inside: avoid; }
            /* trim the on-screen breathing room that print doesn't need, so a normal report fits one sheet */
            .mb-4 { margin-bottom: 12px !important; }
            .my-4 { margin-top: 12px !important; margin-bottom: 12px !important; }
            .report-html-content p { margin: 0 0 6px; }
        }
        /* SQLScripts/2391: an external document page - the image fitted between the letterhead and the footer */
        .ext-doc-caption { font-size: 10px; color: #64748b; margin-bottom: 6px; }
        .ext-doc-caption b { color: #111111; }
        .ext-doc-image { text-align: center; margin-bottom: 12px; }
        .ext-doc-image img { max-width: 100%; max-height: 190mm; object-fit: contain; }
        .ext-doc-note { margin-top: 8px; padding: 4px 8px; border: 1px solid #cbd5e1; background: #f8fafc; font-size: 11px; font-style: italic; }
        @@media print {
            .ext-doc-page { break-inside: avoid; page-break-inside: avoid; }
            .ext-doc-page .page-footer { margin-top: 8px; }
        }
        /* One A4 portrait sheet per test, on screen and on paper alike (so the fit measured on screen is the printed one):
           letterhead and patient boxes at the top, the report under them, and the signatures + footer always at the bottom
           of the same sheet. A report too long for the sheet is scaled down to fit (script below); only when it would have
           to shrink below ~62% does it run onto a second sheet (.flow), signatures still at its end. */
        .report-page.sheet {
            box-sizing: border-box; width: 210mm; max-width: none; height: 296mm;
            padding: 12mm 12mm 12mm 12mm; display: flex; flex-direction: column;
        }
        .report-page.sheet > * { flex-shrink: 0; }
        .report-page.sheet > .report-body { flex: 0 1 auto; min-height: 0; overflow: hidden; margin-bottom: 0 !important; }
        .report-page.sheet > .end-of-report { margin: 10px 0 0 !important; }
        .report-page.sheet > .sign-off-block { margin-top: auto; padding-top: 12px; }
        .report-page.sheet .signature-block { margin-top: 0; margin-bottom: 10px; }
        .report-page.sheet .page-footer { margin-top: 8px; }
        .report-page.sheet.flow { height: auto; min-height: 296mm; }
        .report-page.sheet.flow > .report-body { overflow: visible; }
        /* external document sheet: the image fills the room between the patient boxes and the footer */
        .report-page.sheet.ext-doc-page > .ext-doc-image { flex: 1 1 0; min-height: 0; margin-bottom: 8px;
            display: flex; align-items: center; justify-content: center; }
        .report-page.sheet.ext-doc-page > .ext-doc-image img { max-width: 100%; max-height: 100%; }
        .report-page.sheet.ext-doc-page > .sign-off-block { margin-top: auto; padding-top: 8px; }
        @@media print {
            .report-page.sheet { width: 210mm; height: 296mm; margin: 0; padding: 12mm 12mm 12mm 12mm; }
            .report-page.sheet.flow { height: auto; min-height: 296mm; }
            .report-page.sheet > .sign-off-block { margin-top: auto; }
        }

        /* The watermark is clipped to its own page so a rotated word can never push out a blank sheet */
        .report-page { position: relative; overflow: hidden; }
        .watermark-container {
            position: relative;
            z-index: 1;
        }

        .watermark {
            position: absolute;
            top: 45%;
            left: 50%;
            transform: translate(-50%, -50%) rotate(-35deg);
            font-size: 8rem;
            font-weight: 900;
            color: rgba(220, 38, 38, 0.08); /* Faint red */
            z-index: -1;
            pointer-events: none;
            white-space: nowrap;
            text-align: center;
        }

        .watermark .sub {
            font-size: 1.5rem;
            letter-spacing: 0.15em;
            display: block;
            margin-top: -15px;
        }
    </style>
</head>
<body>

    @if (!(ViewBag.Embed as bool? ?? false))
    {
    <!-- Floating Print Toolbar (Non-printing) -->
    <div class="no-print bg-dark text-white py-2 px-3 sticky-top shadow-sm d-flex justify-content-between align-items-center">
        <div>
            <strong class="me-2"><i class="bi bi-file-earmark-medical me-1"></i>Report Preview</strong>
            <span class="text-white-50 fs-8">@d.PatientName (@d.TokenNo)</span>
        </div>
        <div class="d-flex align-items-center gap-2">
            <button type="button" class="btn btn-primary btn-sm px-3 fw-semibold" onclick="window.print()">
                <i class="bi bi-printer me-1"></i>Print Report
            </button>
            <button type="button" class="btn btn-outline-light btn-sm px-3" onclick="window.close()">
                Close
            </button>
        </div>
    </div>
    }

    <!-- Printable Report Pages: every test starts on its own page, with its own header, status and signatures -->
    @{
        var printItems = d.Items ?? new List<EMR.Web.Models.DTOs.LabReportingItemDto>();
        int pageNo = 0;
        // SQLScripts/2391: an approved test's external document (PDF pages / JPG / PNG), merged after its report
        var externalDocs = ViewBag.ExternalDocs as Dictionary<int, EMR.Common.LabReportExternalDoc>
                           ?? new Dictionary<int, EMR.Common.LabReportExternalDoc>();
        EMR.Common.LabReportExternalDoc? DocOf(EMR.Web.Models.DTOs.LabReportingItemDto it)
            => it.ReportStatusId == 5 && externalDocs.TryGetValue(it.InvestigationID, out var x) ? x : null;
        int totalPages = printItems.Count + printItems.Sum(it => DocOf(it)?.Pages.Count ?? 0);
        // Utility > Print Templates (SQLScripts/2324): the Lab Report template's header / footer, as on the Lab and
        // Microbiology report PDFs; rendered here once (the footer per sheet, for its page number)
        var printTemplate = ViewData["PrintTemplate"] as EMR.Common.PrintLayout;
        var printValues = ViewData["PrintValues"] as Dictionary<string, string?>;
        var printLogoUrl = ViewData["PrintLogoUrl"] as string;
        Microsoft.AspNetCore.Html.IHtmlContent? tplHeader = null;
        var tplFooters = new Dictionary<int, Microsoft.AspNetCore.Html.IHtmlContent>();
        if (printTemplate is not null && printValues is not null)
        {
            tplHeader = await Html.PartialAsync("_PrintBand", new EMR.Common.PrintBandView { Band = printTemplate.Header, Values = printValues, LogoUrl = printLogoUrl });
            for (var pg = 1; pg <= Math.Max(totalPages, 1); pg++)
                tplFooters[pg] = await Html.PartialAsync("_PrintBand", new EMR.Common.PrintBandView
                    { Band = printTemplate.Footer, IsFooter = true, Values = printValues, LogoUrl = printLogoUrl, PageNo = pg, PageCount = Math.Max(totalPages, 1) });
        }
        string ImageSrc(byte[] b) => (b.Length > 3 && b[0] == 0x89 && b[1] == 0x50 ? "data:image/png;base64," : "data:image/jpeg;base64,") + Convert.ToBase64String(b);

        void Letterhead()
        {
            if (ViewBag.ShowLetterhead is false)
            {
                @* Hospital Settings > LAB > Required B2C Lab Report Print Header = No: blank space for pre-printed letterhead *@
                <div style="height: 30mm;"></div>
            }
            else if (tplHeader is not null)
            {
                <div class="tpl-band tpl-header">@tplHeader</div>
            }
            else
            {
            <div class="header-brand">
                <div style="display: flex; align-items: center; gap: 10px;">
                    @if (!string.IsNullOrWhiteSpace(ViewBag.LogoPath as string))
                    {
                        <img src="@ViewBag.LogoPath" alt="Logo" style="height: 50px; object-fit: contain;" />
                    }
                    <div>
                        <div class="hospital-name">@(ViewBag.HospitalName ?? "eMeditech Hospital")</div>
                        @if (!string.IsNullOrWhiteSpace(ViewBag.HospitalType as string))
                        {
                            <div class="department-name">@(((string)ViewBag.HospitalType).ToUpperInvariant())</div>
                        }
                        @if (!string.IsNullOrWhiteSpace(ViewBag.NabhStatus as string))
                        {
                            <div style="font-size: 9px; font-weight: 600; color: #0f3d6b; margin-top: 1px;">
                                NABH: @ViewBag.NabhStatus @(!string.IsNullOrWhiteSpace(ViewBag.NabhCertificateNo as string) ? $"(Cert. No. {ViewBag.NabhCertificateNo})" : "")
                            </div>
                        }
                    </div>
                </div>
                <div class="hospital-contact">
                    @if (!string.IsNullOrWhiteSpace(ViewBag.Address as string)) { <div>@ViewBag.Address</div> }
                    @if (!string.IsNullOrWhiteSpace(ViewBag.ContactNumber as string)) { <div>Tel: @ViewBag.ContactNumber</div> }
                    @if (!string.IsNullOrWhiteSpace(ViewBag.Email as string)) { <div>@ViewBag.Email</div> }
                    @if (!string.IsNullOrWhiteSpace(ViewBag.Website as string)) { <div>@ViewBag.Website</div> }
                    @if (!string.IsNullOrWhiteSpace(ViewBag.RegistrationNumber as string)) { <div>Reg. No.: @ViewBag.RegistrationNumber</div> }
                </div>
            </div>
            }
        }

        void InfoBoxes(bool itemFinal)
        {
            <div class="info-boxes-container">
                <div class="info-box">
                    <div class="info-box-title">Patient Information</div>
                    <div class="info-row"><div class="info-label">Name</div><div class="info-val">: @d.PatientName</div></div>
                    <div class="info-row"><div class="info-label">Age/Gender</div><div class="info-val">: @(d.Age.HasValue ? $"{d.Age} Y" : "—") / @(d.Gender ?? "—")</div></div>
                    <div class="info-row"><div class="info-label">Mobile No</div><div class="info-val">: @(string.IsNullOrWhiteSpace(d.PhoneNumber) ? "—" : d.PhoneNumber)</div></div>
                    <div class="info-row"><div class="info-label">Patient ID</div><div class="info-val">: @(string.IsNullOrWhiteSpace(d.PatientCode) ? "—" : d.PatientCode)</div></div>
                    <div class="info-row"><div class="info-label">Address</div><div class="info-val">: @(string.IsNullOrWhiteSpace(d.Address) ? "—" : d.Address)</div></div>
                </div>
                <div class="info-box">
                    <div class="info-box-title">Specimen Information</div>
                    <div class="info-row"><div class="info-label">Bill No</div><div class="info-val">: @(string.IsNullOrWhiteSpace(d.BillNo) ? "—" : d.BillNo)</div></div>
                    <div class="info-row"><div class="info-label">Collected</div><div class="info-val">: @(d.BookingDateTime?.ToString("dd/MMM/yyyy HH:mm") ?? d.OrderDate.ToString("dd/MMM/yyyy HH:mm"))</div></div>
                    <div class="info-row"><div class="info-label">Received</div><div class="info-val">: @(d.BookingDateTime?.ToString("dd/MMM/yyyy HH:mm") ?? "—")</div></div>
                    <div class="info-row"><div class="info-label">Reported</div><div class="info-val">: @DateTime.Now.ToString("dd/MMM/yyyy HH:mm")</div></div>
                    @if (ViewBag.LabSerialNo is string labSerialNo && !string.IsNullOrWhiteSpace(labSerialNo))
                    {
                        <div class="info-row"><div class="info-label">Lab Serial No</div><div class="info-val">: @labSerialNo</div></div>
                    }
                    <div class="info-row"><div class="info-label">Report Status</div><div class="info-val @(itemFinal ? "status-val final" : "status-val")">: @(itemFinal ? "Final Report" : "Provisional Report")</div></div>
                </div>
                <div class="info-box">
                    <div class="info-box-title">Branch / Doctor Information</div>
                    <div class="info-row"><div class="info-label">Branch Code</div><div class="info-val">: @(d.BranchId)</div></div>
                    <div class="info-row"><div class="info-label">Branch Name</div><div class="info-val">: @(d.BranchName ?? "Main Branch")</div></div>
                    <div class="info-row"><div class="info-label">Ref Doctor</div><div class="info-val">: @(string.IsNullOrWhiteSpace(d.ReferralDoctorName) ? "Self" : d.ReferralDoctorName)</div></div>
                </div>
            </div>
        }

        void Signatures()
        {
        <div class="signature-block" style="display: flex; justify-content: space-between;">
            @{
                var signoffLevels = ViewBag.SignoffLevels as List<EMR.Web.Models.DTOs.LabReportSignoffLevelDto>;
            }
            @if (signoffLevels != null && signoffLevels.Any())
            {
                foreach (var level in signoffLevels.OrderBy(x => x.LevelNo))
                {
                    <div class="sig-box" style="text-align: center;">
                        @if (!string.IsNullOrWhiteSpace(level.SignaturePath))
                        {
                            <img src="@level.SignaturePath" alt="Signature" style="height: 40px; object-fit: contain; margin-bottom: 5px;" />
                        }
                        else
                        {
                            <div class="sig-line" style="margin-top: 30px;"></div>
                        }
                        <div class="sig-title" style="font-size: 8px; font-weight: 600; color: #7f8c8d; text-transform: uppercase;">
                            @level.LevelTitle
                        </div>
                        <div class="sig-name" style="font-size: 10px; font-weight: 700;">@level.FullName</div>
                        @if (level.IsPathologist)
                        {
                            <div class="sig-detail" style="font-size: 9px; color: #475569;">Pathologist</div>
                        }
                        @if (!string.IsNullOrWhiteSpace(level.RegistrationNo))
                        {
                            <div class="sig-detail" style="font-size: 9px; color: #475569;">Reg. No.: @level.RegistrationNo</div>
                        }
                    </div>
                }
            }
            else
            {
                <div class="sig-box">
                    <div class="sig-line"></div>
                    <div class="sig-title">APPROVED BY</div>
                </div>
            }
        </div>

        }

        void PageFooter(int pageNumber)
        {
            @* Required B2C Lab Report Print Header = No: blank strip for the pre-printed letterhead's footer *@
            if (ViewBag.ShowLetterhead is false)
            {
            <div style="height: 15mm;"></div>
            }
            else if (tplFooters.TryGetValue(pageNumber, out var tplFooter))
            {
                <div class="page-footer tpl-band tpl-footer">@tplFooter</div>
            }
            else
            {
            <div class="page-footer">
                <div class="footer-note">This test has been performed at @(ViewBag.HospitalName ?? "eMeditech Hospital")</div>
                <div class="footer-meta">
                    <div>Printed on @DateTime.Now.ToString("dd/MMM/yyyy HH:mm") by @(ViewBag.PrintedBy ?? "System") | Bill @(d.BillNo ?? "—")</div>
                    <div>Page @pageNumber of @totalPages</div>
                </div>
            </div>
            }
        }
    }
    @if (printItems.Count == 0)
    {
        <div class="report-page"><div class="alert alert-warning mb-0">No investigations found for this report.</div></div>
    }
    @foreach (var item in printItems)
    {
        pageNo++;
        bool itemFinal = item.ReportStatusId == 5;   // approved = final; validated = provisional
    <div class="report-page sheet watermark-container @(pageNo > 1 ? "page-break" : "")">
        @if (!itemFinal)
        {
            <div class="watermark">
                <div>PROVISIONAL</div>
                <div class="sub">NOT FOR MEDICO-LEGAL PURPOSES</div>
            </div>
        }

        <!-- Letterhead -->
        @{ Letterhead(); }

        <!-- 3 Info Boxes -->
        @{ InfoBoxes(itemFinal); }

        <!-- Investigation Report -->
        <div class="mb-4 report-body">
            <div class="report-title-bar">
                @item.TestName @(!string.IsNullOrWhiteSpace(item.TestCode) ? $"({item.TestCode})" : "")
            </div>
            <div class="report-html-content">
                @if (!string.IsNullOrWhiteSpace(item.TemplateHtml))
                {
                    @Html.Raw(item.TemplateHtml)
                }
                else
                {
                    <p class="text-muted fst-italic">Report entry pending or empty.</p>
                }
            </div>
            @{ var docNote = DocOf(item); }
            @if (docNote is { Pages.Count: 0 } && !string.IsNullOrWhiteSpace(docNote.Note))
            {
                <div class="ext-doc-note">@docNote.Note</div>
            }
        </div>

        <div class="text-center fw-bold fs-6 my-4 end-of-report">
            *** End Of Report ***
        </div>

        <!-- Signature + page footer travel together as one unit - see .sign-off-block in @@media print -->
        <div class="sign-off-block">
        <!-- Signatory Footer (same signatories on every sheet of the test) -->
        @{ Signatures(); }

        <!-- Page Footer -->
        @{ PageFooter(pageNo); }
        </div>
    </div>

        @* SQLScripts/2391: the external document of this approved test - each page on a sheet of its own, same letterhead and footer *@
        var extDoc = DocOf(item);
        if (extDoc is { Pages.Count: > 0 })
        {
            for (var i = 0; i < extDoc.Pages.Count; i++)
            {
                pageNo++;
    <div class="report-page sheet page-break ext-doc-page">
        @{ Letterhead(); }
        @{ InfoBoxes(true); }
        <div class="ext-doc-caption">
            External report · <b>@extDoc.TestName</b>@(extDoc.Pages.Count > 1 ? $" · page {i + 1} of {extDoc.Pages.Count}" : "")
        </div>
        <div class="ext-doc-image"><img src="@ImageSrc(extDoc.Pages[i])" alt="External report - @extDoc.TestName" /></div>
        <!-- the approved test's signatories + footer, at the bottom of the sheet as on the report page -->
        <div class="sign-off-block">
            @{ Signatures(); }
            @{ PageFooter(pageNo); }
        </div>
    </div>
            }
        }
    }

    <script>
        // Every test on ONE A4 sheet with its signatures at the bottom: a report taller than the room left is scaled
        // down step by step (to ~62% at most); beyond that the sheet runs on to a second page (.flow) as before.
        (function () {
            function fitSheets() {
                document.querySelectorAll('.report-page.sheet:not(.ext-doc-page)').forEach(function (page) {
                    var body = page.querySelector('.report-body'), html = page.querySelector('.report-html-content');
                    if (!body || !html) return;
                    page.classList.remove('flow');
                    html.style.zoom = '';
                    var z = 1;
                    while (body.scrollHeight > body.clientHeight + 1 && z > 0.62) {
                        z = Math.round((z - 0.04) * 100) / 100;
                        html.style.zoom = z;
                    }
                    if (body.scrollHeight > body.clientHeight + 1) { html.style.zoom = ''; page.classList.add('flow'); }
                });
            }
            if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', fitSheets); else fitSheets();
            window.addEventListener('load', fitSheets);          // logo / signature images change the room left
            window.addEventListener('beforeprint', fitSheets);
        })();
    </script>
</body>
</html>
