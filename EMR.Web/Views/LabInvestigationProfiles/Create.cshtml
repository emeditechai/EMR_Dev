@model EMR.Web.Models.ViewModels.LabInvestigationProfileFormViewModel

@{
    ViewData["Title"] = "Add New Investigation Profile / Package";
}

<div class="container-fluid px-4 py-3">
    <!-- Breadcrumb & Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                    <li class="breadcrumb-item text-muted">Lab Master</li>
                    <li class="breadcrumb-item"><a asp-action="Index">Investigation Profile Master</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Create</li>
                </ol>
            </nav>
            <h4 class="fw-bold mb-0 text-primary">
                <i class="bi bi-plus-circle me-2"></i>Add New Investigation Profile / Package
            </h4>
        </div>
        <div>
            <a asp-action="Index" class="btn btn-outline-secondary px-3">
                <i class="bi bi-arrow-left me-1"></i> Back to List
            </a>
        </div>
    </div>

    <form asp-action="Create" method="post" id="profileForm">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="DetailsJson" id="DetailsJson" />

        <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4" role="alert"></div>

        <!-- HEADER SECTION CARD -->
        <div class="card border-0 shadow-sm rounded-3 mb-4">
            <div class="card-header bg-white py-3">
                <h6 class="card-title fw-bold mb-0 text-dark">
                    <i class="bi bi-card-heading me-2 text-primary"></i>Profile / Package Header Details
                </h6>
            </div>
            <div class="card-body p-4">
                <div class="row g-3">
                    <!-- Rule: Code is 1st Field -->
                    <div class="col-md-4">
                        <label asp-for="Profile_Code" class="form-label fw-semibold text-muted"></label>
                        <input asp-for="Profile_Code" class="form-control bg-light" disabled placeholder="Auto-generated on save (e.g. PRF0001)" />
                        <span class="form-text text-muted small">Auto-generated code upon saving.</span>
                    </div>

                    <!-- Profile Type -->
                    <div class="col-md-4">
                        <label asp-for="Profile_Type" class="form-label fw-semibold">
                            Type <span class="text-danger">*</span>
                        </label>
                        <select asp-for="Profile_Type" class="form-select" id="profileTypeSelect" asp-items="Model.ProfileTypeOptions" required>
                        </select>
                        <span asp-validation-for="Profile_Type" class="text-danger small"></span>
                    </div>

                    <!-- Profile Test Dropdown (when Profile is selected) -->
                    <div class="col-md-4" id="profileTestContainer">
                        <label asp-for="Test_ID" class="form-label fw-semibold">
                            Profile Test <span class="text-danger">*</span>
                        </label>
                        <select asp-for="Test_ID" class="form-select" id="profileTestSelect" asp-items="Model.ProfileTestOptions">
                            <option value="">-- Select Profile Test --</option>
                        </select>
                        <span asp-validation-for="Test_ID" class="text-danger small"></span>
                        <small class="text-muted d-block">Shows tests with 'Is Profile Test = Yes'.</small>
                    </div>

                    <!-- Package Name Textbox (when Package is selected) -->
                    <div class="col-md-4" id="packageNameContainer" style="display: none;">
                        <label asp-for="Profile_Name" class="form-label fw-semibold">
                            Package Name <span class="text-danger">*</span>
                        </label>
                        <input asp-for="Profile_Name" class="form-control" id="packageNameInput" placeholder="e.g. Full Body Health Checkup Package" maxlength="200" />
                        <span asp-validation-for="Profile_Name" class="text-danger small"></span>
                    </div>

                    <!-- Hidden input to store synced Profile_Name -->
                    <input type="hidden" asp-for="Profile_Name" id="hiddenProfileName" />

                    <!-- MRP -->
                    <div class="col-md-4">
                        <label asp-for="MRP" class="form-label fw-semibold"></label> <span class="text-danger">*</span>
                        <div class="input-group">
                            <span class="input-group-text">₹</span>
                            <input asp-for="MRP" class="form-control" id="MRP" type="number" step="0.01" min="0" placeholder="0.00" required />
                        </div>
                        <span asp-validation-for="MRP" class="text-danger small"></span>
                    </div>

                    <!-- Discount % (Visible only when Package is selected) -->
                    <div class="col-md-4" id="discountContainer" style="display: none;">
                        <label asp-for="Discount_Pct" class="form-label fw-semibold">Discount (%)</label>
                        <div class="input-group">
                            <input asp-for="Discount_Pct" class="form-control" id="Discount_Pct" type="number" step="0.1" min="0" max="100" placeholder="0.0" />
                            <span class="input-group-text">%</span>
                        </div>
                        <span asp-validation-for="Discount_Pct" class="text-danger small"></span>
                        <small class="text-muted d-block">Package promotional discount percentage.</small>
                    </div>

                    <!-- Effective Start Date & End Date (Visible only when Package is selected) -->
                    <div class="col-md-4" id="startDateContainer" style="display: none;">
                        <label asp-for="Effective_Start_Date" class="form-label fw-semibold">Effective Start Date</label>
                        <input asp-for="Effective_Start_Date" class="form-control" type="date" id="Effective_Start_Date" />
                        <span asp-validation-for="Effective_Start_Date" class="text-danger small"></span>
                        <small class="text-muted d-block">Package validity start date.</small>
                    </div>

                    <div class="col-md-4" id="endDateContainer" style="display: none;">
                        <label asp-for="Effective_End_Date" class="form-label fw-semibold">Effective End Date</label>
                        <input asp-for="Effective_End_Date" class="form-control" type="date" id="Effective_End_Date" />
                        <span asp-validation-for="Effective_End_Date" class="text-danger small"></span>
                        <small class="text-muted d-block">Package validity end date.</small>
                    </div>

                    <!-- Age Operator & Age -->
                    <div class="col-md-4">
                        <label asp-for="Age_Operator" class="form-label fw-semibold"></label>
                        <select asp-for="Age_Operator" class="form-select" asp-items="Model.AgeOperatorOptions">
                        </select>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="Applicable_Age" class="form-label fw-semibold"></label>
                        <input asp-for="Applicable_Age" class="form-control" type="number" min="0" max="150" placeholder="e.g. 40 or 50" />
                        <span asp-validation-for="Applicable_Age" class="text-danger small"></span>
                    </div>

                    <!-- Applicable Gender -->
                    <div class="col-md-4">
                        <label asp-for="Applicable_Gender" class="form-label fw-semibold"></label> <span class="text-danger">*</span>
                        <select asp-for="Applicable_Gender" class="form-select" asp-items="Model.GenderOptions" required>
                        </select>
                        <span asp-validation-for="Applicable_Gender" class="text-danger small"></span>
                    </div>

                    <!-- Profile TAT Hours & Print Sequence -->
                    <div class="col-md-4">
                        <label asp-for="Profile_TAT_Hours" class="form-label fw-semibold"></label>
                        <input asp-for="Profile_TAT_Hours" class="form-control" type="number" min="0" max="720" placeholder="24" />
                        <span asp-validation-for="Profile_TAT_Hours" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="Report_Print_Sequence" class="form-label fw-semibold"></label>
                        <input asp-for="Report_Print_Sequence" class="form-control" type="number" min="1" max="999" placeholder="1" />
                        <span asp-validation-for="Report_Print_Sequence" class="text-danger small"></span>
                    </div>

                    <!-- Toggles -->
                    <div class="col-md-4 d-flex align-items-center">
                        <div class="card bg-light border-0 p-3 w-100">
                            <div class="d-flex justify-content-between align-items-center mb-0">
                                <span class="fw-semibold small">NABL Accredited:</span>
                                <div class="form-check form-switch mb-0">
                                    <input asp-for="Profile_NABL_Accredited" class="form-check-input" type="checkbox" id="nablToggle" />
                                </div>
                            </div>
                            <input type="hidden" asp-for="Status" value="true" />
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- DETAIL SECTION CARD (Component Tests) -->
        <div class="card border-0 shadow-sm rounded-3 mb-4">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                <h6 class="card-title fw-bold mb-0 text-dark">
                    <i class="bi bi-list-nested me-2 text-primary"></i>Profile / Package Test Details (Components)
                </h6>
                <span class="badge bg-primary-subtle text-primary fw-normal">Add individual tests that make up this profile/package</span>
            </div>
            <div class="card-body p-4">
                <!-- Detail Row Add Controls -->
                <div class="row g-2 mb-3 align-items-end p-3 bg-light rounded border">
                    <div class="col-md-6">
                        <label class="form-label fw-semibold small text-muted">Select Component Investigation Test</label>
                        <select id="selectTestId" class="form-select select2-basic" asp-items="Model.AvailableTestOptions">
                            <option value="">-- Choose Component Test --</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-semibold small text-muted">Display Sequence</label>
                        <input id="inputSeq" type="number" class="form-control" value="1" min="1" max="999" placeholder="1" />
                    </div>
                    <div class="col-md-3">
                        <button type="button" class="btn btn-primary w-100 fw-semibold" id="btnAddDetailRow">
                            <i class="bi bi-plus-lg me-1"></i> Add Component Test
                        </button>
                    </div>
                </div>

                <!-- Grid Table -->
                <div class="table-responsive">
                    <table class="table table-bordered table-hover align-middle mb-0" id="detailsDataTable">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 80px;" class="text-center">Seq</th>
                                <th>Investigation Test Name</th>
                                <th style="width: 140px;" class="text-end">Standard MRP</th>
                                <th style="width: 80px;" class="text-center">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            <!-- Populated via JS -->
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Form Actions -->
        <div class="d-flex justify-content-end gap-2 mb-5">
            <a asp-action="Index" class="btn btn-light px-4 border">Cancel</a>
            <button type="submit" class="btn btn-primary px-4 fw-semibold shadow-sm">
                <i class="bi bi-save me-1"></i> Save Profile & Details
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        var detailRows = [];

        function toggleProfileType() {
            var type = parseInt($('#profileTypeSelect').val()) || 1;
            if (type === 1) {
                $('#profileTestContainer').show();
                $('#packageNameContainer').hide();
                $('#discountContainer').hide();
                $('#startDateContainer').hide();
                $('#endDateContainer').hide();
                $('#Discount_Pct').val(0);
                $('#Effective_Start_Date').val('');
                $('#Effective_End_Date').val('');
                var selectedText = $('#profileTestSelect option:selected').text();
                if (selectedText && $('#profileTestSelect').val()) {
                    var testName = selectedText.split(' (')[0].trim();
                    $('#hiddenProfileName').val(testName);
                }
            } else { // Package (2)
                $('#profileTestContainer').hide();
                $('#packageNameContainer').show();
                $('#discountContainer').show();
                $('#startDateContainer').show();
                $('#endDateContainer').show();
                $('#hiddenProfileName').val($('#packageNameInput').val());
            }
        }

        $(document).ready(function () {
            toggleProfileType();
            $('#profileTypeSelect').on('change', toggleProfileType);

            $('#profileTestSelect').on('change', function () {
                var $opt = $(this).find('option:selected');
                if ($(this).val()) {
                    var text = $opt.text();
                    var testName = text.split(' (')[0].trim();
                    $('#hiddenProfileName').val(testName);
                    $('#packageNameInput').val(testName);

                    // If MRP is 0 or empty, auto-fill MRP from test text
                    var mrpMatch = text.match(/[₹]([0-9,]+\.?[0-9]*)/);
                    if (mrpMatch && (parseFloat($('#MRP').val()) || 0) === 0) {
                        var mrpVal = parseFloat(mrpMatch[1].replace(/,/g, ''));
                        $('#MRP').val(mrpVal);
                    }
                }
            });

            $('#packageNameInput').on('input', function () {
                $('#hiddenProfileName').val($(this).val());
            });

            var existingJson = $('#DetailsJson').val();
            if (existingJson && existingJson !== '[]') {
                try { detailRows = JSON.parse(existingJson); } catch (e) { detailRows = []; }
            }
            renderGrid();

            $('#btnAddDetailRow').on('click', function () {
                var $sel = $('#selectTestId');
                var testId = $sel.val();
                var testText = $sel.find('option:selected').text().trim();
                var seq = parseInt($('#inputSeq').val()) || (detailRows.length + 1);

                if (!testId) { alert('Please select an investigation test.'); return; }
                var alreadyAdded = false;
                $.each(detailRows, function(i, r) { if (r.Test_ID == testId) alreadyAdded = true; });
                if (alreadyAdded) { alert('This test is already added to the profile.'); return; }

                var mrpMatch = testText.match(/[₹]([0-9,]+\.?[0-9]*)/);
                var mrpVal = mrpMatch ? parseFloat(mrpMatch[1].replace(/,/g, '')) : 0;

                detailRows.push({ Detail_ID: 0, Test_ID: parseInt(testId), Test_Name: testText, Sequence: seq, TestMRP: mrpVal });
                detailRows.sort(function(a, b) { return a.Sequence - b.Sequence; });
                renderGrid();
                $sel.val('');
                $('#inputSeq').val(detailRows.length + 1);
            });

            $(document).on('click', '.btn-delete-row', function () {
                var idx = parseInt($(this).data('index'));
                detailRows.splice(idx, 1);
                renderGrid();
            });

            $('#profileForm').on('submit', function (e) {
                var type = parseInt($('#profileTypeSelect').val()) || 1;
                if (type === 1) {
                    var testId = $('#profileTestSelect').val();
                    if (!testId) {
                        alert('Please select a Profile Test.');
                        e.preventDefault();
                        return false;
                    }
                    var selectedText = $('#profileTestSelect option:selected').text();
                    var testName = selectedText.split(' (')[0].trim();
                    $('#hiddenProfileName').val(testName);
                    $('#packageNameInput').val(testName);
                } else {
                    var pkgName = $('#packageNameInput').val().trim();
                    if (!pkgName) {
                        alert('Please enter a Package Name.');
                        e.preventDefault();
                        return false;
                    }
                    $('#hiddenProfileName').val(pkgName);
                }

                if (detailRows.length === 0) {
                    alert('Please add at least one component test detail row before saving.');
                    e.preventDefault();
                    return false;
                }
                $('#DetailsJson').val(JSON.stringify(detailRows));
                return true;
            });
        });

        function renderGrid() {
            var tbody = document.querySelector('#detailsDataTable tbody');
            tbody.innerHTML = '';
            if (detailRows.length === 0) {
                tbody.innerHTML = '<tr><td colspan="4" class="text-center text-muted py-3"><i class="bi bi-info-circle me-1"></i>No tests added yet. Use the controls above to add tests.</td></tr>';
            } else {
                detailRows.forEach(function(r, i) {
                    var mrp = parseFloat(r.TestMRP || 0).toFixed(2);
                    var safeName = r.Test_Name.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
                    var tr = '<tr>' +
                        '<td class="text-center font-monospace fw-semibold">' + r.Sequence + '</td>' +
                        '<td class="fw-semibold text-dark">' + safeName + '</td>' +
                        '<td class="text-end fw-bold">₹' + mrp + '</td>' +
                        '<td class="text-center"><button type="button" class="btn btn-sm btn-outline-danger btn-delete-row" data-index="' + i + '" title="Remove"><i class="bi bi-trash"></i></button></td>' +
                        '</tr>';
                    tbody.innerHTML += tr;
                });
            }
            $('#DetailsJson').val(JSON.stringify(detailRows));
        }
    </script>
}
