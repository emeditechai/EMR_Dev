@model EMR.Web.ApiClients.Models.LabInvestigationProfileFullDetailModel

@{
    ViewData["Title"] = "Investigation Profile Details";
}

<div class="container-fluid px-4 py-3">
    <!-- Breadcrumb & Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                    <li class="breadcrumb-item"><a asp-action="Index">Lab</a></li>
                    <li class="breadcrumb-item"><a asp-action="Index">Investigation Profile Master</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Details</li>
                </ol>
            </nav>
            <h4 class="fw-bold mb-0 text-primary">
                <i class="bi bi-info-circle me-2"></i>Investigation Profile Details
            </h4>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Edit" asp-encrypted-id="@Model.Header.Profile_ID" class="btn btn-primary px-3 shadow-sm">
                <i class="bi bi-pencil me-1"></i> Edit Profile
            </a>
            <a asp-action="Index" class="btn btn-outline-secondary px-3">
                <i class="bi bi-arrow-left me-1"></i> Back to List
            </a>
        </div>
    </div>

    <!-- Header Details Card -->
    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-header bg-white py-3 border-bottom-0 d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center gap-3">
                <span class="badge bg-primary bg-opacity-10 text-primary font-monospace fs-6 px-3 py-2 border border-primary border-opacity-25 rounded-pill">
                    @Model.Header.Profile_Code
                </span>
                <h5 class="fw-bold mb-0 text-dark">@Model.Header.Profile_Name</h5>
            </div>
            <div>
                @if (Model.Header.Status)
                {
                    <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2 rounded-pill fs-7">
                        <i class="bi bi-check-circle-fill me-1"></i>Active Status
                    </span>
                }
                else
                {
                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-3 py-2 rounded-pill fs-7">
                        <i class="bi bi-x-circle-fill me-1"></i>Inactive Status
                    </span>
                }
            </div>
        </div>

        <div class="card-body p-4">
            <div class="row g-4">
                <div class="col-md-3">
                    <div class="p-3 bg-light rounded-3">
                        <small class="text-muted text-uppercase fw-bold d-block mb-1">Profile Type</small>
                        <span class="badge bg-primary fs-7 px-3 py-1">@Model.Header.Profile_Type</span>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="p-3 bg-light rounded-3">
                        <small class="text-muted text-uppercase fw-bold d-block mb-1">MRP Price</small>
                        <span class="fw-bold text-success fs-5">₹@Model.Header.MRP.ToString("N2")</span>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="p-3 bg-light rounded-3">
                        <small class="text-muted text-uppercase fw-bold d-block mb-1">Discount (%)</small>
                        <span class="fw-bold text-primary fs-5">@Model.Header.Discount_Pct.ToString("N1")%</span>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="p-3 bg-light rounded-3">
                        <small class="text-muted text-uppercase fw-bold d-block mb-1">TAT (Hours)</small>
                        <span class="fw-semibold text-dark fs-6">@Model.Header.Profile_TAT_Hours Hours</span>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="p-3 bg-light rounded-3">
                        <small class="text-muted text-uppercase fw-bold d-block mb-1">Eligibility Criteria</small>
                        <span class="fw-semibold text-dark fs-6">
                            @if (!string.IsNullOrEmpty(Model.Header.Age_Operator) && Model.Header.Applicable_Age.HasValue)
                            {
                                @:Age @Model.Header.Age_Operator @Model.Header.Applicable_Age yrs |
                            }
                            Gender: @Model.Header.Applicable_Gender
                        </span>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="p-3 bg-light rounded-3">
                        <small class="text-muted text-uppercase fw-bold d-block mb-1">Print Sequence</small>
                        <span class="fw-semibold text-dark fs-6">Sequence #@Model.Header.Report_Print_Sequence</span>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="p-3 bg-light rounded-3">
                        <small class="text-muted text-uppercase fw-bold d-block mb-1">NABL Accreditation</small>
                        @if (Model.Header.Profile_NABL_Accredited)
                        {
                            <span class="text-success fw-semibold"><i class="bi bi-shield-check me-1"></i>Accredited</span>
                        }
                        else
                        {
                            <span class="text-secondary">Not Accredited</span>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Detail Tests List Card -->
    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-header bg-white py-3">
            <h6 class="card-title fw-bold mb-0 text-dark">
                <i class="bi bi-list-nested me-2 text-primary"></i>Tests Included in this Profile (@Model.Details.Count)
            </h6>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light fs-7 text-uppercase text-muted">
                        <tr>
                            <th class="ps-4" style="width: 80px;">Seq</th>
                            <th style="width: 120px;">Test Code</th>
                            <th>Test Name</th>
                            <th>Department</th>
                            <th>Category</th>
                            <th class="text-center">Reporting</th>
                            <th class="text-end pe-4">Individual Test MRP</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Details.Any())
                        {
                            <tr>
                                <td colspan="7" class="text-center py-4 text-muted">
                                    No test details attached to this profile.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var d in Model.Details)
                            {
                                <tr>
                                    <td class="ps-4 font-monospace fw-bold text-muted">@d.Sequence</td>
                                    <td class="font-monospace fw-semibold text-primary">@d.Test_Code</td>
                                    <td class="fw-semibold text-dark">@d.Test_Name</td>
                                    <td>@(d.DepartmentName ?? "-")</td>
                                    <td>@(d.CategoryName ?? "-")</td>
                                    <td class="text-center">
                                        <span class="badge bg-info bg-opacity-10 text-info border border-info border-opacity-25 px-2 py-1 fs-8">
                                            @d.Reporting_Type
                                        </span>
                                    </td>
                                    <td class="text-end pe-4 fw-semibold text-dark">
                                        ₹@d.TestMRP.ToString("N2")
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
