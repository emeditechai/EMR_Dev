@model EMR.Web.Models.ViewModels.LabInvestigationProfileIndexViewModel

@{
    ViewData["Title"] = "Investigation Profile Master";
}

<div class="container-fluid px-4 py-3">
    <!-- Breadcrumb & Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                    <li class="breadcrumb-item text-muted">Lab</li>
                    <li class="breadcrumb-item active" aria-current="page">Investigation Profile Master</li>
                </ol>
            </nav>
            <h4 class="fw-bold mb-0 text-primary">
                <i class="bi bi-collection-play me-2"></i>Investigation Profile & Package Master
            </h4>
        </div>
        <div>
            <a asp-action="Create" class="btn btn-primary px-3 shadow-sm">
                <i class="bi bi-plus-lg me-1"></i> Add New Profile / Package
            </a>
        </div>
    </div>

    <!-- Lab Master Common Dashboard -->
    @await Html.PartialAsync("_LabMasterDashboard", Model.Dashboard)

    <!-- Alert Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Filter Card -->
    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-body p-3">
            <form method="get" asp-action="Index" class="row g-3 align-items-center">
                <div class="col-md-3">
                    <label class="form-label small fw-semibold text-muted mb-1">Profile Type</label>
                    <select name="profileType" class="form-select form-select-sm" onchange="this.form.submit()">
                        <option value="">-- All Profile Types --</option>
                        @foreach (var opt in Model.ProfileTypeOptions)
                        {
                            <option value="@opt.Value" selected="@(opt.Value == Model.SelectedProfileType ? "selected" : null)">@opt.Text</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-semibold text-muted mb-1">Status</label>
                    <select name="status" class="form-select form-select-sm" onchange="this.form.submit()">
                        <option value="">-- All Status --</option>
                        @foreach (var opt in Model.StatusOptions)
                        {
                            <option value="@opt.Value" selected="@(opt.Selected ? "selected" : null)">@opt.Text</option>
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label small fw-semibold text-muted mb-1">Search</label>
                    <div class="input-group input-group-sm">
                        <input type="text" name="search" class="form-control" placeholder="Search profile name/code..." value="@Model.SearchTerm" />
                        <button type="submit" class="btn btn-outline-secondary">
                            <i class="bi bi-search"></i>
                        </button>
                    </div>
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <a asp-action="Index" class="btn btn-sm btn-outline-secondary w-100" title="Reset Filters">
                        <i class="bi bi-arrow-counterclockwise"></i> Reset
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- Data Table Card -->
    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
            <h6 class="card-title fw-bold mb-0 text-dark">
                <i class="bi bi-list-stars me-2 text-primary"></i>Profile / Package List
                <span class="badge bg-primary bg-opacity-10 text-primary ms-2 fs-7 rounded-pill">@Model.Profiles.Count</span>
            </h6>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light fs-7 text-uppercase text-muted">
                        <tr>
                            <th class="ps-4" style="width: 110px;">Code</th>
                            <th>Profile / Package Name</th>
                            <th class="text-center">Type</th>
                            <th class="text-center">Tests Included</th>
                            <th class="text-end">MRP (₹)</th>
                            <th class="text-end">Discount</th>
                            <th class="text-center">Eligibility</th>
                            <th class="text-center">Status</th>
                            <th class="text-end pe-4" style="width: 140px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Profiles.Any())
                        {
                            <tr>
                                <td colspan="9" class="text-center py-5 text-muted">
                                    <i class="bi bi-folder-x fs-1 d-block mb-2 text-secondary"></i>
                                    No Investigation Profile / Package records found.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model.Profiles)
                            {
                                <tr>
                                    <td class="ps-4 fw-semibold text-primary font-monospace fs-7">
                                        @item.Profile_Code
                                    </td>
                                    <td>
                                        <span class="fw-semibold text-dark">@item.Profile_Name</span>
                                        <div class="small text-muted">Seq: @item.Report_Print_Sequence | TAT: @item.Profile_TAT_Hours hrs</div>
                                    </td>
                                    <td class="text-center">
                                        @if (item.Profile_Type == "Package")
                                        {
                                            <span class="badge bg-purple bg-opacity-10 text-purple border border-purple border-opacity-25 px-2 py-1 fs-7" style="color: #6f42c1; background-color: #f3ebf9; border-color: #d6bbf2;">
                                                <i class="bi bi-box-seam me-1"></i>Package
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 px-2 py-1 fs-7">
                                                <i class="bi bi-layers me-1"></i>Profile
                                            </span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <span class="badge bg-dark bg-opacity-10 text-dark border border-secondary border-opacity-25 px-3 py-1 rounded-pill fw-bold">
                                            @item.TestCount Tests
                                        </span>
                                    </td>
                                    <td class="text-end fw-bold text-dark">
                                        ₹@item.MRP.ToString("N2")
                                    </td>
                                    <td class="text-end text-success fw-semibold">
                                        @item.Discount_Pct.ToString("N1")%
                                    </td>
                                    <td class="text-center small">
                                        @if (!string.IsNullOrEmpty(item.Age_Operator) && item.Applicable_Age.HasValue)
                                        {
                                            <span class="badge bg-light text-dark border me-1">Age @item.Age_Operator @item.Applicable_Age yrs</span>
                                        }
                                        <span class="badge bg-light text-dark border">@item.Applicable_Gender</span>
                                    </td>
                                    <td class="text-center">
                                        <form asp-action="ToggleStatus" asp-encrypted-id="@item.Profile_ID" method="post" class="d-inline">
                                            <input type="hidden" name="status" value="@((!item.Status).ToString().ToLower())" />
                                            <button type="submit" class="btn btn-link p-0 text-decoration-none" title="Click to toggle status">
                                                @if (item.Status)
                                                {
                                                    <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-1 rounded-pill">
                                                        <i class="bi bi-check-circle-fill me-1"></i>Active
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-3 py-1 rounded-pill">
                                                        <i class="bi bi-x-circle-fill me-1"></i>Inactive
                                                    </span>
                                                }
                                            </button>
                                        </form>
                                    </td>
                                    <td class="text-end pe-4">
                                        <div class="btn-group btn-group-sm shadow-sm" role="group">
                                            <a asp-action="Details" asp-encrypted-id="@item.Profile_ID" class="btn btn-outline-info" title="View Header & Details">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            <a asp-action="Edit" asp-encrypted-id="@item.Profile_ID" class="btn btn-outline-primary" title="Edit Profile">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteModal-@item.Profile_ID" title="Delete">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </div>

                                        <!-- Delete Confirmation Modal -->
                                        <div class="modal fade" id="deleteModal-@item.Profile_ID" tabindex="-1" aria-hidden="true">
                                            <div class="modal-dialog modal-dialog-centered">
                                                <div class="modal-content text-start">
                                                    <div class="modal-header border-0">
                                                        <h5 class="modal-header-title text-danger fw-bold">
                                                            <i class="bi bi-exclamation-triangle-fill me-2"></i>Confirm Deletion
                                                        </h5>
                                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                    </div>
                                                    <div class="modal-body">
                                                        Are you sure you want to delete Profile <strong>@item.Profile_Name</strong> (<code>@item.Profile_Code</code>)?
                                                    </div>
                                                    <div class="modal-footer border-0">
                                                        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                                                        <form asp-action="Delete" asp-encrypted-id="@item.Profile_ID" method="post">
                                                            <button type="submit" class="btn btn-danger">Delete</button>
                                                        </form>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
