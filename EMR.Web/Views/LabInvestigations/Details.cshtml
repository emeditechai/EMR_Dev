@model EMR.Web.ApiClients.Models.LabInvestigationModel

@{
    ViewData["Title"] = "Investigation Master Details";
}

<div class="container-fluid px-4 py-3">
    <!-- Breadcrumb & Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                    <li class="breadcrumb-item"><a asp-action="Index">Lab</a></li>
                    <li class="breadcrumb-item"><a asp-action="Index">Investigation Master</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Details</li>
                </ol>
            </nav>
            <h4 class="fw-bold mb-0 text-primary">
                <i class="bi bi-info-circle me-2"></i>Investigation Master Details
            </h4>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Edit" asp-encrypted-id="@Model.Test_ID" class="btn btn-primary px-3 shadow-sm">
                <i class="bi bi-pencil me-1"></i> Edit Record
            </a>
            <a asp-action="Index" class="btn btn-outline-secondary px-3">
                <i class="bi bi-arrow-left me-1"></i> Back to List
            </a>
        </div>
    </div>

    <!-- Details Card -->
    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-header bg-white py-3 border-bottom-0 d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center gap-3">
                <span class="badge bg-primary bg-opacity-10 text-primary font-monospace fs-6 px-3 py-2 border border-primary border-opacity-25 rounded-pill">
                    @Model.Test_Code
                </span>
                <h5 class="fw-bold mb-0 text-dark">@Model.Test_Name</h5>
            </div>
            <div>
                @if (Model.Status)
                {
                    <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2 rounded-pill fs-7">
                        <i class="bi bi-check-circle-fill me-1"></i>Active Status
                    </span>
                }
                else
                {
                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-3 py-2 rounded-pill fs-7">
                        <i class="bi bi-x-circle-fill me-1"></i>Inactive Status
                    </span>
                }
            </div>
        </div>

        <div class="card-body p-4">
            <div class="row g-4">
                <div class="col-md-4">
                    <div class="p-3 bg-light rounded-3">
                        <small class="text-muted text-uppercase fw-bold d-block mb-1">Department</small>
                        <span class="fw-semibold text-dark fs-6">@Model.Department_Name</span>
                        <span class="badge bg-secondary ms-1">@Model.Department_Code</span>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="p-3 bg-light rounded-3">
                        <small class="text-muted text-uppercase fw-bold d-block mb-1">Test Category</small>
                        <span class="fw-semibold text-dark fs-6">@Model.Category_Name</span>
                        <span class="badge bg-info ms-1">@Model.Category_Code</span>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="p-3 bg-light rounded-3">
                        <small class="text-muted text-uppercase fw-bold d-block mb-1">Test Sub-Category</small>
                        <span class="fw-semibold text-dark fs-6">@(Model.SubCategory_Name ?? "-")</span>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="p-3 bg-light rounded-3">
                        <small class="text-muted text-uppercase fw-bold d-block mb-1">Sample Type</small>
                        <span class="fw-semibold text-dark fs-6">@(Model.Sample_Type_Name ?? "-")</span>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="p-3 bg-light rounded-3">
                        <small class="text-muted text-uppercase fw-bold d-block mb-1">Test Method</small>
                        <span class="fw-semibold text-dark fs-6">@(Model.Method_Name ?? "-")</span>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="p-3 bg-light rounded-3">
                        <small class="text-muted text-uppercase fw-bold d-block mb-1">Unit of Measurement</small>
                        <span class="fw-semibold text-dark fs-6">@(Model.Unit_Name ?? "-")</span>
                        @if (!string.IsNullOrEmpty(Model.Unit_Symbol))
                        {
                            <span class="badge bg-dark bg-opacity-10 text-dark ms-1 font-monospace">@Model.Unit_Symbol</span>
                        }
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="p-3 bg-light rounded-3">
                        <small class="text-muted text-uppercase fw-bold d-block mb-1">Reporting Type</small>
                        <span class="badge bg-primary fs-7 px-3 py-1">@Model.Reporting_Type</span>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="p-3 bg-light rounded-3">
                        <small class="text-muted text-uppercase fw-bold d-block mb-1">Turn-Around-Time (TAT)</small>
                        <span class="fw-semibold text-dark fs-6">@(Model.TAT_Hours ?? 24) Hours</span>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="p-3 bg-light rounded-3">
                        <small class="text-muted text-uppercase fw-bold d-block mb-1">MRP Price</small>
                        <span class="fw-bold text-success fs-5">₹@Model.MRP.ToString("N2")</span>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="p-3 bg-light rounded-3">
                        <small class="text-muted text-uppercase fw-bold d-block mb-1">Is Outsourced</small>
                        <span class="fw-semibold text-dark fs-6">@(Model.Is_Outsourced ? "Yes (Outsourced Test)" : "No (In-House Test)")</span>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="p-3 bg-light rounded-3">
                        <small class="text-muted text-uppercase fw-bold d-block mb-1">Is Profile Test</small>
                        <span class="fw-semibold text-dark fs-6">@(Model.IsProfileTest ? "Yes" : "No")</span>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="p-3 bg-light rounded-3">
                        <small class="text-muted text-uppercase fw-bold d-block mb-1">Applicable Gender</small>
                        <span class="fw-semibold text-dark fs-6">@Model.Applicable_Gender</span>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="p-3 bg-light rounded-3">
                        <small class="text-muted text-uppercase fw-bold d-block mb-1">Is Billable</small>
                        <span class="fw-semibold text-dark fs-6">@(Model.Is_Billable ? "Yes" : "No")</span>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="p-3 bg-light rounded-3">
                        <small class="text-muted text-uppercase fw-bold d-block mb-1">Applicable Age</small>
                        <span class="fw-semibold text-dark fs-6">
                            @if (!string.IsNullOrEmpty(Model.Age_Operator) && Model.Applicable_Age.HasValue)
                            {
                                @($"{Model.Age_Operator} {Model.Applicable_Age} Yrs")
                            }
                            else if (Model.Applicable_Age.HasValue)
                            {
                                @($"{Model.Applicable_Age} Yrs")
                            }
                            else
                            {
                                @("All Ages")
                            }
                        </span>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="p-3 bg-light rounded-3">
                        <small class="text-muted text-uppercase fw-bold d-block mb-1">Fasting Required</small>
                        <span class="fw-semibold text-dark fs-6">@(Model.Is_Fasting_Required ? "Yes (Fasting Mandatory)" : "No")</span>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="p-3 bg-light rounded-3">
                        <small class="text-muted text-uppercase fw-bold d-block mb-1">Consent Required</small>
                        <span class="fw-semibold text-dark fs-6">@(Model.Is_Consent_Required ? "Yes (Consent Required)" : "No")</span>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="p-3 bg-light rounded-3">
                        <small class="text-muted text-uppercase fw-bold d-block mb-1">Sample Quantity</small>
                        <span class="fw-semibold text-dark fs-6">
                            @if (Model.Sample_Quantity.HasValue)
                            {
                                @($"{Model.Sample_Quantity:G29} {(Model.Sample_Quantity_Unit_Symbol ?? Model.Sample_Quantity_Unit_Name ?? "")}")
                            }
                            else
                            {
                                @("-")
                            }
                        </span>
                    </div>
                </div>

                <div class="col-md-5">
                    <div class="p-3 bg-light rounded-3">
                        <small class="text-muted text-uppercase fw-bold d-block mb-1">Reported On / Duration</small>
                        <span class="fw-semibold text-dark fs-6">
                            @if (Model.Reported_Duration_Value.HasValue)
                            {
                                @($"{Model.Reported_Duration_Value} {(Model.Reported_Duration_Unit ?? "Days")}")
                            }
                            else
                            {
                                @("-")
                            }
                        </span>
                    </div>
                </div>

                <div class="col-md-12">
                    <div class="p-3 bg-light rounded-3">
                        <small class="text-muted text-uppercase fw-bold d-block mb-1">NABL Accreditation Details</small>
                        @if (Model.NABL_Accredited)
                        {
                            <div class="text-success fw-semibold">
                                <i class="bi bi-shield-check me-1"></i> NABL Accredited Test
                            </div>
                            @if (!string.IsNullOrEmpty(Model.NABL_Scope_No))
                            {
                                <small class="text-muted">Scope Reference No: <code class="fw-bold">@Model.NABL_Scope_No</code></small>
                            }
                        }
                        else
                        {
                            <span class="text-secondary">Not NABL Accredited</span>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
