@model EMR.Web.Models.ViewModels.LabInvestigationIndexViewModel

@{
    ViewData["Title"] = "Investigation Master";
}

<div class="container-fluid px-4 py-3">
    <!-- Breadcrumb & Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                    <li class="breadcrumb-item text-muted">Lab</li>
                    <li class="breadcrumb-item active" aria-current="page">Investigation Master</li>
                </ol>
            </nav>
            <h4 class="fw-bold mb-0 text-primary">
                <i class="bi bi-journal-medical me-2"></i>Investigation Master
            </h4>
        </div>
        <div>
            <a asp-action="Create" class="btn btn-primary px-3 shadow-sm">
                <i class="bi bi-plus-lg me-1"></i> Add New Investigation
            </a>
        </div>
    </div>

    <!-- Lab Master Common Dashboard -->
    @await Html.PartialAsync("_LabMasterDashboard", Model.Dashboard)

    <!-- Alert Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Filter Card -->
    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-body p-3">
            <form method="get" asp-action="Index" class="row g-3 align-items-center">
                <div class="col-md-3">
                    <label class="form-label small fw-semibold text-muted mb-1">Department</label>
                    <select name="departmentId" class="form-select form-select-sm" onchange="this.form.submit()">
                        <option value="">-- All Lab Departments --</option>
                        @foreach (var opt in Model.DepartmentOptions)
                        {
                            <option value="@opt.Value" selected="@(opt.Value == Model.SelectedDepartmentId?.ToString() ? "selected" : null)">@opt.Text</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-semibold text-muted mb-1">Test Category</label>
                    <select name="categoryId" class="form-select form-select-sm" onchange="this.form.submit()">
                        <option value="">-- All Categories --</option>
                        @foreach (var opt in Model.CategoryOptions)
                        {
                            <option value="@opt.Value" selected="@(opt.Value == Model.SelectedCategoryId?.ToString() ? "selected" : null)">@opt.Text</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label small fw-semibold text-muted mb-1">Status</label>
                    <select name="status" class="form-select form-select-sm" onchange="this.form.submit()">
                        <option value="">-- All Status --</option>
                        @foreach (var opt in Model.StatusOptions)
                        {
                            <option value="@opt.Value" selected="@(opt.Selected ? "selected" : null)">@opt.Text</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-semibold text-muted mb-1">Search</label>
                    <div class="input-group input-group-sm">
                        <input type="text" name="search" class="form-control" placeholder="Search test name/code..." value="@Model.SearchTerm" />
                        <button type="submit" class="btn btn-outline-secondary">
                            <i class="bi bi-search"></i>
                        </button>
                    </div>
                </div>
                <div class="col-md-1 d-flex align-items-end">
                    <a asp-action="Index" class="btn btn-sm btn-outline-secondary w-100" title="Reset Filters">
                        <i class="bi bi-arrow-counterclockwise"></i> Reset
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- Data Table Card -->
    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
            <h6 class="card-title fw-bold mb-0 text-dark">
                <i class="bi bi-list-task me-2 text-primary"></i>Investigation List
                <span class="badge bg-primary bg-opacity-10 text-primary ms-2 fs-7 rounded-pill">@Model.Investigations.Count</span>
            </h6>
        </div>
        <div class="card-body p-0">
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 px-3 py-2 border-bottom bg-white" id="paginationControlsTop">
                <div class="d-flex align-items-center gap-2">
                    <label class="text-muted small mb-0">Show</label>
                    <select id="pageSizeTop" class="form-select form-select-sm" style="width:auto;">
                        <option value="10" selected>10</option>
                        <option value="25">25</option>
                        <option value="50">50</option>
                        <option value="100">100</option>
                    </select>
                    <span class="text-muted small mb-0">entries</span>
                </div>
                <div class="text-muted small" id="pageInfoTop"></div>
                <div class="d-flex align-items-center gap-2">
                    <nav>
                        <ul class="pagination pagination-sm mb-0" id="pageNavTop"></ul>
                    </nav>
                    <div class="d-flex align-items-center gap-1">
                        <label class="text-muted small mb-0 text-nowrap">Go to</label>
                        <input type="number" id="goToPageTop" class="form-control form-control-sm" style="width:60px;" min="1" />
                        <button class="btn btn-outline-primary btn-sm goToPageBtn" data-target="goToPageTop">Go</button>
                    </div>
                </div>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light fs-7 text-uppercase text-muted">
                        <tr>
                            <th class="ps-4" style="width: 110px;">Test Code</th>
                            <th>Test Name</th>
                            <th>Category / Sub-Category</th>
                            <th>Sample / Method</th>
                            <th class="text-center">Reporting</th>
                            <th class="text-end">MRP (₹)</th>
                            <th class="text-center">NABL</th>
                            <th class="text-center">Status</th>
                            <th class="text-end pe-4" style="width: 140px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Investigations.Any())
                        {
                            <tr>
                                <td colspan="9" class="text-center py-5 text-muted">
                                    <i class="bi bi-journal-x fs-1 d-block mb-2 text-secondary"></i>
                                    No Lab Investigation records found.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model.Investigations)
                            {
                                <tr>
                                    <td class="ps-4 fw-semibold text-primary font-monospace fs-7">
                                        @item.Test_Code
                                    </td>
                                    <td>
                                        <span class="fw-semibold text-dark">@item.Test_Name</span>
                                        @if (item.IsProfileTest)
                                        {
                                            <span class="badge bg-info bg-opacity-10 text-info border border-info ms-1 fs-8">Profile Test</span>
                                        }
                                        @if (item.Is_Outsourced)
                                        {
                                            <span class="badge bg-warning bg-opacity-10 text-dark border border-warning ms-1 fs-8">Outsourced</span>
                                        }
                                        @if (!item.Is_Billable)
                                        {
                                            <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary ms-1 fs-8">Non-Billable</span>
                                        }
                                        @if (item.Is_Fasting_Required)
                                        {
                                            <span class="badge bg-danger bg-opacity-10 text-danger border border-danger ms-1 fs-8">Fasting Req.</span>
                                        }
                                        @if (item.Is_Consent_Required)
                                        {
                                            <span class="badge bg-warning bg-opacity-10 text-dark border border-warning ms-1 fs-8">Consent Req.</span>
                                        }
                                        @if (item.Is_OPD_Document_Required)
                                        {
                                            <span class="badge bg-info bg-opacity-10 text-info border border-info ms-1 fs-8">OPD Doc Req.</span>
                                        }
                                        @if (item.Prescription_Required)
                                        {
                                            <span class="badge bg-primary bg-opacity-10 text-primary border border-primary ms-1 fs-8">Rx Req.</span>
                                        }
                                        <div class="small text-muted">
                                            TAT: @(item.TAT_Hours ?? 24) hrs | Gender: @item.Applicable_Gender
                                        </div>
                                    </td>
                                    <td>
                                        <div class="fw-semibold">@item.Category_Name</div>
                                        <small class="text-muted">@(item.SubCategory_Name ?? "-")</small>
                                    </td>
                                    <td>
                                        <div class="fw-semibold">@(item.Sample_Type_Name ?? "-")</div>
                                        <small class="text-muted">@(item.Method_Name ?? "-")</small>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge bg-info bg-opacity-10 text-info border border-info border-opacity-25 px-2 py-1 fs-7">
                                            @item.Reporting_Type
                                        </span>
                                        @if (!string.IsNullOrEmpty(item.Unit_Symbol))
                                        {
                                            <div class="small text-muted font-monospace">(@item.Unit_Symbol)</div>
                                        }
                                    </td>
                                    <td class="text-end fw-bold text-dark">
                                        ₹@item.MRP.ToString("N2")
                                    </td>
                                    <td class="text-center">
                                        @if (item.NABL_Accredited)
                                        {
                                            <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-2 py-1 fs-8" title="Scope: @item.NABL_Scope_No">
                                                <i class="bi bi-shield-check me-1"></i>Yes
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary border-opacity-25 px-2 py-1 fs-8">
                                                No
                                            </span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <form asp-action="ToggleStatus" asp-encrypted-id="@item.Test_ID" method="post" class="d-inline">
                                            <input type="hidden" name="status" value="@((!item.Status).ToString().ToLower())" />
                                            <button type="submit" class="btn btn-link p-0 text-decoration-none" title="Click to toggle status">
                                                @if (item.Status)
                                                {
                                                    <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-1 rounded-pill">
                                                        <i class="bi bi-check-circle-fill me-1"></i>Active
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-3 py-1 rounded-pill">
                                                        <i class="bi bi-x-circle-fill me-1"></i>Inactive
                                                    </span>
                                                }
                                            </button>
                                        </form>
                                    </td>
                                    <td class="text-end pe-4">
                                        <div class="btn-group btn-group-sm shadow-sm" role="group">
                                            <a asp-action="Details" asp-encrypted-id="@item.Test_ID" class="btn btn-outline-info" title="View Details">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            <a asp-action="Edit" asp-encrypted-id="@item.Test_ID" class="btn btn-outline-primary" title="Edit Investigation">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteModal-@item.Test_ID" title="Delete">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </div>

                                        <!-- Delete Confirmation Modal -->
                                        <div class="modal fade" id="deleteModal-@item.Test_ID" tabindex="-1" aria-hidden="true">
                                            <div class="modal-dialog modal-dialog-centered">
                                                <div class="modal-content text-start">
                                                    <div class="modal-header border-0">
                                                        <h5 class="modal-header-title text-danger fw-bold">
                                                            <i class="bi bi-exclamation-triangle-fill me-2"></i>Confirm Deletion
                                                        </h5>
                                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                    </div>
                                                    <div class="modal-body">
                                                        Are you sure you want to delete Investigation <strong>@item.Test_Name</strong> (<code>@item.Test_Code</code>)?
                                                    </div>
                                                    <div class="modal-footer border-0">
                                                        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                                                        <form asp-action="Delete" asp-encrypted-id="@item.Test_ID" method="post">
                                                            <button type="submit" class="btn btn-danger">Delete</button>
                                                        </form>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 px-3 py-3 border-top bg-white" id="paginationControls">
                <div class="d-flex align-items-center gap-2">
                    <label class="text-muted small mb-0">Show</label>
                    <select id="pageSize" class="form-select form-select-sm" style="width:auto;">
                        <option value="10" selected>10</option>
                        <option value="25">25</option>
                        <option value="50">50</option>
                        <option value="100">100</option>
                    </select>
                    <span class="text-muted small mb-0">entries</span>
                </div>
                <div class="text-muted small" id="pageInfo"></div>
                <div class="d-flex align-items-center gap-2">
                    <nav>
                        <ul class="pagination pagination-sm mb-0" id="pageNav"></ul>
                    </nav>
                    <div class="d-flex align-items-center gap-1">
                        <label class="text-muted small mb-0 text-nowrap">Go to</label>
                        <input type="number" id="goToPage" class="form-control form-control-sm" style="width:60px;" min="1" />
                        <button class="btn btn-outline-primary btn-sm goToPageBtn" data-target="goToPage">Go</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            var rows = $('table.table tbody tr').not(':has(td[colspan])');
            var pageSize = 10;
            var currentPage = 1;

            function renderNav(navEl, totalPages) {
                navEl.empty();
                navEl.append('<li class="page-item ' + (currentPage === 1 ? 'disabled' : '') + '"><a class="page-link" href="#" data-page="first" title="First Page">&laquo;&laquo;</a></li>');
                navEl.append('<li class="page-item ' + (currentPage === 1 ? 'disabled' : '') + '"><a class="page-link" href="#" data-page="prev" title="Previous Page">&laquo;</a></li>');
                var startPage = Math.max(1, currentPage - 2);
                var endPage = Math.min(totalPages, startPage + 4);
                if (endPage - startPage < 4) startPage = Math.max(1, endPage - 4);
                for (var i = startPage; i <= endPage; i++) {
                    navEl.append('<li class="page-item ' + (i === currentPage ? 'active' : '') + '"><a class="page-link" href="#" data-page="' + i + '">' + i + '</a></li>');
                }
                navEl.append('<li class="page-item ' + (currentPage === totalPages ? 'disabled' : '') + '"><a class="page-link" href="#" data-page="next" title="Next Page">&raquo;</a></li>');
                navEl.append('<li class="page-item ' + (currentPage === totalPages ? 'disabled' : '') + '"><a class="page-link" href="#" data-page="last" title="Last Page">&raquo;&raquo;</a></li>');
            }

            function paginate() {
                var total = rows.length;
                var totalPages = Math.max(1, Math.ceil(total / pageSize));
                if (currentPage > totalPages) currentPage = totalPages;
                rows.hide();
                rows.slice((currentPage - 1) * pageSize, currentPage * pageSize).show();
                var start = total === 0 ? 0 : (currentPage - 1) * pageSize + 1;
                var end = Math.min(currentPage * pageSize, total);
                var infoText = 'Showing ' + start + ' to ' + end + ' of ' + total + ' entries (Page ' + currentPage + ' of ' + totalPages + ')';
                $('#pageInfo, #pageInfoTop').text(infoText);
                $('#pageSize, #pageSizeTop').val(pageSize);
                $('#goToPage, #goToPageTop').attr('max', totalPages).attr('placeholder', currentPage);
                renderNav($('#pageNav'), totalPages);
                renderNav($('#pageNavTop'), totalPages);
            }

            $('#pageSize, #pageSizeTop').on('change', function () {
                pageSize = parseInt($(this).val());
                $('#pageSize, #pageSizeTop').val(pageSize);
                currentPage = 1;
                paginate();
            });

            $('#pageNav, #pageNavTop').on('click', 'a.page-link', function (e) {
                e.preventDefault();
                var p = $(this).data('page');
                var totalPages = Math.max(1, Math.ceil(rows.length / pageSize));
                if (p === 'first') { currentPage = 1; }
                else if (p === 'prev') { if (currentPage > 1) currentPage--; }
                else if (p === 'next') { if (currentPage < totalPages) currentPage++; }
                else if (p === 'last') { currentPage = totalPages; }
                else { currentPage = parseInt(p); }
                paginate();
            });

            $('.goToPageBtn').on('click', function () {
                var input = $('#' + $(this).data('target'));
                var page = parseInt(input.val());
                var totalPages = Math.max(1, Math.ceil(rows.length / pageSize));
                if (!isNaN(page) && page >= 1 && page <= totalPages) {
                    currentPage = page;
                    paginate();
                } else {
                    alert('Please enter a valid page number (1 - ' + totalPages + ')');
                }
                input.val('');
            });

            $('#goToPage, #goToPageTop').on('keypress', function (e) {
                if (e.which === 13) {
                    e.preventDefault();
                    $(this).siblings('.goToPageBtn').click();
                }
            });

            paginate();
        });
    </script>
}
