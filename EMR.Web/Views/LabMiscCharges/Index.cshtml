@model EMR.Web.Models.ViewModels.LabMiscChargeIndexViewModel

@{
    ViewData["Title"] = "Misc Charges Master";
}

<div class="container-fluid px-4 py-3">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                    <li class="breadcrumb-item text-muted">Lab Master</li>
                    <li class="breadcrumb-item active" aria-current="page">Misc Charges Master</li>
                </ol>
            </nav>
            <h4 class="fw-bold mb-0 text-primary">
                <i class="bi bi-cash-coin me-2"></i>Misc Charges Master
            </h4>
            <div class="text-muted small">Home Collection and other charges billed along with investigations</div>
        </div>
        <div>
            <a asp-permission="MASTER.LABMISCCHARGES:ADD" asp-action="Create" class="btn btn-primary px-3 shadow-sm">
                <i class="bi bi-plus-lg me-1"></i> Add New Misc Charge
            </a>
        </div>
    </div>

    @await Html.PartialAsync("_LabMasterDashboard", Model.Dashboard)

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-3">
            <form method="get" asp-action="Index" class="row g-3 align-items-end">
                <div class="col-md-3">
                    <label class="form-label small fw-semibold text-muted">Charge Type</label>
                    <select name="chargeType" class="form-select" asp-items="Model.ChargeTypeOptions">
                        <option value="">-- All Types --</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-semibold text-muted">Status</label>
                    <select name="status" class="form-select" asp-items="Model.StatusOptions">
                        <option value="">-- All Statuses --</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label small fw-semibold text-muted">Search</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
                        <input type="text" name="search" class="form-control border-start-0" value="@Model.SearchTerm" placeholder="Charge name or description..." />
                    </div>
                </div>
                <div class="col-md-2 d-flex gap-2">
                    <button type="submit" class="btn btn-secondary w-100 fw-semibold">
                        <i class="bi bi-funnel me-1"></i> Filter
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary" title="Reset Filters">
                        <i class="bi bi-arrow-counterclockwise"></i>
                    </a>
                </div>
            </form>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light border-bottom">
                        <tr>
                            <th class="ps-4" style="width:70px;">ID</th>
                            <th>Charge Name</th>
                            <th style="width:150px;">Charge Type</th>
                            <th class="text-end" style="width:130px;">Amount</th>
                            <th class="text-center" style="width:120px;">Discountable</th>
                            <th class="text-center" style="width:120px;">GST</th>
                            <th class="text-center" style="width:90px;">Order</th>
                            <th class="text-center" style="width:120px;">Status</th>
                            <th class="text-end pe-4" style="width:160px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Charges.Any())
                        {
                            <tr>
                                <td colspan="9" class="text-center py-5 text-muted">
                                    <i class="bi bi-inbox display-6 d-block mb-2 text-secondary"></i>
                                    No misc charges found matching your search criteria.
                                </td>
                            </tr>
                        }
                        @foreach (var item in Model.Charges)
                        {
                            <tr>
                                <td class="ps-4 fw-semibold text-muted">#@item.Misc_Charge_ID</td>
                                <td>
                                    <div class="fw-bold text-dark">@item.Charge_Name</div>
                                    @if (!string.IsNullOrEmpty(item.Description))
                                    {
                                        <div class="text-muted small text-truncate" style="max-width:360px;" title="@item.Description">@item.Description</div>
                                    }
                                </td>
                                <td>
                                    @if (item.Charge_Type == EMR.Web.Models.ViewModels.LabMiscChargeTypes.HomeCollection)
                                    {
                                        <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle px-2 py-1"><i class="bi bi-house-heart me-1"></i>Home Collection</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary-emphasis border border-secondary-subtle px-2 py-1"><i class="bi bi-box-seam me-1"></i>Misc</span>
                                    }
                                </td>
                                <td class="text-end fw-semibold font-monospace">₹@item.Amount.ToString("N2")</td>
                                <td class="text-center">
                                    @if (item.Is_Discountable) { <span class="badge bg-success-subtle text-success border border-success-subtle">Yes</span> }
                                    else { <span class="badge bg-light text-muted border">No</span> }
                                </td>
                                <td class="text-center">
                                    @if (item.Is_GST_Required) { <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle">@item.GST_Percentage?.ToString("0.##")%</span> }
                                    else { <span class="badge bg-light text-muted border">No</span> }
                                </td>
                                <td class="text-center"><span class="badge bg-secondary rounded-pill px-3">@item.Display_Order</span></td>
                                <td class="text-center">
                                    <form asp-permission="MASTER.LABMISCCHARGES:STATUS" asp-action="ToggleStatus" asp-encrypted-id="@item.Misc_Charge_ID" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="status" value="@(!item.Status ? "true" : "false")" />
                                        <button type="submit" class="btn btn-link p-0 text-decoration-none" title="Click to toggle status">
                                            @if (item.Status)
                                            {
                                                <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-1 rounded-pill"><i class="bi bi-check-circle-fill me-1"></i>Active</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-3 py-1 rounded-pill"><i class="bi bi-x-circle-fill me-1"></i>Inactive</span>
                                            }
                                        </button>
                                    </form>
                                </td>
                                <td class="text-end pe-4">
                                    <div class="btn-group btn-group-sm shadow-sm" role="group">
                                        <a asp-permission="MASTER.LABMISCCHARGES:DETAILS" asp-action="Details" asp-encrypted-id="@item.Misc_Charge_ID" class="btn btn-outline-info" title="View Details"><i class="bi bi-eye"></i></a>
                                        <a asp-permission="MASTER.LABMISCCHARGES:EDIT" asp-action="Edit" asp-encrypted-id="@item.Misc_Charge_ID" class="btn btn-outline-primary" title="Edit"><i class="bi bi-pencil"></i></a>
                                        <button asp-permission="MASTER.LABMISCCHARGES:DELETE" type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteModal-@item.Misc_Charge_ID" title="Delete"><i class="bi bi-trash"></i></button>
                                    </div>

                                    <div class="modal fade text-start" id="deleteModal-@item.Misc_Charge_ID" tabindex="-1" aria-hidden="true">
                                        <div class="modal-dialog modal-dialog-centered">
                                            <div class="modal-content">
                                                <div class="modal-header bg-danger text-white">
                                                    <h5 class="modal-title"><i class="bi bi-exclamation-triangle-fill me-2"></i>Confirm Delete</h5>
                                                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                                                </div>
                                                <div class="modal-body">
                                                    Delete the misc charge <strong>@item.Charge_Name</strong> (@item.Charge_Type, ₹@item.Amount.ToString("N2"))?
                                                    <p class="mt-2 text-muted small mb-0">It will no longer be offered on new bills. Bills that already used it are not changed.</p>
                                                </div>
                                                <div class="modal-footer">
                                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                                    <form asp-permission="MASTER.LABMISCCHARGES:DELETE" asp-action="Delete" asp-encrypted-id="@item.Misc_Charge_ID" method="post">
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit" class="btn btn-danger">Delete Misc Charge</button>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
