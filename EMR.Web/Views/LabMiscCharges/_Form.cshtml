@model EMR.Web.Models.ViewModels.LabMiscChargeFormViewModel
@* Shared by Create / Edit. GST % is shown (and required) only when GST is applicable; the server checks it again. *@
<div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4" role="alert"></div>

<div class="row g-3">
    <div class="col-md-8">
        <label asp-for="Charge_Name" class="form-label fw-semibold required-field"></label>
        <input asp-for="Charge_Name" class="form-control" maxlength="150" placeholder="e.g. Home Collection - Within City, Vacutainer Container" autocomplete="off" />
        <span asp-validation-for="Charge_Name" class="text-danger small"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="Charge_Type" class="form-label fw-semibold required-field"></label>
        <select asp-for="Charge_Type" class="form-select" asp-items="Model.ChargeTypeOptions"></select>
        <span asp-validation-for="Charge_Type" class="text-danger small"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="Amount" class="form-label fw-semibold required-field"></label>
        <div class="input-group">
            <span class="input-group-text">₹</span>
            <input asp-for="Amount" type="number" step="0.01" min="0" max="99999999.99" class="form-control" placeholder="0.00" />
        </div>
        <span asp-validation-for="Amount" class="text-danger small"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="Display_Order" class="form-label fw-semibold required-field"></label>
        <input asp-for="Display_Order" type="number" class="form-control" min="1" max="99999" />
        <span asp-validation-for="Display_Order" class="text-danger small"></span>
    </div>
    <div class="col-md-4 d-flex align-items-end">
        <div class="form-check form-switch mb-2">
            <input asp-for="Status" class="form-check-input" type="checkbox" role="switch" id="statusSwitch">
            <label class="form-check-label fw-semibold" for="statusSwitch">Active</label>
        </div>
    </div>

    <div class="col-md-4">
        <label class="form-label fw-semibold d-block">Is Discountable</label>
        <div class="form-check form-switch">
            <input asp-for="Is_Discountable" class="form-check-input" type="checkbox" role="switch" id="discSwitch">
            <label class="form-check-label" for="discSwitch" id="discLabel">@(Model.Is_Discountable ? "Yes" : "No")</label>
        </div>
        <div class="form-text">Yes: a bill discount may also apply to this charge.</div>
    </div>
    <div class="col-md-4">
        <label class="form-label fw-semibold d-block">Is GST Required</label>
        <div class="form-check form-switch">
            <input asp-for="Is_GST_Required" class="form-check-input" type="checkbox" role="switch" id="gstSwitch">
            <label class="form-check-label" for="gstSwitch" id="gstLabel">@(Model.Is_GST_Required ? "Yes" : "No")</label>
        </div>
    </div>
    <div class="col-md-4 @(Model.Is_GST_Required ? "" : "d-none")" id="gstPctBox">
        <label asp-for="GST_Percentage" class="form-label fw-semibold required-field"></label>
        <div class="input-group">
            <input asp-for="GST_Percentage" type="number" step="0.01" min="0.01" max="28" class="form-control" list="gstSlabs" placeholder="e.g. 18" />
            <span class="input-group-text">%</span>
        </div>
        <datalist id="gstSlabs"><option value="5"></option><option value="12"></option><option value="18"></option><option value="28"></option></datalist>
        <span asp-validation-for="GST_Percentage" class="text-danger small"></span>
    </div>

    <div class="col-12">
        <label asp-for="Description" class="form-label fw-semibold"></label>
        <textarea asp-for="Description" class="form-control" rows="2" maxlength="500" placeholder="Optional - when this charge applies"></textarea>
        <span asp-validation-for="Description" class="text-danger small"></span>
    </div>
</div>
