        function loadCategories() {
            var dept = $('#ddlDepartment').val();
            var $cat = $('#ddlCategory');
            $cat.empty().append('<option value="">-- All Categories --</option>');
            $('#ddlSubCategory').empty().append('<option value="">-- All Sub Categories --</option>');

            if (dept) {
                $.get('/LabOrderBooking/GetCategoriesForDropdown?departmentId=' + dept, function(res) {
                    if (res && res.length > 0) {
                        res.forEach(function(c) {
                            $cat.append(new Option(c.text, c.value));
                        });
                    }
                    $cat.trigger('change.select2');
                    loadInvestigations();
                });
