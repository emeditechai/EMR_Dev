        // ── Bidirectional DOB ↔ Age calculation (Same as B2C) ──
        (function setupAgeDobSync() {
            const dobInput = document.getElementById('DateOfBirth');
            const yearsInput = document.getElementById('AgeYears');
            const monthsInput = document.getElementById('AgeMonths');
            const daysInput = document.getElementById('AgeDays');
            const feedbackEl = document.getElementById('ageValidationFeedback');

            let isUpdating = false;

            function clearAgeValidation() {
                yearsInput?.classList.remove('is-invalid');
                monthsInput?.classList.remove('is-invalid');
                daysInput?.classList.remove('is-invalid');
                dobInput?.classList.remove('is-invalid');
                if (feedbackEl) {
                    feedbackEl.textContent = '';
                    feedbackEl.classList.add('d-none');
                }
            }

            function calcAgeDetails(dobValue) {
                if (!dobValue) return { years: '', months: '', days: '' };
                const birthDate = new Date(dobValue);
                if (isNaN(birthDate.getTime())) return { years: '', months: '', days: '' };
                const today = new Date();
                if (birthDate > today) return { years: 0, months: 0, days: 0 };

                let years = today.getFullYear() - birthDate.getFullYear();
                let months = today.getMonth() - birthDate.getMonth();
                let days = today.getDate() - birthDate.getDate();

                if (days < 0) {
                    months--;
                    const prevMonth = new Date(today.getFullYear(), today.getMonth(), 0);
                    days += prevMonth.getDate();
                }

                if (months < 0) {
                    years--;
                    months += 12;
                }

                return {
                    years: Math.max(0, years),
                    months: Math.max(0, months),
                    days: Math.max(0, days)
                };
            }

            function syncDobFromAge() {
                if (isUpdating) return;
                isUpdating = true;
                clearAgeValidation();

                const yVal = yearsInput?.value?.trim() ?? '';
                const mVal = monthsInput?.value?.trim() ?? '';
                const dVal = daysInput?.value?.trim() ?? '';

                const y = parseInt(yVal, 10) || 0;
                const m = parseInt(mVal, 10) || 0;
                const d = parseInt(dVal, 10) || 0;

                // Validate Month <= 12
                if (m > 12) {
                    monthsInput?.classList.add('is-invalid');
                    if (feedbackEl) {
                        feedbackEl.textContent = 'Month cannot exceed 12.';
                        feedbackEl.classList.remove('d-none');
                    }
                    isUpdating = false;
                    return;
                }

                // Validate Days <= 30
                if (d > 30) {
                    daysInput?.classList.add('is-invalid');
                    if (feedbackEl) {
                        feedbackEl.textContent = 'Days cannot exceed 30.';
                        feedbackEl.classList.remove('d-none');
                    }
                    isUpdating = false;
                    return;
                }

                // Validate Years <= 150
                if (y > 150 || y < 0) {
                    yearsInput?.classList.add('is-invalid');
                    if (feedbackEl) {
                        feedbackEl.textContent = 'Years must be between 0 and 150.';
                        feedbackEl.classList.remove('d-none');
                    }
                    isUpdating = false;
                    return;
                }

                if (yVal !== '' || mVal !== '' || dVal !== '') {
                    const today = new Date();
                    const targetDate = new Date(today.getFullYear() - y, today.getMonth() - m, today.getDate() - d);
                    const yyyy = targetDate.getFullYear();
                    const mm = String(targetDate.getMonth() + 1).padStart(2, '0');
                    const dd = String(targetDate.getDate()).padStart(2, '0');
                    if (dobInput) dobInput.value = `${yyyy}-${mm}-${dd}`;
                } else {
                    if (dobInput) dobInput.value = '';
                }
                isUpdating = false;
            }

            function syncAgeFromDob() {
                if (isUpdating) return;
                isUpdating = true;
                clearAgeValidation();

                const val = dobInput?.value;
                if (val) {
                    const age = calcAgeDetails(val);
                    if (yearsInput) yearsInput.value = age.years !== '' ? age.years : '';
                    if (monthsInput) monthsInput.value = age.months !== '' ? age.months : '';
                    if (daysInput) daysInput.value = age.days !== '' ? age.days : '';
                } else {
                    if (yearsInput) yearsInput.value = '';
                    if (monthsInput) monthsInput.value = '';
                    if (daysInput) daysInput.value = '';
                }
                isUpdating = false;
            }

            dobInput?.addEventListener('change', syncAgeFromDob);
            dobInput?.addEventListener('input', syncAgeFromDob);

            [yearsInput, monthsInput, daysInput].forEach(inp => {
                inp?.addEventListener('input', syncDobFromAge);
                inp?.addEventListener('change', syncDobFromAge);
            });

            window._refreshAge = syncAgeFromDob;
            window._refreshDob = syncDobFromAge;

            if (dobInput?.value) {
                syncAgeFromDob();
            } else if (yearsInput?.value || monthsInput?.value || daysInput?.value) {
                syncDobFromAge();
            }
        })();

        // ── B2B Partner Switch & Selection Logic ──
        function onPartnerTypeChanged(type) {
            currentAgentType = type;
            $('#toggleFranchise').prop('checked', type === 'F');
            $('#toggleCompany').prop('checked', type === 'C');

            if (type === 'F') {
                $('#divFranchiseSelect').show();
                $('#divCompanySelect').hide();
                $('#ddlCompany').val('').trigger('change.select2');
                var fVal = $('#ddlFranchise').val();
                onPartnerSelected(fVal);
            } else {
                $('#divFranchiseSelect').hide();
                $('#divCompanySelect').show();
                $('#ddlFranchise').val('').trigger('change.select2');
                var cVal = $('#ddlCompany').val();
                onPartnerSelected(cVal);
            }
        }

        var partnerCreditData = null;

        function onPartnerSelected(agentId) {
            currentAgentId = parseInt(agentId) || 0;
            $('#SelectedB2BAgentId').val(currentAgentId);

            if (currentAgentId > 0) {
                var partnerName = currentAgentType === 'C' 
                    ? $('#ddlCompany option:selected').text()
                    : $('#ddlFranchise option:selected').text();

                var partnerBadge = currentAgentType === 'C' ? 'Corporate' : 'Franchise';
                $('#partnerInfoTitle').html(`<span class="badge bg-primary me-1">${partnerBadge}</span> ${partnerName}`);
                $('#partnerInfoSub').text('Contracted B2B test rates & credit facility active.');

                // Query Partner Credit Status & Policy from API
                $.get(`/LabOrderBooking/GetPartnerCreditStatus?agentType=${currentAgentType}&agentId=${currentAgentId}`, function(res) {
                    if (res && res.success && res.data) {
                        partnerCreditData = res.data;
                        applyPartnerCreditUI(partnerCreditData);
                    } else {
                        partnerCreditData = null;
                        $('#partnerFacilityBadgeContainer').empty();
                        $('#partnerDetailsGrid').hide();
                    }
                });

                // Reload investigations with contracted B2B rate list
                loadInvestigations();

                // Recalculate existing line items with newly contracted rates
                if (lineItems && lineItems.length > 0) {
                    var rateType = currentAgentType === 'C' ? 'Corporate' : 'Franchise';
                    $.get(`/LabOrderBooking/GetAvailableInvestigations?rateType=${rateType}&agentId=${currentAgentId}`, function(res) {
                        if (res.isSuccess && res.data) {
                            var map = new Map();
                            res.data.forEach(x => {
                                var key = (x.isPackage ? 'P' : 'I') + '_' + x.investigationId;
                                var b2b = (x.b2BRate !== undefined && x.b2BRate !== null) ? x.b2BRate : ((x.b2bRate !== undefined && x.b2bRate !== null) ? x.b2bRate : x.mrp);
                                map.set(key, b2b);
                            });
                            lineItems.forEach(item => {
                                var key = item.itemType + '_' + item.id;
                                if (map.has(key)) {
                                    item.b2bRate = map.get(key);
                                }
                            });
                            renderTable();
                        }
                    });
                }
            } else {
                partnerCreditData = null;
                $('#partnerInfoTitle').text('No Partner Selected');
                $('#partnerInfoSub').text('Select partner above to activate B2B contracted test rates.');
                $('#partnerFacilityBadgeContainer').empty();
                $('#partnerDetailsGrid').hide();
                loadInvestigations();
            }
        }

        function applyPartnerCreditUI(credit) {
            $('#partnerDetailsGrid').show();

            // Facility Type Badge
            if (credit.creditFacilityType === 1) { // Prepaid (Wallet)
                $('#partnerFacilityBadgeContainer').html(`
                    <span class="badge bg-success-subtle text-success border border-success px-2 py-1">
                        <i class="bi bi-wallet2 me-1"></i>Prepaid (Wallet)
                    </span>
                `);
                $('#sectionPrepaidWallet').show();
                $('#sectionPostpaidCredit').hide();
                $('#lblWalletBalance').text(`₹ ${credit.walletBalance.toLocaleString('en-IN', {minimumFractionDigits: 2, maximumFractionDigits: 2})}`);
                $('#chkDeductWallet').prop('checked', true);
                $('#hdnDeductFromWallet').val('true');
            } else { // Postpaid (Credit)
                $('#partnerFacilityBadgeContainer').html(`
                    <span class="badge bg-primary-subtle text-primary border border-primary px-2 py-1">
                        <i class="bi bi-credit-card-2-front me-1"></i>Postpaid (Credit)
                    </span>
                `);
                $('#sectionPrepaidWallet').hide();
                $('#sectionPostpaidCredit').show();
                $('#lblCreditLimit').text(credit.creditLimit > 0 ? `₹ ${credit.creditLimit.toLocaleString('en-IN', {minimumFractionDigits: 2, maximumFractionDigits: 2})}` : 'No Limit');
                $('#lblCurrentOutstanding').text(`₹ ${credit.currentOutstanding.toLocaleString('en-IN', {minimumFractionDigits: 2, maximumFractionDigits: 2})}`);
                $('#lblAvailableCredit').text(credit.creditLimit > 0 ? `₹ ${credit.availableCredit.toLocaleString('en-IN', {minimumFractionDigits: 2, maximumFractionDigits: 2})}` : 'Unlimited');
                $('#badgeCreditDays').html(`<i class="bi bi-calendar-event me-1"></i>Credit: ${credit.creditDays > 0 ? credit.creditDays + ' Days' : 'Immediate'}`);
                $('#badgeBillingCycle').html(`<i class="bi bi-arrow-repeat me-1"></i>Cycle: ${credit.billingCycle || 'On-Demand'}`);
                $('#hdnDeductFromWallet').val('false');
            }

            // Corporate validity
            if (credit.agentType === 'C' && (credit.effectiveFrom || credit.effectiveTo)) {
                var fromStr = credit.effectiveFrom ? new Date(credit.effectiveFrom).toLocaleDateString('en-IN', {day:'2-digit', month:'short', year:'numeric'}) : 'N/A';
                var toStr = credit.effectiveTo ? new Date(credit.effectiveTo).toLocaleDateString('en-IN', {day:'2-digit', month:'short', year:'numeric'}) : 'N/A';
                $('#lblContractDates').text(`${fromStr} to ${toStr}`);
                if (credit.isContractValid) {
                    $('#badgeContractStatus').removeClass('bg-danger').addClass('bg-success').text('Active');
                } else {
                    $('#badgeContractStatus').removeClass('bg-success').addClass('bg-danger').text('Expired');
                }
                $('#bannerCorporateValidity').show();
            } else {
                $('#bannerCorporateValidity').hide();
            }

            validateCreditPolicy();
        }

        function validateCreditPolicy() {
            if (!partnerCreditData) {
                $('#partnerPolicyAlert').addClass('d-none').empty();
                $('#btnSaveB2BSubmit').prop('disabled', false);
                return;
            }

            var b2bTotal = parseFloat($('#B2BTotal').val()) || 0;
            var alertEl = $('#partnerPolicyAlert');

            // 1. Corporate contract validity
            if (partnerCreditData.agentType === 'C' && !partnerCreditData.isContractValid) {
                alertEl.removeClass('d-none alert-warning alert-info').addClass('alert-danger')
                    .html(`<i class="bi bi-exclamation-octagon-fill me-1"></i><strong>Contract Expired:</strong> ${partnerCreditData.blockReason || 'Corporate contract is inactive. Billing cannot proceed.'}`);
                $('#btnSaveB2BSubmit').prop('disabled', true);
                return;
            }

            // 2. Postpaid Credit Limit
            if (partnerCreditData.creditFacilityType === 2 && partnerCreditData.creditLimit > 0) {
                var totalWithBill = partnerCreditData.currentOutstanding + b2bTotal;
                if (totalWithBill > partnerCreditData.creditLimit) {
                    var over = totalWithBill - partnerCreditData.creditLimit;
                    alertEl.removeClass('d-none alert-warning alert-info').addClass('alert-danger')
                        .html(`<i class="bi bi-slash-circle-fill me-1"></i><strong>Credit Limit Exceeded:</strong> Current Outstanding (₹${partnerCreditData.currentOutstanding.toFixed(2)}) + This Bill (₹${b2bTotal.toFixed(2)}) exceeds limit (₹${partnerCreditData.creditLimit.toFixed(2)}) by <strong class="text-danger">₹${over.toFixed(2)}</strong>. Booking on credit is blocked.`);
                    $('#btnSaveB2BSubmit').prop('disabled', true);
                    return;
                } else if (totalWithBill > (partnerCreditData.creditLimit * 0.85)) {
                    var remaining = partnerCreditData.creditLimit - totalWithBill;
                    alertEl.removeClass('d-none alert-danger alert-info').addClass('alert-warning')
                        .html(`<i class="bi bi-exclamation-triangle-fill me-1"></i><strong>Notice:</strong> 85%+ credit limit utilized. Available credit remaining after this bill: <strong>₹${remaining.toFixed(2)}</strong>.`);
                    $('#btnSaveB2BSubmit').prop('disabled', false);
                    return;
                }
            }

            // 3. Prepaid Wallet
            if (partnerCreditData.creditFacilityType === 1) {
                var isDeduct = $('#chkDeductWallet').is(':checked');
                if (isDeduct) {
                    if (partnerCreditData.walletBalance < b2bTotal) {
                        var shortfall = b2bTotal - partnerCreditData.walletBalance;
                        alertEl.removeClass('d-none alert-danger alert-info').addClass('alert-warning')
                            .html(`<i class="bi bi-wallet2 me-1"></i><strong>Insufficient Wallet Balance:</strong> Shortfall of <strong>₹${shortfall.toFixed(2)}</strong>. Top up wallet or uncheck to collect spot payment.`);
                        $('#btnSaveB2BSubmit').prop('disabled', false);
                        return;
                    } else {
                        alertEl.removeClass('d-none alert-danger alert-warning').addClass('alert-info')
                            .html(`<i class="bi bi-check-circle-fill me-1 text-success"></i>Bill of <strong>₹${b2bTotal.toFixed(2)}</strong> will be automatically deducted from franchise wallet upon booking.`);
                        $('#btnSaveB2BSubmit').prop('disabled', false);
                        return;
                    }
                } else {
                    alertEl.removeClass('d-none alert-danger alert-warning').addClass('alert-info')
                        .html(`<i class="bi bi-cash-coin me-1 text-primary"></i>Immediate spot payment (Cash/UPI/Card) required for Prepaid facility.`);
                    $('#btnSaveB2BSubmit').prop('disabled', false);
                    return;
                }
            }

            alertEl.addClass('d-none').empty();
            $('#btnSaveB2BSubmit').prop('disabled', false);
        }

