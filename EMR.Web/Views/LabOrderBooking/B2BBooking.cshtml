        function openWalletTopUpModal() {
            if (!partnerCreditData || partnerCreditData.agentType !== 'F') {
                Swal.fire({ icon: 'info', title: 'Franchise Wallet', text: 'Please select a Franchise partner first.' });
                return;
            }
            $('#txtTopUpFranchiseName').text(partnerCreditData.partnerName);
            $('#txtTopUpCurrentBal').text(`₹ ${partnerCreditData.walletBalance.toLocaleString('en-IN', {minimumFractionDigits: 2})}`);
            $('#txtTopUpAmount').val('');
            $('#txtTopUpRef').val('');
            $('#txtTopUpNarration').val('');
            $('#topUpErrorAlert').addClass('d-none').text('');
            var modal = new bootstrap.Modal(document.getElementById('walletTopUpModal'));
            modal.show();
        }

        function submitWalletTopUp(e) {
            e.preventDefault();
            if (!partnerCreditData || partnerCreditData.agentType !== 'F') return;

            var amt = parseFloat($('#txtTopUpAmount').val()) || 0;
            if (amt <= 0) {
                $('#topUpErrorAlert').removeClass('d-none').text('Please enter a valid recharge amount.');
                return;
            }

            var payload = {
                franchiseId: partnerCreditData.agentId,
                amount: amt,
                paymentMethodId: parseInt($('#ddlTopUpMethod').val()) || 1,
                transactionRef: $('#txtTopUpRef').val(),
                narration: $('#txtTopUpNarration').val()
            };

            $('#btnSubmitTopUp').prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-1"></span>Processing...');

            $.ajax({
                url: '/LabOrderBooking/FranchiseWalletTopUp',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(payload),
                success: function(res) {
                    $('#btnSubmitTopUp').prop('disabled', false).html('<i class="bi bi-check2-circle me-1"></i>Recharge Wallet');
                    if (res && res.success) {
                        var modalEl = document.getElementById('walletTopUpModal');
                        var modal = bootstrap.Modal.getInstance(modalEl);
                        if (modal) modal.hide();

                        Swal.fire({
                            icon: 'success',
                            title: 'Wallet Recharged!',
                            text: `Successfully added ₹${amt.toFixed(2)}. Receipt: ${res.receiptNo}. New Balance: ₹${res.newBalance.toFixed(2)}.`,
                            confirmButtonColor: '#198754'
                        });

                        partnerCreditData.walletBalance = res.newBalance;
                        $('#lblWalletBalance').text(`₹ ${res.newBalance.toLocaleString('en-IN', {minimumFractionDigits: 2})}`);
                        validateCreditPolicy();
                    } else {
                        $('#topUpErrorAlert').removeClass('d-none').text(res.error || res.message || 'Failed to top-up wallet.');
                    }
                },
                error: function() {
                    $('#btnSubmitTopUp').prop('disabled', false).html('<i class="bi bi-check2-circle me-1"></i>Recharge Wallet');
                    $('#topUpErrorAlert').removeClass('d-none').text('Error connecting to server.');
                }
            });
        }

