        // ── Auto-Suggest Patient Address with Geolocation Coordinates (Lat/Long) ──
        function escapeHtml(str) {
            if (!str) return '';
            return String(str).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
        }

        const homeAddrInput = document.getElementById('HomeCollectionAddress');
        const homeAddrDrop  = document.getElementById('homeAddrDropdown');
        const hdnLat        = document.getElementById('hdnLatitude');
        const hdnLng        = document.getElementById('hdnLongitude');
        const badgeGeo      = document.getElementById('badgeGeoLocation');
        const lblGeo        = document.getElementById('lblGeoCoords');
        const btnClearGeo   = document.getElementById('btnClearGeoCoords');
        const btnClearHome  = document.getElementById('btnClearHomeAddr');
        const iconSearch    = document.getElementById('iconAddrSearch');

        let addrDebounceTimer = null;
        let addrKbdIndex      = -1;

        function getAddrItems() {
            return homeAddrDrop ? Array.from(homeAddrDrop.querySelectorAll('.geo-addr-sug')) : [];
        }

        function setAddrKbdActive(idx) {
            const items = getAddrItems();
            if (!items.length) return;
            items.forEach(i => i.classList.remove('kbd-active'));
            if (idx < 0) {
                addrKbdIndex = -1;
                return;
            }
            addrKbdIndex = Math.max(0, Math.min(idx, items.length - 1));
            items[addrKbdIndex].classList.add('kbd-active');
            items[addrKbdIndex].scrollIntoView({ block: 'nearest', behavior: 'smooth' });
        }

        function updateGeoBadge(lat, lon) {
            if (lat && lon && !isNaN(Number(lat)) && !isNaN(Number(lon))) {
                if (lblGeo) lblGeo.textContent = `Lat: ${Number(lat).toFixed(4)}, Lon: ${Number(lon).toFixed(4)}`;
                if (badgeGeo) badgeGeo.style.display = 'inline-flex';
            } else {
                if (badgeGeo) badgeGeo.style.display = 'none';
            }
        }

        function clearGeoCoordinates() {
            if (hdnLat) hdnLat.value = '';
            if (hdnLng) hdnLng.value = '';
            if (badgeGeo) badgeGeo.style.display = 'none';
        }

        function selectAddressSuggestion(lat, lon, address) {
            if (homeAddrInput) homeAddrInput.value = address;
            if (hdnLat) hdnLat.value = lat;
            if (hdnLng) hdnLng.value = lon;
            updateGeoBadge(lat, lon);
            if (homeAddrDrop) homeAddrDrop.style.display = 'none';
            if (btnClearHome) btnClearHome.style.display = 'block';
            addrKbdIndex = -1;

            if (typeof Swal !== 'undefined') {
                const Toast = Swal.mixin({
                    toast: true,
                    position: 'top-end',
                    showConfirmButton: false,
                    timer: 2500,
                    timerProgressBar: true
                });
                Toast.fire({
                    icon: 'success',
                    title: `Location coordinates (${Number(lat).toFixed(4)}, ${Number(lon).toFixed(4)}) captured`
                });
            }
        }

        if (btnClearGeo) {
            btnClearGeo.addEventListener('click', function (e) {
                e.stopPropagation();
                clearGeoCoordinates();
            });
        }

        if (btnClearHome) {
            btnClearHome.addEventListener('click', function () {
                if (homeAddrInput) {
                    homeAddrInput.value = '';
                    homeAddrInput.focus();
                }
                clearGeoCoordinates();
                btnClearHome.style.display = 'none';
                if (homeAddrDrop) homeAddrDrop.style.display = 'none';
            });
        }

        async function fetchAddressSuggestions(query) {
            const qs = new URLSearchParams({
                query: query
            });

            // 1. Try server-side controller proxy
            try {
                const res = await fetch(`/LabOrderBooking/SearchAddressGeoSuggestions?${qs.toString()}`);
                if (res.ok) {
                    const data = await res.json();
                    if (Array.isArray(data) && data.length > 0) {
                        return data;
                    }
                }
            } catch (e) {
                console.warn('Server address search error, attempting client-side fallback...', e);
            }

            // 2. Client-side fallback: Try Nominatim first
            try {
                const nomRes = await fetch(`https://nominatim.openstreetmap.org/search?q=${encodeURIComponent(query)}&format=json&addressdetails=1&countrycodes=in&limit=6`);
                if (nomRes.ok) {
                    const nomList = await nomRes.json();
                    if (Array.isArray(nomList) && nomList.length > 0) {
                        return nomList.map(item => {
                            const addr = item.address || {};
                            const name = item.name || (item.display_name ? item.display_name.split(',')[0] : '');
                            const road = addr.road || '';
                            const sub = addr.suburb || addr.neighbourhood || '';
                            const dist = addr.county || addr.state_district || '';
                            const st = addr.state || '';
                            const pc = addr.postcode || '';
                            const cnt = addr.country || 'India';

                            const subParts = [];
                            if (road && road !== name) subParts.push(road);
                            if (sub && sub !== name) subParts.push(sub);
                            if (dist && dist !== name) subParts.push(dist);
                            if (st) subParts.push(pc ? `${st} ${pc}` : st);
                            if (cnt) subParts.push(cnt);

                            const secondary = subParts.filter((v, i, a) => a.indexOf(v) === i).join(', ');
                            const fullAddress = secondary ? `${name}, ${secondary}` : name;

                            return {
                                name: name || fullAddress,
                                secondary,
                                fullAddress,
                                latitude: parseFloat(item.lat),
                                longitude: parseFloat(item.lon),
                                city: dist,
                                district: dist,
                                state: st,
                                postcode: pc,
                                country: cnt
                            };
                        });
                    }
                }
            } catch (e) {
                console.warn('Client-side Nominatim search error:', e);
            }

            // 3. Photon Fallback
            try {
                const clientRes = await fetch(`https://photon.komoot.io/api/?q=${encodeURIComponent(query)}&limit=8`);
                if (clientRes.ok) {
                    const geojson = await clientRes.json();
                    if (geojson?.features?.length) {
                        return geojson.features.map(feat => {
                            const props = feat.properties || {};
                            const coords = feat.geometry?.coordinates || [0, 0];
                            const name = props.name || '';
                            const subParts = [];
                            if (props.street && props.street !== name) subParts.push(props.housenumber ? `${props.housenumber} ${props.street}` : props.street);
                            if (props.district && props.district !== name) subParts.push(props.district);
                            if (props.city && props.city !== name) subParts.push(props.city);
                            if (props.county && props.county !== props.city && props.county !== name) subParts.push(props.county);
                            if (props.state) subParts.push(props.postcode ? `${props.state} ${props.postcode}` : props.state);
                            if (props.country) subParts.push(props.country);
                            const secondary = subParts.filter((v, i, a) => a.indexOf(v) === i).join(', ');
                            const fullAddress = secondary ? `${name}, ${secondary}` : name;
                            return {
                                name: name || fullAddress,
                                secondary,
                                fullAddress,
                                latitude: coords[1],
                                longitude: coords[0],
                                city: props.city || '',
                                district: props.district || '',
                                state: props.state || '',
                                postcode: props.postcode || '',
                                country: props.country || ''
                            };
                        });
                    }
                }
            } catch (e) {
                console.warn('Client-side photon search error:', e);
            }

            return [];
        }

        if (homeAddrInput && homeAddrDrop) {
            homeAddrInput.addEventListener('input', function () {
                const val = this.value.trim();
                if (btnClearHome) btnClearHome.style.display = val ? 'block' : 'none';
                clearTimeout(addrDebounceTimer);
                addrKbdIndex = -1;

                if (val.length < 2) {
                    homeAddrDrop.style.display = 'none';
                    if (iconSearch) iconSearch.className = 'bi bi-search';
                    return;
                }

                if (iconSearch) iconSearch.className = 'spinner-border spinner-border-sm text-primary';
                homeAddrDrop.innerHTML = `
                    <div class="p-3 text-center text-muted small">
                        <span class="spinner-border spinner-border-sm text-primary me-2"></span>Searching locations for "<strong>${escapeHtml(val)}</strong>"...
                    </div>
                `;
                homeAddrDrop.style.display = 'block';

                addrDebounceTimer = setTimeout(async () => {
                    const results = await fetchAddressSuggestions(val);
                    if (iconSearch) iconSearch.className = 'bi bi-search';

                    if (!results.length) {
                        homeAddrDrop.innerHTML = `
                            <div class="p-3 text-center text-muted small">
                                <i class="bi bi-info-circle me-1"></i>No suggestions found for "<strong>${escapeHtml(val)}</strong>". You can continue typing custom address.
                            </div>
                        `;
                        homeAddrDrop.style.display = 'block';
                        return;
                    }

                    homeAddrDrop.innerHTML = results.map((item, idx) => `
                        <button type="button"
                                class="list-group-item list-group-item-action py-2.5 px-3 geo-addr-sug ${idx === 0 ? 'kbd-active' : ''}"
                                data-lat="${item.latitude}"
                                data-lon="${item.longitude}"
                                data-address="${escapeHtml(item.fullAddress)}"
                                tabindex="-1">
                            <div class="d-flex align-items-start gap-2">
                                <i class="bi bi-geo-alt-fill text-danger mt-1 fs-6 flex-shrink-0"></i>
                                <div class="flex-grow-1 min-w-0">
                                    <div class="d-flex justify-content-between align-items-baseline gap-2">
                                        <span class="fw-bold text-dark text-truncate">${escapeHtml(item.name)}</span>
                                        <span class="badge bg-light text-secondary border font-monospace flex-shrink-0" style="font-size:0.7rem;">
                                            <i class="bi bi-pin-map-fill text-danger me-0.5"></i>${Number(item.latitude).toFixed(4)}, ${Number(item.longitude).toFixed(4)}
                                        </span>
                                    </div>
                                    <div class="small text-muted text-truncate mt-0.5" title="${escapeHtml(item.secondary || item.fullAddress)}">
                                        ${escapeHtml(item.secondary || item.fullAddress)}
                                    </div>
                                </div>
                            </div>
                        </button>
                    `).join('');
                    homeAddrDrop.style.display = 'block';
                    addrKbdIndex = 0;
                }, 300);
            });

            // Keyboard navigation
            homeAddrInput.addEventListener('keydown', function (e) {
                if (homeAddrDrop.style.display === 'none') return;
                const items = getAddrItems();
                if (!items.length) return;

                if (e.key === 'ArrowDown') {
                    e.preventDefault();
                    var next = (addrKbdIndex < 0) ? 0 : (addrKbdIndex + 1 >= items.length ? 0 : addrKbdIndex + 1);
                    setAddrKbdActive(next);
                } else if (e.key === 'ArrowUp') {
                    e.preventDefault();
                    var prev = (addrKbdIndex <= 0) ? items.length - 1 : addrKbdIndex - 1;
                    setAddrKbdActive(prev);
                } else if (e.key === 'Enter') {
                    e.preventDefault();
                    e.stopPropagation();
                    var targetIdx = addrKbdIndex >= 0 ? addrKbdIndex : 0;
                    if (items[targetIdx]) {
                        const lat  = items[targetIdx].dataset.lat;
                        const lon  = items[targetIdx].dataset.lon;
                        const addr = items[targetIdx].dataset.address;
                        selectAddressSuggestion(lat, lon, addr);
                    }
                } else if (e.key === 'Escape') {
                    homeAddrDrop.style.display = 'none';
                    addrKbdIndex = -1;
                }
            });

            // Click suggestion item
            $(document).on('click', '#homeAddrDropdown .geo-addr-sug', function (e) {
                e.preventDefault();
                const lat  = this.dataset.lat;
                const lon  = this.dataset.lon;
                const addr = this.dataset.address;
                selectAddressSuggestion(lat, lon, addr);
                if (homeAddrInput) homeAddrInput.focus();
            });

            // Close dropdown outside
            document.addEventListener('click', function (e) {
                if (!e.target.closest('#homeAddrSuggestWrapper')) {
                    if (homeAddrDrop) homeAddrDrop.style.display = 'none';
                    addrKbdIndex = -1;
                }
            });
        }

        // ── Device GPS Location Fallback ──
        async function detectAndFillGeoLocation() {
            const btn   = document.getElementById('btnDetectLocation');
            const icon  = document.getElementById('iconDetectLocation');
            const txt   = document.getElementById('txtDetectLocation');
            const txtHomeAddr = document.getElementById('HomeCollectionAddress');

            if (!navigator.geolocation) {
                Swal.fire({ icon: 'info', title: 'Geolocation', text: 'Geolocation is not supported by your browser.', confirmButtonColor: '#0d6efd' });
                return;
            }

            if (btn) btn.disabled = true;
            if (icon) icon.className = 'spinner-border spinner-border-sm';
            if (txt) txt.textContent = 'Detecting GPS...';

            navigator.geolocation.getCurrentPosition(
                async (position) => {
                    const lat = position.coords.latitude;
                    const lon = position.coords.longitude;
                    
                    if (hdnLat) hdnLat.value = lat;
                    if (hdnLng) hdnLng.value = lon;
                    updateGeoBadge(lat, lon);

                    if (txt) txt.textContent = 'Resolving Address...';

                    let formattedAddress = '';

                    // Try free BigDataCloud Client Reverse Geocode API
                    try {
                        const bdcRes = await fetch(`https://api.bigdatacloud.net/data/reverse-geocode-client?latitude=${lat}&longitude=${lon}&localityLanguage=en`);
                        if (bdcRes.ok) {
                            const bdcData = await bdcRes.json();
                            const parts = [];
                            if (bdcData.locality || bdcData.city) parts.push(bdcData.locality || bdcData.city);
                            if (bdcData.principalSubdivision) parts.push(bdcData.principalSubdivision);
                            if (bdcData.postcode) parts.push(bdcData.postcode);
                            if (bdcData.countryName) parts.push(bdcData.countryName);
                            if (parts.length > 0) formattedAddress = parts.join(', ');
                        }
                    } catch (e) {
                        console.warn('BigDataCloud reverse geocode failed:', e);
                    }

                    if (txtHomeAddr) {
                        if (formattedAddress) {
                            txtHomeAddr.value = formattedAddress;
                        } else if (!txtHomeAddr.value) {
                            txtHomeAddr.value = `GPS: ${lat.toFixed(6)}, ${lon.toFixed(6)}`;
                        }
                        if (btnClearHome) btnClearHome.style.display = txtHomeAddr.value ? 'block' : 'none';
                        $(txtHomeAddr).trigger('focusout');
                    }

                    if (btn) btn.disabled = false;
                    if (icon) icon.className = 'bi bi-crosshair';
                    if (txt) txt.textContent = 'Current GPS';

                    if (typeof Swal !== 'undefined') {
                        const Toast = Swal.mixin({
                            toast: true,
                            position: 'top-end',
                            showConfirmButton: false,
                            timer: 2500,
                            timerProgressBar: true
                        });
                        Toast.fire({
                            icon: 'success',
                            title: `GPS coordinates captured: (${lat.toFixed(4)}, ${lon.toFixed(4)})`
                        });
                    }
                },
                (error) => {
                    if (btn) btn.disabled = false;
                    if (icon) icon.className = 'bi bi-crosshair';
                    if (txt) txt.textContent = 'Current GPS';

                    let errorMsg = 'Unable to retrieve device GPS.';
                    if (error.code === error.PERMISSION_DENIED) {
                        errorMsg = 'Location permission was denied. You can search patient address by typing directly in the address field.';
                    } else if (error.code === error.POSITION_UNAVAILABLE) {
                        errorMsg = 'Location information is unavailable.';
                    } else if (error.code === error.TIMEOUT) {
                        errorMsg = 'Location request timed out. Please try again.';
                    }
                    Swal.fire({ icon: 'warning', title: 'Location Error', text: errorMsg, confirmButtonColor: '#0d6efd' });
                },
                { enableHighAccuracy: true, timeout: 10000, maximumAge: 0 }
            );
        }

        $('#btnDetectLocation').on('click', detectAndFillGeoLocation);

        // ── Interactive Leaflet Map Picker Logic ──
        let leafletMap = null;
        let mapMarker = null;
        let currentMapLat = 0;
        let currentMapLng = 0;
        let currentMapAddress = '';

        function initLeafletMap(initialLat, initialLng, initialAddress) {
            const hasCoords = (initialLat && initialLng && initialLat !== 0 && initialLng !== 0);
            const defaultLat = hasCoords ? initialLat : 22.5726;
            const defaultLng = hasCoords ? initialLng : 88.3639;

            currentMapLat = defaultLat;
            currentMapLng = defaultLng;
            currentMapAddress = initialAddress || '';

            if (!leafletMap) {
                leafletMap = L.map('leafletMapContainer').setView([defaultLat, defaultLng], hasCoords ? 16 : 13);

                L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                    maxZoom: 19,
                    attribution: '© OpenStreetMap contributors'
                }).addTo(leafletMap);

                // Draggable Marker
                mapMarker = L.marker([defaultLat, defaultLng], {
                    draggable: true,
                    autoPan: true
                }).addTo(leafletMap);

                mapMarker.on('dragend', function (e) {
                    const pos = mapMarker.getLatLng();
                    onMapLocationSelected(pos.lat, pos.lng);
                });

                leafletMap.on('click', function (e) {
                    mapMarker.setLatLng(e.latlng);
                    onMapLocationSelected(e.latlng.lat, e.latlng.lng);
                });
            } else {
                leafletMap.setView([defaultLat, defaultLng], hasCoords ? 16 : 13);
                mapMarker.setLatLng([defaultLat, defaultLng]);
            }

            if (initialAddress && hasCoords) {
                updateMapModalInfo(defaultLat, defaultLng, initialAddress);
            } else {
                onMapLocationSelected(defaultLat, defaultLng);
            }
        }

        async function onMapLocationSelected(lat, lng) {
            currentMapLat = lat;
            currentMapLng = lng;
            updateMapModalInfo(lat, lng, 'Fetching address details for selected point...');
            $('#mapLoadingOverlay').css('display', 'flex');

            try {
                // 1. Try Backend ReverseGeoLookup Proxy
                const res = await fetch(`/LabOrderBooking/ReverseGeoLookup?lat=${lat}&lon=${lng}`);
                if (res.ok) {
                    const data = await res.json();
                    if (data && data.success && data.address) {
                        currentMapAddress = data.address;
                        updateMapModalInfo(lat, lng, currentMapAddress);
                        return;
                    }
                }
            } catch (err) {
                console.warn('Backend reverse geocode failed:', err);
            }

            // 2. Client-side Nominatim Reverse Geocode Fallback
            try {
                const nomRes = await fetch(`https://nominatim.openstreetmap.org/reverse?lat=${lat}&lon=${lng}&format=json&addressdetails=1`);
                if (nomRes.ok) {
                    const nomData = await nomRes.json();
                    if (nomData && nomData.display_name) {
                        currentMapAddress = nomData.display_name;
                        updateMapModalInfo(lat, lng, currentMapAddress);
                        return;
                    }
                }
            } catch (e) {
                console.warn('Nominatim client reverse geocode failed:', e);
            } finally {
                $('#mapLoadingOverlay').hide();
            }

            currentMapAddress = `Location (${lat.toFixed(5)}, ${lng.toFixed(5)})`;
            updateMapModalInfo(lat, lng, currentMapAddress);
        }

        function updateMapModalInfo(lat, lng, address) {
            $('#mapLoadingOverlay').hide();
            $('#mapSelectedAddressText').text(address || 'Click map or drag pin to select');
            $('#mapSelectedCoordsBadge').text(`Lat: ${Number(lat).toFixed(5)}, Lon: ${Number(lng).toFixed(5)}`);
        }

        // Open Map Picker Modal
        $('#btnOpenMapModal, #badgeGeoLocation').on('click', function (e) {
            if ($(e.target).closest('#btnClearGeoCoords').length) return;
            $('#mapPickerModal').modal('show');
        });

        // Initialize / Invalidate Leaflet Map on Modal Open
        $('#mapPickerModal').on('shown.bs.modal', function () {
            const lat = parseFloat($('#hdnLatitude').val()) || 0;
            const lng = parseFloat($('#hdnLongitude').val()) || 0;
            const addr = $('#HomeCollectionAddress').val().trim();

            initLeafletMap(lat, lng, addr);
            setTimeout(() => {
                if (leafletMap) leafletMap.invalidateSize();
            }, 100);
        });

        // Confirm Location from Map Modal
        $('#btnConfirmMapLocation').on('click', function () {
            if (currentMapLat && currentMapLng) {
                $('#hdnLatitude').val(currentMapLat.toFixed(6));
