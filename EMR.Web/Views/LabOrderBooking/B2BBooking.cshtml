@model EMR.Web.Models.ViewModels.LabOrderBookingViewModel
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Xsrf
@{
    ViewData["Title"] = "B2B Lab Order Registration & Billing";
    var token = Xsrf.GetAndStoreTokens(Context).RequestToken;
}

@section HeadStyles {
    <link rel="stylesheet" href="~/lib/select2/dist/css/select2.min.css" />
    <link rel="stylesheet" href="~/lib/select2/dist/css/select2.min.css" />
    <link rel="stylesheet" href="~/lib/select2-bootstrap-5-theme/dist/select2-bootstrap-5-theme.min.css" />
    <link rel="stylesheet" href="~/lib/leaflet/dist/leaflet.css" />
    <style>
        #leafletMapContainer {
            height: 380px;
            width: 100%;
            border-radius: 8px;
            z-index: 1;
        }
        .leaflet-container {
            font-family: inherit;
        }
        .geo-addr-sug {
            cursor: pointer;
            transition: all 0.15s ease-in-out;
            border: none;
            border-bottom: 1px solid #f0f0f0;
            border-left: 4px solid transparent;
            background: #fff;
        }
        .geo-addr-sug:hover, .geo-addr-sug.kbd-active {
            background-color: #e8f0fe !important;
            border-left: 4px solid #1a73e8 !important;
        }
        .geo-addr-sug.kbd-active .fw-bold {
            color: #1a73e8 !important;
        }
        .btn-close-xs {
            width: 0.5rem;
            height: 0.5rem;
            padding: 0.15rem;
        }
        .select2-container--bootstrap-5 .select2-selection {
            min-height: 38px;
            font-size: 0.875rem;
            border-color: #cbd5e1;
            border-radius: 8px;
            transition: border-color 0.15s ease-in-out, box-shadow 0.15s ease-in-out;
        }
        .select2-container--bootstrap-5.select2-container--focus .select2-selection,
        .select2-container--bootstrap-5.select2-container--open .select2-selection,
        .form-control:focus,
        .form-select:focus,
        .form-check-input:focus {
            border-color: #2563eb !important;
            box-shadow: 0 0 0 0.25rem rgba(37, 99, 235, 0.22) !important;
            outline: 0 !important;
        }
        .form-check-input:focus + .form-check-label {
            color: #2563eb !important;
            font-weight: 700 !important;
        }
        .select2-container--bootstrap-5 .select2-dropdown {
            border-color: #cbd5e1;
            border-radius: 8px;
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.12), 0 8px 10px -6px rgba(0, 0, 0, 0.08);
            overflow: hidden;
            z-index: 1060;
        }
        .select2-container--bootstrap-5 .select2-search--dropdown {
            padding: 8px 10px;
            background: #f8fafc;
            border-bottom: 1px solid #e2e8f0;
        }
        .select2-container--bootstrap-5 .select2-search--dropdown .select2-search__field {
            border-radius: 6px;
            border: 1px solid #cbd5e1;
            padding: 6px 12px;
            font-size: 0.85rem;
        }
        .select2-container--bootstrap-5 .select2-results__options {
            max-height: 280px;
            padding: 4px;
        }
        .select2-container--bootstrap-5 .select2-results__option {
            padding: 6px 10px;
            font-size: 0.85rem;
            border-radius: 6px;
            margin-bottom: 2px;
            transition: background-color 0.1s ease;
        }
        .select2-container--bootstrap-5 .select2-results__option--highlighted[aria-selected] {
            background-color: #eff6ff !important;
            color: #1e3a8a !important;
        }
        .select2-container { width: 100% !important; }

        .reg-section {
            background: #fff;
            border: 1px solid #e2e8f0;
            border-radius: 12px;
            margin-bottom: 1.25rem;
            overflow: visible;
            box-shadow: 0 1px 3px rgba(0,0,0,.04);
        }
        .reg-section-header {
            display: flex;
            align-items: center;
            gap: .75rem;
            padding: 0.85rem 1.25rem;
            border-bottom: 1px solid #e2e8f0;
            background: #fff;
        }
        .reg-section-header .sec-icon {
            width: 38px; height: 38px;
            border-radius: 8px;
            display: flex; align-items: center; justify-content: center;
            font-size: 1.15rem;
        }
        .reg-section-header .sec-icon.blue  { background: #e8f0fe; color: #1967d2; }
        .reg-section-header .sec-icon.green { background: #e6f4ea; color: #137333; }
        .reg-section-header .sec-icon.purple { background: #f3e8fd; color: #7c3aed; }
        .reg-section-body { padding: 1.25rem; }

        .b2b-toggle-card {
            background: linear-gradient(135deg, #f8fafc 0%, #eff6ff 100%);
            border: 1px solid #bfdbfe;
            border-radius: 12px;
            padding: 1.1rem 1.4rem;
            margin-bottom: 1.25rem;
        }
        .btn-check:checked + .btn-b2b-toggle {
            background: #2563eb;
            color: #fff;
            border-color: #2563eb;
            font-weight: 700;
            box-shadow: 0 2px 6px rgba(37,99,235,.25);
        }
        .btn-b2b-toggle {
            border-color: #cbd5e1;
            color: #475569;
            font-weight: 600;
            padding: .45rem 1.5rem;
            transition: all .15s ease;
        }

        .action-bar {
            background: #fff;
            border: 1px solid #e2e8f0;
            border-radius: 12px;
            padding: 0.85rem 1.25rem;
            display: flex;
            justify-content: flex-end;
            gap: .75rem;
            margin-bottom: 2rem;
            box-shadow: 0 1px 3px rgba(0,0,0,.04);
            position: sticky;
            bottom: 0;
            z-index: 100;
        }

        #phoneSearchDropdown, #topSearchDropdown {
            border-radius: 8px;
            border: 1px solid #dee2e6;
            box-shadow: 0 8px 24px rgba(0,0,0,0.15) !important;
            background: #fff;
        }
        #phoneSearchDropdown .phone-sug, #topSearchDropdown .top-sug {
            cursor: pointer;
            transition: all 0.15s ease-in-out;
            text-align: left;
            border: none;
            border-bottom: 1px solid #f0f0f0;
            border-left: 4px solid transparent;
            background: #fff;
        }
        #phoneSearchDropdown .phone-sug:hover,
        #phoneSearchDropdown .phone-sug.kbd-active,
        #topSearchDropdown .top-sug:hover,
        #topSearchDropdown .top-sug.kbd-active {
            background-color: #e8f0fe !important;
            border-left: 4px solid #1a73e8 !important;
        }
        #phoneSearchDropdown .phone-sug.kbd-active .fw-semibold,
        #topSearchDropdown .top-sug.kbd-active .fw-semibold {
            color: #1a73e8 !important;
        }

        #tblLineItems tbody tr {
            transition: background-color 0.15s ease;
        }
        #tblLineItems tbody tr:hover {
            background-color: #f8fafc;
        }
    </style>
}

@* ── Payment Modal (Standby) ── *@
@{
    ViewData["PaymentModuleCode"]     = "LAB";
    ViewData["PaymentModuleRefId"]    = 0;
    ViewData["PaymentSuccessModalId"] = "bookingSuccessModal";
}
<partial name="_PaymentModal" />

@* ── Page Title Header ── *@
<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <div>
        <h1 class="h3 mb-0 fw-bold">
            <i class="bi bi-building-add me-2 text-primary"></i>B2B Lab Registration &amp; Billing
        </h1>
        <small class="text-muted">Create B2B franchise &amp; corporate bookings with automated contracted rate cards</small>
    </div>
    <div class="d-flex gap-2 align-items-center">
        <a asp-action="B2BRegistration" class="btn btn-outline-secondary btn-sm px-3 fw-semibold">
            <i class="bi bi-journal-text me-1"></i>B2B Order List
        </a>
    </div>
</div>

@* ── Top Patient Quick Search Card (Same as B2C) ── *@
<div class="card shadow-sm border-0 mb-3 bg-body-tertiary">
    <div class="card-body py-2 px-3">
        <div class="row g-2 align-items-center">
            <div class="col-12 col-md-3">
                <select id="searchType" class="form-select form-select-sm">
                    <option value="phone">Mobile No</option>
                    <option value="code">Patient ID</option>
                    <option value="name">Patient Name</option>
                </select>
            </div>
            <div class="col-12 col-md-6 position-relative">
                <div class="input-group input-group-sm">
                    <span class="input-group-text" id="searchIcon"><i class="bi bi-telephone"></i></span>
                    <input type="text" id="searchInput" class="form-control"
                           placeholder="Enter 10-digit mobile number…" maxlength="50" autocomplete="off" />
                    <button class="btn btn-primary px-3" type="button" id="btnTopSearch">
                        <i class="bi bi-search me-1"></i>Search
                    </button>
                </div>
                <div id="topSearchDropdown"
                     class="list-group position-absolute shadow"
                     style="display:none;top:100%;left:0;right:0;z-index:1055;max-height:260px;overflow-y:auto;"></div>
            </div>
            <div class="col-12 col-md-3 text-end d-none d-md-block">
                <span class="badge bg-light text-muted border"><i class="bi bi-info-circle me-1"></i>Auto-populates on selection</span>
            </div>
        </div>
    </div>
</div>

<form asp-action="B2BBooking" method="post" enctype="multipart/form-data" id="frmB2BBooking" autocomplete="off">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="PatientId" id="PatientId" />
    <input type="hidden" asp-for="PatientCode" id="PatientCode" />
    <input type="hidden" asp-for="IsB2B" value="true" />
    <input type="hidden" asp-for="LineItemsJson" id="LineItemsJson" />
    <input type="hidden" asp-for="B2BTotal" id="B2BTotal" />
    <input type="hidden" id="SelectedB2BAgentId" name="B2BAgentId" value="@(Model.B2BAgentId ?? 0)" />
    <input type="hidden" id="hdnDeductFromWallet" name="DeductFromWallet" value="true" />
    <input type="hidden" id="hdnPaymentDataJson" name="PaymentDataJson" value="" />

    @* ══════════════════════════════════════════════════════════════
       SECTION 0: B2B PARTNER TOGGLE & SELECTION (AT TOP)
       ══════════════════════════════════════════════════════════════ *@
    <div class="b2b-toggle-card shadow-sm">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
            <div class="d-flex align-items-center gap-2">
                <span class="badge bg-primary px-2.5 py-1.5"><i class="bi bi-briefcase-fill me-1"></i>B2B Entity</span>
                <span class="fw-bold text-dark fs-6">Select Partner Type:</span>
            </div>
            @* Toggle switch for Franchise and Company *@
            <div class="btn-group" role="group" aria-label="B2B Partner Toggle">
                <input type="radio" class="btn-check" name="AgentType" id="toggleFranchise" value="F" @(Model.AgentType != "C" ? "checked" : "") onchange="onPartnerTypeChanged('F')">
                <label class="btn btn-outline-primary btn-b2b-toggle" for="toggleFranchise">
                    <i class="bi bi-shop me-1"></i>Franchise
                </label>

                <input type="radio" class="btn-check" name="AgentType" id="toggleCompany" value="C" @(Model.AgentType == "C" ? "checked" : "") onchange="onPartnerTypeChanged('C')">
                <label class="btn btn-outline-primary btn-b2b-toggle" for="toggleCompany">
                    <i class="bi bi-building me-1"></i>Company
                </label>
            </div>
        </div>

        <div class="row g-3 align-items-center">
            @* Franchise Dropdown *@
            <div class="col-12 col-md-6" id="divFranchiseSelect" style="@(Model.AgentType == "C" ? "display:none;" : "")">
                <label class="form-label fw-semibold small text-primary">
                    <i class="bi bi-shop me-1"></i>Choose Franchise <span class="text-danger">*</span>
                </label>
                <select id="ddlFranchise" class="form-select s2-basic" data-placeholder="-- Select Franchise --">
                    <option value="">-- Select Franchise --</option>
                    @if (Model.FranchiseOptions != null && Model.FranchiseOptions.Any())
                    {
                        foreach (var f in Model.FranchiseOptions)
                        {
                            <option value="@f.Value" selected="@(Model.AgentType != "C" && Model.B2BAgentId.HasValue && Model.B2BAgentId.Value.ToString() == f.Value)">
                                @f.Text
                            </option>
                        }
                    }
                    else if (ViewBag.Franchises != null)
                    {
                        foreach (var f in ViewBag.Franchises)
                        {
                            <option value="@f.Value" selected="@(Model.AgentType != "C" && Model.B2BAgentId.HasValue && Model.B2BAgentId.Value.ToString() == f.Value)">
                                @f.Text
                            </option>
                        }
                    }
                </select>
                <small class="text-muted d-block mt-1">Rates will load from Franchise Rate List based on Branch</small>
            </div>

            @* Company / Corporate Dropdown *@
            <div class="col-12 col-md-6" id="divCompanySelect" style="@(Model.AgentType == "C" ? "" : "display:none;")">
                <label class="form-label fw-semibold small text-primary">
                    <i class="bi bi-building me-1"></i>Choose Company (Corporate) <span class="text-danger">*</span>
                </label>
                <select id="ddlCompany" class="form-select s2-basic" data-placeholder="-- Select Corporate Company --">
                    <option value="">-- Select Corporate Company --</option>
                    @if (Model.CorporateOptions != null && Model.CorporateOptions.Any())
                    {
                        foreach (var c in Model.CorporateOptions)
                        {
                            <option value="@c.Value" selected="@(Model.AgentType == "C" && Model.B2BAgentId.HasValue && Model.B2BAgentId.Value.ToString() == c.Value)">
                                @c.Text
                            </option>
                        }
                    }
                    else if (ViewBag.Companies != null)
                    {
                        foreach (var c in ViewBag.Companies)
                        {
                            <option value="@c.Value" selected="@(Model.AgentType == "C" && Model.B2BAgentId.HasValue && Model.B2BAgentId.Value.ToString() == c.Value)">
                                @c.Text
                            </option>
                        }
                    }
                </select>
                <small class="text-muted d-block mt-1">Rates will load from Corporate Rate List for selected Company</small>
            </div>

            @* Dynamic Partner Credit & Facility Status Card *@
            <div class="col-12 col-md-6">
                <div id="partnerCreditCard" class="card border shadow-xs" style="background:#f8fafc; border-radius:10px;">
                    <div class="card-body p-2.5">
                        <!-- Top Row: Partner Name & Facility Badge -->
                        <div class="d-flex justify-content-between align-items-center flex-wrap gap-1 mb-1.5 pb-1 border-bottom">
                            <div class="d-flex align-items-center gap-2">
                                <div class="rounded-circle d-flex align-items-center justify-content-center bg-white border text-primary" style="width:32px;height:32px;flex-shrink:0;">
                                    <i class="bi bi-shield-check fs-6" id="partnerCardIcon"></i>
                                </div>
                                <div>
                                    <span class="fw-bold text-dark small" id="partnerInfoTitle">No Partner Selected</span>
                                    <span class="text-muted d-block" style="font-size:0.72rem;" id="partnerInfoSub">Select a partner to load credit facility rules &amp; contracted rates.</span>
                                </div>
                            </div>
                            <div id="partnerFacilityBadgeContainer">
                                <!-- Badge rendered dynamically -->
                            </div>
                        </div>

                        <!-- Partner Details Grid (Hidden until partner selected) -->
                        <div id="partnerDetailsGrid" style="display:none;">
                            <!-- Prepaid Wallet Section -->
                            <div id="sectionPrepaidWallet" class="row g-2 align-items-center mb-1" style="display:none;">
                                <div class="col-7">
                                    <div class="d-flex align-items-baseline gap-1">
                                        <span class="text-muted small">Wallet Balance:</span>
                                        <span class="fs-6 fw-bold text-success font-monospace" id="lblWalletBalance">₹ 0.00</span>
                                    </div>
                                    <div class="form-check form-switch mt-1">
                                        <input class="form-check-input" type="checkbox" id="chkDeductWallet" checked onchange="onWalletDeductToggle(this)">
                                        <label class="form-check-label small fw-semibold text-dark" for="chkDeductWallet">
                                            Pay from Franchise Wallet
                                        </label>
                                    </div>
                                </div>
                                <div class="col-5 text-end">
                                    <button type="button" class="btn btn-sm btn-outline-success py-1 px-2.5" onclick="openWalletTopUpModal()">
                                        <i class="bi bi-wallet2 me-1"></i>Top-Up
                                    </button>
                                </div>
                            </div>

                            <!-- Postpaid Credit Section -->
                            <div id="sectionPostpaidCredit" class="row g-2 mb-1" style="display:none;">
                                <div class="col-4">
                                    <span class="text-muted d-block" style="font-size:0.7rem;">Credit Limit</span>
                                    <span class="fw-bold text-dark font-monospace small" id="lblCreditLimit">₹ 0.00</span>
                                </div>
                                <div class="col-4">
                                    <span class="text-muted d-block" style="font-size:0.7rem;">Outstanding</span>
                                    <span class="fw-bold text-danger font-monospace small" id="lblCurrentOutstanding">₹ 0.00</span>
                                </div>
                                <div class="col-4">
                                    <span class="text-muted d-block" style="font-size:0.7rem;">Available</span>
                                    <span class="fw-bold text-success font-monospace small" id="lblAvailableCredit">₹ 0.00</span>
                                </div>
                                <div class="col-6 mt-1">
                                    <span class="badge bg-light text-secondary border" style="font-size:0.7rem;" id="badgeCreditDays">
                                        <i class="bi bi-calendar-event me-1"></i>Credit Days: --
                                    </span>
                                </div>
                                <div class="col-6 mt-1 text-end">
                                    <span class="badge bg-light text-secondary border" style="font-size:0.7rem;" id="badgeBillingCycle">
                                        <i class="bi bi-arrow-repeat me-1"></i>Cycle: --
                                    </span>
                                </div>
                            </div>

                            <!-- Corporate Validity Banner -->
                            <div id="bannerCorporateValidity" class="mt-1 p-1 rounded bg-light border" style="display:none; font-size:0.72rem;">
                                <span class="text-muted"><i class="bi bi-file-earmark-text me-1"></i>Contract:</span>
                                <span class="fw-semibold text-dark" id="lblContractDates">-- to --</span>
                                <span class="badge ms-1" id="badgeContractStatus">Active</span>
                            </div>

                            <!-- Real-time Warning / Policy Alert Bar -->
                            <div id="partnerPolicyAlert" class="alert py-1 px-2 mb-0 mt-1.5 small d-none" role="alert"></div>
                        </div>
                    </div>
                </div>
                <span asp-validation-for="B2BAgentId" class="text-danger small fw-semibold"></span>
            </div>
        </div>
    </div>

    @* ══════════════════════════════════════════════════════════════
       SECTION 1: PATIENT DEMOGRAPHICS (EXACT B2C LAYOUT & STYLING)
       ══════════════════════════════════════════════════════════════ *@
    <div class="reg-section">
        <div class="reg-section-header">
            <div class="sec-icon blue me-2"><i class="bi bi-person-circle"></i></div>
            <div>
                <h6 class="mb-0 fw-bold text-dark">Patient Information</h6>
                <small class="text-muted">Basic patient demographics and identity</small>
            </div>
            <span id="loadedPatientBadge" class="badge text-bg-primary ms-3 font-monospace d-none"></span>
            <span class="badge text-bg-danger ms-auto">* Required Fields</span>
        </div>

        <div class="reg-section-body">
            @* ── Row 1: Phone Number* | Relation* | Profile Picture ── *@
            <div class="row g-3 mb-3">
                <div class="col-12 col-sm-6 col-md-4 position-relative">
                    <label asp-for="PhoneNumber" class="form-label fw-semibold small">
                        Phone Number <span class="text-danger">*</span>
                    </label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-telephone-fill text-primary"></i></span>
                        <input asp-for="PhoneNumber" id="phoneNumber" class="form-control"
                               maxlength="10" inputmode="numeric" pattern="[0-9]{10}"
                               placeholder="10-digit mobile" autocomplete="off" />
                        <button class="btn btn-outline-primary" type="button" id="btnSearchPatient" title="Search existing patient">
                            <i class="bi bi-search"></i>
                        </button>
                    </div>
                    <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                    <div id="phoneError" class="text-danger small" style="display:none"></div>
                    <div id="phoneSearchDropdown"
                         class="list-group position-absolute shadow"
                         style="display:none;top:100%;left:0;right:0;z-index:1055;max-height:220px;overflow-y:auto;"></div>
                </div>

                <div class="col-12 col-sm-6 col-md-4">
                    <label asp-for="RelationId" class="form-label fw-semibold small">
                        Relation <span class="text-danger">*</span>
                    </label>
                    <select asp-for="RelationId" id="ddlRelation" class="form-select s2-basic"
                            asp-items="Model.RelationOptions">
                        <option value="">-- Select Relation --</option>
                    </select>
                    <span asp-validation-for="RelationId" class="text-danger small"></span>
                </div>

                <div class="col-12 col-sm-12 col-md-4">
                    <label class="form-label fw-semibold small">
                        Profile Picture
                        <span class="text-muted fw-normal">(JPG / PNG / GIF)</span>
                    </label>
                    <div class="d-flex align-items-center gap-2">
                        <div class="flex-grow-1">
                            <div class="input-group">
                                <input type="file" name="profilePictureFile" id="profilePictureFile"
                                       class="form-control" accept=".jpg,.jpeg,.png,.gif" onchange="previewProfilePic(this)" />
                                <button type="button" class="btn btn-outline-primary" id="btnWebcamOpen" title="Take photo via Webcam">
                                    <i class="bi bi-camera-fill"></i>
                                </button>
                            </div>
                        </div>
                        <div id="profilePicPreviewContainer" class="@(string.IsNullOrEmpty(Model.PhotoPath) ? "d-none" : "")">
                            <img id="profilePicPreview" src="@Model.PhotoPath" 
                                 class="rounded-circle border" style="width: 38px; height: 38px; object-fit: cover;" />
                        </div>
                    </div>
                    <span asp-validation-for="PhotoPath" class="text-danger small"></span>
                </div>
            </div>

            @* ── Row 2: Title | First Name* | Middle Name | Last Name* ── *@
            <div class="row g-3 mb-3">
                <div class="col-4 col-sm-3 col-md-2">
                    <label asp-for="Salutation" class="form-label fw-semibold small">Title</label>
                    <select asp-for="Salutation" id="ddlSalutation" class="form-select s2-basic px-1">
                        <option value="Mr.">Mr.</option>
                        <option value="Mrs.">Mrs.</option>
                        <option value="Ms.">Ms.</option>
                        <option value="Master">Master</option>
                        <option value="Dr.">Dr.</option>
                        <option value="Prof.">Prof.</option>
                        <option value="Baby">Baby</option>
                    </select>
                </div>
                <div class="col-8 col-sm-5 col-md-4">
                    <label asp-for="FirstName" class="form-label fw-semibold small">
                        First Name <span class="text-danger">*</span>
                    </label>
                    <input asp-for="FirstName" id="FirstName" class="form-control text-capitalize" maxlength="100" placeholder="Enter first name" style="text-transform: capitalize;" />
                    <span asp-validation-for="FirstName" class="text-danger small"></span>
                </div>
                <div class="col-12 col-sm-4 col-md-2">
                    <label asp-for="MiddleName" class="form-label fw-semibold small">Middle Name</label>
                    <input asp-for="MiddleName" id="MiddleName" class="form-control text-capitalize" maxlength="100" placeholder="Optional" style="text-transform: capitalize;" />
                </div>
                <div class="col-12 col-sm-6 col-md-4">
                    <label asp-for="LastName" class="form-label fw-semibold small">
                        Last Name <span class="text-danger">*</span>
                    </label>
                    <input asp-for="LastName" id="LastName" class="form-control text-capitalize" maxlength="100" placeholder="Enter last name" style="text-transform: capitalize;" />
                    <span asp-validation-for="LastName" class="text-danger small"></span>
                </div>
            </div>

            @* ── Row 3: Secondary Number | Email | Gender* | Date of Birth | Age* ── *@
            <div class="row g-3 mb-3">
                <div class="col-12 col-sm-6 col-md-2">
                    <label asp-for="SecondaryPhoneNumber" class="form-label fw-semibold small">Secondary Number</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-telephone text-secondary"></i></span>
                        <input asp-for="SecondaryPhoneNumber" id="SecondaryPhoneNumber" class="form-control"
                               maxlength="15" placeholder="Optional" />
                    </div>
                </div>
                <div class="col-12 col-sm-6 col-md-2">
                    <label asp-for="EmailId" class="form-label fw-semibold small">Email ID</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-envelope text-secondary"></i></span>
                        <input asp-for="EmailId" id="EmailId" class="form-control text-lowercase" maxlength="150" placeholder="Optional" style="text-transform: lowercase;" />
                    </div>
                </div>
                <div class="col-12 col-sm-4 col-md-2">
                    <label asp-for="Gender" class="form-label fw-semibold small">
                        Gender <span class="text-danger">*</span>
                    </label>
                    <select asp-for="Gender" id="ddlGender" class="form-select s2-basic">
                        <option value="">-- Select --</option>
                        <option value="Male">Male</option>
                        <option value="Female">Female</option>
                        <option value="Other">Other</option>
                    </select>
                    <span asp-validation-for="Gender" class="text-danger small"></span>
                </div>
                <div class="col-12 col-sm-4 col-md-2">
                    <label asp-for="DateOfBirth" class="form-label fw-semibold small">Date of Birth</label>
                    <input asp-for="DateOfBirth" id="DateOfBirth" type="date" class="form-control"
                           max="@DateTime.Today.ToString("yyyy-MM-dd")" />
                    <span asp-validation-for="DateOfBirth" class="text-danger small"></span>
                </div>
                <div class="col-12 col-sm-8 col-md-4">
                    <label class="form-label fw-semibold small">Age <span class="text-danger">*</span></label>
                    <div class="d-flex gap-1 align-items-center">
                        <div class="input-group flex-fill" style="min-width: 0;">
                            <input asp-for="AgeYears" type="number" id="AgeYears" class="form-control px-2 text-center"
                                   min="0" max="150" placeholder="00" title="Years (0-150)" />
                            <span class="input-group-text px-2 small text-muted bg-light fw-medium">Year</span>
                        </div>
                        <div class="input-group flex-fill" style="min-width: 0;">
                            <input asp-for="AgeMonths" type="number" id="AgeMonths" class="form-control px-2 text-center"
                                   min="0" max="12" placeholder="00" title="Months (Max 12)" />
                            <span class="input-group-text px-2 small text-muted bg-light fw-medium">Month</span>
                        </div>
                        <div class="input-group flex-fill" style="min-width: 0;">
                            <input asp-for="AgeDays" type="number" id="AgeDays" class="form-control px-2 text-center"
                                   min="0" max="30" placeholder="00" title="Days (Max 30)" />
                            <span class="input-group-text px-2 small text-muted bg-light fw-medium">Days</span>
                        </div>
                    </div>
                    <div id="ageValidationFeedback" class="text-danger small mt-1 d-none"></div>
                    <span asp-validation-for="AgeYears" class="text-danger small d-block"></span>
                </div>
            </div>

            @* ── Row 4: Blood Group | Referred By Doctor | Address ── *@
            <div class="row g-3 mb-1">
                <div class="col-12 col-sm-6 col-md-3">
                    <label asp-for="BloodGroup" class="form-label fw-semibold small">Blood Group</label>
                    <select asp-for="BloodGroup" id="ddlBloodGroup" class="form-select s2-basic">
                        <option value="">-- Select --</option>
                        <option value="A+">A+</option>
                        <option value="A-">A-</option>
                        <option value="B+">B+</option>
                        <option value="B-">B-</option>
                        <option value="O+">O+</option>
                        <option value="O-">O-</option>
                        <option value="AB+">AB+</option>
                        <option value="AB-">AB-</option>
                        <option value="Unknown">Unknown</option>
                    </select>
                </div>
                <div class="col-12 col-sm-6 col-md-3">
                    <label asp-for="ReferralDoctorId" class="form-label fw-semibold small">Referred By Doctor</label>
                    <select asp-for="ReferralDoctorId" id="ddlReferralDoctor" class="form-select s2-search" asp-items="Model.ReferralDoctorOptions">
                        <option value="">-- Self / Direct --</option>
                    </select>
                </div>
                <div class="col-12 col-md-6">
                    <label asp-for="Address" class="form-label fw-semibold small">Residential Address</label>
                    <input asp-for="Address" id="Address" class="form-control" placeholder="Patient residential address" />
                </div>
            </div>
        </div>
    </div>

    @* ══════════════════════════════════════════════════════════════
       SECTION 2: COLLECTION & ORDER DETAILS
       ══════════════════════════════════════════════════════════════ *@
    <div class="reg-section">
        <div class="reg-section-header">
            <div class="sec-icon green me-2"><i class="bi bi-clock-history"></i></div>
            <div>
                <h6 class="mb-0 fw-bold text-dark">Collection &amp; Order Details</h6>
                <small class="text-muted">Collection mode, scheduling, and assigned phlebotomist</small>
            </div>
            <span class="badge bg-light text-muted border ms-auto fw-normal" style="font-size:0.75rem;">Step 2</span>
        </div>

        <div class="reg-section-body">
            <div class="row g-3">
                <div class="col-12 col-md-4">
                    <label class="form-label fw-semibold small">Collection Type <span class="text-danger">*</span></label>
                    <div class="d-flex gap-3 mt-1">
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="CollectionType" id="colB2B" value="B2BCollector" @(Model.CollectionType != "Home Collection" && Model.CollectionType != "Lab" ? "checked" : "") onchange="onCollectionTypeChanged()">
                            <label class="form-check-label fw-semibold" for="colB2B">
                                <i class="bi bi-briefcase text-primary me-1"></i>B2B Collector
                            </label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="CollectionType" id="colLab" value="Lab" @(Model.CollectionType == "Lab" ? "checked" : "") onchange="onCollectionTypeChanged()">
                            <label class="form-check-label fw-semibold" for="colLab">
                                <i class="bi bi-hospital text-primary me-1"></i>Lab (In-House)
                            </label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="CollectionType" id="colHome" value="Home Collection" @(Model.CollectionType == "Home Collection" ? "checked" : "") onchange="onCollectionTypeChanged()">
                            <label class="form-check-label fw-semibold" for="colHome">
                                <i class="bi bi-house-door text-primary me-1"></i>Home Collection
                            </label>
                        </div>
                    </div>
                </div>

                <div class="col-12 col-md-4">
                    <label asp-for="BookingDateTime" class="form-label fw-semibold small">Booking Date &amp; Time <span class="text-danger">*</span></label>
                    <input asp-for="BookingDateTime" id="BookingDateTime" type="datetime-local" class="form-control"
                           value="@(Model.BookingDateTime != default ? Model.BookingDateTime.ToString("yyyy-MM-ddTHH:mm") : DateTime.Now.ToString("yyyy-MM-ddTHH:mm"))" />
                    <span asp-validation-for="BookingDateTime" class="text-danger small"></span>
                </div>

                <div class="col-12 col-md-4" id="divPhlebotomist">
                    <label class="form-label fw-semibold small">Collector / Phlebotomist</label>
                    <select asp-for="PhlebotomistId" id="ddlPhlebotomist" class="form-select s2-basic" asp-items="Model.PhlebotomistOptions">
                        <option value="">-- Select Collector / Phlebotomist --</option>
                    </select>
                </div>

                <!-- Home Collection Address (with Geo-Location Auto-Suggest, Map Picker & Lat/Long Capture) -->
                <div class="col-12" id="divHomeCollectionAddress" style="@(Model.CollectionType == "Home Collection" ? "" : "display:none;")">
                    <div class="p-3 rounded-3 bg-light border border-primary-subtle">
                        <div class="d-flex justify-content-between align-items-center mb-1 flex-wrap gap-2">
                            <label asp-for="HomeCollectionAddress" class="form-label fw-semibold small mb-0 d-flex align-items-center gap-1 text-primary">
                                <i class="bi bi-geo-alt-fill text-danger"></i> Home Collection Address <span class="text-danger">*</span>
                                <span class="text-muted fw-normal" style="font-size:0.75rem;">(Auto-suggests location &amp; captures doorstep Lat/Long coordinates)</span>
                            </label>
                            <div class="d-flex align-items-center gap-2">
                                <span id="badgeGeoLocation" class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1 align-items-center gap-1" style="display:none; font-size: 0.75rem; cursor:pointer;" title="Click to view/edit on Map">
                                    <i class="bi bi-pin-map-fill text-danger"></i><span id="lblGeoCoords"></span>
                                    <button type="button" class="btn-close btn-close-xs ms-1" id="btnClearGeoCoords" title="Clear GPS coordinates" style="font-size: 0.55rem;"></button>
                                </span>
                                <button type="button" class="btn btn-sm btn-outline-primary py-0 px-2 fw-semibold d-inline-flex align-items-center gap-1" id="btnOpenMapModal" title="Open interactive map to pinpoint or adjust doorstep location">
                                    <i class="bi bi-map-fill"></i>
                                    <span id="txtOpenMap">Pick on Map</span>
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2 fw-semibold d-inline-flex align-items-center gap-1" id="btnDetectLocation" title="Auto-detect current device GPS location">
                                    <i class="bi bi-crosshair" id="iconDetectLocation"></i>
                                    <span id="txtDetectLocation">Current GPS</span>
                                </button>
                            </div>
                        </div>
                        <div class="position-relative" id="homeAddrSuggestWrapper">
                            <div class="input-group">
                                <span class="input-group-text bg-white text-muted border-end-0">
                                    <i class="bi bi-search" id="iconAddrSearch"></i>
                                </span>
                                <input asp-for="HomeCollectionAddress" id="HomeCollectionAddress" class="form-control border-start-0" maxlength="500"
                                       placeholder="Type patient area / landmark / address to auto-suggest (e.g., Belepole, Shibpur, Howrah)..." autocomplete="off" />
                                <button type="button" class="btn btn-outline-secondary" id="btnClearHomeAddr" title="Clear address" style="display:none;">
                                    <i class="bi bi-x-lg"></i>
                                </button>
                            </div>
                            <input type="hidden" asp-for="Latitude" id="hdnLatitude" />
                            <input type="hidden" asp-for="Longitude" id="hdnLongitude" />

                            <!-- Auto-Suggest Dropdown Menu for Geocoded Locations -->
                            <div id="homeAddrDropdown" class="dropdown-menu shadow-lg border-0 w-100 p-0 mt-1" style="display:none; position:absolute; top:100%; left:0; right:0; z-index:1060; max-height:280px; overflow-y:auto; border-radius:8px; border:1px solid #dee2e6;">
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* ══════════════════════════════════════════════════════════════
       SECTION 3: INVESTIGATION SELECTION & B2B LINE ITEMS
       ══════════════════════════════════════════════════════════════ *@
    <div class="reg-section">
        <div class="reg-section-header">
            <div class="sec-icon blue me-2"><i class="bi bi-search"></i></div>
            <div>
                <h6 class="mb-0 fw-bold text-dark">Search &amp; Add Investigation / Profile <span class="text-danger">*</span></h6>
                <small class="text-muted">Filter by department or category, or search directly</small>
            </div>
            <div class="ms-auto d-flex align-items-center gap-2">
                <span class="badge bg-primary-subtle text-primary border border-primary-subtle" id="b2bPaxBadge">
                    <i class="bi bi-tag-fill me-1"></i>B2B PRICING MODE ACTIVE
                </span>
            </div>
        </div>

        <div class="reg-section-body">
            @* Cascading Filters *@
            <div class="row g-3 mb-3">
                <div class="col-12 col-md-4">
                    <label class="form-label fw-semibold small">Department</label>
                    <select id="ddlDepartment" class="form-select s2-search" onchange="loadCategories()">
                        <option value="">-- All Departments --</option>
                        @if (Model.DepartmentOptions != null)
                        {
                            foreach (var d in Model.DepartmentOptions)
                            {
                                <option value="@d.Value">@d.Text</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-12 col-md-4">
                    <label class="form-label fw-semibold small">Category</label>
                    <select id="ddlCategory" class="form-select s2-search" onchange="loadSubCategories()">
                        <option value="">-- All Categories --</option>
                        @if (Model.CategoryOptions != null)
                        {
                            foreach (var c in Model.CategoryOptions)
                            {
                                <option value="@c.Value">@c.Text</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-12 col-md-4">
                    <label class="form-label fw-semibold small">Sub Category</label>
                    <select id="ddlSubCategory" class="form-select s2-search" onchange="loadInvestigations()">
                        <option value="">-- All Sub Categories --</option>
                        @if (Model.SubCategoryOptions != null)
                        {
                            foreach (var sc in Model.SubCategoryOptions)
                            {
                                <option value="@sc.Value">@sc.Text</option>
                            }
                        }
                    </select>
                </div>
            </div>

            @* Investigation Search & Select2 Dropdown *@
            <div class="row g-2 align-items-center mb-3">
                <div class="col-12">
                    <label class="form-label fw-semibold small d-flex justify-content-between align-items-center mb-1">
                        <span>Select Test / Investigation / Profile <span class="text-danger">*</span></span>
                        <span class="badge bg-light text-muted border">
                            Available: <strong id="lblAvailCount" class="text-primary font-monospace">0</strong>
                        </span>
                    </label>
                    <select id="ddlInvestigations" class="form-select" data-placeholder="-- Search by Test Code or Investigation Name --">
                        <option value=""></option>
                    </select>
                    <div class="form-text text-muted small mt-1">
                        <i class="bi bi-info-circle me-1"></i>Rates automatically update to contracted B2B rate cards when a Franchise or Corporate Company is selected.
                    </div>
                </div>
            </div>

            @* ── Line Items Table ── *@
            <div class="table-responsive">
                <table class="table table-bordered table-hover align-middle mb-0" id="tblLineItems">
                    <thead class="table-light">
                        <tr>
                            <th style="width:40px;" class="text-center">#</th>
                            <th style="width:110px;">Test Code</th>
                            <th>Investigation / Profile Name</th>
                            <th style="width:120px;">Sample Type</th>
                            <th style="width:80px;">TAT</th>
                            <th style="width:130px;" class="text-end">Standard MRP (₹)</th>
                            <th style="width:130px;" class="text-end bg-primary-subtle text-primary">B2B Rate (₹)</th>
                            <th style="width:70px;" class="text-center">Urgent</th>
                            <th style="width:50px;" class="text-center">Action</th>
                        </tr>
                    </thead>
                    <tbody id="tblLineItemsBody">
                        <tr id="rowEmpty">
                            <td colspan="9" class="text-center py-4 text-muted">
                                <i class="bi bi-basket fs-4 d-block mb-1 text-secondary"></i>
                                No investigations added yet. Search and select tests above.
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>

            @* ── Totals Footer ── *@
            <div class="row justify-content-end mt-3 g-2">
                <div class="col-12 col-md-8 col-lg-6">
                    <div class="p-3 bg-light rounded-3 border d-flex justify-content-between align-items-center flex-wrap gap-2">
                        <div>
                            <span class="badge bg-secondary" id="badgeSelectedCount">0 Tests Selected</span>
                            <div class="text-muted small mt-1">
                                Standard MRP Total: <strong id="lblStandardTotal" class="font-monospace text-dark">₹ 0.00</strong>
                            </div>
                        </div>
                        <div class="text-end">
                            <span class="fw-bold text-dark text-uppercase small">B2B Total:</span>
                            <div class="bg-success-subtle border border-success-subtle rounded-3 px-3 py-1">
                                <span class="fs-5 fw-bold text-success font-monospace" id="lblB2BTotalAmount">₹ 0.00</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <span asp-validation-for="LineItemsJson" class="text-danger fw-bold small"></span>
        </div>
    </div>

    @* ── Actions ── *@
    <div class="action-bar shadow-sm">
        <a asp-action="B2BRegistration" class="btn btn-outline-secondary px-3 fw-semibold">
            <i class="bi bi-arrow-left me-1"></i>Back to List
        </a>
        <button type="button" class="btn btn-outline-secondary px-3 fw-semibold" id="btnResetForm">
            <i class="bi bi-arrow-counterclockwise me-1"></i>Reset
        </button>
        <button type="submit" class="btn btn-primary px-5 fw-bold" id="btnSaveB2BSubmit">
            <i class="bi bi-check2-circle me-1"></i>Save &amp; Book B2B Order
        </button>
    </div>
</form>

@* ══════════════════════════════════════════════════════════════
   SUCCESS MODAL
   ══════════════════════════════════════════════════════════════ *@
<div class="modal fade" id="bookingSuccessModal" tabindex="-1" data-bs-backdrop="static" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width:480px">
        <div class="modal-content border-0 shadow-lg" style="border-radius:14px;">
            <div class="modal-body text-center py-4 px-4 position-relative">
                <button type="button" class="btn-close position-absolute top-0 end-0 m-3" data-bs-dismiss="modal" aria-label="Close" onclick="window.location.href='@Url.Action("B2BRegistration", "LabOrderBooking")'"></button>
                <div class="rounded-circle d-inline-flex align-items-center justify-content-center mb-3"
                     style="width:68px;height:68px;background:#e6f4ea;color:#137333;">
                    <i class="bi bi-check-circle-fill fs-1"></i>
                </div>
                <h4 class="fw-bold mb-1 text-success">B2B Lab Order Booked!</h4>
                <p class="text-muted small mb-3" id="lblSuccessPatientName">Patient B2B laboratory order registered successfully.</p>
                
                <div class="d-flex gap-2 justify-content-center mt-2 mb-3 flex-wrap">
                    <div class="alert alert-secondary py-2 px-3 mb-0 text-center flex-fill" style="min-width:100px;">
                        <p class="text-muted small mb-0 fw-semibold" style="font-size:.7rem">PATIENT ID</p>
                        <h5 class="fw-bold text-secondary mb-0 font-monospace" id="lblSuccessPatientCode">---</h5>
                    </div>
                    <div class="alert alert-primary py-2 px-3 mb-0 text-center flex-fill" style="min-width:110px;">
                        <p class="text-muted small mb-0 fw-semibold" style="font-size:.7rem">BILL NO</p>
                        <h5 class="fw-bold text-primary mb-0 font-monospace" id="lblSuccessBillNo">---</h5>
                    </div>
                    <div class="alert alert-info py-2 px-3 mb-0 text-center flex-fill" style="min-width:110px;" id="boxSuccessToken">
                        <p class="text-muted small mb-0 fw-semibold" style="font-size:.7rem">TOKEN NO</p>
                        <h5 class="fw-bold text-dark mb-0 font-monospace" id="lblSuccessTokenNo">---</h5>
                    </div>
                    <div class="alert alert-success py-2 px-3 mb-0 text-center flex-fill" style="min-width:110px;">
                        <p class="text-muted small mb-0 fw-semibold" style="font-size:.7rem">B2B TOTAL</p>
                        <h5 class="fw-bold text-success mb-0 font-monospace" id="lblSuccessB2BTotal">₹ 0.00</h5>
                    </div>
                </div>
                <div class="mb-3 text-center">
                    <span class="badge bg-secondary-subtle text-dark border px-2.5 py-1" id="lblSuccessPaymentMode">Settlement: Pending</span>
                </div>

                <div class="d-flex gap-2 justify-content-center flex-wrap">
                    <a href="@Url.Action("B2BRegistration", "LabOrderBooking")" class="btn btn-outline-secondary btn-sm px-3">
                        <i class="bi bi-list-check me-1"></i> B2B Order List
                    </a>
                    <a href="#" id="btnPrintBill" target="_blank" class="btn btn-outline-success btn-sm px-3">
                        <i class="bi bi-printer me-1"></i> Print Bill
                    </a>
                    <!--
                         B2B: Print Barcode at Billing — shown only when BarcodeGenerateAtBilling = true
                         Hidden by default; revealed by JS below when TempData["ShowPrintBarcode"] = "true"
                    -->
                    <a href="#" id="btnPrintBarcode" target="_blank" class="btn btn-outline-info btn-sm px-3 d-none">
                        <i class="bi bi-upc-scan me-1"></i> Print Barcode
                    </a>
                    <a href="@Url.Action("B2BBooking", "LabOrderBooking")" class="btn btn-primary btn-sm px-3">
                        <i class="bi bi-plus-circle me-1"></i> New B2B Booking
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Franchise Wallet Top-Up Modal -->
<div class="modal fade" id="walletTopUpModal" tabindex="-1" aria-labelledby="walletTopUpModalLabel" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered" style="max-width:440px;">
        <div class="modal-content shadow-lg border-0" style="border-radius:12px;">
            <div class="modal-header bg-success text-white py-2 px-3">
                <h6 class="modal-title fw-bold mb-0" id="walletTopUpModalLabel">
                    <i class="bi bi-wallet2 me-2"></i>Franchise Wallet Top-Up / Recharge
                </h6>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-3">
                <div class="p-2 mb-3 bg-light rounded border text-center">
                    <div class="text-muted small">Franchise Account:</div>
                    <div class="fw-bold fs-6 text-dark" id="txtTopUpFranchiseName">--</div>
                    <div class="small text-muted mt-1">Current Balance: <strong class="text-success font-monospace" id="txtTopUpCurrentBal">₹ 0.00</strong></div>
                </div>
                <form id="frmWalletTopUp" onsubmit="submitWalletTopUp(event)">
                    <div class="mb-2.5">
                        <label class="form-label fw-semibold small">Top-Up Amount (₹) <span class="text-danger">*</span></label>
                        <input type="number" step="0.01" min="1" class="form-control font-monospace fw-bold" id="txtTopUpAmount" required placeholder="Enter recharge amount" />
                    </div>
                    <div class="mb-2.5">
                        <label class="form-label fw-semibold small">Payment Mode <span class="text-danger">*</span></label>
                        <select class="form-select form-select-sm" id="ddlTopUpMethod">
                            <option value="1">Cash</option>
                            <option value="2">Bank Transfer (NEFT/RTGS)</option>
                            <option value="3">UPI / QR</option>
                            <option value="4">Cheque</option>
                        </select>
                    </div>
                    <div class="mb-2.5">
                        <label class="form-label fw-semibold small">Reference / UTR / Cheque No</label>
                        <input type="text" class="form-control form-control-sm" id="txtTopUpRef" placeholder="Bank transaction ID or UTR number" />
                    </div>
                    <div class="mb-2.5">
                        <label class="form-label fw-semibold small">Narration / Remarks</label>
                        <input type="text" class="form-control form-control-sm" id="txtTopUpNarration" placeholder="e.g. Advance deposit for lab tests" />
                    </div>
                    <div id="topUpErrorAlert" class="alert alert-danger py-1 px-2 small d-none mb-2"></div>
                    <div class="d-flex justify-content-end gap-2 mt-3">
                        <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-success btn-sm px-4 fw-bold" id="btnSubmitTopUp">
                            <i class="bi bi-check2-circle me-1"></i>Recharge Wallet
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

