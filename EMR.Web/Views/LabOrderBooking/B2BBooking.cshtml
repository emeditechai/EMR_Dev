                $('#lblGeoCoords').text(`Lat: ${currentMapLat.toFixed(4)}, Lon: ${currentMapLng.toFixed(4)}`);
                $('#badgeGeoLocation').css('display', 'inline-flex');

                if (currentMapAddress && !currentMapAddress.startsWith('Fetching')) {
                    $('#HomeCollectionAddress').val(currentMapAddress);
                    if (btnClearHome) btnClearHome.style.display = 'block';
                }
            }
            $('#mapPickerModal').modal('hide');
        });

        // In-Modal Search functionality
        async function searchLocationInsideMap(query) {
            if (!query || query.trim().length < 2) return;
            $('#mapLoadingOverlay').css('display', 'flex');

            const qs = new URLSearchParams({ query: query.trim() });

            try {
                const res = await fetch(`/LabOrderBooking/SearchAddressGeoSuggestions?${qs.toString()}`);
                if (res.ok) {
                    const list = await res.json();
                    if (Array.isArray(list) && list.length > 0) {
                        const first = list[0];
                        if (first.latitude && first.longitude && leafletMap) {
                            leafletMap.setView([first.latitude, first.longitude], 16);
                            mapMarker.setLatLng([first.latitude, first.longitude]);
                            currentMapLat = first.latitude;
                            currentMapLng = first.longitude;
                            currentMapAddress = first.fullAddress || first.name;
                            updateMapModalInfo(first.latitude, first.longitude, currentMapAddress);
                            $('#mapLoadingOverlay').hide();
                            return;
                        }
                    }
                }
            } catch (e) {
                console.warn('Map modal search error:', e);
            }
            $('#mapLoadingOverlay').hide();
        }

        $('#btnMapSearch').on('click', function () {
            searchLocationInsideMap($('#mapSearchInput').val());
        });

        $('#mapSearchInput').on('keydown', function (e) {
            if (e.key === 'Enter') {
                e.preventDefault();
                searchLocationInsideMap($(this).val());
            }
        });

        // In-Modal GPS button
        $('#btnMapCurrentGps').on('click', function () {
            if (navigator.geolocation) {
                $('#mapLoadingOverlay').css('display', 'flex');
                navigator.geolocation.getCurrentPosition(
                    function (pos) {
                        const lat = pos.coords.latitude;
                        const lng = pos.coords.longitude;
                        if (leafletMap) {
                            leafletMap.setView([lat, lng], 16);
                            mapMarker.setLatLng([lat, lng]);
                        }
                        onMapLocationSelected(lat, lng);
                    },
                    function (err) {
                        $('#mapLoadingOverlay').hide();
                        Swal.fire({ icon: 'warning', title: 'GPS Error', text: 'Could not retrieve GPS: ' + (err.message || 'Permission denied'), confirmButtonColor: '#0d6efd' });
                    },
                    { timeout: 8000, enableHighAccuracy: true }
                );
            } else {
                Swal.fire({ icon: 'info', title: 'Geolocation', text: 'Geolocation is not supported by your browser.', confirmButtonColor: '#0d6efd' });
            }
        });

        // ── Profile Photo Webcam Capture ──
        window.previewProfilePic = function(input) {
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    const preview = document.getElementById('profilePicPreview');
                    const container = document.getElementById('profilePicPreviewContainer');
                    if (preview && container) {
                        preview.src = e.target.result;
                        container.classList.remove('d-none');
                    }
                };
                reader.readAsDataURL(input.files[0]);
            }
        };

        let webcamStream = null;
        const webcamModalEl = document.getElementById('webcamModal');
        const webcamModal = webcamModalEl ? new bootstrap.Modal(webcamModalEl) : null;
        const video = document.getElementById('webcamVideo');
        const canvas = document.getElementById('webcamCanvas');
        const btnCapture = document.getElementById('btnCapturePhoto');
        const btnRetake = document.getElementById('btnRetakePhoto');
        const btnUse = document.getElementById('btnUsePhoto');

        document.getElementById('btnWebcamOpen')?.addEventListener('click', async () => {
            try {
                webcamStream = await navigator.mediaDevices.getUserMedia({ video: { width: 320, height: 240, facingMode: "user" } });
                video.srcObject = webcamStream;
                video.classList.remove('d-none');
                canvas.classList.add('d-none');
                btnCapture.classList.remove('d-none');
                btnRetake.classList.add('d-none');
                btnUse.classList.add('d-none');
                webcamModal?.show();
            } catch (err) {
                console.error("Camera access failed:", err);
                Swal.fire({ icon: 'error', title: 'Camera Access', text: 'Could not access camera. Please check permissions.', confirmButtonColor: '#0d6efd' });
            }
        });

        btnCapture?.addEventListener('click', () => {
            if (!webcamStream) return;
            const ctx = canvas.getContext('2d');
            ctx.drawImage(video, 0, 0, 320, 240);
            stopCamera();
            video.classList.add('d-none');
            canvas.classList.remove('d-none');
            btnCapture.classList.add('d-none');
            btnRetake.classList.remove('d-none');
            btnUse.classList.remove('d-none');
        });

        btnRetake?.addEventListener('click', async () => {
            try {
                webcamStream = await navigator.mediaDevices.getUserMedia({ video: { width: 320, height: 240, facingMode: "user" } });
                video.srcObject = webcamStream;
                video.classList.remove('d-none');
                canvas.classList.add('d-none');
                btnCapture.classList.remove('d-none');
                btnRetake.classList.add('d-none');
                btnUse.classList.add('d-none');
            } catch (err) {
                console.error("Camera retake failed:", err);
            }
        });

        btnUse?.addEventListener('click', () => {
            canvas.toBlob((blob) => {
                if (!blob) return;
                const file = new File([blob], "webcam_capture.jpg", { type: "image/jpeg" });
                const dataTransfer = new DataTransfer();
                dataTransfer.items.add(file);
                const fileInput = document.getElementById('profilePictureFile');
                if (fileInput) {
                    fileInput.files = dataTransfer.files;
                    window.previewProfilePic(fileInput);
                }
                webcamModal?.hide();
            }, 'image/jpeg', 0.9);
        });

        webcamModalEl?.addEventListener('hidden.bs.modal', () => {
            stopCamera();
        });

        function stopCamera() {
            if (webcamStream) {
                webcamStream.getTracks().forEach(track => track.stop());
                webcamStream = null;
            }
            if (video) video.srcObject = null;
        }

