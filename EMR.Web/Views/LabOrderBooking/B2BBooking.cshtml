                // Booking Date & Time Validation
                var bookingDateTimeStr = $('#BookingDateTime').val();
                if (!bookingDateTimeStr) {
                    e.preventDefault();
                    Swal.fire({
                        icon: 'warning',
                        title: 'Date & Time Required',
                        text: 'Please select Booking Date & Time.',
                        confirmButtonColor: '#0d6efd'
                    });
                    $('#BookingDateTime').focus();
                    return false;
                }

                // ── B2B Partner Credit Facility & Policy Validations (RUNTIME re-fetch) ─────────────
                // Always prevent default here and re-fetch live credit status before submitting.
                // This ensures validations use real-time balance/limit data, not stale page-load data.
                e.preventDefault();

                var $btn = $('#btnSaveB2BSubmit');
                $btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-1"></span>Validating...');

                $.get('/LabOrderBooking/GetPartnerCreditStatus', {
                    agentType: currentAgentType,
                    agentId: currentAgentId
                }, function(res) {
                    var credit = (res && res.success && res.data) ? res.data : partnerCreditData;
                    // Refresh local cache with live data
                    if (res && res.success && res.data) {
                        partnerCreditData = res.data;
                        applyPartnerCreditUI(partnerCreditData);
                    }

                    var currentB2BTotal = parseFloat($('#B2BTotal').val()) || 0;

                    function restoreBtn() {
                        $btn.prop('disabled', false).html('<i class="bi bi-check2-circle me-1"></i>Save & Book B2B Order');
                    }

                    function doSubmit() {
                        $('#LineItemsJson').val(JSON.stringify(lineItems));
                        document.getElementById('frmB2BBooking').submit();
                    }

                    if (!credit) {
                        // No credit data — allow server to validate
                        doSubmit();
                        return;
                    }

                    // 1. Corporate Contract Validity Check
                    if (credit.agentType === 'C' && !credit.isContractValid) {
                        restoreBtn();
                        Swal.fire({
                            icon: 'error',
                            title: 'Corporate Contract Expired',
                            text: credit.blockReason || 'Corporate company contract is expired or inactive. Billing cannot proceed.',
                            confirmButtonColor: '#dc3545',
                            showCloseButton: true
                        });
                        return;
                    }

                    // 2. Postpaid Credit Facility: Credit Limit Check (runtime)
                    if (credit.creditFacilityType === 2 && credit.creditLimit > 0) {
                        if ((credit.currentOutstanding + currentB2BTotal) > credit.creditLimit) {
                            restoreBtn();
                            var over = (credit.currentOutstanding + currentB2BTotal) - credit.creditLimit;
                            Swal.fire({
                                icon: 'error',
                                title: 'Credit Limit Exceeded',
                                html: `Credit Limit: <b>₹${credit.creditLimit.toFixed(2)}</b><br>Current Outstanding: <b>₹${credit.currentOutstanding.toFixed(2)}</b><br>This Bill Total: <b>₹${currentB2BTotal.toFixed(2)}</b><br><br><span class="text-danger">Exceeds partner credit limit by <b>₹${over.toFixed(2)}</b>.<br>Order booking on credit is blocked until outstanding bills are settled.</span>`,
                                confirmButtonColor: '#dc3545',
                                showCloseButton: true
                            });
                            return;
                        }
                    }

                    // 3. Prepaid (Wallet) Facility: Insufficient Balance Check (runtime)
                    if (credit.creditFacilityType === 1) {
                        var isDeductWallet = $('#chkDeductWallet').is(':checked');
                        if (isDeductWallet) {
                            if (credit.walletBalance < currentB2BTotal) {
                                restoreBtn();
                                var deficit = currentB2BTotal - credit.walletBalance;
                                Swal.fire({
                                    icon: 'warning',
                                    title: 'Insufficient Wallet Balance',
                                    html: `Available Wallet: <b>₹${credit.walletBalance.toFixed(2)}</b><br>Bill Amount: <b>₹${currentB2BTotal.toFixed(2)}</b> (Deficit: <b>₹${deficit.toFixed(2)}</b>)<br><br>Please top up the franchise wallet or switch to Spot Payment.`,
                                    showCloseButton: true,          // ✕ button — closes popup, no action (user can edit the form)
                                    showCancelButton: true,
                                    confirmButtonText: '<i class="bi bi-wallet2 me-1"></i>Top-Up Wallet',
                                    cancelButtonText: '<i class="bi bi-cash-coin me-1"></i>Spot Payment',
                                    confirmButtonColor: '#198754',
                                    cancelButtonColor: '#0d6efd',
                                    allowOutsideClick: false        // prevent accidental dismiss via backdrop
                                }).then((result) => {
                                    if (result.isConfirmed) {
                                        openWalletTopUpModal();
                                    } else if (result.dismiss === Swal.DismissReason.cancel) {
                                        $('#chkDeductWallet').prop('checked', false).trigger('change');
                                        triggerPrepaidSpotPayment();
                                    }
                                    // result.dismiss === Swal.DismissReason.close (✕ button):
                                    // intentionally no action — user closes popup, returns to form
                                });
                                return;
                            }
                            $('#hdnDeductFromWallet').val('true');
                        } else {
                            $('#hdnDeductFromWallet').val('false');
                            if (!$('#hdnPaymentDataJson').val()) {
                                restoreBtn();
                                triggerPrepaidSpotPayment();
                                return;
                            }
                        }
                    }

                    // All validations passed — submit the form
                    doSubmit();

                }).fail(function() {
                    // Credit re-fetch failed — fall back to cached data, proceed to server-side validation
                    $btn.prop('disabled', false).html('<i class="bi bi-check2-circle me-1"></i>Save & Book B2B Order');
                    $('#LineItemsJson').val(JSON.stringify(lineItems));
                    document.getElementById('frmB2BBooking').submit();
                });
            });

            // Reset Button
            $('#btnResetForm').on('click', function() {
                document.getElementById('frmB2BBooking').reset();
                $('#PatientId').val('');
                $('#PatientCode').val('');
                $('#loadedPatientBadge').addClass('d-none').text('');
                lineItems = [];
