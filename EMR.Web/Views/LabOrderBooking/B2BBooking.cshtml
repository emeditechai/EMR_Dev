        function loadInvestigations() {
            var dept = $('#ddlDepartment').val() || '';
            var cat = $('#ddlCategory').val() || '';
            var subCat = $('#ddlSubCategory').val() || '';
            var gender = $('#ddlGender').val() || '';
            var ageYears = $('#AgeYears').val() || '';

            var rateType = 'B2C';
            var agentParam = '';
            if (currentAgentId && currentAgentId > 0) {
                rateType = currentAgentType === 'C' ? 'Corporate' : 'Franchise';
                agentParam = `&agentId=${currentAgentId}`;
            }

            var branchId = '@(User.GetCurrentBranchId() ?? 1)';
            var url = `/LabOrderBooking/GetAvailableInvestigations?branchId=${branchId}&rateType=${rateType}${agentParam}`;
            if (dept) url += `&departmentId=${dept}`;
            if (cat) url += `&categoryId=${cat}`;
            if (subCat) url += `&subCategoryId=${subCat}`;
            if (gender) url += `&gender=${encodeURIComponent(gender)}`;
            if (ageYears) url += `&ageInYears=${ageYears}`;

            var $ddl = $('#ddlInvestigations');
            $ddl.prop('disabled', true);

            $.get(url, function(res) {
                $ddl.empty().append('<option value=""></option>');
                if (res.isSuccess && res.data && res.data.length > 0) {
                    $('#lblAvailCount').text(res.data.length);

                    var $pkgGroup = $('<optgroup label="📦 Health Packages"></optgroup>');
                    var $profGroup = $('<optgroup label="📑 Investigation Profiles"></optgroup>');
                    var $testGroup = $('<optgroup label="🧪 Single Investigations"></optgroup>');

                    res.data.forEach(function(item) {
                        var isProf = item.isProfileTest === true;
                        var isPack = item.isPackage === true;
                        var itemType = isPack ? 'P' : 'I';
                        var valStr = `${itemType}_${item.investigationId}`;

                        var b2bRateVal = (item.b2BRate !== undefined && item.b2BRate !== null) ? item.b2BRate : ((item.b2bRate !== undefined && item.b2bRate !== null) ? item.b2bRate : item.mrp);
                        var textTypeLabel = isPack ? ' [Package]' : (isProf ? ' [Profile]' : ' [Investigation]');

                        var opt = new Option(`${item.testName}${textTypeLabel}`, valStr);
                        $(opt).attr('data-price', item.mrp);
                        $(opt).attr('data-b2b-rate', b2bRateVal);
                        $(opt).attr('data-code', item.testCode);
                        $(opt).attr('data-name', item.testName);
                        $(opt).attr('data-tat', item.tatHours || '');
                        $(opt).attr('data-sample', item.sampleType || '');
                        $(opt).attr('data-method', item.method || '');
                        $(opt).attr('data-is-profile', isProf ? '1' : '0');
                        $(opt).attr('data-is-package', isPack ? '1' : '0');

                        if (isPack) {
                            $pkgGroup.append(opt);
                        } else if (isProf) {
                            $profGroup.append(opt);
                        } else {
                            $testGroup.append(opt);
                        }
                    });

                    if ($pkgGroup.children().length > 0) $ddl.append($pkgGroup);
                    if ($profGroup.children().length > 0) $ddl.append($profGroup);
                    if ($testGroup.children().length > 0) $ddl.append($testGroup);
                } else {
                    $('#lblAvailCount').text('0');
                }
                $ddl.val('').prop('disabled', false).trigger('change.select2');
            }).fail(function() {
                $ddl.prop('disabled', false);
            });
        }

