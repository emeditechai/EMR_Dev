                        </td>
                        <td class="text-center">
                            <button type="button" class="btn btn-sm btn-outline-danger py-0 px-1" onclick="removeLineItem(${idx})" title="Remove">
                                <i class="bi bi-trash"></i>
                            </button>
                        </td>
                    </tr>`;
                $tbody.append(rowHtml);
            });

            $('#lblStandardTotal').text('₹ ' + standardTotal.toFixed(2));
            $('#lblB2BTotalAmount').text('₹ ' + b2bTotal.toFixed(2));
            $('#B2BTotal').val(b2bTotal.toFixed(2));
            $('#badgeSelectedCount').text(lineItems.length + (lineItems.length === 1 ? ' Test Selected' : ' Tests Selected'));
            $('#LineItemsJson').val(JSON.stringify(lineItems));
            validateCreditPolicy();
        }

        function removeLineItem(idx) {
            lineItems.splice(idx, 1);
            renderTable();
        }

        function toggleUrgent(idx, checked) {
            if (lineItems[idx]) {
                lineItems[idx].isUrgent = checked;
            }
        }
    </script>
}
