@section Scripts {
    <script src="~/lib/select2/dist/js/select2.min.js"></script>
    <script src="~/lib/select2/dist/js/select2.min.js"></script>
    <script src="~/lib/leaflet/dist/leaflet.js"></script>
    <script>
        const opdBase = '@Url.Content("~/OPD/")';
        var lineItems = [];
        var currentAgentType = '@Model.AgentType' || 'F';
        var currentAgentId = parseInt($('#SelectedB2BAgentId').val()) || 0;

        // ── Helper functions ──
        async function fetchJson(url) {
            try {
                const r = await fetch(url);
                return r.ok ? await r.json() : null;
            } catch { return null; }
        }

        function setVal(nameOrId, val) {
            if (val === null || val === undefined) return;
            let el = document.getElementById(nameOrId) ?? document.querySelector(`[name="${nameOrId}"]`);
            if (!el) return;
            el.value = val;
            if (el.tagName === 'SELECT' && $(el).hasClass('select2-hidden-accessible')) {
                $(el).val(val).trigger('change.select2');
            }
        }

        // ── Auto-select Gender based on chosen Title / Salutation (Same as B2C) ──
        function getGenderForTitle(title) {
            if (!title) return null;
            const t = title.trim().toLowerCase().replace(/\./g, '');
            if (['mr', 'master', 'shri', 'kumar', 'baba', 'baby_boy', 'babyboy'].includes(t)) {
                return 'Male';
            }
            if (['mrs', 'ms', 'miss', 'smt', 'kumari', 'baby_girl', 'babygirl'].includes(t)) {
                return 'Female';
            }
            return null;
        }

        $(document).ready(function() {
            // ── Initialize Select2 plugins ──
            if ($.fn.select2) {
                $('.s2-basic').select2({
                    theme: 'bootstrap-5',
                    width: '100%',
                    minimumResultsForSearch: Infinity
                });

                $('.s2-search').select2({
                    theme: 'bootstrap-5',
                    width: '100%',
                    allowClear: true
                });

                $('#ddlFranchise').select2({
                    theme: 'bootstrap-5',
                    width: '100%',
                    placeholder: '-- Select Franchise --',
                    allowClear: true
                });

                $('#ddlCompany').select2({
                    theme: 'bootstrap-5',
                    width: '100%',
                    placeholder: '-- Select Corporate Company --',
                    allowClear: true
                });

                function formatInvestigationOption(opt) {
                    if (!opt.id) return null;
                    var $elem = $(opt.element);
                    var isProfile = $elem.attr('data-is-profile') === '1';
                    var isPackage = $elem.attr('data-is-package') === '1';
                    var code = $elem.attr('data-code') || '';
                    var name = $elem.attr('data-name') || opt.text;
                    var tat = $elem.attr('data-tat');
                    var price = parseFloat($elem.attr('data-price')) || 0;
                    var b2bRate = parseFloat($elem.attr('data-b2b-rate')) || price;
                    var sample = $elem.attr('data-sample');

                    var badgeHtml = isPackage
                        ? '<span class="badge bg-success-subtle text-success border border-success-subtle ms-2" style="font-size:0.7rem;"><i class="bi bi-box me-1"></i>Package</span>'
                        : (isProfile
                            ? '<span class="badge bg-primary-subtle text-primary border border-primary-subtle ms-2" style="font-size:0.7rem;"><i class="bi bi-layers me-1"></i>Profile</span>'
                            : '<span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle ms-2" style="font-size:0.7rem;"><i class="bi bi-file-earmark-medical me-1"></i>Investigation</span>');
                    
                    var sampleHtml = sample ? `<span class="badge bg-info-subtle text-info border border-info-subtle ms-2" style="font-size:0.7rem;"><i class="bi bi-droplet me-1"></i>${sample}</span>` : '';
                    var tatHtml = tat ? `<span class="badge bg-light text-secondary border ms-2" style="font-size:0.72rem;"><i class="bi bi-clock me-1"></i>${tat} hrs</span>` : '';
                    
                    var priceBadge = `<span class="ms-auto ps-3 text-end">
                        <span class="text-muted text-decoration-line-through small me-1">MRP ₹${price.toFixed(2)}</span>
                        <span class="fw-bold font-monospace text-primary" style="font-size:0.92rem;">B2B ₹${b2bRate.toFixed(2)}</span>
                    </span>`;

                    return $(`
                        <div class="d-flex align-items-center justify-content-between w-100 py-0.5">
                            <div class="d-flex align-items-center flex-wrap">
                                <span class="badge bg-light text-primary font-monospace border px-1.5 py-1 me-2">${code}</span>
                                <span class="fw-semibold text-dark">${name}</span>
                                ${badgeHtml}
                                ${sampleHtml}
                                ${tatHtml}
                            </div>
                            ${priceBadge}
                        </div>
                    `);
                }

                function formatInvestigationSelection(opt) {
                    if (!opt.id) return opt.text;
                    var $elem = $(opt.element);
                    var isProfile = $elem.attr('data-is-profile') === '1';
                    var isPackage = $elem.attr('data-is-package') === '1';
                    var code = $elem.attr('data-code') || '';
                    var name = $elem.attr('data-name') || opt.text;
                    var sample = $elem.attr('data-sample');
                    var typeText = isPackage ? ' [Package]' : (isProfile ? ' [Profile]' : ' [Investigation]');
                    var sampleText = sample ? ` [Sample: ${sample}]` : '';
                    return `${code ? code + ' - ' : ''}${name}${typeText}${sampleText}`;
                }

                $('#ddlInvestigations').select2({
                    theme: 'bootstrap-5',
                    width: '100%',
                    placeholder: '-- Search by Test Code or Investigation Name --',
                    allowClear: true,
                    templateResult: formatInvestigationOption,
                    templateSelection: formatInvestigationSelection
                });
            }

            // ── Auto-Select Gender on Title Change ──
            $('#ddlSalutation').on('change', function () {
                const selectedTitle = $(this).val();
                const autoGender = getGenderForTitle(selectedTitle);
                if (autoGender) {
                    $('#ddlGender').val(autoGender).trigger('change.select2');
                    $('#ddlGender').removeClass('is-invalid');
                }
            });

            // ── Partner Dropdown Change Listeners ──
            $('#ddlFranchise').on('change select2:select', function() {
                if (currentAgentType !== 'C') {
                    onPartnerSelected($(this).val());
                }
            });

            $('#ddlCompany').on('change select2:select', function() {
                if (currentAgentType === 'C') {
                    onPartnerSelected($(this).val());
                }
            });

            // If initial partner is selected, update UI
            if (currentAgentType === 'C') {
                var cVal = $('#ddlCompany').val();
                if (cVal) onPartnerSelected(cVal);
            } else {
                var fVal = $('#ddlFranchise').val();
                if (fVal) onPartnerSelected(fVal);
            }

            // ── Check if returned from registration ──
            @if (TempData["BillNo"] != null)
            {
                <text>
                $('#lblSuccessBillNo').text('@TempData["BillNo"]');
                $('#lblSuccessPatientName').text('@TempData["NewPatientName"]');
                $('#lblSuccessPatientCode').text('@(TempData["NewPatientCode"] ?? "")'); // parity with B2C
                $('#lblSuccessB2BTotal').text('\u20b9' + '@TempData["B2BTotal"]');
                var tokenVal = '@(TempData["TokenNo"] ?? "")';
                if (tokenVal) {
                    $('#lblSuccessTokenNo').text(tokenVal);
                    $('#boxSuccessToken').removeClass('alert-secondary').addClass('alert-info');
                } else {
                    $('#lblSuccessTokenNo').text('Postpaid / On-Hold');
                    $('#boxSuccessToken').removeClass('alert-info').addClass('alert-secondary');
                }
                var pMode = '@(TempData["PaymentMode"] ?? "Credit (Postpaid)")';
                $('#lblSuccessPaymentMode').text('Mode: ' + pMode);
                var labOrderId = '@TempData["NewLabOrderId"]';
                if (labOrderId) {
                    var printUrl = '@Url.Action("PrintBill", "LabOrderBooking")' + '?labOrderId=' + labOrderId;
                    $('#btnPrintBill').attr('href', printUrl);
                }
                $('#bookingSuccessModal').modal('show');

                // ── B2B: BarcodeGenerateAtBilling parity with B2C ──────────────────
                var showBarcode = '@TempData["ShowPrintBarcode"]' === 'true';
                if (showBarcode && labOrderId) {
                    var barcodeUrl = '@Url.Action("PrintBarcode", "SampleCollection")' + '?labOrderId=' + labOrderId;
                    $('#btnPrintBarcode').removeClass('d-none').attr('href', barcodeUrl);

                    setTimeout(function () {
                        Swal.fire({
                            title: 'Print Barcode Labels?',
                            text: 'Do you want to print the barcode labels for this B2B order now?',
                            icon: 'question',
                            showCancelButton: true,
                            confirmButtonText: 'Yes, print barcodes',
                            cancelButtonText: 'No'
                        }).then(function (res) {
                            if (res.isConfirmed) {
                                window.open(barcodeUrl, '_blank');
                            }
                        });
                    }, 500);
                }
                // ────────────────────────────────────────────────────────────────────
                </text>
            }

            // ── Investigation selection handler ──
            $('#ddlInvestigations').on('select2:select', function(e) {
                var data = e.params.data;
                var valStr = data.id;
                if (!valStr) return;

                var opt = $(this).find(`option[value="${valStr}"]`);
                var parts = valStr.split('_');
                var itemType = parts[0];
                var id = parseInt(parts[1]);
                var price = parseFloat(opt.attr('data-price')) || 0;
                var b2bRate = parseFloat(opt.attr('data-b2b-rate')) || price;
                var code = opt.attr('data-code') || '';
                var name = opt.attr('data-name') || '';
                var tat = opt.attr('data-tat') || '';
                var isProfile = opt.attr('data-is-profile') === '1';
                var isPackage = opt.attr('data-is-package') === '1';
                var sampleType = opt.attr('data-sample') || '';
                var method = opt.attr('data-method') || '';

                if (lineItems.some(x => x.itemType === itemType && x.id === id)) {
                    Swal.fire({
                        icon: 'info',
                        title: 'Duplicate Test',
                        text: `${name} is already added to the order.`,
                        confirmButtonColor: '#0d6efd'
                    });
                    $(this).val('').trigger('change.select2');
                    return;
                }

                lineItems.push({
                    investigationId: id,
                    id: id,
                    itemType: itemType,
                    type: itemType,
                    code: code,
                    testCode: code,
                    name: name,
                    testName: name,
                    sampleType: sampleType,
                    tat: tat,
                    price: price,
                    b2bRate: b2bRate,
                    method: method,
                    isUrgent: false,
                    isProfile: isProfile,
                    isPackage: isPackage
                });

                renderTable();
                $(this).val('').trigger('change.select2');
            });

            // ── Top Quick Search (Same as B2C) ──
            const topSearchInput = document.getElementById('searchInput');
            const topSearchDrop  = document.getElementById('topSearchDropdown');
            let topDebounce;
            let topKbdIndex = -1;

            function getTopItems() { return Array.from(topSearchDrop.querySelectorAll('.top-sug')); }

            function setTopKbdActive(idx) {
                const items = getTopItems();
                if (!items.length) return;
                items.forEach(i => i.classList.remove('kbd-active'));
                if (idx < 0) {
                    topKbdIndex = -1;
                    return;
                }
                topKbdIndex = Math.max(0, Math.min(idx, items.length - 1));
                items[topKbdIndex].classList.add('kbd-active');
                items[topKbdIndex].scrollIntoView({ block: 'nearest', behavior: 'smooth' });
            }

            if (topSearchInput && topSearchDrop) {
                topSearchInput.addEventListener('keydown', function(e) {
                    if (topSearchDrop.style.display === 'none') return;
                    const items = getTopItems();
                    if (!items.length) return;

                    if (e.key === 'ArrowDown') {
                        e.preventDefault();
                        var next = (topKbdIndex < 0) ? 0 : (topKbdIndex + 1 >= items.length ? 0 : topKbdIndex + 1);
                        setTopKbdActive(next);
                    } else if (e.key === 'ArrowUp') {
                        e.preventDefault();
                        var prev = (topKbdIndex <= 0) ? items.length - 1 : topKbdIndex - 1;
                        setTopKbdActive(prev);
                    } else if (e.key === 'Enter') {
                        e.preventDefault();
                        var targetIdx = topKbdIndex >= 0 ? topKbdIndex : 0;
                        if (items[targetIdx]) {
                            populatePatient(items[targetIdx].dataset.id);
                            topSearchDrop.style.display = 'none';
                            topKbdIndex = -1;
                        }
                    } else if (e.key === 'Escape' || e.key === 'Tab') {
                        topSearchDrop.style.display = 'none';
                        topKbdIndex = -1;
                    }
                });

                topSearchInput.addEventListener('input', function() {
                    clearTimeout(topDebounce);
                    topKbdIndex = -1;
                    const val = this.value.trim();
                    if (val.length < 3) {
                        topSearchDrop.style.display = 'none';
                        return;
                    }

                    topDebounce = setTimeout(async () => {
                        const type = document.getElementById('searchType').value;
                        let url = '';
                        const isAllDigits = /^\d+$/.test(val);

                        if (type === 'phone') {
                            if (!isAllDigits && val.length >= 2) url = opdBase + 'SearchPatientByName?name=' + encodeURIComponent(val);
                            else url = opdBase + 'SearchPatientByPhone?phone=' + encodeURIComponent(val);
                        } else if (type === 'code') {
                            url = opdBase + 'SearchPatientByCode?code=' + encodeURIComponent(val);
                        } else {
                            if (isAllDigits && val.length >= 3) url = opdBase + 'SearchPatientByPhone?phone=' + encodeURIComponent(val);
                            else url = opdBase + 'SearchPatientByName?name=' + encodeURIComponent(val);
                        }

                        const data = await fetchJson(url);
                        if (data?.length) {
                            topSearchDrop.innerHTML = data.map((p, idx) => `
                                <button type="button"
                                        class="list-group-item list-group-item-action py-2 px-3 top-sug ${idx === 0 ? 'kbd-active' : ''}"
                                        data-id="${p.patientId}" tabindex="-1">
                                    <div class="d-flex align-items-center gap-1 flex-wrap mb-1">
                                        <span class="fw-semibold">${p.fullName}</span>
                                        <span class="badge text-bg-info text-dark font-monospace">${p.patientCode}</span>
                                        ${p.relationName ? `<span class="badge text-bg-primary">${p.relationName}</span>` : ''}
                                        ${p.bloodGroup   ? `<span class="badge text-bg-danger">${p.bloodGroup}</span>`   : ''}
                                    </div>
                                    <small class="text-muted">${p.phoneNumber} &nbsp;·&nbsp; ${p.gender || ''}</small>
                                </button>`).join('');
                            topSearchDrop.style.display = 'block';
                            topKbdIndex = 0;

                            topSearchDrop.querySelectorAll('.top-sug').forEach((btn, i) => {
                                btn.addEventListener('mouseenter', () => {
                                    getTopItems().forEach(b => b.classList.remove('kbd-active'));
                                    btn.classList.add('kbd-active');
                                    topKbdIndex = i;
                                });
                                btn.addEventListener('mousedown', (e) => { e.preventDefault(); });
                                btn.addEventListener('click', () => {
                                    populatePatient(btn.dataset.id);
                                    topSearchDrop.style.display = 'none';
                                    topKbdIndex = -1;
                                });
                            });
                        } else {
                            topSearchDrop.style.display = 'none';
                            topKbdIndex = -1;
                        }
                    }, 300);
                });

                document.addEventListener('click', e => {
                    if (!topSearchDrop.contains(e.target) && e.target !== topSearchInput) {
                        topSearchDrop.style.display = 'none';
                        topKbdIndex = -1;
                    }
                });

                $('#btnTopSearch').on('click', async function() {
                    const val = topSearchInput.value.trim();
                    if (!val) return;
                    const type = document.getElementById('searchType').value;
                    let url = '';
                    if (type === 'phone') url = opdBase + 'SearchPatientByPhone?phone=' + encodeURIComponent(val);
                    else if (type === 'code') url = opdBase + 'SearchPatientByCode?code=' + encodeURIComponent(val);
                    else url = opdBase + 'SearchPatientByName?name=' + encodeURIComponent(val);
                    await openSearchModal(url);
                });
            }

            // ── Inside-form Phone Number Search & Live Suggestion (Same as B2C) ──
            const phoneInput = document.getElementById('phoneNumber');
            const phoneDrop  = document.getElementById('phoneSearchDropdown');
            let phoneDebounce;
            let phoneKbdIndex = -1;

            function getPhoneItems() { return Array.from(phoneDrop.querySelectorAll('.phone-sug')); }

            function setPhoneKbdActive(idx) {
                const items = getPhoneItems();
                if (!items.length) return;
                items.forEach(i => i.classList.remove('kbd-active'));
                if (idx < 0) {
                    phoneKbdIndex = -1;
                    return;
                }
                phoneKbdIndex = Math.max(0, Math.min(idx, items.length - 1));
                items[phoneKbdIndex].classList.add('kbd-active');
                items[phoneKbdIndex].scrollIntoView({ block: 'nearest', behavior: 'smooth' });
            }

            if (phoneInput && phoneDrop) {
                phoneInput.addEventListener('keydown', function (e) {
                    var allowed = ['Backspace','Delete','Tab','ArrowLeft','ArrowRight','Home','End'];
                    if (allowed.includes(e.key) || e.ctrlKey || e.metaKey) return;

                    if (phoneDrop.style.display !== 'none') {
                        const items = getPhoneItems();
                        if (e.key === 'ArrowDown') {
                            e.preventDefault();
                            var next = (phoneKbdIndex < 0) ? 0 : (phoneKbdIndex + 1 >= items.length ? 0 : phoneKbdIndex + 1);
                            setPhoneKbdActive(next);
                            return;
                        } else if (e.key === 'ArrowUp') {
                            e.preventDefault();
                            var prev = (phoneKbdIndex <= 0) ? items.length - 1 : phoneKbdIndex - 1;
                            setPhoneKbdActive(prev);
                            return;
                        } else if (e.key === 'Enter') {
                            e.preventDefault();
                            var targetIdx = phoneKbdIndex >= 0 ? phoneKbdIndex : 0;
                            if (items[targetIdx]) {
                                populatePatient(items[targetIdx].dataset.id);
                                phoneDrop.style.display = 'none';
                                phoneKbdIndex = -1;
                            }
                            return;
                        } else if (e.key === 'Escape' || e.key === 'Tab') {
                            phoneDrop.style.display = 'none';
                            phoneKbdIndex = -1;
                        }
                    }

                    if (!/^[0-9]$/.test(e.key)) e.preventDefault();
                });

                phoneInput.addEventListener('input', function () {
                    var cleaned = phoneInput.value.replace(/\D/g, '').slice(0, 10);
                    if (phoneInput.value !== cleaned) phoneInput.value = cleaned;

                    clearTimeout(phoneDebounce);
                    phoneKbdIndex = -1;
                    const val = cleaned.trim();
                    if (val.length < 3) {
                        phoneDrop.style.display = 'none';
                        return;
                    }

                    phoneDebounce = setTimeout(async () => {
                        const data = await fetchJson(opdBase + 'SearchPatientByPhone?phone=' + encodeURIComponent(val));
                        if (data?.length) {
                            phoneDrop.innerHTML = data.map((p, idx) => `
                                <button type="button"
                                        class="list-group-item list-group-item-action py-2 px-3 phone-sug ${idx === 0 ? 'kbd-active' : ''}"
                                        data-id="${p.patientId}" tabindex="-1">
                                    <div class="d-flex align-items-center gap-1 flex-wrap mb-1">
                                        <span class="fw-semibold">${p.fullName}</span>
                                        <span class="badge text-bg-info text-dark font-monospace">${p.patientCode}</span>
                                        ${p.relationName ? `<span class="badge text-bg-primary">${p.relationName}</span>` : ''}
                                        ${p.bloodGroup   ? `<span class="badge text-bg-danger">${p.bloodGroup}</span>`   : ''}
                                    </div>
                                    <small class="text-muted">${p.phoneNumber} &nbsp;·&nbsp; ${p.gender || ''}</small>
                                </button>`).join('');
                            phoneDrop.style.display = 'block';
                            phoneKbdIndex = 0;

                            phoneDrop.querySelectorAll('.phone-sug').forEach((btn, i) => {
                                btn.addEventListener('mouseenter', () => {
                                    getPhoneItems().forEach(b => b.classList.remove('kbd-active'));
                                    btn.classList.add('kbd-active');
                                    phoneKbdIndex = i;
                                });
                                btn.addEventListener('mousedown', (e) => { e.preventDefault(); });
                                btn.addEventListener('click', () => {
                                    populatePatient(btn.dataset.id);
                                    phoneDrop.style.display = 'none';
                                    phoneKbdIndex = -1;
                                });
                            });
                        } else {
                            phoneDrop.style.display = 'none';
                            phoneKbdIndex = -1;
                        }
                    }, 300);
                });

                phoneInput.addEventListener('blur', function () {
                    var v = phoneInput.value.replace(/\D/g, '');
                    var phErr = document.getElementById('phoneError');
                    if (v.length === 0) {
                        phoneInput.classList.remove('is-invalid', 'is-valid');
                        if (phErr) phErr.style.display = 'none';
                    } else if (v.length < 10) {
                        phoneInput.classList.add('is-invalid');
                        phoneInput.classList.remove('is-valid');
                        if (phErr) {
                            phErr.textContent = 'Phone number must be exactly 10 digits.';
                            phErr.style.display = 'block';
                        }
                    } else {
                        phoneInput.classList.remove('is-invalid');
                        phoneInput.classList.add('is-valid');
                        if (phErr) phErr.style.display = 'none';
                    }
                });

                document.addEventListener('click', e => {
                    if (!phoneDrop.contains(e.target) && e.target !== phoneInput) {
                        phoneDrop.style.display = 'none';
                        phoneKbdIndex = -1;
                    }
                });
            }

            // Search patient icon button
