        function loadSubCategories() {
            var cat = $('#ddlCategory').val();
            var $subCat = $('#ddlSubCategory');
            $subCat.empty().append('<option value="">-- All Sub Categories --</option>');

            if (cat) {
                $.get('/LabOrderBooking/GetSubCategoriesForDropdown?categoryId=' + cat, function(res) {
                    if (res && res.length > 0) {
