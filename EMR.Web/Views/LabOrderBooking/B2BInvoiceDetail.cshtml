@model EMR.Web.Models.DTOs.B2BInvoiceDetailDto
@{
    ViewData["Title"] = $"Tax Invoice {Model.InvoiceNo}";
    var lh = ViewBag.Letterhead as EMR.Web.Models.ViewModels.B2BInvoiceLetterheadViewModel
             ?? new EMR.Web.Models.ViewModels.B2BInvoiceLetterheadViewModel { DisplayName = Model.BranchName ?? "Diagnostic Laboratory" };
    var items = Model.Items ?? new List<EMR.Web.Models.DTOs.B2BInvoiceItemDto>();
    var dateGroups = items.GroupBy(i => i.OrderDate.Date).OrderBy(g => g.Key).ToList();
    int testCount = Model.TestLines != null && Model.TestLines.Any() ? Model.TestLines.Count : items.Sum(i => i.Tests?.Count > 0 ? i.Tests.Count : 1);
    var periodFrom = items.Any() ? items.Min(i => i.OrderDate) : (DateTime?)null;
    var periodTo = items.Any() ? items.Max(i => i.OrderDate) : (DateTime?)null;
    var statusText = Model.Status == "P" ? "Paid" : Model.Status == "R" ? "Partially Paid" : "Unpaid";
    var statusCls = Model.Status == "P" ? "st-paid" : Model.Status == "R" ? "st-partial" : "st-unpaid";
    var partnerTypeText = Model.PartnerType == "C" ? "Corporate" : "Franchise";
    decimal taxable = Model.TotalAmount - Model.DiscountAmount;
    decimal balance = Math.Max(0, Model.BalanceAmount);
    bool showLegal = !string.IsNullOrWhiteSpace(lh.LegalName) && !string.Equals(lh.LegalName, lh.DisplayName, StringComparison.OrdinalIgnoreCase);
}

@section HeadStyles {
    <style>
        /* B2B tax invoice - A4 document, prints as it looks on screen */
        .tinv-wrap { --ink:#111827; --muted:#4b5563; --soft:#6b7280; --rule:#d1d5db; --rule-soft:#e5e7eb; --band:#f3f4f6; --accent:#1e3a5f; --accent-soft:#eef2f7;
                     max-width: 900px; margin: auto; color: var(--ink); font-family: 'Inter', 'Segoe UI', system-ui, -apple-system, Arial, sans-serif; }
        .tinv-actions { display:flex; justify-content:space-between; align-items:center; gap:.5rem; margin-bottom:.75rem; flex-wrap:wrap; }
        .tinv { background:#fff; border:1px solid var(--rule); box-shadow:0 1px 3px rgba(0,0,0,.06); padding:28px 32px; font-size:12.5px; line-height:1.45; }

        /* letterhead */
        .tinv-head { display:flex; justify-content:space-between; align-items:flex-start; gap:24px; padding-bottom:14px; border-bottom:3px solid var(--accent); }
        .tinv-brand { display:flex; gap:14px; align-items:flex-start; min-width:0; }
        .tinv-logo { width:64px; height:64px; object-fit:contain; flex-shrink:0; }
        .tinv-logo-ph { width:56px; height:56px; border-radius:8px; background:var(--accent); color:#fff; display:flex; align-items:center; justify-content:center; font-size:26px; flex-shrink:0; }
        .tinv-name { font-size:20px; font-weight:800; color:var(--accent); letter-spacing:-.2px; line-height:1.2; }
        .tinv-legal { font-size:12px; font-weight:600; color:var(--ink); }
        .tinv-line { color:var(--muted); font-size:11.5px; }
        .tinv-line b { color:var(--ink); font-weight:600; }
        .tinv-title { text-align:right; flex-shrink:0; }
        .tinv-title h1 { font-size:24px; font-weight:800; letter-spacing:3px; margin:0; color:var(--ink); }
        .tinv-title .copy { font-size:10.5px; text-transform:uppercase; letter-spacing:1px; color:var(--soft); margin-top:2px; }

        /* boxed grids */
        .tinv-meta { display:grid; grid-template-columns:repeat(4, 1fr); border:1px solid var(--rule); border-top:0; }
        .tinv-meta > div { padding:8px 10px; border-right:1px solid var(--rule); }
        .tinv-meta > div:last-child { border-right:0; }
        .lbl { display:block; font-size:9.5px; font-weight:700; text-transform:uppercase; letter-spacing:.6px; color:var(--soft); margin-bottom:2px; }
        .val { font-weight:700; color:var(--ink); }
        .mono { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; }
        .tinv-parties { display:grid; grid-template-columns:1fr 1fr; border:1px solid var(--rule); border-top:0; }
        .tinv-parties > div { padding:10px 12px; }
        .tinv-parties > div + div { border-left:1px solid var(--rule); }
        .party-name { font-size:14px; font-weight:800; color:var(--ink); margin-bottom:2px; }
        .kv { display:flex; justify-content:space-between; gap:12px; padding:1px 0; }
        .kv span:first-child { color:var(--muted); }
        .kv span:last-child { font-weight:600; text-align:right; }
        .st { display:inline-block; padding:1px 8px; border-radius:3px; font-size:10.5px; font-weight:700; text-transform:uppercase; letter-spacing:.5px; border:1px solid; }
        .st-paid { color:#166534; border-color:#86efac; background:#f0fdf4; }
        .st-partial { color:#92400e; border-color:#fcd34d; background:#fffbeb; }
        .st-unpaid { color:#991b1b; border-color:#fca5a5; background:#fef2f2; }

        /* items */
        .tinv-items { width:100%; border-collapse:collapse; margin-top:14px; font-size:12px; }
        .tinv-items thead th { background:var(--accent); color:#fff; font-size:10px; font-weight:700; text-transform:uppercase; letter-spacing:.5px; padding:7px 8px; border:1px solid var(--accent); text-align:left; }
        .tinv-items td { padding:6px 8px; border-left:1px solid var(--rule-soft); border-right:1px solid var(--rule-soft); border-bottom:1px solid var(--rule-soft); vertical-align:top; }
        .tinv-items .num { text-align:right; font-variant-numeric:tabular-nums; white-space:nowrap; }
        .tinv-items tr.grp td { background:var(--band); font-weight:700; font-size:11px; color:var(--ink); border-color:var(--rule); }
        .tinv-items tr.ord-sub td { color:var(--muted); font-size:11px; background:#fafafa; }
        .tinv-items tr.grp-sub td { font-weight:700; border-bottom:1px solid var(--rule); }
        .tinv-items tfoot td { border:1px solid var(--rule); font-weight:800; background:var(--accent-soft); padding:8px; }
        .tag { display:inline-block; font-size:9px; font-weight:700; letter-spacing:.4px; padding:0 5px; border:1px solid var(--rule); border-radius:3px; color:var(--muted); margin-left:4px; vertical-align:1px; }

        /* summary */
        .tinv-summary { display:grid; grid-template-columns:1fr 300px; gap:16px; margin-top:14px; align-items:start; }
        .box { border:1px solid var(--rule); padding:10px 12px; }
        .box + .box { margin-top:10px; }
        .words { font-weight:700; font-style:italic; }
        .totals { width:100%; border-collapse:collapse; border:1px solid var(--rule); }
        .totals td { padding:6px 10px; border-bottom:1px solid var(--rule-soft); }
        .totals td:last-child { text-align:right; font-variant-numeric:tabular-nums; white-space:nowrap; font-weight:600; }
        .totals tr.net td { background:var(--accent); color:#fff; font-weight:800; font-size:13.5px; border-bottom:0; }
        .totals tr.bal td { font-weight:800; border-top:1px solid var(--rule); }
        .terms { margin:0; padding-left:16px; color:var(--muted); font-size:11px; }

        /* sign-off */
        .tinv-sign { display:flex; justify-content:space-between; align-items:flex-end; gap:16px; margin-top:22px; }
        .sign-box { text-align:right; min-width:240px; }
        .sign-space { height:52px; }
        .sign-line { border-top:1px solid var(--ink); padding-top:4px; font-weight:700; }
        .tinv-foot { margin-top:16px; padding-top:8px; border-top:1px solid var(--rule); display:flex; justify-content:space-between; gap:12px; color:var(--soft); font-size:10.5px; }

        @@media (max-width: 760px) {
            .tinv { padding:16px; }
            .tinv-head, .tinv-sign { flex-direction:column; align-items:flex-start; }
            .tinv-title { text-align:left; }
            .tinv-meta { grid-template-columns:1fr 1fr; }
            .tinv-meta > div:nth-child(2n) { border-right:0; }
            .tinv-meta > div:nth-child(-n+2) { border-bottom:1px solid var(--rule); }
            .tinv-parties, .tinv-summary { grid-template-columns:1fr; }
            .tinv-parties > div + div { border-left:0; border-top:1px solid var(--rule); }
            .tinv-items-scroll { overflow-x:auto; }
            .sign-box { text-align:left; }
        }

        @@page { size: A4; margin: 12mm 10mm; }
        @@media print {
            body { background:#fff !important; }
            body * { visibility:hidden; }
            .tinv, .tinv * { visibility:visible; }
            .tinv { position:absolute; left:0; top:0; width:100%; border:0; box-shadow:none; padding:0; }
            .no-print { display:none !important; }
            .tinv * { -webkit-print-color-adjust:exact; print-color-adjust:exact; }
            .tinv-items thead { display:table-header-group; }
            .tinv-items tr, .tinv-summary, .tinv-sign { page-break-inside:avoid; break-inside:avoid; }
        }
    </style>
}

<div class="tinv-wrap py-3">
    @* actions - not printed *@
    <div class="tinv-actions no-print">
        <a asp-action="B2BInvoices" class="btn btn-outline-secondary btn-sm px-3 fw-semibold">
            <i class="bi bi-arrow-left me-1"></i> Back to Invoices List
        </a>
        <div class="d-flex gap-2">
            @if (Model.Status != "P")
            {
                <a asp-action="B2BSettlement" asp-encrypted-qs="agentType=@Model.PartnerType&agentId=@Model.PartnerId" class="btn btn-success btn-sm px-3 fw-bold">
                    <i class="bi bi-wallet2 me-1"></i> Settle Payment
                </a>
            }
            <button type="button" class="btn btn-primary btn-sm px-4 fw-bold" onclick="window.print()">
                <i class="bi bi-printer me-1"></i> Print Invoice
            </button>
        </div>
    </div>

    <div class="tinv">
        <!-- Letterhead -->
        <div class="tinv-head">
            <div class="tinv-brand">
                @if (!string.IsNullOrWhiteSpace(lh.LogoPath))
                {
                    <img src="@lh.LogoPath" class="tinv-logo" alt="Logo" />
                }
                else
                {
                    <div class="tinv-logo-ph"><i class="bi bi-hospital"></i></div>
                }
                <div>
                    <div class="tinv-name">@lh.DisplayName</div>
                    @if (showLegal) { <div class="tinv-legal">@lh.LegalName</div> }
                    @if (!string.IsNullOrWhiteSpace(lh.Address)) { <div class="tinv-line">@lh.Address</div> }
                    @{
                        var contacts = new List<string>();
                        if (!string.IsNullOrWhiteSpace(lh.Phone)) contacts.Add("Ph: " + lh.Phone);
                        if (!string.IsNullOrWhiteSpace(lh.Email)) contacts.Add(lh.Email!);
                        if (!string.IsNullOrWhiteSpace(lh.Website)) contacts.Add(lh.Website!.Replace("https://", "").Replace("http://", "").TrimEnd('/'));
                    }
                    @if (contacts.Any()) { <div class="tinv-line">@string.Join("  ·  ", contacts)</div> }
                    <div class="tinv-line">
                        @if (!string.IsNullOrWhiteSpace(lh.GSTIN)) { <span>GSTIN: <b class="mono">@lh.GSTIN</b></span> }
                        @if (!string.IsNullOrWhiteSpace(lh.PAN)) { <span>&nbsp;·&nbsp; PAN: <b class="mono">@lh.PAN</b></span> }
                        @if (!string.IsNullOrWhiteSpace(lh.State)) { <span>&nbsp;·&nbsp; State: <b>@(lh.State + (lh.StateCode != null ? $" ({lh.StateCode})" : ""))</b></span> }
                    </div>
                    @if (!string.IsNullOrWhiteSpace(lh.RegistrationNumber)) { <div class="tinv-line">Regn. No: <b>@lh.RegistrationNumber</b></div> }
                </div>
            </div>
            <div class="tinv-title">
                <h1>TAX INVOICE</h1>
                <div class="copy">Original for Recipient</div>
            </div>
        </div>

        <!-- Invoice details -->
        <div class="tinv-meta">
            <div><span class="lbl">Invoice No</span><span class="val mono">@Model.InvoiceNo</span></div>
            <div><span class="lbl">Invoice Date</span><span class="val">@Model.InvoiceDate.ToString("dd MMM yyyy")</span></div>
            <div><span class="lbl">Due Date</span><span class="val">@Model.DueDate.ToString("dd MMM yyyy")</span></div>
            <div><span class="lbl">Payment Status</span><span class="st @statusCls">@statusText</span></div>
        </div>

        <!-- Bill to / invoice summary -->
        <div class="tinv-parties">
            <div>
                <span class="lbl">Bill To</span>
                <div class="party-name">@Model.PartnerName</div>
                <div class="tinv-line">@partnerTypeText Partner &nbsp;·&nbsp; Code: <b class="mono">@Model.PartnerCode</b></div>
                @if (!string.IsNullOrWhiteSpace(Model.PartnerAddress)) { <div class="tinv-line">@Model.PartnerAddress</div> }
                @if (!string.IsNullOrWhiteSpace(Model.PartnerPhone)) { <div class="tinv-line">Ph: @Model.PartnerPhone</div> }
                @if (!string.IsNullOrWhiteSpace(Model.PartnerEmail)) { <div class="tinv-line">@Model.PartnerEmail</div> }
            </div>
            <div>
                <span class="lbl">Invoice Summary</span>
                <div class="kv"><span>Billing cycle</span><span>@(string.IsNullOrWhiteSpace(Model.BillingCycle) ? "—" : Model.BillingCycle)</span></div>
                <div class="kv"><span>Service period</span><span>@(periodFrom.HasValue ? $"{periodFrom:dd MMM yyyy} – {periodTo:dd MMM yyyy}" : "—")</span></div>
                <div class="kv"><span>Lab orders / tests</span><span>@items.Count / @testCount</span></div>
                <div class="kv"><span>Billing branch</span><span>@((Model.BranchName ?? "—") + (string.IsNullOrWhiteSpace(Model.BranchCode) ? "" : $" ({Model.BranchCode})"))</span></div>
            </div>
        </div>

        <!-- Line items -->
        <div class="tinv-items-scroll">
            <table class="tinv-items">
                <thead>
                    <tr>
                        <th style="width:34px;">#</th>
                        <th style="width:130px;">Bill No</th>
                        <th style="width:170px;">Patient</th>
                        <th>Investigation</th>
                        <th style="width:110px;">Code / Dept</th>
                        <th style="width:105px;" class="num">Amount (₹)</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!dateGroups.Any())
                    {
                        <tr><td colspan="6" class="text-center py-4" style="color:var(--soft)">No bills in this invoice.</td></tr>
                    }
                    @{ int sl = 1; }
                    @foreach (var group in dateGroups)
                    {
                        decimal groupTotal = group.Sum(o => o.B2BTotal > 0 ? o.B2BTotal : o.Amount);
                        int groupTests = group.Sum(o => o.Tests != null && o.Tests.Any() ? o.Tests.Count : 1);
                        <tr class="grp">
                            <td colspan="6">Order date: @group.Key.ToString("dd MMM yyyy") &nbsp;·&nbsp; @group.Count() order(s), @groupTests test(s)</td>
                        </tr>
                        foreach (var order in group)
                        {
                            var tests = order.Tests ?? new List<EMR.Web.Models.DTOs.B2BInvoiceTestLineDto>();
                            if (tests.Any())
                            {
                                for (int t = 0; t < tests.Count; t++)
                                {
                                    var test = tests[t];
                                    <tr>
                                        @if (t == 0)
                                        {
                                            <td rowspan="@tests.Count">@(sl++)</td>
                                            <td rowspan="@tests.Count" class="mono">@order.BillNo</td>
                                            <td rowspan="@tests.Count"><b>@order.PatientName</b><div style="color:var(--soft);font-size:10.5px;" class="mono">@(order.PatientCode ?? "")</div></td>
                                        }
                                        <td>@test.TestName @if (test.ItemType == "P") { <span class="tag">PROFILE</span> }</td>
                                        <td><span class="mono">@(test.TestCode ?? "—")</span><div style="color:var(--soft);font-size:10.5px;">@(test.DepartmentName ?? "")</div></td>
                                        <td class="num">@test.B2BRate.ToString("N2")</td>
                                    </tr>
                                }
                                if (tests.Count > 1)
                                {
                                    <tr class="ord-sub">
                                        <td colspan="5" class="num">Bill @order.BillNo total</td>
                                        <td class="num">@order.B2BTotal.ToString("N2")</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td>@(sl++)</td>
                                    <td class="mono">@order.BillNo</td>
                                    <td><b>@order.PatientName</b><div style="color:var(--soft);font-size:10.5px;" class="mono">@(order.PatientCode ?? "")</div></td>
                                    <td>@(order.TestNames ?? "Investigation")</td>
                                    <td>—</td>
                                    <td class="num">@((order.B2BTotal > 0 ? order.B2BTotal : order.Amount).ToString("N2"))</td>
                                </tr>
                            }
                        }
                        <tr class="grp-sub">
                            <td colspan="5" class="num">Subtotal for @group.Key.ToString("dd MMM yyyy")</td>
                            <td class="num">@groupTotal.ToString("N2")</td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <td colspan="5" class="num">Total (@items.Count orders, @testCount tests)</td>
                        <td class="num">@Model.TotalAmount.ToString("N2")</td>
                    </tr>
                </tfoot>
            </table>
        </div>

        <!-- Amount in words, bank, terms | totals -->
        <div class="tinv-summary">
            <div>
                <div class="box">
                    <span class="lbl">Amount in words</span>
                    <div class="words">@Model.AmountInWords</div>
                </div>
                <div class="box">
                    <span class="lbl">Payment details</span>
                    @if (lh.HasBank)
                    {
                        <div class="kv"><span>Account name</span><span>@lh.PayeeName</span></div>
                        @if (!string.IsNullOrWhiteSpace(lh.BankName)) { <div class="kv"><span>Bank</span><span>@(lh.BankName + (string.IsNullOrWhiteSpace(lh.BankBranch) ? "" : ", " + lh.BankBranch))</span></div> }
                        @if (!string.IsNullOrWhiteSpace(lh.BankAccountNumber)) { <div class="kv"><span>Account no</span><span class="mono">@lh.BankAccountNumber</span></div> }
                        @if (!string.IsNullOrWhiteSpace(lh.BankIfsc)) { <div class="kv"><span>IFSC</span><span class="mono">@lh.BankIfsc</span></div> }
                        @if (!string.IsNullOrWhiteSpace(lh.UpiId)) { <div class="kv"><span>UPI</span><span class="mono">@lh.UpiId</span></div> }
                    }
                    else
                    {
                        <div class="tinv-line">NEFT / RTGS / cheque in favour of <b>@lh.PayeeName</b>. Please quote invoice no <b class="mono">@Model.InvoiceNo</b> with the payment.</div>
                    }
                </div>
                <div class="box">
                    <span class="lbl">Terms &amp; conditions</span>
                    <ol class="terms">
                        <li>Payment is due on or before <b>@Model.DueDate.ToString("dd MMM yyyy")</b> as per the agreed credit terms.</li>
                        <li>Any discrepancy in billing, rates or test counts must be reported in writing within 7 days of the invoice date.</li>
                        <li>Cheque / demand draft to be drawn in favour of <b>@lh.PayeeName</b>.</li>
                    </ol>
                </div>
                @if (!string.IsNullOrWhiteSpace(Model.Notes))
                {
                    <div class="box"><span class="lbl">Notes</span><div>@Model.Notes</div></div>
                }
            </div>
            <table class="totals">
                <tr><td>Gross amount</td><td>₹ @Model.TotalAmount.ToString("N2")</td></tr>
                @if (Model.DiscountAmount > 0)
                {
                    <tr><td>Less: discount</td><td>− ₹ @Model.DiscountAmount.ToString("N2")</td></tr>
                    <tr><td>Taxable value</td><td>₹ @taxable.ToString("N2")</td></tr>
                }
                <tr><td>GST</td><td>@(Model.TaxAmount > 0 ? "₹ " + Model.TaxAmount.ToString("N2") : "Nil")</td></tr>
                <tr class="net"><td>Invoice total</td><td>₹ @Model.NetAmount.ToString("N2")</td></tr>
                <tr><td>Amount received</td><td>₹ @Model.PaidAmount.ToString("N2")</td></tr>
                <tr class="bal"><td>Balance due</td><td style="color:@(balance > 0 ? "#991b1b" : "#166534")">₹ @balance.ToString("N2")</td></tr>
            </table>
        </div>

        <!-- Sign-off -->
        <div class="tinv-sign">
            <div class="tinv-line" style="max-width:420px;">
                Prepared on @Model.CreatedDate.ToString("dd MMM yyyy, hh:mm tt")@(string.IsNullOrWhiteSpace(Model.CreatedByName) ? "" : " by " + Model.CreatedByName).
            </div>
            <div class="sign-box">
                <div class="tinv-line">For <b>@lh.PayeeName</b></div>
                <div class="sign-space"></div>
                <div class="sign-line">Authorised Signatory</div>
            </div>
        </div>

        <div class="tinv-foot">
            <span>This is a computer-generated invoice.</span>
            <span class="mono">@Model.InvoiceNo</span>
        </div>
    </div>
</div>
