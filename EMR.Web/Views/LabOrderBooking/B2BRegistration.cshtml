@model EMR.Web.Models.ViewModels.LabOrderPagedListViewModel
@{
    ViewData["Title"] = "B2B Registration & Order List";
    var fromDate = Model.FromDate ?? DateTime.Today.AddDays(-30).ToString("yyyy-MM-dd");
    var toDate   = Model.ToDate   ?? DateTime.Today.ToString("yyyy-MM-dd");
    var from     = Model.TotalCount > 0 ? (Model.Page - 1) * Model.PageSize + 1 : 0;
    var to       = Math.Min(Model.Page * Model.PageSize, Model.TotalCount);
}

@section HeadStyles {
    <style>
        .stat-card { border-radius:12px; border:1px solid #e9ecef; background:#fff; box-shadow:0 1px 4px rgba(0,0,0,.06); padding:1rem 1.4rem; }
        .stat-card .stat-icon { width:44px;height:44px;border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:1.3rem; }
        .stat-card .stat-val  { font-size:1.6rem;font-weight:700;line-height:1; }
        .table>thead>tr>th { font-size:.78rem; text-transform:uppercase; letter-spacing:.5px; color:#6c757d; border-bottom:2px solid #dee2e6; white-space:nowrap; }
        .table>tbody>tr>td { font-size:.88rem; vertical-align:middle; }
        .badge-status-P { background:#d1e7dd; color:#0f5132; }
        .badge-status-R { background:#fff3cd; color:#664d03; }
        .badge-status-U { background:#f8d7da; color:#842029; }
        .partner-badge-F { background:#e0f2fe; color:#0369a1; border:1px solid #bae6fd; }
        .partner-badge-C { background:#f3e8ff; color:#6b21a8; border:1px solid #e9d5ff; }
    </style>
}

@* ── Payment Modal (Standby mode for on-demand collection) ── *@
@{
    ViewData["PaymentModuleCode"]     = "LAB";
    ViewData["PaymentModuleRefId"]    = 0;
    ViewData["PaymentSuccessModalId"] = "";
}
<partial name="_PaymentModal" />

@* ── Page header ── *@
<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <div>
        <h1 class="h3 mb-0 fw-bold">
            <i class="bi bi-building-add me-2 text-primary"></i>B2B Registration &amp; Order List
        </h1>
        <small class="text-muted">Laboratory B2B franchise &amp; corporate bookings, contracted test investigations &amp; billing</small>
    </div>
    <div class="d-flex gap-2 align-items-center">
        <span class="badge text-bg-primary fs-6 px-3 py-2"><i class="bi bi-buildings me-1"></i>B2B LAB</span>
        <a asp-action="B2BBooking" class="btn btn-primary px-3 fw-semibold shadow-sm">
            <i class="bi bi-building-add me-2"></i>B2B Registration
        </a>
    </div>
</div>

@* ── Stat cards ── *@
<div class="row g-3 mb-3">
    <div class="col-6 col-md-2" style="flex: 1 1 200px;">
        <div class="stat-card d-flex gap-3 align-items-center">
            <div class="stat-icon" style="background:#e0f2fe;color:#0369a1"><i class="bi bi-receipt-cutoff"></i></div>
            <div>
                <div class="stat-val text-primary">@Model.Stats.TotalOrders</div>
                <div class="text-muted small">B2B Orders</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-2" style="flex: 1 1 200px;">
        <div class="stat-card d-flex gap-3 align-items-center">
            <div class="stat-icon" style="background:#d1e7dd;color:#0a3622"><i class="bi bi-check2-circle"></i></div>
            <div>
                <div class="stat-val text-success">@Model.Stats.PaidCount</div>
                <div class="text-muted small">Fully Paid</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-2" style="flex: 1 1 200px;">
        <div class="stat-card d-flex gap-3 align-items-center">
            <div class="stat-icon" style="background:#fff3cd;color:#664d03"><i class="bi bi-clock-history"></i></div>
            <div>
                <div class="stat-val text-warning-emphasis">@Model.Stats.UnpaidCount</div>
                <div class="text-muted small">Unpaid / Partial</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3" style="flex: 1 1 240px;">
        <div class="stat-card d-flex gap-3 align-items-center">
            <div class="stat-icon" style="background:#f1f5f9;color:#475569"><i class="bi bi-tags"></i></div>
            <div>
                <div class="stat-val text-secondary">₹@Model.Stats.TotalAmount.ToString("N2")</div>
                <div class="text-muted small">Standard MRP Total</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3" style="flex: 1 1 240px;">
        <div class="stat-card d-flex gap-3 align-items-center" style="border-left: 4px solid #10b981;">
            <div class="stat-icon" style="background:#ecfdf5;color:#059669"><i class="bi bi-cash-stack"></i></div>
            <div>
                <div class="stat-val text-success">₹@Model.Stats.B2BTotalAmount.ToString("N2")</div>
                <div class="text-muted small">B2B Contract Total</div>
            </div>
        </div>
    </div>
</div>

@* ── Filter bar ── *@
<div class="card border-0 shadow-sm mb-3">
    <div class="card-body py-2 px-3">
        <form method="get" asp-action="B2BRegistration" class="row g-2 align-items-end">
            <div class="col-auto">
                <label class="form-label small fw-semibold mb-1">From Date</label>
                <input type="date" name="fromDate" value="@fromDate" class="form-control form-control-sm" />
            </div>
            <div class="col-auto">
                <label class="form-label small fw-semibold mb-1">To Date</label>
                <input type="date" name="toDate" value="@toDate" class="form-control form-control-sm" />
            </div>
            <div class="col-auto">
                <label class="form-label small fw-semibold mb-1">Search</label>
                <input type="text" name="search" value="@Model.Search" placeholder="Bill / Token / Patient / Partner..." class="form-control form-control-sm" style="min-width:260px;" />
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-sm btn-primary px-3 fw-semibold">
                    <i class="bi bi-funnel me-1"></i>Filter
                </button>
                <a asp-action="B2BRegistration" class="btn btn-sm btn-outline-secondary ms-1">
                    <i class="bi bi-x-circle me-1"></i>Clear
                </a>
            </div>
        </form>
    </div>
</div>

@* ── Orders table ── *@
<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="ps-3">Bill No / Token</th>
                    <th>Date &amp; Time</th>
                    <th>Patient</th>
                    <th>Partner Type</th>
                    <th>Franchise / Company</th>
                    <th>Investigations</th>
                    <th>Collection</th>
                    <th class="text-end">Standard MRP</th>
                    <th class="text-end">B2B Amount</th>
                    <th class="text-center">Status</th>
                    <th class="text-center pe-3">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Items.Count == 0)
                {
                    <tr>
                        <td colspan="11" class="text-center py-5 text-muted">
                            <i class="bi bi-inbox fs-1 d-block mb-2 text-secondary"></i>
                            No B2B orders found for the selected criteria.
                            <div class="mt-2">
                                <a asp-action="B2BBooking" class="btn btn-sm btn-primary">
                                    <i class="bi bi-plus-circle me-1"></i>Create First B2B Registration
                                </a>
                            </div>
                        </td>
                    </tr>
                }
                @foreach (var item in Model.Items)
                {
                    var statusClass = item.PaymentStatus switch
                    {
                        "P" => "badge-status-P",
                        "R" => "badge-status-R",
                        _   => "badge-status-U"
                    };
                    var statusText = item.PaymentStatus switch
                    {
                        "P" => "Paid",
                        "R" => "Partial",
                        _   => "Unpaid"
                    };
                    var partnerClass = item.AgentType == "C" ? "partner-badge-C" : "partner-badge-F";
                    var partnerLabel = item.AgentType == "C" ? "Company" : "Franchise";

                    <tr>
                        <td class="ps-3">
                            <span class="fw-bold font-monospace text-primary">@item.BillNo</span>
                            @if (!string.IsNullOrEmpty(item.TokenNo))
                            {
                                <span class="badge bg-secondary-subtle text-secondary ms-1 font-monospace">@item.TokenNo</span>
                            }
                            @if (item.IsUrgent)
                            {
                                <span class="badge bg-danger ms-1" style="font-size:0.7rem;"><i class="bi bi-lightning-charge-fill me-0.5"></i>Urgent</span>
                            }
                        </td>
                        <td>
                            <div class="fw-semibold small">@item.OrderDate.ToString("dd MMM yyyy")</div>
                            <div class="text-muted" style="font-size:.78rem;">@item.OrderDate.ToString("hh:mm tt")</div>
                        </td>
                        <td>
                            <div class="fw-bold">@item.PatientName</div>
                            <div class="text-muted small">
                                <span class="font-monospace">@item.PatientCode</span>
                                @if (!string.IsNullOrEmpty(item.Gender))
                                {
                                    <span> &bull; @item.Gender</span>
                                }
                                @if (!string.IsNullOrEmpty(item.FormattedAge))
                                {
                                    <span> &bull; @item.FormattedAge</span>
                                }
                            </div>
                            @if (!string.IsNullOrEmpty(item.PhoneNumber))
                            {
                                <div class="text-muted" style="font-size:.78rem;"><i class="bi bi-telephone me-1"></i>@item.PhoneNumber</div>
                            }
                        </td>
                        <td>
                            <span class="badge @partnerClass px-2 py-1 fw-semibold">
                                <i class="bi @(item.AgentType == "C" ? "bi-buildings" : "bi-shop") me-1"></i>@partnerLabel
                            </span>
                        </td>
                        <td>
                            <div class="fw-semibold text-dark">@(item.AgentName ?? "Partner #" + item.B2BAgentId)</div>
                            <div class="text-muted small">@(!string.IsNullOrEmpty(item.AgentCode) ? item.AgentCode : ("ID: " + item.B2BAgentId))</div>
                        </td>
                        <td>
                            <span class="badge bg-light text-dark border me-1">@item.ItemCount test@(item.ItemCount != 1 ? "s" : "")</span>
                            @if (!string.IsNullOrEmpty(item.TestNamesSummary))
                            {
                                <span class="text-muted small text-truncate d-inline-block" style="max-width:180px;" title="@item.TestNamesSummary">
                                    @item.TestNamesSummary
                                </span>
                            }
                        </td>
                        <td>
                            <span class="badge bg-light text-dark border">
                                @(item.CollectionType == "B2BCollector" ? "B2B Collector" : item.CollectionType)
                            </span>
                        </td>
                        <td class="text-end text-muted">
                            ₹@item.TotalAmount.ToString("N2")
                        </td>
                        <td class="text-end">
                            <span class="fw-bold text-success font-monospace fs-6">
                                ₹@((item.B2BTotal ?? item.TotalAmount).ToString("N2"))
                            </span>
                        </td>
                        <td class="text-center">
                            <span class="badge @statusClass px-2 py-1">@statusText</span>
                            @if (item.BalanceDue > 0 && item.PaymentStatus != "P")
                            {
                                <div class="text-danger" style="font-size:.72rem;">Due: ₹@item.BalanceDue.ToString("N2")</div>
                            }
                        </td>
                        <td class="text-center pe-3">
                            <div class="btn-group btn-group-sm">
                                <button type="button" class="btn btn-outline-secondary" onclick="viewOrderDetail(@item.LabOrderId)" title="View Order Details">
                                    <i class="bi bi-eye"></i>
                                </button>
                                <a href="@Url.Action("PrintBill", "LabOrderBooking", new { labOrderId = item.LabOrderId })" target="_blank" class="btn btn-outline-success" title="Print Bill">
                                    <i class="bi bi-printer"></i>
                                </a>
                                @if (item.PaymentStatus != "P")
                                {
                                    <button type="button" class="btn btn-outline-primary btn-collect-pay"
                                            data-order-id="@item.LabOrderId"
                                            data-total="@((item.B2BTotal ?? item.TotalAmount).ToString("F2"))"
                                            data-balance="@item.BalanceDue.ToString("F2")"
                                            data-bill="@item.BillNo"
                                            data-patient="@item.PatientName"
                                            data-code="@item.PatientCode"
                                            title="Collect Payment">
                                        <i class="bi bi-credit-card"></i>
                                    </button>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @* ── Pagination ── *@
    @if (Model.TotalPages > 1)
    {
        <div class="card-footer bg-white d-flex justify-content-between align-items-center py-2 px-3 border-top flex-wrap gap-2">
            <div class="small text-muted">
                Showing <strong>@from</strong>–<strong>@to</strong> of <strong>@Model.TotalCount</strong> orders
            </div>
            <nav>
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(!Model.HasPrevious ? "disabled" : "")">
                        <a class="page-link" asp-action="B2BRegistration" asp-route-page="@(Model.Page - 1)" asp-route-fromDate="@fromDate" asp-route-toDate="@toDate" asp-route-search="@Model.Search">&laquo;</a>
                    </li>
                    @for (int p = Math.Max(1, Model.Page - 2); p <= Math.Min(Model.TotalPages, Model.Page + 2); p++)
                    {
                        <li class="page-item @(p == Model.Page ? "active" : "")">
                            <a class="page-link" asp-action="B2BRegistration" asp-route-page="@p" asp-route-fromDate="@fromDate" asp-route-toDate="@toDate" asp-route-search="@Model.Search">@p</a>
                        </li>
                    }
                    <li class="page-item @(!Model.HasNext ? "disabled" : "")">
                        <a class="page-link" asp-action="B2BRegistration" asp-route-page="@(Model.Page + 1)" asp-route-fromDate="@fromDate" asp-route-toDate="@toDate" asp-route-search="@Model.Search">&raquo;</a>
                    </li>
                </ul>
            </nav>
        </div>
    }
</div>

@* ── Order Detail Modal ── *@
<div class="modal fade" id="orderDetailModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header border-bottom py-2 px-3">
                <h5 class="modal-title fw-bold" id="detailModalTitle">
                    <i class="bi bi-building-check me-2 text-primary"></i>B2B Order Details
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-3" id="orderDetailBody">
                <div class="text-center py-4"><span class="spinner-border text-primary"></span></div>
            </div>
            <div class="modal-footer py-2 px-3 border-top">
                <a href="#" id="modalPrintBtn" target="_blank" class="btn btn-sm btn-outline-success">
                    <i class="bi bi-printer me-1"></i>Print Bill
                </a>
                <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function viewOrderDetail(id) {
            $('#orderDetailModal').modal('show');
            $('#orderDetailBody').html('<div class="text-center py-4"><span class="spinner-border text-primary"></span></div>');
            $('#modalPrintBtn').attr('href', '@Url.Action("PrintBill", "LabOrderBooking")?labOrderId=' + id);

            $.get('@Url.Action("GetOrderDetail", "LabOrderBooking")/' + id, function(data) {
                if (!data) {
                    $('#orderDetailBody').html('<div class="alert alert-warning">Could not load order details.</div>');
                    return;
                }

                var partnerBadge = data.agentType === 'C'
                    ? '<span class="badge partner-badge-C"><i class="bi bi-buildings me-1"></i>Company</span>'
                    : '<span class="badge partner-badge-F"><i class="bi bi-shop me-1"></i>Franchise</span>';
                var partnerName = data.agentName 
                    ? (data.agentName + (data.agentCode ? ' (' + data.agentCode + ')' : '')) 
                    : ('Partner #' + (data.b2bAgentId || ''));

                var itemsHtml = '';
                if (data.items && data.items.length > 0) {
                    data.items.forEach(function(item, idx) {
                        var isPackage = item.type === 'P';
                        var typeBadge = isPackage ? '<span class="badge bg-success ms-1">Package</span>' : '';
                        var itemMrp = (item.price || 0).toFixed(2);
                        var b2bRateVal = item.b2BRate != null ? item.b2BRate : (item.b2bRate != null ? item.b2bRate : (item.price || 0));
                        var itemB2B = Number(b2bRateVal).toFixed(2);

                        itemsHtml += `<tr>
                            <td class="text-center text-muted">${idx + 1}</td>
                            <td><span class="font-monospace text-primary">${item.testCode || '—'}</span></td>
                            <td><strong>${item.testName || '—'}</strong> ${typeBadge}</td>
                            <td>${item.sampleType || '—'}</td>
                            <td class="text-end">₹${itemMrp}</td>
                            <td class="text-end fw-bold text-success">₹${itemB2B}</td>
                        </tr>`;
                    });
                } else {
                    itemsHtml = '<tr><td colspan="6" class="text-center text-muted">No items found.</td></tr>';
                }

                var b2bTotalRaw = data.b2BTotal != null ? data.b2BTotal : (data.b2bTotal != null ? data.b2bTotal : data.totalAmount);
                var b2bTotalVal = Number(b2bTotalRaw || 0).toFixed(2);

                var html = `
                    <div class="row g-2 mb-3">
                        <div class="col-md-3">
                            <div class="p-2 bg-light rounded border">
                                <div class="text-muted small">Bill No / Token</div>
                                <div class="fw-bold font-monospace text-primary">${data.billNo || '—'}</div>
                                <div class="text-muted small font-monospace">Token: ${data.tokenNo || '—'}</div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="p-2 bg-light rounded border">
                                <div class="text-muted small">Patient</div>
                                <div class="fw-bold">${data.patientName || '—'}</div>
                                <div class="text-muted small">${data.patientCode || '—'} &bull; ${data.gender || ''} &bull; ${data.age || ''} yrs</div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="p-2 bg-light rounded border">
                                <div class="text-muted small">B2B Partner</div>
                                <div>${partnerBadge} <strong class="ms-1">${partnerName}</strong></div>
                                <div class="text-muted small">Collection: ${data.collectionType || 'B2BCollector'}</div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="p-2 bg-light rounded border">
                                <div class="text-muted small">Totals & Status</div>
                                <div class="small">MRP: ₹${data.totalAmount.toFixed(2)}</div>
                                <div class="fw-bold text-success fs-6">B2B Total: ₹${b2bTotalVal}</div>
                            </div>
                        </div>
                    </div>
                    <div class="table-responsive border rounded">
                        <table class="table table-sm table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="text-center" style="width:40px;">#</th>
                                    <th>Code</th>
                                    <th>Investigation / Profile</th>
                                    <th>Sample</th>
                                    <th class="text-end">Standard MRP</th>
                                    <th class="text-end">B2B Rate</th>
                                </tr>
                            </thead>
                            <tbody>
                                ${itemsHtml}
                            </tbody>
                        </table>
                    </div>
                `;
                $('#orderDetailBody').html(html);
            }).fail(function() {
                $('#orderDetailBody').html('<div class="alert alert-danger">Error loading order details.</div>');
            });
        }

        $(document).on('click', '.btn-collect-pay', function() {
            var btn = $(this);
            var labOrderId = parseInt(btn.data('order-id')) || 0;
            var totalAmount = parseFloat(btn.data('total')) || 0;
            var balanceDue = parseFloat(btn.data('balance')) || 0;
            var billNo = btn.data('bill') || '';
            var patientName = btn.data('patient') || '';
            var patientCode = btn.data('code') || '';

            if (typeof openStandbyPaymentModal === 'function') {
                openStandbyPaymentModal({
                    moduleCode: 'LAB',
                    moduleRefId: labOrderId,
                    billNo: billNo,
                    patientName: patientName,
                    patientCode: patientCode,
                    totalAmount: totalAmount,
                    balanceDue: balanceDue,
                    onSuccess: function() {
                        window.location.reload();
                    }
                });
            }
        });
    </script>
}
