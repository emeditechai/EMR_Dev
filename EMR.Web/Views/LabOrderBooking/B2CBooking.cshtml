                'ddlState',
                'ddlDistrict',
                'ddlCity',
                'ddlArea',
                'Address',
                'HomeCollectionAddress',
                'ddlIdType',
                'IdentificationNumber',
                'colTypeLab',
                'ddlPhlebotomist',
                'txtBookingDateTime',
                'ddlDepartment',
                'ddlCategory',
                'ddlSubCategory',
                'ddlInvestigations',
                'btnSaveSubmit'
            ];

            function isFieldVisible(el) {
                if (!el) return false;
                return el.offsetParent !== null && !el.disabled && !el.hidden;
            }

            function getElementByIdOrName(idOrName) {
                let el = document.getElementById(idOrName);
                if (!el) {
                    el = document.querySelector(`[name="${idOrName}"]`);
                }
                return el;
            }

            function focusField(idOrName, selectAllText = true) {
                const el = getElementByIdOrName(idOrName);
                if (!el) return false;

                // If in a collapsed section, expand it first
                const collapseParent = el.closest('.collapse');
                if (collapseParent && !collapseParent.classList.contains('show')) {
                    const bsCollapse = bootstrap.Collapse.getOrCreateInstance(collapseParent, { toggle: false });
                    bsCollapse.show();
                }

                // If Select2-enhanced select
                if (el.tagName === 'SELECT' && el.classList.contains('select2-hidden-accessible')) {
                    const $s2Container = $(el).next('.select2-container');
                    if ($s2Container.length) {
                        $s2Container.find('.select2-selection').focus();
                        return true;
                    }
                }

                // If Radio button
                if (el.type === 'radio') {
                    const checkedRadio = document.querySelector(`input[name="${el.name}"]:checked`) || el;
                    checkedRadio.focus();
                    return true;
                }

                // Standard input / select / button
                if (isFieldVisible(el)) {
                    el.focus();
                    if (selectAllText && (el.type === 'text' || el.type === 'number' || el.type === 'tel' || el.type === 'email')) {
                        el.select();
                    }
                    return true;
                }
                return false;
            }
            window.focusFormField = focusField;

            function getNextFieldId(currentId) {
                const idx = fieldOrder.indexOf(currentId);
                if (idx === -1) return null;

                for (let i = idx + 1; i < fieldOrder.length; i++) {
                    const nextId = fieldOrder[i];

                    // Skip phlebotomist if not Home Collection
                    if (nextId === 'ddlPhlebotomist') {
                        const colType = $('input[name="CollectionType"]:checked').val();
                        if (colType !== 'Home Collection') continue;
                    }

                    const el = getElementByIdOrName(nextId);
                    if (!el) continue;

                    // Skip collapsed optional section if not currently expanded
                    const collapseParent = el.closest('.collapse');
                    if (collapseParent && !collapseParent.classList.contains('show') && collapseParent.id === 'secOtherInfo') {
                        continue;
                    }

                    if (isFieldVisible(el) || (el.classList.contains('select2-hidden-accessible') && el.closest('.select2-container')?.offsetParent !== null)) {
                        return nextId;
                    }
                }
                return 'btnSaveSubmit';
            }

            function getPrevFieldId(currentId) {
                const idx = fieldOrder.indexOf(currentId);
                if (idx <= 0) return null;

                for (let i = idx - 1; i >= 0; i--) {
                    const prevId = fieldOrder[i];
                    if (prevId === 'ddlPhlebotomist') {
                        const colType = $('input[name="CollectionType"]:checked').val();
                        if (colType !== 'Home Collection') continue;
                    }
                    const el = getElementByIdOrName(prevId);
                    if (!el) continue;
                    if (isFieldVisible(el)) return prevId;
                }
                return null;
            }

            let skipCloseFocus = false;

            // Global Keyboard Handler for Form Traversal & Shortcuts
            document.addEventListener('keydown', function (e) {
                // Global Quick Action Shortcuts
                if ((e.ctrlKey || e.altKey) && e.key.toLowerCase() === 's') {
                    e.preventDefault();
                    document.getElementById('btnSaveSubmit')?.click();
                    return;
                }
                if (e.altKey && e.key.toLowerCase() === 'i') {
                    e.preventDefault();
                    $('#ddlInvestigations').select2('open');
                    return;
                }
                if (e.altKey && e.key.toLowerCase() === 'p') {
                    e.preventDefault();
                    focusField('phoneNumber');
                    return;
                }

                if (e.key !== 'Enter') return;

                const target = e.target;
                if (!target) return;

                // Don't intercept Enter on textareas (allow multi-line editing)
                if (target.tagName === 'TEXTAREA') return;

                // Don't intercept Enter on buttons (allow normal submission)
                if (target.tagName === 'BUTTON' || target.type === 'submit' || target.type === 'button') return;

                // Search inputs have their own Enter handler
                if (target.id === 'searchInput') return;

                // If phone dropdown is visible, let phone search handler take care of Enter
                const phoneDrop = document.getElementById('phoneSearchDropdown');
                if (target.id === 'phoneNumber' && phoneDrop && phoneDrop.style.display !== 'none') return;

                // If home collection address dropdown is visible, let address suggest handler take care of Enter
                const homeAddrDrop = document.getElementById('homeAddrDropdown');
                if (target.id === 'HomeCollectionAddress' && homeAddrDrop && homeAddrDrop.style.display !== 'none' && homeAddrDrop.querySelectorAll('.geo-addr-sug').length > 0) return;

                // If inside a Select2 search field or Select2 selection
                if (target.classList.contains('select2-search__field') || target.classList.contains('select2-selection')) {
                    const $openContainer = $('.select2-container--open');
                    if ($openContainer.length) {
                        // Dropdown IS open: Select the currently highlighted item
                        const $highlighted = $openContainer.find('.select2-results__option--highlighted');
                        if ($highlighted.length && !$highlighted.hasClass('select2-results__message')) {
                            e.preventDefault();
                            skipCloseFocus = true;
                            $highlighted.trigger('mouseup');
                            return;
                        }
                    } else if (target.classList.contains('select2-selection')) {
                        // Dropdown is CLOSED: Enter should advance to the next field!
                        e.preventDefault();
                        const $select = $(target).closest('.select2').siblings('select');
                        const currentId = $select.attr('id') || $select.attr('name');
                        if (e.shiftKey) {
                            const prevId = getPrevFieldId(currentId);
                            if (prevId) focusField(prevId);
                        } else {
                            const nextId = getNextFieldId(currentId);
                            if (nextId) focusField(nextId);
                        }
                        return;
                    }
                    return;
                }

                // Prevent default form submit on Enter
                e.preventDefault();

                // Shift + Enter -> go backwards
                if (e.shiftKey) {
                    const prevId = getPrevFieldId(target.id || target.name);
                    if (prevId) focusField(prevId);
                    return;
                }

                // Normal Enter -> advance to next field
                const currentId = target.id || target.name;
                const nextId = getNextFieldId(currentId);
                if (nextId) {
                    focusField(nextId);
                }
            });

            // Advance to next field on Select2 selection
            $(document).on('select2:select', function (e) {
                skipCloseFocus = true;
                const selectEl = e.target;
                const selectId = selectEl.id;

                // Investigation dropdown: stay on investigation dropdown to rapid-add multiple tests
                if (selectId === 'ddlInvestigations') {
                    setTimeout(() => {
                        $('#ddlInvestigations').val('').trigger('change.select2');
