        // ── DOB ↔ Age (Years, Months, Days) bidirectional auto-calculation ─────────────────────────
        (function () {
            const dobInput = document.getElementById('DateOfBirth');
            const yearsInput = document.getElementById('AgeYears');
            const monthsInput = document.getElementById('AgeMonths');
            const daysInput = document.getElementById('AgeDays');
            const feedbackEl = document.getElementById('ageValidationFeedback');

            let isUpdating = false;

            function clearAgeValidation() {
                yearsInput?.classList.remove('is-invalid');
                monthsInput?.classList.remove('is-invalid');
                daysInput?.classList.remove('is-invalid');
                dobInput?.classList.remove('is-invalid');
                if (feedbackEl) {
                    feedbackEl.textContent = '';
                    feedbackEl.classList.add('d-none');
                }
            }

            function calcAgeDetails(dobValue) {
                if (!dobValue) return { years: '', months: '', days: '' };
                const birthDate = new Date(dobValue);
                if (isNaN(birthDate.getTime())) return { years: '', months: '', days: '' };
                const today = new Date();
                if (birthDate > today) return { years: 0, months: 0, days: 0 };

                let years = today.getFullYear() - birthDate.getFullYear();
                let months = today.getMonth() - birthDate.getMonth();
                let days = today.getDate() - birthDate.getDate();

                if (days < 0) {
                    months--;
                    const prevMonth = new Date(today.getFullYear(), today.getMonth(), 0);
                    days += prevMonth.getDate();
                }

                if (months < 0) {
                    years--;
                    months += 12;
                }

                return {
                    years: Math.max(0, years),
                    months: Math.max(0, months),
                    days: Math.max(0, days)
                };
            }

            function syncDobFromAge() {
                if (isUpdating) return;
                isUpdating = true;
                clearAgeValidation();

                const yVal = yearsInput?.value.trim();
                const mVal = monthsInput?.value.trim();
                const dVal = daysInput?.value.trim();

                const y = parseInt(yVal, 10) || 0;
                const m = parseInt(mVal, 10) || 0;
                const d = parseInt(dVal, 10) || 0;

                // Validate Month <= 12
                if (m > 12) {
                    monthsInput?.classList.add('is-invalid');
                    if (feedbackEl) {
                        feedbackEl.textContent = 'Month cannot exceed 12.';
                        feedbackEl.classList.remove('d-none');
                    }
                    isUpdating = false;
                    return;
                }

                // Validate Days <= 30
                if (d > 30) {
                    daysInput?.classList.add('is-invalid');
                    if (feedbackEl) {
                        feedbackEl.textContent = 'Days cannot exceed 30.';
                        feedbackEl.classList.remove('d-none');
                    }
                    isUpdating = false;
                    return;
                }

                // Validate Years <= 150
                if (y > 150 || y < 0) {
                    yearsInput?.classList.add('is-invalid');
                    if (feedbackEl) {
                        feedbackEl.textContent = 'Years must be between 0 and 150.';
                        feedbackEl.classList.remove('d-none');
                    }
                    isUpdating = false;
                    return;
                }

                if (yVal !== '' || mVal !== '' || dVal !== '') {
                    const today = new Date();
                    const targetDate = new Date(today.getFullYear() - y, today.getMonth() - m, today.getDate() - d);
                    const yyyy = targetDate.getFullYear();
                    const mm = String(targetDate.getMonth() + 1).padStart(2, '0');
                    const dd = String(targetDate.getDate()).padStart(2, '0');
                    if (dobInput) dobInput.value = `${yyyy}-${mm}-${dd}`;
                } else {
                    if (dobInput) dobInput.value = '';
                }
                isUpdating = false;
            }

            function syncAgeFromDob() {
                if (isUpdating) return;
                isUpdating = true;
                clearAgeValidation();

                const val = dobInput?.value;
                if (val) {
                    const age = calcAgeDetails(val);
                    if (yearsInput) yearsInput.value = age.years !== '' ? age.years : '';
                    if (monthsInput) monthsInput.value = age.months !== '' ? age.months : '';
                    if (daysInput) daysInput.value = age.days !== '' ? age.days : '';
                } else {
                    if (yearsInput) yearsInput.value = '';
                    if (monthsInput) monthsInput.value = '';
                    if (daysInput) daysInput.value = '';
                }
                isUpdating = false;
            }

            dobInput?.addEventListener('change', syncAgeFromDob);
            dobInput?.addEventListener('input', syncAgeFromDob);

            [yearsInput, monthsInput, daysInput].forEach(inp => {
                inp?.addEventListener('input', syncDobFromAge);
                inp?.addEventListener('change', syncDobFromAge);
            });

            // Expose helper for populatePatient to trigger DOB→Age recalc
            window._refreshAge = function () {
                syncAgeFromDob();
            };

            // On page load: if DOB or Age is set, sync accordingly
            if (dobInput?.value) {
                syncAgeFromDob();
            } else if (yearsInput?.value || monthsInput?.value || daysInput?.value) {
                syncDobFromAge();
            }
        })();

        // ── Phone Number — exactly 10 digits ─────────────────────────────────
        (function () {
            var ph    = document.getElementById('phoneNumber');
            var phErr = document.getElementById('phoneError');
            if (!ph) return;

            function setPhoneError(msg) {
                if (msg) {
                    ph.classList.add('is-invalid');
                    ph.classList.remove('is-valid');
                    phErr.textContent = msg;
                    phErr.style.display = 'block';
                } else {
                    ph.classList.remove('is-invalid');
                    ph.classList.add('is-valid');
                    phErr.style.display = 'none';
                }
            }

            function clearPhoneState() {
                ph.classList.remove('is-invalid', 'is-valid');
                phErr.style.display = 'none';
            }

            // Block non-digit keystrokes in real time
            ph.addEventListener('keydown', function (e) {
                var allowed = ['Backspace','Delete','Tab','ArrowLeft','ArrowRight','Home','End'];
                if (allowed.includes(e.key) || e.ctrlKey || e.metaKey) return;
                if (!/^[0-9]$/.test(e.key)) e.preventDefault();
            });

            // Strip non-digits and enforce max 10 (handles paste / autofill)
            ph.addEventListener('input', function () {
                var cleaned = ph.value.replace(/\D/g, '').slice(0, 10);
                if (ph.value !== cleaned) ph.value = cleaned;
                if (cleaned.length === 0)  { clearPhoneState(); return; }
                if (cleaned.length === 10) { setPhoneError(null); }
                else                       { ph.classList.remove('is-invalid','is-valid'); phErr.style.display='none'; }
            });

            // Show error when leaving the field with fewer than 10 digits
            ph.addEventListener('blur', function () {
                var v = ph.value.replace(/\D/g, '');
                if (v.length === 0)  { clearPhoneState(); return; }
                if (v.length < 10)   { setPhoneError('Phone number must be exactly 10 digits.'); }
                else                 { setPhoneError(null); }
            });
        })();

        // ── Client-side validation highlight ─────────────────────────────────
        (document.getElementById('labForm') || document.getElementById('patientForm'))?.addEventListener('submit', function (e) {
            saveJson();
            // Phone: must be exactly 10 digits
            var ph    = document.getElementById('phoneNumber');
            var phErr = document.getElementById('phoneError');
            if (ph) {
                var digits = ph.value.replace(/\D/g, '');
                if (digits.length !== 10) {
                    e.preventDefault();
                    e.stopPropagation();
                    ph.classList.add('is-invalid');
                    if (phErr) {
                        phErr.textContent = digits.length === 0
                            ? 'Phone number is required.'
                            : 'Phone number must be exactly 10 digits.';
                        phErr.style.display = 'block';
                    }
                    ph.focus();
                    this.classList.add('was-validated');
                    return;
                }
            }
            
            // Age/DOB Client-side Validation
            var yInp = document.getElementById('AgeYears');
            var mInp = document.getElementById('AgeMonths');
            var dInp = document.getElementById('AgeDays');
            var dobInp = document.getElementById('DateOfBirth');
            var feedback = document.getElementById('ageValidationFeedback');

            var y = parseInt(yInp?.value, 10) || 0;
            var m = parseInt(mInp?.value, 10) || 0;
            var d = parseInt(dInp?.value, 10) || 0;
            var hasAnyAge = (yInp && yInp.value.trim() !== '') || (mInp && mInp.value.trim() !== '') || (dInp && dInp.value.trim() !== '');

            if (m > 12) {
                e.preventDefault();
                e.stopPropagation();
                mInp?.classList.add('is-invalid');
                mInp?.focus();
                if (feedback) { feedback.textContent = 'Month cannot exceed 12.'; feedback.classList.remove('d-none'); }
                this.classList.add('was-validated');
                return;
            }
            if (d > 30) {
                e.preventDefault();
                e.stopPropagation();
                dInp?.classList.add('is-invalid');
                dInp?.focus();
                if (feedback) { feedback.textContent = 'Days cannot exceed 30.'; feedback.classList.remove('d-none'); }
                this.classList.add('was-validated');
                return;
            }
            if (y > 150 || y < 0) {
                e.preventDefault();
                e.stopPropagation();
                yInp?.classList.add('is-invalid');
                yInp?.focus();
                if (feedback) { feedback.textContent = 'Years must be between 0 and 150.'; feedback.classList.remove('d-none'); }
                this.classList.add('was-validated');
                return;
            }

            if (!hasAnyAge && (!dobInp || !dobInp.value)) {
                e.preventDefault();
                e.stopPropagation();
                yInp?.classList.add('is-invalid');
                yInp?.focus();
                if (feedback) { feedback.textContent = 'Age or Date of Birth is required.'; feedback.classList.remove('d-none'); }
                this.classList.add('was-validated');
                return;
            } else {
                yInp?.classList.remove('is-invalid');
                mInp?.classList.remove('is-invalid');
                dInp?.classList.remove('is-invalid');
                if (feedback) feedback.classList.add('d-none');
            }

            // Booking Date & Time Client-side Validation
            var txtBooking = document.getElementById('txtBookingDateTime');
            if (txtBooking) {
                // Auto-update if untouched
                if (typeof window.isBookingDateTouched !== 'undefined' && !window.isBookingDateTouched) {
                    var _now = new Date();
                    var _y = _now.getFullYear();
                    var _m = String(_now.getMonth() + 1).padStart(2, '0');
                    var _d = String(_now.getDate()).padStart(2, '0');
                    var _hh = String(_now.getHours()).padStart(2, '0');
                    var _mm = String(_now.getMinutes()).padStart(2, '0');
                    txtBooking.value = `${_y}-${_m}-${_d}T${_hh}:${_mm}`;
                }

                var bookingVal = txtBooking.value;
                if (!bookingVal || new Date(bookingVal) < new Date(Date.now() - 60000)) {
                    e.preventDefault();
                    e.stopPropagation();
                    txtBooking.classList.add('is-invalid');
                    txtBooking.focus();
                    this.classList.add('was-validated');
                    return;
                } else {
                    txtBooking.classList.remove('is-invalid');
                }
            }

            if (!this.checkValidity()) {
                e.preventDefault();
                e.stopPropagation();
            }

            // Line items validation
            lineItemsFormSubmitted = true;
            if (!checkLineItemsValidity()) {
                e.preventDefault();
                e.stopPropagation();
                document.querySelector('.service-block')?.scrollIntoView({ behavior: 'smooth', block: 'center' });
                this.classList.add('was-validated');
                return;
            }

            this.classList.add('was-validated');
        });

