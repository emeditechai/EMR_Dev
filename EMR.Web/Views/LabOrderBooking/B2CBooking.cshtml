        function updateSearchPlaceholder() {
            if (!searchType || !searchInput) return;
            if (searchType.value === 'phone') {
                if (searchLabel) searchLabel.textContent = 'Enter Mobile Number';
                if (searchIcon)  searchIcon.className = 'bi bi-telephone';
                searchInput.placeholder = 'Enter 10-digit mobile number…';
