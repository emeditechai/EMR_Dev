@model EMR.Web.Models.ViewModels.LabOrderBookingViewModel
@{
    ViewData["Title"] = "LAB Order Booking/Registration - B2C";
    bool isEdit = Model.PatientId > 0;
    bool registered = ViewContext.HttpContext.Request.Query.ContainsKey("registered");
    string? newCode = TempData["NewPatientCode"] as string;
    string? newName = TempData["NewPatientName"] as string;
    string? billNo = TempData["BillNo"] as string;
    string? newLabOrderId = TempData["NewLabOrderId"] as string;
}

@section HeadStyles {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" />
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <style>
        #leafletMapContainer {
            height: 380px;
            width: 100%;
            border-radius: 8px;
            z-index: 1;
        }
        .leaflet-container {
            font-family: inherit;
        }
        .select2-container--bootstrap-5 .select2-selection {
            min-height: 38px;
            font-size: 0.875rem;
            border-color: #cbd5e1;
            border-radius: 8px;
            transition: border-color 0.15s ease-in-out, box-shadow 0.15s ease-in-out;
        }
        .select2-container--bootstrap-5.select2-container--focus .select2-selection,
        .select2-container--bootstrap-5.select2-container--open .select2-selection,
        .form-control:focus,
        .form-select:focus,
        .form-check-input:focus {
            border-color: #2563eb !important;
            box-shadow: 0 0 0 0.25rem rgba(37, 99, 235, 0.22) !important;
            outline: 0 !important;
        }
        .form-check-input:focus + .form-check-label {
            color: #2563eb !important;
            font-weight: 700 !important;
        }
        .select2-container--bootstrap-5 .select2-dropdown {
            border-color: #cbd5e1;
            border-radius: 8px;
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.12), 0 8px 10px -6px rgba(0, 0, 0, 0.08);
            overflow: hidden;
            z-index: 1060;
        }
        .select2-container--bootstrap-5 .select2-search--dropdown {
            padding: 8px 10px;
            background: #f8fafc;
            border-bottom: 1px solid #e2e8f0;
        }
        .select2-container--bootstrap-5 .select2-search--dropdown .select2-search__field {
            border-radius: 6px;
            border: 1px solid #cbd5e1;
            padding: 6px 12px;
            font-size: 0.85rem;
        }
        .select2-container--bootstrap-5 .select2-search--dropdown .select2-search__field:focus {
            border-color: #2563eb !important;
            box-shadow: 0 0 0 0.2rem rgba(37, 99, 235, 0.22) !important;
            outline: 0 !important;
        }
        .select2-container--bootstrap-5 .select2-results__options {
            max-height: 280px;
            padding: 4px;
        }
        .select2-container--bootstrap-5 .select2-results__option {
            padding: 6px 10px;
            font-size: 0.85rem;
            border-radius: 6px;
            margin-bottom: 2px;
            transition: background-color 0.1s ease;
        }
        .select2-container--bootstrap-5 .select2-results__option--highlighted[aria-selected] {
            background-color: #eff6ff !important;
            color: #1e3a8a !important;
        }
        .select2-container--bootstrap-5 .select2-results__option--selected {
            background-color: #e0e7ff !important;
            color: #3730a3 !important;
        }
        .select2-container { width: 100% !important; }

        .reg-section {
            background: #fff;
            border: 1px solid #e2e8f0;
            border-radius: 12px;
            margin-bottom: 1.25rem;
            overflow: hidden;
            box-shadow: 0 1px 3px rgba(0,0,0,.04);
        }
        .reg-section-header {
            display: flex;
            align-items: center;
            gap: .75rem;
            padding: 0.85rem 1.25rem;
            border-bottom: 1px solid #e2e8f0;
            background: #fff;
        }
        .reg-section-header .sec-icon {
            width: 38px; height: 38px;
            border-radius: 8px;
            display: flex; align-items: center; justify-content: center;
            font-size: 1.15rem;
        }
        .reg-section-header .sec-icon.blue  { background: #e8f0fe; color: #1967d2; }
        .reg-section-header .sec-icon.green { background: #e6f4ea; color: #137333; }
        .reg-section-body { padding: 1.25rem; }

        .action-bar {
            background: #fff;
            border: 1px solid #e2e8f0;
            border-radius: 12px;
            padding: 0.85rem 1.25rem;
            display: flex;
            justify-content: flex-end;
            gap: .75rem;
            margin-bottom: 2rem;
            box-shadow: 0 1px 3px rgba(0,0,0,.04);
        }

        #phoneSearchDropdown, #topSearchDropdown, #homeAddrDropdown {
            border-radius: 8px;
            border: 1px solid #dee2e6;
            box-shadow: 0 8px 24px rgba(0,0,0,0.12) !important;
        }
        #phoneSearchDropdown .phone-sug, #topSearchDropdown .top-sug, #homeAddrDropdown .geo-addr-sug {
            cursor: pointer;
            transition: all 0.15s ease-in-out;
            text-align: left;
            border-left: 4px solid transparent;
            background: #fff;
        }
        #phoneSearchDropdown .phone-sug:hover,
        #phoneSearchDropdown .phone-sug.kbd-active,
        #topSearchDropdown .top-sug:hover,
        #topSearchDropdown .top-sug.kbd-active,
        #homeAddrDropdown .geo-addr-sug:hover,
        #homeAddrDropdown .geo-addr-sug.kbd-active {
            background-color: #e8f0fe !important;
            border-left: 4px solid #1a73e8 !important;
        }
        #phoneSearchDropdown .phone-sug.kbd-active .fw-semibold,
        #topSearchDropdown .top-sug.kbd-active .fw-semibold,
        #homeAddrDropdown .geo-addr-sug.kbd-active .fw-bold {
            color: #1a73e8 !important;
        }

        /* Hover and transition effects for line items */
        #tblLineItems tbody tr {
            transition: background-color 0.15s ease;
        }
        #tblLineItems tbody tr:hover {
            background-color: #f8fafc;
        }
        .btn-remove {
            transition: all 0.15s ease-in-out;
        }
        .btn-remove:hover {
            background-color: #fee2e2;
            color: #dc2626;
            transform: scale(1.1);
        }
    </style>
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h1 class="h3 mb-0 fw-bold">
            <i class="bi bi-droplet-fill me-2 text-danger"></i>
            LAB Order Booking - B2C
        </h1>
        <small class="text-muted">Register patient and book lab investigations</small>
    </div>
    <div class="d-flex gap-2 align-items-center">
        <span class="badge text-bg-danger fs-6 px-3 py-2"><i class="bi bi-hospital me-1"></i>LAB</span>
    </div>
</div>

@* ══════════════════════════════════════════════════════════════
   SEARCH EXISTING PATIENT  (optional)
══════════════════════════════════════════════════════════════ *@
@if (!isEdit)
{
    <div class="search-panel" id="searchPanel">
        <div class="search-label-strip">
            <i class="bi bi-search text-primary fs-6"></i>
            Search Existing Patient
            <span class="badge text-bg-warning text-dark ms-1">Optional</span>
        </div>
        <div class="row g-2 align-items-end">
            <div class="col-12 col-md-3">
                <label class="form-label fw-semibold small mb-1">Search By</label>
                <select id="searchType" class="form-select form-select-sm">
                    <option value="phone">Mobile No</option>
                    <option value="code">Patient ID</option>
                    <option value="name">Patient Name</option>
                </select>
            </div>
            <div class="col-12 col-md-6 position-relative">
                <label class="form-label fw-semibold small mb-1" id="searchLabel">Enter Mobile Number</label>
                <div class="input-group input-group-sm">
                    <span class="input-group-text" id="searchIcon"><i class="bi bi-telephone"></i></span>
                    <input type="text" id="searchInput" class="form-control"
                           placeholder="Enter 10-digit mobile number…" maxlength="50" autocomplete="off" />
                    <button class="btn btn-primary px-3" type="button" id="btnSearch">
                        <i class="bi bi-search me-1"></i>Search
                    </button>
                </div>
                <div id="topSearchDropdown"
                     class="list-group position-absolute shadow"
                     style="display:none;top:100%;left:0;right:0;z-index:1055;max-height:260px;overflow-y:auto;"></div>
            </div>
            <div class="col-12 col-md-3">
                <div class="alert alert-info py-2 mb-0 small" role="alert">
                    <i class="bi bi-info-circle me-1"></i>Auto-populates form on selection
                </div>
            </div>
        </div>
    </div>
}


<form asp-action="B2CBooking" method="post" enctype="multipart/form-data" id="labForm" novalidate>
    @Html.AntiForgeryToken()
    <input asp-for="PatientId" type="hidden" />
    <input asp-for="PatientCode" type="hidden" />
    <input asp-for="DemographicsOnly" type="hidden" value="false" id="hdnDemographicsOnly" />
    <input asp-for="IdentificationFilePath" type="hidden" />
    <input asp-for="PhotoPath" type="hidden" />
    <input asp-for="LineItemsJson" type="hidden" id="lineItemsJson" />

    <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3"></div>

    @* ════════════════════════════════════════════════════════════
       SECTION 1 — PATIENT DEMOGRAPHY
    ════════════════════════════════════════════════════════════ *@
    <div class="reg-section">
        <div class="reg-section-header collapsed-toggle" role="button"
             data-bs-toggle="collapse" data-bs-target="#secDemography"
             aria-expanded="true" aria-controls="secDemography">
            <div class="sec-icon blue"><i class="bi bi-person-vcard-fill"></i></div>
            <div class="flex-grow-1">
                <h6 class="fw-bold mb-0">
                    Patient Demography
                    @if (isEdit && !string.IsNullOrEmpty(Model.PatientCode))
                    {
                        <span class="badge text-bg-primary ms-2 font-monospace">@Model.PatientCode</span>
                    }
                    <span id="loadedPatientBadge" class="badge text-bg-primary ms-2 font-monospace d-none"></span>
                </h6>
                <small class="text-muted">Basic personal, contact and address information</small>
            </div>
            <span class="badge text-bg-danger me-2">* Required Fields</span>
            <i class="bi bi-chevron-down sec-chevron"></i>
        </div>
        <div id="secDemography" class="collapse show">
        <div class="reg-section-body">

            @* ── Row 1: Phone Number* | Relation* | Profile Picture ── *@
            <div class="row g-3 mb-3">
                <div class="col-12 col-sm-6 col-md-4 position-relative">
                    <label asp-for="PhoneNumber" class="form-label fw-semibold small">
                        Phone Number <span class="text-danger">*</span>
                    </label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-telephone-fill text-primary"></i></span>
                        <input asp-for="PhoneNumber" id="phoneNumber" class="form-control"
                               maxlength="10" inputmode="numeric" pattern="[0-9]{10}"
                               placeholder="10-digit mobile" autocomplete="off" />
                    </div>
                    <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                    <div id="phoneError" class="text-danger small" style="display:none"></div>
                    <div id="phoneSearchDropdown"
                         class="list-group position-absolute shadow"
                         style="display:none;top:100%;left:0;right:0;z-index:1055;max-height:220px;overflow-y:auto;"></div>
                </div>
                <div class="col-12 col-sm-6 col-md-4">
                    <label asp-for="RelationId" class="form-label fw-semibold small">
                        Relation <span class="text-danger">*</span>
                    </label>
                    <select asp-for="RelationId" id="ddlRelation" class="form-select s2-basic"
                            asp-items="Model.RelationOptions">
                        <option value="">-- Select Relation --</option>
                    </select>
                    <span asp-validation-for="RelationId" class="text-danger small"></span>
                </div>
                <div class="col-12 col-sm-12 col-md-4">
                    <label class="form-label fw-semibold small">
                        Profile Picture
                        <span class="text-muted fw-normal">(JPG / PNG / GIF)</span>
                    </label>
                    <div class="d-flex align-items-center gap-2">
                        <div class="flex-grow-1">
                            <div class="input-group">
                                <input type="file" name="profilePictureFile" id="profilePictureFile"
                                       class="form-control" accept=".jpg,.jpeg,.png,.gif" onchange="previewProfilePic(this)" />
                                <button type="button" class="btn btn-outline-primary" id="btnWebcamOpen" title="Take photo via Webcam">
                                    <i class="bi bi-camera-fill"></i>
                                </button>
                            </div>
                        </div>
                        <div id="profilePicPreviewContainer" class="@(string.IsNullOrEmpty(Model.PhotoPath) ? "d-none" : "")">
                            <img id="profilePicPreview" src="@Model.PhotoPath" 
                                 class="rounded-circle border" style="width: 38px; height: 38px; object-fit: cover;" />
                        </div>
                    </div>
                    <span asp-validation-for="PhotoPath" class="text-danger small"></span>
                </div>
            </div>

            @* ── Row 2: Title | First Name | Middle Name | Last Name ── *@
            <div class="row g-3 mb-3">
                <div class="col-4 col-sm-3 col-md-1">
                    <label asp-for="Salutation" class="form-label fw-semibold small">Title</label>
                    <select asp-for="Salutation" id="ddlSalutation" class="form-select s2-basic px-1">
                        <option value="">--</option>
                        <option value="Mr.">Mr.</option>
                        <option value="Mrs.">Mrs.</option>
                        <option value="Master">Master</option>
                        <option value="Ms.">Ms.</option>
                        <option value="Dr.">Dr.</option>
                    </select>
                </div>
                <div class="col-8 col-sm-9 col-md-4">
                    <label asp-for="FirstName" class="form-label fw-semibold small">
                        First Name <span class="text-danger">*</span>
                    </label>
                    <input asp-for="FirstName" class="form-control text-capitalize" maxlength="100" placeholder="Enter first name" style="text-transform: capitalize;" />
                    <span asp-validation-for="FirstName" class="text-danger small"></span>
                </div>
                <div class="col-12 col-sm-6 col-md-3">
                    <label asp-for="MiddleName" class="form-label fw-semibold small">Middle Name</label>
                    <input asp-for="MiddleName" class="form-control text-capitalize" maxlength="100" placeholder="Optional" style="text-transform: capitalize;" />
                </div>
                <div class="col-12 col-sm-6 col-md-4">
                    <label asp-for="LastName" class="form-label fw-semibold small">
                        Last Name <span class="text-danger">*</span>
                    </label>
                    <input asp-for="LastName" class="form-control text-capitalize" maxlength="100" placeholder="Enter last name" style="text-transform: capitalize;" />
                    <span asp-validation-for="LastName" class="text-danger small"></span>
                </div>
            </div>

            @* ── Row 2: Secondary Number | Email | Gender | Date of Birth | Age ── *@
            <div class="row g-3 mb-3">
                <div class="col-12 col-sm-6 col-md-2">
                    <label asp-for="SecondaryPhoneNumber" class="form-label fw-semibold small">Secondary Number</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-telephone text-secondary"></i></span>
                        <input asp-for="SecondaryPhoneNumber" class="form-control"
                               maxlength="15" placeholder="Optional" />
                    </div>
                    <span asp-validation-for="SecondaryPhoneNumber" class="text-danger small"></span>
                </div>
                <div class="col-12 col-sm-6 col-md-2">
                    <label asp-for="EmailId" class="form-label fw-semibold small">Email ID</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-envelope text-secondary"></i></span>
                        <input asp-for="EmailId" class="form-control text-lowercase" maxlength="150" placeholder="Optional" style="text-transform: lowercase;" />
                    </div>
                    <span asp-validation-for="EmailId" class="text-danger small"></span>
                </div>
                <div class="col-12 col-sm-4 col-md-2">
                    <label asp-for="Gender" class="form-label fw-semibold small">
                        Gender <span class="text-danger">*</span>
                    </label>
                    <select asp-for="Gender" id="ddlGender" class="form-select s2-basic">
                        <option value="">-- Select --</option>
                        <option value="Male">Male</option>
                        <option value="Female">Female</option>
                        <option value="Other">Other</option>
                    </select>
                    <span asp-validation-for="Gender" class="text-danger small"></span>
                </div>
                <div class="col-12 col-sm-4 col-md-2">
                    <label asp-for="DateOfBirth" class="form-label fw-semibold small">Date of Birth</label>
                    <input asp-for="DateOfBirth" id="DateOfBirth" type="date" class="form-control"
                           max="@DateTime.Today.ToString("yyyy-MM-dd")" />
                    <span asp-validation-for="DateOfBirth" class="text-danger small"></span>
                </div>
                <div class="col-12 col-sm-8 col-md-4">
                    <label class="form-label fw-semibold small">Age <span class="text-danger">*</span></label>
                    <div class="d-flex gap-1 align-items-center">
                        <div class="input-group flex-fill" style="min-width: 0;">
                            <input asp-for="AgeYears" type="number" id="AgeYears" class="form-control px-2 text-center"
                                   min="0" max="150" placeholder="00" title="Years (0-150)" />
                            <span class="input-group-text px-2 small text-muted bg-light fw-medium">Year</span>
                        </div>
                        <div class="input-group flex-fill" style="min-width: 0;">
                            <input asp-for="AgeMonths" type="number" id="AgeMonths" class="form-control px-2 text-center"
                                   min="0" max="12" placeholder="00" title="Months (Max 12)" />
                            <span class="input-group-text px-2 small text-muted bg-light fw-medium">Month</span>
                        </div>
                        <div class="input-group flex-fill" style="min-width: 0;">
                            <input asp-for="AgeDays" type="number" id="AgeDays" class="form-control px-2 text-center"
                                   min="0" max="30" placeholder="00" title="Days (Max 30)" />
                            <span class="input-group-text px-2 small text-muted bg-light fw-medium">Days</span>
                        </div>
                    </div>
                    <div id="ageValidationFeedback" class="text-danger small mt-1 d-none"></div>
                    <span asp-validation-for="AgeYears" class="text-danger small d-block"></span>
                    <span asp-validation-for="AgeMonths" class="text-danger small d-block"></span>
                    <span asp-validation-for="AgeDays" class="text-danger small d-block"></span>
                </div>
            </div>

            @* ── Row 3: Religion | Blood Group | Guardian / Relative Name ── *@
            <div class="row g-3 mb-3">
                <div class="col-12 col-sm-6 col-md-3">
                    <label asp-for="ReligionId" class="form-label fw-semibold small">Religion</label>
                    <select asp-for="ReligionId" id="ddlReligion" class="form-select s2-search"
                            asp-items="Model.ReligionOptions">
                        <option value="">-- Select Religion --</option>
                    </select>
                </div>
                <div class="col-12 col-sm-6 col-md-3">
                    <label asp-for="BloodGroup" class="form-label fw-semibold small">Blood Group</label>
                    <select asp-for="BloodGroup" id="ddlBloodGroup" class="form-select s2-basic">
                        <option value="">-- Select --</option>
                        <option value="A+">A+</option>
                        <option value="A-">A-</option>
                        <option value="B+">B+</option>
                        <option value="B-">B-</option>
                        <option value="AB+">AB+</option>
                        <option value="AB-">AB-</option>
                        <option value="O+">O+</option>
                        <option value="O-">O-</option>
                        <option value="Unknown">Unknown</option>
                    </select>
                </div>
                <div class="col-12 col-sm-12 col-md-6">
                    <label asp-for="GuardianName" class="form-label fw-semibold small">Guardian / Relative Name</label>
                    <input asp-for="GuardianName" class="form-control" maxlength="200" placeholder="Optional" />
                </div>
            </div>

            @* ── Row 4: Address — Country | State | District | City | Area ── *@
            <div class="row g-3 mb-1">
                <div class="col-12 col-sm-6 col-md-3">
                    <label asp-for="CountryId" class="form-label fw-semibold small" id="lblCountry">
                        Country <span id="reqCountry" class="text-danger" style="@(Model.CollectionType == "Home Collection" ? "" : "display:none;")">*</span>
                    </label>
                    <select asp-for="CountryId" id="ddlCountry" class="form-select s2-search"
                            asp-items="Model.CountryOptions">
                        <option value="">-- Select Country --</option>
                    </select>
                </div>
                <div class="col-12 col-sm-6 col-md-3">
                    <label asp-for="StateId" class="form-label fw-semibold small" id="lblState">
                        State <span id="reqState" class="text-danger" style="@(Model.CollectionType == "Home Collection" ? "" : "display:none;")">*</span>
                    </label>
                    <select asp-for="StateId" id="ddlState" class="form-select s2-search"
                            asp-items="Model.StateOptions">
                        <option value="">-- Select State --</option>
                    </select>
                </div>
                <div class="col-12 col-sm-4 col-md-2">
                    <label asp-for="DistrictId" class="form-label fw-semibold small" id="lblDistrict">District</label>
                    <select asp-for="DistrictId" id="ddlDistrict" class="form-select s2-search"
                            asp-items="Model.DistrictOptions">
                        <option value="">-- Select District --</option>
                    </select>
                </div>
                <div class="col-12 col-sm-4 col-md-2">
                    <label asp-for="CityId" class="form-label fw-semibold small">City</label>
                    <select asp-for="CityId" id="ddlCity" class="form-select s2-search"
                            asp-items="Model.CityOptions">
                        <option value="">-- Select City --</option>
                    </select>
                </div>
                <div class="col-12 col-sm-4 col-md-2">
                    <label asp-for="AreaId" class="form-label fw-semibold small">Area</label>
                    <select asp-for="AreaId" id="ddlArea" class="form-select s2-search"
                            asp-items="Model.AreaOptions">
                        <option value="">-- Select Area --</option>
                    </select>
                </div>
            </div>

            @* ── Row 5: Address ── *@
            <div class="row g-3 mb-1">
                <div class="col-12">
                    <label asp-for="Address" class="form-label fw-semibold small">Address</label>
                    <input asp-for="Address" id="Address" class="form-control" maxlength="500"
                           placeholder="Enter full address (optional)" autocomplete="off" />
                </div>
            </div>

            @* ── Row 6: Home Collection Address (with Auto-Suggest Location & Lat/Long Capture) ── *@
            <div class="row g-3 mb-1 mt-1" id="rowHomeCollectionAddress" style="@(Model.CollectionType == "Home Collection" ? "" : "display:none;")">
                <div class="col-12">
                    <div class="d-flex justify-content-between align-items-center mb-1 flex-wrap gap-2">
                        <label asp-for="HomeCollectionAddress" class="form-label fw-semibold small mb-0 d-flex align-items-center gap-1">
                            <i class="bi bi-geo-alt-fill text-danger"></i> Home Collection Address
                            <span class="text-muted fw-normal" style="font-size:0.75rem;">(Auto-suggests location & captures Lat/Long)</span>
                        </label>
                        <div class="d-flex align-items-center gap-2">
                            <span id="badgeGeoLocation" class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1 align-items-center gap-1" style="display:none; font-size: 0.75rem; cursor:pointer;" title="Click to view/edit on Map">
                                <i class="bi bi-pin-map-fill text-success"></i><span id="lblGeoCoords"></span>
                                <button type="button" class="btn-close btn-close-xs ms-1" id="btnClearGeoCoords" title="Clear GPS coordinates" style="font-size: 0.55rem;"></button>
                            </span>
                            <button type="button" class="btn btn-sm btn-outline-primary py-0 px-2 fw-semibold d-inline-flex align-items-center gap-1" id="btnOpenMapModal" title="Open interactive map to pinpoint or adjust patient doorstep location">
                                <i class="bi bi-map-fill"></i>
                                <span id="txtOpenMap">Pick on Map</span>
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2 fw-semibold d-inline-flex align-items-center gap-1" id="btnDetectLocation" title="Auto-detect current device GPS location (Optional)">
                                <i class="bi bi-crosshair" id="iconDetectLocation"></i>
                                <span id="txtDetectLocation">Current GPS</span>
                            </button>
                        </div>
                    </div>
                    <div class="position-relative" id="homeAddrSuggestWrapper">
                        <div class="input-group">
                            <span class="input-group-text bg-light text-muted border-end-0">
                                <i class="bi bi-search" id="iconAddrSearch"></i>
                            </span>
                            <input asp-for="HomeCollectionAddress" id="HomeCollectionAddress" class="form-control border-start-0" maxlength="500"
                                   placeholder="Type patient area / landmark / address to auto-suggest (e.g., Belepole, Shibpur, Howrah)..." autocomplete="off" />
                            <button type="button" class="btn btn-outline-secondary" id="btnClearHomeAddr" title="Clear address" style="display:none;">
                                <i class="bi bi-x-lg"></i>
                            </button>
                        </div>
                        <input type="hidden" asp-for="Latitude" id="hdnLatitude" />
                        <input type="hidden" asp-for="Longitude" id="hdnLongitude" />

                        <!-- Auto-Suggest Dropdown Menu for Geocoded Locations -->
                        <div id="homeAddrDropdown" class="dropdown-menu shadow-lg border-0 w-100 p-0 mt-1" style="display:none; position:absolute; top:100%; left:0; right:0; z-index:1060; max-height:280px; overflow-y:auto; border-radius:8px; border:1px solid #dee2e6;">
                        </div>
                    </div>
                </div>
            </div>

            @* ── Identification sub-block ── *@
            <div class="id-block mt-3">
                <p class="text-muted small fw-bold mb-3">
                    <i class="bi bi-shield-check-fill me-1 text-secondary"></i>
                    Identification Details <span class="fw-normal">(Optional)</span>
                </p>
                <div class="row g-3">
                    <div class="col-12 col-sm-6 col-md-3">
                        <label asp-for="IdentificationTypeId" class="form-label fw-semibold small">ID Type</label>
                        <select asp-for="IdentificationTypeId" id="ddlIdType" class="form-select s2-search"
                                asp-items="Model.IdentificationTypeOptions">
                            <option value="">-- Select ID Type --</option>
                        </select>
                    </div>
                    <div class="col-12 col-sm-6 col-md-4">
                        <label asp-for="IdentificationNumber" class="form-label fw-semibold small">ID Number</label>
                        <input asp-for="IdentificationNumber" class="form-control" maxlength="100"
                               placeholder="Enter identification number" />
                    </div>
                    <div class="col-12 col-md-5">
                        <label class="form-label fw-semibold small">
                            Upload ID Document
                            <span class="text-muted fw-normal">(PDF / JPG / JPEG / PNG)</span>
                        </label>
                        <input type="file" name="identificationFile" id="idFileUpload"
                               class="form-control" accept=".pdf,.jpg,.jpeg,.png" />
                        @if (!string.IsNullOrEmpty(Model.IdentificationFilePath))
                        {
                            <div class="mt-1">
                                <a href="@Model.IdentificationFilePath" target="_blank" class="small text-primary">
                                    <i class="bi bi-eye me-1"></i>View uploaded file
                                </a>
                            </div>
                        }
                        <span asp-validation-for="IdentificationFilePath" class="text-danger small"></span>
                    </div>
                </div>
            </div>

        </div>
        </div>@* /#secDemography *@
    </div>

    @* ════════════════════════════════════════════════════════════
       SECTION 2 — OTHER INFORMATION
    ════════════════════════════════════════════════════════════ *@
    <div class="reg-section">
        <div class="reg-section-header collapsed-toggle" role="button"
             data-bs-toggle="collapse" data-bs-target="#secOtherInfo"
             aria-expanded="false" aria-controls="secOtherInfo">
            <div class="sec-icon green"><i class="bi bi-clipboard2-pulse-fill"></i></div>
            <div class="flex-grow-1">
                <h6 class="fw-bold mb-0">Other Information</h6>
                <small class="text-muted">Occupation, marital status &amp; medical notes</small>
            </div>
            <i class="bi bi-chevron-down sec-chevron"></i>
        </div>
        <div id="secOtherInfo" class="collapse">
        <div class="reg-section-body">

            @* ── Row 1: Occupation | Marital Status | Referral Doctor ── *@
            <div class="row g-3 mb-3">
                <div class="col-12 col-sm-6 col-md-4">
                    <label asp-for="OccupationId" class="form-label fw-semibold small">Occupation</label>
                    <select asp-for="OccupationId" id="ddlOccupation" class="form-select s2-search"
                            asp-items="Model.OccupationOptions">
                        <option value="">-- Select Occupation --</option>
                    </select>
                </div>
                <div class="col-12 col-sm-6 col-md-4">
                    <label asp-for="MaritalStatusId" class="form-label fw-semibold small">Marital Status</label>
                    <select asp-for="MaritalStatusId" id="ddlMaritalStatus" class="form-select s2-search"
                            asp-items="Model.MaritalStatusOptions">
                        <option value="">-- Select Status --</option>
                    </select>
                </div>
                <div class="col-12 col-sm-6 col-md-4">
                    <label asp-for="ReferralDoctorId" class="form-label fw-semibold small">Referral Doctor</label>
                    <div class="input-group">
                        <select asp-for="ReferralDoctorId" id="ddlReferralDoctor" class="form-select s2-search"
                                asp-items="Model.ReferralDoctorOptions">
                            <option value="">-- Select Referral Doctor --</option>
                        </select>
                        <button type="button" class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#modalAddReferralDoctor" title="Add Referral Doctor">
                            <i class="bi bi-plus-lg"></i>
                        </button>
                    </div>
                </div>
            </div>

            @* ── Row 2: Allergies | Remarks ── *@
            <div class="row g-3">
                <div class="col-12 col-md-6">
                    <label asp-for="KnownAllergies" class="form-label fw-semibold small">Known Allergies</label>
                    <textarea asp-for="KnownAllergies" class="form-control" rows="3" maxlength="500"
                              placeholder="List any known allergies (optional)"></textarea>
                </div>
                <div class="col-12 col-md-6">
                    <label asp-for="Remarks" class="form-label fw-semibold small">Remarks</label>
                    <textarea asp-for="Remarks" class="form-control" rows="3" maxlength="1000"
                              placeholder="Any additional notes (optional)"></textarea>
                </div>
            </div>

        </div>
        </div>@* /#secOtherInfo *@
    </div>


    @* ── Section 2: Lab Investigations ── *@
    <div class="reg-section">
        <div class="reg-section-header d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div class="d-flex align-items-center gap-3">
                <div class="sec-icon green"><i class="bi bi-droplet-half"></i></div>
                <div>
                    <h6 class="fw-bold mb-0">Lab Investigations</h6>
                    <small class="text-muted">Select individual tests or complete profile packages</small>
                </div>
            </div>
            <div class="d-flex align-items-center gap-2">
                <span class="badge bg-light text-secondary border px-2.5 py-1.5 small" id="badgeAvailableCount">
                    <i class="bi bi-collection me-1 text-primary"></i> <span id="lblAvailCount">...</span> Available
                </span>
            </div>
        </div>
        <div class="reg-section-body">
            <!-- Booking Settings Strip: Collection Type, Phlebotomist & Booking Date/Time -->
            <div class="p-3 mb-3 rounded-3 bg-white border border-slate-200 shadow-2xs">
                <div class="row g-3 align-items-center">
                    <!-- Collection Type -->
                    <div class="col-12 col-md-4">
                        <label class="form-label text-dark small mb-1.5 fw-bold d-flex align-items-center gap-1">
                            <i class="bi bi-geo-alt-fill text-primary"></i> Collection Type <span class="text-danger">*</span>
                        </label>
                        <div class="d-flex align-items-center gap-3 pt-1">
                            <div class="form-check form-check-inline m-0">
                                <input class="form-check-input" type="radio" name="CollectionType" id="colTypeLab" value="Lab" @(Model.CollectionType != "Home Collection" ? "checked" : "") onchange="onCollectionTypeChanged()">
                                <label class="form-check-label fw-semibold small text-secondary" for="colTypeLab" role="button">
                                    <i class="bi bi-building me-1 text-primary"></i> Lab
                                </label>
                            </div>
                            <div class="form-check form-check-inline m-0">
                                <input class="form-check-input" type="radio" name="CollectionType" id="colTypeHome" value="Home Collection" @(Model.CollectionType == "Home Collection" ? "checked" : "") onchange="onCollectionTypeChanged()">
                                <label class="form-check-label fw-semibold small text-secondary" for="colTypeHome" role="button">
                                    <i class="bi bi-house-door me-1 text-success"></i> Home Collection
                                </label>
                            </div>
                        </div>
                    </div>

                    <!-- Phlebotomist Dropdown (Conditional on Home Collection) -->
                    <div class="col-12 col-md-4" id="divPhlebotomist" style="@(Model.CollectionType == "Home Collection" ? "" : "display:none;")">
                        <label class="form-label text-dark small mb-1 fw-bold d-flex align-items-center gap-1">
                            <i class="bi bi-person-badge text-primary"></i> Phlebotomist <span class="text-danger">*</span>
                        </label>
                        <select asp-for="PhlebotomistId" class="form-select form-select-sm s2-basic" id="ddlPhlebotomist" asp-items="Model.PhlebotomistOptions">
                            <option value="">-- Select Phlebotomist --</option>
                        </select>
                    </div>

                    <!-- Booking Date & Time -->
                    <div class="col-12 col-md-4 ms-auto">
                        <label class="form-label text-dark small mb-1 fw-bold d-flex align-items-center gap-1" for="txtBookingDateTime">
                            <i class="bi bi-calendar-event text-primary"></i> Booking Date &amp; Time <span class="text-danger">*</span>
                        </label>
                        <input type="datetime-local" class="form-control form-control-sm" id="txtBookingDateTime" name="BookingDateTime" value="@Model.BookingDateTime.ToString("yyyy-MM-ddTHH:mm")" min="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")" required />
                        <div class="invalid-feedback" id="bookingDateTimeFeedback">Booking Date &amp; Time cannot be less than current Date &amp; Time.</div>
                    </div>
                </div>
            </div>

            <!-- Filter Strip -->
            <div class="p-3 mb-3 rounded-3 bg-light border border-slate-200">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="fw-semibold text-secondary small d-flex align-items-center gap-1">
                        <i class="bi bi-funnel-fill text-primary"></i> Filter Investigations:
                    </span>
                    <button type="button" class="btn btn-link btn-sm text-decoration-none text-muted p-0 small" id="btnResetFilters" style="display:none;">
                        <i class="bi bi-x-circle me-1"></i>Clear Filters
                    </button>
                </div>
                <div class="row g-2">
                    <div class="col-12 col-md-4">
                        <label class="form-label text-muted small mb-1 fw-semibold"><i class="bi bi-hospital me-1"></i>Department</label>
                        <select id="ddlDepartment" asp-for="DepartmentId" class="form-select form-select-sm s2-search" asp-items="Model.DepartmentOptions" data-placeholder="-- All Departments --">
                            <option value="">-- All Departments --</option>
                        </select>
                    </div>
                    <div class="col-12 col-md-4">
                        <label class="form-label text-muted small mb-1 fw-semibold"><i class="bi bi-tag me-1"></i>Category</label>
                        <select id="ddlCategory" asp-for="CategoryId" class="form-select form-select-sm s2-search" asp-items="Model.CategoryOptions" data-placeholder="-- All Categories --">
                            <option value="">-- All Categories --</option>
                        </select>
                    </div>
                    <div class="col-12 col-md-4">
                        <label class="form-label text-muted small mb-1 fw-semibold"><i class="bi bi-diagram-3 me-1"></i>Sub Category</label>
                        <select id="ddlSubCategory" asp-for="SubCategoryId" class="form-select form-select-sm s2-search" asp-items="Model.SubCategoryOptions" data-placeholder="-- All Sub Categories --">
                            <option value="">-- All Sub Categories --</option>
                        </select>
                    </div>
                </div>
            </div>

            <!-- Search & Select Box -->
            <div class="mb-3">
                <label class="form-label fw-bold text-dark small mb-1.5 d-flex justify-content-between align-items-center">
                    <span>
                        <i class="bi bi-search text-primary me-1"></i>Search & Add Investigation / Profile
                        <span class="text-danger">*</span>
                    </span>
                    <span class="badge bg-light text-muted border fw-normal" style="font-size:0.75rem;">
                        Use <kbd class="bg-white border text-dark px-1">↑</kbd> <kbd class="bg-white border text-dark px-1">↓</kbd> & <kbd class="bg-white border text-dark px-1">↵ Enter</kbd> or click to add
                    </span>
                </label>
                <div class="position-relative">
                    <select id="ddlInvestigations" class="form-select s2-search"></select>
                </div>
            </div>

            <!-- Selected Tests Table Card -->
            <div class="card border border-slate-200 rounded-3 overflow-hidden mb-2 shadow-2xs">
                <div class="card-header bg-white py-2.5 px-3 border-bottom d-flex justify-content-between align-items-center">
                    <span class="fw-bold small text-dark d-flex align-items-center gap-1.5">
                        <i class="bi bi-list-check text-primary fs-6"></i> Selected Investigations
                    </span>
                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-2.5 py-1 small fw-semibold" id="badgeSelectedCount">
                        0 Tests Selected
                    </span>
                </div>
                <div class="table-responsive m-0">
                    <table class="table table-hover align-middle mb-0" id="tblLineItems">
                        <thead class="table-light border-bottom text-secondary small text-uppercase" style="font-size: 0.75rem; letter-spacing: 0.5px;">
                            <tr>
                                <th style="width: 45px;" class="text-center">#</th>
                                <th style="width: 140px;">Test Code</th>
                                <th>Test / Profile Name</th>
                                <th>Sample / Method</th>
                                <th style="width: 130px;">TAT</th>
                                <th style="width: 130px;" class="text-end">MRP (₹)</th>
                                <th style="width: 80px;" class="text-center">Urgent</th>
                                <th style="width: 60px;" class="text-center">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            <!-- Dynamic rows via renderTable() -->
                        </tbody>
                    </table>
                </div>
                <!-- Summary bar inside card footer -->
                <div class="card-footer bg-white py-2.5 px-3 border-top d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <div class="text-muted small">
                        <i class="bi bi-shield-check text-success me-1"></i>Standard hospital pricing applied
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <span class="fw-bold text-secondary text-uppercase small" style="letter-spacing:0.5px;">Total Amount:</span>
                        <div class="bg-success-subtle border border-success-subtle rounded-3 px-3 py-1">
                            <span class="fs-5 fw-bold text-success font-monospace" id="lblTotalAmount">₹ 0.00</span>
                        </div>
                    </div>
                </div>
            </div>
            <span asp-validation-for="LineItemsJson" class="text-danger fw-bold small"></span>
        </div>
    </div>

    @* ── Actions ── *@
    <div class="action-bar">
        <button type="button" class="btn btn-outline-secondary px-4 fw-semibold" onclick="window.location.reload();">
            <i class="bi bi-arrow-counterclockwise me-1"></i>Reset
        </button>
        <button type="submit" class="btn btn-primary px-5 fw-bold" id="btnSaveSubmit">
            <i class="bi bi-check2-circle me-1"></i> Save & Book
        </button>
    </div>
</form>

<partial name="_PaymentModal" />

@* ══════════════════════════════════════════════════════════════
   SUCCESS MODAL (shown after Save Payment or Skip Payment)
   ══════════════════════════════════════════════════════════════ *@
<div class="modal fade" id="bookingSuccessModal" tabindex="-1" data-bs-backdrop="static" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width:460px">
        <div class="modal-content border-0 shadow-lg" style="border-radius:14px;">
            <div class="modal-body text-center py-4 px-4 position-relative">
                <button type="button" class="btn-close position-absolute top-0 end-0 m-3" data-bs-dismiss="modal" aria-label="Close" onclick="window.location.reload();"></button>
                <div class="rounded-circle d-inline-flex align-items-center justify-content-center mb-3"
                     style="width:68px;height:68px;background:#e6f4ea;color:#137333;">
                    <i class="bi bi-check-circle-fill fs-1"></i>
                </div>
                <h4 class="fw-bold mb-1 text-success">Lab Order Booked!</h4>
                <p class="text-muted small mb-3" id="lblSuccessPatientName">Patient lab investigations order booked successfully.</p>
                
                <div class="d-flex gap-2 justify-content-center mt-2 mb-3 flex-wrap">
                    <div class="alert alert-primary py-2 px-3 mb-0 text-center flex-fill" style="min-width:120px;">
                        <p class="text-muted small mb-0 fw-semibold" style="font-size:.7rem">PATIENT ID</p>
                        <h5 class="fw-bold text-primary mb-0 font-monospace" id="lblSuccessPatientCode">---</h5>
                    </div>
                    <div class="alert alert-success py-2 px-3 mb-0 text-center flex-fill" style="min-width:130px;">
                        <p class="text-muted small mb-0 fw-semibold" style="font-size:.7rem">BILL NO</p>
                        <h5 class="fw-bold text-success mb-0 font-monospace" id="lblSuccessBillNo">---</h5>
                    </div>
                    <div class="alert alert-warning py-2 px-3 mb-0 text-center flex-fill" style="min-width:120px;" id="boxSuccessToken">
                        <p class="text-muted small mb-0 fw-semibold" style="font-size:.7rem">TOKEN NO</p>
                        <h5 class="fw-bold text-warning-emphasis mb-0 font-monospace" id="lblSuccessTokenNo">---</h5>
                    </div>
                </div>

                <div class="d-flex gap-2 justify-content-center flex-wrap">
                    <a href="@Url.Action("B2COrderList", "LabOrderBooking")" class="btn btn-outline-secondary btn-sm px-3">
                        <i class="bi bi-list-check me-1"></i> B2C Order List
                    </a>
                    <a href="#" id="btnPrintBill" target="_blank" class="btn btn-outline-success btn-sm px-3">
                        <i class="bi bi-printer me-1"></i> Print Bill
                    </a>
                    <a href="#" id="btnPrintBarcode" target="_blank" class="btn btn-outline-info btn-sm px-3 d-none">
                        <i class="bi bi-upc-scan me-1"></i> Print Barcode
                    </a>
                    <button type="button" class="btn btn-primary btn-sm px-4" onclick="window.location.reload();">
                        <i class="bi bi-plus-lg me-1"></i> New Booking
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@* ══════════════════════════════════════════════════════════════
   PROFILE INVESTIGATIONS VIEW MODAL
   ══════════════════════════════════════════════════════════════ *@
<div class="modal fade" id="profileInvestigationsModal" tabindex="-1" aria-labelledby="profileInvestigationsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 14px;">
            <div class="modal-header bg-light py-3 px-4 border-bottom">
                <div class="d-flex align-items-center gap-2">
                    <span class="badge bg-primary px-2 py-1 font-monospace fs-7" id="pvmProfileCode">PRF0000</span>
                    <h5 class="modal-title fw-bold mb-0 text-dark" id="pvmProfileName">Profile Name</h5>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <div class="d-flex align-items-center justify-content-between mb-3 bg-light p-3 rounded-3 border">
                    <div class="d-flex align-items-center gap-2">
                        <div class="rounded-circle bg-primary bg-opacity-10 d-flex align-items-center justify-content-center" style="width:38px;height:38px;">
                            <i class="bi bi-collection text-primary fs-5"></i>
                        </div>
                        <div>
                            <div class="fw-semibold small text-muted text-uppercase" style="font-size:0.7rem;">Tests Included in this Profile</div>
                            <div class="fw-bold fs-6 text-dark" id="pvmTestCount">0 Tests</div>
                        </div>
                    </div>
                    <div>
                        <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-1 rounded-pill">
                            <i class="bi bi-check-circle-fill me-1"></i>Active Profile
                        </span>
                    </div>
                </div>

                <div id="pvmLoader" class="text-center py-4">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <div class="text-muted small mt-2">Loading profile investigations...</div>
                </div>

                <div id="pvmTableContainer" class="table-responsive d-none border rounded-3 shadow-xs" style="max-height: 350px; overflow-y: auto;">
                    <table class="table table-hover table-bordered align-middle mb-0" id="tblProfileSubTests">
                        <thead class="table-light sticky-top">
                            <tr class="small text-muted text-uppercase" style="font-size:0.75rem;">
                                <th style="width: 55px;" class="text-center">Seq</th>
                                <th style="width: 110px;">Test Code</th>
                                <th>Test Name</th>
                                <th>Category</th>
                                <th style="width: 120px;" class="text-end">Individual MRP</th>
