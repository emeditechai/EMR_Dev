            <div class="modal-footer bg-light py-2 px-4 border-top d-flex justify-content-between">
                <a id="btnProfileFullDetails" href="#" target="_blank" class="btn btn-outline-primary btn-sm">
                    <i class="bi bi-box-arrow-up-right me-1"></i> Open Full Profile Details Page
                </a>
                <button type="button" class="btn btn-secondary btn-sm px-4" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>



@* ══════════════════════════════════════════════════════════════
   WEBCAM CAPTURE MODAL
   ══════════════════════════════════════════════════════════════ *@
<div class="modal fade" id="webcamModal" tabindex="-1" data-bs-backdrop="static" aria-labelledby="webcamModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 12px;">
            <div class="modal-header bg-primary text-white py-2 px-3 rounded-top-12">
                <h6 class="modal-title fw-bold" id="webcamModalLabel">
                    <i class="bi bi-camera-fill me-2"></i>Capture Profile Photo
                </h6>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close" id="btnWebcamCancel"></button>
            </div>
            <div class="modal-body p-3 text-center bg-light">
                <!-- Video/Canvas box -->
