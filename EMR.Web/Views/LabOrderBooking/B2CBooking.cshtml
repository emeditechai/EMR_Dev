@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script>
        $(document).ready(function () {
            // Collection Type Change Toggle
            window.onCollectionTypeChanged = function () {
                var val = $('input[name="CollectionType"]:checked').val();
                if (val === 'Home Collection') {
                    $('#divPhlebotomist').slideDown(200);
                    $('#rowHomeCollectionAddress').slideDown(200);
                    $('#reqCountry, #reqState').show();
                } else {
                    $('#divPhlebotomist').slideUp(200);
                    $('#rowHomeCollectionAddress').slideUp(200);
                    $('#ddlPhlebotomist').val('').trigger('change.select2');
                    $('#reqCountry, #reqState').hide();
                    $('#ddlCountry, #ddlState, #ddlDistrict').next('.select2-container').find('.select2-selection').removeClass('border-danger');
                    $('#HomeCollectionAddress').removeClass('is-invalid');
                    $('#HomeCollectionAddress').val('');
                    $('#hdnLatitude').val('');
                    $('#hdnLongitude').val('');
                    $('#lblGeoCoords').text('');
                    $('#badgeGeoLocation').hide();
                }
            };

            $('#ddlCountry, #ddlState, #ddlDistrict').on('change', function () {
                $(this).next('.select2-container').find('.select2-selection').removeClass('border-danger');
            });

            function checkFilterResetVisibility() {
                var d = $('#ddlDepartment').val();
                var c = $('#ddlCategory').val();
                var s = $('#ddlSubCategory').val();
                if (d || c || s) {
                    $('#btnResetFilters').show();
                } else {
                    $('#btnResetFilters').hide();
                }
            }

            $('#btnResetFilters').on('click', function () {
                $('#ddlDepartment').val('').trigger('change.select2');
                $('#ddlCategory').val('').trigger('change.select2');
                $('#ddlSubCategory').val('').trigger('change.select2');
                $(this).hide();
                loadInvestigations();
            });

            // Cascading filters for Lab investigations
            $('#ddlDepartment').on('change', function () {
                checkFilterResetVisibility();
                var deptId = $(this).val();
                
                var $cat = $('#ddlCategory');
                $cat.empty().append('<option value="">-- All Categories --</option>');
                
                var $subCat = $('#ddlSubCategory');
                $subCat.empty().append('<option value="">-- All Sub Categories --</option>');

                var catUrl = '/LabOrderBooking/GetCategoriesForDropdown' + (deptId ? '?departmentId=' + deptId : '');
                $.get(catUrl, function (data) {
                    if (data && data.length) {
                        data.forEach(function (item) {
                            $cat.append(new Option(item.text, item.value));
                        });
                    }
                    $cat.val('').trigger('change.select2');
                    $subCat.val('').trigger('change.select2');
                    loadInvestigations();
                });
            });

            $('#ddlCategory').on('change', function () {
                checkFilterResetVisibility();
                var catId = $(this).val();
                
                var $subCat = $('#ddlSubCategory');
                $subCat.empty().append('<option value="">-- All Sub Categories --</option>');
                
                var subCatUrl = '/LabOrderBooking/GetSubCategoriesForDropdown' + (catId ? '?categoryId=' + catId : '');
                $.get(subCatUrl, function (data) {
                    if (data && data.length) {
                        data.forEach(function (item) {
                            $subCat.append(new Option(item.text, item.value));
                        });
                    }
                    $subCat.val('').trigger('change.select2');
                    loadInvestigations();
                });
            });

            $('#ddlSubCategory').on('change', function () {
                checkFilterResetVisibility();
                loadInvestigations();
            });

            // Reload investigations when demographics change to enforce validation rules
            $('#ddlGender').on('change', function() {
                if (lineItems && lineItems.length > 0) {
                    lineItems = [];
                    renderTable();
                    alert("Selected tests have been cleared because demographics changed. Please select tests again.");
                }
                loadInvestigations();
            });

            $('#AgeYears').on('change blur', function() {
                if (lineItems && lineItems.length > 0) {
                    lineItems = [];
                    renderTable();
                    alert("Selected tests have been cleared because demographics changed. Please select tests again.");
                }
                loadInvestigations();
            });

            function formatInvestigationOption(opt) {
                if (!opt.id) return null;
                var $elem = $(opt.element);
                var isProfile = $elem.attr('data-is-profile') === '1';
                var isPackage = $elem.attr('data-is-package') === '1';
                var code = $elem.attr('data-code') || '';
                var name = $elem.attr('data-name') || opt.text;
                var tat = $elem.attr('data-tat');
                var price = parseFloat($elem.attr('data-price')) || 0;
                var sample = $elem.attr('data-sample');

                var badgeHtml = isPackage
                    ? '<span class="badge bg-success-subtle text-success border border-success-subtle ms-2" style="font-size:0.7rem;vertical-align:middle;padding:0.2rem 0.5rem;border-radius:4px;"><i class="bi bi-box me-1"></i>Package</span>'
                    : (isProfile
                        ? '<span class="badge bg-primary-subtle text-primary border border-primary-subtle ms-2" style="font-size:0.7rem;vertical-align:middle;padding:0.2rem 0.5rem;border-radius:4px;"><i class="bi bi-layers me-1"></i>Profile</span>'
                        : '');

                var sampleHtml = sample ? `<span class="badge bg-info-subtle text-info border border-info-subtle ms-2" style="font-size:0.7rem;vertical-align:middle;padding:0.2rem 0.5rem;border-radius:4px;"><i class="bi bi-droplet me-1"></i>${sample}</span>` : '';
                var tatHtml = tat ? `<span class="badge bg-light text-secondary border ms-2" style="font-size:0.72rem;"><i class="bi bi-clock me-1"></i>${tat} hrs</span>` : '';
                var priceHtml = `<span class="fw-bold font-monospace text-success ms-auto ps-3" style="font-size:0.95rem;">₹${price.toFixed(2)}</span>`;

                return $(`
                    <div class="d-flex align-items-center justify-content-between w-100 py-0.5">
                        <div class="d-flex align-items-center flex-wrap">
                            <span class="badge bg-light text-primary font-monospace border px-1.5 py-1 me-2">${code}</span>
                            <span class="fw-semibold text-dark">${name}</span>
                            ${badgeHtml}
                            ${sampleHtml}
                            ${tatHtml}
                        </div>
                        ${priceHtml}
                    </div>
                `);
            }

            function formatInvestigationSelection(opt) {
                if (!opt.id) return opt.text;
                var $elem = $(opt.element);
                var isProfile = $elem.attr('data-is-profile') === '1';
                var code = $elem.attr('data-code') || '';
                var name = $elem.attr('data-name') || opt.text;
                var sample = $elem.attr('data-sample');
                var badgeText = isProfile ? ' [Profile]' : '';
                var sampleText = sample ? ` [Sample: ${sample}]` : '';
                return `${code ? code + ' - ' : ''}${name}${badgeText}${sampleText}`;
            }

            $('#ddlInvestigations').select2({
                theme: 'bootstrap-5',
                width: '100%',
                placeholder: '-- Search by Test Code or Investigation Name --',
                allowClear: true,
                templateResult: formatInvestigationOption,
                templateSelection: formatInvestigationSelection
            });

            // Initial load of investigations
            loadInvestigations();

            function loadInvestigations() {
                var dept = $('#ddlDepartment').val() || '';
                var cat = $('#ddlCategory').val() || '';
                var subCat = $('#ddlSubCategory').val() || '';
                var gender = $('#ddlGender').val() || '';
                var ageYears = $('#AgeYears').val() || '';

                var url = `@Url.Action("GetAvailableInvestigations", "LabOrderBooking")?`;
                if (dept) url += `&departmentId=${dept}`;
                if (cat) url += `&categoryId=${cat}`;
                if (subCat) url += `&subCategoryId=${subCat}`;
                if (gender) url += `&gender=${encodeURIComponent(gender)}`;
                if (ageYears) url += `&ageInYears=${ageYears}`;

                var $ddl = $('#ddlInvestigations');
                $ddl.prop('disabled', true);

                $.get(url, function (res) {
                    $ddl.empty().append('<option value=""></option>');
                    if (res.isSuccess && res.data && res.data.length > 0) {
                        $('#lblAvailCount').text(res.data.length);
                        res.data.forEach(function (item) {
                            var isProf = item.isProfileTest === true || item.isProfileTest === 'true';
                            var isPack = item.isPackage === true || item.isPackage === 'true';
                            var profileLabel = isProf ? ' <span class="badge badge-light-primary"><i class="fas fa-layer-group"></i> Profile</span>' : '';
                            var packageLabel = isPack ? ' <span class="badge badge-light-success"><i class="fas fa-box"></i> Package</span>' : '';
                            var sampleStr = item.sampleType ? ` <span class="badge badge-light-info"><i class="fas fa-tint"></i> ${item.sampleType}</span>` : '';
                            var isDiscAllowed = item.isDiscountAllowed === true || item.isDiscountAllowed === 'true' || item.isDiscountAllowed === 1;
                            
                            // Combine labels
                            var allLabels = isPack ? packageLabel : (profileLabel + sampleStr);
                            if (isPack) sampleStr = ''; // packages don't usually show a single sample type
                            
                            // We use html encoding for option text but Select2 can render HTML if we use templateResult. 
                            // Since we might not be using templateResult, let's just stick to string tags or adjust if Select2 escapes them.
                            // The original code was using raw text: profileLabel = isProf ? ' [Profile]' : '';
                            // Let's stick to the original text approach to avoid XSS/Select2 escaping issues, unless we know Select2 is configured for HTML.
                            
                            var textProfileLabel = isProf ? ' [Profile]' : '';
                            var textPackageLabel = isPack ? ' [Package]' : '';
                            var textSampleStr = item.sampleType ? ` [Sample: ${item.sampleType}]` : '';
                            
                            var itemType = isPack ? 'P' : 'I';
                            var valStr = `${itemType}_${item.investigationId}`;
                            
                            var opt = new Option(
                                `${item.testCode} - ${item.testName}${textProfileLabel}${textPackageLabel}${textSampleStr} [TAT: ${item.tatHours} hrs] - ₹ ${item.mrp.toFixed(2)}`,
                                valStr
                            );
                            $(opt).attr('data-price', item.mrp);
                            $(opt).attr('data-code', item.testCode);
                            $(opt).attr('data-name', item.testName);
                            $(opt).attr('data-tat', item.tatHours);
                            $(opt).attr('data-is-profile', isProf ? '1' : '0');
                            $(opt).attr('data-is-package', isPack ? '1' : '0');
                            $(opt).attr('data-profile-id', item.profileId || '');
                            $(opt).attr('data-profile-url', item.profileEncryptedUrl || '');
                            $(opt).attr('data-sample', item.sampleType || '');
                            $(opt).attr('data-method', item.method || '');
                            $(opt).attr('data-disc-allowed', isDiscAllowed ? '1' : '0');
                            $ddl.append(opt);
                        });
                    } else {
                        $('#lblAvailCount').text('0');
                    }
                    $ddl.val('').prop('disabled', false).trigger('change.select2');
                }).fail(function() {
                    $ddl.prop('disabled', false);
                });
            }

            var lineItems = [];

            // Directly add test on selection (via Keyboard Enter or Mouse Click)
            $('#ddlInvestigations').on('select2:select', async function(e) {
                var data = e.params.data;
                var valStr = data.id;
                if (!valStr) return;

                var opt = $(this).find(`option[value="${valStr}"]`);
                
                var parts = valStr.split('_');
                var itemType = parts[0];
                var id = parseInt(parts[1]);
                var price = parseFloat(opt.attr('data-price')) || 0;
                var code = opt.attr('data-code') || '';
                var name = opt.attr('data-name') || '';
                var tat = opt.attr('data-tat') || '';
                var isProfile = opt.attr('data-is-profile') === '1';
                var isPackage = opt.attr('data-is-package') === '1';
                var profileId = opt.attr('data-profile-id') || '';
                var profileUrl = opt.attr('data-profile-url') || '';

                var sampleType = opt.attr('data-sample') || '';
                var method = opt.attr('data-method') || '';
                var isDiscAllowed = opt.attr('data-disc-allowed') === '1';

                var newTestIds = [id];
                var newTestNames = [name];
                var profileTests = null;

                if (isProfile || isPackage) {
                    try {
                        // Disable the dropdown to prevent further clicks while loading
                        $(this).prop('disabled', true);
                        var url = `@Url.Action("GetProfileDetails", "LabOrderBooking")?profileId=${profileId}`;
                        var res = await $.get(url);
                        if (res.success && res.tests) {
                            profileTests = res.tests;
                            newTestIds = res.tests.map(t => t.testId);
                            newTestNames = res.tests.map(t => t.testName);
                        }
                    } catch (err) {
                        console.error('Failed to fetch profile details:', err);
                    } finally {
                        $(this).prop('disabled', false);
                    }
                }

                // Deep duplicate check
                var duplicateFound = false;
                var duplicateMessage = '';

                for (var i = 0; i < newTestIds.length; i++) {
                    var checkId = newTestIds[i];
                    var checkName = newTestNames[i];
                    
                    // Check against single tests
                    var singleMatch = lineItems.find(x => !x.isProfileTest && !x.isPackage && x.investigationId === checkId);
                    if (singleMatch) {
                        duplicateFound = true;
                        if (isProfile || isPackage) {
                            duplicateMessage = `${checkName} is already added as a single investigation.`;
                        } else {
                            duplicateMessage = `This investigation is already added.`;
                        }
                        break;
                    }
                    
                    // Check against already added profiles/packages
                    var profileMatch = lineItems.find(x => (x.isProfileTest || x.isPackage) && x.profileTests && x.profileTests.some(pt => pt.testId === checkId));
                    if (profileMatch) {
                        duplicateFound = true;
                        if (isProfile || isPackage) {
                            duplicateMessage = `${checkName} is already included in the added '${profileMatch.testName}'.`;
                        } else {
                            duplicateMessage = `This investigation is already included in the added '${profileMatch.testName}'.`;
                        }
                        break;
                    }
                }

                if (duplicateFound) {
                    if (typeof showToast === 'function') {
                        showToast(duplicateMessage, 'danger');
                    } else {
                        alert(duplicateMessage);
                    }
                    $(this).val('').trigger('change.select2');
                    return;
                }

                lineItems.push({
                    investigationId: id,
                    price: price,
                    testCode: code,
                    testName: name,
                    tatHours: tat,
                    isProfileTest: isProfile,
                    isPackage: isPackage,
                    profileId: profileId,
                    profileUrl: profileUrl,
                    sampleType: sampleType,
                    method: method,
                    isDiscountAllowed: isDiscAllowed,
                    profileTests: profileTests
                });

                renderTable();

                // Clear selection back to placeholder and reopen for rapid next test entry
                $(this).val('').trigger('change.select2');
                setTimeout(() => {
                    $('#ddlInvestigations').select2('open');
                }, 80);
            });

            $(document).on('click', '.btn-remove', function() {
                var id = $(this).data('id');
                lineItems = lineItems.filter(x => x.investigationId !== id);
                renderTable();
            });

            $(document).on('change', '.chk-urgent', function() {
                var id = $(this).data('id');
                var isChecked = $(this).is(':checked');
                var item = lineItems.find(x => x.investigationId === id);
                if (item) {
                    item.isUrgent = isChecked;
                }
            });

            function renderTable() {
                var $tbody = $('#tblLineItems tbody');
                $tbody.empty();
                var total = 0;

                if (lineItems.length === 0) {
                    $tbody.append(`
                        <tr id="trEmptyRow">
                            <td colspan="6" class="text-center py-4 text-muted bg-light-subtle">
                                <div class="py-2">
                                    <i class="bi bi-clipboard2-pulse fs-2 d-block mb-1 text-primary opacity-50"></i>
                                    <div class="fw-semibold text-secondary">No investigations added yet</div>
                                    <div class="small text-muted">Use the search box above to search and select tests or profile packages</div>
                                </div>
                            </td>
                        </tr>
                    `);
                } else {
                    lineItems.forEach(function(item, idx) {
                        total += item.price;
                        var badgeProfile = item.isProfileTest
                            ? `<span class="badge bg-primary text-white ms-2 cursor-pointer btn-view-profile" data-test-id="${item.investigationId}" data-profile-id="${item.profileId || ''}" data-profile-url="${item.profileUrl || ''}" data-test-name="${item.testName}" style="font-size:0.72rem;vertical-align:middle;padding:0.25rem 0.5rem;border-radius:4px;cursor:pointer;" title="Click to view included tests"><i class="bi bi-layers me-1"></i>Profile</span>
                               <button type="button" class="btn btn-xs btn-outline-info ms-1 btn-view-profile rounded-pill shadow-2xs" data-test-id="${item.investigationId}" data-profile-id="${item.profileId || ''}" data-profile-url="${item.profileUrl || ''}" data-test-name="${item.testName}" title="View included investigations in this profile" style="font-size:0.75rem;line-height:1.4;vertical-align:middle;padding:0.15rem 0.55rem;">
                                   <i class="bi bi-eye me-1"></i>View Tests
                               </button>`
                            : (item.isPackage ? `<span class="badge bg-success text-white ms-2 cursor-pointer btn-view-profile" data-test-id="${item.investigationId}" data-profile-id="${item.investigationId}" data-profile-url="${item.profileUrl || ''}" data-test-name="${item.testName}" style="font-size:0.72rem;vertical-align:middle;padding:0.25rem 0.5rem;border-radius:4px;cursor:pointer;" title="Click to view included tests"><i class="fas fa-box me-1"></i>Package</span>
                               <button type="button" class="btn btn-xs btn-outline-success ms-1 btn-view-profile rounded-pill shadow-2xs" data-test-id="${item.investigationId}" data-profile-id="${item.investigationId}" data-profile-url="${item.profileUrl || ''}" data-test-name="${item.testName}" title="View included investigations in this package" style="font-size:0.75rem;line-height:1.4;vertical-align:middle;padding:0.15rem 0.55rem;">
                                   <i class="bi bi-eye me-1"></i>View Tests
                               </button>` : '');

                        var badgeDisc = item.isDiscountAllowed
                            ? `<span class="badge bg-success-subtle text-success border border-success-subtle ms-1" style="font-size:0.68rem;padding:0.2rem 0.45rem" title="Discount allowed as per rate list"><i class="bi bi-tag-fill me-1"></i>Disc. Allowed</span>`
                            : `<span class="badge bg-light text-muted border ms-1" style="font-size:0.68rem;padding:0.2rem 0.45rem" title="No discount allowed"><i class="bi bi-slash-circle me-1"></i>No Disc.</span>`;

                        $tbody.append(`
                            <tr>
                                <td class="text-center text-muted fw-semibold">${idx + 1}</td>
                                <td><span class="badge bg-light text-primary font-monospace border px-2 py-1">${item.testCode}</span></td>
                                <td><span class="fw-bold text-dark">${item.testName}</span> ${badgeProfile} ${badgeDisc}</td>
                                <td>
                                    <div class="fw-semibold">${item.sampleType || '-'}</div>
                                    <small class="text-muted">${item.method || '-'}</small>
                                </td>
                                <td><span class="badge bg-light text-secondary border small"><i class="bi bi-clock me-1"></i>${item.tatHours ? item.tatHours + ' hrs' : '-'}</span></td>
                                <td class="text-end font-monospace fw-bold text-success fs-6">₹${item.price.toFixed(2)}</td>
                                <td class="text-center">
                                    <div class="form-check d-flex justify-content-center m-0">
                                        <input class="form-check-input chk-urgent" type="checkbox" data-id="${item.investigationId}" ${item.isUrgent ? 'checked' : ''} title="Mark as Urgent">
                                    </div>
                                </td>
                                <td class="text-center">
                                    <button type="button" class="btn btn-sm btn-outline-danger border-0 rounded-circle btn-remove" data-id="${item.investigationId}" title="Remove test" style="width:32px;height:32px;">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </td>
                            </tr>
                        `);
                    });
                }

                $('#badgeSelectedCount').text(`${lineItems.length} Test${lineItems.length === 1 ? '' : 's'} Selected`);
                $('#lblTotalAmount').text(`₹ ${total.toFixed(2)}`);
                $('#lineItemsJson').val(JSON.stringify(lineItems.map(x => ({
                    investigationId: x.investigationId,
                    type: (x.isPackage ? 'P' : 'I'),
                    isPackage: !!x.isPackage,
                    price: x.price
                }))));
            }

            // Initial empty table render
            renderTable();

            // ── View Profile Tests Modal Handler ─────────────────────────────────
            $(document).on('click', '.btn-view-profile', function (e) {
                e.preventDefault();
                e.stopPropagation();

                var $el = $(this).closest('.btn-view-profile');
                var testId = $el.attr('data-test-id') || $el.data('test-id');
                var profileId = $el.attr('data-profile-id') || $el.data('profile-id');
                var testName = $el.attr('data-test-name') || $el.data('test-name') || 'Profile';
                var profileUrl = $el.attr('data-profile-url') || $el.data('profile-url');

                $('#pvmProfileCode').text('...');
                $('#pvmProfileName').text(testName);
                $('#pvmTestCount').text('Loading tests...');
                $('#pvmLoader').removeClass('d-none');
                $('#pvmTableContainer').addClass('d-none');
                $('#pvmError').addClass('d-none');
                $('#pvmTbody').empty();

                if (profileUrl) {
                    $('#btnProfileFullDetails').attr('href', profileUrl).removeClass('d-none');
                } else {
                    $('#btnProfileFullDetails').addClass('d-none');
                }

                var modalEl = document.getElementById('profileInvestigationsModal');
                if (modalEl) {
                    if (modalEl.parentElement !== document.body) {
                        document.body.appendChild(modalEl);
                    }
                    if (window.bootstrap && bootstrap.Modal) {
                        bootstrap.Modal.getOrCreateInstance(modalEl).show();
                    } else {
                        $('#profileInvestigationsModal').modal('show');
                    }
                }

                var reqData = {};
                if (profileId && parseInt(profileId) > 0) reqData.profileId = parseInt(profileId);
                if (testId && parseInt(testId) > 0) reqData.testId = parseInt(testId);

                $.ajax({
                    url: '/LabOrderBooking/GetProfileDetails',
                    type: 'GET',
                    data: reqData,
                    dataType: 'json',
                    success: function (res) {
                        $('#pvmLoader').addClass('d-none');
                        if (res && res.success) {
                            $('#pvmProfileCode').text(res.profileCode || 'PRF');
                            $('#pvmProfileName').text(res.profileName || testName);
                            $('#pvmTestCount').text(`${res.testCount} Tests Included`);

                            if (res.profileUrl) {
                                $('#btnProfileFullDetails').attr('href', res.profileUrl).removeClass('d-none');
                            }

                            var tbodyHtml = '';
                            (res.tests || []).forEach(function (t) {
                                tbodyHtml += `
                                    <tr>
                                        <td class="text-center font-monospace text-muted small">${t.sequence}</td>
                                        <td class="fw-semibold text-primary font-monospace small">${t.testCode}</td>
                                        <td class="fw-semibold text-dark">${t.testName}</td>
                                        <td class="small text-muted">${t.categoryName || '-'}</td>
                                        <td class="text-end font-monospace small">₹${(t.mrp || 0).toFixed(2)}</td>
                                    </tr>
                                `;
                            });
                            $('#pvmTbody').html(tbodyHtml);
                            $('#pvmTableContainer').removeClass('d-none');
                        } else {
                            $('#pvmError').text(res.message || 'Failed to load profile investigations.').removeClass('d-none');
                        }
                    },
                    error: function (xhr, status, err) {
                        $('#pvmLoader').addClass('d-none');
                        $('#pvmError').text('Error loading profile tests: ' + (err || status)).removeClass('d-none');
                    }
                });
            });

            // ── Pre-Save Payment Flow on Form Submit ────────────────────────────
            $('#labForm').on('submit', function (e) {
                e.preventDefault();

                // Validations
                var phone = ($('#phoneNumber').val() || '').trim();
                var rel = $('#ddlRelation').val();
                var fname = ($('input[name="FirstName"]').val() || '').trim();
                var lname = ($('input[name="LastName"]').val() || '').trim();
                var gender = $('#ddlGender').val();

                if (!phone || phone.length < 10) {
                    alert('Please enter a valid 10-digit mobile number.');
                    $('#phoneNumber').focus();
                    return;
                }
                if (!rel) {
                    alert('Please select Relation.');
                    $('#ddlRelation').focus();
                    return;
                }
                if (!fname) {
                    alert('Please enter First Name.');
                    $('input[name="FirstName"]').focus();
                    return;
                }
                if (!gender) {
                    alert('Please select Gender.');
                    $('#ddlGender').focus();
                    return;
                }
                if (!lineItems || lineItems.length === 0) {
                    if (typeof Swal !== 'undefined') {
                        Swal.fire('Validation Error', 'Please select at least one investigation test.', 'warning');
                    } else {
                        alert('Please select at least one investigation test.');
                    }
                    $('#ddlInvestigations').focus();
                    return;
                }

                var colType = $('input[name="CollectionType"]:checked').val();
                if (colType === 'Home Collection') {
                    var country = $('#ddlCountry').val();
                    if (!country) {
                        alert('Please select Country for Home Collection.');
                        $('#ddlCountry').next('.select2-container').find('.select2-selection').addClass('border-danger');
                        $('#ddlCountry').select2('open');
                        return;
                    } else {
                        $('#ddlCountry').next('.select2-container').find('.select2-selection').removeClass('border-danger');
                    }

                    var state = $('#ddlState').val();
                    if (!state) {
                        alert('Please select State for Home Collection.');
                        $('#ddlState').next('.select2-container').find('.select2-selection').addClass('border-danger');
                        $('#ddlState').select2('open');
                        return;
                    } else {
                        $('#ddlState').next('.select2-container').find('.select2-selection').removeClass('border-danger');
                    }

                    var homeAddr = $('#HomeCollectionAddress').val().trim();
                    if (!homeAddr) {
                        alert('Please enter Home Collection Address.');
                        $('#HomeCollectionAddress').addClass('is-invalid').focus();
                        return;
                    } else {
                        $('#HomeCollectionAddress').removeClass('is-invalid');
                    }

                    var phleb = $('#ddlPhlebotomist').val();
                    if (!phleb) {
                        alert('Please select a Phlebotomist for Home Collection.');
                        $('#ddlPhlebotomist').focus();
                        return;
                    }
                }

                // Booking Date & Time Auto-update if untouched
                if (typeof window.isBookingDateTouched !== 'undefined' && !window.isBookingDateTouched) {
                    var dtInputForSave = document.getElementById('txtBookingDateTime');
                    if (dtInputForSave) {
                        var _now = new Date();
                        var _y = _now.getFullYear();
                        var _m = String(_now.getMonth() + 1).padStart(2, '0');
                        var _d = String(_now.getDate()).padStart(2, '0');
                        var _hh = String(_now.getHours()).padStart(2, '0');
                        var _mm = String(_now.getMinutes()).padStart(2, '0');
                        dtInputForSave.value = `${_y}-${_m}-${_d}T${_hh}:${_mm}`;
                    }
                }

                // Booking Date & Time Validation
                var bookingDateTimeStr = $('#txtBookingDateTime').val();
                if (!bookingDateTimeStr) {
                    alert('Please select Booking Date & Time.');
                    $('#txtBookingDateTime').addClass('is-invalid').focus();
                    return;
                }
                var selectedBookingDate = new Date(bookingDateTimeStr);
                if (selectedBookingDate < new Date(Date.now() - 60000)) {
                    alert('Booking Date & Time cannot be less than current Date & Time.');
                    $('#txtBookingDateTime').addClass('is-invalid').focus();
                    return;
                } else {
                    $('#txtBookingDateTime').removeClass('is-invalid');
                }

                var totalAmount = lineItems.reduce(function (sum, item) { return sum + (parseFloat(item.price) || 0); }, 0);
                var sal = $('#ddlSalutation').val() || '';
                var pCode = $('input[name="PatientCode"]').val() || 'New Patient';
                var fullName = (sal + ' ' + fname + ' ' + lname).trim();

                if (typeof window.pmOpenPreSave !== 'function') {
                    alert('Payment module is not initialized.');
                    return;
                }

                window.pmOpenPreSave({
                    moduleCode: 'LAB',
                    patientName: fullName,
                    patientCode: pCode,
                    patientPhone: phone,
                    subTotal: totalAmount,
                    items: lineItems.map(function (x) {
                        return {
                            lineRefId: x.investigationId,
                            itemName: x.testName,
                            serviceType: x.isProfileTest ? 'Profile' : 'Test',
                            originalAmount: x.price,
                            isGstRequired: false,
                            isDiscountAllowed: x.isDiscountAllowed === true
                        };
                    }),
                    onCancel: function () {
                        // Closed via Red Cross button - absolutely nothing is saved to DB!
                    },
                    onSave: async function (paymentData) {
                        await submitBookingWithPayment(paymentData);
                    },
                    onSkip: async function (paymentData) {
                        await submitBookingWithPayment(paymentData);
                    }
                });
            });

            var _isLabBookingSubmitting = false;
            async function submitBookingWithPayment(paymentData) {
                if (_isLabBookingSubmitting) return;
                _isLabBookingSubmitting = true;
                try {
                    // Update BookingDateTime if untouched right before submit so it never fails validation due to time elapsed on payment modal
                    if (typeof window.isBookingDateTouched !== 'undefined' && !window.isBookingDateTouched) {
                        var dtInputForSave = document.getElementById('txtBookingDateTime');
                        if (dtInputForSave) {
                            var _now = new Date();
                            var _y = _now.getFullYear();
                            var _m = String(_now.getMonth() + 1).padStart(2, '0');
                            var _d = String(_now.getDate()).padStart(2, '0');
                            var _hh = String(_now.getHours()).padStart(2, '0');
                            var _mm = String(_now.getMinutes()).padStart(2, '0');
                            dtInputForSave.value = `${_y}-${_m}-${_d}T${_hh}:${_mm}`;
                        }
                    }

                    var formEl = document.getElementById('labForm');
                    var formData = new FormData(formEl);
                    formData.append('paymentDataJson', JSON.stringify(paymentData));

                    var res = await fetch('@Url.Action("SaveBookingWithPayment", "LabOrderBooking")', {
                        method: 'POST',
                        body: formData
                    });
                    var result = await res.json();

                    if (!result.success) {
                        throw new Error(result.error || 'Failed to save booking');
                    }

                    // Hide payment modal
                    var pmModalEl = document.getElementById('paymentModal');
                    var pmModal = bootstrap.Modal.getInstance(pmModalEl);
                    if (pmModal) pmModal.hide();

                    // Populate Success Modal with generated details
                    $('#lblSuccessPatientName').text(`${result.patientName}`);
                    $('#lblSuccessPatientCode').text(result.patientCode);
                    $('#lblSuccessBillNo').text(result.billNo);

                    if (result.tokenNo) {
                        $('#boxSuccessToken').removeClass('alert-warning').addClass('alert-success');
                        $('#lblSuccessTokenNo').text(result.tokenNo);
                    } else {
                        $('#boxSuccessToken').removeClass('alert-success').addClass('alert-warning');
                        $('#lblSuccessTokenNo').text('Pending Payment');
                    }

                    // Store labOrderId for print button
                    var printUrl = '@Url.Action("PrintBill", "LabOrderBooking")' + '?labOrderId=' + result.labOrderId;
                    $('#btnPrintBill').attr('href', printUrl);

                    var sm = new bootstrap.Modal(document.getElementById('bookingSuccessModal'));
                    sm.show();

                    // Auto-open print bill in new tab
                    window.open(printUrl, '_blank');

                    if (result.showPrintBarcode) {
                        var barcodeUrl = '@Url.Action("PrintBarcode", "SampleCollection")' + '?labOrderId=' + result.labOrderId;
                        $('#btnPrintBarcode').removeClass('d-none').attr('href', barcodeUrl);

                        setTimeout(() => {
                            Swal.fire({
                                title: 'Print Barcode Labels?',
                                text: 'Do you want to print the barcode labels for this order now?',
                                icon: 'question',
                                showCancelButton: true,
                                confirmButtonText: 'Yes, print barcodes',
                                cancelButtonText: 'No'
                            }).then((res) => {
                                if (res.isConfirmed) {
                                    window.open(barcodeUrl, '_blank');
                                }
                            });
                        }, 500);
                    }
                } catch (err) {
                    _isLabBookingSubmitting = false;
                    throw err;
                } finally {
                    _isLabBookingSubmitting = false;
                }
            }

        });
    </script>

    <script>
    const opdBase = '/OPD/';
    (function () {
        'use strict';
        const opdBase = '@Url.Content("~/OPD/")';

        // ── Utility ───────────────────────────────────────────────────────────
        async function fetchJson(url) {
            try {
                const r = await fetch(url);
                return r.ok ? await r.json() : null;
            } catch { return null; }
        }

        function setVal(nameOrId, val) {
            if (val === null || val === undefined) return;
            // Try by id first, then by name attribute
            let el = document.getElementById(nameOrId) ?? document.querySelector(`[name="${nameOrId}"]`);
            if (!el) return;
            el.value = val;
            if (el.tagName === 'SELECT' && el.classList.contains('select2-hidden-accessible')) {
                // If it is a Select2-enhanced select, update Select2 display as well
                $(el).val(val).trigger('change.select2');
            } else if (el.type !== 'hidden') {
                // Notify jQuery Unobtrusive Validation to re-evaluate so stale
                // errors (e.g. "Enter a valid 10-digit mobile number.") are cleared
                // when the field is populated programmatically.
                $(el).trigger('focusout');
            }
        }

        function resetS2(selectId, placeholder) {
            const $sel = $(`#${selectId}`);
            $sel.empty().append(new Option(placeholder, '', true, true)).trigger('change');
        }

        function showToast(msg, type = 'success') {
            const el = document.createElement('div');
            el.className = `toast align-items-center text-bg-${type} border-0 position-fixed bottom-0 end-0 m-3`;
            el.style.zIndex = 9999;
            el.setAttribute('role', 'alert');
            el.innerHTML = `<div class="d-flex">
                <div class="toast-body fw-semibold"><i class="bi bi-check-circle me-2"></i>${msg}</div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
            </div>`;
            document.body.appendChild(el);
            new bootstrap.Toast(el, { delay: 3000 }).show();
            el.addEventListener('hidden.bs.toast', () => el.remove());
        }

        // ── Slot Fetching ─────────────────────────────────────────────────────
        const $ddlDoctor = $('#ddlDoctor');
        const $txtAppointmentDate = $('#txtAppointmentDate');
        const $ddlSlot = $('#ddlSlot');
        const $hdnScheduleId = $('#hdnScheduleId');
        const $hdnAppointmentTime = $('#hdnAppointmentTime');

        async function fetchAvailableSlots() {
            const docId = $ddlDoctor.val();
            const date = $txtAppointmentDate.val();
            
            $ddlSlot.empty();
            
            if (!docId || !date) {
                $ddlSlot.append(new Option('-- Select Doctor & Date First --', ''));
                return;
            }
            
            $ddlSlot.append(new Option('Loading slots...', ''));
            
            const result = await fetchJson(`${opdBase}GetAvailableSlots?doctorId=${docId}&date=${date}`);
            $ddlSlot.empty();
            
            if (!result || !result.slots || result.slots.length === 0) {
                if (result && result.hasException) {
                    $ddlSlot.append(new Option(`-- Unavailable: ${result.exceptionReason} --`, ''));
                } else {
                    $ddlSlot.append(new Option('-- No available slots --', ''));
                }
                return;
            }
            
            $ddlSlot.append(new Option('-- Select Slot --', ''));
            result.slots.forEach(slot => {
                const opt = new Option(`${slot.slotTime} (${slot.bookedCount}/${slot.maxPerSlot} Booked)`, `${slot.scheduleId}|${slot.slotTime}`);
                if (!slot.isAvailable) {
                    opt.disabled = true;
                    opt.text += ' - FULL';
                }
                $ddlSlot.append(opt);
            });
            
            // Re-select if previously selected
            const prevSchId = $hdnScheduleId.val();
            const prevTime = $hdnAppointmentTime.val();
            if (prevSchId && prevTime) {
                // Formatting time properly (hh:mm:ss to hh:mm)
                const formattedTime = prevTime.length > 5 ? prevTime.substring(0, 5) : prevTime;
                const prevVal = `${prevSchId}|${formattedTime}`;
                $ddlSlot.val(prevVal);
            }
        }

        $ddlDoctor.on('change', fetchAvailableSlots);
        $txtAppointmentDate.on('change', fetchAvailableSlots);

        $ddlSlot.on('change', function() {
            const val = $(this).val();
            if (val) {
                const parts = val.split('|');
                $hdnScheduleId.val(parts[0]);
                $hdnAppointmentTime.val(parts[1]);
            } else {
                $hdnScheduleId.val('');
                $hdnAppointmentTime.val('');
            }
        });

        // ── Real-Time Booking Date & Time Min and Validation ─────────────────
        window.isBookingDateTouched = false;
        function updateBookingDateTimeMin() {
            var dtInput = document.getElementById('txtBookingDateTime');
            if (!dtInput) return;
            var now = new Date();
            var y = now.getFullYear();
            var m = String(now.getMonth() + 1).padStart(2, '0');
            var d = String(now.getDate()).padStart(2, '0');
            var hh = String(now.getHours()).padStart(2, '0');
            var mm = String(now.getMinutes()).padStart(2, '0');
            var minStr = `${y}-${m}-${d}T${hh}:${mm}`;
            dtInput.min = minStr;
        }

        $('#txtBookingDateTime').on('input change blur', function () {
            window.isBookingDateTouched = true;
            updateBookingDateTimeMin();
            var val = this.value;
            if (!val) {
                $(this).addClass('is-invalid');
                this.setCustomValidity('Booking Date & Time is required.');
                return;
            }
            var selected = new Date(val);
            if (selected < new Date(Date.now() - 60000)) {
                $(this).addClass('is-invalid');
                this.setCustomValidity('Booking Date & Time cannot be less than current Date & Time.');
            } else {
                $(this).removeClass('is-invalid');
                this.setCustomValidity('');
            }
        });

        $('#txtBookingDateTime').on('focus', function () {
            window.isBookingDateTouched = true;
            updateBookingDateTimeMin();
        });
        updateBookingDateTimeMin();

        // ── Real-time Auto-formatting: Capitalize Names & Lowercase Email ────
        function toTitleCase(str) {
            if (!str) return '';
            return str.replace(/\b\w/g, function (l) { return l.toUpperCase(); });
        }

        $('#FirstName, #MiddleName, #LastName, input[name="FirstName"], input[name="MiddleName"], input[name="LastName"], #GuardianName, input[name="GuardianName"]').on('input blur change', function () {
            const start = this.selectionStart;
            const end = this.selectionEnd;
            const originalVal = this.value;
            const capitalized = toTitleCase(originalVal);
            if (originalVal !== capitalized) {
                this.value = capitalized;
                if (this.setSelectionRange && document.activeElement === this) {
                    this.setSelectionRange(start, end);
                }
            }
        });

        $('#EmailId, input[name="EmailId"]').on('input blur change', function () {
            const start = this.selectionStart;
            const end = this.selectionEnd;
            const originalVal = this.value;
            const lower = originalVal.toLowerCase();
            if (originalVal !== lower) {
                this.value = lower;
                if (this.setSelectionRange && document.activeElement === this) {
                    this.setSelectionRange(start, end);
                }
            }
        });

        // ── Auto-select Gender based on chosen Title / Salutation ───────────
        function getGenderForTitle(title) {
            if (!title) return null;
            const t = title.trim().toLowerCase().replace(/\./g, '');
            if (['mr', 'master', 'shri', 'kumar', 'baba', 'baby_boy', 'babyboy'].includes(t)) {
                return 'Male';
            }
            if (['mrs', 'ms', 'miss', 'smt', 'kumari', 'baby_girl', 'babygirl'].includes(t)) {
                return 'Female';
            }
            return null; // For Dr., Prof., etc. leave current or manual selection
        }

        $('#ddlSalutation').on('change', function () {
            const selectedTitle = $(this).val();
            const autoGender = getGenderForTitle(selectedTitle);
            if (autoGender) {
                $('#ddlGender').val(autoGender).trigger('change.select2');
                $('#ddlGender').removeClass('is-invalid');
            }
        });
        
        // ── Initialise Select2 ────────────────────────────────────────────────
        // s2-basic  → dropdown only (no search box for short lists)
        // s2-search → includes search/auto-suggest box (Department, Category, Sub Category, Geography, Doctors…)

        const commonOpts = {
            theme: 'bootstrap-5',
            width: '100%',
            dropdownParent: $(document.body)   // avoids z-index issues inside panels
        };

        $('.s2-basic').select2({ ...commonOpts, minimumResultsForSearch: Infinity });
        $('.s2-search').each(function () {
            const ph = $(this).attr('data-placeholder') || $(this).find('option:first').text() || '';
            $(this).select2({
