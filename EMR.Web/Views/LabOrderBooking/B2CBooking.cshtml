                                    ${p.dateOfBirth ? `<span><i class="bi bi-calendar3 me-1"></i>${p.dateOfBirth.substring(0,10)}</span>` : ''}
                                </div>
                            </button>`).join('');
                        topSearchDropdown.style.display = 'block';
                        topKbdIndex = 0;
