        }

        if (searchType) {
            searchType.addEventListener('change', () => {
                updateSearchPlaceholder();
                searchInput?.focus();
            });
        }

        function getTopSearchUrl(val) {
            val = val.trim();
            const type = searchType?.value || 'phone';
            // Smart auto-detection: if type is phone but value contains non-digits, search by name
            const isAllDigits = /^\d+$/.test(val);

            if (type === 'phone') {
                if (!isAllDigits && val.length >= 2) {
                    return opdBase + 'SearchPatientByName?name=' + encodeURIComponent(val);
                }
                return opdBase + 'SearchPatientByPhone?phone=' + encodeURIComponent(val);
            } else if (type === 'code') {
                return opdBase + 'SearchPatientByCode?code=' + encodeURIComponent(val);
            } else if (type === 'name') {
                if (isAllDigits && val.length >= 3) {
                    return opdBase + 'SearchPatientByPhone?phone=' + encodeURIComponent(val);
                }
                return opdBase + 'SearchPatientByName?name=' + encodeURIComponent(val);
            }
            return opdBase + 'SearchPatientByName?name=' + encodeURIComponent(val);
        }

        function getTopItems() {
            return topSearchDropdown ? Array.from(topSearchDropdown.querySelectorAll('.top-sug')) : [];
        }

        function setTopKbdActive(idx) {
            const items = getTopItems();
            if (!items.length) return;
            items.forEach(i => i.classList.remove('kbd-active'));
            if (idx < 0) {
                topKbdIndex = -1;
                return;
            }
            topKbdIndex = Math.max(0, Math.min(idx, items.length - 1));
            items[topKbdIndex].classList.add('kbd-active');
            items[topKbdIndex].scrollIntoView({ block: 'nearest', behavior: 'smooth' });
        }

        // Live Type-Ahead for Top Search Input
        if (searchInput && topSearchDropdown) {
            searchInput.addEventListener('keydown', function (e) {
                if (topSearchDropdown.style.display === 'none') {
                    if (e.key === 'Enter') {
                        e.preventDefault();
                        btnSearch?.click();
                    }
                    return;
                }

                const items = getTopItems();
                if (!items.length) return;

                if (e.key === 'ArrowDown') {
                    e.preventDefault();
                    var next = (topKbdIndex < 0) ? 0 : (topKbdIndex + 1 >= items.length ? 0 : topKbdIndex + 1);
                    setTopKbdActive(next);
                } else if (e.key === 'ArrowUp') {
                    e.preventDefault();
                    var prev = (topKbdIndex <= 0) ? items.length - 1 : topKbdIndex - 1;
                    setTopKbdActive(prev);
                } else if (e.key === 'Enter') {
                    e.preventDefault();
                    var targetIdx = topKbdIndex >= 0 ? topKbdIndex : 0;
                    if (items[targetIdx]) {
                        populatePatient(items[targetIdx].dataset.id);
                        topSearchDropdown.style.display = 'none';
                        topKbdIndex = -1;
                    }
                } else if (e.key === 'Escape' || e.key === 'Tab') {
                    topSearchDropdown.style.display = 'none';
                    topKbdIndex = -1;
                }
            });

