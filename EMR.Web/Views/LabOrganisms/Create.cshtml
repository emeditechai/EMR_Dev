@model EMR.Web.Models.ViewModels.LabOrganismFormViewModel

@{
    ViewData["Title"] = "Create Organism";
}

<div class="container-fluid px-4 py-3">
    <div class="mb-4">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                <li class="breadcrumb-item text-muted">Lab Master</li>
                <li class="breadcrumb-item"><a asp-action="Index">Organism Master</a></li>
                <li class="breadcrumb-item active" aria-current="page">Create</li>
            </ol>
        </nav>
        <h4 class="fw-bold mb-0 text-primary">
            <i class="bi bi-plus-circle me-2"></i>Create Organism
        </h4>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-9">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-primary text-white p-3">
                    <h5 class="card-title mb-0 fw-semibold"><i class="bi bi-bug me-2"></i>Organism Details</h5>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Create" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="CompanyId" />
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4" role="alert"></div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label fw-semibold text-muted">Organism Code</label>
                                <input class="form-control font-monospace bg-light" disabled placeholder="Auto-generated on save (e.g. ORG0001)" />
                            </div>
                            <div class="col-md-6"></div>

                            <div class="col-md-6">
                                <label asp-for="Organism_Name" class="form-label fw-semibold required-field"></label>
                                <input asp-for="Organism_Name" class="form-control" placeholder="e.g. Escherichia coli" maxlength="150" />
                                <span asp-validation-for="Organism_Name" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Gram_Type" class="form-label fw-semibold required-field"></label>
                                <select asp-for="Gram_Type" class="form-select">
                                    <option value="">-- Select Gram Type --</option>
                                    @foreach (var o in EMR.Web.Models.ViewModels.LabOrganismFormViewModel.Gram_TypeOptions)
                                    {
                                        <option value="@o">@o</option>
                                    }
                                </select>
                                <span asp-validation-for="Gram_Type" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Organism_Type" class="form-label fw-semibold required-field"></label>
                                <select asp-for="Organism_Type" class="form-select">
                                    <option value="">-- Select Organism Type --</option>
                                    @foreach (var o in EMR.Web.Models.ViewModels.LabOrganismFormViewModel.Organism_TypeOptions)
                                    {
                                        <option value="@o">@o</option>
                                    }
                                </select>
                                <span asp-validation-for="Organism_Type" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Organism_Category" class="form-label fw-semibold required-field"></label>
                                <select asp-for="Organism_Category" class="form-select">
                                    <option value="">-- Select Category --</option>
                                    @foreach (var o in EMR.Web.Models.ViewModels.LabOrganismFormViewModel.Organism_CategoryOptions)
                                    {
                                        <option value="@o">@o</option>
                                    }
                                </select>
                                <span asp-validation-for="Organism_Category" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="WHONET_Code" class="form-label fw-semibold"></label>
                                <input asp-for="WHONET_Code" class="form-control" placeholder="From the official WHONET organism list" maxlength="10" />
                                <small class="text-muted">Optional. Needed only for WHONET / ICMR-AMRSN surveillance export.</small>
                                <span asp-validation-for="WHONET_Code" class="text-danger small"></span>
                            </div>

                            <div class="col-md-12">
                                <label asp-for="Description" class="form-label fw-semibold"></label>
                                <textarea asp-for="Description" class="form-control" rows="3" placeholder="Clinical notes, identification remarks..."></textarea>
                                <span asp-validation-for="Description" class="text-danger small"></span>
                            </div>
                        </div>

                        <hr class="my-4" />

                        <div class="d-flex justify-content-end gap-2">
                            <a asp-action="Index" class="btn btn-outline-secondary px-4">
                                <i class="bi bi-x-lg me-1"></i> Cancel
                            </a>
                            <button type="submit" class="btn btn-primary px-4 shadow-sm">
                                <i class="bi bi-save me-1"></i> Save Organism
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
