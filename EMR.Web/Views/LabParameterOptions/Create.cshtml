@model EMR.Web.Models.ViewModels.LabParameterOptionFormViewModel

@{
    ViewData["Title"] = "Create Parameter Option";
}
@section HeadStyles {
<link rel="stylesheet" href="~/lib/select2/dist/css/select2.min.css" />
<link rel="stylesheet" href="~/lib/select2-bootstrap-5-theme/dist/select2-bootstrap-5-theme.min.css" />
}

<div class="container-fluid px-4 py-3">
    <div class="mb-4">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                <li class="breadcrumb-item text-muted">Lab Master</li>
                <li class="breadcrumb-item"><a asp-action="Index">Parameter Option Master</a></li>
                <li class="breadcrumb-item active" aria-current="page">Create</li>
            </ol>
        </nav>
        <h4 class="fw-bold mb-0 text-primary">
            <i class="bi bi-plus-circle me-2"></i>Create Parameter Option
        </h4>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-9">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-primary text-white p-3">
                    <h5 class="card-title mb-0 fw-semibold"><i class="bi bi-ui-radios me-2"></i>Parameter Option Details</h5>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Create" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="CompanyId" />
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4" role="alert"></div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label fw-semibold text-muted">Option Code</label>
                                <input class="form-control font-monospace bg-light" disabled placeholder="Auto-generated on save (e.g. OPT0001)" />
                            </div>
                            <div class="col-md-6"></div>

                            <div class="col-md-6">
                                <label asp-for="Test_ID" class="form-label fw-semibold required-field"></label>
                                <select asp-for="Test_ID" asp-items="Model.Test_IDOptions" class="form-select select2-single" data-placeholder="-- Select Test (Parameter) --">
                                    <option value="0"></option>
                                </select>
                                <small class="text-muted">Only investigations with Reporting Type "Select" are listed.</small>
                                <span asp-validation-for="Test_ID" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Option_Text" class="form-label fw-semibold required-field"></label>
                                <input asp-for="Option_Text" class="form-control" placeholder="e.g. Pale Yellow, Trace, 2+" maxlength="100" />
                                <span asp-validation-for="Option_Text" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Display_Order" class="form-label fw-semibold"></label>
                                <input asp-for="Display_Order" type="number" class="form-control" min="1" max="999" />
                                <span asp-validation-for="Display_Order" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6 d-flex align-items-end">
                                <div class="form-check form-switch mb-2">
                                    <input asp-for="Is_Abnormal" class="form-check-input" type="checkbox" role="switch" id="Is_AbnormalSwitch">
                                    <label class="form-check-label fw-semibold" for="Is_AbnormalSwitch">Abnormal Value</label>
                                </div>
                            </div>

                            <div class="col-md-6 d-flex align-items-end">
                                <div class="form-check form-switch mb-2">
                                    <input asp-for="Is_Default" class="form-check-input" type="checkbox" role="switch" id="Is_DefaultSwitch">
                                    <label class="form-check-label fw-semibold" for="Is_DefaultSwitch">Default Selection</label>
                                </div>
                            </div>
                        </div>

                        <hr class="my-4" />

                        <div class="d-flex justify-content-end gap-2">
                            <a asp-action="Index" class="btn btn-outline-secondary px-4">
                                <i class="bi bi-x-lg me-1"></i> Cancel
                            </a>
                            <button type="submit" class="btn btn-primary px-4 shadow-sm">
                                <i class="bi bi-save me-1"></i> Save Parameter Option
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/lib/select2/dist/js/select2.min.js"></script>
    <script>
        $(function () {
            $('.select2-single').each(function () {
                $(this).select2({ theme: 'bootstrap-5', width: '100%', placeholder: $(this).data('placeholder'), allowClear: true });
            });
            $('.select2-multi').each(function () {
                $(this).select2({ theme: 'bootstrap-5', width: '100%', placeholder: $(this).data('placeholder'), closeOnSelect: false });
            });
            // Keep the order in which items were picked, so it becomes the saved display order.
            $('.select2-multi').on('select2:select', function (e) {
                var el = $(e.params.data.element);
                el.detach();
                $(this).append(el).trigger('change');
            });
            // Tier per selected item. Rows follow the select's option order, which is also the posted order.
            $('.tier-grid').each(function () {
                var grid = $(this), sel = $('#' + grid.data('for')), tiers = {};
                (grid.data('tiers') || []).forEach(function (t) { tiers[t.id] = t.tier; });
                var labels = { 1: 'Tier 1 - First line', 2: 'Tier 2 - Second line', 3: 'Tier 3 - Restricted', 4: 'Tier 4 - Last resort' };
                function render() {
                    var body = grid.find('tbody').empty(), n = 0;
                    sel.find('option:selected').each(function () {
                        var id = parseInt(this.value, 10), t = tiers[id] || 1, opts = '';
                        for (var k = 1; k <= 4; k++) opts += '<option value="' + k + '"' + (k === t ? ' selected' : '') + '>' + labels[k] + '</option>';
                        body.append($('<tr>').append($('<td class="text-muted">').text(++n), $('<td>').text(this.text),
                            $('<td>').append($('<select class="form-select form-select-sm">').attr('name', grid.data('tiername')).attr('data-id', id).html(opts))));
                    });
                    grid.toggle(n > 0);
                }
                grid.on('change', 'select', function () { tiers[$(this).data('id')] = parseInt(this.value, 10); });
                sel.on('change', render);
                render();
            });
        });
    </script>
}
