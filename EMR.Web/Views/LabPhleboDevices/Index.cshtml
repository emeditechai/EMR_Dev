@{
    ViewData["Title"] = "Phlebotomist Phones";
}

<link rel="stylesheet" href="~/css/views/LabPhleboDevices/Index.css" asp-append-version="true" />

<div class="container-fluid px-4 py-3">
    <div class="mb-3">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                <li class="breadcrumb-item text-muted">LAB</li>
                <li class="breadcrumb-item active" aria-current="page">Phlebotomist Phones</li>
            </ol>
        </nav>
        <h4 class="fw-bold mb-0 text-primary"><i class="bi bi-phone me-2"></i>Phlebotomist Phones</h4>
        <div class="text-muted small">A phlebotomist's first phone is approved by itself. A new phone, or the app installed again, waits here until you approve it.</div>
    </div>

    <div class="row g-2 mb-3" id="pdTiles">
        <div class="col-6 col-lg"><button type="button" class="pd-tile pd-pending on" data-grp="PENDING"><div class="n" id="pdPending">0</div><div class="l">Waiting</div></button></div>
        <div class="col-6 col-lg"><button type="button" class="pd-tile pd-approved" data-grp="APPROVED"><div class="n" id="pdApproved">0</div><div class="l">Approved</div></button></div>
        <div class="col-6 col-lg"><button type="button" class="pd-tile pd-blocked" data-grp="REVOKED"><div class="n" id="pdBlocked">0</div><div class="l">Blocked</div></button></div>
        <div class="col-6 col-lg"><button type="button" class="pd-tile pd-all" data-grp=""><div class="n" id="pdAll">0</div><div class="l">All phones</div></button></div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table table-sm table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr><th>Phlebotomist</th><th>Phone</th><th>First seen</th><th>Last seen</th><th>Status</th><th class="text-end">Actions</th></tr>
                </thead>
                <tbody id="pdRows"><tr><td colspan="6" class="text-center text-muted py-4">Loading…</td></tr></tbody>
            </table>
        </div>
    </div>
</div>

<div class="modal fade" id="pdModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <form class="modal-content" id="pdForm" autocomplete="off">
            @Html.AntiForgeryToken()
            <div class="modal-header">
                <h6 class="modal-title fw-bold" id="pdModalTitle"></h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="small mb-2" id="pdModalPhone"></div>
                <div class="form-check d-none" id="pdOthersWrap">
                    <input class="form-check-input" type="checkbox" id="pdOthers" checked />
                    <label class="form-check-label small" for="pdOthers">Block this user's other phones</label>
                    <div class="form-text" id="pdOthersHint"></div>
                </div>
                <div class="alert alert-warning small py-2 mb-0 d-none" id="pdBlockNote">The phlebotomist cannot use the app on this phone until it is approved again.</div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light btn-sm" data-bs-dismiss="modal">Back</button>
                <button type="submit" class="btn btn-primary btn-sm" id="pdSave">Save</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script>
(() => {
    const STATUS = { PENDING: ['Waiting', 'bg-danger'], APPROVED: ['Approved', 'bg-success'], REVOKED: ['Blocked', 'bg-secondary'] };
    const esc = s => String(s ?? '').replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
    const when = s => s ? new Date(s).toLocaleString('en-IN', { day: 'numeric', month: 'short', hour: 'numeric', minute: '2-digit' }) : '—';
    const rows = document.getElementById('pdRows');
    const modalEl = document.getElementById('pdModal');
    const modal = new bootstrap.Modal(modalEl);
    let devices = [], group = 'PENDING', current = null, action = '';

    async function load() {
        try {
            const res = await (await fetch('@Url.Action("Devices")')).json();
            if (!res.success) { Swal.fire({ icon: 'error', text: res.message }); return; }
            devices = res.devices;
            render();
        } catch { rows.innerHTML = '<tr><td colspan="6" class="text-center text-danger py-4">Could not load the phones. Try again.</td></tr>'; }
    }

    function render() {
        const count = s => devices.filter(d => d.Status === s).length;
        pdPending.textContent = count('PENDING'); pdApproved.textContent = count('APPROVED'); pdBlocked.textContent = count('REVOKED'); pdAll.textContent = devices.length;
        const shown = group ? devices.filter(d => d.Status === group) : devices;
        if (!shown.length) { rows.innerHTML = '<tr><td colspan="6" class="text-center text-muted py-4">No phones here.</td></tr>'; return; }
        rows.innerHTML = shown.map(d => `
            <tr data-id="${d.PhleboDeviceId}">
                <td><div class="fw-semibold">${esc(d.UserName)}</div><div class="pd-note">${esc(d.Username)}</div></td>
                <td><div class="small fw-semibold">${esc(d.DeviceName || 'Phone')}</div><div class="pd-note">${esc(d.Platform)} · app ${esc(d.AppVersion)} · id …${esc(d.DeviceTail)}</div></td>
                <td class="small text-nowrap">${when(d.CreatedDate)}</td>
                <td class="small text-nowrap">${when(d.LastSeen)}</td>
                <td><span class="badge ${(STATUS[d.Status] || ['', 'bg-light text-dark'])[1]}">${esc((STATUS[d.Status] || [d.Status])[0])}</span>
                    ${d.ApprovedByName && d.Status === 'APPROVED' ? `<div class="pd-note">${esc(d.ApprovedByName)}, ${when(d.ApprovedDate)}</div>` : ''}
                    ${d.Status !== 'APPROVED' && d.OtherApproved > 0 ? `<div class="pd-note">${d.OtherApproved} other phone(s) approved</div>` : ''}</td>
                <td class="text-end text-nowrap">
                    ${d.Status !== 'APPROVED' ? '<button type="button" class="btn btn-success btn-sm pd-do" data-do="approve">Approve</button>' : ''}
                    ${d.Status !== 'REVOKED' ? '<button type="button" class="btn btn-outline-danger btn-sm pd-do" data-do="block">Block</button>' : ''}
                </td>
            </tr>`).join('');
    }

    rows.addEventListener('click', e => {
        const btn = e.target.closest('.pd-do'); if (!btn) return;
        current = devices.find(d => d.PhleboDeviceId === Number(btn.closest('tr').dataset.id));
        action = btn.dataset.do;
        const approve = action === 'approve';
        pdModalTitle.textContent = approve ? 'Approve phone' : 'Block phone';
        pdModalPhone.textContent = `${current.UserName} · ${current.DeviceName || 'Phone'} · id …${current.DeviceTail}`;
        pdOthersWrap.classList.toggle('d-none', !approve);
        pdOthers.checked = true;
        pdOthersHint.textContent = current.OtherApproved > 0 ? `${current.OtherApproved} other phone(s) of this user are approved now.` : 'Any other phones of this user will stop working.';
        pdBlockNote.classList.toggle('d-none', approve);
        pdSave.textContent = approve ? 'Approve' : 'Block';
        pdSave.className = 'btn btn-sm ' + (approve ? 'btn-success' : 'btn-danger');
        modal.show();
    });

    pdForm.addEventListener('submit', async e => {
        e.preventDefault();
        const body = new FormData();
        body.append('id', current.PhleboDeviceId);
        if (action === 'approve') body.append('blockOthers', pdOthers.checked);
        body.append('__RequestVerificationToken', document.querySelector('#pdForm input[name="__RequestVerificationToken"]').value);
        pdSave.disabled = true;
        try {
            const url = action === 'approve' ? '@Url.Action("Approve")' : '@Url.Action("Block")';
            const res = await (await fetch(url, { method: 'POST', body })).json();
            if (res.success) { modal.hide(); Swal.fire({ icon: 'success', text: res.message }); await load(); }
            else Swal.fire({ icon: 'error', text: res.message });
        } catch { Swal.fire({ icon: 'error', text: 'Could not save. Check the connection and try again.' }); }
        finally { pdSave.disabled = false; }
    });

    document.getElementById('pdTiles').addEventListener('click', e => {
        const t = e.target.closest('.pd-tile'); if (!t) return;
        group = t.dataset.grp;
        document.querySelectorAll('.pd-tile').forEach(x => x.classList.toggle('on', x === t));
        render();
    });
    load();
    setInterval(() => { if (!modalEl.classList.contains('show')) load(); }, 30000);
})();
</script>
}
