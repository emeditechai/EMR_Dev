@model EMR.Web.Models.ViewModels.LabRateCardIndexViewModel
@{
    ViewData["Title"] = "Lab Rate List (B2C)";
}

@section HeadStyles {
    <link href="~/lib/select2/dist/css/select2.min.css" rel="stylesheet" />
    <link href="~/lib/datatables/dataTables.bootstrap5.min.css" rel="stylesheet" />
}

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Lab Rate List (B2C)</h5>
        <a asp-action="Create" class="btn btn-primary btn-sm"><i class="bi bi-plus"></i> Create New</a>
    </div>
    <div class="card-body">
        <div class="row mb-3">
            <div class="col-md-3">
                <label class="form-label">Branch</label>
                <select id="filterBranch" class="form-select select2" asp-items="Model.BranchList">
                    <option value="">All Branches</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">Status</label>
                <select id="filterStatus" class="form-select">
                    <option value="">All</option>
                    <option value="true" selected>Active</option>
                    <option value="false">Inactive</option>
                </select>
            </div>
            <div class="col-md-3 d-flex align-items-end">
                <button id="btnSearch" class="btn btn-secondary me-2"><i class="bi bi-search"></i> Search</button>
            </div>
        </div>

        <table id="tblRateCards" class="table table-striped table-bordered w-100">
            <thead>
                <tr>
                    <th>Branch</th>
                    <th>Effective From</th>
                    <th>Effective To</th>
                    <th>Items Count</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
        </table>
    </div>
</div>

@section Scripts {
<script src="~/lib/select2/dist/js/select2.min.js"></script>
<script src="~/lib/datatables/jquery.dataTables.min.js"></script>
<script src="~/lib/datatables/dataTables.bootstrap5.min.js"></script>
<script>
    $(document).ready(function () {
        $('.select2').select2({ width: '100%' });

        var table = $('#tblRateCards').DataTable({
            ajax: {
                url: '@Url.Action("LoadData")',
                data: function (d) {
                    d.branchId = $('#filterBranch').val();
                    d.status = $('#filterStatus').val();
                }
            },
            columns: [
                { data: 'Branch_Name' },
                { 
                    data: 'Effective_From',
                    render: function(data) { return data ? data.substring(0,10) : ''; }
                },
                { 
                    data: 'Effective_To',
                    render: function(data) { return data ? data.substring(0,10) : ''; }
                },
                { data: 'ItemCount' },
                {
                    data: 'Status',
                    render: function (data, type, row) {
                        var checked = data ? 'checked' : '';
                        return `<div class="form-check form-switch text-center">
                                    <input class="form-check-input flexSwitchCheck" type="checkbox" data-id="${row.RateCard_ID}" ${checked}>
                                </div>`;
                    }
                },
                {
                    data: 'RateCard_ID',
                    render: function (data) {
                        return `<div class="btn-group btn-group-sm shadow-sm" role="group">
                                    <a href="@Url.Action("Edit")/${data}" class="btn btn-outline-primary" title="Edit Rate Card"><i class="bi bi-pencil"></i></a>
                                    <button type="button" class="btn btn-outline-danger btn-delete" data-id="${data}" title="Delete Rate Card"><i class="bi bi-trash"></i></button>
                                </div>`;
                    }
                }
            ]
        });

        $('#btnSearch').click(function () {
            table.ajax.reload();
        });

        $('#tblRateCards tbody').on('change', '.flexSwitchCheck', function () {
            var id = $(this).data('id');
            var status = $(this).is(':checked');
            
            $.ajax({
                url: '@Url.Action("ToggleStatus")',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({ RateCard_ID: id, Status: status }),
                success: function (res) {
                    if (res.success) {
                        toastr.success('Status updated successfully');
                    } else {
                        toastr.error(res.message);
                        table.ajax.reload(); // Revert toggle visually
                    }
                },
                error: function() { toastr.error('An error occurred'); table.ajax.reload(); }
            });
        });

        $('#tblRateCards tbody').on('click', '.btn-delete', function () {
            if (confirm('Are you sure you want to delete this Rate Card?')) {
                var id = $(this).data('id');
                $.ajax({
                    url: '@Url.Action("Delete")/' + id,
                    type: 'DELETE',
                    success: function (res) {
                        if (res.success) {
                            toastr.success('Deleted successfully');
                            table.ajax.reload();
                        } else {
                            toastr.error(res.message);
                        }
                    }
                });
            }
        });
    });
</script>
}
