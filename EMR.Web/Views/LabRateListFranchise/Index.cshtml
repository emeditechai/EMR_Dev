@model EMR.Web.Models.ViewModels.LabRateCardIndexViewModel
@{
    ViewData["Title"] = "Lab Rate List (Franchise)";
}

@section HeadStyles {
    <link href="~/lib/select2/dist/css/select2.min.css" rel="stylesheet" />
    <link href="~/lib/datatables/dataTables.bootstrap5.min.css" rel="stylesheet" />
}

<!-- Summary KPI Widgets Section -->
<div class="row g-3 mb-4">
    <div class="col-xl-3 col-md-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body p-3 d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small fw-semibold text-uppercase d-block">TOTAL RATE CARDS</span>
                    <h3 class="fw-bold mb-0 text-primary" id="widgetTotalRateCards">0</h3>
                    <span class="badge bg-success-subtle text-success mt-1" id="badgeTotalActiveCards">0 Active</span>
                </div>
                <div class="bg-primary text-white rounded-3 p-3 shadow-sm d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                    <i class="bi bi-card-checklist fs-4"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body p-3 d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small fw-semibold text-uppercase d-block">ACTIVE RATE CARDS</span>
                    <h3 class="fw-bold mb-0 text-success" id="widgetActiveRateCards">0</h3>
                    <span class="badge bg-success-subtle text-success mt-1">100% Active</span>
                </div>
                <div class="bg-success text-white rounded-3 p-3 shadow-sm d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                    <i class="bi bi-check-circle-fill fs-4"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body p-3 d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small fw-semibold text-uppercase d-block">LINKED FRANCHISES</span>
                    <h3 class="fw-bold mb-0 text-info" id="widgetLinkedFranchises">0</h3>
                    <span class="badge bg-success-subtle text-success mt-1" id="badgeFranchiseActive">0 Linked</span>
                </div>
                <div class="bg-info text-white rounded-3 p-3 shadow-sm d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                    <i class="bi bi-building-gear fs-4"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body p-3 d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small fw-semibold text-uppercase d-block">CONFIGURED ITEMS</span>
                    <h3 class="fw-bold mb-0 text-warning" id="widgetTotalItems">0</h3>
                    <span class="badge bg-success-subtle text-success mt-1">Items Total</span>
                </div>
                <div class="bg-warning text-dark rounded-3 p-3 shadow-sm d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                    <i class="bi bi-layers-fill fs-4"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Lab Rate List (Franchise)</h5>
        <a asp-action="Create" class="btn btn-primary btn-sm"><i class="bi bi-plus"></i> Create New</a>
    </div>
    <div class="card-body">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        <div class="row mb-3">
            <div class="col-md-3">
                <label class="form-label">Branch</label>
                <select id="filterBranch" class="form-select select2" asp-items="Model.BranchList">
                    @if (Model.IsHOBranch)
                    {
                        <option value="">All Branches</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">Status</label>
                <select id="filterStatus" class="form-select">
                    <option value="">All</option>
                    <option value="true" selected>Active</option>
                    <option value="false">Inactive</option>
                </select>
            </div>
            <div class="col-md-3 d-flex align-items-end">
                <button id="btnSearch" class="btn btn-secondary me-2"><i class="bi bi-search"></i> Search</button>
            </div>
        </div>

        <table id="tblRateCards" class="table table-striped table-bordered w-100">
            <thead>
                <tr>
                    <th>Branch</th>
                    <th>Franchise</th>
                    <th>Effective From</th>
                    <th>Effective To</th>
                    <th>Items Count</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
        </table>
    </div>
</div>

@section Scripts {
<script src="~/lib/select2/dist/js/select2.min.js"></script>
<script src="~/lib/datatables/jquery.dataTables.min.js"></script>
<script src="~/lib/datatables/dataTables.bootstrap5.min.js"></script>
<script>
    $(document).ready(function () {
        $('.select2').select2({ width: '100%' });

        var table = $('#tblRateCards').DataTable({
            ajax: {
                url: '@Url.Action("LoadData")',
                data: function (d) {
                    d.branchId = $('#filterBranch').val();
                    d.status = $('#filterStatus').val();
                }
            },
            columns: [
                { 
                    data: null,
                    render: function (data, type, row) {
                        return row.Branch_Name || row.branch_Name || '';
                    }
                },
                { 
                    data: null,
                    render: function (data, type, row) {
                        var name = row.Entity_Name || row.entity_Name || '';
                        return name ? `<span class="fw-semibold text-primary"><i class="bi bi-building-gear me-1"></i>${name}</span>` : '<span class="text-muted">N/A</span>';
                    }
                },
                { 
                    data: null,
                    render: function (data, type, row) {
                        var date = row.Effective_From || row.effective_From || '';
                        return date ? date.substring(0, 10) : '';
                    }
                },
                { 
                    data: null,
                    render: function (data, type, row) {
                        var date = row.Effective_To || row.effective_To || '';
                        return date ? date.substring(0, 10) : '';
                    }
                },
                { 
                    data: null,
                    render: function (data, type, row) {
                        return row.ItemCount !== undefined ? row.ItemCount : (row.itemCount !== undefined ? row.itemCount : 0);
                    }
                },
                {
                    data: null,
                    render: function (data, type, row) {
                        var st = row.Status !== undefined ? row.Status : row.status;
                        var id = row.RateCard_ID || row.rateCard_ID;
                        var checked = st ? 'checked' : '';
                        return `<div class="form-check form-switch text-center">
                                    <input class="form-check-input flexSwitchCheck" type="checkbox" data-id="${id}" ${checked}>
                                </div>`;
                    }
                },
                {
                    data: null,
                    render: function (data, type, row) {
                        var id = row.RateCard_ID || row.rateCard_ID;
                        var qToken = row.EncryptedId || row.encryptedId || id;
                        return `<div class="btn-group btn-group-sm shadow-sm" role="group">
                                    <a href="@Url.Action("Edit")?q=${encodeURIComponent(qToken)}" class="btn btn-outline-primary" title="Edit Rate Card"><i class="bi bi-pencil"></i></a>
                                    <button type="button" class="btn btn-outline-danger btn-delete" data-id="${id}" title="Delete Rate Card"><i class="bi bi-trash"></i></button>
                                </div>`;
                    }
                }
            ]
        });

        table.on('draw', function () {
            var data = table.rows({ filter: 'applied' }).data().toArray();
            var totalCards = data.length;
            var activeCards = data.filter(r => (r.Status !== undefined ? r.Status : r.status) === true).length;
            var uniqueFranchises = new Set(data.map(r => r.Entity_Name || r.entity_Name).filter(Boolean)).size;
            var totalItems = data.reduce((acc, r) => acc + (r.ItemCount !== undefined ? r.ItemCount : (r.itemCount !== undefined ? r.itemCount : 0)), 0);

            $('#widgetTotalRateCards').text(totalCards);
            $('#widgetActiveRateCards').text(activeCards);
            $('#widgetLinkedFranchises').text(uniqueFranchises);
            $('#widgetTotalItems').text(totalItems.toLocaleString());

            $('#badgeTotalActiveCards').text(activeCards + ' Active');
            $('#badgeFranchiseActive').text(uniqueFranchises + ' Linked');
        });

        $('#btnSearch').click(function () {
            table.ajax.reload();
        });

        $('#tblRateCards tbody').on('change', '.flexSwitchCheck', function () {
            var id = $(this).data('id');
            var status = $(this).is(':checked');
            
            $.ajax({
                url: '@Url.Action("ToggleStatus")',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({ RateCard_ID: id, Status: status }),
                success: function (res) {
                    if (res.success) {
                        toastr.success('Status updated successfully');
                    } else {
                        toastr.error(res.message);
                        table.ajax.reload();
                    }
                },
                error: function() { toastr.error('An error occurred'); table.ajax.reload(); }
            });
        });

        $('#tblRateCards tbody').on('click', '.btn-delete', function () {
            if (confirm('Are you sure you want to delete this Rate Card?')) {
                var id = $(this).data('id');
                $.ajax({
                    url: '@Url.Action("Delete")/' + id,
                    type: 'DELETE',
                    success: function (res) {
                        if (res.success) {
                            toastr.success('Deleted successfully');
                            table.ajax.reload();
                        } else {
                            toastr.error(res.message);
                        }
                    }
                });
            }
        });
    });
</script>
}
