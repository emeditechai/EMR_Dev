@model EMR.Web.Models.ViewModels.LabReportDispatchPageViewModel
@{
    ViewData["Title"] = "Lab Report Dispatch";
}

@section HeadStyles {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" />
    <style>
        .dispatch-wrapper {
            --ds-ready: #0f766e;    --ds-ready-bg: #ccfbf1;
            --ds-partial: #0369a1;  --ds-partial-bg: #e0f2fe;
            --ds-await: #b45309;    --ds-await-bg: #fef3c7;
            --ds-prog: #4f46e5;     --ds-prog-bg: #e0e7ff;
            --ds-printed: #15803d;  --ds-printed-bg: #dcfce7;
            --ds-total: #1e3a8a;    --ds-total-bg: #dbeafe;
            background-color: #f8f9fa;
            min-height: calc(100vh - 60px);
        }
        .dispatch-wrapper .fs-7 { font-size: 0.85rem !important; }
        .dispatch-wrapper .fs-8 { font-size: 0.78rem !important; }
        .dispatch-wrapper .fs-9 { font-size: 0.70rem !important; }

        /* KPI cards */
        .dispatch-wrapper .dsp-card { --c: var(--ds-total); --bg: var(--ds-total-bg); border-left: 4px solid var(--c) !important; transition: transform .15s, box-shadow .15s; position: relative; overflow: hidden; }
        .dispatch-wrapper .dsp-card::after { content: ""; position: absolute; right: -18px; top: -18px; width: 70px; height: 70px; border-radius: 50%; background: var(--bg); opacity: .55; }
        .dispatch-wrapper .dsp-card.is-clickable { cursor: pointer; }
        .dispatch-wrapper .dsp-card.is-clickable:hover { transform: translateY(-2px); box-shadow: 0 .4rem .8rem rgba(0,0,0,.09) !important; }
        .dispatch-wrapper .dsp-card.active-card { outline: 2px solid var(--c); background: linear-gradient(135deg, #fff 40%, var(--bg)); }
        .dispatch-wrapper .dsp-label { font-size: .68rem; letter-spacing: .3px; color: #6b7280; font-weight: 700; text-transform: uppercase; }
        .dispatch-wrapper .dsp-value { color: var(--c); font-weight: 800; line-height: 1.1; }
        .dispatch-wrapper .dsp-sub { font-size: .68rem; color: #6b7280; }
        .dispatch-wrapper .dsp-icon { width: 32px; height: 32px; border-radius: 50%; background: var(--bg); color: var(--c); display: flex; align-items: center; justify-content: center; font-size: .95rem; position: relative; z-index: 1; }
        .dispatch-wrapper .k-total   { --c: var(--ds-total);   --bg: var(--ds-total-bg); }
        .dispatch-wrapper .k-ready   { --c: var(--ds-ready);   --bg: var(--ds-ready-bg); }
        .dispatch-wrapper .k-partial { --c: var(--ds-partial); --bg: var(--ds-partial-bg); }
        .dispatch-wrapper .k-await   { --c: var(--ds-await);   --bg: var(--ds-await-bg); }
        .dispatch-wrapper .k-prog    { --c: var(--ds-prog);    --bg: var(--ds-prog-bg); }
        .dispatch-wrapper .k-printed { --c: var(--ds-printed); --bg: var(--ds-printed-bg); }
        .dispatch-wrapper .k-notprt  { --c: #c2410c; --bg: #ffedd5; }
        .dispatch-wrapper .k-urgent  { --c: #b91c1c; --bg: #fee2e2; }
        .dispatch-wrapper .k-crit    { --c: #9f1239; --bg: #ffe4e6; }
        .dispatch-wrapper .k-split   { --c: #7c3aed; --bg: #ede9fe; }
        .dispatch-wrapper .k-tat     { --c: #0e7490; --bg: #cffafe; }
        .dispatch-wrapper .k-tests   { --c: #166534; --bg: #dcfce7; }
        .dispatch-wrapper .mini-bar { height: 6px; border-radius: 4px; background: #e5e7eb; overflow: hidden; display: flex; }
        .dispatch-wrapper .mini-bar > span { display: block; height: 100%; }

        /* Table */
        .dispatch-wrapper .table-responsive-custom { max-height: calc(100vh - 430px); min-height: 260px; overflow-y: auto; }
        .dispatch-wrapper .table-sticky-header thead th { position: sticky; top: 0; background: #f1f5f9; z-index: 10; box-shadow: 0 1px 2px rgba(0,0,0,.06); }
        .dispatch-wrapper tbody tr.row-ready > td:first-child    { box-shadow: inset 4px 0 0 var(--ds-ready); }
        .dispatch-wrapper tbody tr.row-partial > td:first-child  { box-shadow: inset 4px 0 0 var(--ds-partial); }
        .dispatch-wrapper tbody tr.row-awaiting > td:first-child { box-shadow: inset 4px 0 0 #f59e0b; }
        .dispatch-wrapper tbody tr.row-inprogress > td:first-child { box-shadow: inset 4px 0 0 var(--ds-prog); }
        .dispatch-wrapper tbody tr.row-notstarted > td:first-child { box-shadow: inset 4px 0 0 #cbd5e1; }
        .dispatch-wrapper .badge-ds { font-weight: 600; border: 1px solid transparent; }
        .dispatch-wrapper .bs-ready      { background: var(--ds-ready-bg);   color: var(--ds-ready);   border-color: #5eead4; }
        .dispatch-wrapper .bs-partial    { background: var(--ds-partial-bg); color: var(--ds-partial); border-color: #7dd3fc; }
        .dispatch-wrapper .bs-awaiting   { background: var(--ds-await-bg);   color: var(--ds-await);   border-color: #fcd34d; }
        .dispatch-wrapper .bs-inprogress { background: var(--ds-prog-bg);    color: var(--ds-prog);    border-color: #a5b4fc; }
        .dispatch-wrapper .bs-notstarted { background: #f1f5f9;              color: #64748b;           border-color: #cbd5e1; }
        .dispatch-wrapper .type-b2c { background: #eff6ff; color: #1d4ed8; border-color: #bfdbfe; }
        .dispatch-wrapper .type-b2b { background: #f5f3ff; color: #6d28d9; border-color: #ddd6fe; }
        .dispatch-wrapper .tests-bar { height: 6px; border-radius: 4px; background: #e5e7eb; overflow: hidden; display: flex; min-width: 90px; }
        .dispatch-wrapper .tests-bar .seg-approved  { background: #0f766e; }
        .dispatch-wrapper .tests-bar .seg-validated { background: #4ade80; }
        .dispatch-wrapper .tests-bar .seg-entered   { background: #a5b4fc; }
        .dispatch-wrapper .btn-print-ready { background: #0f766e; border-color: #0f766e; color: #fff; }
        .dispatch-wrapper .btn-print-ready:hover { background: #115e59; color: #fff; }
        .dispatch-wrapper .btn-print-prov  { background: #f59e0b; border-color: #f59e0b; color: #fff; }
        .dispatch-wrapper .btn-print-prov:hover { background: #d97706; color: #fff; }
        .dispatch-wrapper .btn-icon-sm { width: 30px; height: 30px; padding: 0; display: inline-flex; align-items: center; justify-content: center; }
        .dispatch-wrapper .urgent-dot { display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: #dc2626; box-shadow: 0 0 0 3px #fee2e2; }
        .dispatch-wrapper #tblDispatch > :not(caption) > * > * { padding: .45rem .4rem; }
        .dispatch-wrapper #tblDispatch th:first-child, .dispatch-wrapper #tblDispatch td:first-child { padding-left: .75rem; }
        .dispatch-wrapper .cell-client { max-width: 150px; }
        .dispatch-wrapper .btn-view-tests { border: 0; background: transparent; color: #2563eb; padding: 0 2px; line-height: 1; font-size: .9rem; }
        .dispatch-wrapper .btn-view-tests:hover { color: #1d4ed8; transform: scale(1.12); }
        #modalBillTests .t-head th { position: sticky; top: 0; background: #f1f5f9; z-index: 5; font-size: .66rem; text-transform: uppercase; letter-spacing: .2px; color: #64748b; white-space: nowrap; }
        #modalBillTests td, #modalBillTests th { padding: .35rem .45rem; vertical-align: middle; }
        #modalBillTests table { table-layout: fixed; width: 100%; }
        #modalBillTests .c-idx { width: 30px; }
        #modalBillTests .c-test { width: 19%; }
        #modalBillTests .c-sample { width: 10%; }
        #modalBillTests .c-time { width: 10%; }
        #modalBillTests .c-by { width: 9%; }
        #modalBillTests .c-status { width: 9%; }
        #modalBillTests .c-tat { width: 7%; }
        #modalBillTests .stamp { font-size: .68rem; line-height: 1.2; display: block; white-space: nowrap; }
        #modalBillTests .stamp .s-t { display: block; color: #64748b; font-size: .64rem; }
        #modalBillTests .t-name { font-size: .75rem; line-height: 1.2; }
        #modalBillTests .t-sample { font-size: .68rem; line-height: 1.15; }
        #modalBillTests .grp-row td { background: #eef2ff; font-weight: 700; color: #3730a3; font-size: .72rem; }
        #modalBillTests .stamp { font-size: .72rem; white-space: nowrap; }
        #modalBillTests .stamp .s-none { color: #94a3b8; }
        #modalBillTests .badge-ds { font-weight: 600; border: 1px solid transparent; }
        #modalBillTests .bs-ready      { background: #ccfbf1; color: #0f766e; border-color: #5eead4; }
        #modalBillTests .bs-partial    { background: #e0f2fe; color: #0369a1; border-color: #7dd3fc; }
        #modalBillTests .bs-awaiting   { background: #fef3c7; color: #b45309; border-color: #fcd34d; }
        #modalBillTests .bs-inprogress { background: #e0e7ff; color: #4f46e5; border-color: #a5b4fc; }
        #modalBillTests .bs-notstarted { background: #f1f5f9; color: #64748b; border-color: #cbd5e1; }
        #modalBillTests .t-code { font-size: .66rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        #modalBillTests .t-reason { font-size: .64rem; color: #b91c1c; line-height: 1.2; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
        #modalBillTests .sum-pill { border: 1px solid #e2e8f0; border-radius: 8px; padding: .25rem .6rem; font-size: .72rem; background: #f8fafc; }
        #modalBillTests .sum-pill b { display: block; font-size: .95rem; }
        .dispatch-wrapper .dup-note { font-size: .62rem; color: #b45309; font-weight: 600; margin-top: 2px; }
        .dispatch-wrapper .tone-bar { height: 3px; background: linear-gradient(90deg, #0f766e, #0369a1, #4f46e5, #7c3aed); border-radius: 3px; }

        /* Print modal */
        #dispatchPrintFrame { width: 100%; height: 100%; border: 0; background: #525659; }
    </style>
}

<div class="container-fluid px-3 py-2 dispatch-wrapper">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-2 flex-wrap gap-2">
        <div class="d-flex align-items-center gap-2 flex-wrap">
            <h5 class="mb-0 fw-bold text-dark d-flex align-items-center">
                <i class="bi bi-printer-fill text-primary me-2"></i>Lab Report Dispatch
                <span class="badge bg-primary-subtle text-primary border border-primary-subtle ms-2 fs-9 fw-semibold">Bill No wise</span>
            </h5>
            <span class="text-muted fs-9 d-none d-md-inline border-start ps-2">Track report readiness and print reports for hand-over</span>
        </div>
        <div class="d-flex gap-2 align-items-center">
            <span class="text-muted fs-9" id="lblLastRefreshed"></span>
            <button type="button" class="btn btn-outline-primary btn-sm btn-icon-sm shadow-sm" id="btnRefresh" title="Refresh"><i class="bi bi-arrow-clockwise"></i></button>
        </div>
    </div>
    <div class="tone-bar mb-2"></div>

    <!-- Row 1: dispatch status cards (click to filter the list) -->
    <div class="row g-2 mb-2">
        <div class="col-6 col-md-4 col-xl-2">
            <div class="card shadow-sm border-0 rounded-3 h-100 dsp-card k-total is-clickable active-card" data-status="ALL">
                <div class="card-body py-2 px-3 d-flex align-items-center justify-content-between">
                    <div><div class="dsp-label">Total Bills</div><h4 class="mb-0 dsp-value" id="kTotal">0</h4><div class="dsp-sub">in selected range</div></div>
                    <div class="dsp-icon"><i class="bi bi-receipt"></i></div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-4 col-xl-2">
            <div class="card shadow-sm border-0 rounded-3 h-100 dsp-card k-ready is-clickable" data-status="READY">
                <div class="card-body py-2 px-3 d-flex align-items-center justify-content-between">
                    <div><div class="dsp-label">Ready to Dispatch</div><h4 class="mb-0 dsp-value" id="kReady">0</h4><div class="dsp-sub">all tests approved</div></div>
                    <div class="dsp-icon"><i class="bi bi-patch-check-fill"></i></div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-4 col-xl-2">
            <div class="card shadow-sm border-0 rounded-3 h-100 dsp-card k-partial is-clickable" data-status="PARTIAL">
                <div class="card-body py-2 px-3 d-flex align-items-center justify-content-between">
                    <div><div class="dsp-label">Partially Approved</div><h4 class="mb-0 dsp-value" id="kPartial">0</h4><div class="dsp-sub">some tests approved</div></div>
                    <div class="dsp-icon"><i class="bi bi-hourglass-split"></i></div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-4 col-xl-2">
            <div class="card shadow-sm border-0 rounded-3 h-100 dsp-card k-await is-clickable" data-status="AWAITING">
                <div class="card-body py-2 px-3 d-flex align-items-center justify-content-between">
                    <div><div class="dsp-label">Awaiting Approval</div><h4 class="mb-0 dsp-value" id="kAwaiting">0</h4><div class="dsp-sub">validated, not approved</div></div>
                    <div class="dsp-icon"><i class="bi bi-shield-check"></i></div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-4 col-xl-2">
            <div class="card shadow-sm border-0 rounded-3 h-100 dsp-card k-prog is-clickable" data-status="INPROGRESS">
                <div class="card-body py-2 px-3 d-flex align-items-center justify-content-between">
                    <div><div class="dsp-label">In Progress</div><h4 class="mb-0 dsp-value" id="kProgress">0</h4><div class="dsp-sub">entry / validation pending</div></div>
                    <div class="dsp-icon"><i class="bi bi-pencil-square"></i></div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-4 col-xl-2">
            <div class="card shadow-sm border-0 rounded-3 h-100 dsp-card k-printed is-clickable" data-status="PRINTED">
                <div class="card-body py-2 px-3 d-flex align-items-center justify-content-between">
                    <div><div class="dsp-label">Printed</div><h4 class="mb-0 dsp-value" id="kPrinted">0</h4><div class="dsp-sub">final report printed</div></div>
                    <div class="dsp-icon"><i class="bi bi-printer-fill"></i></div>
                </div>
            </div>
        </div>
    </div>

    <!-- Row 2: insight cards -->
    <div class="row g-2 mb-2">
        <div class="col-6 col-md-4 col-xl-2">
            <div class="card shadow-sm border-0 rounded-3 h-100 dsp-card k-notprt is-clickable" data-status="NOTPRINTED">
                <div class="card-body py-2 px-3 d-flex align-items-center justify-content-between">
                    <div><div class="dsp-label">Ready · Not Printed</div><h4 class="mb-0 dsp-value" id="kNotPrinted">0</h4><div class="dsp-sub" id="kNotPrintedSub">waiting for hand-over</div></div>
                    <div class="dsp-icon"><i class="bi bi-box-seam"></i></div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-4 col-xl-2">
            <div class="card shadow-sm border-0 rounded-3 h-100 dsp-card k-urgent">
                <div class="card-body py-2 px-3 d-flex align-items-center justify-content-between">
                    <div><div class="dsp-label">Urgent Pending</div><h4 class="mb-0 dsp-value" id="kUrgent">0</h4><div class="dsp-sub">urgent bills not yet ready</div></div>
                    <div class="dsp-icon"><i class="bi bi-lightning-charge-fill"></i></div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-4 col-xl-2">
            <div class="card shadow-sm border-0 rounded-3 h-100 dsp-card k-crit">
                <div class="card-body py-2 px-3 d-flex align-items-center justify-content-between">
                    <div><div class="dsp-label">Critical Results</div><h4 class="mb-0 dsp-value" id="kCritical">0</h4><div class="dsp-sub">bills with critical values</div></div>
                    <div class="dsp-icon"><i class="bi bi-exclamation-triangle-fill"></i></div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-4 col-xl-2">
            <div class="card shadow-sm border-0 rounded-3 h-100 dsp-card k-split">
                <div class="card-body py-2 px-3">
                    <div class="d-flex justify-content-between align-items-start">
                        <div><div class="dsp-label">B2C · B2B</div><h4 class="mb-0 dsp-value"><span id="kB2C">0</span> <span class="text-muted fw-normal fs-7">/</span> <span id="kB2B">0</span></h4></div>
                        <div class="dsp-icon"><i class="bi bi-diagram-2-fill"></i></div>
                    </div>
                    <div class="mini-bar mt-1"><span id="barB2C" style="background:#3b82f6;width:0"></span><span id="barB2B" style="background:#7c3aed;width:0"></span></div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-4 col-xl-2">
            <div class="card shadow-sm border-0 rounded-3 h-100 dsp-card k-tat">
                <div class="card-body py-2 px-3 d-flex align-items-center justify-content-between">
                    <div><div class="dsp-label">Avg. Turnaround</div><h4 class="mb-0 dsp-value" id="kTat">—</h4><div class="dsp-sub">billing → final approval</div></div>
                    <div class="dsp-icon"><i class="bi bi-stopwatch-fill"></i></div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-4 col-xl-2">
            <div class="card shadow-sm border-0 rounded-3 h-100 dsp-card k-tests">
                <div class="card-body py-2 px-3">
                    <div class="d-flex justify-content-between align-items-start">
                        <div><div class="dsp-label">Tests Approved</div><h4 class="mb-0 dsp-value"><span id="kTestsApproved">0</span><span class="text-muted fw-normal fs-7"> / <span id="kTestsTotal">0</span></span></h4></div>
                        <div class="dsp-icon"><i class="bi bi-clipboard2-check-fill"></i></div>
                    </div>
                    <div class="mini-bar mt-1"><span id="barTestsApproved" style="background:#0f766e;width:0"></span><span id="barTestsValidated" style="background:#4ade80;width:0"></span></div>
                </div>
            </div>
        </div>
    </div>

    <!-- Filters -->
    <div class="card shadow-sm border-0 rounded-3 mb-2">
        <div class="card-body p-2 px-3">
            <div class="row g-2 align-items-end">
                <div class="col-6 col-md-2">
                    <label class="form-label fs-9 text-muted mb-0 fw-bold text-uppercase">Filter By Date</label>
                    <select id="selDateBasis" class="form-select form-select-sm fs-8">
                        <option value="BillingDate" selected>Billing Date</option>
                        <option value="ApprovedDate">Approved Date</option>
                    </select>
                </div>
                <div class="col-6 col-md-2">
                    <label class="form-label fs-9 text-muted mb-0 fw-bold text-uppercase">From Date</label>
                    <input type="date" id="txtFromDate" class="form-control form-control-sm fs-8" value="@Model.FromDate.ToString("yyyy-MM-dd")" />
                </div>
                <div class="col-6 col-md-2">
                    <label class="form-label fs-9 text-muted mb-0 fw-bold text-uppercase">To Date</label>
                    <input type="date" id="txtToDate" class="form-control form-control-sm fs-8" value="@Model.ToDate.ToString("yyyy-MM-dd")" />
                </div>
                <div class="col-12 col-md-3">
                    <label class="form-label fs-9 text-muted mb-0 fw-bold text-uppercase">Quick Select</label>
                    <div class="btn-group btn-group-sm w-100" role="group">
                        <button type="button" class="btn btn-outline-secondary btn-quick-date fs-9 active" data-range="today">Today</button>
                        <button type="button" class="btn btn-outline-secondary btn-quick-date fs-9" data-range="yesterday">Yesterday</button>
                        <button type="button" class="btn btn-outline-secondary btn-quick-date fs-9" data-range="week">7 Days</button>
                        <button type="button" class="btn btn-outline-secondary btn-quick-date fs-9" data-range="month">This Month</button>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <label class="form-label fs-9 text-muted mb-0 fw-bold text-uppercase">Billing Type</label>
                    <div class="btn-group btn-group-sm w-100" role="group">
                        <button type="button" class="btn btn-outline-primary btn-client-type fs-9 active" data-type="ALL">All</button>
                        <button type="button" class="btn btn-outline-primary btn-client-type fs-9" data-type="B2C">B2C</button>
                        <button type="button" class="btn btn-outline-primary btn-client-type fs-9" data-type="B2B">B2B</button>
                    </div>
                </div>
                <div class="col-12 col-md-6">
                    <label class="form-label fs-9 text-muted mb-0 fw-bold text-uppercase">Search</label>
                    <div class="input-group input-group-sm">
                        <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
                        <input type="text" id="txtSearch" class="form-control border-start-0 fs-8" placeholder="Patient ID, Patient name, Bill No, Token, Phone, Franchise / Company..." autocomplete="off" />
                        <button type="button" class="btn btn-outline-secondary fs-8" id="btnClearSearch" title="Clear search" style="display:none;"><i class="bi bi-x-lg"></i></button>
                    </div>
                </div>
                <div class="col-12 col-md-6 d-flex align-items-center justify-content-md-end gap-2">
                    <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle fs-9 d-none" id="chipStatusFilter"></span>
                    <button type="button" class="btn btn-link btn-sm text-decoration-none text-danger p-0 fs-9" id="btnResetFilters"><i class="bi bi-x-circle me-1"></i>Reset Filters</button>
                    <button type="button" class="btn btn-primary btn-sm fs-8 px-3" id="btnApply"><i class="bi bi-funnel me-1"></i>Apply</button>
                </div>
            </div>
        </div>
    </div>

    <!-- List -->
    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-header bg-white border-bottom py-2 px-3 d-flex justify-content-between align-items-center">
            <span class="fw-bold fs-7 text-dark"><i class="bi bi-list-check text-primary me-1"></i>Bills <span class="badge bg-secondary-subtle text-secondary border fs-9 ms-1" id="lblRowCount">0</span></span>
            <div class="d-flex align-items-center gap-2">
                <span class="text-muted fs-9">Rows per page</span>
                <select id="selPageSize" class="form-select form-select-sm fs-9" style="width: 70px;">
                    <option>10</option><option selected>25</option><option>50</option><option>100</option>
                </select>
            </div>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive table-responsive-custom">
                <table class="table table-hover table-sticky-header align-middle mb-0" id="tblDispatch">
                    <thead>
                        <tr class="fs-9 text-muted text-uppercase fw-bold">
                            <th class="ps-3" style="width: 40px;">#</th>
                            <th>Bill / Token</th>
                            <th>Patient</th>
                            <th>Billing</th>
                            <th class="text-nowrap">Billing Date</th>
                            <th style="min-width: 150px;">Tests</th>
                            <th class="text-nowrap">Approved On</th>
                            <th class="text-center">Report Status</th>
                            <th class="text-center">Printed</th>
                            <th class="text-end pe-3" style="width: 170px;">Action</th>
                        </tr>
                    </thead>
                    <tbody id="tblDispatchBody" class="fs-8"></tbody>
                </table>
            </div>
            <div id="stateEmpty" class="text-center py-5 d-none">
                <i class="bi bi-inbox text-muted" style="font-size: 3rem;"></i>
                <div class="fw-bold text-dark fs-6 mt-2">No Bills Found</div>
                <div class="text-muted fs-8">No bills match the selected date, status and search.</div>
            </div>
            <div id="stateError" class="text-center py-5 d-none">
                <i class="bi bi-cloud-slash text-danger" style="font-size: 3rem;"></i>
                <div class="fw-bold text-dark fs-6 mt-2">Unable to load bills</div>
                <div class="text-muted fs-8" id="stateErrorText"></div>
                <button type="button" class="btn btn-outline-primary btn-sm mt-2" id="btnRetry"><i class="bi bi-arrow-clockwise me-1"></i>Retry</button>
            </div>
            <div id="stateLoading" class="text-center py-5">
                <div class="spinner-border text-primary" role="status"><span class="visually-hidden">Loading...</span></div>
                <div class="text-muted fs-8 mt-2">Loading lab reports&hellip;</div>
            </div>
        </div>
        <div class="card-footer bg-white border-top py-2 px-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
            <span class="text-muted fs-9" id="lblPageInfo"></span>
            <nav><ul class="pagination pagination-sm mb-0" id="pager"></ul></nav>
        </div>
    </div>
</div>

