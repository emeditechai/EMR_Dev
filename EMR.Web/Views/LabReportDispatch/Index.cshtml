@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
    <script>
        $(function () {
            toastr.options = { closeButton: true, progressBar: true, positionClass: 'toast-top-right', timeOut: '3500' };

            const dataUrl = '@Url.Action("GetDashboardJson", "LabReportDispatch")';
            const pdfUrl = '@Url.Action("PrintReportPdf", "LabReportDispatch")';
            const billUrl = '@Url.Action("PrintBill", "LabReportDispatch")';

            const STATUS_LABEL = { ALL: 'All bills', READY: 'Ready to Dispatch', PARTIAL: 'Partially Approved', AWAITING: 'Awaiting Approval', INPROGRESS: 'In Progress', PRINTED: 'Printed', NOTPRINTED: 'Ready · Not Printed' };
            const BADGE = {
                READY:      { cls: 'bs-ready',      icon: 'bi-patch-check-fill', text: 'Ready to Dispatch' },
                PARTIAL:    { cls: 'bs-partial',    icon: 'bi-hourglass-split',  text: 'Partially Approved' },
                AWAITING:   { cls: 'bs-awaiting',   icon: 'bi-shield-check',     text: 'Awaiting Approval' },
                INPROGRESS: { cls: 'bs-inprogress', icon: 'bi-pencil-square',    text: 'In Progress' },
                NOTSTARTED: { cls: 'bs-notstarted', icon: 'bi-clock-history',    text: 'Not Started' }
            };

            let rows = [];
            let page = 1;
            let statusFilter = 'ALL';
            let clientType = 'ALL';
            let searchTimer = null;
            let loadSeq = 0;

            const esc = s => String(s ?? '').replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
            const pad = n => String(n).padStart(2, '0');
            const iso = d => d.getFullYear() + '-' + pad(d.getMonth() + 1) + '-' + pad(d.getDate());
            const MON = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
            function fmt(dt) {
                if (!dt) return '—';
                const d = new Date(dt); if (isNaN(d)) return '—';
                let h = d.getHours(); const ap = h >= 12 ? 'PM' : 'AM'; h = h % 12 || 12;
                return pad(d.getDate()) + ' ' + MON[d.getMonth()] + ' ' + d.getFullYear() + ', ' + pad(h) + ':' + pad(d.getMinutes()) + ' ' + ap;
            }
            function fmtDur(min) {
                if (min == null) return '—';
                const m = Math.round(min);
                if (m < 60) return m + ' min';
                const h = Math.floor(m / 60), r = m % 60;
                if (h < 48) return h + 'h' + (r ? ' ' + r + 'm' : '');
                return (h / 24).toFixed(1) + ' d';
            }

            // ── Load ────────────────────────────────────────────────────────
            function showState(which) {
                $('#stateLoading, #stateEmpty, #stateError').addClass('d-none');
                if (which) $('#' + which).removeClass('d-none');
            }

            function load() {
                const seq = ++loadSeq;
                showState('stateLoading');
                $('#tblDispatchBody').empty();
                $('#pager').empty();

                $.get(dataUrl, {
                    fromDate: $('#txtFromDate').val(),
                    toDate: $('#txtToDate').val(),
                    dateBasis: $('#selDateBasis').val(),
                    search: $('#txtSearch').val(),
                    dispatchStatus: statusFilter,
                    clientType: clientType
                }).done(function (res) {
                    if (seq !== loadSeq) return; // a newer request superseded this one
                    if (!res || !res.success) {
                        $('#stateErrorText').text((res && res.message) || 'Unexpected response from the server.');
                        return showState('stateError');
                    }
                    rows = res.rows || [];
                    page = 1;
                    renderStats(res.stats || {});
                    renderTable();
                    $('#lblLastRefreshed').text('Updated ' + fmt(new Date()).split(', ')[1]);
                }).fail(function () {
                    if (seq !== loadSeq) return;
                    $('#stateErrorText').text('Server error while loading the dispatch list.');
                    showState('stateError');
                });
            }

            function renderStats(s) {
                $('#kTotal').text(s.totalBills || 0);
                $('#kReady').text(s.readyBills || 0);
                $('#kPartial').text(s.partialBills || 0);
                $('#kAwaiting').text(s.awaitingBills || 0);
                $('#kProgress').text(s.inProgressBills || 0);
                $('#kPrinted').text(s.printedBills || 0);
                $('#kNotPrinted').text(s.notPrintedBills || 0);
                $('#kNotPrintedSub').text(s.readyPaymentDueBills ? (s.readyPaymentDueBills + ' with payment due') : 'waiting for hand-over');
                $('#kUrgent').text(s.urgentPendingBills || 0);
                $('#kCritical').text(s.criticalBills || 0);

                const b2c = s.b2CBills || 0, b2b = s.b2BBills || 0, tot = b2c + b2b;
                $('#kB2C').text(b2c); $('#kB2B').text(b2b);
                $('#barB2C').css('width', tot ? (b2c * 100 / tot) + '%' : 0);
                $('#barB2B').css('width', tot ? (b2b * 100 / tot) + '%' : 0);

                $('#kTat').text(s.avgTatMinutes != null ? fmtDur(s.avgTatMinutes) : '—');

                const tt = s.totalTests || 0, ta = s.approvedTests || 0, tv = s.validatedTests || 0;
                $('#kTestsApproved').text(ta); $('#kTestsTotal').text(tt);
                $('#barTestsApproved').css('width', tt ? (ta * 100 / tt) + '%' : 0);
                $('#barTestsValidated').css('width', tt ? (tv * 100 / tt) + '%' : 0);
            }

            // ── Table + pager ───────────────────────────────────────────────
            function rowHtml(r, idx) {
                const b = BADGE[r.dispatchStatus] || BADGE.NOTSTARTED;
                const total = r.totalTests || 0;
                const pApp = total ? r.approvedTests * 100 / total : 0;
                const pVal = total ? r.validatedTests * 100 / total : 0;
                const pEnt = total ? Math.max(0, r.enteredTests - r.validatedTests - r.approvedTests) * 100 / total : 0;
                const isReady = r.dispatchStatus === 'READY';
                const isB2B = r.billingType === 'B2B';

                const paid = r.paymentStatus === 'P' || r.balanceDue <= 0;
                const payHtml = paid
                    ? '<span class="badge badge-ds bg-success-subtle text-success border-success-subtle fs-9">Paid</span>'
                    : '<span class="badge badge-ds bg-danger-subtle text-danger border-danger-subtle fs-9" title="Balance due">Due ₹' + Number(r.balanceDue).toFixed(2) + '</span>';

                let printedHtml;
                if (r.printedAfterApproval) {
                    printedHtml = '<span class="badge badge-ds bg-success-subtle text-success border-success-subtle fs-9" title="Final report printed on ' + esc(fmt(r.lastPrintedDate)) + '"><i class="bi bi-check2-all me-1"></i>Printed' + (r.printCount > 1 ? ' ×' + r.printCount : '') + '</span>'
                        + '<div class="dup-note">Next print = duplicate</div>';
                } else if (r.printCount > 0) {
                    printedHtml = '<span class="badge badge-ds bg-warning-subtle text-warning-emphasis border-warning-subtle fs-9" title="Provisional copy printed ' + esc(fmt(r.lastPrintedDate)) + '"><i class="bi bi-printer me-1"></i>Provisional ×' + r.printCount + '</span>'
                        + '<div class="dup-note">Next print = duplicate</div>';
                } else {
                    printedHtml = '<span class="text-muted fs-9">—</span>';
                }

                const hasDue = !paid;
                let printBtn;
                if (!r.canPrint) {
                    printBtn = '<button type="button" class="btn btn-outline-secondary btn-sm fs-9 px-2 py-1" disabled title="Validate at least one test to print"><i class="bi bi-printer me-1"></i>Print</button>';
                } else if (hasDue) {
                    // Kept clickable on purpose: the click explains why the report is held back.
                    printBtn = '<button type="button" class="btn btn-outline-danger btn-sm fs-9 px-2 py-1 btn-print-due" data-bill="' + esc(r.billNo) + '" data-due="' + Number(r.balanceDue).toFixed(2) + '" title="Payment pending - the report cannot be printed"><i class="bi bi-lock-fill me-1"></i>Print</button>';
                } else if (r.dispatchStatus === 'PARTIAL') {
                    // Part approved, part still awaiting approval: the approved tests can go out as a clean report,
                    // and the rest as the usual NOT APPROVED copy. Dues are already cleared at this point.
                    printBtn = '<button type="button" class="btn btn-sm fs-9 px-2 py-1 btn-print btn-print-ready" data-id="' + r.labOrderId + '" data-bill="' + esc(r.billNo) + '" data-scope="approved" title="Print the approved test(s) of this bill - ' + r.approvedTests + ' of ' + total + '"><i class="bi bi-printer-fill me-1"></i>Print Approved</button>'
                        + ' <button type="button" class="btn btn-sm fs-9 px-2 py-1 btn-print btn-print-prov" data-id="' + r.labOrderId + '" data-bill="' + esc(r.billNo) + '" data-scope="pending" title="Print a NOT APPROVED copy of the tests still awaiting approval"><i class="bi bi-printer-fill me-1"></i>Not Approved</button>';
                } else {
                    printBtn = '<button type="button" class="btn btn-sm fs-9 px-2 py-1 btn-print ' + (isReady ? 'btn-print-ready' : 'btn-print-prov') + '" data-id="' + r.labOrderId + '" data-bill="' + esc(r.billNo) + '" data-scope="all" title="' + (isReady ? 'Print the final report' : 'Print a NOT APPROVED copy (validated tests only)') + '"><i class="bi bi-printer-fill me-1"></i>' + (isReady ? 'Print' : 'Print (Not Approved)') + '</button>';
                }

                const client = isB2B
                    ? '<div class="fs-9 text-muted text-truncate mt-1" style="max-width:150px" title="' + esc((r.clientType === 'FRANCHISE' ? 'Franchise: ' : 'Company: ') + (r.clientName || '')) + '"><i class="bi ' + (r.clientType === 'FRANCHISE' ? 'bi-shop' : 'bi-building') + ' me-1"></i>' + esc([r.clientCode, r.clientName].filter(Boolean).join(' · ') || '—') + '</div>'
                    : '';

                const sample = (r.recollectTests > 0 ? '<span class="badge badge-ds bg-warning-subtle text-warning-emphasis border-warning-subtle fs-9 ms-1" title="Tests marked for re-collect / rejected">' + r.recollectTests + ' re-collect</span>' : '')
                    + (r.collectedTests + r.recollectTests < total ? '<span class="badge badge-ds bg-secondary-subtle text-secondary border-secondary-subtle fs-9 ms-1" title="Tests not collected yet">' + (total - r.collectedTests - r.recollectTests) + ' uncollected</span>' : '');

                return '<tr class="row-' + esc((r.dispatchStatus || '').toLowerCase()) + '">'
                    + '<td class="ps-3 text-muted fw-bold">' + idx + '</td>'
                    + '<td><div class="fw-bold text-dark font-monospace text-nowrap">' + esc(r.billNo || '—') + (r.isUrgent ? ' <span class="urgent-dot ms-1" title="Urgent"></span>' : '') + '</div>'
                    +     '<div class="fs-9 text-muted font-monospace">' + esc(r.tokenNo || '') + '</div></td>'
                    + '<td><div class="fw-semibold text-dark text-truncate" style="max-width:170px" title="' + esc(r.patientName) + '">' + esc(r.patientName) + '</div>'
                    +     '<div class="fs-9 text-muted text-nowrap"><span class="badge bg-secondary-subtle text-secondary border font-monospace fs-9">' + esc(r.patientCode || '—') + '</span> '
                    +     esc((r.age != null ? r.age + 'Y / ' : '') + (r.gender || '')) + '</div>'
                    +     (r.phoneNumber ? '<div class="fs-9 text-muted text-nowrap"><i class="bi bi-telephone me-1"></i>' + esc(r.phoneNumber) + '</div>' : '') + '</td>'
                    + '<td><div class="d-flex align-items-center gap-1"><span class="badge badge-ds fs-9 ' + (isB2B ? 'type-b2b' : 'type-b2c') + '">' + esc(r.billingType) + '</span>' + payHtml + '</div>' + client + '</td>'
                    + '<td class="text-nowrap fs-9">' + esc(fmt(r.billingDate)) + '</td>'
                    + '<td><div class="d-flex align-items-center gap-2"><div class="tests-bar flex-grow-1" title="' + r.approvedTests + ' approved, ' + r.validatedTests + ' validated of ' + total + '">'
                    +     '<span class="seg-approved" style="width:' + pApp + '%"></span><span class="seg-validated" style="width:' + pVal + '%"></span><span class="seg-entered" style="width:' + pEnt + '%"></span></div>'
                    +     '<span class="fs-9 fw-semibold text-nowrap">' + r.approvedTests + ' / ' + total + '</span>'
                    +     '<button type="button" class="btn-view-tests" data-id="' + r.labOrderId + '" data-bill="' + esc(r.billNo) + '" data-patient="' + esc(r.patientName) + '" title="View all test details for this bill" aria-label="View test details"><i class="bi bi-eye-fill"></i></button></div>'
                    +     '<div class="fs-9 text-muted mt-1">' + (r.validatedTests ? r.validatedTests + ' validated' : '') + sample + (r.criticalTests ? ' <span class="badge badge-ds bg-danger-subtle text-danger border-danger-subtle fs-9" title="Critical result(s)"><i class="bi bi-exclamation-triangle-fill me-1"></i>' + r.criticalTests + '</span>' : '') + '</div></td>'
                    + '<td class="text-nowrap fs-9">' + (r.approvedDate ? esc(fmt(r.approvedDate)) : '<span class="text-muted">—</span>') + '</td>'
                    + '<td class="text-center"><span class="badge badge-ds fs-9 ' + b.cls + '"><i class="bi ' + b.icon + ' me-1"></i>' + b.text + '</span></td>'
                    + '<td class="text-center">' + printedHtml + '</td>'
                    + '<td class="text-end pe-3 text-nowrap">' + printBtn
                    +     ' <button type="button" class="btn btn-outline-secondary btn-sm fs-9 px-2 py-1 btn-print-bill" data-id="' + r.labOrderId + '" title="Print the bill for ' + esc(r.billNo || 'this order') + '"><i class="bi bi-receipt me-1"></i>Bill</button></td>'
                    + '</tr>';
            }

            function renderTable() {
                const size = parseInt($('#selPageSize').val(), 10) || 25;
                const totalRows = rows.length;
                const pages = Math.max(1, Math.ceil(totalRows / size));
                if (page > pages) page = pages;

                $('#lblRowCount').text(totalRows);
                $('#tblDispatchBody').empty();

                if (totalRows === 0) {
                    $('#lblPageInfo').text('');
                    $('#pager').empty();
                    return showState('stateEmpty');
                }
                showState(null);

                const start = (page - 1) * size;
                const slice = rows.slice(start, start + size);
                $('#tblDispatchBody').html(slice.map((r, i) => rowHtml(r, start + i + 1)).join(''));
                $('#lblPageInfo').text('Showing ' + (start + 1) + '–' + (start + slice.length) + ' of ' + totalRows);

                // compact pager: first, prev, window, next, last
                const items = [];
                const add = (label, p, disabled, active) => items.push('<li class="page-item' + (disabled ? ' disabled' : '') + (active ? ' active' : '') + '"><a class="page-link" href="#" data-page="' + p + '">' + label + '</a></li>');
                add('&laquo;', 1, page === 1);
                add('&lsaquo;', page - 1, page === 1);
                const lo = Math.max(1, page - 2), hi = Math.min(pages, page + 2);
                for (let p = lo; p <= hi; p++) add(p, p, false, p === page);
                add('&rsaquo;', page + 1, page === pages);
                add('&raquo;', pages, page === pages);
                $('#pager').html(items.join(''));
            }

            $('#pager').on('click', '.page-link', function (e) {
                e.preventDefault();
                if ($(this).parent().hasClass('disabled')) return;
                page = parseInt($(this).data('page'), 10);
                renderTable();
            });
            $('#selPageSize').on('change', function () { page = 1; renderTable(); });

            // ── Filters ─────────────────────────────────────────────────────
            function syncStatusChip() {
                if (statusFilter === 'ALL') $('#chipStatusFilter').addClass('d-none');
                else $('#chipStatusFilter').removeClass('d-none').html('<i class="bi bi-funnel-fill me-1"></i>' + esc(STATUS_LABEL[statusFilter]));
                $('.dsp-card.is-clickable').each(function () { $(this).toggleClass('active-card', $(this).data('status') === statusFilter); });
            }

            $('.dsp-card.is-clickable').on('click', function () {
                const s = $(this).data('status');
                statusFilter = (statusFilter === s && s !== 'ALL') ? 'ALL' : s; // clicking the active card clears it
                syncStatusChip();
                load();
            });

            $('.btn-quick-date').on('click', function () {
                const t = new Date(); let from = new Date(t), to = new Date(t);
                switch ($(this).data('range')) {
                    case 'yesterday': from.setDate(t.getDate() - 1); to = new Date(from); break;
                    case 'week': from.setDate(t.getDate() - 6); break;
                    case 'month': from = new Date(t.getFullYear(), t.getMonth(), 1); break;
                }
                $('#txtFromDate').val(iso(from)); $('#txtToDate').val(iso(to));
                $('.btn-quick-date').removeClass('active'); $(this).addClass('active');
                load();
            });

            $('#txtFromDate, #txtToDate').on('change', function () {
                $('.btn-quick-date').removeClass('active');
                const f = $('#txtFromDate').val(), t = $('#txtToDate').val();
                if (f && t && t < f) { $('#txtToDate').val(f); }
                load();
            });
            $('#selDateBasis').on('change', load);

            $('.btn-client-type').on('click', function () {
                clientType = $(this).data('type');
                $('.btn-client-type').removeClass('active'); $(this).addClass('active');
                load();
            });

            $('#txtSearch').on('input', function () {
                $('#btnClearSearch').toggle($(this).val().length > 0);
                clearTimeout(searchTimer);
                searchTimer = setTimeout(load, 350);
            }).on('keydown', function (e) { if (e.key === 'Enter') { clearTimeout(searchTimer); load(); } });
            $('#btnClearSearch').on('click', function () { $('#txtSearch').val('').trigger('input').focus(); });

            $('#btnApply, #btnRefresh, #btnRetry').on('click', load);

            $('#btnResetFilters').on('click', function () {
                const today = iso(new Date());
                $('#txtFromDate, #txtToDate').val(today);
                $('#selDateBasis').val('BillingDate');
                $('#txtSearch').val(''); $('#btnClearSearch').hide();
                statusFilter = 'ALL'; clientType = 'ALL';
                $('.btn-client-type').removeClass('active').filter('[data-type="ALL"]').addClass('active');
                $('.btn-quick-date').removeClass('active').filter('[data-range="today"]').addClass('active');
                syncStatusChip();
                load();
            });

            // ── Print modal (same PDF as the Entry page) ─────────────────────
            let printOrderId = 0, blobUrl = null, fileName = 'LabReport.pdf', printLogged = false, printScope = 'all';
            const reportUrl = (id, mode) => pdfUrl + '?labOrderId=' + id + '&mode=' + mode + '&scope=' + printScope + '&_=' + Date.now();
            const $frame = $('#dispatchPrintFrame'), $loading = $('#printLoading'), $error = $('#printError');
            const $actions = $('#btnReportPrintNow, #btnReportDownload, #btnReportNewTab');

            function resetModal() {
                if (blobUrl) { URL.revokeObjectURL(blobUrl); blobUrl = null; }
                $frame.addClass('d-none').attr('src', 'about:blank');
                $error.addClass('d-none').text('');
                $('#printStatusChip, #printDuplicateChip').addClass('d-none');
                $('#printSubtitle').text('Preparing report…');
                $actions.prop('disabled', true);
                $loading.removeClass('d-none');
            }
            function failModal(msg) {
                $loading.addClass('d-none');
                $error.text(msg).removeClass('d-none');
                $('#printSubtitle').text('Report unavailable');
            }
            async function loadPdf() {
                resetModal();
                const id = printOrderId;
                try {
                    const res = await fetch(reportUrl(id, 'preview'), { credentials: 'same-origin', cache: 'no-store' });
                    if (id !== printOrderId) return;
                    const type = res.headers.get('content-type') || '';
                    if (!res.ok) {
                        let msg = 'Unable to generate the report.', body = null;
                        try { body = await res.json(); msg = body.message || msg; } catch (e) { /* keep default */ }
                        if (res.status === 402) {                 // payment pending - the server holds the report back
                            bootstrap.Modal.getOrCreateInstance(modalEl).hide();
                            dueAlert(body && body.billNo, body && body.balanceDue);
                            load();
                            return;
                        }
                        return failModal(msg);
                    }
                    if (type.indexOf('pdf') === -1) return failModal('Your session may have expired. Please refresh the page and sign in again.');

                    const watermark = res.headers.get('X-Report-Watermark') === '1';
                    const status = res.headers.get('X-Report-Status');
                    const tests = res.headers.get('X-Report-Tests');
                    const m = /filename="?([^";]+)"?/i.exec(res.headers.get('Content-Disposition') || '');
                    if (m) fileName = m[1];

                    blobUrl = URL.createObjectURL(await res.blob());
                    $frame.attr('src', blobUrl + '#toolbar=1&navpanes=0').removeClass('d-none');
                    $loading.addClass('d-none');
                    $actions.prop('disabled', false);
                    $('#printStatusChip')
                        .attr('class', 'badge fs-9 ' + (watermark ? 'bg-warning-subtle text-warning-emphasis border border-warning-subtle'
                            : (status === 'final' ? 'bg-success-subtle text-success border border-success-subtle' : 'bg-primary-subtle text-primary border border-primary-subtle')))
                        .text(watermark ? 'NOT APPROVED copy' : (status === 'final' ? (printScope === 'approved' ? 'Approved tests (final)' : 'Final Report') : 'Provisional Report'));
                    const isDup = res.headers.get('X-Report-Duplicate') === '1';
                    const seq = res.headers.get('X-Report-Print-Sequence');
                    $('#printDuplicateChip').toggleClass('d-none', !isDup).text(isDup ? 'DUPLICATE · Print #' + seq : '');
                    $('#printSubtitle').text(tests + ' ' + (printScope === 'approved' ? 'approved' : printScope === 'pending' ? 'validated (not approved)' : 'validated/approved') + ' test(s) on this report'
                        + (watermark ? ' • watermarked until every printed test is approved' : '')
                        + (isDup ? ' • this bill was printed before, so the copy is marked DUPLICATE' : ''));
                } catch (e) {
                    failModal('Server error while generating the report. Please try again.');
                }
            }
            /// Fetches the report again in print / download mode; the server records the print before streaming it.
            async function fetchForPrint(mode) {
                const res = await fetch(reportUrl(printOrderId, mode), { credentials: 'same-origin', cache: 'no-store' });
                if (res.status === 402) {
                    let body = null; try { body = await res.json(); } catch (e) { /* ignore */ }
                    bootstrap.Modal.getOrCreateInstance(modalEl).hide();
                    dueAlert(body && body.billNo, body && body.balanceDue);
                    load();
                    throw new Error('due');
                }
                if (!res.ok || (res.headers.get('content-type') || '').indexOf('pdf') === -1) throw new Error('print');
                printLogged = true;
                const m = /filename="?([^";]+)"?/i.exec(res.headers.get('Content-Disposition') || '');
                if (m) fileName = m[1];
                return URL.createObjectURL(await res.blob());
            }

            // ── Test details of one bill ─────────────────────────────────────
            const testsUrl = '@Url.Action("GetBillTestsJson", "LabReportDispatch")';
            const testsModalEl = document.getElementById('modalBillTests');
            const SAMPLE_BADGE = { 2: ['bg-success-subtle text-success border-success-subtle', 'Collected'], 3: ['bg-warning-subtle text-warning-emphasis border-warning-subtle', 'Re-Collect'], 4: ['bg-danger-subtle text-danger border-danger-subtle', 'Rejected'], 1: ['bg-secondary-subtle text-secondary border-secondary-subtle', 'Pending'] };
            const REPORT_BADGE = { 5: ['bs-ready', 'Approved'], 3: ['bs-partial', 'Validated'], 2: ['bs-inprogress', 'Entered'], 1: ['bs-awaiting', 'Draft'], 0: ['bs-notstarted', 'Pending Entry'] };

            function stamp(dt) {
                if (!dt) return '<span class="stamp s-none">&mdash;</span>';
                const parts = fmt(dt).split(', ');   // "20 Sep 2026, 01:45 PM"
                return '<span class="stamp" title="' + esc(fmt(dt)) + '">' + esc(parts[0]) + '<span class="s-t">' + esc(parts[1] || '') + '</span></span>';
            }

            $('#tblDispatchBody').on('click', '.btn-view-tests', function () {
                const $b = $(this);
                $('#testsBillChip').text($b.data('bill') || '—');
                $('#testsSubtitle').text($b.data('patient') || '');
                bootstrap.Modal.getOrCreateInstance(testsModalEl).show();
                loadTests($b.data('id'));
            });

            function loadTests(labOrderId) {
                $('#tblBillTestsBody').empty();
                $('#testsSummary').empty();
                $('#testsFooterNote').text('');
                $('#testsEmpty, #testsError').addClass('d-none');
                $('#testsLoading').removeClass('d-none');

                $.get(testsUrl, { labOrderId: labOrderId })
                    .done(function (res) {
                        $('#testsLoading').addClass('d-none');
                        if (!res || !res.success) {
                            return $('#testsError').text((res && res.message) || 'Unable to load the test details.').removeClass('d-none');
                        }
                        renderTests(res.tests || []);
                    })
                    .fail(function () {
                        $('#testsLoading').addClass('d-none');
                        $('#testsError').text('Server error while loading the test details.').removeClass('d-none');
                    });
            }

            function renderTests(tests) {
                if (tests.length === 0) return $('#testsEmpty').removeClass('d-none');

                const approved = tests.filter(t => t.reportStatusId === 5).length;
                const validated = tests.filter(t => t.reportStatusId === 3).length;
                const pending = tests.length - approved - validated;
                const tats = tests.map(t => t.tatMinutes).filter(v => v != null && v >= 0);
                const avgTat = tats.length ? tats.reduce((a, b) => a + b, 0) / tats.length : null;
                const firstCollected = tests.map(t => t.collectedOn).filter(Boolean).sort()[0];
                const lastApproved = tests.map(t => t.approvedDate).filter(Boolean).sort().slice(-1)[0];

                const pill = (label, value) => '<span class="sum-pill"><b>' + value + '</b>' + label + '</span>';
                $('#testsSummary').html(
                    pill('Total tests', tests.length)
                    + pill('Approved', approved)
                    + pill('Validated', validated)
                    + pill('Pending', pending)
                    + pill('First collected', firstCollected ? esc(fmt(firstCollected)) : '—')
                    + pill('Last approved', lastApproved ? esc(fmt(lastApproved)) : '—')
                    + pill('Avg. TAT', avgTat != null ? esc(fmtDur(avgTat)) : '—')
                );

                let html = '', lastGroup = null, i = 0;
                tests.forEach(function (t) {
                    const groupKey = [t.departmentName, t.categoryName, t.groupName].filter(Boolean).join(' \u203a ');
                    if (groupKey && groupKey !== lastGroup) {
                        html += '<tr class="grp-row"><td colspan="11">' + esc(groupKey) + '</td></tr>';
                        lastGroup = groupKey;
                    }
                    i++;

                    const sb = SAMPLE_BADGE[t.collectionstatusID] || SAMPLE_BADGE[1];
                    const rb = REPORT_BADGE[t.reportStatusId] || REPORT_BADGE[0];

                    html += '<tr>'
                        + '<td class="text-muted">' + i + '</td>'
                        + '<td><div class="fw-semibold text-dark t-name">' + esc(t.testName) + '</div>'
                        +     '<div class="text-muted font-monospace t-code">' + esc(t.testCode || '') + '</div>'
                    +     (t.barcodeNo ? '<div class="text-muted font-monospace t-code">' + esc(t.barcodeNo) + '</div>' : '') + '</td>'
                        + '<td><div class="t-sample">' + esc(t.sampleTypeName || '—') + '</div>'
                        +     '<span class="badge badge-ds fs-9 ' + sb[0] + '">' + sb[1] + '</span>'
                        +     (t.rejectionReason ? '<div class="t-reason" title="' + esc(t.rejectionReason) + '">' + esc(t.rejectionReason) + '</div>' : '')
                        +     (t.isTransferred ? '<div class="fs-9 text-primary"><i class="bi bi-arrow-left-right me-1"></i>' + esc(t.targetBranchName || 'Transferred') + '</div>' : '') + '</td>'
                        + '<td>' + stamp(t.collectedOn) + '</td>'
                        + '<td>' + stamp(t.receivedDate) + '</td>'
                        + '<td>' + stamp(t.submittedDate || t.draftedDate) + '</td>'
                        + '<td>' + stamp(t.validatedDate) + '</td>'
                        + '<td>' + stamp(t.approvedDate) + '</td>'
                        + '<td class="fs-9">' + (t.approvedByName ? esc(t.approvedByName) : '<span class="s-none">&mdash;</span>') + '</td>'
                        + '<td class="text-center"><span class="badge badge-ds fs-9 ' + rb[0] + '">' + rb[1] + '</span></td>'
                        + '<td class="text-end fs-9">' + (t.tatMinutes != null ? esc(fmtDur(t.tatMinutes)) : '<span class="s-none">&mdash;</span>') + '</td>'
                        + '</tr>';
                });
                $('#tblBillTestsBody').html(html);
                $('#testsFooterNote').text(tests.length + ' test(s) \u00b7 TAT is measured from sample collection to report approval');
            }

            function dueAlert(billNo, due) {
                const amount = due != null ? '₹' + Number(due).toFixed(2) : '';
                Swal.fire({
                    icon: 'error',
                    title: 'Unable to Print Report',
                    html: '<div class="fs-8">Clear the due first.</div>'
                        + (billNo ? '<div class="fs-9 text-muted mt-2">Bill No: <span class="font-monospace">' + esc(billNo) + '</span></div>' : '')
                        + (amount ? '<div class="fw-bold text-danger mt-1">Outstanding: ' + amount + '</div>' : ''),
                    confirmButtonColor: '#dc3545',
                    confirmButtonText: 'OK'
                });
            }

            $('#tblDispatchBody').on('click', '.btn-print-due', function () {
                dueAlert($(this).data('bill'), $(this).data('due'));
            });

            const modalEl = document.getElementById('modalDispatchPrint');
            $('#tblDispatchBody').on('click', '.btn-print', function () {
                printOrderId = parseInt($(this).data('id'), 10);
                printScope = $(this).attr('data-scope') || 'all';
                printLogged = false;
                $('#printBillChip').text($(this).data('bill') || '—');
                bootstrap.Modal.getOrCreateInstance(modalEl).show();
            });
            $('#tblDispatchBody').on('click', '.btn-print-bill', function () {
                const id = $(this).data('id');
                window.open(billUrl + '?labOrderId=' + id, '_blank'); // logged server-side, then the existing bill print page
            });

            $(modalEl).on('shown.bs.modal', loadPdf);
            $(modalEl).on('hidden.bs.modal', function () {
                resetModal();
                if (printLogged) { printLogged = false; setTimeout(load, 600); } // refresh the Printed column / cards
            });
            $('#btnReportPrintNow').on('click', async function () {
                if (!blobUrl) return;
                const $btn = $(this).prop('disabled', true);
                try {
                    const printable = await fetchForPrint('print');   // recorded server-side
                    $frame.one('load', function () {
                        try { const w = $frame[0].contentWindow; w.focus(); w.print(); }
                        catch (e) { window.open(printable, '_blank'); }
                    }).attr('src', printable + '#toolbar=1&navpanes=0');
                    if (blobUrl) URL.revokeObjectURL(blobUrl);
                    blobUrl = printable;
                } catch (e) {
                    if (e.message !== 'due') toastr.error('Unable to print the report. Please try again.');
                } finally {
                    $btn.prop('disabled', false);
                }
            });
            $('#btnReportDownload').on('click', async function () {
                const $btn = $(this).prop('disabled', true);
                try {
                    const file = await fetchForPrint('download');     // recorded server-side
                    const a = document.createElement('a'); a.href = file; a.download = fileName;
                    document.body.appendChild(a); a.click(); a.remove();
                    setTimeout(() => URL.revokeObjectURL(file), 30000);
                } catch (e) {
                    if (e.message !== 'due') toastr.error('Unable to download the report. Please try again.');
                } finally {
                    $btn.prop('disabled', false);
                }
            });
            $('#btnReportNewTab').on('click', function () { if (blobUrl) window.open(blobUrl, '_blank'); });

            // Refresh when returning from a Report Entry tab (statuses may have changed)
            document.addEventListener('visibilitychange', function () { if (!document.hidden && rows.length) load(); });

            syncStatusChip();
            load();
        });
    </script>
}
