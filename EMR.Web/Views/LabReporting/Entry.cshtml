                            <option value="@r.Reason_ID" data-name="@r.Reason_Text">@r.Reason_Text@(string.IsNullOrWhiteSpace(r.Applicable_Sample_Type_Name) ? "" : $" ({r.Applicable_Sample_Type_Name})")</option>
