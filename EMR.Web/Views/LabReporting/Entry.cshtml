@model EMR.Web.Models.ViewModels.LabReportingEntryPageViewModel
@inject EMR.Shared.Security.IActionPermissionGuard PermissionGuard
@inject EMR.Web.Services.IAiBillingFeatures AiBillingFeatures
@{
    // The reporting screen using this page: Lab Report Entry (defaults) or Microbiology Report Entry.
    var screen = Model.Screen ?? EMR.Web.Models.ViewModels.LabReportingScreen.Numeric;
    ViewData["Title"] = (screen.MixedTypes ? "Microbiology " : "") + $"Report Entry - {Model.Detail.PatientName} ({Model.Detail.TokenNo})";
    ViewData["MixedReporting"] = screen.MixedTypes;
    // delta check trend popup (last 5 results): Lab Report Entry only
    ViewData["DeltaTrend"] = screen.Controller == "LabReporting" && !screen.MixedTypes;
    ViewData["PicklistOptions"] = Model.PicklistOptions;
    ViewData["DescriptiveDefaults"] = Model.DescriptiveDefaults;
    ViewData["ReportPrintController"] = screen.Controller;
    var d = Model.Detail;
    var latestDrafted = d.Items?.FirstOrDefault(x => x.DraftedDate.HasValue)?.DraftedDate;
    var latestSubmitted = d.Items?.FirstOrDefault(x => x.SubmittedDate.HasValue)?.SubmittedDate;
    var latestValidated = d.Items?.FirstOrDefault(x => x.ValidatedDate.HasValue)?.ValidatedDate;
    var latestApproved = d.Items?.FirstOrDefault(x => x.ApprovedDate.HasValue)?.ApprovedDate;

    var activeItems = d.Items?.Where(x => x.CollectionstatusID != 3 && x.CollectionstatusID != 4).ToList() ?? new();
    int totalCount = activeItems.Count;
    int unenteredCount = activeItems.Count(x => string.IsNullOrWhiteSpace(x.TestValue));
    int enteredCount = activeItems.Count(x => !string.IsNullOrWhiteSpace(x.TestValue));
    int unsubmittedCount = activeItems.Count(x => !string.IsNullOrWhiteSpace(x.TestValue) && x.ReportStatusId < 2);
    int submittedCount = activeItems.Count(x => !string.IsNullOrWhiteSpace(x.TestValue) && x.ReportStatusId == 2);
    int validatedCount = activeItems.Count(x => !string.IsNullOrWhiteSpace(x.TestValue) && x.ReportStatusId == 3);
    int approvedCount = activeItems.Count(x => !string.IsNullOrWhiteSpace(x.TestValue) && x.ReportStatusId == 5);

    bool isAllApproved = (totalCount > 0 && approvedCount == totalCount);
    bool isPartialApproved = (approvedCount > 0 && approvedCount < totalCount);
    bool isApproved = isAllApproved;
    ViewData["IsOrderApproved"] = isAllApproved;

    // Submit button: visible if any active test is unentered or unsubmitted, and not fully approved
    bool showSubmit = (unenteredCount > 0 || unsubmittedCount > 0) && !isAllApproved;
    // Validate button: visible if there are any submitted tests awaiting validation (allows partial validation)
    // Validating is its own control (Settings > Security): without it the Validate buttons are not offered.
    bool canValidate = await PermissionGuard.ShowsAsync(Context, screen.PageCode, EMR.Shared.Security.PermissionControls.Validate);
    bool showValidate = (submittedCount > 0) && !isAllApproved && canValidate;
    // Approve button: visible if there are any validated tests awaiting approval (allows partial approval).
    // With "Pathologist approval required" on for the branch, approval belongs to the Pathologist Dashboard,
    // so this screen never offers it.
    bool pathologistApprovalRequired = Model.PathologistApprovalRequired;
    // Approving is its own control (Settings > Security): without it the Approve buttons are not offered.
    bool canApprove = await PermissionGuard.ShowsAsync(Context, screen.PageCode, EMR.Shared.Security.PermissionControls.Approve);
    bool showApprove = (validatedCount > 0) && !isAllApproved && !pathologistApprovalRequired && canApprove;
    bool showApprovedBadge = isAllApproved || isPartialApproved;

    // Print Report: available once any test is Validated/Approved. Amber "Not Approved" copy while a printed test is not yet approved.
    bool showPrint = (validatedCount + approvedCount) > 0;
    bool printProvisional = validatedCount > 0;
    // Part approved / part validated: two separate prints - the approved tests (final look) and the not-yet-approved ones (watermarked).
    bool printSplit = approvedCount > 0 && validatedCount > 0;
    if (printSplit) { printProvisional = false; }

    // Colour hook for the patient avatar (male = blue, female = rose, other = violet)
    var genderKey = (d.Gender ?? string.Empty).Trim().ToLowerInvariant() switch
    {
        "male" or "m" => "male",
        "female" or "f" => "female",
        _ => "other"
    };
}

@section HeadStyles {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" />
    @if (screen.MixedTypes)
    {
        <link rel="stylesheet" href="~/lib/quill/quill.snow.css" />
    }
    <link rel="stylesheet" href="~/css/views/LabReporting/Entry.css" asp-append-version="true" />
}

<div class="reporting-entry-wrapper px-3 py-3">
    <!-- Breadcrumb & Top Bar -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0 fs-8">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none">Home</a></li>
                <li class="breadcrumb-item"><a asp-controller="@screen.Controller" asp-action="Index" class="text-decoration-none">@screen.ListTitle</a></li>
                <li class="breadcrumb-item active text-dark fw-semibold" aria-current="page">Report Entry: @d.BillNo</li>
            </ol>
        </nav>
        <div class="d-flex gap-2">
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm px-3">
                <i class="bi bi-arrow-left me-1"></i>Back to List
            </a>
            <button type="button" class="btn btn-outline-danger btn-sm px-3" onclick="window.close()">
                <i class="bi bi-x-circle me-1"></i>Close Tab
            </button>
        </div>
    </div>

    @if (ViewData["RelatedReportLink"] is ValueTuple<string, string, string> related)
    {
        <div class="alert alert-info border-info-subtle shadow-sm d-flex flex-wrap align-items-center justify-content-between p-2.5 mb-3 rounded-3 gap-2 fs-8" role="note">
            <span><i class="bi bi-info-circle-fill me-1"></i>@related.Item3 - they are reported on <strong>@related.Item2</strong>.</span>
            <a asp-controller="@related.Item1" asp-action="Entry" asp-encrypted-route-labOrderId="@d.LabOrderId" target="_blank" rel="noopener" class="btn btn-sm btn-outline-primary fs-8">
                Open @related.Item2 <i class="bi bi-box-arrow-up-right ms-1"></i>
            </a>
        </div>
    }

    @if (d.IsTransferred)
    {
        <div class="alert alert-warning border-warning-subtle shadow-sm d-flex flex-wrap align-items-center justify-content-between p-2.5 mb-3 rounded-3 gap-2" role="alert">
            <div class="d-flex align-items-center gap-2">
                <span class="badge bg-warning text-dark fs-8 px-2.5 py-1.5 fw-bold">
                    <i class="bi bi-arrow-left-right me-1"></i>Sample Transferred
                </span>
                <span class="fs-8 text-dark">
                    This specimen was transferred from <strong>@(d.SourceBranchName ?? "External Branch")</strong>.
                    @if (d.TransferredDate.HasValue)
                    {
                        <span class="text-muted ms-1"><i class="bi bi-clock me-1"></i>Transferred on @d.TransferredDate.Value.ToString("dd MMM yyyy, hh:mm tt")</span>
                    }
                    @if (!string.IsNullOrWhiteSpace(d.TransferRemarks))
                    {
                        <span class="text-dark ms-2 border-start ps-2"><em>Remarks:</em> @d.TransferRemarks</span>
                    }
                </span>
            </div>
            <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle fs-9">
                <i class="bi bi-shield-check me-1"></i>Authorized Cross-Branch Processing
            </span>
        </div>
    }

    <!-- Patient Header Banner (2 Compact Aligned Rows) -->
    <div class="patient-banner shadow-sm mb-3">
        <div class="row g-2 align-items-center">
            <!-- Patient Identity -->
            <div class="col-xl-3 col-lg-4 col-12 banner-identity d-flex align-items-center gap-2.5">
                <div class="patient-avatar-box gender-@genderKey flex-shrink-0">
                    <i class="bi bi-person-fill"></i>
                </div>
                <div class="text-truncate">
                    <div class="d-flex align-items-center gap-1.5 flex-wrap">
                        <h6 class="mb-0 fw-bold text-dark text-truncate" style="max-width: 170px;" title="@d.PatientName">@d.PatientName</h6>
                        <button type="button" class="btn-audit-info" id="btnAuditHistory"
                                data-laborderid="@d.LabOrderId" data-patient="@d.PatientName" data-bill="@(d.BillNo ?? "—")"
                                data-bs-toggle="tooltip" data-bs-placement="bottom"
                                title="View audit history for this bill"
                                aria-label="View audit history for this bill">
                            <i class="bi bi-info-circle-fill"></i>
                        </button>
                        <span class="badge bg-secondary-subtle text-secondary border font-monospace fs-9 py-0.5 px-1.5">@d.PatientCode</span>
                        @if (d.IsUrgent)
                        {
                            <span class="badge bg-danger text-white fs-9 py-0.5 px-1.5"><i class="bi bi-lightning-fill me-0.5"></i>Urgent</span>
                        }
                    </div>
                    <div class="text-muted fs-9 mt-0.5 d-flex align-items-center gap-2 flex-wrap">
                        <span><i class="bi bi-gender-ambiguous me-0.5"></i>@(d.Age.HasValue ? $"{d.Age}Y / " : "")@(d.Gender ?? "—")</span>
                        @if (d.LmpDate.HasValue) { <span class="fw-semibold" style="color:#be185d" title="Last menstrual period"><i class="bi bi-calendar-heart me-0.5"></i>LMP @d.LmpDate.Value.ToString("dd-MMM-yyyy")</span> }   @* 2453 *@
                        <span><i class="bi bi-telephone me-0.5"></i>@(d.PhoneNumber ?? "—")</span>
                    </div>
                </div>
            </div>

            <!-- Order / Token identifiers & status pills (2 Rows) -->
            <div class="col-xl-9 col-lg-8 col-12 banner-tiles-col">
                <div class="banner-tiles">
                    <!-- Row 1: Key Metadata Pills (one even grid with row 2: same width / height, columns aligned) -->
                    <div class="banner-tiles-row">
                        <div class="info-pill pill-token">
                            <span class="pill-label">Token No</span>
                            <span class="pill-val font-monospace">@(d.TokenNo ?? "LAB")</span>
                        </div>
                        <div class="info-pill pill-bill">
                            <span class="pill-label">Bill / Order No</span>
                            <span class="pill-val font-monospace">@(d.BillNo ?? "—")</span>
                        </div>
                        @if (Model.B2BClient != null)
                        {
                            var b2bIsFranchise = string.Equals(Model.B2BClient.ClientType, "FRANCHISE", StringComparison.OrdinalIgnoreCase);
                            var b2bName = string.Join(" · ", new[] { Model.B2BClient.Code, Model.B2BClient.Name }.Where(x => !string.IsNullOrWhiteSpace(x)));
                            var b2bTip = string.Join(" | ", new[] { Model.B2BClient.Name, Model.B2BClient.Phone, Model.B2BClient.Address }.Where(x => !string.IsNullOrWhiteSpace(x)));
                            <div class="info-pill pill-client" id="pillB2BClient">
                                <span class="pill-label"><i class="bi @(b2bIsFranchise ? "bi-shop" : "bi-building") me-0.5"></i>B2B @(b2bIsFranchise ? "Franchise" : "Company")</span>
                                <span class="pill-val text-truncate" title="@b2bTip">@(string.IsNullOrWhiteSpace(b2bName) ? "—" : b2bName)</span>
                            </div>
                        }
                        <div class="info-pill pill-booking">
                            <span class="pill-label">Booking Time</span>
                            <span class="pill-val">@((d.BookingDateTime ?? d.OrderDate).ToString("dd MMM yyyy, hh:mm tt"))</span>
                        </div>
                        <div class="info-pill pill-collect">
                            <span class="pill-label">Collection Type</span>
                            <span class="pill-val">@d.CollectionType</span>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(d.PhlebotomistName))
                        {
                            <div class="info-pill pill-phleb">
                                <span class="pill-label">Phlebotomist</span>
                                <span class="pill-val text-truncate" style="max-width: 110px;" title="@d.PhlebotomistName">@d.PhlebotomistName</span>
                            </div>
                        }
                        <div class="info-pill pill-collect">
                            <span class="pill-label">Referred By</span>
                            <span class="pill-val text-truncate" style="max-width: 150px;" title="@(d.ReferralDoctorName ?? "Self")">@(string.IsNullOrWhiteSpace(d.ReferralDoctorName) ? "Self" : d.ReferralDoctorName)</span>
                        </div>
                        <div class="info-pill" id="pillPayment">
                            @if (Model.B2BClient != null)
                            {
                                var cftClass = Model.B2BClient.CreditFacilityType switch
                                {
                                    1 => "bg-info-subtle text-info border-info-subtle",
                                    2 => "bg-warning-subtle text-warning border-warning-subtle",
                                    3 => "bg-secondary-subtle text-secondary border-secondary-subtle",
                                    _ => "bg-info-subtle text-info border-info-subtle"
                                };
                                <span class="pill-label">Credit Facility Type</span>
                                <div>
                                    <span class="badge @cftClass border py-0.5 px-1.5 fs-9 fw-bold">@(string.IsNullOrWhiteSpace(Model.B2BClient.CreditFacilityTypeName) ? "—" : Model.B2BClient.CreditFacilityTypeName)</span>
                                </div>
                            }
                            else
                            {
                                <span class="pill-label">Payment Status</span>
                                <div>
                                    @if (d.PaymentStatus == "P" || d.BalanceDue <= 0)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle py-0.5 px-1.5 fs-9 fw-bold">Paid (₹@d.TotalPaid.ToString("0.00"))</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle py-0.5 px-1.5 fs-9 fw-bold">Due: ₹@d.BalanceDue.ToString("0.00")</span>
                                    }
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Row 2: Workflow Milestones & Timestamps -->
                    <div class="banner-tiles-row" id="rowBannerStatusTimeline">
                        <div class="info-pill" id="pillOrderStatus">
                            <span class="pill-label"><i class="bi bi-shield-check text-primary me-0.5"></i>Report Status</span>
                            <div>
                                <span class="badge @(d.ReportBadgeClass) py-0.5 px-1.5 fs-9 fw-semibold" id="badgeOrderStatus">@(isPartialApproved ? $"Partially Approved ({approvedCount}/{totalCount})" : d.ReportStatusName)</span>
                            </div>
                        </div>
                        @if (latestDrafted.HasValue)
                        {
                            <div class="info-pill" id="pillDrafted">
                                <span class="pill-label text-warning-emphasis"><i class="bi bi-pencil-square text-warning me-0.5"></i>Drafted Date</span>
                                <span class="pill-val text-warning-emphasis font-monospace" id="pillDraftedVal">@latestDrafted.Value.ToString("dd MMM yyyy, hh:mm tt")</span>
                            </div>
                        }
                        @if (latestSubmitted.HasValue)
                        {
                            <div class="info-pill" id="pillSubmitted">
                                <span class="pill-label text-primary"><i class="bi bi-send-check text-primary me-0.5"></i>Submitted Date</span>
                                <span class="pill-val text-primary font-monospace" id="pillSubmittedVal">@latestSubmitted.Value.ToString("dd MMM yyyy, hh:mm tt")</span>
                            </div>
                        }
                        @if (latestValidated.HasValue)
                        {
                            <div class="info-pill" id="pillValidated">
                                <span class="pill-label text-success"><i class="bi bi-check2-circle text-success me-0.5"></i>Validated Date</span>
                                <span class="pill-val text-success font-monospace" id="pillValidatedVal">@latestValidated.Value.ToString("dd MMM yyyy, hh:mm tt")</span>
                            </div>
                        }
                        @if (latestApproved.HasValue)
                        {
                            <div class="info-pill" id="pillApproved">
                                <span class="pill-label text-info"><i class="bi bi-patch-check-fill text-info me-0.5"></i>Approved Date</span>
                                <span class="pill-val text-info font-monospace" id="pillApprovedVal">@latestApproved.Value.ToString("dd MMM yyyy, hh:mm tt")</span>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <link rel="stylesheet" href="~/css/views/Shared/report-progress.css" asp-append-version="true" />
    <!-- Report progress & colour code (live: driven by the row status badges) -->
    <div class="workflow-strip mb-3" id="workflowStrip">
        <div class="workflow-head">
            <span class="workflow-title"><i class="bi bi-diagram-3-fill me-1"></i>Report Progress</span>
            <span class="workflow-percent" id="wfPercent">&mdash;</span>
        </div>
        <div class="workflow-bar" id="wfBar" role="progressbar" aria-label="Report progress" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
            <span class="wf-seg wf-c-approved"  data-wf="approved"></span>
            <span class="wf-seg wf-c-validated" data-wf="validated"></span>
            <span class="wf-seg wf-c-submitted" data-wf="submitted"></span>
            <span class="wf-seg wf-c-draft"     data-wf="draft"></span>
            <span class="wf-seg wf-c-recollect" data-wf="recollect"></span>
            <span class="wf-seg wf-c-pending"   data-wf="pending"></span>
        </div>
        <div class="workflow-legend">
            <span class="wf-chip wf-c-pending"   data-wf="pending"   title="No result entered yet"><i class="wf-dot"></i>Pending <b id="wfCount_pending">0</b></span>
            <span class="wf-chip wf-c-draft"     data-wf="draft"     title="Draft saved or edits not yet saved"><i class="wf-dot"></i>Draft / Unsaved <b id="wfCount_draft">0</b></span>
            <span class="wf-chip wf-c-submitted" data-wf="submitted" title="Submitted, awaiting validation"><i class="wf-dot"></i>Submitted <b id="wfCount_submitted">0</b></span>
            <span class="wf-chip wf-c-validated" data-wf="validated" title="Validated, awaiting approval"><i class="wf-dot"></i>Validated <b id="wfCount_validated">0</b></span>
            <span class="wf-chip wf-c-approved"  data-wf="approved"  title="Approved and locked"><i class="wf-dot"></i>Approved <b id="wfCount_approved">0</b></span>
            <span class="wf-chip wf-c-recollect" data-wf="recollect" title="Re-collect pending or sample rejected"><i class="wf-dot"></i>Re-collect / Rejected <b id="wfCount_recollect">0</b></span>
            <span class="wf-legend-sep"></span>
            <span class="wf-flag flag-normal"   title="Within reference range">Normal</span>
            <span class="wf-flag flag-l"        title="Below reference range">L Low</span>
            <span class="wf-flag flag-h"        title="Above reference range">H High</span>
            <span class="wf-flag flag-critical" title="Critical value">Critical</span>
            <span class="wf-flag flag-panic" title="Panic value">Panic</span>
        </div>
    </div>

    <!-- Workspace Header & Quick Actions -->
    <div class="d-flex justify-content-between align-items-center mb-2 flex-wrap gap-2">
        <div class="d-flex align-items-center gap-2 flex-wrap">
            <h5 class="mb-0 fw-bold text-dark d-flex align-items-center fs-7">
                <i class="bi bi-file-earmark-medical text-primary me-2"></i>Investigation Test Entry
            </h5>
            <span class="badge bg-primary-subtle text-primary border border-primary-subtle fs-8">
                @(d.Items?.Count ?? 0) Collected In-House Tests
            </span>
            <div class="btn-group btn-group-sm ms-1" role="group">
                <button type="button" class="btn btn-outline-secondary btn-sm py-1 px-2.5 fs-9" id="btnExpandAll" title="Expand all groups">
                    <i class="bi bi-chevron-expand me-1"></i>Expand All
                </button>
                <button type="button" class="btn btn-outline-secondary btn-sm py-1 px-2.5 fs-9" id="btnCollapseAll" title="Collapse all groups">
                    <i class="bi bi-chevron-contract me-1"></i>Collapse All
                </button>
            </div>
        </div>
        @* SQLScripts/2514: Lab Serial No - typed by the user (not generated), one per lab order on this page, required while
           Hospital Settings > LAB > "Is Lab Serial No Req" is Yes *@
        @if (ViewBag.LabSerialRequired is true)
        {
            <div class="d-flex align-items-center gap-2 ms-auto me-2">
                <label for="txtLabSerialNo" class="fw-semibold text-dark fs-8 mb-0 text-nowrap">Lab Serial No <span class="text-danger">*</span></label>
                @{ var serialSaved = !string.IsNullOrWhiteSpace(ViewBag.LabSerialNo as string); }
                @* saved: locked with an Edit button; fully approved: locked for good (no Edit) *@
                <div class="input-group input-group-sm" style="width:210px">
                    <input type="text" id="txtLabSerialNo" class="form-control form-control-sm fs-8" maxlength="50"
                           autocomplete="off" placeholder="Enter serial no" value="@(ViewBag.LabSerialNo as string)"
                           @(serialSaved || isAllApproved ? "readonly" : "") data-approved="@(isAllApproved ? "1" : "0")" />
                    <button type="button" class="btn btn-outline-primary @(serialSaved && !isAllApproved ? "" : "d-none")" id="btnEditLabSerialNo" title="Change the Lab Serial No">
                        <i class="bi bi-pencil-square"></i>
                    </button>
                </div>
            </div>
            <script>
                // SQLScripts/2514: after a save the Lab Serial No locks (Edit unlocks it); after approval it stays locked
                window.labSerialLock = function (approved) {
                    var box = document.getElementById('txtLabSerialNo'), btn = document.getElementById('btnEditLabSerialNo');
                    if (!box || !box.value.trim()) return;
                    box.readOnly = true;
                    if (approved) box.dataset.approved = '1';
                    if (btn) btn.classList.toggle('d-none', box.dataset.approved === '1');
                };
                document.addEventListener('click', function (e) {
                    var btn = e.target.closest('#btnEditLabSerialNo'), box = document.getElementById('txtLabSerialNo');
                    if (!btn || !box || box.dataset.approved === '1') return;
                    box.readOnly = false; box.focus(); box.select(); btn.classList.add('d-none');
                });
            </script>
        }
        <div class="d-flex align-items-center gap-2" id="headerActionButtons">
            <button type="button" class="btn btn-primary px-3.5 py-1.5 fs-8 fw-semibold shadow-xs btn-action-save" id="btnHeaderSave" style="@(showSubmit ? "" : "display:none;")">
                <i class="bi bi-send-check me-1"></i>Submit
            </button>
            <button type="button" class="btn btn-success px-3.5 py-1.5 fs-8 fw-semibold shadow-xs btn-action-validate" id="btnHeaderValidate" asp-permission="@($"{screen.PageCode}:VALIDATE")" style="@(showValidate ? "" : "display:none;")">
                <i class="bi bi-check-circle-fill me-1"></i>Validate Report
            </button>
            <button type="button" class="btn btn-info text-white px-3.5 py-1.5 fs-8 fw-semibold shadow-xs btn-action-approve" id="btnHeaderApprove" asp-permission="@($"{screen.PageCode}:APPROVE")" style="@(showApprove ? "" : "display:none;")">
                <i class="bi bi-patch-check-fill me-1"></i>Approve Report
            </button>
            @if (pathologistApprovalRequired && !isAllApproved)
            {
                <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle px-3 py-1.5 fs-8"
                      title="Hospital Settings > LAB > Pathologist approval required is switched on for this branch">
                    <i class="bi bi-shield-lock-fill me-1"></i>Approval by pathologist
                </span>
            }
            <span class="badge bg-info-subtle text-info border border-info-subtle px-3 py-1.5 fs-8 @(showApprovedBadge ? "" : "d-none")" id="badgeHeaderApproved">
                <i class="bi bi-patch-check-fill me-1"></i>@(isPartialApproved ? $"Partially Approved ({approvedCount}/{totalCount})" : "Report Approved")
            </span>
            <button type="button" class="btn btn-sm px-3 py-1.5 fs-8 btn-print-report @(printProvisional ? "is-provisional" : "")" id="btnHeaderPrint"
                    data-scope="@(printSplit ? "approved" : "all")" data-laborderid="@d.LabOrderId" data-bill="@(d.BillNo ?? "—")"
                    style="@(showPrint ? "" : "display:none;")" title="@(printSplit ? "Preview and print the approved tests" : "Preview and print the lab report")">
                <i class="bi bi-printer-fill me-1"></i><span class="print-btn-label">@(printProvisional ? "Print (Not Approved)" : "Print Report")</span>
            </button>
            <button type="button" class="btn btn-sm px-3 py-1.5 fs-8 btn-print-report is-provisional btn-print-pending" id="btnHeaderPrintPending"
                    data-scope="pending" data-laborderid="@d.LabOrderId" data-bill="@(d.BillNo ?? "—")"
                    style="@(printSplit ? "" : "display:none;")" title="Preview and print the validated tests that are not approved yet (watermarked)">
                <i class="bi bi-printer-fill me-1"></i><span class="print-btn-label">Print (Not Approved)</span>
            </button>
        </div>
    </div>

    <!-- Investigation Results Table -->
    <div class="table-entry-workspace mb-4">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" id="tblInvestigationEntry">
                <thead class="table-light fs-9 text-muted text-uppercase fw-bold border-bottom">
                    <tr>
                        <th class="ps-3 text-muted" style="width: 38px;">#</th>
                        <th style="width: 25%;">Investigation / Profile</th>
                        <th style="width: 12%;">Sample / Tube Type</th>
                        <th style="width: 13%;">Reference Range</th>
                        <th style="width: 7%;">Unit</th>
                        <th style="width: 14%;">Test Result Value *</th>
                        <th class="text-center" style="width: 6%;">Flag</th>
                        <th style="width: 15%;">Lab Remarks / Notes</th>
                        <th class="text-center" style="width: 8%;">Status</th>
                    </tr>
                </thead>
                <tbody class="fs-8">
                    @if (d.Items == null || d.Items.Count == 0)
                    {
                        <tr>
                            <td colspan="9" class="text-center text-muted py-5">
                                <i class="bi bi-journal-x fs-1 text-secondary d-block mb-2"></i>
                                No collected in-house tests found for this lab order.
                            </td>
                        </tr>
                    }
                    else
                    {
                        var hierarchy = d.GetHierarchy();
                        int globalRowIndex = 0;

                        // 1. Render Packages
                        foreach (var pkg in hierarchy.Packages)
                        {
                            <tr class="group-header-row group-header-package" id="header_@pkg.GroupId">
                                <td colspan="9" class="py-2 px-3">
                                    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
                                        <div class="d-flex align-items-center group-collapse-toggle" data-target="@pkg.GroupId" title="Click to Expand/Collapse">
                                            <i class="bi bi-chevron-down me-2 text-info fs-7 group-collapse-icon" id="icon_@pkg.GroupId"></i>
                                            <i class="bi bi-box-seam me-2 fs-7"></i>
                                            <span class="fs-8 text-dark fw-bold">@pkg.PackageName</span>
                                        </div>
                                        <div class="d-flex align-items-center gap-2">
                                            <button type="button" class="btn btn-outline-secondary btn-sm py-0 px-2 fs-9 group-toggle-btn" data-target="@pkg.GroupId">
                                                <span class="toggle-text">Collapse</span>
                                            </button>
                                        </div>
                                    </div>
                                </td>
                            </tr>

                            // Render Profiles within Package
                            foreach (var prof in pkg.Profiles)
                            {
                                var canCollapse = prof.Items.Count > 1;
                                var maxTatHours = prof.Items.Any() ? prof.Items.Max(x => x.TATHours) : 24;
                                var targetMinutes = maxTatHours <= 2 ? maxTatHours * 60 : 60;
                                var orderStart = d.BookingDateTime ?? d.OrderDate;
                                var elapsedMin = Math.Max(5, (int)(DateTime.Now - orderStart).TotalMinutes);
                                if (elapsedMin > targetMinutes) elapsedMin = 52;
                                var tatPct = Math.Min(100, Math.Max(10, (int)((double)elapsedMin / targetMinutes * 100)));
                                var tatBarColor = tatPct > 90 ? "bg-danger" : (tatPct > 70 ? "bg-warning" : "bg-primary");

                                <tr class="group-header-row group-header-profile group-child-@pkg.GroupId is-nested" id="header_@prof.GroupId">
                                    <td colspan="9" class="py-2 px-3">
                                        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 ms-4">
                                            <div class="d-flex align-items-center @(canCollapse ? "group-collapse-toggle" : "")" data-target="@prof.GroupId" title="@(canCollapse ? "Click to Expand/Collapse" : "")">
                                                @if (canCollapse)
                                                {
                                                    <i class="bi bi-chevron-down me-2 text-primary fs-7 group-collapse-icon" id="icon_@prof.GroupId"></i>
                                                }
                                                <i class="bi bi-folder2-open me-2 fs-7 text-primary"></i>
                                                <span class="fs-8 text-dark fw-bold">@prof.ProfileName</span>
                                                <span class="badge bg-white text-dark border ms-2 fs-9 shadow-2xs">
                                                    @prof.Items.Count Test@(prof.Items.Count > 1 ? "s" : "")
                                                </span>
                                                @if (!string.IsNullOrWhiteSpace(prof.SharedBarcode))
                                                {
                                                    <span class="badge bg-white text-dark border ms-2 font-monospace fs-9 shadow-2xs d-inline-flex align-items-center gap-1" title="Specimen Barcode">
                                                        <i class="bi bi-upc-scan text-primary"></i>
                                                        <span>Barcode: <strong>@prof.SharedBarcode</strong></span>
                                                    </span>
                                                }
                                                <div class="d-flex align-items-center gap-2 bg-white px-2 py-0.5 rounded-pill border shadow-2xs ms-2" title="Turnaround Time (Elapsed / Target)">
                                                    <span class="fs-9 fw-semibold text-muted font-monospace">TAT @elapsedMin / @targetMinutes min</span>
                                                    <div class="progress" style="width: 50px; height: 5px; border-radius: 3px; background-color: #e2e8f0;">
                                                        <div class="progress-bar @tatBarColor" role="progressbar" style="width: @(tatPct)%"></div>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="d-flex align-items-center gap-2">
                                                @{
                                                    bool hasProfReportStatus = prof.Items.Any(x => x.ReportStatusId >= 2 && !string.IsNullOrWhiteSpace(x.TestValue));
                                                }
                                                <div class="d-flex align-items-center gap-1.5 sample-status-wrapper" data-grpid="@prof.GroupId">
                                                    <span class="fs-9 fw-semibold text-muted text-nowrap d-none d-sm-inline"><i class="bi bi-eyedropper text-primary me-0.5"></i>Sample:</span>
                                                    @if (hasProfReportStatus)
                                                    {
                                                        <span class="badge @(prof.CollectionstatusID == 3 ? "bg-warning-subtle text-warning-emphasis border border-warning-subtle" : (prof.CollectionstatusID == 4 ? "bg-danger-subtle text-danger border border-danger-subtle" : "bg-success-subtle text-success border border-success-subtle")) fs-9 py-1 px-2 fw-bold">
                                                            <i class="bi bi-eyedropper me-1"></i>@prof.SampleCollectionStatus
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <select class="form-select form-select-sm py-0 ps-2 pe-4 fs-9 fw-bold sample-status-select select-sample-status-@prof.CollectionstatusID"
                                                                data-grpid="@prof.GroupId"
                                                                data-target-name="@prof.ProfileName"
                                                                data-profile-id="@prof.ProfileId"
                                                                data-investigation-id=""
                                                                data-sample-id=""
                                                                data-current-status="@prof.CollectionstatusID"
                                                                style="height: 26px; border-radius: 5px; width: auto; min-width: 110px;">
                                                            @foreach (var st in Model.SampleCollectionStatuses.Where(s => s.StatusID == 2 || s.StatusID == 3 || s.StatusID == 4))
                                                            {
                                                                <option value="@st.StatusID" selected="@(prof.CollectionstatusID == st.StatusID)">@st.StatusName</option>
                                                            }
                                                        </select>
                                                    }
                                                    @if (!string.IsNullOrWhiteSpace(prof.RejectionReason))
                                                    {
                                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle fs-9 sample-rejection-reason-badge" title="Reason: @prof.RejectionReason">
                                                            <i class="bi bi-exclamation-circle me-1"></i>@prof.RejectionReason
                                                        </span>
                                                    }
                                                </div>
                                                <span class="fs-9 text-muted fw-semibold ms-2">
                                                    <span class="group-filled-val" data-grpid="@prof.GroupId">0</span> / @prof.Items.Count entered
                                                </span>
                                                @if (canCollapse)
                                                {
                                                    <button type="button" class="btn btn-outline-secondary btn-sm py-0 px-2 fs-9 group-toggle-btn" data-target="@prof.GroupId">
                                                        <span class="toggle-text">Collapse</span>
                                                    </button>
                                                }
                                            </div>
                                        </div>
                                    </td>
                                </tr>

                                foreach (var item in prof.Items)
                                {
                                    globalRowIndex++;
                                    <tr class="test-item-row group-child-row group-child-@pkg.GroupId group-child-@prof.GroupId is-nested @(canCollapse ? "can-collapse" : "")"
                                        data-samplecollection-id="@item.SamplecollectionID"
                                        data-investigation-id="@item.InvestigationID"
                                        data-test-code="@item.TestCode"
                                        data-report-status-id="@item.ReportStatusId"
                                        data-initial-val="@(item.TestValue ?? "")"
                                        data-initial-remarks="@(item.Remarks ?? item.SpecialRemarks ?? "")"
                                        data-low-val="@(item.LowValue.HasValue ? item.LowValue.Value.ToString(System.Globalization.CultureInfo.InvariantCulture) : "")"
                                        data-high-val="@(item.HighValue.HasValue ? item.HighValue.Value.ToString(System.Globalization.CultureInfo.InvariantCulture) : "")"
                                        data-tier="@(item.RangeTier ?? "")"
                                        data-low-thr="@(item.LowThreshold.HasValue ? item.LowThreshold.Value.ToString(System.Globalization.CultureInfo.InvariantCulture) : "")"
                                        data-high-thr="@(item.HighThreshold.HasValue ? item.HighThreshold.Value.ToString(System.Globalization.CultureInfo.InvariantCulture) : "")"
                                        data-prev-val="@(item.PreviousTestValue ?? "")"
                                        data-prev-date="@(item.PreviousOrderDate?.ToString("dd MMM") ?? "")"
                                        data-prev-unit="@(item.PreviousUnitSymbol ?? item.UnitName ?? "")"
                                        data-unit="@(item.UnitName ?? "")"
                                        data-reporting-type="@(item.ReportingType ?? "Numeric")"
                                        data-grpid="@prof.GroupId">
                                        @await Html.PartialAsync("~/Views/LabReporting/_LabReportingEntryRow.cshtml", new Tuple<int, EMR.Web.Models.DTOs.LabReportingItemDto>(globalRowIndex, item))
                                    </tr>
                                }

                                <!-- Lab Remarks Row for Package Profile -->
                                <tr class="lab-remarks-row group-child-row group-child-@pkg.GroupId group-child-@prof.GroupId is-nested @(canCollapse ? "can-collapse" : "")" id="remarks_@prof.GroupId">
                                    <td colspan="9" class="p-2.5 border-bottom">
                                        <div class="d-flex align-items-center gap-2.5 px-3 ms-4">
                                            <div class="d-flex align-items-center gap-1.5 text-nowrap">
                                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle fs-8 px-2.5 py-1 fw-bold">
                                                    <i class="bi bi-chat-square-text me-1"></i>Lab Remarks
                                                </span>
                                                <span class="fs-8 fw-semibold text-secondary">(@prof.ProfileName):</span>
                                            </div>
                                            <div class="flex-grow-1">
                                                <input type="text"
                                                       class="form-control form-control-sm fs-8 txt-group-lab-remarks @(isApproved ? "bg-light-subtle text-muted" : "")"
                                                       data-group-key="PRF_@prof.ProfileId"
                                                       data-header-name="@prof.ProfileName"
                                                       data-profile-id="@prof.ProfileId"
                                                       data-initial-val="@(prof.LabRemarks ?? "")"
                                                       placeholder="Enter clinical lab remarks or impression for @prof.ProfileName..."
                                                       value="@(prof.LabRemarks ?? "")"
                                                       autocomplete="off"
                                                       @(isApproved ? "readonly=\"readonly\"" : "") />
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            }

                            // Render Standalone Items within Package
                            foreach (var item in pkg.StandaloneItems)
                            {
                                globalRowIndex++;
                                <tr class="test-item-row group-child-row group-child-@pkg.GroupId is-nested"
                                    data-samplecollection-id="@item.SamplecollectionID"
                                    data-investigation-id="@item.InvestigationID"
                                    data-test-code="@item.TestCode"
                                    data-report-status-id="@item.ReportStatusId"
                                    data-initial-val="@(item.TestValue ?? "")"
                                    data-initial-remarks="@(item.Remarks ?? item.SpecialRemarks ?? "")"
                                    data-low-val="@(item.LowValue.HasValue ? item.LowValue.Value.ToString(System.Globalization.CultureInfo.InvariantCulture) : "")"
                                    data-high-val="@(item.HighValue.HasValue ? item.HighValue.Value.ToString(System.Globalization.CultureInfo.InvariantCulture) : "")"
                                    data-tier="@(item.RangeTier ?? "")"
                                    data-low-thr="@(item.LowThreshold.HasValue ? item.LowThreshold.Value.ToString(System.Globalization.CultureInfo.InvariantCulture) : "")"
                                    data-high-thr="@(item.HighThreshold.HasValue ? item.HighThreshold.Value.ToString(System.Globalization.CultureInfo.InvariantCulture) : "")"
                                    data-prev-val="@(item.PreviousTestValue ?? "")"
                                    data-prev-date="@(item.PreviousOrderDate?.ToString("dd MMM") ?? "")"
                                    data-prev-unit="@(item.PreviousUnitSymbol ?? item.UnitName ?? "")"
                                    data-unit="@(item.UnitName ?? "")"
                                    data-reporting-type="@(item.ReportingType ?? "Numeric")"
                                    data-grpid="@pkg.GroupId">
                                    @await Html.PartialAsync("~/Views/LabReporting/_LabReportingEntryRow.cshtml", new Tuple<int, EMR.Web.Models.DTOs.LabReportingItemDto>(globalRowIndex, item))
                                </tr>
                            }

                            @if (pkg.StandaloneItems.Any())
                            {
                                var pkgStandaloneRemarks = pkg.StandaloneItems.FirstOrDefault()?.GroupLabRemarks ?? "";
                                <tr class="lab-remarks-row group-child-row group-child-@pkg.GroupId is-nested" id="remarks_pkg_standalone_@pkg.GroupId">
                                    <td colspan="9" class="p-2.5 border-bottom">
                                        <div class="d-flex align-items-center gap-2.5 px-3 ms-4">
                                            <div class="d-flex align-items-center gap-1.5 text-nowrap">
                                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle fs-8 px-2.5 py-1 fw-bold">
                                                    <i class="bi bi-chat-square-text me-1"></i>Lab Remarks
                                                </span>
                                                <span class="fs-8 fw-semibold text-secondary">(@pkg.PackageName Tests):</span>
                                            </div>
                                            <div class="flex-grow-1">
                                                <input type="text"
                                                       class="form-control form-control-sm fs-8 txt-group-lab-remarks @(isApproved ? "bg-light-subtle text-muted" : "")"
                                                       data-group-key="PKG_@(pkg.PackageId)_STANDALONE"
                                                       data-header-name="@pkg.PackageName"
                                                       data-profile-id="0"
                                                       data-investigation-id="0"
                                                       data-initial-val="@pkgStandaloneRemarks"
                                                       placeholder="Enter clinical lab remarks or impression for @pkg.PackageName tests..."
                                                       value="@pkgStandaloneRemarks"
                                                       autocomplete="off"
                                                       @(isApproved ? "readonly=\"readonly\"" : "") />
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }

                        // 2. Render Standalone Profiles (e.g. Lipid Profile Total)
                        foreach (var prof in hierarchy.StandaloneProfiles)
                        {
                            var canCollapse = prof.Items.Count > 1;
                            var maxTatHours = prof.Items.Any() ? prof.Items.Max(x => x.TATHours) : 24;
                            var targetMinutes = maxTatHours <= 2 ? maxTatHours * 60 : 60;
                            var orderStart = d.BookingDateTime ?? d.OrderDate;
                            var elapsedMin = Math.Max(5, (int)(DateTime.Now - orderStart).TotalMinutes);
                            if (elapsedMin > targetMinutes) elapsedMin = 52;
                            var tatPct = Math.Min(100, Math.Max(10, (int)((double)elapsedMin / targetMinutes * 100)));
                            var tatBarColor = tatPct > 90 ? "bg-danger" : (tatPct > 70 ? "bg-warning" : "bg-primary");

                            <tr class="group-header-row group-header-profile" id="header_@prof.GroupId">
                                <td colspan="9" class="py-2 px-3">
                                    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
                                        <div class="d-flex align-items-center @(canCollapse ? "group-collapse-toggle" : "")" data-target="@prof.GroupId" title="@(canCollapse ? "Click to Expand/Collapse" : "")">
                                            @if (canCollapse)
                                            {
                                                <i class="bi bi-chevron-down me-2 text-primary fs-7 group-collapse-icon" id="icon_@prof.GroupId"></i>
                                            }
                                            <i class="bi bi-folder2-open me-2 fs-7 text-primary"></i>
                                            <span class="fs-8 text-dark fw-bold">@prof.ProfileName</span>
                                            <span class="badge bg-white text-dark border ms-2 fs-9 shadow-2xs">
                                                @prof.Items.Count Test@(prof.Items.Count > 1 ? "s" : "")
                                            </span>
                                            @if (!string.IsNullOrWhiteSpace(prof.SharedBarcode))
                                            {
                                                <span class="badge bg-white text-dark border ms-2 font-monospace fs-9 shadow-2xs d-inline-flex align-items-center gap-1" title="Specimen Barcode">
                                                    <i class="bi bi-upc-scan text-primary"></i>
                                                    <span>Barcode: <strong>@prof.SharedBarcode</strong></span>
                                                </span>
                                            }
                                            <div class="d-flex align-items-center gap-2 bg-white px-2 py-0.5 rounded-pill border shadow-2xs ms-2" title="Turnaround Time (Elapsed / Target)">
                                                <span class="fs-9 fw-semibold text-muted font-monospace">TAT @elapsedMin / @targetMinutes min</span>
                                                <div class="progress" style="width: 50px; height: 5px; border-radius: 3px; background-color: #e2e8f0;">
                                                    <div class="progress-bar @tatBarColor" role="progressbar" style="width: @(tatPct)%"></div>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="d-flex align-items-center gap-2">
                                            @{
                                                bool hasProfReportStatus = prof.Items.Any(x => x.ReportStatusId >= 2 && !string.IsNullOrWhiteSpace(x.TestValue));
                                            }
                                            <div class="d-flex align-items-center gap-1.5 sample-status-wrapper" data-grpid="@prof.GroupId">
                                                <span class="fs-9 fw-semibold text-muted text-nowrap d-none d-sm-inline"><i class="bi bi-eyedropper text-primary me-0.5"></i>Sample:</span>
                                                @if (hasProfReportStatus)
                                                {
                                                    <span class="badge @(prof.CollectionstatusID == 3 ? "bg-warning-subtle text-warning-emphasis border border-warning-subtle" : (prof.CollectionstatusID == 4 ? "bg-danger-subtle text-danger border border-danger-subtle" : "bg-success-subtle text-success border border-success-subtle")) fs-9 py-1 px-2 fw-bold">
                                                        <i class="bi bi-eyedropper me-1"></i>@prof.SampleCollectionStatus
                                                    </span>
                                                }
                                                else
                                                {
                                                    <select class="form-select form-select-sm py-0 ps-2 pe-4 fs-9 fw-bold sample-status-select select-sample-status-@prof.CollectionstatusID"
                                                            data-grpid="@prof.GroupId"
                                                            data-target-name="@prof.ProfileName"
                                                            data-profile-id="@prof.ProfileId"
                                                            data-investigation-id=""
                                                            data-sample-id=""
                                                            data-current-status="@prof.CollectionstatusID"
                                                            style="height: 26px; border-radius: 5px; width: auto; min-width: 110px;">
                                                        @foreach (var st in Model.SampleCollectionStatuses.Where(s => s.StatusID == 2 || s.StatusID == 3 || s.StatusID == 4))
                                                        {
                                                            <option value="@st.StatusID" selected="@(prof.CollectionstatusID == st.StatusID)">@st.StatusName</option>
                                                        }
                                                    </select>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(prof.RejectionReason))
                                                {
                                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle fs-9 sample-rejection-reason-badge" title="Reason: @prof.RejectionReason">
                                                        <i class="bi bi-exclamation-circle me-1"></i>@prof.RejectionReason
                                                    </span>
                                                }
                                            </div>
                                            <span class="fs-9 text-muted fw-semibold ms-2">
                                                <span class="group-filled-val" data-grpid="@prof.GroupId">0</span> / @prof.Items.Count entered
                                            </span>
                                            @if (canCollapse)
                                            {
                                                <button type="button" class="btn btn-outline-secondary btn-sm py-0 px-2 fs-9 group-toggle-btn" data-target="@prof.GroupId">
                                                    <span class="toggle-text">Collapse</span>
                                                </button>
                                            }
                                        </div>
                                    </div>
                                </td>
                            </tr>

                            foreach (var item in prof.Items)
                            {
                                globalRowIndex++;
                                <tr class="test-item-row group-child-row group-child-@prof.GroupId is-nested @(canCollapse ? "can-collapse" : "")"
                                    data-samplecollection-id="@item.SamplecollectionID"
                                    data-investigation-id="@item.InvestigationID"
                                    data-test-code="@item.TestCode"
                                    data-report-status-id="@item.ReportStatusId"
                                    data-initial-val="@(item.TestValue ?? "")"
                                    data-initial-remarks="@(item.Remarks ?? item.SpecialRemarks ?? "")"
                                    data-low-val="@(item.LowValue.HasValue ? item.LowValue.Value.ToString(System.Globalization.CultureInfo.InvariantCulture) : "")"
                                    data-high-val="@(item.HighValue.HasValue ? item.HighValue.Value.ToString(System.Globalization.CultureInfo.InvariantCulture) : "")"
                                    data-tier="@(item.RangeTier ?? "")"
                                    data-low-thr="@(item.LowThreshold.HasValue ? item.LowThreshold.Value.ToString(System.Globalization.CultureInfo.InvariantCulture) : "")"
                                    data-high-thr="@(item.HighThreshold.HasValue ? item.HighThreshold.Value.ToString(System.Globalization.CultureInfo.InvariantCulture) : "")"
                                    data-prev-val="@(item.PreviousTestValue ?? "")"
                                    data-prev-date="@(item.PreviousOrderDate?.ToString("dd MMM") ?? "")"
                                    data-prev-unit="@(item.PreviousUnitSymbol ?? item.UnitName ?? "")"
                                    data-unit="@(item.UnitName ?? "")"
                                    data-reporting-type="@(item.ReportingType ?? "Numeric")"
                                    data-grpid="@prof.GroupId">
                                    @await Html.PartialAsync("~/Views/LabReporting/_LabReportingEntryRow.cshtml", new Tuple<int, EMR.Web.Models.DTOs.LabReportingItemDto>(globalRowIndex, item))
                                </tr>
                            }

                            <!-- Lab Remarks Row for Standalone Profile -->
                            <tr class="lab-remarks-row group-child-row group-child-@prof.GroupId is-nested @(canCollapse ? "can-collapse" : "")" id="remarks_@prof.GroupId">
                                <td colspan="9" class="p-2.5 border-bottom">
                                    <div class="d-flex align-items-center gap-2.5 px-3 ms-3">
                                        <div class="d-flex align-items-center gap-1.5 text-nowrap">
                                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle fs-8 px-2.5 py-1 fw-bold">
                                                <i class="bi bi-chat-square-text me-1"></i>Lab Remarks
                                            </span>
                                            <span class="fs-8 fw-semibold text-secondary">(@prof.ProfileName):</span>
                                        </div>
                                        <div class="flex-grow-1">
                                            <input type="text"
                                                   class="form-control form-control-sm fs-8 txt-group-lab-remarks @(isApproved ? "bg-light-subtle text-muted" : "")"
                                                   data-group-key="PRF_@prof.ProfileId"
                                                   data-header-name="@prof.ProfileName"
                                                   data-profile-id="@prof.ProfileId"
                                                   data-initial-val="@(prof.LabRemarks ?? "")"
                                                   placeholder="Enter clinical lab remarks or impression for @prof.ProfileName..."
                                                   value="@(prof.LabRemarks ?? "")"
                                                   autocomplete="off"
                                                   @(isApproved ? "readonly=\"readonly\"" : "") />
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }

                        // 3. Render Standalone Investigation Groups (e.g. Fasting Blood Sugar (FBS))
                        if (hierarchy.StandaloneTestGroups.Any())
                        {
                            foreach (var tstGrp in hierarchy.StandaloneTestGroups)
                            {
                                var maxTatHours = tstGrp.Items.Any() ? tstGrp.Items.Max(x => x.TATHours) : 24;
                                var targetMinutes = maxTatHours <= 2 ? maxTatHours * 60 : 60;
                                var orderStart = d.BookingDateTime ?? d.OrderDate;
                                var elapsedMin = Math.Max(5, (int)(DateTime.Now - orderStart).TotalMinutes);
                                if (elapsedMin > targetMinutes) elapsedMin = 52;
                                var tatPct = Math.Min(100, Math.Max(10, (int)((double)elapsedMin / targetMinutes * 100)));
                                var tatBarColor = tatPct > 90 ? "bg-danger" : (tatPct > 70 ? "bg-warning" : "bg-primary");

                                <tr class="group-header-row group-header-default" id="header_@tstGrp.GroupId">
                                    <td colspan="9" class="py-2 px-3">
                                        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
                                            <div class="d-flex align-items-center">
                                                <i class="bi bi-card-checklist me-2 fs-7 text-secondary"></i>
                                                <span class="fs-8 text-dark fw-bold">@tstGrp.TestName</span>
                                                <span class="badge bg-white text-dark border ms-2 fs-9 shadow-2xs font-monospace">@tstGrp.TestCode</span>
                                                @if (!string.IsNullOrWhiteSpace(tstGrp.SharedBarcode))
                                                {
                                                    <span class="badge bg-white text-dark border ms-2 font-monospace fs-9 shadow-2xs d-inline-flex align-items-center gap-1" title="Specimen Barcode">
                                                        <i class="bi bi-upc-scan text-primary"></i>
                                                        <span>Barcode: <strong>@tstGrp.SharedBarcode</strong></span>
                                                    </span>
                                                }
                                                <div class="d-flex align-items-center gap-2 bg-white px-2 py-0.5 rounded-pill border shadow-2xs ms-2" title="Turnaround Time (Elapsed / Target)">
                                                    <span class="fs-9 fw-semibold text-muted font-monospace">TAT @elapsedMin / @targetMinutes min</span>
                                                    <div class="progress" style="width: 50px; height: 5px; border-radius: 3px; background-color: #e2e8f0;">
                                                        <div class="progress-bar @tatBarColor" role="progressbar" style="width: @(tatPct)%"></div>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="d-flex align-items-center gap-2">
                                                @{
                                                    bool hasTstReportStatus = tstGrp.Items.Any(x => x.ReportStatusId >= 2 && !string.IsNullOrWhiteSpace(x.TestValue));
                                                }
                                                <div class="d-flex align-items-center gap-1.5 sample-status-wrapper" data-grpid="@tstGrp.GroupId">
                                                    <span class="fs-9 fw-semibold text-muted text-nowrap d-none d-sm-inline"><i class="bi bi-eyedropper text-primary me-0.5"></i>Sample:</span>
                                                    @if (hasTstReportStatus)
                                                    {
                                                        <span class="badge @(tstGrp.CollectionstatusID == 3 ? "bg-warning-subtle text-warning-emphasis border border-warning-subtle" : (tstGrp.CollectionstatusID == 4 ? "bg-danger-subtle text-danger border border-danger-subtle" : "bg-success-subtle text-success border border-success-subtle")) fs-9 py-1 px-2 fw-bold">
                                                            <i class="bi bi-eyedropper me-1"></i>@tstGrp.SampleCollectionStatus
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <select class="form-select form-select-sm py-0 ps-2 pe-4 fs-9 fw-bold sample-status-select select-sample-status-@tstGrp.CollectionstatusID"
                                                                data-grpid="@tstGrp.GroupId"
                                                                data-target-name="@tstGrp.TestName"
                                                                data-profile-id=""
                                                                data-investigation-id="@tstGrp.InvestigationId"
                                                                data-sample-id="@tstGrp.SamplecollectionID"
                                                                data-current-status="@tstGrp.CollectionstatusID"
                                                                style="height: 26px; border-radius: 5px; width: auto; min-width: 110px;">
                                                            @foreach (var st in Model.SampleCollectionStatuses.Where(s => s.StatusID == 2 || s.StatusID == 3 || s.StatusID == 4))
                                                            {
                                                                <option value="@st.StatusID" selected="@(tstGrp.CollectionstatusID == st.StatusID)">@st.StatusName</option>
                                                            }
                                                        </select>
                                                    }
                                                    @if (!string.IsNullOrWhiteSpace(tstGrp.RejectionReason))
                                                    {
                                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle fs-9 sample-rejection-reason-badge" title="Reason: @tstGrp.RejectionReason">
                                                            <i class="bi bi-exclamation-circle me-1"></i>@tstGrp.RejectionReason
                                                        </span>
                                                    }
                                                </div>
                                                <span class="badge bg-light text-secondary border fs-9">Single Investigation</span>
                                            </div>
                                        </div>
                                    </td>
                                </tr>

                                foreach (var item in tstGrp.Items)
                                {
                                    globalRowIndex++;
                                    <tr class="test-item-row group-child-row group-child-@tstGrp.GroupId is-nested"
                                        data-samplecollection-id="@item.SamplecollectionID"
                                        data-investigation-id="@item.InvestigationID"
                                        data-test-code="@item.TestCode"
                                        data-report-status-id="@item.ReportStatusId"
                                        data-initial-val="@(item.TestValue ?? "")"
                                        data-initial-remarks="@(item.Remarks ?? item.SpecialRemarks ?? "")"
                                        data-low-val="@(item.LowValue.HasValue ? item.LowValue.Value.ToString(System.Globalization.CultureInfo.InvariantCulture) : "")"
                                        data-high-val="@(item.HighValue.HasValue ? item.HighValue.Value.ToString(System.Globalization.CultureInfo.InvariantCulture) : "")"
                                        data-tier="@(item.RangeTier ?? "")"
                                        data-low-thr="@(item.LowThreshold.HasValue ? item.LowThreshold.Value.ToString(System.Globalization.CultureInfo.InvariantCulture) : "")"
                                        data-high-thr="@(item.HighThreshold.HasValue ? item.HighThreshold.Value.ToString(System.Globalization.CultureInfo.InvariantCulture) : "")"
                                        data-prev-val="@(item.PreviousTestValue ?? "")"
                                        data-prev-date="@(item.PreviousOrderDate?.ToString("dd MMM") ?? "")"
                                        data-prev-unit="@(item.PreviousUnitSymbol ?? item.UnitName ?? "")"
                                        data-unit="@(item.UnitName ?? "")"
                                        data-reporting-type="@(item.ReportingType ?? "Numeric")"
                                        data-grpid="@tstGrp.GroupId">
                                        @await Html.PartialAsync("~/Views/LabReporting/_LabReportingEntryRow.cshtml", new Tuple<int, EMR.Web.Models.DTOs.LabReportingItemDto>(globalRowIndex, item))
                                    </tr>
                                }

                                <!-- Lab Remarks Row for Standalone Test -->
                                <tr class="lab-remarks-row group-child-row group-child-@tstGrp.GroupId is-nested" id="remarks_@tstGrp.GroupId">
                                    <td colspan="9" class="p-2.5 border-bottom">
                                        <div class="d-flex align-items-center gap-2.5 px-3 ms-3">
                                            <div class="d-flex align-items-center gap-1.5 text-nowrap">
                                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle fs-8 px-2.5 py-1 fw-bold">
                                                    <i class="bi bi-chat-square-text me-1"></i>Lab Remarks
                                                </span>
                                                <span class="fs-8 fw-semibold text-secondary">(@tstGrp.TestName):</span>
                                            </div>
                                            <div class="flex-grow-1">
                                                <input type="text"
                                                       class="form-control form-control-sm fs-8 txt-group-lab-remarks @(isApproved ? "bg-light-subtle text-muted" : "")"
                                                       data-group-key="INV_@tstGrp.InvestigationId"
                                                       data-header-name="@tstGrp.TestName"
                                                       data-investigation-id="@tstGrp.InvestigationId"
                                                       data-initial-val="@(tstGrp.LabRemarks ?? "")"
                                                       placeholder="Enter clinical lab remarks or impression for @tstGrp.TestName..."
                                                       value="@(tstGrp.LabRemarks ?? "")"
                                                       autocomplete="off"
                                                       @(isApproved ? "readonly=\"readonly\"" : "") />
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Sticky Bottom Action Footer -->
<div class="sticky-action-bar">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
        <div class="d-flex align-items-center gap-3 fs-8 text-muted">
            <i class="bi bi-ui-checks text-primary"></i>
            <span id="counterEntered" class="fw-semibold text-dark">0 / @(d.Items?.Count ?? 0) Values Filled</span>
        </div>
        <div class="d-flex align-items-center gap-2" id="footerActionButtons">
            <button type="button" class="btn btn-outline-secondary btn-sm px-3" onclick="window.close()">
                <i class="bi bi-x me-1"></i>Close
            </button>
            <button type="button" class="btn btn-primary btn-sm px-3.5 fw-semibold shadow-xs btn-action-save" id="btnStickySave" style="@(showSubmit ? "" : "display:none;")">
                <i class="bi bi-send-check me-1"></i>Submit
            </button>
            <button type="button" class="btn btn-success btn-sm px-3.5 fw-semibold shadow-xs btn-action-validate" id="btnStickyValidate" asp-permission="@($"{screen.PageCode}:VALIDATE")" style="@(showValidate ? "" : "display:none;")">
                <i class="bi bi-check-circle-fill me-1"></i>Validate Report
            </button>
            <button type="button" class="btn btn-info text-white btn-sm px-3.5 fw-semibold shadow-xs btn-action-approve" id="btnStickyApprove" asp-permission="@($"{screen.PageCode}:APPROVE")" style="@(showApprove ? "" : "display:none;")">
                <i class="bi bi-patch-check-fill me-1"></i>Approve Report
            </button>
            <span class="badge bg-info-subtle text-info border border-info-subtle px-3 py-2 fs-8 @(isAllApproved ? "" : "d-none")" id="badgeApprovedFooter">
                <i class="bi bi-patch-check-fill me-1"></i>Report Approved
            </span>
            <button type="button" class="btn btn-sm px-3 fw-semibold btn-print-report @(printProvisional ? "is-provisional" : "")" id="btnStickyPrint"
                    data-scope="@(printSplit ? "approved" : "all")" data-laborderid="@d.LabOrderId" data-bill="@(d.BillNo ?? "—")"
                    style="@(showPrint ? "" : "display:none;")" title="@(printSplit ? "Preview and print the approved tests" : "Preview and print the lab report")">
                <i class="bi bi-printer-fill me-1"></i><span class="print-btn-label">@(printProvisional ? "Print (Not Approved)" : "Print Report")</span>
            </button>
            <button type="button" class="btn btn-sm px-3 fw-semibold btn-print-report is-provisional btn-print-pending" id="btnStickyPrintPending"
                    data-scope="pending" data-laborderid="@d.LabOrderId" data-bill="@(d.BillNo ?? "—")"
                    style="@(printSplit ? "" : "display:none;")" title="Preview and print the validated tests that are not approved yet (watermarked)">
                <i class="bi bi-printer-fill me-1"></i><span class="print-btn-label">Print (Not Approved)</span>
            </button>
        </div>
    </div>
</div>

<!-- Rejection / Re-Collection Reason Modal -->
<div class="modal fade" id="modalSampleRejectionReason" tabindex="-1" aria-labelledby="modalSampleRejectionReasonLabel" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header border-bottom py-2.5 px-3 bg-light">
                <h6 class="modal-title fs-7 fw-bold d-flex align-items-center gap-2" id="modalSampleRejectionReasonLabel">
                    <i class="bi bi-exclamation-triangle-fill text-warning"></i>
                    <span id="modalRejectionTitle">Sample Status Change</span>
                </h6>
                <button type="button" class="btn-close fs-9" data-bs-dismiss="modal" aria-label="Close" id="btnCancelModalClose"></button>
            </div>
            <div class="modal-body p-3">
                <div class="alert alert-light border d-flex align-items-center gap-2 p-2 mb-3 rounded-2">
                    <i class="bi bi-folder2-open text-primary fs-6"></i>
                    <div>
                        <div class="fs-9 text-muted fw-semibold">Target Investigation / Profile</div>
                        <div class="fs-8 fw-bold text-dark" id="modalRejectionTargetName">—</div>
                    </div>
                </div>

                <div class="mb-3">
                    <label for="modalRejectionReasonSelect" class="form-label fs-8 fw-bold text-dark mb-1">
                        Select Rejection / Re-Collection Reason <span class="text-danger">*</span>
                    </label>
                    <select class="form-select form-select-sm fs-8" id="modalRejectionReasonSelect">
                        <option value="">-- Choose Reason from Master --</option>
                        @foreach (var r in Model.RejectionReasons)
                        {
                            <option value="@r.Reason_ID" data-name="@r.Reason_Text">@r.Reason_Text@(string.IsNullOrWhiteSpace(r.Applicable_Sample_Type_Name) ? "" : $" ({r.Applicable_Sample_Type_Name})")</option>
                        }
                        <option value="0">Other / Custom Reason...</option>
                    </select>
                    <div class="invalid-feedback fs-9" id="modalRejectionReasonFeedback">Please select a reason.</div>
                </div>

                <div class="mb-2" id="modalCustomReasonContainer" style="display:none;">
                    <label for="modalCustomReasonText" class="form-label fs-9 fw-semibold text-muted mb-1">Additional Remarks / Reason Details <span class="text-danger">*</span></label>
                    <textarea class="form-control form-control-sm fs-8" id="modalCustomReasonText" rows="2" placeholder="Provide specific reason / comments..."></textarea>
                </div>

                <div class="alert alert-warning-subtle border border-warning-subtle p-2 mb-0 rounded-2 fs-9 text-warning-emphasis d-flex align-items-start gap-2">
                    <i class="bi bi-info-circle-fill mt-0.5"></i>
                    <div>
                        Marking this specimen for <strong>Re-Collect</strong> or <strong>Rejected</strong> will send it back to the <strong>Sample Collection</strong> worklist in pending status. All entered test results for this group will be cleared and set to <strong>Pending entry</strong>.
                    </div>
                </div>
            </div>
            <div class="modal-footer border-top py-2 px-3 bg-light">
                <button type="button" class="btn btn-outline-secondary btn-sm fs-8 px-3" data-bs-dismiss="modal" id="btnCancelModal">Cancel</button>
                <button asp-permission="@($"{screen.PageCode}:SAMPLE_STATUS")" type="button" class="btn btn-primary btn-sm fs-8 px-3 shadow-sm fw-bold" id="btnConfirmSampleStatusChange">
                    <span class="spinner-border spinner-border-sm me-1 d-none" id="spnConfirmSampleStatus"></span>
                    <i class="bi bi-check2-circle me-1" id="iconConfirmSampleStatus"></i>Confirm & Update
                </button>
            </div>
        </div>
    </div>
</div>

<partial name="_LabAuditHistoryModal" />

<partial name="_LabReportPrintModal" />

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
    <partial name="_CriticalCommunicationModal" />
    @* Lab Report Entry script (wwwroot/js/views/LabReporting/Entry.js): the page's values *@
    <script>
        window.labEntryCfg = {
            labOrderId: @d.LabOrderId,
            pathologistApprovalRequired: @(pathologistApprovalRequired ? "true" : "false"),
            formulaUrl: @Json.Serialize(Url.Action("CalculateFormulasJson", screen.Controller)),
            saveUrl: @Json.Serialize(Url.Action("SaveEntryJson", screen.Controller)),
            sampleStatusUrl: @Json.Serialize(Url.Action("UpdateSampleStatusJson", screen.Controller))
        };
    </script>
    <script src="~/js/views/LabReporting/Entry.js" asp-append-version="true"></script>
    @if (screen.MixedTypes)
    {
        <script src="~/lib/quill/quill.min.js"></script>
        <partial name="~/Views/LabReporting/_LabReportingMixedTypeScripts.cshtml" />
    }
    <partial name="_LabAuditHistoryScripts" />

    <partial name="_LabReportPrintScripts" />

    @if (ViewData["DeltaTrend"] as bool? == true)
    {
        <partial name="~/Views/LabReporting/_DeltaTrendPopup.cshtml" />
    }

    @* reflex test suggestions: numeric reporting only, AI features switched on (SQLScripts/2289) *@
    @if (screen.Controller == "LabReporting" && await AiBillingFeatures.IsEnabledAsync(Context))
    {
        @Html.AntiForgeryToken()
        <partial name="~/Views/LabReporting/_ReflexSuggestions.cshtml" model="@d.LabOrderId" />
    }
}
