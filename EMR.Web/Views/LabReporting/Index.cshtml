@model EMR.Web.Models.ViewModels.LabReportingDashboardViewModel
@{
    ViewData["Title"] = "Lab Reporting Entry";
}

@section HeadStyles {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" />
    <link rel="stylesheet" href="~/css/views/LabReporting/Index.css" asp-append-version="true" />
}

<div class="container-fluid px-3 py-1.5 reporting-wrapper">
    <!-- Page header -->
    <div class="lr-head shadow-sm px-3 py-2 mb-2 d-flex flex-wrap justify-content-between align-items-center gap-2">
        <div class="d-flex align-items-center gap-2">
            <div class="lr-head-icon"><i class="bi bi-file-earmark-medical"></i></div>
            <div>
                <h5 class="mb-0 fw-bold text-dark d-flex align-items-center gap-2">
                    Lab Reporting Entry
                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle fs-9 fw-semibold">Collected In-House Samples</span>
                </h5>
                <div class="text-muted fs-9 mt-0.5">Enter and validate test results for collected lab specimens</div>
            </div>
        </div>
        <div class="d-flex gap-2 align-items-center">
            <span id="arMount"></span>
            <span class="lr-count-chip" id="lblRowCount">&mdash;</span>
            <button type="button" class="btn btn-outline-secondary btn-sm btn-icon shadow-xs" id="btnRefreshList" title="Refresh list">
                <i class="bi bi-arrow-clockwise"></i>
            </button>
        </div>
    </div>

    @if (TempData["ErrorMessage"] is string lrErr && !string.IsNullOrWhiteSpace(lrErr))
    {
        <div class="alert alert-danger alert-dismissible fade show py-2 fs-8 mb-2" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-1"></i>@lrErr
            <button type="button" class="btn-close py-2" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @* Department Access (User Master): which test departments this user reports on *@
    @if (Model.DepartmentScopeRestricted)
    {
        if (Model.DepartmentScopeNames.Count == 0)
        {
            <div class="alert alert-warning py-2 fs-8 mb-2 d-flex align-items-center gap-2" role="alert">
                <i class="bi bi-shield-exclamation fs-6"></i>
                <div><strong>No LAB department assigned to you.</strong> Orders are listed by the department of each test &mdash;
                    ask an administrator to add your department(s) in <strong>User Master &rsaquo; Access &amp; Roles &rsaquo; Department Access</strong>.</div>
            </div>
        }
        else
        {
            <div class="d-flex flex-wrap align-items-center gap-1 fs-9 mb-2 text-muted">
                <i class="bi bi-shield-lock text-primary"></i>
                <span>Showing tests of your departments:</span>
                @foreach (var dn in Model.DepartmentScopeNames)
                {
                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle fw-semibold">@dn</span>
                }
                <span class="ms-1">(User Master &rsaquo; Department Access)</span>
            </div>
        }
    }

    <!-- Summary KPI cards -->
    <div class="row g-2 mb-2">
        <div class="col-6 col-md">
            <div class="card stat-card k-total shadow-sm h-100" data-status="All">
                <div class="card-body py-2 px-2.5 d-flex align-items-center justify-content-between">
                    <div>
                        <span class="stat-label d-block">Total Orders</span>
                        <div class="stat-value mt-0.5" id="statTotalOrders">@Model.Stats.TotalOrders</div>
                    </div>
                    <div class="stat-icon"><i class="bi bi-journal-medical"></i></div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md">
            <div class="card stat-card k-pending shadow-sm h-100" data-status="Pending Entry">
                <div class="card-body py-2 px-2.5 d-flex align-items-center justify-content-between">
                    <div>
                        <span class="stat-label d-block">Pending Entry</span>
                        <div class="stat-value mt-0.5" id="statPendingOrders">@Model.Stats.PendingOrders</div>
                    </div>
                    <div class="stat-icon"><i class="bi bi-clock-history"></i></div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md">
            <div class="card stat-card k-draft shadow-sm h-100" data-status="Draft" title="Some tests submitted and others not yet on this bill (there is no separate Save Draft step)">
                <div class="card-body py-2 px-2.5 d-flex align-items-center justify-content-between">
                    <div>
                        <span class="stat-label d-block">In Progress</span>
                        <div class="stat-value mt-0.5" id="statDraftOrders">@Model.Stats.DraftOrders</div>
                    </div>
                    <div class="stat-icon"><i class="bi bi-pencil-square"></i></div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md">
            <div class="card stat-card k-entered shadow-sm h-100" data-status="Report Entry">
                <div class="card-body py-2 px-2.5 d-flex align-items-center justify-content-between">
                    <div>
                        <span class="stat-label d-block">Report Entered</span>
                        <div class="stat-value mt-0.5" id="statEnteredOrders">@Model.Stats.EnteredOrders</div>
                    </div>
                    <div class="stat-icon"><i class="bi bi-file-earmark-check"></i></div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md">
            <div class="card stat-card k-validated shadow-sm h-100" data-status="Report Validated">
                <div class="card-body py-2 px-2.5 d-flex align-items-center justify-content-between">
                    <div>
                        <span class="stat-label d-block">Validated</span>
                        <div class="stat-value mt-0.5" id="statValidatedOrders">@Model.Stats.ValidatedOrders</div>
                    </div>
                    <div class="stat-icon"><i class="bi bi-patch-check-fill"></i></div>
                </div>
            </div>
        </div>
    </div>

    <!-- Filters -->
    <div class="card lr-card shadow-sm mb-2">
        <div class="card-body p-2 px-3">
            <div class="row g-2 align-items-end">
                <div class="col-6 col-md-2">
                    <label class="lr-label" for="selDateFilterType">Filter By Date</label>
                    <select id="selDateFilterType" class="form-select form-select-sm">
                        <option value="CollectionDate" selected="@(Model.DateFilterType == "CollectionDate")">Sample Collection DateTime</option>
                        <option value="BookingDate" selected="@(Model.DateFilterType == "BookingDate")">Booking Date Time</option>
                        <option value="OrderDate" selected="@(Model.DateFilterType == "OrderDate")">Order / Bill Date</option>
                    </select>
                </div>
                <div class="col-6 col-md-2">
                    <label class="lr-label" for="txtFromDate">From Date</label>
                    <input type="date" id="txtFromDate" class="form-control form-control-sm" value="@Model.FromDate.ToString("yyyy-MM-dd")" />
                </div>
                <div class="col-6 col-md-2">
                    <label class="lr-label" for="txtToDate">To Date</label>
                    <input type="date" id="txtToDate" class="form-control form-control-sm" value="@Model.ToDate.ToString("yyyy-MM-dd")" />
                </div>
                <div class="col-6 col-md-3">
                    <label class="lr-label">Quick Select</label>
                    <div class="btn-group btn-group-sm w-100 lr-quick" role="group" aria-label="Quick date range">
                        <button type="button" class="btn btn-quick-date" data-range="today">Today</button>
                        <button type="button" class="btn btn-quick-date" data-range="yesterday">Yesterday</button>
                        <button type="button" class="btn btn-quick-date" data-range="week">7 Days</button>
                        <button type="button" class="btn btn-quick-date" data-range="month">This Month</button>
                    </div>
                </div>
                <div class="col-12 col-md-3">
                    <label class="lr-label" for="txtSearch">Search Patient / Order</label>
                    <div class="input-group input-group-sm">
                        <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                        <input type="text" id="txtSearch" class="form-control border-start-0 ps-0" placeholder="Name, code, token, bill, phone&hellip;" value="@Model.Search" />
                    </div>
                </div>
            </div>
        </div>

        <div class="lr-filter-strip px-3 py-2">
            <div class="row g-2 align-items-end">
                <div class="col-12 col-md-auto d-flex align-items-center pb-1">
                    <span class="fw-semibold fs-9 text-secondary d-flex align-items-center gap-1 text-uppercase" style="letter-spacing:.4px;">
                        <i class="bi bi-funnel-fill text-primary"></i>Filter Investigations
                    </span>
                </div>
                <div class="col-12 col-md">
                    <label class="lr-label" for="ddlDepartment"><i class="bi bi-hospital me-1"></i>Department</label>
                    <select id="ddlDepartment" class="form-select form-select-sm" data-placeholder="-- All Departments --">
                        <option value="">-- All Departments --</option>
                            @foreach (var d in Model.DepartmentOptions)
                            {
                                <option value="@d.Value" selected="@(d.Value == Model.DepartmentId?.ToString() ? "selected" : null)">@d.Text</option>
                            }
                        </select>
                </div>
                <div class="col-12 col-md">
                    <label class="lr-label" for="ddlCategory"><i class="bi bi-tag me-1"></i>Category</label>
                    <select id="ddlCategory" class="form-select form-select-sm" data-placeholder="-- All Categories --">
                        <option value="">-- All Categories --</option>
                            @foreach (var c in Model.CategoryOptions)
                            {
                                <option value="@c.Value" selected="@(c.Value == Model.CategoryId?.ToString() ? "selected" : null)">@c.Text</option>
                            }
                        </select>
                </div>
                <div class="col-12 col-md">
                    <label class="lr-label" for="ddlSubCategory"><i class="bi bi-diagram-3 me-1"></i>Sub Category</label>
                    <select id="ddlSubCategory" class="form-select form-select-sm" data-placeholder="-- All Sub Categories --">
                        <option value="">-- All Sub Categories --</option>
                            @foreach (var s in Model.SubCategoryOptions)
                            {
                                <option value="@s.Value" selected="@(s.Value == Model.SubCategoryId?.ToString() ? "selected" : null)">@s.Text</option>
                            }
                        </select>
                </div>
                <div class="col-12 col-md-auto">
                    <button type="button" class="btn btn-link btn-sm text-decoration-none text-danger p-0 fs-9" id="btnResetFilters" style="display:none;">
                        <i class="bi bi-x-circle me-1"></i>Clear Filters
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Orders -->
    <div class="card lr-card shadow-sm">
        <div class="px-3 py-2 border-bottom d-flex flex-wrap justify-content-between align-items-center gap-2">
            <span class="fw-semibold fs-9 text-secondary text-uppercase" style="letter-spacing:.4px;">
                <i class="bi bi-list-ul me-1 text-primary"></i>Orders
            </span>
            <div class="lr-legend" id="statusLegend" role="group" aria-label="Filter rows by report status">
                <button type="button" class="lg-item st-pending"   data-st="st-pending"   title="Show only Pending Entry rows"><span class="lg-dot"></span>Pending Entry<span class="lg-count"></span></button>
                <button type="button" class="lg-item st-draft"     data-st="st-draft"     title="Show only In Progress rows"><span class="lg-dot"></span>In Progress<span class="lg-count"></span></button>
                <button type="button" class="lg-item st-entered"   data-st="st-entered"   title="Show only Report Entry rows"><span class="lg-dot"></span>Report Entry<span class="lg-count"></span></button>
                <button type="button" class="lg-item st-validated" data-st="st-validated" title="Show only Validated rows"><span class="lg-dot"></span>Validated<span class="lg-count"></span></button>
                <button type="button" class="lg-item st-approved"  data-st="st-approved"  title="Show only Approved rows"><span class="lg-dot"></span>Approved<span class="lg-count"></span></button>
                <button type="button" class="lg-item st-recollect" data-st="st-recollect" title="Show only Re-Collect rows"><span class="lg-dot"></span>Re-Collect<span class="lg-count"></span></button>
                <button type="button" class="lg-item st-rejected"  data-st="st-rejected"  title="Show only Rejected rows"><span class="lg-dot"></span>Rejected<span class="lg-count"></span></button>
                <button type="button" class="lg-item lg-clear d-none" id="btnClearLegend" title="Show every status again"><i class="bi bi-x-lg"></i>Clear</button>
            </div>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive table-responsive-custom">
                <table class="table table-hover table-sticky-header align-middle mb-0" id="tblReportingOrders">
                    <thead>
                        <tr>
                            <th class="ps-3" style="width: 44px;">#</th>
                            <th style="width: 170px;">Order / Token</th>
                            <th style="width: 260px;">Patient Details</th>
                            <th>Contact</th>
                            <th style="width: 140px;">Booking Date</th>
                            <th class="text-center" style="width: 150px;">Collection Status</th>
                            <th class="text-center" style="width: 150px;">Report Status</th>
                            <th class="text-end pe-3" style="width: 140px;">Action</th>
                        </tr>
                    </thead>
                    <tbody id="tblReportingOrdersBody" class="fs-8">
                        <!-- Populated by JavaScript -->
                    </tbody>
                </table>
            </div>
            <!-- No row matches the picked status colour -->
            <div id="legendEmptyState" class="text-center py-4 d-none">
                <div class="text-muted fs-8">
                    <i class="bi bi-funnel me-1"></i>No order in this status for the current filters.
                    <button type="button" class="btn btn-link btn-sm p-0 fs-8 text-decoration-none align-baseline" id="btnClearLegendInline">Show all statuses</button>
                </div>
            </div>

            <!-- Empty state -->
            <div id="emptyOrdersState" class="text-center py-5 d-none">
                <div class="d-inline-flex align-items-center justify-content-center rounded-circle mb-2"
                     style="width:64px;height:64px;background:#eef2f6;color:#94a3b8;">
                    <i class="bi bi-journal-x" style="font-size: 1.8rem;"></i>
                </div>
                <div class="fw-bold text-dark fs-7">No collected orders found</div>
                <div class="text-muted fs-8 mt-1">No in-house collected samples match the current filters. Try a wider date range or clear the filters.</div>
            </div>
            <!-- Loading state -->
            <div id="loadingOrdersState" class="text-center py-5">
                <div class="spinner-border spinner-border-sm text-primary" role="status">
                    <span class="visually-hidden">Loading&hellip;</span>
                </div>
                <div class="text-muted fs-8 mt-2">Fetching lab orders for reporting&hellip;</div>
            </div>
        </div>
    </div>
</div>
</div>

<partial name="_LabAuditHistoryModal" />

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
    <partial name="_LabAuditHistoryScripts" />
    <script src="~/js/auto-refresh.js" asp-append-version="true"></script>
    <script>
        $(document).ready(function () {
            toastr.options = {
                closeButton: true,
                progressBar: true,
                positionClass: "toast-top-right",
                timeOut: "3000"
            };

            let currentOrders = [];
            let encMap = {};
            // Legend colour-code filter: narrows the rows already on screen (display only, no re-query).
            let legendStatus = null;
            let activeOrderId = null;
            let currentDetailData = null;
            let currentStatusFilter = '@Model.StatusFilter' || 'All';
            let searchTimeout = null;

            // ── 1. Fetch and Render Orders ──────────────────────────────────
            // silent = auto refresh: keep the current rows on screen (no spinner / blank table / error toast)
            // and resolve to the number of orders that were not in the list before.
            function loadOrders(silent) {
                const prevIds = silent ? new Set(currentOrders.map(o => o.labOrderId)) : null;
                if (!silent) {
                    $('#loadingOrdersState').removeClass('d-none');
                    $('#emptyOrdersState').addClass('d-none');
                    $('#tblReportingOrdersBody').empty();
                }

                const params = {
                    fromDate: $('#txtFromDate').val(),
                    toDate: $('#txtToDate').val(),
                    dateFilterType: $('#selDateFilterType').val(),
                    statusFilter: currentStatusFilter,
                    search: $('#txtSearch').val(),
                    departmentId: $('#ddlDepartment').val() || null,
                    categoryId: $('#ddlCategory').val() || null,
                    subCategoryId: $('#ddlSubCategory').val() || null
                };

                const request = new Promise(function (resolve, reject) {
                    $.get('@Url.Action("GetHeadersJson", "LabReporting")', params)
                        .done(function (res) {
                            $('#loadingOrdersState').addClass('d-none');
                            if (res.success) {
                                currentOrders = res.headers || [];
                                encMap = res.encMap || {};
                                updateStats(res.stats);
                                renderOrdersTable(currentOrders);
                                if (!silent && autoRefresh) autoRefresh.touch();
                                resolve(AutoRefresh.markNewRows(prevIds, currentOrders, o => o.labOrderId, id => '#orderRow_' + id));
                            } else {
                                if (!silent) toastr.error(res.message || 'Failed to load reporting headers.');
                                reject();
                            }
                        })
                        .fail(function () {
                            $('#loadingOrdersState').addClass('d-none');
                            if (!silent) toastr.error('Server error while loading reporting list.');
                            reject();
                        });
                });
                if (!silent) request.catch(function () { /* already reported */ });
                return request;
            }

            function updateStats(stats) {
                if (!stats) return;
                $('#statTotalOrders').text(stats.totalOrders || 0);
                $('#statPendingOrders').text(stats.pendingOrders || 0);
                $('#statDraftOrders').text(stats.draftOrders || 0);
                $('#statEnteredOrders').text(stats.enteredOrders || 0);
                $('#statValidatedOrders').text(stats.validatedOrders || 0);
            }

            function renderOrdersTable(orders) {
                const $tbody = $('#tblReportingOrdersBody');
                $tbody.empty();

                if (!orders || orders.length === 0) {
                    $('#emptyOrdersState').removeClass('d-none');
                    $('#legendEmptyState').addClass('d-none');
                    $('#lblRowCount').text('0 orders');
                    $('#statusLegend .lg-item[data-st]').addClass('is-empty').removeClass('active').find('.lg-count').text('');
                    $('#btnClearLegend').addClass('d-none');
                    return;
                }

                $('#emptyOrdersState').addClass('d-none');
                $('#lblRowCount').text(orders.length + (orders.length === 1 ? ' order' : ' orders'));

                let html = '';
                orders.forEach((o, index) => {
                    const urgentBadge = o.isUrgent
                        ? '<span class="badge bg-danger-subtle text-danger border border-danger-subtle fs-9 ms-1"><i class="bi bi-lightning-fill me-1"></i>Urgent</span>'
                        : '';

                    const sampleBadgeClass = o.sampleCollectionStatus === 'Collected'
                        ? 'bg-success-subtle text-success border border-success-subtle'
                        : 'bg-info-subtle text-info border border-info-subtle';

                    const transferredBadge = o.isTransferred
                        ? `<div class="mt-1"><span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle fs-9" title="Sample transferred from ${escapeHtml(o.sourceBranchName || 'External Branch')}"><i class="bi bi-arrow-left-right me-1"></i>From: ${escapeHtml(o.sourceBranchName || 'Branch')}</span></div>`
                        : '';

                    // B2B-billed order (Franchise / Company): badge with the partner in the tooltip
                    const b2bBadge = o.isB2B
                        ? `<span class="badge fs-9 fw-semibold" style="background:#f5f3ff;color:#6d28d9;border:1px solid #ddd6fe;" title="B2B billing${o.clientName ? ' - ' + escapeHtml((o.clientType === 'FRANCHISE' ? 'Franchise: ' : 'Company: ') + (o.clientCode ? o.clientCode + ' · ' : '') + o.clientName) : ''}"><i class="bi ${o.clientType === 'FRANCHISE' ? 'bi-shop' : 'bi-building'} me-1"></i>B2B</span>`
                        : '';

                    // presentation helpers only - initials, gender tint and the left status rail
                    const initials = (o.patientName || '?').trim().split(/\s+/).filter(w => /[A-Za-z]/.test(w))
                        .slice(-2).map(w => w[0]).join('').toUpperCase() || '?';
                    const genderCls = (o.gender || '').toLowerCase().startsWith('f') ? ' female' : '';
                    // one status token drives the row tint, the left rail and the status badge
                    const st = (o.reportStatusName || '').toLowerCase();
                    const stCls = st.includes('approve')  ? 'st-approved'
                                : st.includes('validat')  ? 'st-validated'
                                : st.includes('reject')   ? 'st-rejected'
                                : st.includes('collect')  ? 'st-recollect'
                                : st.includes('draft') || st.includes('progress') ? 'st-draft'
                                // "Pending Entry" must not fall into the "Report Entry" bucket
                                : st.includes('pending')  ? 'st-pending'
                                : st.includes('entry') || st.includes('entered') || st.includes('submit') ? 'st-entered'
                                : 'st-pending';

                    html += `
                        <tr id="orderRow_${o.labOrderId}" class="${stCls}">
                            <td class="ps-3 text-muted fw-semibold fs-9">${index + 1}</td>
                            <td>
                                <div class="d-flex align-items-center flex-wrap gap-1">
                                    <span class="badge bg-primary text-white lr-mono fs-9">${escapeHtml(o.tokenNo || 'LAB')}</span>
                                    ${b2bBadge}
                                    ${urgentBadge}
                                </div>
                                <div class="fs-9 text-muted lr-mono mt-1">${escapeHtml(o.billNo || '—')}</div>
                                ${transferredBadge}
                            </td>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <span class="lr-avatar${genderCls}">${escapeHtml(initials)}</span>
                                    <div class="min-w-0">
                                        <div class="d-flex align-items-center gap-1">
                                            <span class="fw-semibold text-dark fs-8 text-truncate" title="${escapeHtml(o.patientName)}">${escapeHtml(o.patientName)}</span>
                                            <button type="button" class="btn-audit-info"
                                                    data-laborderid="${o.labOrderId}"
                                                    data-patient="${escapeHtml(o.patientName)}"
                                                    data-bill="${escapeHtml(o.billNo || '—')}"
                                                    title="View audit history for this bill"
                                                    aria-label="View audit history for this bill">
                                                <i class="bi bi-info-circle-fill"></i>
                                            </button>
                                        </div>
                                        <div class="fs-9 text-muted d-flex align-items-center gap-1 mt-0.5">
                                            <span class="badge bg-light text-secondary border lr-mono fw-normal">${escapeHtml(o.patientCode)}</span>
                                            <span>${o.age ? o.age + ' Y' : ''}${o.age && o.gender ? ' · ' : ''}${escapeHtml(o.gender || '')}</span>
                                        </div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <div class="text-dark fs-8"><i class="bi bi-telephone text-muted me-1"></i>${escapeHtml(o.phoneNumber || '—')}</div>
                                <div class="fs-9 text-muted text-truncate" style="max-width: 210px;" title="${escapeHtml(o.emailId || '')}">
                                    <i class="bi bi-envelope me-1"></i>${escapeHtml(o.emailId || '—')}
                                </div>
                            </td>
                            <td>
                                <div class="text-dark fs-8">${formatDate(o.bookingDateTime || o.orderDate)}</div>
                                <div class="fs-9 text-muted"><i class="bi bi-clock me-1"></i>${formatTime(o.bookingDateTime || o.orderDate)}</div>
                            </td>
                            <td class="text-center">
                                <span class="badge ${sampleBadgeClass} fs-9">
                                    <i class="bi bi-eyedropper me-1"></i>${escapeHtml(o.sampleCollectionStatus)}
                                </span>
                                <div class="fs-9 text-muted mt-1">${o.collectedInHouseTests} / ${o.totalInHouseTests} Tests</div>
                            </td>
                            <td class="text-center">
                                <span class="badge st-badge fs-9">
                                    ${escapeHtml(o.reportStatusName)}
                                </span>
                            </td>
                            <td class="text-end pe-3">
                                <a data-permission="LAB.LABREPORTING:ENTRY" href="@Url.Action("Entry", "LabReporting")?q=${encodeURIComponent(encMap[o.labOrderId] || '')}"
                                   target="_blank"
                                   class="btn btn-entry btn-sm py-1 px-2.5 fs-8 d-inline-flex align-items-center"
                                   title="Open Report Entry in a new tab">
                                    <i class="bi bi-pencil-square me-1"></i>Report Entry
                                    <i class="bi bi-box-arrow-up-right ms-1.5 fs-9 text-white-50"></i>
                                </a>
                            </td>
                        </tr>
                    `;
                });

                $tbody.html(html);
                applyLegendFilter();
            }

            // ── Status colour-code filter (legend) ─────────────────────────
            function applyLegendFilter() {
                const $rows = $('#tblReportingOrdersBody tr');
                const total = $rows.length;

                // per-status counts of the rows currently loaded
                $('#statusLegend .lg-item[data-st]').each(function () {
                    const st = $(this).data('st');
                    const n = $rows.filter('.' + st).length;
                    $(this).find('.lg-count').text(n ? ' ' + n : '');
                    $(this).toggleClass('is-empty', n === 0);
                });

                if (legendStatus) {
                    $rows.addClass('d-none').filter('.' + legendStatus).removeClass('d-none');
                } else {
                    $rows.removeClass('d-none');
                }

                $('#statusLegend .lg-item[data-st]').removeClass('active')
                    .filter('[data-st="' + legendStatus + '"]').addClass('active');
                $('#btnClearLegend').toggleClass('d-none', !legendStatus);

                // keep the # column sequential over the rows actually on screen
                let n = 0;
                $rows.not('.d-none').each(function () { $(this).children('td').first().text(++n); });

                const shown = $rows.not('.d-none').length;
                $('#legendEmptyState').toggleClass('d-none', !(legendStatus && shown === 0 && total > 0));
                $('#lblRowCount').text(
                    legendStatus && total > 0
                        ? shown + ' of ' + total + (total === 1 ? ' order' : ' orders')
                        : total + (total === 1 ? ' order' : ' orders'));
            }

            $('#statusLegend').on('click', '.lg-item[data-st]', function () {
                const st = $(this).data('st');
                legendStatus = (legendStatus === st) ? null : st;   // click the active one again to clear
                applyLegendFilter();
            });

            $('#btnClearLegend, #btnClearLegendInline').on('click', function () {
                legendStatus = null;
                applyLegendFilter();
            });

            // ── 2. Filter & Date Handlers ──────────────────────────────────
            $('.stat-card').on('click', function () {
                $('.stat-card').removeClass('active-card');
                $(this).addClass('active-card');
                currentStatusFilter = $(this).data('status');
                loadOrders();
            });

            $('#btnRefreshList').on('click', function () {
                loadOrders();
            });

            $('#txtFromDate, #txtToDate, #selDateFilterType').on('change', function () {
                $('.btn-quick-date').removeClass('active');
                loadOrders();
            });

            $('#txtSearch').on('input', function () {
                clearTimeout(searchTimeout);
                searchTimeout = setTimeout(loadOrders, 350);
            });

            $('.btn-quick-date').on('click', function () {
                $('.btn-quick-date').removeClass('active');
                $(this).addClass('active');
                const range = $(this).data('range');
                const today = new Date();
                let from = new Date();
                let to = new Date();

                if (range === 'today') {
                    from = today;
                    to = today;
                } else if (range === 'yesterday') {
                    from.setDate(today.getDate() - 1);
                    to.setDate(today.getDate() - 1);
                } else if (range === 'week') {
                    from.setDate(today.getDate() - 7);
                    to = today;
                } else if (range === 'month') {
                    from = new Date(today.getFullYear(), today.getMonth(), 1);
                    to = today;
                }

                $('#txtFromDate').val(formatIsoDate(from));
                $('#txtToDate').val(formatIsoDate(to));
                loadOrders();
            });

            // ── 3. Auto-refresh on Window Focus ────────────────────────────
            // When user switches back from the dedicated Entry tab, refresh the list automatically
            $(window).on('focus', function () {
                loadOrders();
            });

            // ── 5. Helper Utilities ────────────────────────────────────────
            function escapeHtml(text) {
                if (!text) return '';
                return String(text)
                    .replace(/&/g, "&amp;")
                    .replace(/</g, "&lt;")
                    .replace(/>/g, "&gt;")
                    .replace(/"/g, "&quot;")
                    .replace(/'/g, "&#039;");
            }

            function formatDate(dt) {
                if (!dt) return '—';
                const d = new Date(dt);
                if (isNaN(d)) return '—';
                return d.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });
            }

            function formatTime(dt) {
                if (!dt) return '';
                const d = new Date(dt);
                if (isNaN(d)) return '';
                return d.toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit', hour12: true });
            }

            function formatIsoDate(d) {
                const year = d.getFullYear();
                const month = String(d.getMonth() + 1).padStart(2, '0');
                const day = String(d.getDate()).padStart(2, '0');
                return `${year}-${month}-${day}`;
            }

            // ── 6. Department, Category & Sub Category Cascading Filters ──
            function checkFilterResetVisibility() {
                var d = $('#ddlDepartment').val();
                var c = $('#ddlCategory').val();
                var s = $('#ddlSubCategory').val();
                if (d || c || s) {
                    $('#btnResetFilters').show();
                } else {
                    $('#btnResetFilters').hide();
                }
            }

            $('#btnResetFilters').on('click', function () {
                $('#ddlDepartment').val('');
                $('#ddlCategory').empty().append('<option value="">-- All Categories --</option>').val('');
                $('#ddlSubCategory').empty().append('<option value="">-- All Sub Categories --</option>').val('');
                $(this).hide();
                loadOrders();
            });

            $('#ddlDepartment').on('change', function () {
                checkFilterResetVisibility();
                var deptId = $(this).val();
                
                var $cat = $('#ddlCategory');
                $cat.empty().append('<option value="">-- All Categories --</option>');
                
                var $subCat = $('#ddlSubCategory');
                $subCat.empty().append('<option value="">-- All Sub Categories --</option>');

                var catUrl = '@Url.Action("GetCategoriesForDropdown", "LabReporting")' + (deptId ? '?departmentId=' + deptId : '');
                $.get(catUrl, function (data) {
                    if (data && data.length) {
                        data.forEach(function (item) {
                            $cat.append(new Option(item.text, item.value));
                        });
                    }
                    $cat.val('');
                    $subCat.val('');
                    loadOrders();
                });
            });

            $('#ddlCategory').on('change', function () {
                checkFilterResetVisibility();
                var catId = $(this).val();
                
                var $subCat = $('#ddlSubCategory');
                $subCat.empty().append('<option value="">-- All Sub Categories --</option>');
                
                var subCatUrl = '@Url.Action("GetSubCategoriesForDropdown", "LabReporting")' + (catId ? '?categoryId=' + catId : '');
                $.get(subCatUrl, function (data) {
                    if (data && data.length) {
                        data.forEach(function (item) {
                            $subCat.append(new Option(item.text, item.value));
                        });
                    }
                    $subCat.val('');
                    loadOrders();
                });
            });

            $('#ddlSubCategory').on('change', function () {
                checkFilterResetVisibility();
                loadOrders();
            });

            checkFilterResetVisibility();

            // Auto refresh (interval remembered per browser); pauses while the tab is hidden or a window is open
            const autoRefresh = AutoRefresh.init({
                mount: '#arMount', key: 'lab-reporting-entry', defaultSeconds: 60,
                refresh: () => loadOrders(true)
            });

            // Initial load
            loadOrders();
        });
    </script>
    <partial name="_FilterAutoSuggest" />
}
