@model Tuple<int, EMR.Web.Models.DTOs.LabReportingItemDto>
@{
    int globalRowIndex = Model.Item1;
    var item = Model.Item2;

    var cTypeLower = (item.ContainerType ?? "").ToLower();
    var sTypeLower = (item.SampleTypeName ?? "").ToLower();
    var capBadgeClass = "cap-badge-grey";

    if (cTypeLower.Contains("yellow") || cTypeLower.Contains("sst") || sTypeLower.Contains("serum")) {
        capBadgeClass = "cap-badge-yellow";
    } else if (cTypeLower.Contains("purple") || cTypeLower.Contains("edta") || sTypeLower.Contains("blood")) {
        capBadgeClass = "cap-badge-purple";
    } else if (cTypeLower.Contains("blue") || cTypeLower.Contains("citrate")) {
        capBadgeClass = "cap-badge-blue";
    } else if (cTypeLower.Contains("grey") || cTypeLower.Contains("gray") || cTypeLower.Contains("fluoride")) {
        capBadgeClass = "cap-badge-grey";
    } else if (cTypeLower.Contains("red") || cTypeLower.Contains("plain")) {
        capBadgeClass = "cap-badge-red";
    } else if (cTypeLower.Contains("green") || cTypeLower.Contains("heparin")) {
        capBadgeClass = "cap-badge-green";
    }

    // Calculated parameter (Lab Master > Lab Formula Component): the value is worked out on the server
    // from the configured formula, so the field is filled in, not typed.
    var formulaTargets = ViewData["FormulaTargets"] as Dictionary<string, EMR.Web.Models.ViewModels.LabFormulaTargetInfo>
                         ?? new Dictionary<string, EMR.Web.Models.ViewModels.LabFormulaTargetInfo>(StringComparer.OrdinalIgnoreCase);
    formulaTargets.TryGetValue(item.TestCode ?? string.Empty, out var formula);
    bool isAutoCalculated = formula != null;
    string formulaHint = formula == null ? "" : "= " + formula.Hint;

    bool isRejectedOrReCollect = item.CollectionstatusID == 3 || item.CollectionstatusID == 4;
    bool hasValue = !isRejectedOrReCollect && !string.IsNullOrWhiteSpace(item.TestValue);
    // No Reference Range configured for this test/patient => result entry is blocked until the range is configured.
    // Values saved before this rule existed stay untouched (so those reports can still be validated / approved).
    bool noRefRange = !item.RefRangeId.HasValue && !hasValue && !isRejectedOrReCollect;
    bool isOrderFullyApproved = (ViewData["IsOrderApproved"] as bool? ?? false);
    bool isApproved = (isOrderFullyApproved || item.ReportStatusId == 5) && hasValue;
    // Transferred out of this branch and approved at the target branch: shown here for viewing / printing only.
    // 'disabled' also keeps the row out of every Submit / Validate / Approve payload the page builds.
    bool isOtherBranch = item.IsReadOnlyForBranch;
    bool isLocked = isOtherBranch || isApproved || (hasValue && item.ReportStatusId >= 2) || isRejectedOrReCollect;
    bool canEditRow = !isOtherBranch && hasValue && !isApproved && !isRejectedOrReCollect && (item.ReportStatusId == 2 || item.ReportStatusId == 3);
    string currentFlag = isRejectedOrReCollect ? "" : (item.AbnormalFlag ?? "");
    string lowValStr = item.LowValue.HasValue ? item.LowValue.Value.ToString(System.Globalization.CultureInfo.InvariantCulture) : "";
    string highValStr = item.HighValue.HasValue ? item.HighValue.Value.ToString(System.Globalization.CultureInfo.InvariantCulture) : "";
}

<td class="ps-3 text-muted fw-bold align-top pt-2.5">@globalRowIndex</td>

<!-- Investigation Column -->
<td class="ps-2 ps-md-3 align-top pt-2.5">
    <div class="fw-bold text-dark fs-7 lh-sm">
        @item.TestName
    </div>
    <div class="fs-9 text-muted mt-1 d-flex align-items-center gap-1.5 flex-wrap">
        <span class="font-monospace text-secondary fw-semibold">@item.TestCode</span>
        <span class="text-secondary">•</span>
        @if (isAutoCalculated)
        {
            <span class="badge bg-purple-subtle text-purple border border-purple-subtle fs-9">Auto-calculated</span>
        }
        else if (!string.IsNullOrWhiteSpace(item.DepartmentName))
        {
            <span class="text-muted">@item.DepartmentName</span>
        }
    </div>
    @if (isRejectedOrReCollect)
    {
        <div class="fs-9 mt-0.5 d-flex align-items-center gap-1">
            @if (item.CollectionstatusID == 3)
            {
                <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle fs-9"><i class="bi bi-arrow-repeat me-1"></i>Re-Collect Pending</span>
            }
            else if (item.CollectionstatusID == 4)
            {
                <span class="badge bg-danger-subtle text-danger border border-danger-subtle fs-9"><i class="bi bi-x-circle me-1"></i>Sample Rejected</span>
            }
            @if (!string.IsNullOrWhiteSpace(item.RejectionReason))
            {
                <span class="text-danger fs-9 text-truncate" style="max-width: 200px;" title="Reason: @item.RejectionReason">(@item.RejectionReason)</span>
            }
        </div>
    }
    @if (!string.IsNullOrWhiteSpace(item.MethodName))
    {
        <div class="fs-9 text-secondary mt-0.5 text-truncate" style="max-width: 250px;" title="Test Method: @item.MethodName">
            <span class="text-muted">Method:</span> @item.MethodName
        </div>
    }
</td>

<!-- Sample / Tube Column -->
<td class="align-top pt-2.5">
    <span class="badge @capBadgeClass border fs-9 fw-semibold">
        <i class="bi bi-droplet-fill me-1"></i>@(item.ContainerType ?? "Standard Tube")
    </span>
    <div class="fs-9 text-muted mt-1 fw-medium">@(item.SampleTypeName ?? "Serum")</div>
</td>

<!-- Reference Range Column -->
<td class="align-top pt-2.5">
    <div class="d-flex align-items-center gap-1.5 flex-wrap">
        <span class="fw-bold text-dark fs-8 font-monospace">
            @(string.IsNullOrWhiteSpace(item.ReferenceRange) ? "—" : item.ReferenceRange)
        </span>
        @if (!string.IsNullOrWhiteSpace(item.SpecialRemarks))
        {
            <i class="bi bi-info-circle text-primary opacity-75 fs-8" 
               role="button" 
               tabindex="0"
               data-bs-toggle="tooltip" 
               data-bs-placement="top" 
               title="@item.SpecialRemarks"></i>
        }
    </div>
</td>

<!-- Unit Column -->
<td class="align-top pt-2.5">
    <span class="fw-semibold text-secondary fs-8">@(string.IsNullOrWhiteSpace(item.UnitName) ? "—" : item.UnitName)</span>
</td>

<!-- Result Value Column -->
<td class="align-top pt-2">
    <div class="d-flex align-items-center gap-1">
        <input type="number"
               step="any"
               data-no-ref-range="@(!item.RefRangeId.HasValue && !hasValue ? "true" : "false")"
               @if (isAutoCalculated)
               {
                   <text>data-formula="@formula!.Expression" data-formula-precision="@formula!.RoundingPrecision" </text>
               }
               class="form-control form-control-sm result-val-numeric-input test-val-input txt-test-val @(hasValue ? "has-value" : "") @(noRefRange ? "no-ref-range" : "") @(isAutoCalculated ? "is-formula bg-light-subtle" : "") @(isLocked ? "is-locked bg-light text-dark" : "")"
               value="@(isRejectedOrReCollect ? "" : (item.TestValue ?? ""))"
               placeholder="@(isRejectedOrReCollect ? "Pending" : (noRefRange ? "N/A" : (isAutoCalculated ? "Calculated" : "Value")))"
               tabindex="@globalRowIndex"
               autocomplete="off"
               title="@(isOtherBranch ? $"Processed at {item.TargetBranchName ?? "the target branch"} - this branch cannot change it" : "")"
               @(isOtherBranch || isRejectedOrReCollect || noRefRange ? "disabled=\"disabled\"" : (isLocked || isAutoCalculated ? "readonly=\"readonly\"" : "")) />
        
        <button type="button" 
                class="btn btn-outline-secondary btn-sm btn-edit-row py-1 px-1.5 shadow-2xs @(canEditRow ? "" : "d-none")" 
                title="Edit Result Value">
            <i class="bi bi-pencil-square text-primary"></i>
        </button>
    </div>
    
    @if (!item.RefRangeId.HasValue && !isRejectedOrReCollect && !hasValue)
    {
        <div class="no-ref-range-msg fs-9 mt-1" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-1"></i>Need to configure Reference Range first
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(formulaHint))
    {
        <div class="fs-9 text-muted font-monospace mt-1 formula-text" style="max-width: 155px; line-height: 1.2;">
            @formulaHint
        </div>
        <div class="fs-9 mt-0.5 formula-note text-warning-emphasis" style="max-width: 155px; line-height: 1.2; display:none;"></div>
        @if (!string.IsNullOrWhiteSpace(formula!.ValidityCondition))
        {
            <div class="fs-9 text-muted mt-0.5" style="max-width: 155px; line-height: 1.2;" title="Validity condition from the formula configuration">
                <i class="bi bi-info-circle me-1"></i>@formula!.ValidityCondition
            </div>
        }
    }
    
    <div class="delta-check-container mt-1 fs-9" style="max-width: 155px; line-height: 1.25; @(string.IsNullOrWhiteSpace(item.PreviousTestValue) ? "display:none;" : "")">
        <div class="delta-prev-label text-muted">
            Previous: <strong>@(item.PreviousTestValue ?? "")</strong> @(item.PreviousUnitSymbol ?? item.UnitName ?? "")
            @if (item.PreviousOrderDate.HasValue)
            {
                <span class="text-secondary">(@item.PreviousOrderDate.Value.ToString("dd MMM"))</span>
            }
        </div>
        <div class="delta-diff-display fw-semibold mt-0.5"></div>
    </div>
</td>

<!-- Flag Column -->
<td class="align-top pt-2.5 text-center">
    @{
        string flagText = "—";
        string flagClass = "flag-none";
        string flagVal = (item.AbnormalFlag ?? "").Trim();
        bool isThresholdTier = item.RangeTier is "Critical Value" or "Panic Value";
        // Direction of a Critical / Panic threshold breach (L / H), "" when the value is within the thresholds.
        string thrDir = "";
        if (hasValue && isThresholdTier && decimal.TryParse(item.TestValue, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out decimal thrVal))
        {
            if (item.LowThreshold.HasValue && thrVal < item.LowThreshold.Value) { thrDir = "L"; }
            else if (item.HighThreshold.HasValue && thrVal > item.HighThreshold.Value) { thrDir = "H"; }
        }
        if (string.IsNullOrEmpty(flagVal) && hasValue && decimal.TryParse(item.TestValue, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out decimal parsedVal))
        {
            if (thrDir.Length > 0) { flagVal = item.RangeTier == "Panic Value" ? "Panic" : "Critical"; }
            else if (item.LowValue.HasValue && parsedVal < item.LowValue.Value) { flagVal = "L"; }
            else if (item.HighValue.HasValue && parsedVal > item.HighValue.Value) { flagVal = "H"; }
            else if (item.LowValue.HasValue || item.HighValue.HasValue) { flagVal = "Normal"; }
        }

        if (flagVal.Equals("L", StringComparison.OrdinalIgnoreCase))
        {
            flagText = "L";
            flagClass = "flag-l";
        }
        else if (flagVal.Equals("H", StringComparison.OrdinalIgnoreCase))
        {
            flagText = "H";
            flagClass = "flag-h";
        }
        else if (flagVal.Equals("Normal", StringComparison.OrdinalIgnoreCase))
        {
            flagText = "Normal";
            flagClass = "flag-normal";
        }
        else if (flagVal.Equals("Critical", StringComparison.OrdinalIgnoreCase))
        {
            flagText = thrDir.Length > 0 ? $"Critical {thrDir}" : "Critical";
            flagClass = "flag-critical";
        }
        else if (flagVal.Equals("Panic", StringComparison.OrdinalIgnoreCase))
        {
            flagText = thrDir.Length > 0 ? $"Panic {thrDir}" : "Panic";
            flagClass = "flag-panic";
        }
    }
    <span class="badge flag-badge @flagClass fs-8 px-2 py-1">@flagText</span>
</td>

<!-- Clinical Remarks / Notes Column -->
<td class="align-top pt-2">
    <input type="text"
           class="form-control form-control-sm fs-8 txt-test-remarks @(isOtherBranch || isApproved || isRejectedOrReCollect ? "bg-light-subtle text-muted" : "")"
           value="@(isRejectedOrReCollect ? "" : (item.Remarks ?? item.SpecialRemarks ?? ""))"
           placeholder="@(isRejectedOrReCollect ? (item.CollectionstatusID == 3 ? "Re-Collect pending" : "Sample Rejected") : "Optional note")"
           title="@(item.SpecialRemarks ?? "Optional interpretation / notes")"
           autocomplete="off"
           @(isOtherBranch || isRejectedOrReCollect ? "disabled=\"disabled\"" : (isApproved ? "readonly=\"readonly\"" : "")) />
</td>

<!-- Status Column -->
<td class="align-top pt-2.5 text-center">
    @{
        string statusText = "Pending entry";
        string statusClass = "bg-secondary-subtle text-secondary border border-secondary-subtle";

        if (item.CollectionstatusID == 3)
        {
            statusText = "Pending (Re-Collect)";
            statusClass = "bg-warning-subtle text-warning-emphasis border border-warning-subtle";
        }
        else if (item.CollectionstatusID == 4)
        {
            statusText = "Pending (Rejected)";
            statusClass = "bg-danger-subtle text-danger border border-danger-subtle";
        }
        else if (hasValue)
        {
            if (item.ReportStatusId == 5)
            {
                statusText = "Approved";
                statusClass = "bg-info-subtle text-info border border-info-subtle";
            }
            else if (item.ReportStatusId == 3)
            {
                statusText = "Validated";
                statusClass = "bg-success-subtle text-success border border-success-subtle";
            }
            else if (item.ReportStatusId == 1)
            {
                statusText = "Draft";
                statusClass = "bg-warning-subtle text-warning border border-warning-subtle";
            }
            else
            {
                statusText = "Entered";
                statusClass = "status-entered";
            }
        }
    }
    @{
        // Stage timestamps (same "dd MMM yyyy, hh:mm tt" format as the banner date pills); null => attribute omitted
        string? StageTime(DateTime? dt) => dt.HasValue ? dt.Value.ToString("dd MMM yyyy, hh:mm tt") : null;
    }
    @if (isOtherBranch)
    {
        <div class="mb-1">
            <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle fs-9"
                  title="The sample was transferred to @(item.TargetBranchName ?? "another branch"), which entered and approved this result. It is read-only here.">
                <i class="bi bi-lock-fill me-1"></i>@(item.TargetBranchName ?? "Other branch")
            </span>
        </div>
    }
    <span class="badge fs-9 row-status-badge @statusClass"
          data-time-drafted="@StageTime(item.DraftedDate)"
          data-time-submitted="@StageTime(item.SubmittedDate)"
          data-time-validated="@StageTime(item.ValidatedDate)"
          data-time-approved="@StageTime(item.ApprovedDate)">
        @statusText
    </span>
</td>
