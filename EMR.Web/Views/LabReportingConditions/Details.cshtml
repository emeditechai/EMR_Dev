@model EMR.Web.ApiClients.Models.LabReportingConditionModel

@{
    ViewData["Title"] = "Condition of Reporting Details";
}

<div class="container-fluid px-4 py-3">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                    <li class="breadcrumb-item text-muted">Lab Master</li>
                    <li class="breadcrumb-item"><a asp-action="Index">Conditions of Reporting</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Details</li>
                </ol>
            </nav>
            <h4 class="fw-bold mb-0 text-primary">
                <i class="bi bi-eye me-2"></i>Condition of Reporting Details
            </h4>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Edit" asp-encrypted-id="@Model.Condition_ID" class="btn btn-primary px-3 shadow-sm">
                <i class="bi bi-pencil me-1"></i> Edit Condition
            </a>
            <a asp-action="Index" class="btn btn-outline-secondary px-3">
                <i class="bi bi-arrow-left me-1"></i> Back to List
            </a>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-primary text-white p-3">
                    <h5 class="card-title mb-0 fw-semibold">
                        <i class="bi bi-file-earmark-ruled me-2"></i>@Model.Condition_Code
                    </h5>
                </div>
                <div class="card-body p-4">
                    <div class="row g-4">
                        <div class="col-md-6">
                            <label class="text-muted small fw-semibold text-uppercase d-block mb-1">Condition Code</label>
                            <span class="fw-bold text-dark fs-5 font-monospace">@Model.Condition_Code</span>
                        </div>
                        <div class="col-md-6">
                            <label class="text-muted small fw-semibold text-uppercase d-block mb-1">Applies To</label>
                            @if (Model.Branch_ID.HasValue)
                            {
                                <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle px-3 py-2 fs-6">
                                    <i class="bi bi-building me-1"></i>@Model.Branch_Name@(string.IsNullOrWhiteSpace(Model.Branch_Code) ? "" : $" ({Model.Branch_Code})")
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-light text-muted border px-3 py-2 fs-6">
                                    <i class="bi bi-globe me-1"></i>All Branches (company-wide)
                                </span>
                            }
                        </div>
                        <div class="col-12">
                            <label class="text-muted small fw-semibold text-uppercase d-block mb-1">Condition Text</label>
                            <div class="border rounded-3 p-3 bg-light" style="white-space: pre-wrap;">@Model.Condition_Text</div>
                        </div>
                        <div class="col-md-6">
                            <label class="text-muted small fw-semibold text-uppercase d-block mb-1">Display Order</label>
                            <span class="badge bg-secondary rounded-pill px-3">@Model.Display_Order</span>
                        </div>
                        <div class="col-md-6">
                            <label class="text-muted small fw-semibold text-uppercase d-block mb-1">Status</label>
                            @if (Model.Status)
                            {
                                <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-1 rounded-pill"><i class="bi bi-check-circle-fill me-1"></i>Active</span>
                            }
                            else
                            {
                                <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-3 py-1 rounded-pill"><i class="bi bi-x-circle-fill me-1"></i>Inactive</span>
                            }
                        </div>
                    </div>
                    <hr class="my-4" />
                    <div class="row g-3 text-muted small">
                        <div class="col-md-6">Created: @Model.CreatedDate.ToString("dd MMM yyyy, hh:mm tt")</div>
                        <div class="col-md-6">Last modified: @(Model.ModifiedDate.HasValue ? Model.ModifiedDate.Value.ToString("dd MMM yyyy, hh:mm tt") : "—")</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
