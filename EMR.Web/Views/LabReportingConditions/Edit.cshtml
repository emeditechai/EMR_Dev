@model EMR.Web.Models.ViewModels.LabReportingConditionFormViewModel

@{
    ViewData["Title"] = "Edit Condition of Reporting";
}

<div class="container-fluid px-4 py-3">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                    <li class="breadcrumb-item text-muted">Lab Master</li>
                    <li class="breadcrumb-item"><a asp-action="Index">Conditions of Reporting</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Edit</li>
                </ol>
            </nav>
            <h4 class="fw-bold mb-0 text-primary">
                <i class="bi bi-pencil-square me-2"></i>Edit Condition of Reporting
            </h4>
        </div>
        <div>
            <a asp-action="Index" class="btn btn-outline-secondary px-3">
                <i class="bi bi-arrow-left me-1"></i> Back to List
            </a>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white py-3 border-bottom">
                    <h6 class="card-title fw-bold mb-0 text-dark">
                        <i class="bi bi-file-earmark-ruled me-2 text-primary"></i>Condition @Model.Condition_Code
                    </h6>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Edit" asp-encrypted-id="@Model.Condition_ID" method="post">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4" role="alert"></div>
                        <input type="hidden" asp-for="Condition_ID" />
                        <input type="hidden" asp-for="CompanyId" />

                        <partial name="_ConditionFormFields" model="Model" view-data="@(new ViewDataDictionary(ViewData) { { "IsEdit", true } })" />

                        <hr class="my-4" />

                        <div class="d-flex justify-content-end gap-2">
                            <a asp-action="Index" class="btn btn-outline-secondary px-4"><i class="bi bi-x-lg me-1"></i> Cancel</a>
                            <button type="submit" class="btn btn-primary px-4 shadow-sm"><i class="bi bi-save me-1"></i> Update Condition</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var txt = document.getElementById('Condition_Text');
            var counter = document.getElementById('conditionTextCount');
            if (txt && counter) {
                var update = function () { counter.textContent = txt.value.length; };
                txt.addEventListener('input', update);
                update();
            }
        });
    </script>
}
