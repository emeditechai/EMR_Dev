@model EMR.Web.Models.ViewModels.LabReportingConditionIndexViewModel

@{
    ViewData["Title"] = "Conditions of Reporting";
}

<div class="container-fluid px-4 py-3">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                    <li class="breadcrumb-item text-muted">Lab Master</li>
                    <li class="breadcrumb-item active" aria-current="page">Conditions of Reporting</li>
                </ol>
            </nav>
            <h4 class="fw-bold mb-0 text-primary">
                <i class="bi bi-file-earmark-ruled me-2"></i>Conditions of Reporting
            </h4>
        </div>
        <div>
            <a asp-action="Create" class="btn btn-primary px-3 shadow-sm">
                <i class="bi bi-plus-lg me-1"></i> Add New Condition
            </a>
        </div>
    </div>

    <!-- KPI cards (whole company) -->
    <div class="row g-3 mb-4">
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm h-100"><div class="card-body p-3 d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small fw-semibold text-uppercase d-block">Total Conditions</span>
                    <h3 class="fw-bold mb-0 text-primary">@Model.TotalCount</h3>
                    <span class="badge bg-success-subtle text-success mt-1">@Model.ActiveCount Active</span>
                </div>
                <div class="bg-primary text-white rounded-3 p-3 shadow-sm d-flex align-items-center justify-content-center" style="width:48px;height:48px;"><i class="bi bi-file-earmark-ruled fs-4"></i></div>
            </div></div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm h-100"><div class="card-body p-3 d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small fw-semibold text-uppercase d-block">Company-wide</span>
                    <h3 class="fw-bold mb-0 text-info">@Model.CompanyWideCount</h3>
                    <span class="badge bg-info-subtle text-info-emphasis mt-1">All branches</span>
                </div>
                <div class="bg-info text-white rounded-3 p-3 shadow-sm d-flex align-items-center justify-content-center" style="width:48px;height:48px;"><i class="bi bi-globe fs-4"></i></div>
            </div></div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm h-100"><div class="card-body p-3 d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small fw-semibold text-uppercase d-block">Branch-specific</span>
                    <h3 class="fw-bold mb-0 text-warning">@Model.BranchSpecificCount</h3>
                    <span class="badge bg-warning-subtle text-warning-emphasis mt-1">@Model.BranchesWithOwnSet branch(es) with own set</span>
                </div>
                <div class="bg-warning text-dark rounded-3 p-3 shadow-sm d-flex align-items-center justify-content-center" style="width:48px;height:48px;"><i class="bi bi-building fs-4"></i></div>
            </div></div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm h-100 border-start border-4 border-success"><div class="card-body p-3">
                <span class="text-muted small fw-semibold text-uppercase d-block mb-1"><i class="bi bi-info-circle me-1"></i>How it applies</span>
                <div class="small text-secondary lh-sm">A branch with its own <b>active</b> conditions prints only those. Otherwise the <b>company-wide</b> ones print on its Lab Report.</div>
            </div></div>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Filter Card -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-3">
            <form method="get" asp-action="Index" class="row g-3 align-items-end">
                <div class="col-md-4">
                    <label class="form-label small fw-semibold text-muted">Applies To</label>
                    <select name="branchScope" class="form-select" asp-items="Model.BranchScopeOptions">
                        <option value="">-- All Scopes --</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-semibold text-muted">Status</label>
                    <select name="status" class="form-select" asp-items="Model.StatusOptions">
                        <option value="">-- All Statuses --</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-semibold text-muted">Search</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
                        <input type="text" name="search" class="form-control border-start-0" value="@Model.SearchTerm" placeholder="Code, text or branch..." />
                    </div>
                </div>
                <div class="col-md-2 d-flex gap-2">
                    <button type="submit" class="btn btn-secondary w-100 fw-semibold"><i class="bi bi-funnel me-1"></i> Filter</button>
                    <a asp-action="Index" class="btn btn-outline-secondary" title="Reset Filters"><i class="bi bi-arrow-counterclockwise"></i></a>
                </div>
            </form>
        </div>
    </div>

    <!-- Data Table Card -->
    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light border-bottom">
                        <tr>
                            <th class="ps-4" style="width: 110px;">Code</th>
                            <th>Condition Text</th>
                            <th style="width: 220px;">Applies To</th>
                            <th class="text-center" style="width: 110px;">Display Order</th>
                            <th class="text-center" style="width: 120px;">Status</th>
                            <th class="text-end pe-4" style="width: 180px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Conditions.Any())
                        {
                            <tr>
                                <td colspan="6" class="text-center py-5 text-muted">
                                    <i class="bi bi-inbox display-6 d-block mb-2 text-secondary"></i>
                                    No Conditions of Reporting found matching your search criteria.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model.Conditions)
                            {
                                <tr>
                                    <td class="ps-4 fw-semibold font-monospace text-muted">@item.Condition_Code</td>
                                    <td class="text-dark" style="max-width: 520px; white-space: normal;">@item.Condition_Text</td>
                                    <td>
                                        @if (item.Branch_ID.HasValue)
                                        {
                                            <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle px-2 py-1">
                                                <i class="bi bi-building me-1"></i>@item.Branch_Name
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-light text-muted border px-2 py-1"><i class="bi bi-globe me-1"></i>All Branches</span>
                                        }
                                    </td>
                                    <td class="text-center"><span class="badge bg-secondary rounded-pill px-3">@item.Display_Order</span></td>
                                    <td class="text-center">
                                        <form asp-action="ToggleStatus" asp-encrypted-id="@item.Condition_ID" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="status" value="@(!item.Status ? "true" : "false")" />
                                            <button type="submit" class="btn btn-link p-0 text-decoration-none" title="Click to toggle status">
                                                @if (item.Status)
                                                {
                                                    <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-1 rounded-pill"><i class="bi bi-check-circle-fill me-1"></i>Active</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-3 py-1 rounded-pill"><i class="bi bi-x-circle-fill me-1"></i>Inactive</span>
                                                }
                                            </button>
                                        </form>
                                    </td>
                                    <td class="text-end pe-4">
                                        <div class="btn-group btn-group-sm shadow-sm" role="group">
                                            <a asp-action="Details" asp-encrypted-id="@item.Condition_ID" class="btn btn-outline-info" title="View Details"><i class="bi bi-eye"></i></a>
                                            <a asp-action="Edit" asp-encrypted-id="@item.Condition_ID" class="btn btn-outline-primary" title="Edit Condition"><i class="bi bi-pencil"></i></a>
                                            <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteModal-@item.Condition_ID" title="Delete"><i class="bi bi-trash"></i></button>
                                        </div>

                                        <div class="modal fade text-start" id="deleteModal-@item.Condition_ID" tabindex="-1" aria-hidden="true">
                                            <div class="modal-dialog modal-dialog-centered">
                                                <div class="modal-content">
                                                    <div class="modal-header bg-danger text-white">
                                                        <h5 class="modal-title"><i class="bi bi-exclamation-triangle-fill me-2"></i>Confirm Delete</h5>
                                                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                                                    </div>
                                                    <div class="modal-body">
                                                        Are you sure you want to delete condition <strong>@item.Condition_Code</strong>?
                                                        <p class="mt-2 text-muted small border-start border-3 border-danger ps-2">@item.Condition_Text</p>
                                                    </div>
                                                    <div class="modal-footer">
                                                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                                        <form asp-action="Delete" asp-encrypted-id="@item.Condition_ID" method="post">
                                                            @Html.AntiForgeryToken()
                                                            <button type="submit" class="btn btn-danger">Delete Condition</button>
                                                        </form>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
