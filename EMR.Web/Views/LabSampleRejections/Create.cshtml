@model EMR.Web.Models.ViewModels.LabSampleRejectionFormViewModel

@{
    ViewData["Title"] = "Add Sample Rejection Reason";
}

<div class="container-fluid px-4 py-3">
    <!-- Breadcrumb & Header -->
    <div class="mb-4">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                <li class="breadcrumb-item text-muted">Lab Master</li>
                <li class="breadcrumb-item"><a asp-action="Index">Sample Rejection Master</a></li>
                <li class="breadcrumb-item active" aria-current="page">Add New</li>
            </ol>
        </nav>
        <h4 class="fw-bold mb-0 text-primary">
            <i class="bi bi-plus-circle me-2"></i>Add New Sample Rejection Reason
        </h4>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-primary text-white p-3">
                    <h5 class="card-title mb-0 fw-semibold">
                        <i class="bi bi-x-circle me-2"></i>Sample Rejection Information
                    </h5>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Create" method="post">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4" role="alert"></div>

                        <div class="row g-3">
                            <div class="col-md-12">
                                <label asp-for="Rejection_Reason" class="form-label fw-semibold required-field"></label>
                                <input asp-for="Rejection_Reason" class="form-control" placeholder="e.g. Hemolyzed Sample, Insufficient Volume, Clotted Sample" />
                                <span asp-validation-for="Rejection_Reason" class="text-danger small"></span>
                            </div>

                            <div class="col-md-12">
                                <label asp-for="Description" class="form-label fw-semibold"></label>
                                <textarea asp-for="Description" class="form-control" rows="3" placeholder="Additional details or guidelines regarding this rejection reason..."></textarea>
                                <span asp-validation-for="Description" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Display_Order" class="form-label fw-semibold required-field"></label>
                                <input asp-for="Display_Order" type="number" class="form-control" min="1" max="99999" />
                                <span asp-validation-for="Display_Order" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6 d-flex align-items-end">
                                <div class="form-check form-switch mb-2">
                                    <input asp-for="Status" class="form-check-input" type="checkbox" role="switch" id="statusSwitch">
                                    <label class="form-check-label fw-semibold" for="statusSwitch">Active Status</label>
                                </div>
                            </div>
                        </div>

                        <hr class="my-4" />

                        <div class="d-flex justify-content-end gap-2">
                            <a asp-action="Index" class="btn btn-outline-secondary px-4">
                                <i class="bi bi-x-lg me-1"></i> Cancel
                            </a>
                            <button type="submit" class="btn btn-primary px-4 shadow-sm">
                                <i class="bi bi-save me-1"></i> Save Rejection Reason
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
