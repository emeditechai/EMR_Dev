@* Utility > API data: header and the links between its pages (SQLScripts/2316) *@
@{
    var active = ViewData["ApiDataPage"] as string ?? "";
    var items = new[]
    {
        ("Releases", "Terminology Import", "bi-cloud-arrow-down", "UTILITY.APIDATA.RELEASES:VIEW"),
        ("Search", "Standard Test Search", "bi-search", "UTILITY.APIDATA.SEARCH:VIEW"),
        ("Mapping", "Investigation Mapping", "bi-diagram-3", "UTILITY.APIDATA.MAPPING:VIEW"),
        ("Changes", "Release Changes", "bi-arrow-left-right", "UTILITY.APIDATA.CHANGES:VIEW")
    };
}
<style>
    .ad-head h4 { font-weight: 800; }
    .ad-nav { display: flex; flex-wrap: wrap; gap: .4rem; }
    .ad-nav a { display: inline-flex; align-items: center; gap: .4rem; padding: .45rem .85rem; border-radius: .6rem; font-weight: 600; font-size: .85rem;
                text-decoration: none; color: #334155; background: #fff; border: 1px solid #e2e8f0; }
    .ad-nav a.active { background: #1d4ed8; border-color: #1d4ed8; color: #fff; }
    .ad-nav a:hover:not(.active) { background: #eff6ff; border-color: #bfdbfe; }
    .ad-note { font-size: .8rem; color: #64748b; }
    .ad-kpi { border: 0; border-left: 4px solid var(--k); border-radius: .75rem; }
    .ad-kpi .num { font-size: 1.6rem; font-weight: 800; line-height: 1; color: var(--k); font-variant-numeric: tabular-nums; }
    .ad-kpi .lbl { font-size: .72rem; font-weight: 700; text-transform: uppercase; letter-spacing: .05em; color: #64748b; }
    .ad-table thead th { background: #f8fafc; font-size: .72rem; text-transform: uppercase; letter-spacing: .05em; color: #64748b; font-weight: 700; white-space: nowrap; }
    .ad-table td { font-size: .86rem; vertical-align: middle; }
    .ad-code { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-weight: 700; color: #1d4ed8; white-space: nowrap; }
    .ad-pill { display: inline-block; font-size: .7rem; font-weight: 700; padding: .15rem .55rem; border-radius: 1rem; border: 1px solid transparent; white-space: nowrap; }
    .ad-pill.green { background: #dcfce7; color: #166534; border-color: #bbf7d0; }
    .ad-pill.amber { background: #fef3c7; color: #92400e; border-color: #fde68a; }
    .ad-pill.red { background: #fee2e2; color: #991b1b; border-color: #fecaca; }
    .ad-pill.blue { background: #dbeafe; color: #1e40af; border-color: #bfdbfe; }
    .ad-pill.grey { background: #f1f5f9; color: #475569; border-color: #e2e8f0; }
    .ad-pill.violet { background: #ede9fe; color: #5b21b6; border-color: #ddd6fe; }
    .ad-attr { font-size: .78rem; color: #475569; }
    .ad-attr b { color: #0f172a; font-weight: 600; }
</style>
<div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-3 ad-head">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                <li class="breadcrumb-item text-muted">Utility</li>
                <li class="breadcrumb-item text-muted">API data</li>
                <li class="breadcrumb-item active" aria-current="page">@ViewData["Title"]</li>
            </ol>
        </nav>
        <h4 class="mb-0 text-primary"><i class="bi bi-database-gear me-2"></i>@ViewData["Title"]</h4>
        <div class="ad-note mt-1"><i class="bi bi-shield-check me-1 text-success"></i>Standard Laboratory Test Master (LOINC) - kept separate from your Investigation Master, which is only read here.</div>
    </div>
    <div class="ad-nav">
        @foreach (var (action, title, icon, perm) in items)
        {
            <a asp-permission="@perm" asp-action="@action" class="@(active == action ? "active" : "")"><i class="bi @icon"></i>@title</a>
        }
    </div>
</div>
