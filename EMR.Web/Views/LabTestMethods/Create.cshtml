@model EMR.Web.Models.ViewModels.LabTestMethodFormViewModel

@{
    ViewData["Title"] = "Create Test Method";
}

<div class="container-fluid px-4 py-3">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                    <li class="breadcrumb-item text-muted">Lab Master</li>
                    <li class="breadcrumb-item"><a asp-action="Index">Test Method Master</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Create</li>
                </ol>
            </nav>
            <h4 class="fw-bold mb-0 text-primary">
                <i class="bi bi-plus-circle me-2"></i>Create New Test Method
            </h4>
        </div>
        <div>
            <a asp-action="Index" class="btn btn-outline-secondary px-3">
                <i class="bi bi-arrow-left me-1"></i> Back to List
            </a>
        </div>
    </div>

    <!-- Form Card -->
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white py-3 border-bottom">
                    <h6 class="card-title fw-bold mb-0 text-dark">
                        <i class="bi bi-card-heading me-2 text-primary"></i>Method Details
                    </h6>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Create" method="post" id="createMethodForm">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4" role="alert"></div>

                        <div class="row g-3">
                            <!-- Method Code (Auto-generated note - First Position) -->
                            <div class="col-md-6">
                                <label class="form-label fw-semibold text-muted">Method Code</label>
                                <input type="text" class="form-control bg-light" value="Auto-generated on save (e.g. MTH0001)" disabled />
                                <small class="text-muted">Unique code automatically assigned sequentially.</small>
                            </div>

                            <!-- Department ID Dropdown -->
                            <div class="col-md-6">
                                <label asp-for="Department_ID" class="form-label fw-semibold">
                                    Department <span class="text-danger">*</span>
                                </label>
                                <select asp-for="Department_ID" class="form-select" asp-items="Model.DepartmentOptions" required>
                                    <option value="">-- Select Department --</option>
                                </select>
                                <span asp-validation-for="Department_ID" class="text-danger small"></span>
                            </div>

                            <!-- Method Name -->
                            <div class="col-md-12">
                                <label asp-for="Method_Name" class="form-label fw-semibold">
                                    Method Name <span class="text-danger">*</span>
                                </label>
                                <input asp-for="Method_Name" class="form-control" placeholder="e.g., Spectrophotometry, ELISA, PCR" required maxlength="150" />
                                <span asp-validation-for="Method_Name" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- Form Actions -->
                        <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                            <a asp-action="Index" class="btn btn-light border px-4">Cancel</a>
                            <button type="submit" class="btn btn-primary px-4 fw-semibold shadow-sm">
                                <i class="bi bi-save me-1"></i> Save Method
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
