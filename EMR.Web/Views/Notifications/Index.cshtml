@{
    ViewData["Title"] = "Notifications";
}
@* All of the signed-in user's notifications (SQLScripts/2263); rows, reading and removing come from wwwroot/js/notifications.js *@
<div class="container-fluid py-3" style="max-width: 900px;">
    <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
        <div>
            <h4 class="mb-0 fw-bold"><i class="bi bi-bell me-2 text-primary"></i>Notifications</h4>
            <div class="text-muted small">Messages sent to you by the system. Only you can see them.</div>
        </div>
        <div class="ms-auto d-flex gap-2">
            <div class="btn-group btn-group-sm" role="group" aria-label="Filter">
                <button type="button" class="btn btn-outline-primary active" data-filter="all">All</button>
                <button type="button" class="btn btn-outline-primary" data-filter="unread">Unread <span class="badge bg-danger ms-1 d-none" id="pgUnread"></span></button>
            </div>
            <button type="button" class="btn btn-sm btn-outline-secondary" id="pgReadAll"><i class="bi bi-check2-all me-1"></i>Mark all as read</button>
        </div>
    </div>
    <div class="card border-0 shadow-sm overflow-hidden">
        <div id="pgList"><div class="emr-bell-empty">Loading…</div></div>
        <div class="text-center p-2 border-top d-none" id="pgMoreWrap">
            <button type="button" class="btn btn-sm btn-link text-decoration-none" id="pgMore">Load older notifications</button>
        </div>
    </div>
</div>

@section Scripts {
<script src="~/js/views/Notifications/Index.js" asp-append-version="true"></script>
}
