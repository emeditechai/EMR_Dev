@{
    // Settings > Notification Languages (SQLScripts/2543): patient notification texts per language. js/views/NotifyTemplates/notify-templates.js
    ViewData["Title"] = "Notification Languages";
    bool canEdit = ViewData["CanEDIT"] as bool? ?? false;
}
@section HeadStyles { <link rel="stylesheet" href="~/css/ipd.css" asp-append-version="true" /> }
@Html.AntiForgeryToken()
<div class="ipdx-section-head mb-3">
    <div><h2 class="fs-4"><i class="bi bi-translate me-2 text-primary"></i>Notification Languages</h2>
        <p>Patients get their WhatsApp and e-mail messages in the language chosen on their registration (<b>Language</b> field).
           <b>English</b> messages stay as set in WhatsApp Configuration and the built-in e-mails; add the text of other languages here.
           A patient whose language has no text here gets the English message.</p></div>
    <div class="d-flex gap-2 align-items-center">
        <select id="fEvent" class="form-select form-select-sm" style="width:auto"></select>
        @if (canEdit) { <button type="button" class="btn btn-sm btn-primary" id="add"><i class="bi bi-plus-circle me-1"></i>Add text</button> }
    </div>
</div>
<div class="alert alert-light border small" id="evInfo"></div>
<div class="reg-section"><div class="reg-section-body p-0"><div class="table-responsive"><table class="table ipd-table table-hover mb-0">
    <thead><tr><th>Language</th><th>Channel</th><th>Branch</th><th>Text</th><th>Status</th><th>Changed</th><th></th></tr></thead>
    <tbody id="rows"><tr><td colspan="7" class="text-muted small p-3">Loading…</td></tr></tbody></table></div></div></div>
@section Scripts {
    <script src="~/js/ipd.js" asp-append-version="true"></script>
    <script>window.NotifyPage = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(new { @base = Url.Content("~/NotifyTemplates/"), canEdit }));</script>
    <script src="~/js/views/NotifyTemplates/notify-templates.js" asp-append-version="true"></script>
}
