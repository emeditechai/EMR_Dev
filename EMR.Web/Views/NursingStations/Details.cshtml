@model EMR.Web.Models.ViewModels.NursingStationDetailsViewModel
@{
    ViewData["Title"] = $"{Model.StationName} - Details";
}

<div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-2">
    <div class="d-flex align-items-center gap-2">
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left"></i></a>
        <div>
            <h1 class="h3 mb-0 fw-bold">@Model.StationName</h1>
            <small class="text-muted">Station Code: <strong class="font-monospace text-primary">@Model.StationCode</strong></small>
        </div>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.NursingStationId" class="btn btn-outline-primary btn-sm px-3">
            <i class="bi bi-pencil me-1"></i> Edit Station
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm px-3">
            <i class="bi bi-list me-1"></i> All Stations
        </a>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-header bg-white border-bottom py-3">
                <h6 class="mb-0 fw-bold text-primary"><i class="bi bi-person-workspace me-2"></i>Nursing Station Overview</h6>
            </div>
            <div class="card-body p-4">
                <div class="row g-4">
                    <div class="col-md-6">
                        <p class="text-muted small mb-1 text-uppercase fw-semibold">Station Code</p>
                        <p class="fw-bold font-monospace fs-5 mb-0">
                            <span class="badge text-bg-light border text-dark">@Model.StationCode</span>
                        </p>
                    </div>
                    <div class="col-md-6">
                        <p class="text-muted small mb-1 text-uppercase fw-semibold">Parent Ward</p>
                        <p class="fw-semibold fs-5 mb-0">
                            <a asp-controller="Wards" asp-action="Details" asp-route-id="@Model.WardId" class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 text-decoration-none px-3 py-2">
                                <i class="bi bi-hospital me-1"></i>@Model.WardName (@Model.WardCode)
                            </a>
                        </p>
                    </div>

                    <div class="col-md-6">
                        <p class="text-muted small mb-1 text-uppercase fw-semibold">Floor & Building Location</p>
                        <p class="fw-semibold fs-5 mb-0 text-dark">
                            <i class="bi bi-layers text-primary me-2"></i>@Model.FloorName
                            @if (!string.IsNullOrWhiteSpace(Model.BuildingName))
                            {
                                <small class="text-muted">(@Model.BuildingName)</small>
                            }
                        </p>
                    </div>
                    <div class="col-md-6">
                        <p class="text-muted small mb-1 text-uppercase fw-semibold">Responsible In-Charge Nurse</p>
                        @if (!string.IsNullOrWhiteSpace(Model.ResponsibleNurse))
                        {
                            <span class="badge bg-info bg-opacity-10 text-info border border-info border-opacity-25 fs-6 px-3 py-2">
                                <i class="bi bi-person-badge-fill me-1"></i>@Model.ResponsibleNurse
                            </span>
                        }
                        else
                        {
                            <span class="text-muted">No Nurse assigned</span>
                        }
                    </div>

                    <div class="col-md-6">
                        <p class="text-muted small mb-1 text-uppercase fw-semibold">Status</p>
                        @if (Model.IsActive)
                        {
                            <span class="badge text-bg-success px-3 py-2">Active Station</span>
                        }
                        else
                        {
                            <span class="badge text-bg-secondary px-3 py-2">Inactive</span>
                        }
                    </div>

                    <div class="col-12">
                        <p class="text-muted small mb-1 text-uppercase fw-semibold">Description / Counter Notes</p>
                        <p class="text-dark bg-light p-3 rounded-2 mb-0">
                            @(string.IsNullOrWhiteSpace(Model.Description) ? "No description provided." : Model.Description)
                        </p>
                    </div>

                    <div class="col-12 pt-3 border-top text-muted small d-flex justify-content-between flex-wrap gap-2">
                        <div>Created: @Model.CreatedDate.ToString("dd MMM yyyy, HH:mm")</div>
                        @if (Model.ModifiedDate.HasValue)
                        {
                            <div>Last Modified: @Model.ModifiedDate.Value.ToString("dd MMM yyyy, HH:mm")</div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
