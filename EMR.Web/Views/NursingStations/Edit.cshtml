@model EMR.Web.Models.ViewModels.NursingStationFormViewModel
@{
    ViewData["Title"] = "Edit Nursing Station";
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h1 class="h3 mb-0 fw-bold">Edit Nursing Station</h1>
        <small class="text-muted">Update nursing station details and ward assignment</small>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm px-3">
        <i class="bi bi-arrow-left me-1"></i> Back to List
    </a>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-header bg-white border-bottom py-3">
                <h6 class="mb-0 fw-bold text-primary"><i class="bi bi-pencil-square me-2"></i>Edit Nursing Station Details</h6>
            </div>
            <div class="card-body p-4">
                <form asp-action="Edit" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="NursingStationId" />
                    <input type="hidden" asp-for="CompanyId" />
                    <input type="hidden" asp-for="BranchId" />

                    <div class="row g-3">
                        <!-- Ward Dropdown -->
                        <div class="col-12">
                            <label asp-for="WardId" class="form-label fw-semibold required-label">
                                Parent Ward <span class="text-danger">*</span>
                            </label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="bi bi-hospital text-muted"></i></span>
                                <select asp-for="WardId" asp-items="Model.WardOptions" class="form-select" required>
                                    <option value="">-- Select Ward --</option>
                                </select>
                            </div>
                            <span asp-validation-for="WardId" class="text-danger small d-block mt-1"></span>
                        </div>

                        <!-- Station Code -->
                        <div class="col-md-5">
                            <label asp-for="StationCode" class="form-label fw-semibold required-label">
                                Station Code <span class="text-danger">*</span>
                            </label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="bi bi-qr-code text-muted"></i></span>
                                <input asp-for="StationCode" class="form-control text-uppercase font-monospace"
                                       maxlength="50" placeholder="e.g. NS-GW1" required
                                       oninput="this.value=this.value.toUpperCase()" />
                            </div>
                            <span asp-validation-for="StationCode" class="text-danger small d-block mt-1"></span>
                        </div>

                        <!-- Station Name -->
                        <div class="col-md-7">
                            <label asp-for="StationName" class="form-label fw-semibold required-label">
                                Station Name <span class="text-danger">*</span>
                            </label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="bi bi-person-workspace text-muted"></i></span>
                                <input asp-for="StationName" class="form-control"
                                       maxlength="150" placeholder="e.g. Nursing Station 1 - Med Ward A" required />
                            </div>
                            <span asp-validation-for="StationName" class="text-danger small d-block mt-1"></span>
                        </div>

                        <!-- Responsible Nurse (Dropdown) -->
                        <div class="col-12">
                            <label asp-for="ResponsibleNurse" class="form-label fw-semibold">
                                Responsible In-Charge Nurse
                            </label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="bi bi-person-badge text-muted"></i></span>
                                <select asp-for="ResponsibleNurse" asp-items="Model.NurseOptions" class="form-select">
                                    <option value="">-- Select In-Charge Nurse (Optional) --</option>
                                </select>
                            </div>
                            <span asp-validation-for="ResponsibleNurse" class="text-danger small d-block mt-1"></span>
                        </div>

                        <!-- Description -->
                        <div class="col-12">
                            <label asp-for="Description" class="form-label fw-semibold">Description / Desk Notes</label>
                            <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>

                        <!-- Status -->
                        <div class="col-12">
                            <label class="form-label fw-semibold">Status</label>
                            <div class="form-check form-switch p-2 border rounded bg-light">
                                <input class="form-check-input ms-0 me-2" type="checkbox" role="switch" asp-for="IsActive">
                                <label class="form-check-label fw-semibold" asp-for="IsActive">Active Nursing Station</label>
                            </div>
                        </div>
                    </div>

                    <hr class="my-4" />

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-outline-secondary px-3">Cancel</a>
                        <button type="submit" class="btn btn-primary px-4 shadow-sm">
                            <i class="bi bi-floppy-fill me-1"></i> Update Nursing Station
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
