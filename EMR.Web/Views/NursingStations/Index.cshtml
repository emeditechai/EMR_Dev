@model IEnumerable<EMR.Web.Models.ViewModels.NursingStationListItemViewModel>
@{
    ViewData["Title"] = "Nursing Station Master";
    var total = Model.Count();
    var active = Model.Count(x => x.IsActive);
    var inactive = total - active;
    var wardsCount = Model.Select(x => x.WardId).Distinct().Count();
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h1 class="h3 mb-0 fw-bold">Nursing Station Master</h1>
        <small class="text-muted">Manage inpatient ward nursing stations, desk counters, and in-charge supervisory assignments</small>
    </div>
    <div class="d-flex gap-2">
        <a asp-controller="Wards" asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-hospital me-1"></i>Ward Master
        </a>
        <a asp-action="Create" asp-route-wardId="@ViewBag.WardId" class="btn btn-primary shadow-sm">
            <i class="bi bi-plus-lg me-1"></i>Add Nursing Station
        </a>
    </div>
</div>

<!-- Stat Cards -->
<div class="row g-3 mb-4">
    <div class="col-12 col-sm-6 col-lg-3">
        <div class="stat-card stat-blue">
            <div class="stat-icon"><i class="bi bi-person-workspace"></i></div>
            <div>
                <div class="stat-value">@total</div>
                <div class="stat-label">Total Stations</div>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-lg-3">
        <div class="stat-card stat-green">
            <div class="stat-icon"><i class="bi bi-check-circle-fill"></i></div>
            <div>
                <div class="stat-value">@active</div>
                <div class="stat-label">Active Stations</div>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-lg-3">
        <div class="stat-card stat-red">
            <div class="stat-icon"><i class="bi bi-x-circle-fill"></i></div>
            <div>
                <div class="stat-value">@inactive</div>
                <div class="stat-label">Inactive</div>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-lg-3">
        <div class="stat-card stat-cyan">
            <div class="stat-icon"><i class="bi bi-hospital"></i></div>
            <div>
                <div class="stat-value">@wardsCount</div>
                <div class="stat-label">Wards Covered</div>
            </div>
        </div>
    </div>
</div>

<!-- Filter Bar -->
@if (ViewBag.WardOptions != null)
{
    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-body p-3">
            <form method="get" class="row g-2 align-items-center">
                <div class="col-auto">
                    <label class="form-label mb-0 fw-semibold text-muted small"><i class="bi bi-funnel me-1"></i>Filter by Ward:</label>
                </div>
                <div class="col-md-4">
                    <select name="wardId" class="form-select form-select-sm" onchange="this.form.submit()">
                        <option value="">-- All Wards --</option>
                        @foreach (var opt in (IEnumerable<SelectListItem>)ViewBag.WardOptions)
                        {
                            <option value="@opt.Value" selected="@(opt.Value == (ViewBag.WardId?.ToString()))">@opt.Text</option>
                        }
                    </select>
                </div>
                @if (ViewBag.WardId != null)
                {
                    <div class="col-auto">
                        <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Clear Filter</a>
                    </div>
                }
            </form>
        </div>
    </div>
}

<!-- Data Table -->
<div class="dashboard-panel table-responsive shadow-sm border rounded-3 bg-white">
    <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
            <tr>
                <th style="width: 50px;">#</th>
                <th>Station Code</th>
                <th>Station Name</th>
                <th>Parent Ward</th>
                <th>Floor</th>
                <th>Responsible In-Charge Nurse</th>
                <th>Status</th>
                <th>Created</th>
                <th class="text-end" style="width: 140px;">Actions</th>
            </tr>
        </thead>
        <tbody>
            @{int i = 1;}
            @foreach (var item in Model)
            {
                <tr>
                    <td class="text-muted small">@(i++)</td>
                    <td>
                        <span class="badge text-bg-light border text-dark font-monospace fs-6">
                            @item.StationCode
                        </span>
                    </td>
                    <td class="fw-semibold">
                        <i class="bi bi-person-workspace text-primary me-2"></i>@item.StationName
                    </td>
                    <td>
                        <a asp-controller="Wards" asp-action="Details" asp-route-id="@item.WardId" class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 text-decoration-none px-2 py-1">
                            <i class="bi bi-hospital me-1"></i>@item.WardName (@item.WardCode)
                        </a>
                    </td>
                    <td>
                        <span class="text-muted small">@item.FloorName</span>
                    </td>
                    <td>
                        @if (!string.IsNullOrWhiteSpace(item.ResponsibleNurse))
                        {
                            <span class="badge bg-info bg-opacity-10 text-info border border-info border-opacity-25 px-2 py-1">
                                <i class="bi bi-person-badge-fill me-1"></i>@item.ResponsibleNurse
                            </span>
                        }
                        else
                        {
                            <span class="text-muted small">—</span>
                        }
                    </td>
                    <td>
                        @if (item.IsActive)
                        {
                            <span class="badge text-bg-success">Active</span>
                        }
                        else
                        {
                            <span class="badge text-bg-secondary">Inactive</span>
                        }
                    </td>
                    <td class="text-muted small">@item.CreatedDate.ToString("dd MMM yyyy")</td>
                    <td class="text-end">
                        <a asp-action="Details" asp-route-id="@item.NursingStationId"
                           class="btn btn-sm btn-outline-secondary me-1" title="View Details">
                            <i class="bi bi-eye"></i>
                        </a>
                        <a asp-action="Edit" asp-route-id="@item.NursingStationId"
                           class="btn btn-sm btn-outline-primary me-1" title="Edit">
                            <i class="bi bi-pencil"></i>
                        </a>
                        <form asp-action="Delete" asp-route-id="@item.NursingStationId" method="post" class="d-inline"
                              onsubmit="return confirm('Are you sure you want to delete @item.StationName?');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete">
                                <i class="bi bi-trash"></i>
                            </button>
                        </form>
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="9" class="text-center text-muted py-5">
                        <i class="bi bi-person-workspace fs-1 d-block mb-2 opacity-50"></i>
                        No nursing stations found. <a asp-action="Create" asp-route-wardId="@ViewBag.WardId" class="fw-bold">Create one now.</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
