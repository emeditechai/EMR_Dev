@model EMR.Web.Models.ViewModels.PatientDetailsViewModel
@inject EMR.Shared.Security.IActionPermissionGuard PermissionGuard
@{
    ViewData["Title"] = "Patient Details";
    var p = Model.Patient;
    var fullName = string.Join(" ", new[] { p.Salutation, p.FirstName, p.MiddleName, p.LastName }.Where(x => !string.IsNullOrEmpty(x)));
    var initials = ((p.FirstName?.Length > 0 ? p.FirstName[0].ToString() : "") + (p.LastName?.Length > 0 ? p.LastName[0].ToString() : "")).ToUpper();
    if (string.IsNullOrEmpty(initials)) initials = "?";

    var age = EMR.Web.Utils.AgeCalculator.FormatAgePattern(p.DateOfBirth);
    // Edit opens Patient Registration: Patient Master > Edit patient (script 2208) and that screen are both needed
    var canEdit = await PermissionGuard.ShowsAsync(Context, "MASTER.OPD", "EDIT")
                  && await PermissionGuard.ShowsAsync(Context, "OPD.PATIENTREGISTRATION", "VIEW");
    var canOpenCard = await PermissionGuard.ShowsAsync(Context, "MASTER.MEMBERSHIPCARDS", "VIEW");

    var card = Model.CurrentCard;
    var cardMembers = card == null ? new List<EMR.Web.Models.ViewModels.PatientCardMemberItem>() : Model.CardMembers.Where(m => m.CardId == card.CardId).ToList();
    var otherCards = Model.MembershipCards.Where(c => card == null || c.CardId != card.CardId).ToList();
    string CardTone(string s) => s switch { "Active" => "success", "Expired" => "warning", "Blocked" => "danger", "Cancelled" => "secondary", _ => "secondary" };
    var isHead = p.RelationId == 1;
    var headOfFamily = isHead ? null : Model.Family.FirstOrDefault(f => f.IsSelf);
    var opd = Model.BillingSummary.FirstOrDefault(b => b.ModuleCode == "OPD");
    var lab = Model.BillingSummary.FirstOrDefault(b => b.ModuleCode == "LAB");
    var totalBilled = Model.BillingSummary.Sum(b => b.NetAmount);
    var totalPaid = Model.BillingSummary.Sum(b => b.Paid);
    var totalDue = Model.BillingSummary.Sum(b => b.Due);
    var lastVisit = new[] { Model.VisitHistory.Select(v => (DateTime?)v.VisitDate).FirstOrDefault(), Model.LabOrderHistory?.Select(l => (DateTime?)l.OrderDate).FirstOrDefault() }
                    .Where(d => d.HasValue).Select(d => d!.Value).DefaultIfEmpty().Max();
    string TxnLabel(string t) => t switch { "ISSUE" => "Card issued", "EARN" => "Earned", "REDEEM" => "Redeemed", "REVERSE" => "Reversed", "RESTORE" => "Restored", "DISCOUNT" => "Member discount", "STATUS" => "Status change", _ => t };
}

<style>
    .pp-kpi { border:1px solid #e9eef5; border-radius:.75rem; background:#fff; padding:.75rem 1rem; height:100%; }
    .pp-kpi .lbl { font-size:.7rem; text-transform:uppercase; letter-spacing:.05em; color:#64748b; font-weight:600; }
    .pp-kpi .val { font-size:1.15rem; font-weight:700; color:#0f172a; font-variant-numeric:tabular-nums; }
    .pp-kpi .sub { font-size:.75rem; color:#64748b; }
    .pp-mcard { border-radius:.9rem; color:#fff; padding:1.1rem 1.25rem; position:relative; overflow:hidden;
                background:linear-gradient(135deg,#1e3a8a 0%,#4f46e5 55%,#7c3aed 100%); }
    .pp-mcard.is-off { background:linear-gradient(135deg,#475569 0%,#64748b 100%); }
    .pp-mcard::after { content:""; position:absolute; right:-40px; top:-40px; width:150px; height:150px; border-radius:50%; background:rgba(255,255,255,.08); }
    .pp-mcard .no { font-family:ui-monospace,SFMono-Regular,Menlo,monospace; letter-spacing:.12em; font-size:1.15rem; font-weight:700; }
    .pp-mcard .k { font-size:.65rem; text-transform:uppercase; letter-spacing:.08em; opacity:.75; }
    .pp-mcard .v { font-weight:600; font-variant-numeric:tabular-nums; }
    .pp-av { width:34px; height:34px; border-radius:50%; display:flex; align-items:center; justify-content:center; font-weight:700; font-size:.75rem; flex-shrink:0; background:#e0e7ff; color:#3730a3; }
    .pp-row { display:flex; gap:.65rem; align-items:center; padding:.6rem 0; border-bottom:1px solid #f1f5f9; }
    .pp-row:last-child { border-bottom:0; }
</style>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-0 fw-bold text-dark">
            <i class="bi bi-person-bounding-box text-primary me-2"></i>Patient Profile
        </h1>
        <small class="text-muted">Detailed view of patient demographics, visits, and clinical vitals history.</small>
    </div>
    <div class="d-flex gap-2">
        @if (canEdit)
        {
            <a asp-action="PatientRegistration" asp-route-id="@p.PatientId" class="btn btn-primary btn-sm">
                <i class="bi bi-pencil-fill me-1"></i>Edit Profile
            </a>
        }
        <button class="btn btn-outline-secondary btn-sm" onclick="window.close()">
            <i class="bi bi-x-lg me-1"></i>Close Tab
        </button>
    </div>
</div>

<!-- At a glance -->
<div class="row g-3 mb-4">
    <div class="col-6 col-md-4 col-xl-2"><div class="pp-kpi"><div class="lbl"><i class="bi bi-hospital me-1"></i>OPD Visits</div>
        <div class="val">@Model.VisitHistory.Count</div><div class="sub">@(opd == null ? "No bills" : $"₹ {opd.NetAmount:N2} billed")</div></div></div>
    <div class="col-6 col-md-4 col-xl-2"><div class="pp-kpi"><div class="lbl"><i class="bi bi-droplet-half me-1"></i>LAB Bills</div>
        <div class="val">@(Model.LabOrderHistory?.Count ?? 0)</div><div class="sub">@(lab == null ? "No bills" : $"₹ {lab.NetAmount:N2} billed")</div></div></div>
    <div class="col-6 col-md-4 col-xl-2"><div class="pp-kpi"><div class="lbl"><i class="bi bi-receipt me-1"></i>Total Billed</div>
        <div class="val">₹ @totalBilled.ToString("N2")</div><div class="sub">Paid ₹ @totalPaid.ToString("N2")</div></div></div>
    <div class="col-6 col-md-4 col-xl-2"><div class="pp-kpi" style="@(totalDue > 0 ? "border-color:#fecaca;background:#fff7f7" : "")"><div class="lbl"><i class="bi bi-exclamation-circle me-1"></i>Outstanding</div>
        <div class="val @(totalDue > 0 ? "text-danger" : "text-success")">₹ @totalDue.ToString("N2")</div><div class="sub">@(totalDue > 0 ? "Due to collect" : "Nothing due")</div></div></div>
    <div class="col-6 col-md-4 col-xl-2"><div class="pp-kpi"><div class="lbl"><i class="bi bi-credit-card-2-front me-1"></i>Membership</div>
        @if (card != null)
        {
            <div class="val">@card.CardNo</div><div class="sub"><span class="text-@CardTone(card.EffectiveStatus) fw-semibold">@card.EffectiveStatus</span> · @card.PointsBalance.ToString("0.##") pts</div>
        }
        else
        {
            <div class="val text-muted">—</div><div class="sub">No card</div>
        }
    </div></div>
    <div class="col-6 col-md-4 col-xl-2"><div class="pp-kpi"><div class="lbl"><i class="bi bi-people me-1"></i>Family</div>
        <div class="val">@(Model.Family.Count + 1)</div><div class="sub">@(Model.Family.Count == 0 ? "Only this patient" : $"on {p.PhoneNumber}")</div></div></div>
</div>

<div class="row g-4">
    <!-- Left Column: Patient Profile Header Card & Basic Details -->
    <div class="col-lg-4">
        
        <!-- Header Card -->
        <div class="card shadow-sm border-0 mb-4 overflow-hidden">
            <div class="card-header bg-gradient bg-primary py-4 text-center text-white border-0 position-relative">
                <div class="position-absolute top-0 end-0 p-2">
                    @if (p.IsActive)
                    {
                        <span class="badge bg-success-subtle text-success border border-success border-opacity-25 px-3 py-1">Active</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary-subtle text-secondary border border-secondary border-opacity-25 px-3 py-1">Inactive</span>
                    }
                </div>
                <div class="mx-auto mb-3 rounded-circle border border-3 border-white shadow-sm d-flex align-items-center justify-content-center bg-white text-primary fw-bold" 
                     style="width: 100px; height: 100px; font-size: 2.2rem; overflow:hidden;">
                    @if (!string.IsNullOrEmpty(p.PhotoPath))
                    {
                        <img src="@p.PhotoPath" class="w-100 h-100 object-fit-cover" alt="Profile photo" />
                    }
                    else
                    {
                        <span>@initials</span>
                    }
                </div>
                <h4 class="fw-bold mb-1 text-white">@fullName</h4>
                <div class="font-monospace text-white-50 small mb-2">@p.PatientCode</div>
                <div class="d-flex justify-content-center gap-2 flex-wrap">
                    @if (!string.IsNullOrEmpty(p.Gender))
                    {
                        <span class="badge bg-white bg-opacity-25 px-3 py-1.5 rounded-pill">@p.Gender</span>
                    }
                    @if (!string.IsNullOrEmpty(age))
                    {
                        <span class="badge bg-white bg-opacity-25 px-3 py-1.5 rounded-pill">@age</span>
                    }
                    @if (!string.IsNullOrEmpty(p.BloodGroup))
                    {
                        <span class="badge bg-danger px-3 py-1.5 rounded-pill"><i class="bi bi-droplet-fill me-1"></i>@p.BloodGroup</span>
                    }
                </div>
                <div class="d-flex justify-content-center gap-2 flex-wrap mt-2">
                    <span class="badge bg-white text-primary px-3 py-1.5 rounded-pill">
                        <i class="bi bi-diagram-3 me-1"></i>@(isHead ? "Head of family" : (Model.RelationName ?? "Relation not set"))
                    </span>
                    @if (card != null)
                    {
                        <span class="badge bg-warning text-dark px-3 py-1.5 rounded-pill"><i class="bi bi-credit-card-2-front me-1"></i>@card.CardNo · @card.EffectiveStatus</span>
                    }
                </div>
            </div>
            <div class="card-body p-0 border-top">
                <div class="list-group list-group-flush small">
                    <div class="list-group-item d-flex justify-content-between py-3 px-4">
                        <span class="text-muted"><i class="bi bi-telephone-fill me-2 text-primary"></i>Mobile Number</span>
                        <span class="fw-semibold text-dark">@p.PhoneNumber</span>
                    </div>
                    @if (!string.IsNullOrEmpty(p.SecondaryPhoneNumber))
                    {
                        <div class="list-group-item d-flex justify-content-between py-3 px-4">
                            <span class="text-muted"><i class="bi bi-telephone-plus-fill me-2 text-primary"></i>Secondary Mobile</span>
                            <span class="fw-semibold text-dark">@p.SecondaryPhoneNumber</span>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(p.EmailId))
                    {
                        <div class="list-group-item d-flex justify-content-between py-3 px-4">
                            <span class="text-muted"><i class="bi bi-envelope-fill me-2 text-primary"></i>Email Address</span>
                            <span class="fw-semibold text-dark">@p.EmailId</span>
                        </div>
                    }
                    <div class="list-group-item d-flex justify-content-between py-3 px-4">
                        <span class="text-muted"><i class="bi bi-calendar-event-fill me-2 text-primary"></i>Registration Date</span>
                        <span class="fw-semibold text-dark">@p.CreatedDate.ToString("dd MMM yyyy, HH:mm")</span>
                    </div>
                    @if (Model.RegisteredBranchName != null || Model.RegisteredByName != null)
                    {
                        <div class="list-group-item d-flex justify-content-between py-3 px-4 gap-3">
                            <span class="text-muted text-nowrap"><i class="bi bi-building me-2 text-primary"></i>Registered At</span>
                            <span class="fw-semibold text-dark text-end">@(Model.RegisteredBranchName ?? "--")@(Model.RegisteredByName == null ? "" : $" · by {Model.RegisteredByName}")</span>
                        </div>
                    }
                    @if (Model.ReferralDoctorName != null)
                    {
                        <div class="list-group-item d-flex justify-content-between py-3 px-4">
                            <span class="text-muted"><i class="bi bi-person-badge me-2 text-primary"></i>Referred By</span>
                            <span class="fw-semibold text-dark">@Model.ReferralDoctorName</span>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Address Card -->
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-body p-4">
                <h6 class="fw-bold text-dark text-uppercase mb-3" style="letter-spacing:.05em">
                    <i class="bi bi-geo-alt-fill text-primary me-2"></i>Address Details
                </h6>
                @if (!string.IsNullOrWhiteSpace(p.Address))
                {
                    <div class="text-dark mb-2" style="line-height:1.4;">
                        <strong><i class="bi bi-house-door text-secondary me-1"></i>Address:</strong> <br/>
                        @p.Address
                    </div>
                }
                @if (!string.IsNullOrWhiteSpace(p.HomeCollectionAddress))
                {
                    <div class="text-dark mb-2" style="line-height:1.4;">
                        <strong><i class="bi bi-geo-alt-fill text-danger me-1"></i>Home Collection:</strong> <br/>
                        @p.HomeCollectionAddress
                        @if (p.Latitude.HasValue && p.Longitude.HasValue)
                        {
                            <div class="mt-1">
                                <span class="badge bg-success-subtle text-success border border-success"><i class="bi bi-crosshair me-1"></i>Lat: @p.Latitude.Value.ToString("0.0000"), Lon: @p.Longitude.Value.ToString("0.0000")</span>
                            </div>
                        }
                    </div>
                }
                @if (string.IsNullOrWhiteSpace(p.Address) && string.IsNullOrWhiteSpace(p.HomeCollectionAddress))
                {
                    <div class="text-muted fst-italic mb-2">No address provided</div>
                }
                <hr class="my-3" />
                <div class="row g-2 small text-muted">
                    <div class="col-6"><strong>Area:</strong> @(Model.AreaName ?? "--")</div>
                    <div class="col-6"><strong>City/Village:</strong> @(Model.CityName ?? "--")</div>
                    <div class="col-6"><strong>District:</strong> @(Model.DistrictName ?? "--")</div>
                    <div class="col-6"><strong>State:</strong> @(Model.StateName ?? "--")</div>
                    <div class="col-12"><strong>Country:</strong> @(Model.CountryName ?? "--")</div>
                </div>
            </div>
        </div>


        <!-- Membership Card -->
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="fw-bold text-dark text-uppercase mb-0" style="letter-spacing:.05em">
                        <i class="bi bi-credit-card-2-front text-primary me-2"></i>Membership Card
                    </h6>
                    @if (card != null && canOpenCard)
                    {
                        <a href="/MembershipCards/Details/@card.CardId" target="_blank" class="btn btn-sm btn-outline-primary py-0 px-2">Open <i class="bi bi-box-arrow-up-right ms-1"></i></a>
                    }
                </div>
                @if (card == null)
                {
                    <div class="text-center text-muted py-3 small">
                        <i class="bi bi-credit-card d-block fs-3 opacity-50 mb-1"></i>No membership card is assigned to this patient.
                    </div>
                }
                else
                {
                    <div class="pp-mcard mb-3 @(card.EffectiveStatus == "Active" ? "" : "is-off")">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <div>
                                <div class="k">@(card.PlanType ?? "Plan")</div>
                                <div class="fw-bold">@card.PlanName</div>
                            </div>
                            <span class="badge bg-white text-@CardTone(card.EffectiveStatus)">@card.EffectiveStatus</span>
                        </div>
                        <div class="no my-2">@card.CardNo</div>
                        <div class="d-flex justify-content-between gap-2">
                            <div><div class="k">Valid</div><div class="v small">@card.ValidFrom.ToString("dd MMM yy") – @card.ValidTo.ToString("dd MMM yy")</div></div>
                            <div class="text-end"><div class="k">Points</div><div class="v">@card.PointsBalance.ToString("0.##")</div></div>
                        </div>
                    </div>
                    <div class="small">
                        <div class="d-flex justify-content-between py-1"><span class="text-muted">Card holder</span>
                            <span class="fw-semibold text-end">
                                @if (card.IsPrimary) { <span>This patient (Self)</span> }
                                else { <a href="/OPD/Details/@card.PrimaryPatientId" class="text-decoration-none">@card.PrimaryName</a> <span class="text-muted">(@card.PrimaryCode)</span> }
                            </span></div>
                        @if (!card.IsPrimary)
                        {
                            <div class="d-flex justify-content-between py-1"><span class="text-muted">Covered as</span><span class="fw-semibold">@card.MemberRelation@(card.MemberActive ? "" : " (removed)")</span></div>
                        }
                        <div class="d-flex justify-content-between py-1"><span class="text-muted">Points value</span><span class="fw-semibold">₹ @((card.PointsBalance * card.PointValue).ToString("N2"))</span></div>
                        <div class="d-flex justify-content-between py-1"><span class="text-muted">Issued at</span><span class="fw-semibold text-end">@(card.IssueBranchName ?? "--") · @card.CreatedDate.ToString("dd MMM yyyy")</span></div>
                        <div class="d-flex justify-content-between py-1"><span class="text-muted">Card fee</span><span class="fw-semibold">₹ @card.FeeAmount.ToString("N2")@(string.IsNullOrEmpty(card.ReceiptNo) ? "" : $" · {card.ReceiptNo}")</span></div>
                    </div>

                    <div class="mt-3">
                        <div class="text-muted small fw-semibold text-uppercase mb-1" style="letter-spacing:.05em">Members on this card (@cardMembers.Count(m => m.IsActive)@(card.MaxMembers > 0 ? $" of {card.MaxMembers}" : ""))</div>
                        @foreach (var m in cardMembers)
                        {
                            <div class="pp-row @(m.IsActive ? "" : "opacity-50")">
                                <div class="pp-av">@string.Concat(m.FullName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Where(w => !w.EndsWith(".")).Take(2).Select(w => char.ToUpper(w[0])))</div>
                                <div class="flex-grow-1 small">
                                    @if (m.PatientId == p.PatientId) { <span class="fw-semibold">@m.FullName</span> <span class="badge bg-primary-subtle text-primary ms-1">This patient</span> }
                                    else { <a href="/OPD/Details/@m.PatientId" class="fw-semibold text-decoration-none">@m.FullName</a> }
                                    <div class="text-muted">@m.PatientCode</div>
                                </div>
                                <span class="badge @(m.IsPrimary ? "bg-primary" : "bg-light text-dark border")">@(m.IsPrimary ? "Primary" : m.Relation)@(m.IsActive ? "" : " · removed")</span>
                            </div>
                        }
                    </div>

                    @if (otherCards.Any())
                    {
                        <div class="mt-3">
                            <div class="text-muted small fw-semibold text-uppercase mb-1" style="letter-spacing:.05em">Earlier / other cards</div>
                            @foreach (var c in otherCards)
                            {
                                <div class="d-flex justify-content-between align-items-center small py-1 border-bottom">
                                    <span>
                                        @if (canOpenCard) { <a href="/MembershipCards/Details/@c.CardId" target="_blank" class="font-monospace text-decoration-none">@c.CardNo</a> }
                                        else { <span class="font-monospace">@c.CardNo</span> }
                                        <span class="text-muted">· @c.PlanName · till @c.ValidTo.ToString("dd MMM yy")</span>
                                    </span>
                                    <span class="badge bg-@CardTone(c.EffectiveStatus)-subtle text-@CardTone(c.EffectiveStatus)">@c.EffectiveStatus</span>
                                </div>
                            }
                        </div>
                    }
                }
            </div>
        </div>

        <!-- Family & Dependents -->
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-body p-4">
                <h6 class="fw-bold text-dark text-uppercase mb-1" style="letter-spacing:.05em">
                    <i class="bi bi-people-fill text-primary me-2"></i>Family &amp; Dependents
                </h6>
                <div class="text-muted small mb-2">Patients registered on mobile <span class="fw-semibold">@(string.IsNullOrWhiteSpace(p.PhoneNumber) ? "--" : p.PhoneNumber)</span>, by relation to the head of family.</div>
                @if (!isHead)
                {
                    <div class="alert alert-light border small py-2 mb-2">
                        This patient is registered as <b>@(Model.RelationName ?? "a family member")</b>
                        @if (headOfFamily != null) { <span>of <a href="/OPD/Details/@headOfFamily.PatientId" class="fw-semibold text-decoration-none">@headOfFamily.FullName</a>.</span> }
                        else { <span>; no head of family (Self) is registered on this number.</span> }
                    </div>
                }
                @if (!Model.Family.Any())
                {
                    <div class="text-center text-muted py-3 small"><i class="bi bi-person d-block fs-3 opacity-50 mb-1"></i>No other patient is registered on this mobile number.</div>
                }
                else
                {
                    @foreach (var f in Model.Family)
                    {
                        var fAge = EMR.Web.Utils.AgeCalculator.FormatAgePattern(f.DateOfBirth);
                        var onCard = card != null && cardMembers.Any(m => m.PatientId == f.PatientId && m.IsActive);
                        <div class="pp-row @(f.IsActive ? "" : "opacity-50")">
                            <div class="pp-av" style="@(f.IsSelf ? "background:#dbeafe;color:#1d4ed8" : "")">@string.Concat(f.FullName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Where(w => !w.EndsWith(".")).Take(2).Select(w => char.ToUpper(w[0])))</div>
                            <div class="flex-grow-1 small">
                                <a href="/OPD/Details/@f.PatientId" class="fw-semibold text-decoration-none">@f.FullName</a>
                                @if (onCard) { <i class="bi bi-credit-card-2-front text-warning ms-1" title="Member of @card!.CardNo"></i> }
                                <div class="text-muted">@f.PatientCode@(string.IsNullOrEmpty(f.Gender) ? "" : $" · {f.Gender}")@(string.IsNullOrEmpty(fAge) ? "" : $" · {fAge}")@(f.IsActive ? "" : " · inactive")</div>
                            </div>
                            <span class="badge @(f.IsSelf ? "bg-primary" : "bg-light text-dark border")">@(f.IsSelf ? "Head (Self)" : (f.RelationName ?? "—"))</span>
                        </div>
                    }
                }
            </div>
        </div>
    </div>

    <!-- Right Column: Full Details, Visits, and Vitals -->
    <div class="col-lg-8">
        
        <!-- Personal & Demographic Details -->
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-body p-4">
                <h6 class="fw-bold text-dark text-uppercase mb-3" style="letter-spacing:.05em">
                    <i class="bi bi-card-list text-primary me-2"></i>Demographics & Identification
                </h6>
                <div class="row g-3 small">
                    <div class="col-sm-6 border-bottom pb-2">
                        <span class="text-muted d-block mb-1">Date of Birth</span>
                        <span class="fw-semibold text-dark fs-6">@(p.DateOfBirth?.ToString("dd MMM yyyy") ?? "--")</span>
                    </div>
                    <div class="col-sm-6 border-bottom pb-2">
                        <span class="text-muted d-block mb-1">Salutation / Title</span>
                        <span class="fw-semibold text-dark fs-6">@(p.Salutation ?? "--")</span>
                    </div>
                    <div class="col-sm-6 border-bottom pb-2">
                        <span class="text-muted d-block mb-1">Religion</span>
                        <span class="fw-semibold text-dark fs-6">@(Model.ReligionName ?? "--")</span>
                    </div>
                    <div class="col-sm-6 border-bottom pb-2">
                        <span class="text-muted d-block mb-1">Occupation</span>
                        <span class="fw-semibold text-dark fs-6">@(Model.OccupationName ?? "--")</span>
                    </div>
                    <div class="col-sm-6 border-bottom pb-2">
                        <span class="text-muted d-block mb-1">Marital Status</span>
                        <span class="fw-semibold text-dark fs-6">@(Model.MaritalStatusName ?? "--")</span>
                    </div>
                    <div class="col-sm-6 border-bottom pb-2">
                        <span class="text-muted d-block mb-1">Language</span>
                        <span class="fw-semibold text-dark fs-6">@(Model.LanguageName ?? "--")</span>
                    </div>
                    <div class="col-sm-6 border-bottom pb-2">
                        <span class="text-muted d-block mb-1">Relation to Head of Family</span>
                        <span class="fw-semibold text-dark fs-6">@(isHead ? "Self (head of family)" : (Model.RelationName ?? "--"))</span>
                    </div>
                    <div class="col-sm-6 border-bottom pb-2">
                        <span class="text-muted d-block mb-1">Guardian Name</span>
                        <span class="fw-semibold text-dark fs-6">
                            @if (!string.IsNullOrEmpty(p.GuardianName))
                            {
                                <span>@p.GuardianName</span>
                            }
                            else
                            {
                                <span>--</span>
                            }
                        </span>
                    </div>

                    <!-- Identification Doc -->
                    <div class="col-12 pt-2">
                        <div class="p-3 bg-light rounded d-flex align-items-center justify-content-between flex-wrap gap-2">
                            <div>
                                <span class="text-muted d-block small">Identification Doc Type &amp; Number</span>
                                <span class="fw-semibold text-dark">
                                    @(Model.IdentificationTypeName ?? "Not Provided") @(string.IsNullOrEmpty(p.IdentificationNumber) ? "" : $"({p.IdentificationNumber})")
                                </span>
                            </div>
                            @if (!string.IsNullOrEmpty(p.IdentificationFilePath))
                            {
                                <button type="button" class="btn btn-sm btn-outline-primary" onclick="openDocModal('@p.IdentificationFilePath')">
                                    <i class="bi bi-file-earmark-arrow-down-fill me-1"></i>View Document
                                </button>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Medical Alerts & Remarks -->
        <div class="card shadow-sm border-0 mb-4 bg-light border-start border-4 border-warning">
            <div class="card-body p-4">
                <h6 class="fw-bold text-dark text-uppercase mb-3" style="letter-spacing:.05em">
                    <i class="bi bi-shield-fill-exclamation text-warning me-2"></i>Medical & General Notes
                </h6>
                <div class="row g-3 small">
                    <div class="col-md-6">
                        <span class="text-muted d-block mb-1 fw-bold text-danger">Known Allergies</span>
                        <div class="p-2.5 bg-white rounded border border-danger border-opacity-10 text-dark">
                            @(string.IsNullOrEmpty(p.KnownAllergies) ? "No known allergies recorded." : p.KnownAllergies)
                        </div>
                    </div>
                    <div class="col-md-6">
                        <span class="text-muted d-block mb-1 fw-bold text-dark">Remarks / Medical History Notes</span>
                        <div class="p-2.5 bg-white rounded border text-dark">
                            @(string.IsNullOrEmpty(p.Remarks) ? "No remarks or history recorded." : p.Remarks)
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- History Tabs Card -->
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white border-0 pt-3">
                <ul class="nav nav-tabs card-header-tabs border-bottom-0" id="historyTabs" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active fw-bold text-dark border-bottom border-3" id="visits-tab" data-bs-toggle="tab" data-bs-target="#visits-pane" type="button" role="tab" aria-controls="visits-pane" aria-selected="true">
                            <i class="bi bi-hospital me-2 text-primary"></i>OPD Visits History (@Model.VisitHistory.Count)
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link fw-bold text-dark border-bottom border-3" id="vitals-tab" data-bs-toggle="tab" data-bs-target="#vitals-pane" type="button" role="tab" aria-controls="vitals-pane" aria-selected="false">
                            <i class="bi bi-activity me-2 text-success"></i>Patient Vitals Log (@Model.VitalHistory.Count)
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link fw-bold text-dark border-bottom border-3" id="vital-graph-tab" data-bs-toggle="tab" data-bs-target="#vital-graph-pane" type="button" role="tab" aria-controls="vital-graph-pane" aria-selected="false">
                            <i class="bi bi-graph-up-arrow me-2 text-danger"></i>Vital Graph
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link fw-bold text-dark border-bottom border-3" id="visit-graph-tab" data-bs-toggle="tab" data-bs-target="#visit-graph-pane" type="button" role="tab" aria-controls="visit-graph-pane" aria-selected="false">
                            <i class="bi bi-graph-up me-2 text-warning"></i>Visit Graph
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link fw-bold text-dark border-bottom border-3" id="laborders-tab" data-bs-toggle="tab" data-bs-target="#laborders-pane" type="button" role="tab" aria-controls="laborders-pane" aria-selected="false">
                            <i class="bi bi-droplet-half me-2 text-info"></i>LAB TESTs (@(Model.LabOrderHistory?.Count ?? 0))
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link fw-bold text-dark border-bottom border-3" id="points-tab" data-bs-toggle="tab" data-bs-target="#points-pane" type="button" role="tab" aria-controls="points-pane" aria-selected="false">
                            <i class="bi bi-stars me-2 text-warning"></i>Membership Points (@Model.PointsLedger.Count)
                        </button>
                    </li>
                </ul>
            </div>
            <div class="card-body p-4 tab-content" id="historyTabsContent">
                
                <!-- Visits Tab Pane -->
                <div class="tab-pane fade show active" id="visits-pane" role="tabpanel" aria-labelledby="visits-tab" tabindex="0">
                    @if (Model.VisitHistory.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle small mb-0 border-top">
                                <thead class="table-light text-muted uppercase font-monospace" style="font-size: 0.75rem;">
                                    <tr>
                                        <th>Visit Date</th>
                                        <th>Bill No.</th>
                                        <th>Token No.</th>
                                        <th>Consulting Doctor</th>
                                        <th>Services Taken</th>
                                        <th>Total Amount</th>
                                        <th>Payment</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var v in Model.VisitHistory)
                                    {
                                        <tr>
                                            <td class="fw-semibold text-dark">@v.VisitDate.ToString("dd MMM yyyy, HH:mm")</td>
                                            <td class="font-monospace text-secondary">
                                                <a asp-permission="MASTER.OPD:PRINT" href="/OPD/PrintBill?id=@v.OPDServiceId" target="_blank" class="text-decoration-none">
                                                    <i class="bi bi-file-earmark-pdf text-danger me-1"></i>@v.OPDBillNo
                                                </a>
                                            </td>
                                            <td>
                                                @if (!string.IsNullOrEmpty(v.TokenNo))
                                                {
                                                    <span class="badge bg-primary rounded-pill font-monospace px-2.5 py-1.5">@v.TokenNo</span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted italic small">Pending</span>
                                                }
                                            </td>
                                            <td>@(v.ConsultingDoctorName ?? "--")</td>
                                            <td>
                                                <span class="text-truncate d-inline-block" style="max-width: 220px;" title="@v.ServiceTypesSummary">
                                                    @v.ServiceTypesSummary
                                                </span>
                                            </td>
                                            <td class="fw-bold text-dark">₹ @v.TotalAmount.ToString("N2")</td>
                                            <td>
                                                @if (v.PaymentStatus == "P" || v.PaymentStatus == "Fully Paid")
                                                {
                                                    <span class="badge text-bg-success px-2.5 py-1.5">Fully Paid</span>
                                                }
                                                else if (v.PaymentStatus == "D" || v.PaymentStatus == "Partially Paid")
                                                {
                                                    <span class="badge text-bg-warning text-dark px-2.5 py-1.5">Partially Paid</span>
                                                }
                                                else
                                                {
                                                    <span class="badge text-bg-danger px-2.5 py-1.5">Unpaid</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="bi bi-calendar-x text-muted display-6 mb-3 d-block"></i>
                            <p class="text-muted mb-0">No outpatient service bookings found for this patient.</p>
                        </div>
                    }
                </div>

                <!-- Vitals Tab Pane -->
                <div class="tab-pane fade" id="vitals-pane" role="tabpanel" aria-labelledby="vitals-tab" tabindex="0">
                    @if (Model.VitalHistory.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle small mb-0 border-top">
                                <thead class="table-light text-muted uppercase font-monospace" style="font-size: 0.75rem;">
                                    <tr>
                                        <th>Date Recorded</th>
                                        <th>BP (mmHg)</th>
                                        <th>Pulse (bpm)</th>
                                        <th>SpO2</th>
                                        <th>Temp (°F)</th>
                                        <th>Ht/Wt/BMI</th>
                                        <th>Blood Glucose</th>
                                        <th>Notes</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var vt in Model.VitalHistory)
                                    {
                                        <tr>
                                            <td class="fw-semibold text-dark">@vt.RecordedOn.ToString("dd MMM yyyy, HH:mm")</td>
                                            <td>
                                                @if (vt.BPSystolic.HasValue || vt.BPDiastolic.HasValue)
                                                {
                                                    <span class="fw-bold">@vt.BPSystolic/@vt.BPDiastolic</span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">--</span>
                                                }
                                            </td>
                                            <td>
                                                @if (vt.PulseRate.HasValue)
                                                {
                                                    <span>@vt.PulseRate <span class="text-muted small">bpm</span></span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">--</span>
                                                }
                                            </td>
                                            <td>
                                                @if (vt.SpO2.HasValue)
                                                {
                                                    <span class="fw-semibold text-success">@vt.SpO2%</span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">--</span>
                                                }
                                            </td>
                                            <td>
                                                @if (vt.Temperature.HasValue)
                                                {
                                                    <span>@vt.Temperature <span class="text-muted small">°F</span></span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">--</span>
                                                }
                                            </td>
                                            <td>
                                                @if (vt.Height.HasValue || vt.Weight.HasValue)
                                                {
                                                    <div class="lh-sm">
                                                        <div>Ht: @(vt.Height?.ToString("0.#") ?? "--") cm | Wt: @(vt.Weight?.ToString("0.#") ?? "--") kg</div>
                                                        @if (vt.BMI.HasValue)
                                                        {
                                                            <div class="text-muted small">
                                                                BMI: <strong>@vt.BMI.Value.ToString("F1")</strong> 
                                                                <span class="badge px-1.5 py-0.5 ms-1 @(vt.BMICategory == "Normal" ? "text-bg-success" : "text-bg-warning text-dark")">@vt.BMICategory</span>
                                                            </div>
                                                        }
                                                    </div>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">--</span>
                                                }
                                            </td>
                                            <td>
                                                @if (vt.BloodGlucose.HasValue)
                                                {
                                                    <div class="lh-sm">
                                                        <span class="fw-semibold">@vt.BloodGlucose.Value.ToString("0.#")</span> <span class="text-muted small">mg/dL</span>
                                                        @if (!string.IsNullOrEmpty(vt.GlucoseType))
                                                        {
                                                            <div class="text-muted small italic text-uppercase font-monospace">@vt.GlucoseType</div>
                                                        }
                                                    </div>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">--</span>
                                                }
                                            </td>
                                            <td class="text-muted" style="max-width: 180px;" title="@vt.Notes">@vt.Notes</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="bi bi-activity text-muted display-6 mb-3 d-block"></i>
                            <p class="text-muted mb-0">No clinical vitals logged for this patient.</p>
                        </div>
                    }
                </div>

                <!-- Vital Graph Tab Pane -->
                <div class="tab-pane fade" id="vital-graph-pane" role="tabpanel" aria-labelledby="vital-graph-tab" tabindex="0">
                    <div class="row mb-3 align-items-center">
                        <div class="col-auto">
                            <label for="vitalMetricSelect" class="form-label mb-0 fw-semibold">Select Vital Metric:</label>
                        </div>
                        <div class="col-sm-4">
                            <select id="vitalMetricSelect" class="form-select form-select-sm">
                                <option value="bp">Blood Pressure (BP)</option>
                                <option value="pulse">Pulse Rate</option>
                                <option value="temp">Temperature</option>
                                <option value="weight">Weight</option>
                            </select>
                        </div>
                    </div>
                    <div class="position-relative p-2 border rounded bg-white" style="height: 380px;">
                        <canvas id="vitalsChart"></canvas>
                        <div id="vitalsChartLoader" class="position-absolute top-50 start-50 translate-middle text-center" style="display:none">
                            <div class="spinner-border text-primary" role="status"></div>
                        </div>
                        <div id="vitalsChartEmpty" class="position-absolute top-50 start-50 translate-middle text-center text-muted" style="display:none">
                            <i class="bi bi-graph-up-arrow display-6 d-block mb-2"></i>
                            <span>No vital metrics logged to plot graph.</span>
                        </div>
                    </div>
                </div>

                <!-- Visit Graph Tab Pane -->
                <div class="tab-pane fade" id="visit-graph-pane" role="tabpanel" aria-labelledby="visit-graph-tab" tabindex="0">
                    <div class="row mb-3 align-items-center">
                        <div class="col-auto">
                            <label for="visitMetricSelect" class="form-label mb-0 fw-semibold">Select Visit Metric:</label>
                        </div>
                        <div class="col-sm-4">
                            <select id="visitMetricSelect" class="form-select form-select-sm">
                                <option value="amount">Bill Amount (₹)</option>
                                <option value="consulting">Doctor Consulting Count</option>
                            </select>
                        </div>
                    </div>
                    <div class="position-relative p-2 border rounded bg-white" style="height: 380px;">
                        <canvas id="visitsChart"></canvas>
                        <div id="visitsChartLoader" class="position-absolute top-50 start-50 translate-middle text-center" style="display:none">
                            <div class="spinner-border text-primary" role="status"></div>
                        </div>
                        <div id="visitsChartEmpty" class="position-absolute top-50 start-50 translate-middle text-center text-muted" style="display:none">
                            <i class="bi bi-graph-up display-6 d-block mb-2"></i>
                            <span>No visit bookings logged to plot graph.</span>
                        </div>
                    </div>
                </div>

                <!-- Lab Orders Tab Pane -->
                <div class="tab-pane fade" id="laborders-pane" role="tabpanel" aria-labelledby="laborders-tab" tabindex="0">
                    @if (Model.LabOrderHistory != null && Model.LabOrderHistory.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle small mb-0 border-top">
                                <thead class="table-light text-muted uppercase font-monospace" style="font-size: 0.75rem;">
                                    <tr>
                                        <th>Date</th>
                                        <th>Bill No.</th>
                                        <th>Bill Amount</th>
                                        <th>Discount</th>
                                        <th>Paid Amount</th>
                                        <th>Payment Status</th>
                                        <th>Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var l in Model.LabOrderHistory)
                                    {
                                        <tr>
                                            <td class="fw-semibold text-dark">@l.OrderDate.ToString("dd MMM yyyy, HH:mm")</td>
                                            <td class="font-monospace text-secondary">@l.BillNo</td>
                                            <td class="fw-bold text-dark">₹ @l.TotalAmount.ToString("N2")</td>
                                            <td class="text-danger">₹ @l.DiscountAmount.ToString("N2")</td>
                                            <td class="text-success fw-semibold">₹ @l.PaidAmount.ToString("N2")</td>
                                            <td>
                                                @if (l.PaymentStatus == "P" || l.PaymentStatus == "Fully Paid")
                                                {
                                                    <span class="badge text-bg-success px-2.5 py-1.5">Fully Paid</span>
                                                }
                                                else if (l.PaymentStatus == "D" || l.PaymentStatus == "Partially Paid")
                                                {
                                                    <span class="badge text-bg-warning text-dark px-2.5 py-1.5">Partially Paid</span>
                                                }
                                                else
                                                {
                                                    <span class="badge text-bg-danger px-2.5 py-1.5">Unpaid</span>
                                                }
                                            </td>
                                            <td>
                                                <div class="d-inline-flex gap-1">
                                                    <a asp-permission="MASTER.OPD:PRINT" href="/LabOrderBooking/PrintBill?labOrderId=@l.LabOrderId" target="_blank" class="btn btn-sm btn-outline-primary py-1 px-2" title="Print Bill">
                                                        <i class="bi bi-printer me-1"></i>Print
                                                    </a>
                                                    @if (l.ApprovedTestCount > 0)
                                                    {
                                                        <button type="button" class="btn btn-sm btn-outline-success py-1 px-2 btn-print-report"
                                                                data-scope="approved" data-laborderid="@l.LabOrderId" data-bill="@l.BillNo"
                                                                title="Print Lab Report (@l.ApprovedTestCount approved test@(l.ApprovedTestCount == 1 ? "" : "s"))">
                                                            <i class="bi bi-file-earmark-medical"></i>
                                                        </button>
                                                    }
                                                    else
                                                    {
                                                        <span class="d-inline-block" tabindex="0" title="Lab report not approved yet">
                                                            <button type="button" class="btn btn-sm btn-outline-secondary py-1 px-2" disabled style="pointer-events:none;">
                                                                <i class="bi bi-file-earmark-medical"></i>
                                                            </button>
                                                        </span>
                                                    }
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="bi bi-droplet-half text-muted display-6 mb-3 d-block opacity-50"></i>
                            <p class="text-muted mb-0">No lab test history found for this patient.</p>
                        </div>
                    }
                </div>

                <!-- Membership Points Tab Pane -->
                <div class="tab-pane fade" id="points-pane" role="tabpanel" aria-labelledby="points-tab" tabindex="0">
                    @if (Model.PointsLedger.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle small mb-0 border-top">
                                <thead class="table-light text-muted" style="font-size: 0.75rem;">
                                    <tr><th>Date</th><th>Card</th><th>Transaction</th><th>Member</th><th>Receipt / Bill</th><th class="text-end">Points</th><th class="text-end">Balance</th><th>Narration</th></tr>
                                </thead>
                                <tbody>
                                    @foreach (var lp in Model.PointsLedger)
                                    {
                                        <tr>
                                            <td class="text-nowrap">@lp.CreatedDate.ToString("dd MMM yyyy, HH:mm")</td>
                                            <td class="font-monospace text-secondary">@lp.CardNo</td>
                                            <td>@TxnLabel(lp.TxnType)</td>
                                            <td>@(string.IsNullOrWhiteSpace(lp.PatientName) ? "--" : lp.PatientName)</td>
                                            <td class="font-monospace">@(lp.ReceiptNo ?? "--")</td>
                                            <td class="text-end fw-semibold @(lp.Points > 0 ? "text-success" : lp.Points < 0 ? "text-danger" : "")">@(lp.Points > 0 ? "+" : "")@lp.Points.ToString("0.##")</td>
                                            <td class="text-end">@lp.BalanceAfter.ToString("0.##")</td>
                                            <td class="text-muted">@lp.Narration</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="bi bi-stars text-muted display-6 mb-3 d-block opacity-50"></i>
                            <p class="text-muted mb-0">@(card == null ? "No membership card, so no points history." : "No points transactions on this card yet.")</p>
                        </div>
                    }
                </div>

            </div>
        </div>

    </div>
</div>

<!-- Modal for Document View -->
<div class="modal fade" id="docViewerModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content shadow-lg border-0">
            <div class="modal-header bg-dark text-white py-2 px-4">
                <h6 class="modal-title fw-bold" id="docViewerTitle">View Document</h6>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-0 bg-light d-flex align-items-center justify-content-center" style="min-height: 450px;">
                <img id="docImg" class="w-100 h-100 object-fit-contain" style="display:none; max-height:75vh;" alt="Document content" />
                <iframe id="docFrame" class="w-100 border-0" style="display:none; height: 75vh;" src=""></iframe>
                <div id="docFallback" class="text-center py-5" style="display:none">
                    <i class="bi bi-file-earmark-arrow-down text-muted display-3 mb-3 d-block"></i>
                    <p class="mb-3 text-dark">This file format cannot be previewed directly in the browser.</p>
                    <a id="docDownloadBtn" href="" class="btn btn-primary" download>
                        <i class="bi bi-download me-1"></i>Download Document
                    </a>
                </div>
            </div>
            <div class="modal-footer py-2 px-4 bg-light border-top">
                <span class="text-muted small me-auto font-monospace" id="docFileName"></span>
                <a id="docOpenLink" href="" target="_blank" class="btn btn-sm btn-outline-secondary">
                    <i class="bi bi-box-arrow-up-right me-1"></i>Open in New Tab
                </a>
                <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<partial name="_LabReportPrintModal" />

@section Scripts {
    <partial name="_LabReportPrintScripts" />
    <script src="~/lib/chartjs/chart.umd.min.js"></script>
    <script>
        function openDocModal(path) {
            if (!path) return;
            const ext = path.split('.').pop().toLowerCase();
            const isImg = ['jpg', 'jpeg', 'png', 'gif', 'webp', 'bmp'].includes(ext);
            const isPdf = ext === 'pdf';

            const img = document.getElementById('docImg');
            const frame = document.getElementById('docFrame');
            const fallback = document.getElementById('docFallback');

            img.style.display = 'none';
            frame.style.display = 'none';
            fallback.style.display = 'none';
            img.src = '';
            frame.src = '';

            if (isImg) {
                img.src = path;
                img.style.display = '';
            } else if (isPdf) {
                frame.src = path;
                frame.style.display = '';
            } else {
                document.getElementById('docDownloadBtn').href = path;
                fallback.style.display = '';
            }

            document.getElementById('docFileName').textContent = path.split('/').pop();
            document.getElementById('docOpenLink').href = path;

            new bootstrap.Modal(document.getElementById('docViewerModal')).show();
        }

        // ── Chart.js AJAX Rendering Logic ──────────────────────────────────────
        const patientId = @Model.Patient.PatientId;
        let vitalsData = null;
        let visitsData = null;
        let vitalsChartInstance = null;
        let visitsChartInstance = null;

        // Listen for tab changes
        document.querySelectorAll('button[data-bs-toggle="tab"]').forEach(tabEl => {
            tabEl.addEventListener('shown.bs.tab', function (event) {
                if (event.target.id === 'vital-graph-tab') {
                    loadVitalsChart();
                } else if (event.target.id === 'visit-graph-tab') {
                    loadVisitsChart();
                }
            });
        });

        // Listen for metric change
        document.getElementById('vitalMetricSelect')?.addEventListener('change', function () {
            if (vitalsData) {
                renderVitalsChart();
            }
        });

        // Listen for visit metric change
        document.getElementById('visitMetricSelect')?.addEventListener('change', function () {
            if (visitsData) {
                renderVisitsChart();
            }
        });

        async function loadVitalsChart() {
            if (vitalsData) return;

            const loader = document.getElementById('vitalsChartLoader');
            const emptyMsg = document.getElementById('vitalsChartEmpty');
            const canvas = document.getElementById('vitalsChart');

            loader.style.display = '';
            emptyMsg.style.display = 'none';
            canvas.style.display = 'none';

            try {
                const res = await fetch(`/OPD/GetPatientVitalsChartData?id=${patientId}`);
                if (!res.ok) throw new Error();
                vitalsData = await res.json();
                
                loader.style.display = 'none';
                if (!vitalsData || vitalsData.length === 0) {
                    emptyMsg.style.display = '';
                } else {
                    canvas.style.display = '';
                    renderVitalsChart();
                }
            } catch (err) {
                loader.style.display = 'none';
                emptyMsg.style.display = '';
                emptyMsg.querySelector('span').textContent = 'Error loading vitals graph data.';
            }
        }

        function renderVitalsChart() {
            const ctx = document.getElementById('vitalsChart').getContext('2d');
            const metric = document.getElementById('vitalMetricSelect').value;

            if (vitalsChartInstance) {
                vitalsChartInstance.destroy();
            }

            const labels = vitalsData.map(d => d.recordedOn);
            let datasets = [];

            if (metric === 'bp') {
                datasets = [
                    {
                        label: 'Systolic BP (mmHg)',
                        data: vitalsData.map(d => d.bpSystolic),
                        borderColor: '#dc3545',
                        backgroundColor: '#dc354522',
                        borderWidth: 2,
                        tension: 0.3,
                        spanGaps: true
                    },
                    {
                        label: 'Diastolic BP (mmHg)',
                        data: vitalsData.map(d => d.bpDiastolic),
                        borderColor: '#ffc107',
                        backgroundColor: '#ffc10722',
                        borderWidth: 2,
                        tension: 0.3,
                        spanGaps: true
                    }
                ];
            } else if (metric === 'pulse') {
                datasets = [{
                    label: 'Pulse Rate (bpm)',
                    data: vitalsData.map(d => d.pulseRate),
                    borderColor: '#198754',
                    backgroundColor: '#19875422',
                    borderWidth: 2,
                    tension: 0.3,
                    spanGaps: true
                }];
            } else if (metric === 'temp') {
                datasets = [{
                    label: 'Temperature (°F)',
                    data: vitalsData.map(d => d.temperature),
                    borderColor: '#0d6efd',
                    backgroundColor: '#0d6efd22',
                    borderWidth: 2,
                    tension: 0.3,
                    spanGaps: true
                }];
            } else if (metric === 'weight') {
                datasets = [{
                    label: 'Weight (kg)',
                    data: vitalsData.map(d => d.weight),
                    borderColor: '#6f42c1',
                    backgroundColor: '#6f42c122',
                    borderWidth: 2,
                    tension: 0.3,
                    spanGaps: true
                }];
            }

            vitalsChartInstance = new Chart(ctx, {
                type: 'line',
                data: { labels, datasets },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        y: {
                            beginAtZero: false
                        }
                    },
                    plugins: {
                        legend: {
                            position: 'top',
                        }
                    }
                }
            });
        }

        async function loadVisitsChart() {
            if (visitsData) return;

            const loader = document.getElementById('visitsChartLoader');
            const emptyMsg = document.getElementById('visitsChartEmpty');
            const canvas = document.getElementById('visitsChart');

            loader.style.display = '';
            emptyMsg.style.display = 'none';
            canvas.style.display = 'none';

            try {
                const res = await fetch(`/OPD/GetPatientVisitsChartData?id=${patientId}`);
                if (!res.ok) throw new Error();
                visitsData = await res.json();

                loader.style.display = 'none';
                if (!visitsData || (!visitsData.billData.length && !visitsData.consultingData.length)) {
                    emptyMsg.style.display = '';
                } else {
                    canvas.style.display = '';
                    renderVisitsChart();
                }
            } catch (err) {
                loader.style.display = 'none';
                emptyMsg.style.display = '';
                emptyMsg.querySelector('span').textContent = 'Error loading visit trends data.';
            }
        }

        function renderVisitsChart() {
            const ctx = document.getElementById('visitsChart').getContext('2d');
            const metric = document.getElementById('visitMetricSelect').value;

            if (visitsChartInstance) {
                visitsChartInstance.destroy();
            }

            let labels = [];
            let data = [];
            let datasetLabel = '';
            let bgColor = '';
            let ticksCallback = null;
            let stepSize = undefined;

            if (metric === 'amount') {
                labels = visitsData.billData.map(d => d.visitDate);
                data = visitsData.billData.map(d => d.totalAmount);
                datasetLabel = 'Billing Amount (₹)';
                bgColor = '#ffc107dd';
                ticksCallback = function(value) { return '₹ ' + value; };
            } else {
                labels = visitsData.consultingData.map(d => d.doctorName);
                data = visitsData.consultingData.map(d => d.consultingCount);
                datasetLabel = 'Doctor Consulting Count';
                bgColor = '#198754dd'; // success color
                ticksCallback = function(value) { return value; };
                stepSize = 1;
            }

            visitsChartInstance = new Chart(ctx, {
                type: 'bar',
                data: {
                    labels,
                    datasets: [{
                        label: datasetLabel,
                        data: data,
                        borderColor: bgColor.substring(0, 7),
                        backgroundColor: bgColor,
                        borderWidth: 1,
                        borderRadius: 4
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: {
                                callback: ticksCallback,
                                stepSize: stepSize
                            }
                        }
                    },
                    plugins: {
                        legend: {
                            position: 'top'
                        }
                    }
                }
            });
        }
    </script>
}
