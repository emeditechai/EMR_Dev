@{
    ViewData["Title"] = "Doctor Dashboard";
    var doctors = ViewBag.Doctors as IEnumerable<(int DoctorId, string FullName, int? PrimarySpecialityId, string Gender)> ?? new List<(int, string, int?, string)>();
    var defaultDoctorId = ViewBag.DefaultDoctorId is int id ? id : 0;
    var doctorRoomMap = ViewBag.DoctorRoomMap as Dictionary<string, string> ?? new Dictionary<string, string>();
    // header: the doctor's own name for a doctor, else "Doctor Dashboard"; initials drawn from that name
    var isDoctorLogin = ViewBag.IsDoctor is bool isDoc && isDoc;
    var ownDoctorName = ViewBag.DoctorName as string;
    var heroTitle = isDoctorLogin && !string.IsNullOrWhiteSpace(ownDoctorName) ? ownDoctorName! : "Doctor Dashboard";
    var heroSource = isDoctorLogin ? heroTitle : (User.FindFirst("DisplayName")?.Value ?? User.Identity?.Name ?? "Doctor");
    var heroWords = System.Text.RegularExpressions.Regex.Replace(heroSource, @"^(dr|prof|mr|mrs|ms)\.?\s+", "", System.Text.RegularExpressions.RegexOptions.IgnoreCase)
        .Split(' ', StringSplitOptions.RemoveEmptyEntries);
    var heroInitials = string.Concat(heroWords.Take(2).Select(w => char.ToUpperInvariant(w[0])));
    if (heroInitials.Length == 0) heroInitials = "DR";
}

<!-- Bootstrap Select CSS -->
<link rel="stylesheet" href="~/lib/bootstrap-select/dist/css/bootstrap-select.min.css">
<link href="~/lib/quill/quill.snow.css" rel="stylesheet" />

<div class="container-fluid dd-page" id="config-page-container">
    @if (ViewBag.NoOwnDoctor == true)
    {
        <div class="alert alert-warning d-flex align-items-center gap-2 py-2 mb-3">
            <i class="bi bi-person-exclamation fs-5"></i>
            <div><b>No doctor is linked to your login.</b> The Doctor Dashboard shows only your own doctor's queue.
                Ask an administrator to link your user to your doctor in Doctor Master (Login Account).</div>
        </div>
    }

    <!-- Header: who, when, where + console controls -->
    <section class="dd-hero">
        <div class="dd-hero-id">
            <div class="dd-avatar" aria-hidden="true">@heroInitials</div>
            <div class="min-w-0">
                <div class="dd-eyebrow"><span id="ddGreeting">Welcome</span><span class="dd-dot-sep">·</span><span id="ddToday"></span></div>
                <h1 class="dd-title">@heroTitle</h1>
                <div class="dd-sub">
                    <span class="dd-live"><span class="dd-live-dot"></span>Live queue &amp; consultation console</span>
                    <!-- Room Badge -->
                    <span id="roomBadgeContainer" class="d-inline-flex align-items-center"></span>
                </div>
            </div>
        </div>

        <div class="dd-hero-actions">
            <!-- Doctor Select Dropdown (administrators) -->
            <div class="dd-doctor-pick @(ViewBag.IsDoctor == true ? "d-none" : "")">
                <select id="ddlDoctorDashboard" class="selectpicker-custom form-control form-control-sm" data-live-search="true" title="Select doctor" onchange="onDoctorChanged()">
                    @foreach (var doc in doctors)
                    {
                        var isDefault = doc.DoctorId == defaultDoctorId ? "selected" : "";
                        var roomInfo = doctorRoomMap.TryGetValue(doc.FullName, out var rm) ? $" ({rm})" : "";
                        <!option value="@doc.DoctorId" data-gender="@doc.Gender" @isDefault>@doc.FullName @roomInfo</!option>
                    }
                </select>
            </div>

            @if (ViewBag.IsDoctor == true)
            {
                <a href="@Url.Action("MyRoster", "OPD")" class="dd-btn dd-btn-soft" title="My roster: my shifts, leave and bookings">
                    <i class="bi bi-calendar2-week"></i><span>My Roster</span>
                </a>
            }
            else if (ViewBag.CanOpenFullRoster == true)
            {
                <a href="@Url.Action("Index", "DoctorRoster")" class="dd-btn dd-btn-soft" title="Doctor roster: shifts, leave and bookings of every doctor">
                    <i class="bi bi-calendar2-week"></i><span>Doctor Roster</span>
                </a>
            }

            <!-- Auto Refresh Switch -->
            <div class="dd-refresh form-check form-switch mb-0" title="Refresh the queue every 30 seconds">
                <input class="form-check-input" type="checkbox" role="switch" id="chkAutoRefresh" checked onchange="toggleAutoRefresh()">
                <label class="form-check-label" for="chkAutoRefresh">Auto <span id="lblCountdown" class="dd-countdown"></span></label>
            </div>

            <!-- Controls -->
            <button class="dd-icon-btn" id="darkModeToggle" onclick="toggleDarkMode()" title="Toggle theme" aria-label="Toggle theme">
                <i class="bi bi-moon-stars-fill" id="darkModeIcon"></i>
            </button>
            <button class="dd-icon-btn dd-icon-btn-primary" onclick="fetchQueue()" title="Refresh queue now" aria-label="Refresh queue">
                <i class="bi bi-arrow-clockwise"></i>
            </button>
        </div>
    </section>

    <!-- Today at a glance -->
    <section class="dd-kpis">
        <div class="dd-kpi dd-kpi-indigo">
            <div class="dd-kpi-icon"><i class="bi bi-people-fill"></i></div>
            <div class="dd-kpi-body">
                <span class="dd-kpi-label">Waiting in queue</span>
                <span class="dd-kpi-value" id="statWaiting">0</span>
                <span class="dd-kpi-note"><span id="statSkipped">0</span> skipped</span>
            </div>
        </div>
        <div class="dd-kpi dd-kpi-green">
            <div class="dd-kpi-icon"><i class="bi bi-check2-circle"></i></div>
            <div class="dd-kpi-body">
                <span class="dd-kpi-label">Completed today</span>
                <span class="dd-kpi-value" id="statCompleted">0</span>
                <div class="dd-progress" title="Share of today's patients seen"><span id="statProgressBar" style="width:0%"></span></div>
                <span class="dd-kpi-note"><span id="statProgressPct">0%</span> of today's patients</span>
            </div>
        </div>
        <div class="dd-kpi dd-kpi-sky">
            <div class="dd-kpi-icon"><i class="bi bi-calendar2-check-fill"></i></div>
            <div class="dd-kpi-body">
                <span class="dd-kpi-label">Today's patients</span>
                <span class="dd-kpi-value" id="statTotal">0</span>
                <span class="dd-kpi-note"><i class="bi bi-person-walking"></i> <span id="statWalkIn">0</span> walk-in · <i class="bi bi-camera-video"></i> <span id="statVideo">0</span> video</span>
            </div>
        </div>
        <div class="dd-kpi dd-kpi-amber">
            <div class="dd-kpi-icon"><i class="bi bi-megaphone-fill"></i></div>
            <div class="dd-kpi-body min-w-0">
                <span class="dd-kpi-label">Now consulting</span>
                <span class="dd-kpi-value dd-kpi-text text-truncate" id="statActivePatient">None</span>
                <span class="dd-kpi-note" id="statActiveNote">Click <b>Start EMR</b> on a patient to begin</span>
            </div>
        </div>
    </section>

    <!-- Main Workspace -->
    <div class="row g-3">
        <!-- Left: Patients Queue -->
        <div class="col-xl-8">
            <div class="card dd-card overflow-hidden">
                <!-- Title, segmented tabs and search -->
                <div class="dd-card-head" id="queueTableHeader">
                    <div class="dd-card-title">
                        <i class="bi bi-list-ol"></i>
                        <div>
                            <h2>Patient queue</h2>
                            <span>Today's consultations in token order</span>
                        </div>
                    </div>
                    <div class="d-flex align-items-center flex-wrap gap-2">
                        <div class="segmented-tabs" id="queueTabs">
                            <button class="segmented-tab active" id="tabActive" onclick="changeQueueTab('active')">
                                <i class="bi bi-people"></i> Active <span class="badge bg-secondary" id="badgeActiveCount">0</span>
                            </button>
                            <button class="segmented-tab" id="tabCompleted" onclick="changeQueueTab('completed')">
                                <i class="bi bi-check-circle"></i> Completed <span class="badge bg-secondary" id="badgeCompletedCount">0</span>
                            </button>
                        </div>
                        <!-- Search Filter -->
                        <div class="dd-search">
                            <i class="bi bi-search"></i>
                            <input type="text" id="queueSearch" placeholder="Search name, ID or token" class="form-control form-control-sm" oninput="filterQueueTable()" aria-label="Search the queue">
                        </div>
                    </div>
                </div>

                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table align-middle mb-0 dd-queue" id="queueTable">
                            <thead>
                                <tr>
                                    <th class="ps-3" style="width: 76px;">Token</th>
                                    <th>Patient</th>
                                    <th>Visit time</th>
                                    <th>Status &amp; dues</th>
                                    <th class="text-end pe-3">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td colspan="5" class="text-center py-4 text-muted">
                                        <i class="spinner-border text-primary spinner-border-sm me-2"></i> Loading queue...
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right: Active Patient Profile & Vitals -->
        <div class="col-xl-4">
            <div class="card dd-card dd-patient-card" id="patientDetailCard">
                <div class="dd-empty">
                    <div class="dd-empty-icon"><i class="bi bi-person-vcard"></i></div>
                    <h3>No patient active</h3>
                    <p>Select a patient in the queue and click <strong>Start EMR</strong> to see their profile and latest vitals.</p>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Dynamic EMR Consultation Modal -->
<div class="modal fade" id="emrConsultationModal" tabindex="-1" aria-labelledby="emrConsultationModalLabel" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 16px;">
            <div class="modal-header bg-primary text-white py-3 px-4 border-0">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-journal-medical fs-4"></i>
                    <div>
                        <h5 class="modal-title fw-bold mb-0" id="emrConsultationModalLabel">EMR Clinical Consultation</h5>
                        <small class="text-white-50 fs-8" id="emrTemplateNameSub">Speciality EMR Template</small>
                    </div>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body bg-light-subtle px-4 py-3">
                <!-- Vitals Strip Reference -->
                <div class="card border-0 shadow-xs mb-3 bg-white p-2.5 rounded-12">
                    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 fs-7.5">
                        <span class="fw-bold text-secondary"><i class="bi bi-activity text-danger me-1"></i>Active Patient Vitals Reference:</span>
                        <div class="d-flex flex-wrap gap-3" id="emrVitalsReference">
                            <!-- Populated dynamically -->
                        </div>
                    </div>
                </div>

                <!-- Common EMR Header (Fixed Fields) -->
                <div class="card border-0 shadow-sm mb-4 bg-white rounded-12 overflow-hidden">
                    <div class="card-header bg-light py-2 px-3 border-0">
                        <span class="fw-bold text-secondary small text-uppercase"><i class="bi bi-person-lines-fill me-1"></i>Common Patient Header</span>
                    </div>
                    <div class="card-body py-3">
                        <div class="row g-3 small">
                            <input type="hidden" id="emrPatientId" />
                            <input type="hidden" id="emrDoctorId" />
                            <input type="hidden" id="emrTemplateId" />
                            <input type="hidden" id="emrOPDServiceId" />

                            <div class="col-md-3 col-sm-6">
                                <label class="form-label fw-semibold text-muted mb-1">OPD BILL NO</label>
                                <input type="text" id="emrOPDBillNo" class="form-control form-control-sm bg-light" readonly />
                            </div>
                            <div class="col-md-3 col-sm-6">
                                <label class="form-label fw-semibold text-muted mb-1">PATIENT ID</label>
                                <input type="text" id="emrPatientCode" class="form-control form-control-sm bg-light" readonly />
                            </div>
                            <div class="col-md-3 col-sm-6">
                                <label class="form-label fw-semibold text-muted mb-1">PATIENT NAME</label>
                                <input type="text" id="emrPatientName" class="form-control form-control-sm bg-light fw-bold" readonly />
                            </div>
                            <div class="col-md-3 col-sm-6">
                                <label class="form-label fw-semibold text-muted mb-1">GENDER</label>
                                <input type="text" id="emrGender" class="form-control form-control-sm bg-light" readonly />
                            </div>
                            <div class="col-md-3 col-sm-6">
                                <label class="form-label fw-semibold text-muted mb-1">DOB / AGE</label>
                                <input type="text" id="emrAge" class="form-control form-control-sm bg-light" readonly />
                            </div>
                            <div class="col-md-3 col-sm-6">
                                <label class="form-label fw-semibold text-muted mb-1">MOBILE NUMBER</label>
                                <input type="text" id="emrMobileNumber" class="form-control form-control-sm bg-light" readonly />
                            </div>
                            <div class="col-md-3 col-sm-6">
                                <label class="form-label fw-semibold text-muted mb-1">VISIT DATE & TIME</label>
                                <input type="text" id="emrVisitDate" class="form-control form-control-sm bg-light" readonly />
                            </div>
                            <div class="col-md-3 col-sm-6">
                                <label class="form-label fw-semibold text-muted mb-1">VISIT TYPE <span class="text-danger">*</span></label>
                                <select id="emrVisitType" class="form-select form-select-sm">
                                    <option value="New">New Consultation</option>
                                    <option value="Follow-up">Follow-up Visit</option>
                                </select>
                            </div>
                            <div class="col-md-3 col-sm-6">
                                <label class="form-label fw-semibold text-muted mb-1">CONSULTATION TYPE <span class="text-danger">*</span></label>
                                <select id="emrConsultationType" class="form-select form-select-sm">
                                    <option value="Walking">Walking / OPD</option>
                                    <option value="Video">Video Consultation</option>
                                </select>
                            </div>
                            @* Refer To Doctor (optional): search a speciality, then a doctor of it; Follow-Up Date (optional) - SQLScripts/2229 *@
                            <div class="col-md-3 col-sm-6">
                                <label class="form-label fw-semibold text-muted mb-1" for="emrReferSpeciality">REFER TO &middot; SPECIALITY <span class="fw-normal text-muted">(optional)</span></label>
                                <select id="emrReferSpeciality" class="form-control form-control-sm" data-live-search="true" data-container="body" data-size="8" title="Search speciality...">
                                    <option value="">&mdash; No referral &mdash;</option>
                                </select>
                            </div>
                            <div class="col-md-3 col-sm-6">
                                <label class="form-label fw-semibold text-muted mb-1" for="emrReferDoctor">REFER TO &middot; DOCTOR</label>
                                <select id="emrReferDoctor" class="form-control form-control-sm" data-live-search="true" data-container="body" data-size="8" title="Select a speciality first" disabled></select>
                            </div>
                            <div class="col-md-3 col-sm-6">
                                <label class="form-label fw-semibold text-muted mb-1" for="emrFollowUpDate">FOLLOW-UP DATE <span class="fw-normal text-muted">(optional)</span></label>
                                <div class="input-group input-group-sm">
                                    <input type="date" id="emrFollowUpDate" class="form-control" autocomplete="off" />
                                    <button type="button" class="btn btn-outline-secondary" id="btnClearFollowUp" title="Clear follow-up date" aria-label="Clear follow-up date"><i class="bi bi-x-lg"></i></button>
                                </div>
                                <div class="form-text small mb-0" id="emrFollowUpHint"></div>
                                <div class="d-flex flex-wrap gap-1 mt-1" id="emrFollowUpQuick">
                                    <button type="button" class="btn btn-outline-secondary btn-sm py-0 px-2" data-days="7">1 wk</button>
                                    <button type="button" class="btn btn-outline-secondary btn-sm py-0 px-2" data-days="15">15 d</button>
                                    <button type="button" class="btn btn-outline-secondary btn-sm py-0 px-2" data-days="30">1 mo</button>
                                    <button type="button" class="btn btn-outline-secondary btn-sm py-0 px-2" data-days="90">3 mo</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Dynamic EMR Fields Canvas -->
                <div id="emrDynamicFieldsCanvas">
                    <!-- Dynamic sections & fields will load here via JavaScript -->
                </div>
            </div>
            <div class="modal-footer bg-light border-0 py-3 px-4 d-flex justify-content-between">
                <div>
                    <button type="button" class="btn btn-outline-info" id="btnPrintEmrRecord">
                        <i class="bi bi-printer me-1"></i>Print Consultation
                    </button>
                </div>
                <div class="d-flex gap-2">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                    <button type="button" class="btn btn-primary px-4 fw-bold" id="btnSaveEmrRecord">
                        <i class="bi bi-check-circle me-1"></i>Save Consultation
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- Bootstrap Select JS -->
    <script src="~/lib/bootstrap-select/dist/js/bootstrap-select.min.js"></script>
    <!-- Quill Rich Text Editor -->
    <script src="~/lib/quill/quill.min.js"></script>
    <style>
        .pd-tool.active { background-color: #6c757d !important; color: #fff !important; border-color: #6c757d !important; }
        .rt-wrapper-dash .ql-toolbar.ql-snow { border-radius: 6px 6px 0 0; border-color: #dee2e6; }
        .rt-wrapper-dash .ql-container.ql-snow { border-radius: 0 0 6px 6px; border-color: #dee2e6; min-height: 130px; }
        .pd-canvas { touch-action: none; }
    </style>

    <style>
        /* Compact layout overrides */
        #config-page-container {
            padding: 0.85rem !important;
        }
        #queueTable th, #queueTable td {
            padding: 8px 12px !important;
            font-size: 0.82rem !important;
        }
        #queueTable td .badge {
            font-size: 0.72rem !important;
            padding: 3px 6px !important;
        }
        .font-xs {
            font-size: 0.72rem !important;
        }

        .rounded-12 {
            border-radius: 12px !important;
        }
        .shadow-xs {
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.02) !important;
        }
        .bg-light-primary {
            background-color: rgba(99, 102, 241, 0.08) !important;
        }
        .bg-light-success {
            background-color: rgba(16, 185, 129, 0.08) !important;
        }
        .bg-light-warning {
            background-color: rgba(245, 158, 11, 0.08) !important;
        }
        .btn-xs {
            padding: 0.15rem 0.4rem;
            font-size: 0.72rem;
            border-radius: 4px;
        }
        
        /* Auto countdown styles */
        #lblCountdown {
            font-variant-numeric: tabular-nums;
        }
        
        /* Color system & variables */
        body {
            --bg-main: #f8fafc;
            --bg-card: #ffffff;
            --bg-header: #ffffff;
            --border-color: #e2e8f0;
            --text-primary: #0f172a;
            --text-secondary: #475569;
            --text-muted: #64748b;
            --table-hover-bg: #f8fafc;
            --btn-light-bg: #f8fafc;
            --btn-light-border: #e2e8f0;
            --modal-bg: #ffffff;
            --modal-header-bg: #f8fafc;
            --input-bg: #ffffff;
            --input-border: #cbd5e1;
            --input-text: #0f172a;
            --vital-box-bg: #f8fafc;
            --card-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.03), 0 2px 4px -2px rgb(0 0 0 / 0.03);
            --card-shadow-hover: 0 10px 15px -3px rgb(0 0 0 / 0.05), 0 4px 6px -4px rgb(0 0 0 / 0.05);
            --accent-primary: #6366f1;
            --accent-primary-hover: #4f46e5;
            --accent-primary-light: rgba(99, 102, 241, 0.06);
        }

        body.dark-mode {
            --bg-main: #0b0f19;
            --bg-card: #151b2c;
            --bg-header: #151b2c;
            --border-color: #242f47;
            --text-primary: #f8fafc;
            --text-secondary: #94a3b8;
            --text-muted: #64748b;
            --table-hover-bg: #1e293b;
            --btn-light-bg: #1e2538;
            --btn-light-border: #242f47;
            --modal-bg: #151b2c;
            --modal-header-bg: #0b0f19;
            --input-bg: #0b0f19;
            --input-border: #242f47;
            --input-text: #f8fafc;
            --vital-box-bg: #151b2c;
            --card-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.2), 0 2px 4px -2px rgb(0 0 0 / 0.2);
            --card-shadow-hover: 0 10px 15px -3px rgb(0 0 0 / 0.3), 0 4px 6px -4px rgb(0 0 0 / 0.3);
            --accent-primary: #818cf8;
            --accent-primary-hover: #6366f1;
            --accent-primary-light: rgba(129, 140, 248, 0.12);
        }
        
        /* Interactive Stat Cards */
        .stat-card {
            border: 1px solid var(--border-color) !important;
            background: var(--bg-card) !important;
            box-shadow: var(--card-shadow) !important;
            border-radius: 16px !important;
            transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
            overflow: hidden;
            position: relative;
        }
        .stat-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 4px;
            height: 100%;
        }
        .stat-card-waiting::before { background: var(--accent-primary); }
        .stat-card-completed::before { background: #10b981; }
        .stat-card-active::before { background: #f59e0b; }

        .stat-card:hover {
            transform: translateY(-3px);
            box-shadow: var(--card-shadow-hover) !important;
        }
        
        /* Icon color classes */
        .icon-box-purple {
            background-color: rgba(99, 102, 241, 0.08) !important;
            color: var(--accent-primary) !important;
        }
        .icon-box-green {
            background-color: rgba(16, 185, 129, 0.08) !important;
            color: #10b981 !important;
        }
        .icon-box-orange {
            background-color: rgba(245, 158, 11, 0.08) !important;
            color: #f59e0b !important;
        }
        
        /* Segmented Tabs */
        .segmented-tabs {
            background-color: var(--btn-light-bg);
            border: 1px solid var(--border-color);
            padding: 4px;
            border-radius: 12px;
            display: inline-flex;
            gap: 4px;
        }
        .segmented-tab {
            border: none;
            background: transparent;
            color: var(--text-secondary);
            padding: 8px 16px;
            border-radius: 8px;
            font-size: 0.875rem;
            font-weight: 500;
            transition: all 0.2s ease;
            display: flex;
            align-items: center;
            gap: 6px;
        }
        .segmented-tab.active {
            background-color: var(--accent-primary);
            color: #ffffff;
            box-shadow: 0 4px 10px rgba(99, 102, 241, 0.2);
        }
        .segmented-tab .badge {
            font-size: 0.72rem;
            padding: 2px 6px;
            border-radius: 6px;
        }
        .segmented-tab.active .badge {
            background-color: rgba(255, 255, 255, 0.2) !important;
            color: #ffffff !important;
        }
        
        /* Calling sound wave animation */
        .sound-wave {
            display: inline-flex;
            align-items: center;
            gap: 3px;
            height: 12px;
            margin-left: 8px;
        }
        .sound-wave span {
            display: block;
            width: 2.5px;
            height: 4px;
            background-color: #3b82f6;
