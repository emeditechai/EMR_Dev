        let currentSchedulesList = [];
        let activePatientId = null;
        let activeOPDServiceId = null;
        let autoRefreshInterval = null;
        let refreshCountdown = 30;
        
        // Global variables for queue and tabs
        let allQueuePatients = [];
        let activeQueueTab = 'active'; // 'active' or 'completed'
        
        // Use a Set to track which patients have been called in this session
        const calledPatientsSet = new Set();
        let callingPatientId = null;

        const doctorRoomMap = @Html.Raw(Json.Serialize(doctorRoomMap));

        function toggleDarkMode() {
            const container = document.getElementById('config-page-container');
            if (!container) return;
            
            const isDark = container.classList.toggle('dark-mode');
            document.body.classList.toggle('dark-mode', isDark);
            
            // Save preference
            localStorage.setItem('theme', isDark ? 'dark' : 'light');
            
            // Update button UI
            const icon = document.getElementById('darkModeIcon');
            const text = document.getElementById('darkModeText');
            if (isDark) {
                if (icon) icon.className = 'bi bi-sun-fill text-warning';
                if (text) text.innerText = 'Light Mode';
            } else {
                if (icon) icon.className = 'bi bi-moon-stars-fill';
                if (text) text.innerText = 'Dark Mode';
            }
        }

        // Dark Mode self-executing preference load
        (function() {
            const theme = localStorage.getItem('theme');
            if (theme === 'dark') {
                document.body.classList.add('dark-mode');
                document.addEventListener('DOMContentLoaded', () => {
                    const container = document.getElementById('config-page-container');
                    if (container) {
                        container.classList.add('dark-mode');
                        const icon = document.getElementById('darkModeIcon');
                        const text = document.getElementById('darkModeText');
                        if (icon) icon.className = 'bi bi-sun-fill text-warning';
                        if (text) text.innerText = 'Light Mode';
                    }
                });
            }
        })();

        // Auto Refresh Handlers
        function startAutoRefresh() {
            stopAutoRefresh();
            refreshCountdown = 30;
            updateCountdownLabel();
            
            autoRefreshInterval = setInterval(() => {
                refreshCountdown--;
                updateCountdownLabel();
                
                if (refreshCountdown <= 0) {
                    fetchQueue();
                    refreshCountdown = 30;
                }
            }, 1000);
        }

        // Search queue filter
        function filterQueueTable() {
            const q = document.getElementById('queueSearch').value.toLowerCase().trim();
            const rows = document.querySelectorAll('#queueTable tbody tr');
            rows.forEach(row => {
                // Ignore spinner loading rows
                if (row.cells.length === 1 && row.cells[0].colSpan === 5) return;
                
                const text = row.innerText.toLowerCase();
                if (text.includes(q)) {
                    row.style.display = '';
                } else {
                    row.style.display = 'none';
                }
            });
        }

        function stopAutoRefresh() {
            if (autoRefreshInterval) {
                clearInterval(autoRefreshInterval);
                autoRefreshInterval = null;
            }
            document.getElementById('lblCountdown').innerText = '';
        }

        function toggleAutoRefresh() {
            const chk = document.getElementById('chkAutoRefresh');
            if (chk.checked) {
                startAutoRefresh();
            } else {
                stopAutoRefresh();
            }
        }

        function updateCountdownLabel() {
            const lbl = document.getElementById('lblCountdown');
            if (lbl && autoRefreshInterval) {
                lbl.innerText = `(${refreshCountdown}s)`;
            }
        }

        function onDoctorChanged() {
            fetchQueue();
            updateRoomBadge();
        }

        function updateRoomBadge() {
            const select = document.getElementById('ddlDoctorDashboard');
            const container = document.getElementById('roomBadgeContainer');
            container.innerHTML = '';
            
            if (select && select.selectedOptions && select.selectedOptions[0]) {
                const docName = select.selectedOptions[0].text.split(' (')[0];
                const roomInfo = doctorRoomMap[docName];
                if (roomInfo) {
                    container.innerHTML = `
                        <span class="badge bg-purple border text-white px-3 py-2 rounded-pill fs-7 shadow-xs">
                            <i class="bi bi-geo-alt-fill me-1"></i>${roomInfo}
                        </span>`;
                }
            }
        }

        function changeQueueTab(tabName) {
            activeQueueTab = tabName;
            document.querySelectorAll('.segmented-tab').forEach(t => t.classList.remove('active'));
            if (tabName === 'active') {
                document.getElementById('tabActive').classList.add('active');
            } else {
                document.getElementById('tabCompleted').classList.add('active');
            }
            renderQueueTable();
        }

        async function fetchQueue() {
            const select = document.getElementById('ddlDoctorDashboard');
            if (!select || !select.value) {
                renderEmptyQueue("Please select a doctor to load the consulting queue.");
                return;
            }

            const doctorId = select.value;
            try {
                const res = await fetch(`/OPD/GetDoctorConsultingQueue?doctorId=${doctorId}`);
                const result = await res.json();
                
                if (result.isSuccess) {
                    document.getElementById('statWaiting').innerText = result.totalWaiting;
                    document.getElementById('statCompleted').innerText = result.totalCompleted;
                    
                    allQueuePatients = result.data || [];
                    renderQueueTable();

                    // Auto-select patient from URL if present
                    const urlParams = new URLSearchParams(window.location.search);
                    const autoPatientId = urlParams.get('patientId');
                    if (autoPatientId && !window._autoSelected) {
                        window._autoSelected = true;
                        const patient = allQueuePatients.find(p => p.patientId == autoPatientId);
                        if (patient) {
                            const pyStatus = (patient.paymentStatus || 'U').toUpperCase();
                            const hasDue = pyStatus === 'U' || pyStatus === 'R';
                            startConsulting(patient.opdServiceId, patient.patientId, patient.patientName, patient.patientCode, patient.gender, patient.age, patient.tokenNo, hasDue);
                        }
                    }
                } else {
                    console.error("Error loading queue details.");
                }
            } catch (err) {
                console.error("Connection failed:", err);
            }
        }

        // ── Look helpers: initials avatar, today-at-a-glance cards, greeting ──
        const ddPalette = ['#4f46e5', '#059669', '#e11d48', '#d97706', '#0284c7', '#c026d3', '#0891b2', '#16a34a', '#7c3aed', '#475569'];
        function avatarColor(id) { return ddPalette[Math.abs(parseInt(id, 10) || 0) % ddPalette.length]; }
        function initialsOf(name) {
            const words = String(name || '').replace(/^(mr|mrs|ms|miss|dr|master|baby)\.?\s+/i, '').trim().split(/\s+/).filter(Boolean);
            return (words.slice(0, 2).map(w => w[0]).join('') || '?').toUpperCase();
        }
        function updateGlanceCards(list, completedCount) {
            const total = list.length;
            const set = (id, v) => { const el = document.getElementById(id); if (el) el.innerText = v; };
            set('statTotal', total);
            set('statSkipped', list.filter(x => x.status === 'Skipped').length);
            const video = list.filter(x => (x.consultingType || '').toLowerCase() === 'video').length;
            set('statVideo', video);
            set('statWalkIn', total - video);
            const pct = total ? Math.round(completedCount * 100 / total) : 0;
            set('statProgressPct', pct + '%');
            const bar = document.getElementById('statProgressBar');
            if (bar) bar.style.width = pct + '%';
        }
        function paintGreeting() {
            const h = new Date().getHours();
            const g = document.getElementById('ddGreeting');
            if (g) g.innerText = h < 12 ? 'Good morning' : h < 17 ? 'Good afternoon' : 'Good evening';
            const d = document.getElementById('ddToday');
            if (d) d.innerText = new Date().toLocaleDateString('en-GB', { weekday: 'long', day: '2-digit', month: 'short', year: 'numeric' });
        }

        function renderEmptyQueue(message) {
            const tbody = document.querySelector('#queueTable tbody');
            tbody.innerHTML = `
                <tr>
                    <td colspan="5" class="dd-queue-empty">
                        <i class="bi bi-inbox"></i>
                        <p class="mb-0">${message}</p>
                    </td>
                </tr>`;
        }

        function renderQueueTable() {
            const list = allQueuePatients;
            const doctorId = document.getElementById('ddlDoctorDashboard')?.value || 0;
            
            // Count active vs completed in the result set
            const activePatients = list.filter(item => item.status === 'Consulting' || item.status === 'Skipped');
            const completedPatients = list.filter(item => item.status === 'Completed');
            
            // Update tab count badges
            const badgeActive = document.getElementById('badgeActiveCount');
            const badgeCompleted = document.getElementById('badgeCompletedCount');
            if (badgeActive) badgeActive.innerText = activePatients.length;
            if (badgeCompleted) badgeCompleted.innerText = completedPatients.length;
            updateGlanceCards(list, completedPatients.length);
            
            const filteredList = activeQueueTab === 'active' ? activePatients : completedPatients;
            
            const tbody = document.querySelector('#queueTable tbody');
            tbody.innerHTML = '';
            
            if (filteredList.length === 0) {
                renderEmptyQueue(activeQueueTab === 'active' 
                    ? "No pending patients in consulting queue for this doctor today."
                    : "No completed consultations today yet.");
                
                if (activeOPDServiceId) {
                    const exists = list.some(x => x.opdServiceId === activeOPDServiceId);
                    if (!exists) {
                        clearActivePatient();
                    }
                }
                return;
            }

            filteredList.forEach(item => {
                const tr = document.createElement('tr');
                tr.id = `queueRow-${item.opdServiceId}`;
                if (item.opdServiceId === activeOPDServiceId) {
                    tr.classList.add('active-row');
                }
                
                let visitTime = '--:--';
                if (item.slotStartTime) {
                    const parts = item.slotStartTime.split(':');
                    let hr = parseInt(parts[0], 10);
                    let min = parseInt(parts[1], 10);
                    
                    const formatTime = (h, m) => {
                        const ampm = h >= 12 ? 'PM' : 'AM';
                        const h12 = h % 12 || 12;
                        return `${h12.toString().padStart(2, '0')}:${m.toString().padStart(2, '0')} ${ampm}`;
                    };
                    
                    const startStr = formatTime(hr, min);
                    
                    if (item.slotDurationMinutes) {
                        min += item.slotDurationMinutes;
                        hr += Math.floor(min / 60);
                        min = min % 60;
                        const endStr = formatTime(hr, min);
                        visitTime = `${startStr} - ${endStr}`;
                    } else {
                        visitTime = startStr;
                    }
                } else if (item.visitDate) {
                    visitTime = new Date(item.visitDate).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
                }
                    
                const pyStatus = (item.paymentStatus || 'U').toUpperCase();
                const hasDue = pyStatus === 'U' || pyStatus === 'R';
                const dueBadge = hasDue
                    ? `<span class="dd-pill dd-pill-warn"><i class="bi bi-exclamation-triangle-fill"></i>${pyStatus === 'R' ? 'PARTIAL DUE' : 'DUE'}</span>`
                    : `<span class="dd-pill dd-pill-ok"><i class="bi bi-check-circle-fill"></i>PAID</span>`;

                // Called patient indicator
                const isCalled = calledPatientsSet.has(item.opdServiceId);
                const isCurrentlyCalling = callingPatientId === item.opdServiceId;
                
                let callingAnim = '';
                if (isCurrentlyCalling) {
                    callingAnim = `
                        <div class="sound-wave">
                            <span></span><span></span><span></span><span></span>
                        </div>
                    `;
                }
                
                const statusBadge = item.status === 'Completed'
                    ? `<span class="dd-pill dd-pill-done"><i class="bi bi-check-circle-fill"></i>COMPLETED</span>`
                    : item.status === 'Skipped'
                        ? `<span class="dd-pill dd-pill-skip"><i class="bi bi-skip-forward-fill"></i>SKIPPED</span>`
                        : isCalled
                            ? `<span class="dd-pill dd-pill-called"><i class="bi bi-megaphone-fill"></i>CALLED ${callingAnim}</span>`
                            : item.isEmrDone
                                ? `<span class="dd-pill dd-pill-emr"><i class="bi bi-clipboard2-check-fill"></i>EMR DONE</span>`
                                : `<span class="dd-pill dd-pill-wait"><i class="bi bi-hourglass-split"></i>WAITING</span>`;

                // Action buttons based on status
                let actionButtons = '';
                if (item.status === 'Completed') {
                    actionButtons = `
                        <button class="dd-act-main dd-act-outline" onclick="startConsulting(${item.opdServiceId}, ${item.patientId}, '${item.patientName}', '${item.patientCode}', '${item.gender}', ${item.age}, '${item.tokenNo || ''}', ${hasDue})">
                            <i class="bi bi-eye"></i> Review record
                        </button>
                    `;
                } else {
                    const skipButton = item.status === 'Skipped' ? '' : `
                        <button data-permission="OPD.DOCTORDASHBOARD:TOKEN_STATUS" class="dd-act-btn dd-act-skip" title="Skip / pass patient" aria-label="Skip patient" onclick="skipConsulting(${item.opdServiceId})">
                            <i class="bi bi-skip-forward"></i>
                        </button>
                    `;
                    actionButtons = `
                        <button class="dd-act-main" onclick="startConsulting(${item.opdServiceId}, ${item.patientId}, '${item.patientName}', '${item.patientCode}', '${item.gender}', ${item.age}, '${item.tokenNo || ''}', ${hasDue})">
                            <i class="bi bi-journal-medical"></i> Start EMR
                        </button>
                        <button class="dd-act-btn dd-act-call" title="Call patient" aria-label="Call patient" onclick="callPatient(${item.opdServiceId}, '${item.patientName}', '${item.tokenNo}')">
                            <i class="bi bi-megaphone"></i>
                        </button>
                        ${skipButton}
                        <button data-permission="OPD.DOCTORDASHBOARD:TOKEN_STATUS" class="dd-act-btn dd-act-done" title="Mark consultation completed" aria-label="Mark completed" onclick="completeConsulting(${item.opdServiceId}, '${item.patientName}', ${item.isEmrDone})">
                            <i class="bi bi-check-lg"></i>
                        </button>
                    `;
                }

                if (item.isEmrDone) {
                    actionButtons += `
                        <button class="dd-act-btn dd-act-print" title="Print prescription" aria-label="Print prescription" onclick="window.open('/OPD/PrintPrescription?opdServiceId=${item.opdServiceId}&doctorId=${doctorId}', '_blank')">
                            <i class="bi bi-printer"></i>
                        </button>
                    `;
                }
                // OPD > Certificates (SQLScripts/2341): certificate from this visit (hidden without the DRAFT control)
                actionButtons += `
                    <button data-permission="OPD.CERTIFICATES:DRAFT" class="dd-act-btn dd-act-print" title="Issue certificate" aria-label="Issue certificate" onclick="window.open('/Certificates/Create?opdServiceId=${item.opdServiceId}', '_blank')">
                        <i class="bi bi-patch-check"></i>
                    </button>
                `;

                // ── Video / Walk-In badge ────────────────────────────────────
                const isVideo = (item.consultingType || '').toLowerCase() === 'video';
                const consultTypeBadge = isVideo
                    ? `<span class="dd-pill dd-pill-video" title="Video consultation"><i class="bi bi-camera-video-fill"></i>Video</span>`
                    : `<span class="dd-pill dd-pill-walkin" title="Walk-in consultation"><i class="bi bi-person-walking"></i>Walk-in</span>`;

                // ── Join Video button (only for fully-paid video patients with a link) ──
                let videoBtn = '';
                if (isVideo && item.videoHostUrl) {
                    videoBtn = `<a href="${item.videoHostUrl}" target="_blank" class="dd-act-btn dd-act-video" title="Join video consultation as host" aria-label="Join video consultation">
                        <i class="bi bi-camera-video-fill"></i>
                    </a>`;
                }

                tr.innerHTML = `
                    <td class="ps-3"><span class="dd-token">${item.tokenNo || 'N/A'}</span></td>
                    <td>
                        <div class="dd-pt">
                            <div class="dd-pt-avatar" style="background:${avatarColor(item.patientId)}">${initialsOf(item.patientName)}</div>
                            <div class="min-w-0">
                                <div class="dd-pt-name">${item.patientName}</div>
                                <div class="dd-pt-meta">
                                    ${consultTypeBadge}
                                    <span>${item.patientCode} · ${item.gender || '-'}, ${item.age || '-'} yrs</span>
                                </div>
                            </div>
                        </div>
                    </td>
                    <td><span class="dd-time"><i class="bi bi-clock"></i>${visitTime}</span></td>
                    <td>
                        <div class="d-flex flex-column gap-1 align-items-start">
                            ${dueBadge}
                            ${statusBadge}
                        </div>
                    </td>
                    <td class="text-end pe-3">
                        <div class="dd-act">
                            ${videoBtn}
                            ${actionButtons}
                        </div>
                    </td>
                `;
                tbody.appendChild(tr);
            });

            filterQueueTable();
        }

        function startConsulting(opdServiceId, patientId, name, code, gender, age, tokenNo, hasDue) {
