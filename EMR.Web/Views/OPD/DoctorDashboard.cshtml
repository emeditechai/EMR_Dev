        // ── Media Field Init Functions ─────────────────────────────────────────
        function initDashboardPaint(wrapper, hiddenInput, savedVal, templateDefault) {
            const canvas = wrapper.find('.pd-canvas')[0];
            if (!canvas || $(canvas).data('pd-init')) return;
            $(canvas).data('pd-init', true);

            const ctx = canvas.getContext('2d');
            ctx.fillStyle = '#fff';
            ctx.fillRect(0, 0, canvas.width, canvas.height);

            // Restore: patient saved data takes priority over template default background
            const restore = (typeof savedVal === 'string' && savedVal.startsWith('data:image')) ? savedVal
                : (typeof templateDefault === 'string' && templateDefault.startsWith('data:image')) ? templateDefault : null;
            if (restore) {
                const img = new Image();
                img.onload = () => ctx.drawImage(img, 0, 0, canvas.width, canvas.height);
                img.src = restore;
                if (restore === savedVal) hiddenInput.val(savedVal);
            }

            let isDrawing = false, currentTool = 'pen';
            let startX = 0, startY = 0, lastX = 0, lastY = 0;
            let snapshot = null, history = [], redoStack = [];
            const SHAPE = new Set(['line','arrow','rect','filled-rect','circle','filled-circle']);
            const FREE  = new Set(['pen','highlighter','eraser']);

            const commit  = () => hiddenInput.val(canvas.toDataURL());
            const snap    = () => { history.push(canvas.toDataURL()); if (history.length > 30) history.shift(); redoStack = []; };
            const getPos  = e => { const r = canvas.getBoundingClientRect(); return [(e.clientX-r.left)*(canvas.width/r.width),(e.clientY-r.top)*(canvas.height/r.height)]; };
            const setStyl = () => {
                ctx.strokeStyle = currentTool === 'eraser' ? '#ffffff' : wrapper.find('.pd-color').val();
                ctx.fillStyle   = wrapper.find('.pd-color').val();
                ctx.lineWidth   = currentTool === 'highlighter' ? parseInt(wrapper.find('.pd-size').val()) * 6 : parseInt(wrapper.find('.pd-size').val());
                ctx.lineCap = 'round'; ctx.lineJoin = 'round';
                ctx.globalAlpha = currentTool === 'highlighter' ? 0.35 : 1.0;
            };
            const arrowHead = (x1, y1, x2, y2) => {
                const len = Math.max(14, Math.min(50, ctx.lineWidth * 4)), ang = Math.atan2(y2-y1, x2-x1);
                ctx.beginPath(); ctx.moveTo(x1,y1); ctx.lineTo(x2,y2);
                ctx.lineTo(x2-len*Math.cos(ang-Math.PI/6), y2-len*Math.sin(ang-Math.PI/6));
                ctx.moveTo(x2,y2); ctx.lineTo(x2-len*Math.cos(ang+Math.PI/6), y2-len*Math.sin(ang+Math.PI/6));
                ctx.stroke();
            };
            const drawSh = (x2, y2) => {
                setStyl();
                switch (currentTool) {
                    case 'line': ctx.beginPath(); ctx.moveTo(startX,startY); ctx.lineTo(x2,y2); ctx.stroke(); break;
                    case 'arrow': arrowHead(startX,startY,x2,y2); break;
                    case 'rect': ctx.strokeRect(startX,startY,x2-startX,y2-startY); break;
                    case 'filled-rect': ctx.fillRect(startX,startY,x2-startX,y2-startY); break;
                    case 'circle': { const rx=(x2-startX)/2,ry=(y2-startY)/2; ctx.beginPath(); ctx.ellipse(startX+rx,startY+ry,Math.abs(rx),Math.abs(ry),0,0,Math.PI*2); ctx.stroke(); break; }
                    case 'filled-circle': { const rx=(x2-startX)/2,ry=(y2-startY)/2; ctx.beginPath(); ctx.ellipse(startX+rx,startY+ry,Math.abs(rx),Math.abs(ry),0,0,Math.PI*2); ctx.fill(); break; }
                }
                ctx.globalAlpha = 1.0;
            };

            canvas.addEventListener('mousedown', e => {
                e.preventDefault();
                if (currentTool === 'text') {
                    const [x,y] = getPos(e), ti = wrapper.find('.pd-text-input');
                    ti.css({left:Math.min(x,canvas.width-290)+'px',top:Math.min(y,canvas.height-40)+'px'}).removeClass('d-none').focus().data({tx:x,ty:y});
                    ti.off('keydown.pd').on('keydown.pd', function(ke) {
                        if (ke.key === 'Enter') {
                            const txt = $(this).val().trim();
                            if (txt) { snap(); ctx.globalAlpha=1; ctx.font=`${parseInt(wrapper.find('.pd-size').val())*4}px Arial`; ctx.fillStyle=wrapper.find('.pd-color').val(); ctx.fillText(txt,$(this).data('tx'),$(this).data('ty')); commit(); }
                            $(this).val('').addClass('d-none');
                        }
                    }); return;
                }
                isDrawing = true; [startX,startY] = getPos(e); [lastX,lastY] = [startX,startY];
                snap();
                if (SHAPE.has(currentTool)) { snapshot = ctx.getImageData(0,0,canvas.width,canvas.height); }
                else { setStyl(); ctx.beginPath(); ctx.moveTo(startX,startY); }
            });
            canvas.addEventListener('mousemove', e => {
                if (!isDrawing) return;
                const [x,y] = getPos(e);
                if (FREE.has(currentTool)) { setStyl(); ctx.beginPath(); ctx.moveTo(lastX,lastY); ctx.lineTo(x,y); ctx.stroke(); ctx.globalAlpha=1; [lastX,lastY]=[x,y]; }
                else if (snapshot) { ctx.putImageData(snapshot,0,0); drawSh(x,y); }
            });
            canvas.addEventListener('mouseup', e => {
                if (!isDrawing) return; isDrawing=false;
                if (SHAPE.has(currentTool)) { const [x,y]=getPos(e); if(snapshot) ctx.putImageData(snapshot,0,0); drawSh(x,y); snapshot=null; }
                ctx.globalAlpha=1; commit();
            });
            canvas.addEventListener('mouseleave', () => {
                if (!isDrawing) return; isDrawing=false;
                if (snapshot) { ctx.putImageData(snapshot,0,0); if(history.length) history.pop(); snapshot=null; }
                ctx.globalAlpha=1; commit();
            });

            const cursors = {pen:'crosshair',highlighter:'crosshair',line:'crosshair',arrow:'crosshair',rect:'crosshair','filled-rect':'crosshair',circle:'crosshair','filled-circle':'crosshair',text:'text',eraser:'cell'};
            wrapper.find('.pd-tool').on('click', function() {
                wrapper.find('.pd-tool').removeClass('active'); $(this).addClass('active');
                currentTool = $(this).data('tool'); canvas.style.cursor = cursors[currentTool] || 'crosshair';
            });
            wrapper.find('.pd-undo-btn').on('click', () => {
                if (!history.length) return; redoStack.push(canvas.toDataURL()); const s=history.pop(), i=new Image();
                i.onload=()=>{ctx.fillStyle='#fff';ctx.fillRect(0,0,canvas.width,canvas.height);ctx.drawImage(i,0,0);commit();}; i.src=s;
            });
            wrapper.find('.pd-redo-btn').on('click', () => {
                if (!redoStack.length) return; history.push(canvas.toDataURL()); const s=redoStack.pop(), i=new Image();
                i.onload=()=>{ctx.fillStyle='#fff';ctx.fillRect(0,0,canvas.width,canvas.height);ctx.drawImage(i,0,0);commit();}; i.src=s;
            });
            wrapper.find('.pd-bg-btn').on('click', e => { e.stopPropagation(); wrapper.find('.pd-bg-input').trigger('click'); });
            wrapper.find('.pd-bg-input').on('change', function() {
                const file = this.files[0];
                if (file && file.type.startsWith('image/')) {
                    snap(); const reader = new FileReader();
                    reader.onload = ev => { const img=new Image(); img.onload=()=>{const sc=Math.min(canvas.width/img.width,canvas.height/img.height);ctx.fillStyle='#fff';ctx.fillRect(0,0,canvas.width,canvas.height);ctx.drawImage(img,(canvas.width-img.width*sc)/2,(canvas.height-img.height*sc)/2,img.width*sc,img.height*sc);commit();};img.src=ev.target.result;};
                    reader.readAsDataURL(file);
                }
            });
            wrapper.find('.pd-clear-btn').on('click', () => { snap(); ctx.fillStyle='#fff'; ctx.fillRect(0,0,canvas.width,canvas.height); hiddenInput.val(''); });
        }

        function initDashboardQuill(container, hiddenInput, savedVal) {
            if (!container || $(container).data('pd-quill-init')) return;
            if (typeof Quill === 'undefined') { console.warn('Quill.js not loaded'); return; }
            const quill = new Quill(container, {
                theme: 'snow',
                placeholder: 'Enter notes here...',
                modules: {
                    toolbar: [
                        [{'header':[1,2,3,false]}],
                        ['bold','italic','underline','strike'],
                        [{'color':[]},{'background':[]}],
                        [{'align':[]}],
                        [{'list':'ordered'},{'list':'bullet'}],
                        ['link'],['clean']
                    ]
                }
            });
            $(container).data('pd-quill-init', true).data('pd-quill-instance', quill);
            if (savedVal) {
                try { quill.setContents(JSON.parse(savedVal)); } catch(e) { quill.setText(savedVal); }
            }
            quill.on('text-change', () => hiddenInput.val(JSON.stringify(quill.getContents())));
        }

        // AutoSuggest dynamic engine inside Dashboard EMR modal
        function setupAutoSuggest(fieldComponent, fieldType) {
            const endpoint = fieldType === 'Investigation' ? '/EmrInvestigations/Search' : '/EmrMedications/Search';
            const suggestBox = fieldComponent.find('.autosuggest-input');
            const dropdown = fieldComponent.find('.autosuggest-dropdown');
            const container = fieldComponent.find('.selected-items-container');
            const isMed = fieldType === 'Medication';

            suggestBox.on('input', async function () {
                const q = $(this).val().trim();
                if (q.length < 1) { dropdown.hide(); return; }

                try {
                    const res = await fetch(`${endpoint}?q=${encodeURIComponent(q)}`);
                    const items = await res.json();
                    dropdown.empty();

                    if (items.length === 0) {
                        dropdown.html('<div class="dropdown-item-text text-muted small py-2">No results found</div>').show();
                        return;
                    }

                    items.forEach(item => {
                        const subtitle = isMed
                            ? (item.genericName ? `<small class="text-muted ms-1">(${item.genericName})</small>` : '')
                            : (item.category ? `<span class="badge bg-info-subtle text-info border ms-1" style="font-size:0.65rem;">${item.category}</span>` : '');

                        const li = $(`<button type="button" class="dropdown-item py-2 d-flex align-items-center gap-1">
                            <span class="fw-semibold">${item.text}</span>
                            ${subtitle}
                        </button>`);

                        li.on('click', function () {
                            // For Medication: add dose/freq row; for Investigation: add badge
                            if (isMed) {
                                if (container.find(`[data-item-id="${item.id}"]`).length === 0) {
                                    const dosePlaceholder = (item.strength || '') + (item.unit ? ' ' + item.unit : '');
                                    
                                    const freqOpts = fieldComponent.data('freq-opts') || ['Daily', 'Weekly', 'Monthly', 'Yearly', 'Alternate Day'];
                                    const procOpts = fieldComponent.data('proc-opts') || ['Before Food', 'After Food', 'After Breakfast', 'Before Breakfast', 'After Lunch', 'After Dinner', 'Before Dinner'];
                                    const fq = freqOpts.map(o => `<option value="${o}">${o}</option>`).join('');
                                    const pr = procOpts.map(o => `<option value="${o}">${o}</option>`).join('');

                                    const row = $(`
                                        <div class="selected-item-tag d-flex align-items-center gap-2 flex-wrap p-1 bg-white border rounded" data-item-id="${item.id}" data-item-text="${item.text}">
                                            <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle">
                                                <i class="bi bi-capsule me-1"></i>${item.text}
                                            </span>
                                            <input type="text" class="form-control form-control-sm item-dose-input" placeholder="${dosePlaceholder ? 'Dose (e.g. ' + dosePlaceholder.trim() + ')' : 'Dose'}" style="max-width:100px;" />
                                            <select class="form-select form-select-sm item-freq-select" style="max-width:130px;">
                                                <option value="">-- Frequency --</option>
                                                ${fq}
                                            </select>
                                            <select class="form-select form-select-sm item-proc-select" style="max-width:155px;">
                                                <option value="">-- Procedure --</option>
                                                ${pr}
                                            </select>
                                            <button type="button" class="btn btn-sm btn-link text-danger p-0 ms-auto item-remove-btn" style="line-height:1;"><i class="bi bi-x-circle-fill"></i></button>
                                        </div>
                                    `);
                                    row.find('.item-remove-btn').on('click', function () { row.remove(); });
                                    container.append(row);
                                }
                            } else {
                                if (container.find(`[data-item-id="${item.id}"]`).length === 0) {
                                    const tag = $(`
                                        <span class="badge bg-light text-dark border me-1 mb-1 d-inline-flex align-items-center gap-1 selected-item-tag" data-item-id="${item.id}" data-item-text="${item.text}">
                                            ${item.text}
                                            <button type="button" class="btn-close btn-close-dark" style="font-size:0.5rem;"></button>
                                        </span>
                                    `);
                                    tag.find('.btn-close').on('click', function () { tag.remove(); });
                                    container.append(tag);
                                }
                            }
                            suggestBox.val('');
                            dropdown.hide();
                        });
                        dropdown.append(li);
                    });

                    dropdown.show();
                } catch (e) {
                    console.error('AutoSuggest error:', e);
                }
            });

            // Close dropdown on outside click
            $(document).on('click.autosuggest-dashboard', function (e) {
                if (!fieldComponent[0].contains(e.target)) dropdown.hide();
            });
        }

        async function saveEMRRecord() {
            const opdServiceId = $('#emrOPDServiceId').val();
            if (!opdServiceId) return;

            // Collect dynamic EMR fields value
            const emrData = {};
            
            // Loop through dynamic field inputs
            $('.emr-field-input').each(function() {
                const id = $(this).attr('data-field-id');
                if (!id) return;
                
                if ($(this).attr('type') === 'checkbox') {
                    emrData[id] = $(this).is(':checked');
                } else if ($(this).prop('multiple')) {
                    const vals = $(this).val();
                    emrData[id] = vals ? vals.join(',') : '';
                } else {
                    emrData[id] = $(this).val();
                }
            });

            // Loop through medication / investigation list components
            $('#emrDynamicFieldsCanvas .field-row').each(function() {
                const id = $(this).attr('data-field-id');
                if (!id) return;
                const fieldType = $(this).attr('data-field-type');
                const selected = [];
                $(this).find('.selected-item-tag').each(function() {
                    const itemId = $(this).attr('data-item-id');
                    const itemText = $(this).attr('data-item-text');
                    if (fieldType === 'Medication') {
                        const dose = $(this).find('.item-dose-input').val().trim();
                        const freq = $(this).find('.item-freq-select').val().trim();
                        const proc = $(this).find('.item-proc-select').val().trim();
                        selected.push(itemId + '|' + itemText + '|' + dose + '|' + freq + '|' + proc);
                    } else {
                        selected.push(itemId + '|' + itemText);
                    }
                });
                emrData[id] = selected.join(',');
            });

            const req = {
                OPDServiceId: parseInt(opdServiceId),
                PatientId: parseInt($('#emrPatientId').val()),
                DoctorId: parseInt($('#emrDoctorId').val()),
                TemplateId: parseInt($('#emrTemplateId').val()),
                OPDBillNo: $('#emrOPDBillNo').val(),
                PatientCode: $('#emrPatientCode').val(),
                PatientName: $('#emrPatientName').val(),
                Gender: $('#emrGender').val(),
                Age: $('#emrAge').val()?.replace(' Yrs', ''),
                MobileNumber: $('#emrMobileNumber').val(),
                VisitType: $('#emrVisitType').val(),
                ConsultationType: $('#emrConsultationType').val(),
                EmrDataJson: JSON.stringify(emrData),
                ReferToSpecialityId: parseInt($('#emrReferSpeciality').val()) || null,
                ReferToDoctorId: parseInt($('#emrReferDoctor').val()) || null,
                FollowUpDate: $('#emrFollowUpDate').val() || null
            };
            const referFollowUpError = emrReferValidate();
            if (referFollowUpError) { Swal.fire('Check the referral / follow-up', referFollowUpError, 'warning'); return; }

            Swal.fire({
                title: 'Saving EMR Record...',
                allowOutsideClick: false,
                didOpen: () => {
                    Swal.showLoading();
                }
            });

            try {
                const res = await fetch('/OPD/SavePatientConsultation', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(req)
                });
                const result = await res.json();
                Swal.close();

                if (result.success) {
                    Swal.fire({
                        icon: 'success',
                        title: 'Saved Successfully',
                        text: result.message,
                        timer: 2000,
                        showConfirmButton: false
                    });
                    
                    // Close the modal
                    const modalEl = document.getElementById('emrConsultationModal');
                    const modal = bootstrap.Modal.getInstance(modalEl);
                    if (modal) modal.hide();
                    
                    // Refresh queue to show updated status
                    fetchQueue();
                    clearActivePatient();
                } else {
                    Swal.fire('Error', result.message, 'error');
                }
            } catch (err) {
                console.error(err);
                Swal.close();
                Swal.fire('Error', 'An unexpected error occurred while saving EMR.', 'error');
            }
        }

        // ── Refer To Doctor (speciality -> doctor) and Follow-Up Date - SQLScripts/2229 ──────────────────────────
        let _emrReferDoctorId = null;   // consulting doctor (left out of the referral list)
        const pad2 = n => String(n).padStart(2, '0');
        const isoDate = d => d.getFullYear() + '-' + pad2(d.getMonth() + 1) + '-' + pad2(d.getDate());
        function emrPicker($s, action) {
            if (typeof $.fn.selectpicker === 'undefined') return;
            if (action === 'init') { if (!$s.data('selectpicker')) $s.selectpicker(); else $s.selectpicker('refresh'); }
            else $s.selectpicker(action);
        }
        async function emrReferLoad(doctorId, saved) {
            _emrReferDoctorId = parseInt(doctorId) || null;
            const $sp = $('#emrReferSpeciality'), $dr = $('#emrReferDoctor');
            $sp.find('option:not(:first)').remove();
            $dr.empty().prop('disabled', true);
            try {
                const res = await fetch(`/OPD/EmrReferSpecialities?excludeDoctorId=${_emrReferDoctorId || ''}`);
                const rows = res.ok ? await res.json() : [];
                rows.forEach(r => $sp.append(new Option(r.name, r.id)));
            } catch { /* the referral stays optional */ }
            $sp.val(saved?.referToSpecialityId ? String(saved.referToSpecialityId) : '');
            emrPicker($sp, 'init');
            await emrReferDoctors(saved?.referToDoctorId);
            emrPicker($dr, 'init');

            // follow-up date: tomorrow .. one year ahead
            const t = new Date(), min = new Date(t.getFullYear(), t.getMonth(), t.getDate() + 1), max = new Date(t.getFullYear() + 1, t.getMonth(), t.getDate());
            $('#emrFollowUpDate').attr({ min: isoDate(min), max: isoDate(max) })
                .val(saved?.followUpDate ? String(saved.followUpDate).substring(0, 10) : '');
            emrFollowUpHint();
        }
        let _emrReferDoctorsSeq = 0;   // only the latest load fills the list (loads can overlap)
        async function emrReferDoctors(selectId) {
            const seq = ++_emrReferDoctorsSeq;
            const $dr = $('#emrReferDoctor'), sid = parseInt($('#emrReferSpeciality').val()) || 0;
            if (!sid) { $dr.empty().prop('disabled', true).attr('title', 'Select a speciality first'); emrPicker($dr, 'refresh'); return; }
            try {
                const res = await fetch(`/OPD/EmrReferDoctors?specialityId=${sid}&excludeDoctorId=${_emrReferDoctorId || ''}`);
                const rows = res.ok ? await res.json() : [];
                if (seq !== _emrReferDoctorsSeq) return;   // a newer load is on its way
                $dr.empty();
                $dr.append(new Option('— Select doctor —', ''));
                rows.forEach(r => $dr.append(new Option(r.name + (r.isPrimary ? '' : ' (secondary speciality)'), r.id)));
                $dr.prop('disabled', rows.length === 0).attr('title', rows.length ? 'Search doctor...' : 'No doctor in this speciality');
                $dr.val(selectId ? String(selectId) : (rows.length === 1 ? String(rows[0].id) : ''));
            } catch { if (seq === _emrReferDoctorsSeq) $dr.empty().prop('disabled', true); }
            if (seq === _emrReferDoctorsSeq) emrPicker($dr, 'refresh');
        }
        function emrReferValidate() {
            const sid = parseInt($('#emrReferSpeciality').val()) || 0, did = parseInt($('#emrReferDoctor').val()) || 0;
            if (sid && !did) return 'Select the doctor to refer to, or set the speciality back to "No referral".';
            const f = $('#emrFollowUpDate').val();
            if (f) {
                if (f < $('#emrFollowUpDate').attr('min')) return 'The follow-up date must be after today.';
                if (f > $('#emrFollowUpDate').attr('max')) return 'The follow-up date can be at most one year ahead.';
            }
            return null;
        }
        function emrFollowUpHint() {
            const v = $('#emrFollowUpDate').val(), $h = $('#emrFollowUpHint');
            if (!v) { $h.text(''); return; }
            const d = new Date(v + 'T00:00:00'), t = new Date(); t.setHours(0, 0, 0, 0);
            const days = Math.round((d - t) / 86400000);
            $h.html(days > 0 ? `<i class="bi bi-calendar-event me-1"></i>In ${days} day${days === 1 ? '' : 's'} &middot; ${d.toLocaleDateString('en-GB', { weekday: 'short', day: '2-digit', month: 'short', year: 'numeric' })}` : '');
        }
        function emrReferPrintText() {
            const did = parseInt($('#emrReferDoctor').val()) || 0;
            if (!did) return '';
            const doc = $('#emrReferDoctor option:selected').text().replace(' (secondary speciality)', '');
            const sp = $('#emrReferSpeciality option:selected').text();
            return `${doc} &mdash; ${sp}`;
        }
        function emrFollowUpPrintText() {
            const v = $('#emrFollowUpDate').val();
            return v ? new Date(v + 'T00:00:00').toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }) : '';
        }
        $(document).on('change', '#emrReferSpeciality', function () { emrReferDoctors(null); });
        $(document).on('change input', '#emrFollowUpDate', emrFollowUpHint);
        $(document).on('click', '#btnClearFollowUp', () => { $('#emrFollowUpDate').val(''); emrFollowUpHint(); });
        $(document).on('click', '#emrFollowUpQuick [data-days]', function () {
            const d = new Date(); d.setDate(d.getDate() + parseInt($(this).data('days')));
            $('#emrFollowUpDate').val(isoDate(d)); emrFollowUpHint();
        });

