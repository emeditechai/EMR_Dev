        // ── Webcam headshot capture logic ──────────────────────────────────────
        let webcamStream = null;
        const webcamModalEl = document.getElementById('webcamModal');
        const webcamModal = new bootstrap.Modal(webcamModalEl);
        const video = document.getElementById('webcamVideo');
        const canvas = document.getElementById('webcamCanvas');
        const btnCapture = document.getElementById('btnCapturePhoto');
        const btnRetake = document.getElementById('btnRetakePhoto');
        const btnUse = document.getElementById('btnUsePhoto');

        document.getElementById('btnWebcamOpen').addEventListener('click', async () => {
            try {
                webcamStream = await navigator.mediaDevices.getUserMedia({ video: { width: 320, height: 240, facingMode: "user" } });
                video.srcObject = webcamStream;
                // reset layout state
                video.classList.remove('d-none');
                canvas.classList.add('d-none');
                btnCapture.classList.remove('d-none');
                btnRetake.classList.add('d-none');
                btnUse.classList.add('d-none');
                
                webcamModal.show();
            } catch (err) {
                console.error("Camera access failed:", err);
                showToast("Could not access camera. Please check camera permissions.", "danger");
            }
        });

        // Capture button
        btnCapture.addEventListener('click', () => {
            if (!webcamStream) return;
            const ctx = canvas.getContext('2d');
            ctx.drawImage(video, 0, 0, 320, 240);
            
            // stop webcam tracks
            stopCamera();

            video.classList.add('d-none');
            canvas.classList.remove('d-none');
            btnCapture.classList.add('d-none');
            btnRetake.classList.remove('d-none');
            btnUse.classList.remove('d-none');
        });

        // Retake button
        btnRetake.addEventListener('click', async () => {
            try {
                webcamStream = await navigator.mediaDevices.getUserMedia({ video: { width: 320, height: 240, facingMode: "user" } });
                video.srcObject = webcamStream;
                video.classList.remove('d-none');
                canvas.classList.add('d-none');
                btnCapture.classList.remove('d-none');
                btnRetake.classList.add('d-none');
                btnUse.classList.add('d-none');
            } catch (err) {
                console.error("Camera access failed on retake:", err);
                showToast("Could not access camera. Please try again.", "danger");
            }
        });

        // Use photo button
        btnUse.addEventListener('click', () => {
            canvas.toBlob((blob) => {
                if (!blob) return;
                
                // Create a File object
                const file = new File([blob], "webcam_capture.jpg", { type: "image/jpeg" });
                
                // Use DataTransfer to programmatically assign the file to input
                const dataTransfer = new DataTransfer();
                dataTransfer.items.add(file);
                const fileInput = document.getElementById('profilePictureFile');
                if (fileInput) {
                    fileInput.files = dataTransfer.files;
                    
                    // Trigger preview update
                    window.previewProfilePic(fileInput);
                }
                
                webcamModal.hide();
            }, 'image/jpeg', 0.9);
        });

        // Stop stream when modal is closed/dismissed
        webcamModalEl.addEventListener('hidden.bs.modal', () => {
            stopCamera();
        });

        function stopCamera() {
            if (webcamStream) {
                webcamStream.getTracks().forEach(track => track.stop());
                webcamStream = null;
            }
            video.srcObject = null;
        }

        // ── Quick Add Referral Doctor ──
        $('#btnSaveRefDoctor').on('click', async function () {
            const name = $('#txtNewRefDoctorName').val().trim();
            const phone = $('#txtNewRefDoctorPhone').val().trim();
            if (!name) {
                showToast('Doctor name is required', 'danger');
                return;
            }
            
            const formData = new FormData();
            formData.append('name', name);
            formData.append('phone', phone);
            
            try {
                const res = await fetch('@Url.Action("CreateReferralDoctorQuick", "OPD")', {
                    method: 'POST',
                    body: formData
                });
                
                const data = await res.json();
                if (data.success) {
                    showToast('Referral Doctor added successfully!');
                    
                    const newOption = new Option(data.name, data.id, true, true);
                    $('#ddlReferralDoctor').append(newOption).trigger('change');
                    
                    $('#modalAddReferralDoctor').modal('hide');
                    $('#txtNewRefDoctorName').val('');
                    $('#txtNewRefDoctorPhone').val('');
                } else {
                    showToast(data.message || 'Failed to add doctor', 'danger');
                }
            } catch (err) {
                showToast('Network error occurred.', 'danger');
            }
        });

    })();
    </script>
}
