        // ── Phone live-suggest (inside form) – with keyboard navigation ──────────
        const phoneInput = document.getElementById('phoneNumber');
        const phoneDrop  = document.getElementById('phoneSearchDropdown');
        let debounce;
        let kbdIndex = -1;

        function getPhoneItems() { return Array.from(phoneDrop.querySelectorAll('.phone-sug')); }

        function setKbdActive(idx) {
            const items = getPhoneItems();
            if (!items.length) return;
            items.forEach(i => i.classList.remove('kbd-active'));
            kbdIndex = Math.max(0, Math.min(idx, items.length - 1));
            items[kbdIndex].classList.add('kbd-active');
            items[kbdIndex].scrollIntoView({ block: 'nearest' });
        }

        if (phoneInput && phoneDrop) {
            // ── Arrow / Enter / Escape keyboard support ──
            phoneInput.addEventListener('keydown', function (e) {
                if (phoneDrop.style.display === 'none') return;
                const items = getPhoneItems();
                if (!items.length) return;

                if (e.key === 'ArrowDown') {
                    e.preventDefault();
                    setKbdActive(kbdIndex < 0 ? 0 : kbdIndex + 1);
                } else if (e.key === 'ArrowUp') {
                    e.preventDefault();
                    setKbdActive(kbdIndex <= 0 ? 0 : kbdIndex - 1);
                } else if (e.key === 'Enter') {
                    if (kbdIndex >= 0 && items[kbdIndex]) {
                        e.preventDefault();
                        populatePatient(items[kbdIndex].dataset.id);
                        phoneDrop.style.display = 'none';
                        kbdIndex = -1;
                    }
                } else if (e.key === 'Escape' || e.key === 'Tab') {
                    phoneDrop.style.display = 'none';
                    kbdIndex = -1;
                }
            });

            // ── Type-ahead search ────────────────────────────────────────────────
            phoneInput.addEventListener('input', function () {
                clearTimeout(debounce);
                kbdIndex = -1;
                const val = this.value.trim();
                if (val.length < 3) { phoneDrop.style.display = 'none'; return; }
                debounce = setTimeout(async () => {
                    const data = await fetchJson(opdBase + 'SearchPatientByPhone?phone=' + encodeURIComponent(val));
                    if (data?.length) {
                        phoneDrop.innerHTML = data.map(p => `
                            <button type="button"
                                    class="list-group-item list-group-item-action py-2 px-3 phone-sug"
                                    data-id="${p.patientId}" tabindex="-1">
                                <div class="d-flex align-items-center gap-1 flex-wrap mb-1">
                                    <span class="fw-semibold">${p.fullName}</span>
                                    <span class="badge text-bg-info text-dark font-monospace">${p.patientCode}</span>
                                    ${p.relationName ? `<span class="badge text-bg-primary">${p.relationName}</span>` : ''}
                                    ${p.bloodGroup   ? `<span class="badge text-bg-danger">${p.bloodGroup}</span>`   : ''}
                                </div>
                                <small class="text-muted">${p.phoneNumber} &nbsp;·&nbsp; ${p.gender || ''}</small>
                            </button>`).join('');
                        phoneDrop.style.display = 'block';
                        kbdIndex = -1;

                        // Mouse hover syncs kbdIndex so Enter still works
                        phoneDrop.querySelectorAll('.phone-sug').forEach((btn, i) => {
                            btn.addEventListener('mouseenter', () => {
                                getPhoneItems().forEach(b => b.classList.remove('kbd-active'));
                                btn.classList.add('kbd-active');
                                kbdIndex = i;
                            });
                            btn.addEventListener('mousedown', (e) => {
                                e.preventDefault(); // Prevent input blur & layout shift
                            });
                            btn.addEventListener('click', () => {
                                populatePatient(btn.dataset.id);
                                phoneDrop.style.display = 'none';
                                kbdIndex = -1;
                            });
                        });
                    } else {
                        phoneDrop.style.display = 'none';
                    }
                }, 350);
            });

            document.addEventListener('click', e => {
                if (!phoneDrop.contains(e.target) && e.target !== phoneInput) {
                    phoneDrop.style.display = 'none';
                    kbdIndex = -1;
                }
            });
        }


        // ── Cascading geography dropdowns ─────────────────────────────────────
        function setupCascade(parentId, qsParam, action, childId, valProp, textProp, placeholder) {
            $(`#${parentId}`).on('change', async function () {
                const val = $(this).val();
                resetS2(childId, placeholder);
                // Also clear downstream cascades
                const chain = ['ddlState','ddlDistrict','ddlCity','ddlArea'];
                const startIdx = chain.indexOf(childId);
                if (startIdx >= 0) {
                    for (let i = startIdx + 1; i < chain.length; i++) {
                        resetS2(chain[i], placeholderFor(chain[i]));
                    }
                }
                if (!val) return;
                const data = await fetchJson(opdBase + action + '?' + qsParam + '=' + val);
                if (!data?.length) return;
                const $child = $(`#${childId}`);
                data.forEach(item => $child.append(new Option(item[textProp], item[valProp])));
                $child.trigger('change.select2');
            });
        }

        function placeholderFor(id) {
            return { ddlState: '-- Select State --', ddlDistrict: '-- Select District --',
                     ddlCity:  '-- Select City --',  ddlArea:     '-- Select Area --' }[id] || '--';
        }

        setupCascade('ddlCountry',  'countryId',  'GetStatesByCountry',   'ddlState',    'stateId',    'stateName',    '-- Select State --');
        setupCascade('ddlState',    'stateId',    'GetDistrictsByState',  'ddlDistrict', 'districtId', 'districtName', '-- Select District --');
        setupCascade('ddlDistrict', 'districtId', 'GetCitiesByDistrict',  'ddlCity',     'cityId',     'cityName',     '-- Select City --');
        setupCascade('ddlCity',     'cityId',     'GetAreasByCity',       'ddlArea',     'areaId',     'areaName',     '-- Select Area --');

        // ── Line-item management ──────────────────────────────────────────────
        let lineItems  = [];   // { rowId, serviceType, serviceId, itemName, serviceCharges }
        let rowCounter = 0;
        let lineItemsFormSubmitted = false;

        try {
            const initialJson = document.getElementById('hdnLineItemsJson')?.value;
            if (initialJson && initialJson !== '[]') {
                lineItems = JSON.parse(initialJson);
                lineItems.forEach((item, idx) => {
                    if (!item.rowId) item.rowId = idx + 1;
                    rowCounter = Math.max(rowCounter, item.rowId);
                });
            }
        } catch (e) {
            console.error('Error parsing initial line items:', e);
        }

        const $doctor = $('#ddlDoctor');

        function checkLineItemsValidity() {
            const demoOnly = (document.getElementById('DemographicsOnly')?.value || '').toLowerCase() === 'true';
            if (demoOnly) return true;

            const errEl = document.getElementById('lineItemsValidationError');
            if (!lineItemsFormSubmitted) {
                if (lineItems.length === 0) return false;
                if (lineItems.some(item => !item.serviceType || !item.serviceId)) return false;
                return true;
            }

            if (lineItems.length === 0) {
                if (errEl) {
                    errEl.textContent = 'At least one service or consultation fee item is required.';
                    errEl.style.display = 'block';
                }
                document.getElementById('lineItemTable')?.classList.add('border-danger');
                return false;
            }

            const incomplete = lineItems.some(item => !item.serviceType || !item.serviceId);
            if (incomplete) {
                if (errEl) {
                    errEl.textContent = 'Please select a Type and Item/Service Name for all rows.';
                    errEl.style.display = 'block';
                }
                document.getElementById('lineItemTable')?.classList.add('border-danger');
                return false;
            }

            if (window._registrationValidityConfigured && !window._registrationValid) {
                const hasConsultation = lineItems.some(item => item.serviceType === 'Consulting');
                if (hasConsultation) {
                    const hasReg = lineItems.some(item => item.isRegistration);
                    if (!hasReg) {
                        if (errEl) {
                            errEl.textContent = 'Registration service is mandatory to take along with consultation as per Hospital Settings.';
                            errEl.style.display = 'block';
                        }
                        document.getElementById('lineItemTable')?.classList.add('border-danger');
                        return false;
                    }
                }
            }

            if (errEl) {
                errEl.textContent = '';
                errEl.style.display = 'none';
            }
            document.getElementById('lineItemTable')?.classList.remove('border-danger');
            return true;
        }

        function saveJson() {
            var hdn = document.getElementById('hdnLineItemsJson');
            if (hdn) {
                hdn.value = JSON.stringify(lineItems);
            }
            checkLineItemsValidity();
        }

        function updateTotal() {
            const total = lineItems.reduce((s, r) => s + (parseFloat(r.serviceCharges) || 0), 0);
            document.getElementById('lineItemTotal').textContent =
                '₹ ' + total.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        }

        async function loadItemsForRow(rowId, type, selectedId, selectedName) {
            const $row    = $(`#row-${rowId}`);
            const $item   = $row.find('.row-item');
            const doctorId = $doctor.val();

            // destroy existing Select2 on row-item if present
            if ($item.hasClass('select2-hidden-accessible')) $item.select2('destroy');
            $item.empty().append(new Option('-- loading… --', ''));

            let url;
            if (type === 'Consulting') {
                if (!doctorId) {
                    $item.empty().append(new Option('-- Select Doctor first --', ''));
                    initRowS2($item);
                    return;
                }
                url = opdBase + 'GetConsultingFeesByDoctor?doctorId=' + doctorId;
            } else if (type === 'Service') {
                url = opdBase + 'GetServicesByType?type=Service';
            } else {
                $item.empty().append(new Option('-- Select Type first --', ''));
                initRowS2($item);
                return;
            }

            const data = await fetchJson(url);
            $item.empty().append(new Option('-- Select item --', ''));
            (data || []).forEach(s => {
                // Skip registration service if patient's registration is still within validity
                if (s.isRegistration && window._registrationValid) return;
                const o = new Option(s.itemName, s.serviceId);
                o.dataset.charges = s.itemCharges;
                o.dataset.isRegistration = s.isRegistration ? 'true' : 'false';
                $item.append(o);
            });
            if (selectedId) $item.val(selectedId);
            initRowS2($item);

            // Set charges from selected option's dataset
            const sel = $item[0].options[$item[0].selectedIndex];
            const charges = sel?.dataset?.charges;
            setRowCharges($row, rowId, charges || '');

            const rowItem = lineItems.find(r => r.rowId === rowId);
            if (rowItem) {
                rowItem.isRegistration = sel?.dataset?.isRegistration === 'true';
            }
        }

        function initRowS2($el) {
            $el.select2({
                theme: 'bootstrap-5',
                width: '100%',
                dropdownParent: document.body,
                templateResult: function(opt) {
                    if (!opt.id) return opt.text;
                    const el = opt.element;
                    if (el && el.dataset.isRegistration === 'true') {
                        const $w = $('<span class="d-flex align-items-center gap-2"></span>');
                        $w.append($('<span></span>').text(opt.text));
                        $w.append('<span class="badge text-bg-primary" style="font-size:0.7em">Registration</span>');
                        return $w;
                    }
                    return opt.text;
                }
            });
            $el.on('change', function () {
                const rid  = parseInt(this.closest('tr').id.replace('row-',''));
                const sel  = this.options[this.selectedIndex];
                const row  = lineItems.find(r => r.rowId === rid);
                if (row) {
                    row.serviceId      = parseInt(this.value) || null;
                    row.itemName       = sel?.text ?? '';
                    row.serviceCharges = parseFloat(sel?.dataset?.charges) || 0;
                    row.isRegistration = sel?.dataset?.isRegistration === 'true';
                }
                setRowCharges($(this).closest('tr'), rid, sel?.dataset?.charges || '');
                updateTotal();
                saveJson();
            });
        }

        function setRowCharges($row, rowId, chargesStr) {
            const val = parseFloat(chargesStr) || 0;
            $row.find('.row-charges').val(val > 0
                ? '₹ ' + val.toLocaleString('en-IN', { minimumFractionDigits: 2 })
                : '');
            const row = lineItems.find(r => r.rowId === rowId);
            if (row) row.serviceCharges = val;
        }

        function renderRows() {
            const tbody = document.getElementById('lineItemTbody');
            if (!lineItems.length) {
                tbody.innerHTML = `<tr id="emptyRow"><td colspan="4" class="text-center text-muted small py-2">
                    <i class="bi bi-info-circle me-1"></i>Click "Add Item" to add a service line</td></tr>`;
                updateTotal();
                return;
            }
            tbody.innerHTML = lineItems.map(r => `
                <tr id="row-${r.rowId}">
                    <td>
                        <select class="form-select form-select-sm row-type">
                            <option value="">-- Type --</option>
                            <option value="Consulting"${r.serviceType==='Consulting'?' selected':''}>Consulting</option>
                            <option value="Service"${r.serviceType==='Service'?' selected':''}>Services</option>
                        </select>
                    </td>
                    <td><select class="form-select form-select-sm row-item"></select></td>
                    <td><input type="text" class="form-control form-control-sm row-charges" readonly placeholder="₹ 0.00" /></td>
                    <td class="text-center">
                        <button type="button" class="btn btn-sm btn-outline-danger btn-del"
                                data-rowid="${r.rowId}"><i class="bi bi-trash3"></i></button>
                    </td>
                </tr>`).join('');

            lineItems.forEach(r => {
                const $row     = $(`#row-${r.rowId}`);
                const $typeEl  = $row.find('.row-type');

                // Init row-type Select2
                $typeEl.select2({ theme:'bootstrap-5', width:'100%', dropdownParent:document.body,
                                   minimumResultsForSearch: Infinity });
                $typeEl.on('change', function () {
                    const rid  = parseInt(this.closest('tr').id.replace('row-',''));
                    const row2 = lineItems.find(x => x.rowId === rid);
                    if (row2) { row2.serviceType = this.value; row2.serviceId = null; row2.itemName = ''; row2.serviceCharges = 0; row2.isRegistration = false; }
                    loadItemsForRow(rid, this.value, null, '');
                    updateTotal(); saveJson();
                });

                // Load items for existing type
                loadItemsForRow(r.rowId, r.serviceType, r.serviceId, r.itemName);

                // Delete button
                $row.find('.btn-del').on('click', function () {
                    const rid = parseInt($(this).data('rowid'));
                    lineItems = lineItems.filter(x => x.rowId !== rid);
                    renderRows();
                    updateTotal(); saveJson();
                });
            });
        }

        // Add Item button
        document.getElementById('btnAddItem')?.addEventListener('click', () => {
            lineItems.push({ rowId: ++rowCounter, serviceType: '', serviceId: null, itemName: '', serviceCharges: 0, isRegistration: false });
            renderRows();
            saveJson();
        });

        // When doctor changes, reload all Consulting rows
        $doctor.on('change', () => {
            lineItems.forEach(r => {
                if (r.serviceType === 'Consulting') loadItemsForRow(r.rowId, 'Consulting', r.serviceId, r.itemName);
            });
        });

        // Render initial rows if any (e.g. on validation error reload)
        if (lineItems.length > 0) {
            renderRows();
            updateTotal();
        }

        // Check if there is already a server-side error displayed
        const serverError = document.getElementById('lineItemsValidationError')?.textContent.trim();
        if (serverError) {
            lineItemsFormSubmitted = true;
            document.getElementById('lineItemsValidationError').style.display = 'block';
            document.getElementById('lineItemTable')?.classList.add('border-danger');
        }

        // ── Auto-populate patient data ─────────────────────────────────────────
        async function populatePatient(patientId) {
            if (phoneDrop) phoneDrop.style.display = 'none';
            const p = await fetchJson(opdBase + 'GetPatientDetails?id=' + patientId);
            if (!p) return;

            // ── Critical: mark form as UPDATE mode for this patient ───────────
            document.getElementById('PatientId').value    = p.patientId;
            document.getElementById('PatientCode').value  = p.patientCode ?? '';
            // Preserve existing ID file so it isn't wiped if user doesn't re-upload
            document.getElementById('existingFilePath').value = p.identificationFilePath ?? '';
            document.getElementById('existingPhotoPath').value = p.photoPath ?? '';
            document.getElementById('HomeCollectionAddress').value = p.homeCollectionAddress ?? '';
            document.getElementById('Latitude').value = p.latitude ?? '';
            document.getElementById('Longitude').value = p.longitude ?? '';
            
            const picPreview = document.getElementById('profilePicPreview');
            const picContainer = document.getElementById('profilePicPreviewContainer');
            if (p.photoPath) {
                picPreview.src = p.photoPath;
                picContainer.classList.remove('d-none');
            } else {
                picPreview.src = '';
                picContainer.classList.add('d-none');
            }

            // Always create a NEW OPD service row on search-load (new visit)
            document.getElementById('hdnOPDServiceId').value = 0;

            // ── Show patient code badge in Demography header ──────────────────
            const badge = document.getElementById('loadedPatientBadge');
            badge.textContent = p.patientCode;
            badge.classList.remove('d-none');

            // ── Switch submit button to "Book Service" ────────────────────────
            document.getElementById('btnSaveIcon').className  = 'bi bi-calendar2-check-fill me-2';
            document.getElementById('btnSaveLabel').textContent = 'Book Service';
            document.getElementById('btnSave').classList.replace('btn-primary', 'btn-success');

            // Plain text inputs (demographics)
            ['PhoneNumber','SecondaryPhoneNumber','FirstName','MiddleName','LastName',
             'EmailId','GuardianName','IdentificationNumber','KnownAllergies','Remarks'
            ].forEach(f => setVal(f, p[f.charAt(0).toLowerCase() + f.slice(1)]));

            // Date of Birth & Age
            const dobRaw = p.dateOfBirth;
            const dobEl  = document.getElementById('DateOfBirth');
            if (dobEl) {
                dobEl.value = dobRaw ? dobRaw.substring(0, 10) : '';
                window._refreshAge?.();
            }
            if (p.ageYears !== undefined && p.ageYears !== null && document.getElementById('AgeYears')) {
                document.getElementById('AgeYears').value = p.ageYears;
                document.getElementById('AgeMonths').value = p.ageMonths ?? 0;
                document.getElementById('AgeDays').value = p.ageDays ?? 0;
            }

            // Select2 selects (demographics)
            const s2Map = {
                'ddlSalutation':    p.salutation,
                'ddlRelation':      p.relationId,
                'ddlGender':        p.gender,
                'ddlReligion':      p.religionId,
                'ddlBloodGroup':    p.bloodGroup,
                'ddlOccupation':    p.occupationId,
                'ddlMaritalStatus': p.maritalStatusId,
                'ddlLanguage':      p.languageId,
                'ddlIdType':        p.identificationTypeId,
            };
            Object.entries(s2Map).forEach(([id, val]) => {
                if (val !== null && val !== undefined) $(`#${id}`).val(val).trigger('change');
            });

            // Cascading geography chain
            if (p.countryId) {
                $('#ddlCountry').val(p.countryId).trigger('change.select2');
                await loadAndSet('ddlState',    'countryId',  'GetStatesByCountry',   p.countryId,  'stateId',    'stateName',    p.stateId);
                if (p.stateId) {
                    await loadAndSet('ddlDistrict','stateId',  'GetDistrictsByState',  p.stateId,    'districtId', 'districtName', p.districtId);
                    if (p.districtId) {
                        await loadAndSet('ddlCity','districtId','GetCitiesByDistrict', p.districtId, 'cityId',     'cityName',     p.cityId);
                        if (p.cityId) {
                            await loadAndSet('ddlArea','cityId','GetAreasByCity',      p.cityId,     'areaId',     'areaName',     p.areaId);
                        }
                    }
                }
            }
            const patientAddr = (p.address && p.address.trim()) ? p.address.trim() : (p.homeCollectionAddress && p.homeCollectionAddress.trim() ? p.homeCollectionAddress.trim() : '');
            document.getElementById('Address').value = patientAddr;

            // ── Section 3: only reset if NOT locked by roster ────────────────
            if (!fromRoster) {
                // Reset doctor and clear all line items for fresh visit booking
                $('#ddlDoctor').val('').trigger('change');
                lineItems = [];
                renderRows();
                saveJson();
            } else {
                // If from roster, we keep the doctor, date, and slot intact.
                // We just want to ensure lineItems are clean for the new patient.
                lineItems = [];
                renderRows();
                saveJson();
                // Then let the doctor change event know it needs to load consulting item
                $doctor.trigger('change');
            }

            // ── Check registration validity for this (returning) patient ─────
            await checkRegistrationValidity(p.patientId);

            showToast(`Patient loaded (${p.patientCode}) — select Doctor & Service for new visit`);
        }

