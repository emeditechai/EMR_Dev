        // ── Search panel – label / icon switching ─────────────────────────────
        const searchType  = document.getElementById('searchType');
        const searchLabel = document.getElementById('searchLabel');
        const searchIcon  = document.querySelector('#searchIcon i');
        if (searchType) {
            searchType.addEventListener('change', () => {
                if (searchType.value === 'phone') {
                    searchLabel.textContent = 'Enter Mobile Number';
                    if (searchIcon) { searchIcon.className = 'bi bi-telephone'; }
                } else if (searchType.value === 'code') {
                    searchLabel.textContent = 'Enter Patient ID';
                    if (searchIcon) { searchIcon.className = 'bi bi-hash'; }
                } else if (searchType.value === 'name') {
                    searchLabel.textContent = 'Enter Patient Name';
                    if (searchIcon) { searchIcon.className = 'bi bi-person'; }
                }
            });
        }

        // ── Title → Gender auto-populate ─────────────────────────────────────
        const titleGenderMap = { 'Mr.': 'Male', 'Mrs.': 'Female', 'Master': 'Male', 'Ms.': 'Female' };
        $('#ddlSalutation').on('change', function () {
            const mapped = titleGenderMap[$(this).val()];
            if (mapped) setVal('ddlGender', mapped);
        });

        // ── Top search button ─────────────────────────────────────────────────
        const btnSearch   = document.getElementById('btnSearch');
        const searchInput = document.getElementById('searchInput');
        if (btnSearch) {
            btnSearch.addEventListener('click', async () => {
                const val = searchInput.value.trim();
                if (!val) return;
                let url = '';
                if (searchType.value === 'phone') {
                    url = opdBase + 'SearchPatientByPhone?phone=' + encodeURIComponent(val);
                } else if (searchType.value === 'code') {
                    url = opdBase + 'SearchPatientByCode?code='  + encodeURIComponent(val);
                } else if (searchType.value === 'name') {
                    url = opdBase + 'SearchPatientByName?name=' + encodeURIComponent(val);
                }
                await openSearchModal(url);
            });
            searchInput?.addEventListener('keypress', e => {
                if (e.key === 'Enter') { e.preventDefault(); btnSearch.click(); }
