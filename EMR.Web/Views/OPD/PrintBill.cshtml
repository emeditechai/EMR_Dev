@model EMR.Web.Models.ViewModels.ServiceBookingDetailViewModel
@using EMR.Web.Models.ViewModels
@{
    Layout = null;
    // OPD bill on the same template as the LAB bill (LabOrderBooking/PrintBill): same header, layout, summary and receipts.
    var settings   = ViewBag.Settings   as EMR.Web.Models.Entities.HospitalSettings;
    var branchName = ViewBag.BranchName as string;
    var payment    = ViewBag.Payment    as BillPaymentSummary;
    // false only for the in-app print when Required B2C Bill Print Header = No (SQLScripts/2206); the email / WhatsApp link keeps them
    var showHeaderFooter = ViewBag.ShowHeaderFooter as bool? ?? true;

    var hospName  = settings?.HospitalName ?? branchName ?? "Hospital";
    var phones    = string.Join(" / ", new[] { settings?.ContactNumber1, settings?.ContactNumber2 }.Where(p => !string.IsNullOrWhiteSpace(p)));
    var billDate  = Model.CreatedDate.ToString("dd-MMM-yyyy hh:mm tt");
    var apptDate  = Model.VisitDate.ToString("dd-MMM-yyyy") + (Model.AppointmentTime.HasValue ? " " + DateTime.Today.Add(Model.AppointmentTime.Value).ToString("hh:mm tt") : "");
    var printDate = DateTime.Now.ToString("dd-MMM-yyyy hh:mm tt");
    var ageStr    = !string.IsNullOrEmpty(Model.FormattedAge) ? Model.FormattedAge : (Model.Age.HasValue ? $"{Model.Age.Value} Yrs" : "");
    var genderAge = !string.IsNullOrEmpty(ageStr)
                      ? (!string.IsNullOrEmpty(Model.Gender) ? $"{ageStr} / {Model.Gender}" : ageStr)
                      : (Model.Gender ?? "—");
    var printedBy = User?.FindFirst("DisplayName")?.Value ?? User?.Identity?.Name;
    var isCancelled = string.Equals(Model.Status, "Cancelled", StringComparison.OrdinalIgnoreCase);

    // amounts: the line charges, their GST, then the bill's payment summary
    decimal gross = 0, gstTotal = 0;
    var lines = Model.Items.Select(item =>
    {
        var lp = payment?.LineItems?.FirstOrDefault(l => l.ModuleLineRefId == item.ItemId);
        decimal half = item.IsGstRequired && item.GstPercentage > 0 ? Math.Round(item.ServiceCharges * (item.GstPercentage!.Value / 100M) / 2, 2) : 0;
        decimal gst = lp != null ? lp.CgstAmount + lp.SgstAmount + lp.IgstAmount : half * 2;
        gross += item.ServiceCharges; gstTotal += gst;
        return (item, gst);
    }).ToList();
    decimal discount   = payment?.DiscountAmount ?? 0;
    decimal roundOff   = payment?.RoundOffAmount ?? 0;
    decimal grandTotal = payment?.NetAmount ?? (gross + gstTotal);
    decimal received   = payment?.TotalPaid ?? 0;
    decimal balance    = payment?.BalanceDue ?? grandTotal;
    var receiptNos = payment?.Rows.Where(r => !string.IsNullOrWhiteSpace(r.ReceiptNo)).Select(r => r.ReceiptNo!).Distinct().ToList() ?? new List<string>();
    var amountInWords = new MoneyReceiptViewModel { Amount = received }.AmountInWords;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>OPD Bill — @Model.OPDBillNo</title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            font-family: Arial, Helvetica, sans-serif;
            font-size: 11px;
            color: #111;
            background: #fff;
        }

        .page-wrap {
            width: 210mm;
            min-height: 297mm;
            margin: 0 auto;
            padding: 10mm 12mm 10mm 12mm;
            position: relative;
        }

        /* ── Print Button (hidden on print) ── */
        .print-actions {
            position: fixed;
            top: 10px;
            right: 16px;
            z-index: 999;
            display: flex;
            gap: 8px;
        }
        .btn-print {
            background: #1a56db;
            color: #fff;
            border: none;
            padding: 8px 20px;
            border-radius: 5px;
            cursor: pointer;
            font-size: 13px;
            font-weight: bold;
        }
        .btn-close-tab {
            background: #374151;
            color: #fff;
            border: none;
            padding: 8px 16px;
            border-radius: 5px;
            cursor: pointer;
            font-size: 13px;
        }

        /* ── Header ── */
        .letterhead-space { height: 30mm; }
        .bill-header {
            margin-bottom: 4mm;
            padding-bottom: 3mm;
            border-bottom: 1.5px solid #222;
        }
        .header-top {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 12px;
        }
        .header-left {
            display: flex;
            align-items: center;
            gap: 12px;
            flex: 1;
        }
        .hosp-logo {
            height: 52px;
            max-width: 120px;
            object-fit: contain;
        }
        .hosp-info-main .hosp-name {
            font-size: 18px;
            font-weight: 900;
            color: #1a3a6b;
            letter-spacing: 0.5px;
            margin-bottom: 3px;
        }
        .hosp-badges {
            display: flex;
            flex-wrap: wrap;
            gap: 5px;
            align-items: center;
        }
        .badge-pill {
            display: inline-block;
            padding: 1.5px 6px;
            font-size: 9px;
            font-weight: bold;
            border-radius: 3px;
        }
        .badge-type {
            background: #e0edff;
            color: #0b57d0;
            border: 1px solid #c2dbff;
        }
        .badge-reg {
            background: #f1f3f4;
            color: #3c4043;
            border: 1px solid #dadce0;
        }
        .badge-nabh {
            background: #e6f4ea;
            color: #137333;
            border: 1px solid #ceead6;
        }
        .header-right {
            text-align: right;
            display: flex;
            flex-direction: column;
            align-items: flex-end;
            gap: 4px;
        }
        .emergency-box {
            background: #fce8e6;
            color: #c5221f;
            border: 1px solid #fad2cf;
            padding: 2px 8px;
            border-radius: 12px;
            font-size: 9.5px;
            font-weight: bold;
            display: inline-flex;
            align-items: center;
            gap: 4px;
        }
        .barcode-area {
            font-size: 26px;
            letter-spacing: -2px;
            font-family: 'Libre Barcode 128', cursive;
            color: #000;
            line-height: 1;
            margin-top: 2px;
        }

        /* ── Header details strip ── */
        .header-details-strip {
            display: flex;
            justify-content: space-between;
            flex-wrap: wrap;
            margin-top: 6px;
            padding-top: 5px;
            border-top: 1px dashed #ccc;
            font-size: 9.5px;
            color: #333;
            gap: 8px;
        }
        .header-details-strip .item {
            display: flex;
            gap: 4px;
        }
        .header-details-strip .item-title {
            font-weight: bold;
            text-transform: uppercase;
            color: #555;
            font-size: 8.5px;
        }

        /* ── Section title ── */
        .section-title {
            text-align: center;
            font-size: 11px;
            font-weight: bold;
            border-top: 1.5px solid #111;
            border-bottom: 1.5px solid #111;
            padding: 2.5px 0;
            margin-bottom: 0;
            position: relative;
        }
        .section-title .original-label {
            position: absolute;
            right: 0;
            top: 2.5px;
            font-size: 10.5px;
            font-weight: bold;
        }
        .cancelled-watermark {
            position: absolute;
            top: 30%;
            left: 50%;
            transform: translate(-50%, -50%) rotate(-30deg);
            font-size: 80px;
            color: rgba(220, 53, 69, 0.15);
            font-weight: 900;
            z-index: -1;
            pointer-events: none;
            letter-spacing: 10px;
        }
        .text-strike {
            text-decoration: line-through;
            color: #777;
        }

        /* ── Patient/Doctor info table ── */
        .info-grid {
            width: 100%;
            border-collapse: collapse;
            border: 1px solid #111;
        }
        .info-grid th, .info-grid td {
            border: 1px solid #111;
            padding: 2px 5px;
            vertical-align: top;
            font-size: 10.5px;
        }
        .info-grid .col-header {
            background: #f0f0f0;
            font-weight: bold;
            font-size: 10.5px;
            text-align: left;
        }
        .info-grid .lbl {
            font-weight: bold;
            width: 28%;
            white-space: nowrap;
        }

        /* ── Investigations table ── */
        .inv-table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 5mm;
        }
        .inv-table thead tr {
            background: #f0f0f0;
        }
        .inv-table th, .inv-table td {
            border: 1px solid #333;
            padding: 3px 6px;
            font-size: 10.5px;
        }
        .inv-table th {
            font-weight: bold;
            text-align: left;
        }
        .inv-table td.num { text-align: right; }
        .inv-table tfoot td {
            border: none;
            padding: 2px 6px;
            font-size: 10.5px;
        }
        .inv-table tfoot tr.total-row td {
            border-top: 1.5px solid #111;
        }

        /* ── Payment receipts table ── */
        .rcpt-table { margin-top: 4mm; }
        .rcpt-table th, .rcpt-table td { font-size: 9.5px; padding: 2.5px 5px; vertical-align: top; }
        .rcpt-table th.rcpt-caption { background: #fff; border: none; border-bottom: 1.5px solid #111; padding: 0 0 2px; font-size: 10.5px; text-transform: uppercase; letter-spacing: 0.4px; }
        .rcpt-table th.num { text-align: right; }
        .rcpt-table .rcpt-tag { font-family: Arial, Helvetica, sans-serif; font-size: 8px; font-weight: bold; color: #92400e; text-transform: uppercase; letter-spacing: 0.3px; }

        /* ── Summary block ── */
        .summary-block {
            width: 55%;
            margin-left: auto;
            margin-top: 3mm;
        }
        .summary-block table {
            width: 100%;
            border-collapse: collapse;
        }
        .summary-block td {
            padding: 2px 6px;
            font-size: 11px;
        }
        .summary-block .s-lbl { text-align: right; font-weight: bold; }
        .summary-block .s-val { text-align: right; }
        .summary-block .s-total { font-size: 12px; font-weight: 900; border-top: 1.5px solid #111; }

        /* ── Amount in words ── */
        .amount-words {
            text-align: right;
            font-size: 10.5px;
            font-style: italic;
            margin-top: 2px;
        }
        .amount-words strong { font-style: normal; }

        /* ── Footer note ── */
        .footer-notes {
            margin-top: 6mm;
            font-size: 9.5px;
            color: #222;
            line-height: 1.5;
        }
        .footer-notes p { margin-bottom: 3px; }
        .footer-notes a { color: #1a3a6b; }

        .footer-meta {
            margin-top: 5mm;
            font-size: 10px;
            font-weight: bold;
        }
        .footer-meta p { margin-bottom: 2px; }

        .page-footer {
            position: fixed;
            bottom: 8mm;
            left: 12mm;
            right: 12mm;
            display: flex;
            justify-content: space-between;
            font-size: 10px;
            color: #555;
            border-top: 1px solid #ccc;
            padding-top: 3px;
        }

        /* ── Payment methods ── */
        .payment-methods {
            margin-top: 4mm;
            font-size: 10.5px;
        }
        .payment-methods strong { display: inline-block; min-width: 120px; }

        @@media print {
            .print-actions { display: none !important; }
            body { background: #fff; }
            .page-wrap { margin: 0; padding: 8mm 10mm; }
            .page-footer { position: fixed; bottom: 5mm; }
        }
    </style>
    <link rel="stylesheet" href="~/css/fonts.css" />
</head>
<body onload="window.print()">

<div class="print-actions">
    <button class="btn-print" onclick="window.print()">🖨 Print</button>
    <button class="btn-close-tab" onclick="window.close()">✕ Close</button>
</div>

<div class="page-wrap">

    <!-- ══ HEADER ══ -->
    @if (!showHeaderFooter)
    {
        @* Required B2C Bill Print Header = No: blank space for pre-printed letterhead *@
        <div class="letterhead-space"></div>
    }
    else
    {
    <div class="bill-header">
        <div class="header-top">
            <div class="header-left">
                @if (!string.IsNullOrWhiteSpace(settings?.LogoPath))
                {
                    <img src="@settings!.LogoPath" class="hosp-logo" alt="Hospital Logo" />
                }
                <div class="hosp-info-main">
                    <div class="hosp-name">@hospName</div>
                    <div class="hosp-badges">
                        @if (!string.IsNullOrWhiteSpace(settings?.HospitalType))
                        {
                            <span class="badge-pill badge-type">🏷 @settings!.HospitalType</span>
                        }
                        @if (!string.IsNullOrWhiteSpace(settings?.RegistrationNumber))
                        {
                            <span class="badge-pill badge-reg">📋 Reg: @settings!.RegistrationNumber</span>
                        }
                        @if (!string.IsNullOrWhiteSpace(settings?.NabhStatus))
                        {
                            <span class="badge-pill badge-nabh">✔ NABH: @settings!.NabhStatus</span>
                        }
                    </div>
                </div>
            </div>
            <div class="header-right">
                @if (!string.IsNullOrWhiteSpace(settings?.EmergencyNumber))
                {
                    <div class="emergency-box">
                        <span>📞 Emergency Helpline: @settings!.EmergencyNumber</span>
                    </div>
                }
                <div class="barcode-area" title="@Model.OPDBillNo">
                    |||||||||||||||||||||||||||||||||||||||
                </div>
            </div>
        </div>

        <div class="header-details-strip">
            @if (!string.IsNullOrWhiteSpace(settings?.Address))
            {
                <div class="item"><span class="item-title">📍 Address:</span><span>@settings!.Address</span></div>
            }
            @if (!string.IsNullOrWhiteSpace(phones))
            {
                <div class="item"><span class="item-title">📞 Contacts:</span><span>@phones</span></div>
            }
            @if (!string.IsNullOrWhiteSpace(settings?.EmailAddress))
            {
                <div class="item"><span class="item-title">✉ Email:</span><span>@settings!.EmailAddress</span></div>
            }
            @if (!string.IsNullOrWhiteSpace(settings?.Website))
            {
                <div class="item"><span class="item-title">🌐 Web:</span><span>@settings!.Website</span></div>
            }
            @if (!string.IsNullOrWhiteSpace(settings?.GSTCode))
            {
                <div class="item"><span class="item-title">Taxation:</span><span>GST: @settings!.GSTCode</span></div>
            }
            @if (!string.IsNullOrWhiteSpace(settings?.NabhCertificateNo))
            {
                <div class="item"><span class="item-title">NABH Cert:</span><span>@settings!.NabhCertificateNo</span></div>
            }
        </div>
    </div>
    }

    <!-- ══ BILL TITLE ══ -->
    <div class="section-title">
        Bill of Supply cum Receipt
        @if (isCancelled)
        {
            <span class="original-label" style="color: #c5221f;">CANCELLED</span>
        }
        else
        {
            <span class="original-label">Original</span>
        }
    </div>
    @if (isCancelled)
    {
        <div class="cancelled-watermark">CANCELLED</div>
    }

    <!-- ══ PATIENT / VISIT INFO ══ -->
    <table class="info-grid" style="margin-top:0;">
        <colgroup>
            <col style="width:18%"><col style="width:30%">
            <col style="width:18%"><col style="width:34%">
        </colgroup>
        <thead>
            <tr>
                <th class="col-header" colspan="2">Patient Information</th>
                <th class="col-header" colspan="2">Visit &amp; Consultation</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td class="lbl">Name</td>
                <td><strong>@Model.PatientName</strong></td>
                <td class="lbl">Mobile No</td>
                <td>@(string.IsNullOrWhiteSpace(Model.PhoneNumber) ? "—" : Model.PhoneNumber)</td>
            </tr>
            <tr>
                <td class="lbl">Bill No</td>
                <td><strong>@(Model.OPDBillNo ?? "—")</strong></td>
                <td class="lbl">Consulting Doctor</td>
                <td><strong>@(string.IsNullOrWhiteSpace(Model.ConsultingDoctorName) ? "—" : Model.ConsultingDoctorName)</strong></td>
            </tr>
            <tr>
                <td class="lbl">Receipt No</td>
                <td>@(receiptNos.Any() ? string.Join(", ", receiptNos) : "—")</td>
                <td class="lbl">Appointment</td>
                <td style="font-weight:600;color:#c00;">@apptDate</td>
            </tr>
            <tr>
                <td class="lbl">Age / Gender</td>
                <td>@(string.IsNullOrWhiteSpace(genderAge) ? "—" : genderAge)</td>
                <td class="lbl">Token No</td>
                <td><strong>@(Model.TokenNo ?? "—")</strong></td>
            </tr>
            <tr>
                <td class="lbl">Patient ID</td>
                <td>@Model.PatientCode</td>
                <td class="lbl">Billed By</td>
                <td>@(string.IsNullOrWhiteSpace(branchName) ? "—" : branchName)</td>
            </tr>
            <tr>
                <td class="lbl">Bill Date</td>
                <td>@billDate</td>
                <td class="lbl">Created By</td>
                <td>@(string.IsNullOrWhiteSpace(Model.CreatedByUser) ? "—" : Model.CreatedByUser)</td>
            </tr>
        </tbody>
    </table>

    <!-- ══ SERVICES TABLE ══ -->
    <table class="inv-table">
        <thead>
            <tr>
                <th style="width:30px;">#</th>
                <th style="width:90px;">Type</th>
                <th>Service / Consultation</th>
                <th style="width:75px;" class="num">Amount (₹)</th>
                <th style="width:70px;" class="num">GST (₹)</th>
                <th style="width:75px;" class="num">Total (₹)</th>
            </tr>
        </thead>
        <tbody>
            @for (int i = 0; i < lines.Count; i++)
            {
                var (item, gst) = lines[i];
                <tr>
                    <td>@(i + 1)</td>
                    <td>@(item.ServiceType ?? "—")</td>
                    <td>@(item.ItemName ?? "—")</td>
                    <td class="num">@item.ServiceCharges.ToString("N2")</td>
                    <td class="num">@(gst > 0 ? gst.ToString("N2") : "—")</td>
                    <td class="num"><strong>@((item.ServiceCharges + gst).ToString("N2"))</strong></td>
                </tr>
            }
            @if (!lines.Any())
            {
                <tr><td colspan="6" style="text-align:center;">No service items recorded.</td></tr>
            }
        </tbody>
    </table>

    <!-- ══ PAYMENT SUMMARY ══ -->
    <div class="summary-block">
        <table>
            <tr>
                <td class="s-lbl" style="width:55%;">Gross Amount :</td>
                <td class="s-val">@gross.ToString("N2")</td>
            </tr>
            <tr>
                <td class="s-lbl">Discount@(payment?.DiscountType == "P" && discount > 0 ? $" ({payment.DiscountValue:0.##}%)" : "") :</td>
                <td class="s-val">@discount.ToString("N2")</td>
            </tr>
            @if (gstTotal > 0)
            {
                <tr>
                    <td class="s-lbl">GST@(payment != null ? $" (CGST {payment.TotalCgstAmount:N2} + SGST {payment.TotalSgstAmount:N2})" : "") :</td>
                    <td class="s-val">+@gstTotal.ToString("N2")</td>
                </tr>
            }
            @if (roundOff != 0)
            {
                <tr>
                    <td class="s-lbl">Round Off :</td>
                    <td class="s-val">@(roundOff > 0 ? "+" : "")@roundOff.ToString("N2")</td>
                </tr>
            }
            <tr class="s-total">
                <td class="s-lbl">Grand Total :</td>
                <td class="s-val">@grandTotal.ToString("N2")</td>
            </tr>
            <tr>
                <td class="s-lbl">Received Amount :</td>
                <td class="s-val">@received.ToString("N2")</td>
            </tr>
            <tr>
                <td class="s-lbl">Balance :</td>
                <td class="s-val">@balance.ToString("N2")</td>
            </tr>
        </table>
        <div class="amount-words">
            <strong>Amount Paid in words :</strong> @amountInWords
        </div>
    </div>

    @if (payment != null && payment.Rows.Any())
    {
        <!-- ══ PAYMENT RECEIPTS ══ -->
        <table class="inv-table rcpt-table">
            <thead>
                <tr><th colspan="5" class="rcpt-caption">Payment Receipts</th></tr>
                <tr>
                    <th style="width:4%;">#</th>
                    <th style="width:20%;">Receipt No</th>
                    <th style="width:16%;">Payment Mode</th>
                    <th>Mode Details</th>
                    <th class="num" style="width:14%;">Amount (₹)</th>
                </tr>
            </thead>
            <tbody>
            @{ var rcptIdx = 0; }
            @foreach (var row in payment.Rows)
            {
                rcptIdx++;
                var refParts = new List<string>();
                if (!string.IsNullOrWhiteSpace(row.UPIRefNo)) refParts.Add($"UPI: {row.UPIRefNo}");
                if (!string.IsNullOrWhiteSpace(row.TransactionRef)) refParts.Add($"Ref: {row.TransactionRef}");
                if (!string.IsNullOrWhiteSpace(row.ChequeNo)) refParts.Add($"Cheque: {row.ChequeNo}");
                if (!string.IsNullOrWhiteSpace(row.BankName)) refParts.Add($"Bank: {row.BankName}");
                if (!string.IsNullOrWhiteSpace(row.CardLast4)) refParts.Add($"Card: ****{row.CardLast4}");
                <tr>
                    <td>@rcptIdx</td>
                    <td>@(row.ReceiptNo ?? "—")</td>
                    <td>@(string.IsNullOrWhiteSpace(row.MethodName) ? "—" : row.MethodName)</td>
                    <td>@(refParts.Any() ? string.Join(" · ", refParts) : "—")</td>
                    <td class="num">@row.PaidAmount.ToString("N2")</td>
                </tr>
            }
            </tbody>
            <tfoot>
                <tr class="total-row">
                    <td colspan="4" style="text-align:right; font-weight:bold;">Total Received@(payment.PaidOn.HasValue ? $" (last on {payment.PaidOn.Value:dd-MMM-yyyy hh:mm tt})" : "")</td>
                    <td class="num" style="font-weight:bold;">@payment.Rows.Sum(x => x.PaidAmount).ToString("N2")</td>
                </tr>
            </tfoot>
        </table>
    }

    @if (showHeaderFooter)
    {
    <hr style="margin:5mm 0 3mm 0; border:none; border-top:1px solid #bbb;" />

    <!-- ══ FOOTER NOTES ══ -->
    <div class="footer-notes">
        <p>Category of Service : <strong>Health Service by Clinical establishment</strong></p>
        @if (!string.IsNullOrWhiteSpace(settings?.GSTCode))
        {
            <p>GSTIN : <strong>@settings!.GSTCode</strong></p>
        }
        <br/>
        <p>This is a computer generated document, does not require any signature. Terms and Conditions Applicable.
        Please keep this bill for your follow-up visit. Consultation is valid as per the hospital's follow-up policy.</p>
    </div>

    <div class="footer-meta" style="margin-top:4mm;">
        <p>Created By : <strong>@(string.IsNullOrWhiteSpace(Model.CreatedByUser) ? "System" : Model.CreatedByUser)</strong>&nbsp;&nbsp;&nbsp;Printed By : <strong>@(string.IsNullOrWhiteSpace(printedBy) ? "Auto" : printedBy)</strong></p>
        @if (!string.IsNullOrWhiteSpace(settings?.GSTCode))
        {
            <p>GSTIN : @settings!.GSTCode</p>
        }
        @if (!string.IsNullOrWhiteSpace(settings?.Address))
        {
            <p>Address : @settings!.Address</p>
        }
    </div>
    }
</div>

@if (showHeaderFooter)
{
<!-- ══ PAGE FOOTER ══ -->
<div class="page-footer">
    <span>@printDate</span>
    <span>Page 1 of 1</span>
</div>
}

</body>
</html>
