@model EMR.Web.ApiClients.Models.PrescriptionPadInfo
@using EMR.Common
@{
    Layout = null;
    // OPD > "Print Dr. Prescription" (SQLScripts/2527): the consulting doctor's prescription pad, filled in with the visit.
    // Header: the branch's Bill print template, else the hospital name / address; blank space on pre-printed letterhead.
    var settings   = ViewBag.Settings as EMR.Web.Models.Entities.HospitalSettings;
    var branchName = ViewBag.BranchName as string;
    var showHeader = ViewBag.ShowHeaderFooter as bool? ?? true;
    var printTemplate = ViewData["PrintTemplate"] as PrintLayout;
    var printValues   = ViewData["PrintValues"] as Dictionary<string, string?>;
    var printLogoUrl  = ViewData["PrintLogoUrl"] as string;

    var hospName = settings?.HospitalName ?? branchName ?? "Hospital";
    var phones   = string.Join(" / ", new[] { settings?.ContactNumber1, settings?.ContactNumber2 }.Where(p => !string.IsNullOrWhiteSpace(p)));
    var visitDate = Model.VisitDate.ToString("dd-MMM-yyyy") + (Model.AppointmentTime.HasValue ? " " + DateTime.Today.Add(Model.AppointmentTime.Value).ToString("hh:mm tt") : "");
    var regNo = string.Join(" ", new[] { Model.RegistrationNo, Model.RegistrationCouncil }.Where(x => !string.IsNullOrWhiteSpace(x)));
    var barcode = string.IsNullOrWhiteSpace(Model.OPDBillNo) ? null : Code128.Svg(Model.OPDBillNo);
    var cancelled = string.Equals(Model.Status, "Cancelled", StringComparison.OrdinalIgnoreCase);
    string V(string? s) => string.IsNullOrWhiteSpace(s) ? "" : s;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Prescription — @Model.PatientName — @Model.OPDBillNo</title>
    <link rel="stylesheet" href="~/css/fonts.css" />
    <link rel="stylesheet" href="~/css/views/OPD/prescription-pad.css" asp-append-version="true" />
</head>
<body onload="window.print()">

<div class="rx-actions">
    <button type="button" class="rx-btn-print" onclick="window.print()">🖨 Print</button>
    <button type="button" class="rx-btn-close" onclick="window.close()">✕ Close</button>
</div>

<div class="rx-page">

    @* ── header ── *@
    @if (!showHeader)
    {
        <div class="rx-letterhead-space"></div>
    }
    else if (printTemplate is not null)
    {
        <partial name="_PrintBand" model="new PrintBandView { Band = printTemplate.Header, Values = printValues!, LogoUrl = printLogoUrl }" />
    }
    else
    {
        <div class="rx-header">
            @if (!string.IsNullOrWhiteSpace(settings?.LogoPath))
            {
                <img src="@settings!.LogoPath" class="rx-logo" alt="" />
            }
            <div class="rx-hosp">
                <div class="rx-hosp-name">@hospName</div>
                @if (!string.IsNullOrWhiteSpace(settings?.Address))
                {
                    <div class="rx-hosp-line">@settings!.Address</div>
                }
                @if (!string.IsNullOrWhiteSpace(phones))
                {
                    <div class="rx-hosp-line">Phone: @phones</div>
                }
            </div>
        </div>
    }

    @if (cancelled)
    {
        <div class="rx-cancelled">This visit is cancelled</div>
    }

    @* ── the visit ── *@
    <div class="rx-info">
        <div class="rx-info-grid">
            <div class="rx-f rx-col1"><span class="rx-l">Registration ID</span><span class="rx-c">:</span><span class="rx-v">@V(Model.PatientCode)</span></div>
            <div class="rx-f"><span class="rx-l">Visit ID</span><span class="rx-c">:</span><span class="rx-v">@V(Model.OPDBillNo)</span></div>
            <div class="rx-f"><span class="rx-l">Visit Date</span><span class="rx-c">:</span><span class="rx-v">@visitDate</span></div>

            <div class="rx-f rx-col1"><span class="rx-l">Patient Name</span><span class="rx-c">:</span><span class="rx-v rx-strong">@V(Model.PatientName)</span></div>
            <div class="rx-f"><span class="rx-l">Age</span><span class="rx-c">:</span><span class="rx-v">@V(Model.AgeText)</span></div>
            <div class="rx-f"><span class="rx-l">Sex</span><span class="rx-c">:</span><span class="rx-v">@V(Model.Gender)</span></div>

            <div class="rx-f rx-span2 rx-col1"><span class="rx-l">Address</span><span class="rx-c">:</span><span class="rx-v">@V(Model.Address)</span></div>
            <div class="rx-f"><span class="rx-l">Token No.</span><span class="rx-c">:</span><span class="rx-v">@V(Model.TokenNo)</span></div>

            <div class="rx-f rx-span3 rx-col1"><span class="rx-l">Phone No.</span><span class="rx-c">:</span><span class="rx-v">@V(Model.PhoneNumber)</span></div>

            <div class="rx-f rx-span2 rx-col1"><span class="rx-l">Consultant</span><span class="rx-c">:</span><span class="rx-v rx-strong">@V(Model.DoctorName)</span></div>
            <div class="rx-f"><span class="rx-l">Consultant No.</span><span class="rx-c">:</span><span class="rx-v">@regNo</span></div>

            <div class="rx-f rx-span2 rx-col1"><span class="rx-l">Department</span><span class="rx-c">:</span><span class="rx-v">@V(Model.Department)</span></div>
            <div class="rx-f rx-barcode-cell">
                @if (barcode is not null)
                {
                    <div class="rx-barcode" style="min-width:@(Code128.MinWidthMm(Model.OPDBillNo!).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))mm">@Html.Raw(barcode)</div>
                }
            </div>
        </div>
    </div>

    <div class="rx-title">PRESCRIPTION</div>

    @* ── the pad: notes on the left, the prescription on the right ── *@
    <div class="rx-pad">
        <div class="rx-side">
            <div class="rx-side-block">
                <div class="rx-side-h">Vitals</div>
                <div class="rx-side-row">BP <span></span></div>
                <div class="rx-side-row">Pulse <span></span></div>
                <div class="rx-side-row">Temp <span></span></div>
                <div class="rx-side-row">SpO₂ <span></span></div>
                <div class="rx-side-row">Weight <span></span></div>
                <div class="rx-side-row">Height <span></span></div>
            </div>
            <div class="rx-side-block"><div class="rx-side-h">Chief Complaints</div></div>
            <div class="rx-side-block"><div class="rx-side-h">History</div></div>
            <div class="rx-side-block"><div class="rx-side-h">Diagnosis</div></div>
            <div class="rx-side-block"><div class="rx-side-h">Investigations</div></div>
        </div>
        <div class="rx-main">
            <div class="rx-symbol" aria-hidden="true">℞</div>
            <div class="rx-sign">
                <div class="rx-sign-line"></div>
                <div class="rx-sign-name">@V(Model.DoctorName)</div>
                @if (!string.IsNullOrWhiteSpace(Model.Qualification))
                {
                    <div class="rx-sign-qual">@Model.Qualification</div>
                }
                @if (!string.IsNullOrWhiteSpace(regNo))
                {
                    <div class="rx-sign-reg">Reg. No. @regNo</div>
                }
            </div>
        </div>
    </div>

    <div class="rx-foot">
        <span>Next visit: ____________________</span>
        <span>Printed @DateTime.Now.ToString("dd-MMM-yyyy hh:mm tt")</span>
    </div>
</div>

</body>
</html>
