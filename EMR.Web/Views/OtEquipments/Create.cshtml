@model EMR.Web.Models.ViewModels.OtEquipmentFormViewModel
@{
    ViewData["Title"] = "Add OT Equipment";
}

<div class="row justify-content-center">
    <div class="col-12 col-lg-8">
        <nav aria-label="breadcrumb" class="mb-3">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-action="Index">OT Equipment Master</a></li>
                <li class="breadcrumb-item active" aria-current="page">Add Equipment</li>
            </ol>
        </nav>

        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-header bg-white py-3 border-bottom">
                <h5 class="card-title mb-0 fw-bold"><i class="bi bi-tools me-2 text-primary"></i>Add OT Equipment</h5>
            </div>
            <div class="card-body p-4">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3" role="alert"></div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="d-flex align-items-center justify-content-between mb-1">
                                <label asp-for="OtId" class="form-label fw-semibold mb-0"></label> <span class="text-danger">*</span>
                                @if (Model.IsOtLocked)
                                {
                                    <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle"><i class="bi bi-lock-fill me-1"></i>Pre-selected & Locked</span>
                                }
                            </div>
                            @if (Model.IsOtLocked)
                            {
                                <select asp-items="Model.OtOptions" class="form-select bg-light" disabled style="cursor: not-allowed;">
                                    <option value="">-- Select Operation Theatre --</option>
                                </select>
                                <input type="hidden" asp-for="OtId" />
                                <input type="hidden" asp-for="IsOtLocked" />
                                <small class="text-muted d-block mt-1"><i class="bi bi-info-circle me-1"></i>OT fixed from OT details page.</small>
                            }
                            else
                            {
                                <select asp-for="OtId" asp-items="Model.OtOptions" class="form-select">
                                    <option value="">-- Select Operation Theatre --</option>
                                </select>
                                <span asp-validation-for="OtId" class="text-danger small"></span>
                            }
                        </div>

                        <div class="col-md-6">
                            <label asp-for="EquipmentType" class="form-label fw-semibold"></label>
                            <select asp-for="EquipmentType" asp-items="Model.EquipmentTypeOptions" class="form-select">
                                <option value="">-- Select Category / Type --</option>
                            </select>
                            <span asp-validation-for="EquipmentType" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="EquipmentCode" class="form-label fw-semibold"></label> <span class="text-danger">*</span>
                            <input asp-for="EquipmentCode" class="form-control font-monospace" placeholder="e.g. EQ-CARM-01" style="text-transform:uppercase" />
                            <span asp-validation-for="EquipmentCode" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="EquipmentName" class="form-label fw-semibold"></label> <span class="text-danger">*</span>
                            <input asp-for="EquipmentName" class="form-control" placeholder="e.g. C-Arm Image Intensifier" />
                            <span asp-validation-for="EquipmentName" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="SerialNo" class="form-label fw-semibold"></label>
                            <input asp-for="SerialNo" class="form-control font-monospace" placeholder="e.g. SN-GE-9800-4412" />
                            <span asp-validation-for="SerialNo" class="text-danger small"></span>
                        </div>

                        <!-- Calibration Settings -->
                        <div class="col-12">
                            <div class="card bg-light border-0 p-3 rounded-3 mt-2">
                                <div class="form-check form-switch mb-3">
                                    <input asp-for="CalibrationRequired" class="form-check-input" type="checkbox" role="switch" id="switchCalibration" />
                                    <label class="form-check-label fw-semibold" for="switchCalibration">
                                        <i class="bi bi-patch-check me-1 text-primary"></i>Periodic Calibration & Biomedical Maintenance Required
                                    </label>
                                </div>
                                <div class="row g-3" id="calibrationFields">
                                    <div class="col-md-6">
                                        <label asp-for="LastCalibrationDate" class="form-label fw-semibold small"></label>
                                        <input asp-for="LastCalibrationDate" class="form-control form-control-sm" type="date" />
                                        <span asp-validation-for="LastCalibrationDate" class="text-danger small"></span>
                                    </div>
                                    <div class="col-md-6">
                                        <label asp-for="CalibrationDueDate" class="form-label fw-semibold small"></label>
                                        <input asp-for="CalibrationDueDate" class="form-control form-control-sm" type="date" />
                                        <span asp-validation-for="CalibrationDueDate" class="text-danger small"></span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-12">
                            <label asp-for="Description" class="form-label fw-semibold"></label>
                            <textarea asp-for="Description" class="form-control" rows="2" placeholder="Optional notes regarding manufacturer, warranty, power specs, or clinical instructions..."></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <div class="form-check form-switch">
                                <input asp-for="IsActive" class="form-check-input" type="checkbox" role="switch" id="switchIsActive" />
                                <label class="form-check-label fw-semibold" for="switchIsActive">Active Status</label>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check-lg me-1"></i>Save Equipment
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
