@model EMR.Web.Models.Entities.OtEquipmentMaster
@{
    ViewData["Title"] = "OT Equipment Details";
}

<div class="row justify-content-center">
    <div class="col-12 col-lg-8">
        <nav aria-label="breadcrumb" class="mb-3">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-action="Index">OT Equipment Master</a></li>
                <li class="breadcrumb-item active" aria-current="page">Equipment Details</li>
            </ol>
        </nav>

        <div class="card border-0 shadow-sm rounded-3 mb-4">
            <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                <h5 class="card-title mb-0 fw-bold"><i class="bi bi-tools me-2 text-primary"></i>OT Equipment Details</h5>
                <div>
                    @if (Model.IsActive)
                    {
                        <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2">Active</span>
                    }
                    else
                    {
                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-3 py-2">Inactive</span>
                    }
                </div>
            </div>
            <div class="card-body p-4">
                <div class="row g-4">
                    <div class="col-sm-6">
                        <label class="text-muted small d-block">Equipment Code</label>
                        <span class="font-monospace fs-5 fw-bold text-primary">@Model.EquipmentCode</span>
                    </div>
                    <div class="col-sm-6">
                        <label class="text-muted small d-block">Equipment Name</label>
                        <span class="fs-5 fw-semibold">@Model.EquipmentName</span>
                    </div>

                    <div class="col-sm-6">
                        <label class="text-muted small d-block">Assigned Operation Theatre</label>
                        <span class="fw-medium">@(Model.Ot?.OtName ?? "N/A")</span>
                        <div class="small text-muted">
                            <span class="font-monospace">@(Model.Ot?.OtCode)</span>
                            <span class="mx-1">•</span>
                            <span>@(Model.Ot?.OtType)</span>
                        </div>
                    </div>

                    <div class="col-sm-6">
                        <label class="text-muted small d-block">Location (Floor)</label>
                        <span class="fw-medium">@(Model.Ot?.Floor?.FloorName ?? "N/A")</span>
                    </div>

                    <div class="col-sm-6">
                        <label class="text-muted small d-block">Category / Type</label>
                        <span class="badge bg-light text-dark border fs-6">@(Model.EquipmentType ?? "General OT Equipment")</span>
                    </div>
                    <div class="col-sm-6">
                        <label class="text-muted small d-block">Model / Serial Number</label>
                        <span class="font-monospace fw-medium text-secondary">@(string.IsNullOrWhiteSpace(Model.SerialNo) ? "Not Specified" : Model.SerialNo)</span>
                    </div>

                    <!-- Calibration Details -->
                    <div class="col-12">
                        <div class="card bg-light border-0 p-3 rounded-3">
                            <h6 class="fw-bold text-dark mb-3"><i class="bi bi-patch-check me-2 text-primary"></i>Calibration & Maintenance Status</h6>
                            <div class="row g-3">
                                <div class="col-sm-4">
                                    <label class="text-muted small d-block">Calibration Required</label>
                                    @if (Model.CalibrationRequired)
                                    {
                                        <span class="badge bg-warning-subtle text-warning-emphasis border">Mandatory Periodic Calibration</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">Not Required</span>
                                    }
                                </div>
                                <div class="col-sm-4">
                                    <label class="text-muted small d-block">Last Calibration Date</label>
                                    <span class="fw-medium">@(Model.LastCalibrationDate.HasValue ? Model.LastCalibrationDate.Value.ToString("dd MMM yyyy") : "Never / Not Recorded")</span>
                                </div>
                                <div class="col-sm-4">
                                    <label class="text-muted small d-block">Next Calibration Due Date</label>
                                    @if (Model.CalibrationDueDate.HasValue)
                                    {
                                        var isOverdue = Model.CalibrationDueDate.Value.Date < DateTime.Today;
                                        <span class="fw-bold @(isOverdue ? "text-danger" : "text-success")">
                                            @Model.CalibrationDueDate.Value.ToString("dd MMM yyyy")
                                            @(isOverdue ? " (OVERDUE)" : "")
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">Not Scheduled</span>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-12">
                        <label class="text-muted small d-block">Description / Specs</label>
                        <p class="mb-0 text-secondary">@(string.IsNullOrWhiteSpace(Model.Description) ? "No description provided." : Model.Description)</p>
                    </div>

                    <div class="col-sm-6">
                        <label class="text-muted small d-block">Branch</label>
                        <span class="text-muted">@(Model.Branch?.BranchName ?? "Current Branch")</span>
                    </div>
                    <div class="col-sm-6">
                        <label class="text-muted small d-block">Created Date</label>
                        <span class="text-muted">@Model.CreatedDate.ToString("dd MMM yyyy, hh:mm tt")</span>
                    </div>
                </div>

                <div class="d-flex justify-content-between gap-2 mt-4 pt-3 border-top">
                    <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Back to List</a>
                    <a asp-action="Edit" asp-route-id="@Model.EquipmentId" class="btn btn-primary">
                        <i class="bi bi-pencil me-1"></i>Edit Equipment
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
