@model IEnumerable<EMR.Web.Models.ViewModels.OtEquipmentListItemViewModel>
@{
    ViewData["Title"] = "OT Equipment Master";
    var list = Model?.ToList() ?? [];
    var otOptions = ViewBag.OtOptions as List<SelectListItem> ?? [];
    int? selectedOt = ViewBag.SelectedOtId;
}

<div class="container-fluid px-0">
    <!-- Header -->
    <div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-2">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                    <li class="breadcrumb-item">Master</li>
                    <li class="breadcrumb-item">IPD Master</li>
                    <li class="breadcrumb-item active" aria-current="page">OT Equipment Master</li>
                </ol>
            </nav>
            <h1 class="h3 mb-0 fw-bold text-dark">
                <i class="bi bi-tools me-2 text-primary"></i>OT Equipment Master
                <span class="badge bg-primary-subtle text-primary border border-primary-subtle fs-6 ms-2">@list.Count</span>
            </h1>
        </div>
        <div class="d-flex gap-2">
            <a asp-controller="Ots" asp-action="Index" class="btn btn-outline-primary">
                <i class="bi bi-hospital me-1"></i>OT Master
            </a>
            <a asp-action="Create" class="btn btn-primary">
                <i class="bi bi-plus-lg me-1"></i>Add Equipment
            </a>
        </div>
    </div>

    <!-- Filter Card -->
    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-body p-3">
            <form method="get" asp-action="Index" class="row g-2 align-items-end">
                <div class="col-md-9">
                    <label class="form-label small fw-semibold text-muted mb-1">Operation Theatre (OT)</label>
                    <select name="otId" class="form-select form-select-sm" onchange="this.form.submit()">
                        <option value="">-- All Operation Theatres --</option>
                        @foreach (var opt in otOptions)
                        {
                            <option value="@opt.Value" selected="@(opt.Value == selectedOt?.ToString())">@opt.Text</option>
                        }
                    </select>
                </div>
                <div class="col-md-3 d-flex gap-2">
                    <button type="submit" class="btn btn-sm btn-primary flex-grow-1">
                        <i class="bi bi-filter me-1"></i>Filter
                    </button>
                    @if (selectedOt.HasValue)
                    {
                        <a asp-action="Index" class="btn btn-sm btn-outline-secondary" title="Clear Filters">
                            <i class="bi bi-x-circle"></i>
                        </a>
                    }
                </div>
            </form>
        </div>
    </div>

    <!-- Data Table -->
    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Code</th>
                            <th>Equipment Name</th>
                            <th>Operation Theatre</th>
                            <th>Category / Type</th>
                            <th>Serial / Model</th>
                            <th>Calibration Status</th>
                            <th>Status</th>
                            <th class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (list.Count == 0)
                        {
                            <tr>
                                <td colspan="8" class="text-center py-5 text-muted">
                                    <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                                    No OT equipment found.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in list)
                            {
                                <tr>
                                    <td class="ps-4">
                                        <span class="font-monospace fw-bold text-primary">@item.EquipmentCode</span>
                                    </td>
                                    <td>
                                        <div class="fw-semibold">@item.EquipmentName</div>
                                        @if (!string.IsNullOrWhiteSpace(item.Description))
                                        {
                                            <small class="text-muted text-truncate d-inline-block" style="max-width: 220px;">@item.Description</small>
                                        }
                                    </td>
                                    <td>
                                        <div class="fw-medium">@item.OtName</div>
                                        <small class="text-muted">
                                            <span class="font-monospace">@item.OtCode</span>
                                            <span class="mx-1">•</span>
                                            <span>@item.OtType</span>
                                        </small>
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark border">
                                            @(item.EquipmentType ?? "General")
                                        </span>
                                    </td>
                                    <td>
                                        <span class="font-monospace small text-secondary">
                                            @(string.IsNullOrWhiteSpace(item.SerialNo) ? "—" : item.SerialNo)
                                        </span>
                                    </td>
                                    <td>
                                        @if (!item.CalibrationRequired)
                                        {
                                            <span class="text-muted small">Not Required</span>
                                        }
                                        else if (item.CalibrationStatusFormatted == "Calibrated")
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle">
                                                <i class="bi bi-check-circle me-1"></i>Calibrated
                                            </span>
                                            <small class="text-muted d-block">Due: @item.CalibrationDueDate?.ToString("dd MMM yyyy")</small>
                                        }
                                        else if (item.CalibrationStatusFormatted == "Due Soon")
                                        {
                                            <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle">
                                                <i class="bi bi-exclamation-circle me-1"></i>Due Soon
                                            </span>
                                            <small class="text-muted d-block">Due: @item.CalibrationDueDate?.ToString("dd MMM yyyy")</small>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle">
                                                <i class="bi bi-exclamation-triangle-fill me-1"></i>@item.CalibrationStatusFormatted
                                            </span>
                                        }
                                    </td>
                                    <td>
                                        @if (item.IsActive)
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle">Inactive</span>
                                        }
                                    </td>
                                    <td class="text-end pe-4">
                                        <div class="btn-group btn-group-sm">
                                            <a asp-action="Details" asp-route-id="@item.EquipmentId" class="btn btn-outline-info" title="View Details">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            <a asp-action="Edit" asp-route-id="@item.EquipmentId" class="btn btn-outline-primary" title="Edit">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <form asp-action="ToggleStatus" asp-route-id="@item.EquipmentId" method="post" class="d-inline" onsubmit="return confirm('Toggle status for this equipment?');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-outline-warning" title="@(item.IsActive ? "Deactivate" : "Activate")">
                                                    <i class="bi @(item.IsActive ? "bi-slash-circle" : "bi-check-circle")"></i>
                                                </button>
                                            </form>
                                            <form asp-action="Delete" asp-route-id="@item.EquipmentId" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to remove this equipment?');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-outline-danger" title="Delete">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
