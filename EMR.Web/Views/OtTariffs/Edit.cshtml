@model EMR.Web.Models.ViewModels.OtTariffFormViewModel
@{
    ViewData["Title"] = "Edit OT Tariff";
}

<div class="row justify-content-center">
    <div class="col-12 col-lg-8">
        <nav aria-label="breadcrumb" class="mb-3">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-action="Index">OT Tariff Master</a></li>
                <li class="breadcrumb-item active" aria-current="page">Edit OT Tariff</li>
            </ol>
        </nav>

        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-header bg-white py-3 border-bottom">
                <h5 class="card-title mb-0 fw-bold"><i class="bi bi-pencil-square me-2 text-primary"></i>Edit Operation Theatre Tariff Rate</h5>
            </div>
            <div class="card-body p-4">
                <form asp-action="Edit" asp-route-id="@Model.OtTariffId" method="post" id="tariffForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="OtTariffId" />
                    <input type="hidden" asp-for="CompanyId" />
                    <input type="hidden" asp-for="BranchId" />

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3" role="alert"></div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="TariffCategoryId" class="form-label fw-semibold"></label> <span class="text-danger">*</span>
                            <select asp-for="TariffCategoryId" asp-items="Model.TariffCategoryOptions" class="form-select">
                                <option value="">-- Select Tariff Category --</option>
                            </select>
                            <span asp-validation-for="TariffCategoryId" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="OtId" class="form-label fw-semibold"></label> <span class="text-danger">*</span>
                            <select asp-for="OtId" asp-items="Model.OtOptions" class="form-select">
                                <option value="">-- Select Operation Theatre --</option>
                            </select>
                            <span asp-validation-for="OtId" class="text-danger small"></span>
                        </div>

                        <!-- OT Tariff Component Breakdown -->
                        <div class="col-12">
                            <div class="card bg-light border-0 p-3 rounded-3 mt-2">
                                <h6 class="fw-bold text-dark mb-3"><i class="bi bi-receipt me-2 text-primary"></i>OT Charges & Component Breakdown</h6>
                                
                                <div class="row g-3">
                                    <div class="col-md-4">
                                        <label asp-for="OtUsageRate" class="form-label fw-semibold small"></label>
                                        <div class="input-group input-group-sm">
                                            <span class="input-group-text"><i class="bi bi-currency-rupee"></i></span>
                                            <input asp-for="OtUsageRate" class="form-control fee-input" type="number" step="0.01" min="0" />
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <label asp-for="NursingCharges" class="form-label fw-semibold small"></label>
                                        <div class="input-group input-group-sm">
                                            <span class="input-group-text"><i class="bi bi-currency-rupee"></i></span>
                                            <input asp-for="NursingCharges" class="form-control fee-input" type="number" step="0.01" min="0" />
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <label asp-for="EquipmentCharges" class="form-label fw-semibold small"></label>
                                        <div class="input-group input-group-sm">
                                            <span class="input-group-text"><i class="bi bi-currency-rupee"></i></span>
                                            <input asp-for="EquipmentCharges" class="form-control fee-input" type="number" step="0.01" min="0" />
                                        </div>
                                    </div>

                                    <div class="col-md-4">
                                        <label asp-for="RecoveryCharges" class="form-label fw-semibold small"></label>
                                        <div class="input-group input-group-sm">
                                            <span class="input-group-text"><i class="bi bi-currency-rupee"></i></span>
                                            <input asp-for="RecoveryCharges" class="form-control fee-input" type="number" step="0.01" min="0" />
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <label asp-for="ConsumableCharges" class="form-label fw-semibold small"></label>
                                        <div class="input-group input-group-sm">
                                            <span class="input-group-text"><i class="bi bi-currency-rupee"></i></span>
                                            <input asp-for="ConsumableCharges" class="form-control fee-input" type="number" step="0.01" min="0" />
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <label asp-for="SpecialEquipmentCharges" class="form-label fw-semibold small"></label>
                                        <div class="input-group input-group-sm">
                                            <span class="input-group-text"><i class="bi bi-currency-rupee"></i></span>
                                            <input asp-for="SpecialEquipmentCharges" class="form-control fee-input" type="number" step="0.01" min="0" />
                                        </div>
                                    </div>

                                    <!-- Total Sum -->
                                    <div class="col-12">
                                        <div class="p-3 bg-white rounded-3 border d-flex justify-content-between align-items-center">
                                            <div>
                                                <span class="fw-bold text-dark">Total OT Tariff Rate:</span>
                                                <small class="text-muted d-block">Sum of OT usage, nursing, standard equipment, recovery, consumables & special equipment</small>
                                            </div>
                                            <div class="fs-4 fw-bold text-success font-monospace" id="totalRateDisplay">₹0.00</div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="EffectiveFrom" class="form-label fw-semibold"></label> <span class="text-danger">*</span>
                            <input asp-for="EffectiveFrom" class="form-control" type="date" />
                            <span asp-validation-for="EffectiveFrom" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="EffectiveTo" class="form-label fw-semibold"></label>
                            <input asp-for="EffectiveTo" class="form-control" type="date" />
                            <span asp-validation-for="EffectiveTo" class="text-danger small"></span>
                            <small class="text-muted d-block mt-1">Leave empty for ongoing tariff rate</small>
                        </div>

                        <div class="col-12">
                            <label asp-for="Description" class="form-label fw-semibold"></label>
                            <textarea asp-for="Description" class="form-control" rows="2" placeholder="Optional notes regarding this OT tariff package..."></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <div class="form-check form-switch">
                                <input asp-for="IsActive" class="form-check-input" type="checkbox" role="switch" id="switchIsActive" />
                                <label class="form-check-label fw-semibold" for="switchIsActive">Active Status</label>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check-lg me-1"></i>Save Changes
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function calculateTotal() {
            var total = 0;
            document.querySelectorAll('.fee-input').forEach(function (input) {
                var val = parseFloat(input.value) || 0;
                total += val;
            });
            document.getElementById('totalRateDisplay').innerText = '₹' + total.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        }

        document.querySelectorAll('.fee-input').forEach(function (input) {
            input.addEventListener('input', calculateTotal);
            input.addEventListener('change', calculateTotal);
        });

        calculateTotal();
    </script>
}
