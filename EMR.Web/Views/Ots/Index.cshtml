@model IEnumerable<EMR.Web.Models.ViewModels.OtListItemViewModel>
@{
    ViewData["Title"] = "OT Master";
    var list = Model?.ToList() ?? [];
    var floorOptions = ViewBag.FloorOptions as List<SelectListItem> ?? [];
    var typeOptions = ViewBag.OtTypeOptions as List<SelectListItem> ?? [];
    int? selectedFloor = ViewBag.SelectedFloorId;
    string? selectedType = ViewBag.SelectedOtType;
}

<div class="container-fluid px-0">
    <!-- Header -->
    <div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-2">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                    <li class="breadcrumb-item">Master</li>
                    <li class="breadcrumb-item">IPD Master</li>
                    <li class="breadcrumb-item active" aria-current="page">OT Master</li>
                </ol>
            </nav>
            <h1 class="h3 mb-0 fw-bold text-dark">
                <i class="bi bi-hospital me-2 text-primary"></i>Operation Theatre (OT) Master
                <span class="badge bg-primary-subtle text-primary border border-primary-subtle fs-6 ms-2">@list.Count</span>
            </h1>
        </div>
        <div class="d-flex gap-2">
            <a asp-controller="OtEquipments" asp-action="Index" class="btn btn-outline-info">
                <i class="bi bi-tools me-1"></i>OT Equipments
            </a>
            <a asp-controller="OtTariffs" asp-action="Index" class="btn btn-outline-success">
                <i class="bi bi-calculator me-1"></i>OT Tariffs
            </a>
            <a asp-action="Create" class="btn btn-primary">
                <i class="bi bi-plus-lg me-1"></i>Add Operation Theatre
            </a>
        </div>
    </div>

    <!-- Filter Card -->
    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-body p-3">
            <form method="get" asp-action="Index" class="row g-2 align-items-end">
                <div class="col-md-5">
                    <label class="form-label small fw-semibold text-muted mb-1">Building & Floor</label>
                    <select name="floorId" class="form-select form-select-sm" onchange="this.form.submit()">
                        <option value="">-- All Buildings & Floors --</option>
                        @foreach (var opt in floorOptions)
                        {
                            <option value="@opt.Value" selected="@(opt.Value == selectedFloor?.ToString())">@opt.Text</option>
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label small fw-semibold text-muted mb-1">OT Type</label>
                    <select name="otType" class="form-select form-select-sm" onchange="this.form.submit()">
                        <option value="">-- All OT Types --</option>
                        @foreach (var opt in typeOptions)
                        {
                            <option value="@opt.Value" selected="@(opt.Value == selectedType)">@opt.Text</option>
                        }
                    </select>
                </div>
                <div class="col-md-3 d-flex gap-2">
                    <button type="submit" class="btn btn-sm btn-primary flex-grow-1">
                        <i class="bi bi-filter me-1"></i>Filter
                    </button>
                    @if (selectedFloor.HasValue || !string.IsNullOrWhiteSpace(selectedType))
                    {
                        <a asp-action="Index" class="btn btn-sm btn-outline-secondary" title="Clear Filters">
                            <i class="bi bi-x-circle"></i>
                        </a>
                    }
                </div>
            </form>
        </div>
    </div>

    <!-- Data Table -->
    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">OT Code</th>
                            <th>Operation Theatre Name</th>
                            <th>OT Type</th>
                            <th>Location (Building & Floor)</th>
                            <th>Capacity</th>
                            <th>Emergency 24x7</th>
                            <th>Status</th>
                            <th class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (list.Count == 0)
                        {
                            <tr>
                                <td colspan="8" class="text-center py-5 text-muted">
                                    <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                                    No Operation Theatres found matching your criteria.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in list)
                            {
                                <tr>
                                    <td class="ps-4">
                                        <span class="font-monospace fw-bold text-primary">@item.OtCode</span>
                                    </td>
                                    <td>
                                        <div class="fw-semibold">@item.OtName</div>
                                        @if (!string.IsNullOrWhiteSpace(item.Description))
                                        {
                                            <small class="text-muted text-truncate d-inline-block" style="max-width: 250px;">@item.Description</small>
                                        }
                                    </td>
                                    <td>
                                        <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle">
                                            @item.OtType
                                        </span>
                                    </td>
                                    <td>
                                        <div class="small fw-medium">
                                            <i class="bi bi-building me-1 text-muted"></i>@item.LocationFormatted
                                        </div>
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark border">
                                            <i class="bi bi-layout-text-sidebar-reverse me-1"></i>@item.Capacity
                                        </span>
                                    </td>
                                    <td>
                                        @if (item.EmergencyAvailable)
                                        {
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle"><i class="bi bi-lightning-charge-fill me-1"></i>24x7 Available</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted small"><i class="bi bi-dash-circle me-1"></i>Scheduled</span>
                                        }
                                    </td>
                                    <td>
                                        @if (item.IsActive)
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle">Inactive</span>
                                        }
                                    </td>
                                    <td class="text-end pe-4">
                                        <div class="btn-group btn-group-sm">
                                            <a asp-action="Details" asp-route-id="@item.OtId" class="btn btn-outline-info" title="View Details">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            <a asp-action="Edit" asp-route-id="@item.OtId" class="btn btn-outline-primary" title="Edit">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <form asp-action="ToggleStatus" asp-route-id="@item.OtId" method="post" class="d-inline" onsubmit="return confirm('Toggle status for this Operation Theatre?');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-outline-warning" title="@(item.IsActive ? "Deactivate" : "Activate")">
                                                    <i class="bi @(item.IsActive ? "bi-slash-circle" : "bi-check-circle")"></i>
                                                </button>
                                            </form>
                                            <form asp-action="Delete" asp-route-id="@item.OtId" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to remove this Operation Theatre?');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-outline-danger" title="Delete">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
