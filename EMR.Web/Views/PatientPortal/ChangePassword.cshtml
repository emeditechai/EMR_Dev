@model EMR.Web.Models.ViewModels.PatientChangePasswordViewModel
@{
    ViewData["Title"] = "Set New Password";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - eCare360+</title>
    <link rel="stylesheet" href="~/css/fonts.css" />
    <link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css">
    @* the same look as the Patient Portal login page *@
    <style>
        :root {
            --primary: #6d4bb0;
            --primary-light: #8b6cc8;
            --secondary: #a8407a;
            --dark: #2b2d42;
            --ok: #16a34a;
        }
        body {
            /* portal-bg.png is used when present, otherwise portal-bg.jpg (the staff login keeps its own login-bg.jpg) */
            background:
                linear-gradient(135deg, rgba(34,22,74,.55) 0%, rgba(75,47,143,.35) 55%, rgba(122,58,138,.45) 100%),
                url('/Images/portal-bg.png') center / cover no-repeat fixed,
                url('/Images/portal-bg.jpg') center / cover no-repeat fixed;
            font-family: 'Inter', sans-serif;
            margin: 0;
            min-height: 100vh;
            color: #fff;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .login-wrapper { width: 100%; max-width: 460px; padding: 15px; }
        .login-card {
            background: rgba(255, 255, 255, 0.97);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.4);
            border-radius: 20px;
            padding: 36px 36px 30px;
            box-shadow: 0 15px 35px rgba(0,0,0,0.1), 0 5px 15px rgba(0,0,0,0.05);
            color: var(--dark);
        }
        .brand-header { text-align: center; margin-bottom: 22px; }
        .brand-icon {
            width: 64px; height: 64px; border-radius: 18px; margin: 0 auto 14px;
            display: flex; align-items: center; justify-content: center;
            font-size: 1.9rem; color: #fff;
            background: linear-gradient(135deg, var(--primary) 0%, var(--secondary) 100%);
            box-shadow: 0 8px 18px rgba(109, 75, 176, 0.3);
        }
        .brand-title { font-size: 1.6rem; font-weight: 700; margin-bottom: 4px; letter-spacing: -0.5px; }
        .brand-subtitle { color: #495057; font-size: 0.93rem; margin: 0; }
        .info-note {
            background: rgba(109, 75, 176, 0.08); border: 1px solid rgba(109, 75, 176, 0.18); color: #2f3e9e;
            border-radius: 12px; padding: 10px 14px; font-size: 0.88rem; display: flex; gap: 10px; align-items: flex-start;
        }
        .pw-field { position: relative; }
        .form-floating > .form-control {
            border-radius: 12px; border: 1px solid rgba(0,0,0,0.1);
            background-color: rgba(255, 255, 255, 0.92); box-shadow: none; padding-right: 3rem;
        }
        .form-floating > .form-control:focus {
            border-color: var(--primary-light); box-shadow: 0 0 0 0.25rem rgba(109, 75, 176, 0.15); background-color: #fff;
        }
        .form-floating > label { color: #6c757d; }
        .pw-toggle {
            position: absolute; top: 50%; right: 10px; transform: translateY(-50%); z-index: 5;
            border: 0; background: transparent; color: #6c757d; padding: 6px 8px; border-radius: 8px; line-height: 1;
        }
        .pw-toggle:hover, .pw-toggle:focus-visible { color: var(--primary); background: rgba(109, 75, 176, 0.08); outline: none; }
        .strength { height: 6px; border-radius: 6px; background: #e9ecef; overflow: hidden; margin: 10px 2px 6px; }
        .strength > span { display: block; height: 100%; width: 0; border-radius: 6px; transition: width .25s ease, background-color .25s ease; }
        .strength-text { font-size: 0.8rem; color: #6c757d; margin: 0 2px 10px; min-height: 1.1em; }
        .rules { list-style: none; padding: 0; margin: 0 0 18px; display: grid; grid-template-columns: 1fr 1fr; gap: 6px 12px; font-size: 0.84rem; }
        .rules li { color: #6c757d; display: flex; align-items: center; gap: 6px; }
        .rules li i { font-size: 0.95rem; }
        .rules li.ok { color: var(--ok); }
        .btn-login {
            background: linear-gradient(135deg, var(--primary) 0%, var(--secondary) 100%);
            border: none; border-radius: 12px; padding: 14px; font-weight: 600; font-size: 1.05rem;
            letter-spacing: 0.4px; color: white; transition: all 0.3s ease; box-shadow: 0 4px 15px rgba(109, 75, 176, 0.3);
        }
        .btn-login:hover { transform: translateY(-2px); box-shadow: 0 6px 20px rgba(109, 75, 176, 0.4); color: white; }
        .btn-login:disabled { opacity: .65; transform: none; }
        .alert-glass {
            background: rgba(220, 53, 69, 0.1); border: 1px solid rgba(220, 53, 69, 0.2); color: #dc3545; border-radius: 12px;
        }
        .alert-glass ul { margin: 0; padding-left: 1.1rem; }
        .back-link { color: #6c757d; text-decoration: none; font-size: 0.88rem; }
        .back-link:hover { color: var(--primary); }
        @@media (max-width: 420px) {
            .login-card { padding: 28px 20px 24px; }
            .rules { grid-template-columns: 1fr; }
        }
    </style>
</head>
<body>

    <div class="login-wrapper">
        <div class="login-card">
            <div class="brand-header">
                <div class="brand-icon"><i class="bi bi-shield-lock"></i></div>
                <h2 class="brand-title">Set New Password</h2>
                <p class="brand-subtitle">Choose your own password to secure your portal account</p>
            </div>

            @if (TempData["Success"] != null)
            {
                <div class="info-note mb-3">
                    <i class="bi bi-info-circle-fill mt-1"></i>
                    <span>@TempData["Success"]</span>
                </div>
            }

            <form asp-action="ChangePassword" method="post" id="changePasswordForm" novalidate>
                <input type="hidden" asp-for="PatientId" />

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-glass mb-3 px-3 py-2 small fw-medium">
                        <div asp-validation-summary="All" class="mb-0"></div>
                    </div>
                }

                <div class="pw-field form-floating">
                    <input asp-for="NewPassword" class="form-control" id="newPassword" placeholder="New password" autocomplete="new-password" autofocus />
                    <label for="newPassword">New password</label>
                    <button type="button" class="pw-toggle" data-target="newPassword" aria-label="Show password"><i class="bi bi-eye"></i></button>
                </div>
                <div class="strength" aria-hidden="true"><span id="strengthBar"></span></div>
                <div class="strength-text" id="strengthText" aria-live="polite"></div>

                <ul class="rules" id="pwRules">
                    <li data-rule="len"><i class="bi bi-circle"></i>At least 8 characters</li>
                    <li data-rule="letter"><i class="bi bi-circle"></i>At least one letter</li>
                    <li data-rule="digit"><i class="bi bi-circle"></i>At least one digit</li>
                    <li data-rule="match"><i class="bi bi-circle"></i>Both passwords match</li>
                </ul>

                <div class="pw-field form-floating mb-4">
                    <input asp-for="ConfirmPassword" class="form-control" id="confirmPassword" placeholder="Confirm password" autocomplete="new-password" />
                    <label for="confirmPassword">Confirm new password</label>
                    <button type="button" class="pw-toggle" data-target="confirmPassword" aria-label="Show password"><i class="bi bi-eye"></i></button>
                </div>

                <button type="submit" class="btn btn-login w-100" id="btnSave">
                    <i class="bi bi-check2-circle me-2"></i>Save password &amp; continue
                </button>

                <div class="text-center mt-3">
                    <a asp-action="Login" class="back-link"><i class="bi bi-arrow-left me-1"></i>Back to sign in</a>
                </div>
            </form>
        </div>

        <div class="text-center mt-4">
            <p class="small text-white-50 fw-medium">
                &copy; @DateTime.Now.Year eCare360+ Patient Portal. All rights reserved.
            </p>
        </div>
    </div>

    <script>
        (function () {
            const pw = document.getElementById('newPassword');
            const confirm = document.getElementById('confirmPassword');
            const bar = document.getElementById('strengthBar');
            const text = document.getElementById('strengthText');
            const btn = document.getElementById('btnSave');
            const rules = {
                len: v => v.length >= 8,
                letter: v => /[A-Za-z]/.test(v),
                digit: v => /\d/.test(v),
                match: v => v.length > 0 && v === confirm.value
            };

            // show / hide each password
            document.querySelectorAll('.pw-toggle').forEach(b => b.addEventListener('click', () => {
                const input = document.getElementById(b.dataset.target);
                const show = input.type === 'password';
                input.type = show ? 'text' : 'password';
                b.querySelector('i').className = show ? 'bi bi-eye-slash' : 'bi bi-eye';
                b.setAttribute('aria-label', show ? 'Hide password' : 'Show password');
            }));

            function update() {
                const v = pw.value;
                let met = 0;
                document.querySelectorAll('#pwRules li').forEach(li => {
                    const ok = rules[li.dataset.rule](v);
                    li.classList.toggle('ok', ok);
                    li.querySelector('i').className = ok ? 'bi bi-check-circle-fill' : 'bi bi-circle';
                    if (ok && li.dataset.rule !== 'match') met++;
                });
                // strength: the three rules plus length 12+ and a mix of cases / symbols
                let score = met;
                if (v.length >= 12) score++;
                if (/[a-z]/.test(v) && /[A-Z]/.test(v) && /[^A-Za-z0-9]/.test(v)) score++;
                const levels = [
                    { w: 0, c: '#e9ecef', t: '' },
                    { w: 25, c: '#dc3545', t: 'Weak' },
                    { w: 45, c: '#fd7e14', t: 'Fair' },
                    { w: 70, c: '#0d6efd', t: 'Good' },
                    { w: 85, c: '#16a34a', t: 'Strong' },
                    { w: 100, c: '#15803d', t: 'Very strong' }
                ];
                const l = v.length === 0 ? levels[0] : levels[Math.min(score, 5)] || levels[1];
                bar.style.width = l.w + '%';
                bar.style.backgroundColor = l.c;
                text.textContent = l.t ? 'Password strength: ' + l.t : '';
                btn.disabled = !(rules.len(v) && rules.letter(v) && rules.digit(v) && rules.match(v));
            }

            pw.addEventListener('input', update);
            confirm.addEventListener('input', update);
            update();
            document.getElementById('changePasswordForm').addEventListener('submit', () => {
                btn.disabled = true;
                btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Saving...';
            });
        })();
    </script>
</body>
</html>
