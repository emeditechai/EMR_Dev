@model EMR.Web.Models.ViewModels.PatientDetailsViewModel
@{
    // Patient Portal home: the same data as Master > Patient Master > View (Services/PatientProfileService), arranged
    // for the patient - sections instead of staff tables. Bills, prescriptions and reports open through
    // PatientPortalController, which checks they belong to the signed-in patient.
    ViewData["Title"] = "My Health";
    Layout = null;
    var p = Model.Patient;
    var hospitalName = ViewData["HospitalName"] as string;
    var brand = string.IsNullOrWhiteSpace(hospitalName) ? "Patient Portal" : hospitalName;
    var fullName = string.Join(" ", new[] { p.Salutation, p.FirstName, p.MiddleName, p.LastName }.Where(x => !string.IsNullOrEmpty(x)));
    var firstName = string.IsNullOrWhiteSpace(p.FirstName) ? fullName : p.FirstName;
    var initials = ((p.FirstName?.Length > 0 ? p.FirstName[0].ToString() : "") + (p.LastName?.Length > 0 ? p.LastName[0].ToString() : "")).ToUpper();
    if (string.IsNullOrEmpty(initials)) initials = "?";
    var age = EMR.Web.Utils.AgeCalculator.FormatAgePattern(p.DateOfBirth);
    var greeting = DateTime.Now.Hour < 12 ? "Good morning" : DateTime.Now.Hour < 17 ? "Good afternoon" : "Good evening";

    var card = Model.CurrentCard;
    var cardMembers = card == null ? new List<EMR.Web.Models.ViewModels.PatientCardMemberItem>() : Model.CardMembers.Where(m => m.CardId == card.CardId && m.IsActive).ToList();
    string CardTone(string s) => s switch { "Active" => "ok", "Expired" => "warn", "Blocked" => "bad", _ => "muted" };
    var isHead = p.RelationId == 1;
    var headOfFamily = isHead ? null : Model.Family.FirstOrDefault(f => f.IsSelf);
    var family = Model.Family.Where(f => f.IsActive).ToList();
    var opd = Model.BillingSummary.FirstOrDefault(b => b.ModuleCode == "OPD");
    var lab = Model.BillingSummary.FirstOrDefault(b => b.ModuleCode == "LAB");
    var totalBilled = Model.BillingSummary.Sum(b => b.NetAmount);
    var totalPaid = Model.BillingSummary.Sum(b => b.Paid);
    var totalDue = Model.BillingSummary.Sum(b => b.Due);
    string TxnLabel(string t) => t switch { "ISSUE" => "Card issued", "EARN" => "Earned", "REDEEM" => "Redeemed", "REVERSE" => "Reversed", "RESTORE" => "Restored", "DISCOUNT" => "Member discount", "STATUS" => "Status change", _ => t };
    static bool IsPaid(string s) => s == "P" || s == "Fully Paid";
    static bool IsPart(string s) => s == "D" || s == "Partially Paid";
    static string PayText(string s) => IsPaid(s) ? "Paid" : IsPart(s) ? "Part paid" : "Unpaid";
    static string PayTone(string s) => IsPaid(s) ? "ok" : IsPart(s) ? "warn" : "bad";
    string Initials(string name) => string.Concat(name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Where(w => !w.EndsWith(".")).Take(2).Select(w => char.ToUpper(w[0])));
    string Money(decimal v) => "₹" + v.ToString("N2");

    var labs = Model.LabOrderHistory ?? new List<EMR.Web.Models.ViewModels.PatientLabOrderHistoryItem>();
    var readyReports = labs.Where(l => l.ApprovedTestCount > 0 && IsPaid(l.PaymentStatus)).ToList();
    var upcoming = Model.VisitHistory
        .Where(v => v.VisitDate.Date >= DateTime.Today && !string.Equals(v.Status, "Completed", StringComparison.OrdinalIgnoreCase)
                    && !string.Equals(v.Status, "Cancelled", StringComparison.OrdinalIgnoreCase))
        .OrderBy(v => v.VisitDate).ToList();
    var latestVital = Model.VitalHistory.OrderByDescending(v => v.RecordedOn).FirstOrDefault();
    var lastVisit = Model.VisitHistory.OrderByDescending(v => v.VisitDate).FirstOrDefault();
    var lastLab = labs.OrderByDescending(l => l.OrderDate).FirstOrDefault();

    // recent activity: OPD visits and LAB bills, newest first
    var activity = Model.VisitHistory.Select(v => (Date: v.VisitDate, Kind: "opd", Opd: v, Lab: (EMR.Web.Models.ViewModels.PatientLabOrderHistoryItem?)null))
        .Concat(labs.Select(l => (Date: l.OrderDate, Kind: "lab", Opd: (EMR.Web.Models.ViewModels.PatientVisitHistoryItem?)null, Lab: (EMR.Web.Models.ViewModels.PatientLabOrderHistoryItem?)l)))
        .OrderByDescending(a => a.Date).Take(6).ToList();
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @brand</title>
    <link rel="stylesheet" href="~/css/fonts.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" asp-append-version="true" />
    <style>
        :root {
            --bg: #f5f6fb; --surface: #ffffff; --line: #e8e9f3; --ink: #1d1b2f; --muted: #6b6a85;
            --brand: #6d4bb0; --brand-2: #a8407a; --brand-soft: #f1ecfa;
            --ok: #12805c; --ok-soft: #e3f6ee; --warn: #a15c00; --warn-soft: #fff3dc; --bad: #c2273a; --bad-soft: #fde8eb;
            --info: #1d63c9; --info-soft: #e6effd; --radius: 18px;
        }
        * { -webkit-tap-highlight-color: transparent; }
        body { background: var(--bg); color: var(--ink); font-family: 'Inter', system-ui, -apple-system, 'Segoe UI', sans-serif; font-size: 15px; margin: 0; }
        .num { font-variant-numeric: tabular-nums; }
        .mono { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; }
        .muted { color: var(--muted); }

        /* top bar */
        .pp-top { background: var(--surface); border-bottom: 1px solid var(--line); position: sticky; top: 0; z-index: 30; }
        .pp-top .inner { max-width: 1320px; margin: 0 auto; padding: 10px 20px; display: flex; align-items: center; justify-content: space-between; gap: 12px; }
        .pp-logo { display: flex; align-items: center; gap: 10px; min-width: 0; text-decoration: none; color: var(--ink); }
        .pp-logo .mark { width: 38px; height: 38px; border-radius: 12px; flex-shrink: 0; display: grid; place-items: center; color: #fff;
                         background: linear-gradient(135deg, var(--brand), var(--brand-2)); font-size: 1.1rem; }
        .pp-logo .t { font-weight: 700; line-height: 1.1; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .pp-logo .s { font-size: .72rem; color: var(--muted); letter-spacing: .06em; text-transform: uppercase; }
        .pp-me { display: flex; align-items: center; gap: 10px; }
        .pp-me .av { width: 36px; height: 36px; border-radius: 50%; display: grid; place-items: center; font-weight: 700; font-size: .8rem; color: var(--brand); background: var(--brand-soft); }
        .pp-me .nm { font-weight: 600; font-size: .88rem; line-height: 1.1; }
        .pp-me .id { font-size: .72rem; color: var(--muted); }
        .btn-out { border: 1px solid var(--line); border-radius: 999px; padding: 6px 14px; font-size: .82rem; color: var(--ink); background: var(--surface); }
        .btn-out:hover { border-color: var(--bad); color: var(--bad); }

        /* layout */
        .pp-wrap { max-width: 1320px; margin: 0 auto; padding: 22px 20px 40px; display: grid; grid-template-columns: 230px minmax(0, 1fr); gap: 26px; }
        .pp-nav { position: sticky; top: 82px; align-self: start; display: flex; flex-direction: column; gap: 4px; }
        .pp-nav button { all: unset; cursor: pointer; display: flex; align-items: center; gap: 12px; padding: 11px 14px; border-radius: 12px; color: var(--muted); font-weight: 500; }
        .pp-nav button i { font-size: 1.1rem; }
        .pp-nav button:hover { background: var(--surface); color: var(--ink); }
        .pp-nav button.active { background: var(--surface); color: var(--brand); font-weight: 600; box-shadow: 0 1px 2px rgba(30,20,60,.06), inset 3px 0 0 var(--brand); }
        .pp-nav .count { margin-left: auto; font-size: .72rem; background: var(--bg); color: var(--muted); border-radius: 999px; padding: 1px 8px; }
        .pp-nav .help { margin-top: 18px; padding: 14px; border-radius: 14px; background: var(--brand-soft); color: var(--ink); font-size: .82rem; line-height: 1.45; }
        section.pp-sec { display: none; }
        section.pp-sec.active { display: block; animation: fade .2s ease; }
        @@keyframes fade { from { opacity: .4; transform: translateY(4px); } to { opacity: 1; transform: none; } }
        .sec-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 12px; margin-bottom: 16px; flex-wrap: wrap; }
        .sec-head h2 { font-size: 1.35rem; font-weight: 700; margin: 0; letter-spacing: -.01em; }
        .sec-head p { margin: 2px 0 0; color: var(--muted); font-size: .9rem; }

        /* surfaces */
        .box { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); padding: 20px; }
        .box + .box { margin-top: 16px; }
        .box h3 { font-size: 1rem; font-weight: 700; margin: 0 0 14px; display: flex; align-items: center; gap: 8px; }
        .box h3 .link { margin-left: auto; font-size: .82rem; font-weight: 600; color: var(--brand); cursor: pointer; background: none; border: 0; padding: 0; }
        .grid { display: grid; gap: 16px; }
        .g2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        .g3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }

        /* hero */
        .hero { position: relative; overflow: hidden; border-radius: 22px; padding: 26px; color: #fff;
                background: radial-gradient(120% 140% at 100% 0%, rgba(255,255,255,.18) 0, rgba(255,255,255,0) 45%), linear-gradient(120deg, #5b3fa0 0%, #7d50b6 55%, #a8407a 100%); }
        .hero .row1 { display: flex; gap: 18px; align-items: center; flex-wrap: wrap; }
        .hero .big-av { width: 76px; height: 76px; border-radius: 22px; background: rgba(255,255,255,.95); color: var(--brand); display: grid; place-items: center; font-weight: 800; font-size: 1.6rem; overflow: hidden; flex-shrink: 0; }
        .hero .big-av img { width: 100%; height: 100%; object-fit: cover; }
        .hero .hi { font-size: .9rem; opacity: .85; }
        .hero h1 { font-size: 1.65rem; font-weight: 800; margin: 2px 0 8px; letter-spacing: -.02em; }
        .chip { display: inline-flex; align-items: center; gap: 6px; border-radius: 999px; padding: 4px 11px; font-size: .78rem; font-weight: 600; }
        .hero .chip { background: rgba(255,255,255,.18); color: #fff; }
        .hero .chip.gold { background: #ffd66b; color: #4a3300; }
        .hero .copy { border: 0; cursor: pointer; font: inherit; font-size: .78rem; }
        .hero .copy:hover { background: rgba(255,255,255,.28); }
        .hero .actions { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 20px; }
        .hero .act { display: inline-flex; align-items: center; gap: 8px; padding: 10px 14px; border-radius: 12px; font-weight: 600; font-size: .88rem;
                     background: rgba(255,255,255,.96); color: var(--ink); text-decoration: none; border: 0; }
        .hero .act i { color: var(--brand); }
        .hero .act:hover { background: #fff; transform: translateY(-1px); }

        /* stats */
        .stat { background: var(--surface); border: 1px solid var(--line); border-radius: 16px; padding: 14px 16px; display: flex; gap: 12px; align-items: center; }
        .stat .ic { width: 42px; height: 42px; border-radius: 12px; display: grid; place-items: center; font-size: 1.15rem; flex-shrink: 0; }
        .stat .k { font-size: .74rem; color: var(--muted); font-weight: 600; text-transform: uppercase; letter-spacing: .04em; }
        .stat .v { font-size: 1.15rem; font-weight: 700; line-height: 1.2; }
        .stat .s { font-size: .76rem; color: var(--muted); }
        .t-brand { background: var(--brand-soft); color: var(--brand); } .t-ok { background: var(--ok-soft); color: var(--ok); }
        .t-info { background: var(--info-soft); color: var(--info); } .t-warn { background: var(--warn-soft); color: var(--warn); } .t-bad { background: var(--bad-soft); color: var(--bad); }
        .pill { display: inline-flex; align-items: center; gap: 5px; border-radius: 999px; padding: 3px 10px; font-size: .74rem; font-weight: 600; white-space: nowrap; }
        .pill.ok { background: var(--ok-soft); color: var(--ok); } .pill.warn { background: var(--warn-soft); color: var(--warn); }
        .pill.bad { background: var(--bad-soft); color: var(--bad); } .pill.muted { background: var(--bg); color: var(--muted); } .pill.info { background: var(--info-soft); color: var(--info); }

        /* vitals tiles */
        .vt { border: 1px solid var(--line); border-radius: 14px; padding: 12px 14px; }
        .vt .k { font-size: .74rem; color: var(--muted); display: flex; align-items: center; gap: 6px; }
        .vt .v { font-size: 1.25rem; font-weight: 700; margin-top: 2px; }
        .vt .v small { font-size: .74rem; color: var(--muted); font-weight: 500; }

        /* lists */
        .item { display: flex; gap: 14px; align-items: center; padding: 14px 0; border-bottom: 1px solid var(--line); }
        .item:last-child { border-bottom: 0; padding-bottom: 2px; }
        .item:first-child { padding-top: 2px; }
        .item .ic { width: 44px; height: 44px; border-radius: 13px; display: grid; place-items: center; font-size: 1.15rem; flex-shrink: 0; }
        .item .main { flex: 1; min-width: 0; }
        .item .ttl { font-weight: 600; }
        .item .sub { font-size: .82rem; color: var(--muted); }
        .item .end { text-align: right; flex-shrink: 0; display: flex; flex-direction: column; align-items: flex-end; gap: 6px; }
        .btn-soft { display: inline-flex; align-items: center; gap: 6px; border-radius: 10px; padding: 6px 12px; font-size: .8rem; font-weight: 600; text-decoration: none; border: 1px solid var(--line); color: var(--ink); background: var(--surface); white-space: nowrap; }
        .btn-soft:hover { border-color: var(--brand); color: var(--brand); }
        .btn-soft.primary { background: var(--brand); border-color: var(--brand); color: #fff; }
        .btn-soft.primary:hover { filter: brightness(1.08); color: #fff; }
        .btn-soft[aria-disabled="true"] { opacity: .55; pointer-events: none; }
        .datebox { width: 54px; flex-shrink: 0; text-align: center; border-radius: 13px; background: var(--brand-soft); color: var(--brand); padding: 6px 0; line-height: 1.1; }
        .datebox .d { font-size: 1.2rem; font-weight: 800; } .datebox .m { font-size: .7rem; font-weight: 700; text-transform: uppercase; letter-spacing: .05em; }
        .datebox.lab { background: var(--info-soft); color: var(--info); }
        .meta { display: flex; flex-wrap: wrap; gap: 4px 14px; font-size: .82rem; color: var(--muted); margin-top: 3px; }
        .meta span { display: inline-flex; align-items: center; gap: 5px; }
        .empty { text-align: center; color: var(--muted); padding: 30px 10px; }
        .empty i { font-size: 2rem; display: block; margin-bottom: 8px; opacity: .5; }
        .filters { display: flex; gap: 6px; flex-wrap: wrap; }
        .filters button { all: unset; cursor: pointer; padding: 6px 13px; border-radius: 999px; font-size: .8rem; font-weight: 600; background: var(--surface); border: 1px solid var(--line); color: var(--muted); }
        .filters button.on { background: var(--ink); border-color: var(--ink); color: #fff; }

        /* timeline */
        .tl { position: relative; padding-left: 26px; }
        .tl::before { content: ""; position: absolute; left: 9px; top: 6px; bottom: 6px; width: 2px; background: var(--line); }
        .tl .ev { position: relative; padding: 0 0 16px; }
        .tl .ev:last-child { padding-bottom: 0; }
        .tl .dot { position: absolute; left: -26px; top: 2px; width: 20px; height: 20px; border-radius: 50%; display: grid; place-items: center; font-size: .65rem; color: #fff; border: 3px solid var(--surface); }

        /* membership */
        .mcard { border-radius: 20px; color: #fff; padding: 22px; position: relative; overflow: hidden; min-height: 190px;
                 background: linear-gradient(135deg, #22164a 0%, #4b2f8f 50%, #a8407a 100%); box-shadow: 0 18px 40px -18px rgba(75,47,143,.6); }
        .mcard.off { background: linear-gradient(135deg, #4b5563, #6b7280); box-shadow: none; }
        .mcard::before { content: ""; position: absolute; width: 240px; height: 240px; border-radius: 50%; right: -80px; top: -90px; background: rgba(255,255,255,.08); }
        .mcard::after { content: ""; position: absolute; width: 160px; height: 160px; border-radius: 50%; right: 40px; bottom: -110px; background: rgba(255,255,255,.06); }
        .mcard .no { font-family: ui-monospace, Menlo, monospace; font-size: 1.35rem; letter-spacing: .16em; font-weight: 700; margin: 18px 0 14px; }
        .mcard .k { font-size: .66rem; text-transform: uppercase; letter-spacing: .1em; opacity: .7; }
        .mcard .v { font-weight: 600; }
        .kv { display: flex; justify-content: space-between; gap: 12px; padding: 9px 0; border-bottom: 1px dashed var(--line); font-size: .9rem; }
        .kv:last-child { border-bottom: 0; }
        .kv .k { color: var(--muted); }
        .kv .v { font-weight: 600; text-align: right; }
        .person { display: flex; align-items: center; gap: 12px; padding: 10px 0; border-bottom: 1px solid var(--line); }
        .person:last-child { border-bottom: 0; }
        .person .av { width: 40px; height: 40px; border-radius: 50%; display: grid; place-items: center; font-weight: 700; font-size: .8rem; background: var(--brand-soft); color: var(--brand); flex-shrink: 0; }
        .field { padding: 12px 14px; border: 1px solid var(--line); border-radius: 14px; }
        .field .k { font-size: .76rem; color: var(--muted); }
        .field .v { font-weight: 600; margin-top: 2px; word-break: break-word; }
        .note { border-radius: 14px; padding: 14px 16px; font-size: .9rem; }
        .chart-box { position: relative; height: 320px; }
        .vcards { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; }
        .vcard { background: var(--surface); border: 1px solid var(--line); border-radius: 18px; padding: 16px 16px 10px; cursor: pointer; position: relative; overflow: hidden;
                 transition: transform .15s ease, box-shadow .15s ease, border-color .15s ease; }
        .vcard:hover { transform: translateY(-2px); box-shadow: 0 10px 24px -14px rgba(60,30,110,.35); }
        .vcard.on { border-color: var(--brand); box-shadow: 0 0 0 3px var(--brand-soft); }
        .vcard .top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px; }
        .vcard .ic { width: 38px; height: 38px; border-radius: 12px; display: grid; place-items: center; font-size: 1.05rem; }
        .vcard .k { font-size: .78rem; color: var(--muted); font-weight: 600; }
        .vcard .v { font-size: 1.7rem; font-weight: 800; letter-spacing: -.02em; line-height: 1.15; }
        .vcard .v small { font-size: .78rem; font-weight: 600; color: var(--muted); margin-left: 4px; }
        .vcard .d { font-size: .76rem; color: var(--muted); min-height: 1.1em; }
        .vcard .r { font-size: .74rem; color: var(--muted); opacity: .85; }
        .vcard canvas.spark { width: 100% !important; height: 38px !important; margin-top: 6px; display: block; }
        @@media (max-width: 991.98px) { .vcards { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
        @@media (max-width: 575.98px) { .vcard .v { font-size: 1.4rem; } }
        table.mini { width: 100%; font-size: .85rem; }
        table.mini th { font-size: .72rem; text-transform: uppercase; letter-spacing: .04em; color: var(--muted); font-weight: 600; padding: 8px 10px; border-bottom: 1px solid var(--line); white-space: nowrap; }
        table.mini td { padding: 10px; border-bottom: 1px solid var(--line); vertical-align: middle; }
        table.mini tr:last-child td { border-bottom: 0; }
        .rx { border: 1px solid var(--line); border-radius: 16px; padding: 16px 18px; }
        /* lab bill workflow (the same stages staff see in Audit History), refreshed live */
        .lab-item { flex-wrap: wrap; }
        .wf { flex-basis: 100%; margin-left: 68px; margin-top: 2px; }
        .wf-track { display: flex; gap: 4px; }
        .wf-track span { flex: 1; height: 6px; border-radius: 6px; background: var(--line); position: relative; }
        .wf-track span.done { background: var(--ok); }
        .wf-track span.current { background: linear-gradient(90deg, var(--info) 50%, var(--info-soft) 50%); }
        .wf-track span.issue { background: var(--bad); }
        .wf-track span.skipped { background: repeating-linear-gradient(45deg, var(--line) 0 4px, transparent 4px 8px); }
        .wf-now { font-size: .82rem; margin-top: 6px; display: flex; gap: 6px; align-items: baseline; flex-wrap: wrap; }
        .wf-now b { color: var(--ink); }
        .wf-now .when { color: var(--muted); font-size: .76rem; }
        .wf-steps { display: none; margin-top: 10px; border-left: 2px solid var(--line); padding-left: 14px; }
        .wf.open .wf-steps { display: block; }
        .wf-steps .st { position: relative; padding: 0 0 10px; font-size: .82rem; }
        .wf-steps .st::before { content: ""; position: absolute; left: -21px; top: 4px; width: 12px; height: 12px; border-radius: 50%; background: var(--line); border: 2px solid var(--surface); }
        .wf-steps .st.done::before { background: var(--ok); } .wf-steps .st.current::before { background: var(--info); }
        .wf-steps .st.issue::before { background: var(--bad); }
        .wf-steps .st .l { font-weight: 600; } .wf-steps .st .d { color: var(--muted); }
        .wf-toggle { all: unset; cursor: pointer; color: var(--brand); font-weight: 600; font-size: .78rem; }
        .live { display: inline-flex; align-items: center; gap: 6px; font-size: .76rem; color: var(--muted); }
        .live i { width: 8px; height: 8px; border-radius: 50%; background: var(--ok); box-shadow: 0 0 0 0 rgba(18,128,92,.5); animation: pulse 2s infinite; display: inline-block; }
        @@keyframes pulse { 0% { box-shadow: 0 0 0 0 rgba(18,128,92,.45); } 70% { box-shadow: 0 0 0 7px rgba(18,128,92,0); } 100% { box-shadow: 0 0 0 0 rgba(18,128,92,0); } }
        @@media (max-width: 575.98px) { .wf { margin-left: 0; } }
        footer.pp-foot { text-align: center; color: var(--muted); font-size: .8rem; padding: 10px 20px 30px; }

        /* phones and tablets: the section menu becomes a scrolling pill bar */
        @@media (max-width: 991.98px) {
            .pp-wrap { grid-template-columns: 1fr; gap: 16px; padding-top: 0; }
            .pp-nav { position: sticky; top: 59px; z-index: 20; flex-direction: row; overflow-x: auto; gap: 6px; padding: 10px 2px; margin: 0 -20px; padding-left: 20px; padding-right: 20px;
                      background: var(--bg); scrollbar-width: none; }
            .pp-nav::-webkit-scrollbar { display: none; }
            .pp-nav button { flex-shrink: 0; padding: 8px 14px; border-radius: 999px; background: var(--surface); border: 1px solid var(--line); font-size: .85rem; }
            .pp-nav button.active { box-shadow: none; background: var(--brand); border-color: var(--brand); color: #fff; }
            .pp-nav button.active .count { background: rgba(255,255,255,.25); color: #fff; }
            .pp-nav .help { display: none; }
            .g3 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        }
        @@media (max-width: 575.98px) {
            body { font-size: 14px; }
            .pp-top .inner, .pp-wrap { padding-left: 16px; padding-right: 16px; }
            .pp-nav { margin: 0 -16px; padding-left: 16px; padding-right: 16px; }
            .pp-me .nm, .pp-me .id { display: none; }
            .g2 { grid-template-columns: 1fr; }
            .hero { padding: 20px; } .hero h1 { font-size: 1.35rem; }
            .box { padding: 16px; }
            .item { flex-wrap: wrap; }
            .item .end { flex-direction: row; align-items: center; width: 100%; justify-content: space-between; padding-left: 58px; }
        }
    </style>
</head>
<body>
    <header class="pp-top">
        <div class="inner">
            <a class="pp-logo" href="@Url.Action("Dashboard")">
                <span class="mark"><i class="bi bi-heart-pulse-fill"></i></span>
                <span style="min-width:0"><span class="t d-block">@brand</span><span class="s">Patient Portal</span></span>
            </a>
            <div class="pp-me">
                <div class="av">@initials</div>
                <div><div class="nm">@fullName</div><div class="id mono">@p.PatientCode</div></div>
                <form asp-action="Logout" method="post" class="m-0">
                    <button type="submit" class="btn-out"><i class="bi bi-box-arrow-right me-1"></i>Log out</button>
                </form>
            </div>
        </div>
    </header>

    <div class="pp-wrap">
        <nav class="pp-nav" aria-label="Sections">
            <button data-sec="overview" class="active"><i class="bi bi-house-heart"></i>Overview</button>
            <button data-sec="visits"><i class="bi bi-hospital"></i>Visits<span class="count">@Model.VisitHistory.Count</span></button>
            <button data-sec="labs"><i class="bi bi-droplet-half"></i>Lab Reports<span class="count">@labs.Count</span></button>
            <button data-sec="rx"><i class="bi bi-capsule"></i>Prescriptions</button>
            <button data-sec="vitals"><i class="bi bi-activity"></i>Vitals<span class="count">@Model.VitalHistory.Count</span></button>
            <button data-sec="membership"><i class="bi bi-credit-card-2-front"></i>Membership</button>
            <button data-sec="profile"><i class="bi bi-person-vcard"></i>My Profile</button>
            <div class="help"><i class="bi bi-headset me-1"></i>Something not right in your record? Please contact the hospital reception.</div>
        </nav>

        <main>
            @if (TempData["Success"] != null)
            {
                <div class="note t-ok mb-3"><i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]</div>
            }

            <!-- ═══ Overview ═══ -->
            <section class="pp-sec active" id="sec-overview">
                <div class="hero mb-3">
                    <div class="row1">
                        <div class="big-av">
                            @if (!string.IsNullOrEmpty(p.PhotoPath)) { <img src="@p.PhotoPath" alt="" /> } else { <span>@initials</span> }
                        </div>
                        <div style="min-width:0">
                            <div class="hi">@greeting,</div>
                            <h1>@fullName</h1>
                            <div class="d-flex flex-wrap gap-2">
                                <button class="chip copy" type="button" id="copyId" title="Copy your Patient ID"><i class="bi bi-person-badge"></i><span class="mono">@p.PatientCode</span><i class="bi bi-copy"></i></button>
                                @if (!string.IsNullOrEmpty(p.Gender)) { <span class="chip">@p.Gender</span> }
                                @if (!string.IsNullOrEmpty(age)) { <span class="chip">@age</span> }
                                @if (!string.IsNullOrEmpty(p.BloodGroup)) { <span class="chip"><i class="bi bi-droplet-fill"></i>@p.BloodGroup</span> }
                                <span class="chip"><i class="bi bi-diagram-3"></i>@(isHead ? "Head of family" : (Model.RelationName ?? "Family member"))</span>
                                @if (card != null) { <span class="chip gold"><i class="bi bi-credit-card-2-front"></i>@card.CardNo · @card.EffectiveStatus</span> }
                            </div>
                        </div>
                    </div>
                    <div class="actions">
                        @if (readyReports.Any())
                        {
                            <a class="act" href="@Url.Action("Report", new { id = readyReports.OrderByDescending(r => r.OrderDate).First().LabOrderId })" target="_blank"><i class="bi bi-file-earmark-medical"></i>Latest lab report</a>
                        }
                        @if (lastVisit != null)
                        {
                            <a class="act" href="@Url.Action("OpdBill", new { id = lastVisit.OPDServiceId })" target="_blank"><i class="bi bi-receipt"></i>Last OPD bill</a>
                        }
                        <button class="act" type="button" data-go="rx"><i class="bi bi-capsule"></i>Prescriptions</button>
                        <button class="act" type="button" data-go="vitals"><i class="bi bi-graph-up-arrow"></i>My vitals</button>
                    </div>
                </div>

                <div class="grid g3 mb-3">
                    <div class="stat"><div class="ic t-brand"><i class="bi bi-hospital"></i></div><div><div class="k">OPD Visits</div><div class="v num">@Model.VisitHistory.Count</div><div class="s">@(opd == null ? "No bills" : $"{Money(opd.NetAmount)} billed")</div></div></div>
                    <div class="stat"><div class="ic t-info"><i class="bi bi-droplet-half"></i></div><div><div class="k">Lab Bills</div><div class="v num">@labs.Count</div><div class="s">@(lab == null ? "No bills" : $"{Money(lab.NetAmount)} billed")</div></div></div>
                    <div class="stat"><div class="ic t-ok"><i class="bi bi-wallet2"></i></div><div><div class="k">Total Billed</div><div class="v num">@Money(totalBilled)</div><div class="s">Paid @Money(totalPaid)</div></div></div>
                    <div class="stat"><div class="ic @(totalDue > 0 ? "t-bad" : "t-ok")"><i class="bi @(totalDue > 0 ? "bi-exclamation-circle" : "bi-check2-circle")"></i></div><div><div class="k">Outstanding</div><div class="v num @(totalDue > 0 ? "text-danger" : "")">@Money(totalDue)</div><div class="s">@(totalDue > 0 ? "Due at the hospital" : "Nothing due")</div></div></div>
                    <div class="stat"><div class="ic t-warn"><i class="bi bi-credit-card-2-front"></i></div><div><div class="k">Membership</div>
                        @if (card != null) { <div class="v mono">@card.CardNo</div><div class="s">@card.EffectiveStatus · @card.PointsBalance.ToString("0.##") points</div> }
                        else { <div class="v">—</div><div class="s">No card</div> }
                    </div></div>
                    <div class="stat"><div class="ic t-brand"><i class="bi bi-people"></i></div><div><div class="k">Family</div><div class="v num">@(Model.Family.Count + 1)</div><div class="s">@(Model.Family.Count == 0 ? "Only you" : $"on {p.PhoneNumber}")</div></div></div>
                </div>

                <div class="grid g2">
                    <div>
                        <div class="box">
                            <h3><i class="bi bi-calendar-heart text-danger"></i>Upcoming appointment</h3>
                            @if (upcoming.Any())
                            {
                                foreach (var u in upcoming.Take(2))
                                {
                                    <div class="item">
                                        <div class="datebox"><div class="d">@u.VisitDate.Day</div><div class="m">@u.VisitDate.ToString("MMM")</div></div>
                                        <div class="main">
                                            <div class="ttl">@(u.ConsultingDoctorName ?? "Consultation")</div>
                                            <div class="meta"><span><i class="bi bi-calendar3"></i>@u.VisitDate.ToString("dddd")</span>
                                                @if (u.VisitDate.TimeOfDay.TotalMinutes > 0) { <span><i class="bi bi-clock"></i>@u.VisitDate.ToString("hh:mm tt")</span> }
                                                @if (!string.IsNullOrEmpty(u.TokenNo)) { <span><i class="bi bi-ticket-perforated"></i>Token @u.TokenNo</span> }</div>
                                        </div>
                                        <span class="pill info">@u.Status</span>
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="empty py-3"><i class="bi bi-calendar-check"></i>No upcoming appointment.</div>
                            }
                        </div>

                        <div class="box">
                            <h3><i class="bi bi-heart-pulse text-danger"></i>Latest vitals <button class="link" data-go="vitals">All vitals <i class="bi bi-arrow-right"></i></button></h3>
                            @if (latestVital != null)
                            {
                                <div class="grid g2" style="gap:10px">
                                    <div class="vt"><div class="k"><i class="bi bi-heart"></i>Blood pressure</div><div class="v num">@(latestVital.BPSystolic.HasValue ? $"{latestVital.BPSystolic}/{latestVital.BPDiastolic}" : "--") <small>mmHg</small></div></div>
                                    <div class="vt"><div class="k"><i class="bi bi-activity"></i>Pulse</div><div class="v num">@(latestVital.PulseRate?.ToString() ?? "--") <small>bpm</small></div></div>
                                    <div class="vt"><div class="k"><i class="bi bi-lungs"></i>SpO2</div><div class="v num">@(latestVital.SpO2?.ToString("0.#") ?? "--") <small>%</small></div></div>
                                    <div class="vt"><div class="k"><i class="bi bi-person-arms-up"></i>Weight</div><div class="v num">@(latestVital.Weight?.ToString("0.#") ?? "--") <small>kg@(latestVital.BMI.HasValue ? $" · BMI {latestVital.BMI:0.0}" : "")</small></div></div>
                                </div>
                                <div class="small muted mt-2">Recorded @latestVital.RecordedOn.ToString("dd MMM yyyy, hh:mm tt")</div>
                            }
                            else
                            {
                                <div class="empty py-3"><i class="bi bi-activity"></i>No vitals recorded yet.</div>
                            }
                        </div>
                    </div>

                    <div>
                        <div class="box">
                            <h3><i class="bi bi-file-earmark-medical text-success"></i>Reports ready <button class="link" data-go="labs">All reports <i class="bi bi-arrow-right"></i></button></h3>
                            @if (readyReports.Any())
                            {
                                foreach (var r in readyReports.OrderByDescending(r => r.OrderDate).Take(3))
                                {
                                    <div class="item">
                                        <div class="ic t-ok"><i class="bi bi-file-earmark-check"></i></div>
                                        <div class="main"><div class="ttl mono" style="font-size:.88rem">@r.BillNo</div><div class="sub">@r.OrderDate.ToString("dd MMM yyyy") · @r.ApprovedTestCount test@(r.ApprovedTestCount == 1 ? "" : "s") approved</div></div>
                                        <a class="btn-soft primary" href="@Url.Action("Report", new { id = r.LabOrderId })" target="_blank"><i class="bi bi-download"></i>Report</a>
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="empty py-3"><i class="bi bi-hourglass-split"></i>No report ready to download yet.</div>
                            }
                        </div>

                        <div class="box">
                            <h3><i class="bi bi-clock-history text-primary"></i>Recent activity</h3>
                            @if (activity.Any())
                            {
                                <div class="tl">
                                    @foreach (var a in activity)
                                    {
                                        <div class="ev">
                                            @if (a.Kind == "opd")
                                            {
                                                var v = a.Opd!;
                                                <span class="dot" style="background:var(--brand)"><i class="bi bi-hospital"></i></span>
                                                <div class="d-flex justify-content-between gap-2">
                                                    <div style="min-width:0"><div class="fw-semibold">OPD visit@(string.IsNullOrEmpty(v.ConsultingDoctorName) ? "" : $" · {v.ConsultingDoctorName}")</div>
                                                        <div class="sub muted small">@v.VisitDate.ToString("dd MMM yyyy") · @Money(v.TotalAmount)</div></div>
                                                    <span class="pill @PayTone(v.PaymentStatus) align-self-start">@PayText(v.PaymentStatus)</span>
                                                </div>
                                            }
                                            else
                                            {
                                                var l = a.Lab!;
                                                <span class="dot" style="background:var(--info)"><i class="bi bi-droplet-half"></i></span>
                                                <div class="d-flex justify-content-between gap-2">
                                                    <div style="min-width:0"><div class="fw-semibold">Lab tests · <span class="mono small">@l.BillNo</span></div>
                                                        <div class="sub muted small">@l.OrderDate.ToString("dd MMM yyyy") · @Money(l.TotalAmount)</div></div>
                                                    <span class="pill @(l.ApprovedTestCount > 0 && IsPaid(l.PaymentStatus) ? "ok" : "muted") align-self-start" data-stage-of="@l.LabOrderId">@(l.ApprovedTestCount > 0 && IsPaid(l.PaymentStatus) ? "Report ready" : l.ApprovedTestCount > 0 ? "Pay to view" : "In progress")</span>
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="empty py-3"><i class="bi bi-clock-history"></i>No visits or tests yet.</div>
                            }
                        </div>
                    </div>
                </div>
            </section>

            <!-- ═══ Visits ═══ -->
            <section class="pp-sec" id="sec-visits">
                <div class="sec-head"><div><h2>My Visits</h2><p>Your OPD consultations and their bills.</p></div></div>
                <div class="box">
                    @if (Model.VisitHistory.Any())
                    {
                        foreach (var v in Model.VisitHistory)
                        {
                            <div class="item">
                                <div class="datebox"><div class="d">@v.VisitDate.Day</div><div class="m">@v.VisitDate.ToString("MMM yy")</div></div>
                                <div class="main">
                                    <div class="ttl">@(v.ConsultingDoctorName ?? "OPD visit")</div>
                                    <div class="meta">
                                        @if (!string.IsNullOrEmpty(v.ServiceTypesSummary)) { <span><i class="bi bi-clipboard2-pulse"></i>@v.ServiceTypesSummary</span> }
                                        <span><i class="bi bi-ticket-perforated"></i>@(string.IsNullOrEmpty(v.TokenNo) ? "Token pending" : $"Token {v.TokenNo}")</span>
                                        <span class="mono"><i class="bi bi-receipt"></i>@v.OPDBillNo</span>
                                    </div>
                                </div>
                                <div class="end">
                                    <div class="fw-bold num">@Money(v.TotalAmount)</div>
                                    <div class="d-flex gap-2 align-items-center">
                                        <span class="pill @PayTone(v.PaymentStatus)">@PayText(v.PaymentStatus)</span>
                                        <a class="btn-soft" href="@Url.Action("OpdBill", new { id = v.OPDServiceId })" target="_blank"><i class="bi bi-receipt"></i>Bill</a>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="empty"><i class="bi bi-calendar-x"></i>No OPD visits yet.</div>
                    }
                </div>
                <div class="box">
                    <h3><i class="bi bi-bar-chart-line text-warning"></i>Visit trends
                        <span class="ms-auto filters" id="visitMetric"><button class="on" data-v="amount">Bill amount</button><button data-v="consulting">Visits per doctor</button></span></h3>
                    <div class="chart-box"><canvas id="visitsChart"></canvas><div class="empty" id="visitsEmpty" style="display:none"><i class="bi bi-bar-chart"></i>No visits to show yet.</div></div>
                </div>
            </section>

            <!-- ═══ Lab reports ═══ -->
            <section class="pp-sec" id="sec-labs">
                <div class="sec-head">
                    <div><h2>Lab Reports</h2><p>Follow each bill from sample to report. Download a report once your tests are approved and the bill is paid.</p>
                        <div class="live mt-1" id="liveNote" hidden><i></i><span>Live status · updated <b id="liveAt"></b></span></div></div>
                    <div class="filters" id="labFilter"><button class="on" data-f="all">All (@labs.Count)</button><button data-f="ready">Ready (@readyReports.Count)</button><button data-f="pending">In progress</button></div>
                </div>
                <div class="box" id="labList">
                    @if (labs.Any())
                    {
                        foreach (var l in labs)
                        {
                            var paid = IsPaid(l.PaymentStatus);
                            var ready = l.ApprovedTestCount > 0 && paid;
                            <div class="item lab-item" data-id="@l.LabOrderId" data-ready="@(ready ? "1" : "0")">
                                <div class="datebox lab"><div class="d">@l.OrderDate.Day</div><div class="m">@l.OrderDate.ToString("MMM yy")</div></div>
                                <div class="main">
                                    <div class="ttl mono" style="font-size:.92rem">@l.BillNo</div>
                                    <div class="meta">
                                        <span><i class="bi bi-cash-stack"></i>Bill @Money(l.TotalAmount)</span>
                                        @if (l.DiscountAmount > 0) { <span><i class="bi bi-tag"></i>Discount @Money(l.DiscountAmount)</span> }
                                        <span><i class="bi bi-check2"></i>Paid @Money(l.PaidAmount)</span>
                                        <span class="pill @PayTone(l.PaymentStatus)" data-role="pay">@PayText(l.PaymentStatus)</span>
                                    </div>
                                </div>
                                <div class="end">
                                    <span class="pill @(ready ? "ok" : l.ApprovedTestCount > 0 ? "warn" : "muted")" data-role="stage"><i class="bi @(ready ? "bi-check-circle-fill" : "bi-hourglass-split")"></i><span>@(ready ? "Report ready" : l.ApprovedTestCount > 0 ? "Pay to view" : "In progress")</span></span>
                                    <div class="d-flex gap-2">
                                        <a class="btn-soft" href="@Url.Action("LabBill", new { id = l.LabOrderId })" target="_blank"><i class="bi bi-receipt"></i>Bill</a>
                                        <a class="btn-soft primary" data-role="report" href="@Url.Action("Report", new { id = l.LabOrderId })" target="_blank" aria-disabled="@(ready ? "false" : "true")"
                                           title="@(ready ? $"{l.ApprovedTestCount} approved test{(l.ApprovedTestCount == 1 ? "" : "s")}" : l.ApprovedTestCount > 0 ? "Available once the bill is paid" : "Not ready yet")"><i class="bi bi-download"></i>Report</a>
                                    </div>
                                </div>
                                <div class="wf" data-role="wf"></div>
                            </div>
                        }
                        <div class="empty" id="labEmpty" style="display:none"><i class="bi bi-funnel"></i>Nothing here.</div>
                    }
                    else
                    {
                        <div class="empty"><i class="bi bi-droplet-half"></i>No lab tests yet.</div>
                    }
                </div>
            </section>

            <!-- ═══ Prescriptions ═══ -->
            <section class="pp-sec" id="sec-rx">
                <div class="sec-head"><div><h2>Prescriptions</h2><p>From your OPD consultations.</p></div></div>
                <div id="rxList" class="box"><div class="empty"><div class="spinner-border spinner-border-sm me-2"></div>Loading your prescriptions...</div></div>
            </section>

            <!-- ═══ Vitals ═══ -->
            <section class="pp-sec" id="sec-vitals">
                <div class="sec-head"><div><h2>My Vitals</h2><p>Recorded at your visits.</p></div></div>
                @{
                    var vs = Model.VitalHistory.OrderByDescending(v => v.RecordedOn).ToList();
                    var vNow = vs.FirstOrDefault();
                    T? Prev<T>(Func<EMR.Web.ApiClients.Models.VitalRow, T?> f) where T : struct => vs.Skip(1).Select(f).FirstOrDefault(x => x.HasValue);
                    string Delta(decimal? now, decimal? before, string unit) =>
                        now is null || before is null ? "" : now == before ? "Same as last time" : $"{(now > before ? "▲" : "▼")} {Math.Abs(now.Value - before.Value):0.#} {unit} since last";
                    (string Tone, string Text) Bp(int? s1, int? d1) => s1 is null ? ("muted", "") : s1 >= 140 || d1 >= 90 ? ("bad", "High") : s1 >= 130 || d1 >= 80 ? ("warn", "Raised") : s1 >= 120 ? ("warn", "Elevated") : s1 < 90 || d1 < 60 ? ("info", "Low") : ("ok", "Normal");
                    (string Tone, string Text) Range(decimal? v, decimal lo, decimal hi) => v is null ? ("muted", "") : v < lo ? ("info", "Low") : v > hi ? ("bad", "High") : ("ok", "Normal");
                }
                @if (vNow != null)
                {
                    var bp = Bp(vNow.BPSystolic, vNow.BPDiastolic);
                    var pu = Range(vNow.PulseRate, 60, 100);
                    var sp = vNow.SpO2 is null ? ("muted", "") : vNow.SpO2 >= 95 ? ("ok", "Normal") : vNow.SpO2 >= 90 ? ("warn", "Low") : ("bad", "Very low");
                    var tp = Range(vNow.Temperature, 97m, 99.5m);
                    var gl = vNow.BloodGlucose is null ? ("muted", "") : string.Equals(vNow.GlucoseType, "Fasting", StringComparison.OrdinalIgnoreCase)
                        ? Range(vNow.BloodGlucose, 70, 99) : Range(vNow.BloodGlucose, 70, 139);
                    var bmiTone = vNow.BMICategory == "Normal" ? "ok" : string.IsNullOrEmpty(vNow.BMICategory) ? "muted" : "warn";
                    <div class="vcards mb-3">
                        <div class="vcard" data-metric="bp"><div class="top"><span class="ic t-bad"><i class="bi bi-heart-pulse-fill"></i></span><span class="pill @bp.Tone">@bp.Text</span></div>
                            <div class="k">Blood pressure</div><div class="v num">@(vNow.BPSystolic.HasValue ? $"{vNow.BPSystolic}/{vNow.BPDiastolic}" : "--")<small>mmHg</small></div>
                            <div class="d">@Delta(vNow.BPSystolic, Prev(v => v.BPSystolic), "systolic")</div><div class="r">Normal below 120/80</div><canvas class="spark" data-key="bpSystolic"></canvas></div>
                        <div class="vcard" data-metric="pulse"><div class="top"><span class="ic t-ok"><i class="bi bi-activity"></i></span><span class="pill @pu.Tone">@pu.Text</span></div>
                            <div class="k">Pulse</div><div class="v num">@(vNow.PulseRate?.ToString() ?? "--")<small>bpm</small></div>
                            <div class="d">@Delta(vNow.PulseRate, Prev(v => v.PulseRate), "bpm")</div><div class="r">Normal 60 – 100 bpm</div><canvas class="spark" data-key="pulseRate"></canvas></div>
                        <div class="vcard" data-metric="spo2"><div class="top"><span class="ic t-info"><i class="bi bi-lungs-fill"></i></span><span class="pill @sp.Item1">@sp.Item2</span></div>
                            <div class="k">Oxygen (SpO2)</div><div class="v num">@(vNow.SpO2?.ToString("0.#") ?? "--")<small>%</small></div>
                            <div class="d">@Delta(vNow.SpO2, Prev(v => v.SpO2), "%")</div><div class="r">Normal 95% or more</div><canvas class="spark" data-key="spO2"></canvas></div>
                        <div class="vcard" data-metric="temp"><div class="top"><span class="ic t-warn"><i class="bi bi-thermometer-half"></i></span><span class="pill @tp.Tone">@tp.Text</span></div>
                            <div class="k">Temperature</div><div class="v num">@(vNow.Temperature?.ToString("0.#") ?? "--")<small>°F</small></div>
                            <div class="d">@Delta(vNow.Temperature, Prev(v => v.Temperature), "°F")</div><div class="r">Normal 97 – 99.5 °F</div><canvas class="spark" data-key="temperature"></canvas></div>
                        <div class="vcard" data-metric="weight"><div class="top"><span class="ic t-brand"><i class="bi bi-person-arms-up"></i></span><span class="pill @bmiTone">@(string.IsNullOrEmpty(vNow.BMICategory) ? "" : $"BMI {vNow.BMI:0.0} · {vNow.BMICategory}")</span></div>
                            <div class="k">Weight</div><div class="v num">@(vNow.Weight?.ToString("0.#") ?? "--")<small>kg</small></div>
                            <div class="d">@Delta(vNow.Weight, Prev(v => v.Weight), "kg")</div><div class="r">Height @(vNow.Height?.ToString("0.#") ?? "--") cm</div><canvas class="spark" data-key="weight"></canvas></div>
                        <div class="vcard" data-metric="glucose"><div class="top"><span class="ic t-info"><i class="bi bi-droplet-half"></i></span><span class="pill @gl.Item1">@gl.Item2</span></div>
                            <div class="k">Blood glucose@(string.IsNullOrEmpty(vNow.GlucoseType) ? "" : $" ({vNow.GlucoseType})")</div><div class="v num">@(vNow.BloodGlucose?.ToString("0.#") ?? "--")<small>mg/dL</small></div>
                            <div class="d">@Delta(vNow.BloodGlucose, Prev(v => v.BloodGlucose), "mg/dL")</div><div class="r">@(string.Equals(vNow.GlucoseType, "Fasting", StringComparison.OrdinalIgnoreCase) ? "Normal fasting 70 – 99" : "Normal 70 – 139")</div><canvas class="spark" data-key="bloodGlucose"></canvas></div>
                    </div>
                    <div class="small muted mb-3"><i class="bi bi-clock me-1"></i>Latest reading @vNow.RecordedOn.ToString("dd MMM yyyy, hh:mm tt") · @vs.Count reading@(vs.Count == 1 ? "" : "s") in total. Ranges are general adult guides - your doctor knows what is right for you.</div>
                }
                <div class="box">
                    <h3><i class="bi bi-graph-up-arrow text-danger"></i>Trend
                        <span class="ms-auto filters" id="vitalMetric"><button class="on" data-v="bp">BP</button><button data-v="pulse">Pulse</button><button data-v="spo2">SpO2</button><button data-v="temp">Temp</button><button data-v="weight">Weight</button><button data-v="glucose">Glucose</button></span></h3>
                    <div class="chart-box"><canvas id="vitalsChart"></canvas><div class="empty" id="vitalsEmpty" style="display:none"><i class="bi bi-graph-up"></i>No vitals recorded yet.</div></div>
                </div>
                <div class="box">
                    <h3><i class="bi bi-list-ul text-success"></i>All readings</h3>
                    @if (Model.VitalHistory.Any())
                    {
                        <div class="table-responsive">
                            <table class="mini">
                                <thead><tr><th>Date</th><th>BP</th><th>Pulse</th><th>SpO2</th><th>Temp</th><th>Height / Weight</th><th>BMI</th><th>Glucose</th></tr></thead>
                                <tbody>
                                    @foreach (var vt in Model.VitalHistory)
                                    {
                                        <tr>
                                            <td class="text-nowrap fw-semibold">@vt.RecordedOn.ToString("dd MMM yyyy")<div class="small muted">@vt.RecordedOn.ToString("hh:mm tt")</div></td>
                                            <td class="num text-nowrap">@(vt.BPSystolic.HasValue || vt.BPDiastolic.HasValue ? $"{vt.BPSystolic}/{vt.BPDiastolic}" : "--")</td>
                                            <td class="num">@(vt.PulseRate?.ToString() ?? "--")</td>
                                            <td class="num">@(vt.SpO2.HasValue ? $"{vt.SpO2:0.#}%" : "--")</td>
                                            <td class="num text-nowrap">@(vt.Temperature.HasValue ? $"{vt.Temperature:0.#} °F" : "--")</td>
                                            <td class="num text-nowrap">@(vt.Height?.ToString("0.#") ?? "--") cm · @(vt.Weight?.ToString("0.#") ?? "--") kg</td>
                                            <td>@if (vt.BMI.HasValue) { <span class="num">@vt.BMI.Value.ToString("0.0")</span> <span class="pill @(vt.BMICategory == "Normal" ? "ok" : "warn") ms-1">@vt.BMICategory</span> } else { <span>--</span> }</td>
                                            <td class="num text-nowrap">@(vt.BloodGlucose.HasValue ? $"{vt.BloodGlucose:0.#} mg/dL" : "--")@(string.IsNullOrEmpty(vt.GlucoseType) ? "" : $" ({vt.GlucoseType})")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="empty"><i class="bi bi-activity"></i>No vitals recorded yet.</div>
                    }
                </div>
            </section>

            <!-- ═══ Membership ═══ -->
            <section class="pp-sec" id="sec-membership">
                <div class="sec-head"><div><h2>Membership</h2><p>Your card, the family it covers and your points.</p></div></div>
                @if (card == null)
                {
                    <div class="box"><div class="empty"><i class="bi bi-credit-card"></i>You have no membership card. Ask the hospital reception about membership benefits.</div></div>
                }
                else
                {
                    <div class="grid g2">
                        <div>
                            <div class="mcard @(card.EffectiveStatus == "Active" ? "" : "off")">
                                <div class="d-flex justify-content-between align-items-start position-relative" style="z-index:1">
                                    <div><div class="k">@(card.PlanType ?? "Plan")</div><div class="fw-bold fs-5">@card.PlanName</div></div>
                                    <span class="pill @CardTone(card.EffectiveStatus)">@card.EffectiveStatus</span>
                                </div>
                                <div class="no position-relative" style="z-index:1">@card.CardNo</div>
                                <div class="d-flex justify-content-between position-relative" style="z-index:1">
                                    <div><div class="k">Valid</div><div class="v">@card.ValidFrom.ToString("dd MMM yy") – @card.ValidTo.ToString("dd MMM yy")</div></div>
                                    <div class="text-end"><div class="k">Points</div><div class="v fs-5">@card.PointsBalance.ToString("0.##")</div></div>
                                </div>
                            </div>
                        </div>
                        <div class="box">
                            <div class="kv"><span class="k">Card holder</span><span class="v">@(card.IsPrimary ? "You" : $"{card.PrimaryName} ({card.PrimaryCode})")</span></div>
                            @if (!card.IsPrimary) { <div class="kv"><span class="k">You are covered as</span><span class="v">@card.MemberRelation</span></div> }
                            <div class="kv"><span class="k">Points value</span><span class="v">@Money(card.PointsBalance * card.PointValue)</span></div>
                            <div class="kv"><span class="k">Issued at</span><span class="v">@(card.IssueBranchName ?? "--") · @card.CreatedDate.ToString("dd MMM yyyy")</span></div>
                        </div>
                    </div>
                    <div class="grid g2 mt-3">
                        <div class="box">
                            <h3><i class="bi bi-people text-primary"></i>Members on this card <span class="pill muted ms-1">@cardMembers.Count@(card.MaxMembers > 0 ? $" of {card.MaxMembers}" : "")</span></h3>
                            @foreach (var m in cardMembers)
                            {
                                <div class="person">
                                    <div class="av">@Initials(m.FullName)</div>
                                    <div class="flex-grow-1"><div class="fw-semibold">@m.FullName @if (m.PatientId == p.PatientId) { <span class="pill info ms-1">You</span> }</div><div class="small muted mono">@m.PatientCode</div></div>
                                    <span class="pill @(m.IsPrimary ? "info" : "muted")">@(m.IsPrimary ? "Primary" : m.Relation)</span>
                                </div>
                            }
                        </div>
                        <div class="box">
                            <h3><i class="bi bi-stars text-warning"></i>Points history</h3>
                            @if (Model.PointsLedger.Any())
                            {
                                foreach (var lp in Model.PointsLedger.Take(25))
                                {
                                    <div class="person">
                                        <div class="av" style="@(lp.Points > 0 ? "background:var(--ok-soft);color:var(--ok)" : lp.Points < 0 ? "background:var(--bad-soft);color:var(--bad)" : "background:var(--bg);color:var(--muted)")"><i class="bi @(lp.Points > 0 ? "bi-plus-lg" : lp.Points < 0 ? "bi-dash-lg" : "bi-tag")"></i></div>
                                        <div class="flex-grow-1" style="min-width:0">
                                            <div class="fw-semibold">@TxnLabel(lp.TxnType)@(string.IsNullOrWhiteSpace(lp.PatientName) ? "" : $" · {lp.PatientName}")</div>
                                            <div class="small muted">@lp.CreatedDate.ToString("dd MMM yyyy")@(string.IsNullOrEmpty(lp.ReceiptNo) ? "" : $" · {lp.ReceiptNo}")</div>
                                        </div>
                                        <div class="text-end"><div class="fw-bold num @(lp.Points > 0 ? "text-success" : lp.Points < 0 ? "text-danger" : "")">@(lp.Points > 0 ? "+" : "")@lp.Points.ToString("0.##")</div><div class="small muted num">Bal @lp.BalanceAfter.ToString("0.##")</div></div>
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="empty py-3"><i class="bi bi-stars"></i>No points transactions yet.</div>
                            }
                        </div>
                    </div>
                }
            </section>

            <!-- ═══ Profile ═══ -->
            <section class="pp-sec" id="sec-profile">
                <div class="sec-head"><div><h2>My Profile</h2><p>Registered @p.CreatedDate.ToString("dd MMM yyyy")@(Model.RegisteredBranchName == null ? "" : $" at {Model.RegisteredBranchName}"). To correct anything, please contact the hospital reception.</p></div></div>
                <div class="box">
                    <h3><i class="bi bi-person text-primary"></i>Personal details</h3>
                    <div class="grid g3" style="gap:10px">
                        <div class="field"><div class="k">Full name</div><div class="v">@fullName</div></div>
                        <div class="field"><div class="k">Patient ID</div><div class="v mono">@p.PatientCode</div></div>
                        <div class="field"><div class="k">Date of birth</div><div class="v">@(p.DateOfBirth?.ToString("dd MMM yyyy") ?? "--")</div></div>
                        <div class="field"><div class="k">Gender</div><div class="v">@(string.IsNullOrEmpty(p.Gender) ? "--" : p.Gender)</div></div>
                        <div class="field"><div class="k">Age</div><div class="v">@(string.IsNullOrEmpty(age) ? "--" : age)</div></div>
                        <div class="field"><div class="k">Blood group</div><div class="v">@(string.IsNullOrEmpty(p.BloodGroup) ? "--" : p.BloodGroup)</div></div>
                        <div class="field"><div class="k">Marital status</div><div class="v">@(Model.MaritalStatusName ?? "--")</div></div>
                        <div class="field"><div class="k">Religion</div><div class="v">@(Model.ReligionName ?? "--")</div></div>
                        <div class="field"><div class="k">Occupation</div><div class="v">@(Model.OccupationName ?? "--")</div></div>
                        <div class="field"><div class="k">Language</div><div class="v">@(Model.LanguageName ?? "--")</div></div>
                        <div class="field"><div class="k">Guardian name</div><div class="v">@(string.IsNullOrEmpty(p.GuardianName) ? "--" : p.GuardianName)</div></div>
                        <div class="field"><div class="k">Identification</div><div class="v">@(Model.IdentificationTypeName ?? "Not provided") @(string.IsNullOrEmpty(p.IdentificationNumber) ? "" : $"({p.IdentificationNumber})")</div></div>
                        @if (Model.ReferralDoctorName != null) { <div class="field"><div class="k">Referred by</div><div class="v">@Model.ReferralDoctorName</div></div> }
                    </div>
                </div>

                <div class="grid g2 mt-3">
                    <div class="box">
                        <h3><i class="bi bi-telephone text-primary"></i>Contact &amp; address</h3>
                        <div class="kv"><span class="k">Mobile</span><span class="v">@(string.IsNullOrWhiteSpace(p.PhoneNumber) ? "--" : p.PhoneNumber)</span></div>
                        @if (!string.IsNullOrEmpty(p.SecondaryPhoneNumber)) { <div class="kv"><span class="k">Secondary mobile</span><span class="v">@p.SecondaryPhoneNumber</span></div> }
                        <div class="kv"><span class="k">E-mail</span><span class="v text-break">@(string.IsNullOrWhiteSpace(p.EmailId) ? "--" : p.EmailId)</span></div>
                        <div class="kv"><span class="k">Address</span><span class="v">@(string.IsNullOrWhiteSpace(p.Address) ? "--" : p.Address)</span></div>
                        @if (!string.IsNullOrWhiteSpace(p.HomeCollectionAddress)) { <div class="kv"><span class="k">Home collection</span><span class="v">@p.HomeCollectionAddress</span></div> }
                        <div class="kv"><span class="k">Area / City</span><span class="v">@(Model.AreaName ?? "--") / @(Model.CityName ?? "--")</span></div>
                        <div class="kv"><span class="k">District / State</span><span class="v">@(Model.DistrictName ?? "--") / @(Model.StateName ?? "--")</span></div>
                        <div class="kv"><span class="k">Country</span><span class="v">@(Model.CountryName ?? "--")</span></div>
                    </div>
                    <div>
                        <div class="box">
                            <h3><i class="bi bi-shield-exclamation text-warning"></i>Medical notes</h3>
                            <div class="note t-bad mb-2"><div class="fw-semibold mb-1"><i class="bi bi-exclamation-triangle me-1"></i>Known allergies</div>@(string.IsNullOrEmpty(p.KnownAllergies) ? "No known allergies recorded." : p.KnownAllergies)</div>
                            <div class="note" style="background:var(--bg)"><div class="fw-semibold mb-1"><i class="bi bi-journal-medical me-1"></i>Remarks / medical history</div>@(string.IsNullOrEmpty(p.Remarks) ? "No remarks or history recorded." : p.Remarks)</div>
                        </div>
                        <div class="box">
                            <h3><i class="bi bi-people text-primary"></i>Family on your mobile number</h3>
                            @if (!isHead && headOfFamily != null)
                            {
                                <div class="small muted mb-2">You are registered as <b>@(Model.RelationName ?? "a family member")</b> of <b>@headOfFamily.FullName</b>.</div>
                            }
                            @if (family.Any())
                            {
                                foreach (var f in family)
                                {
                                    var fAge = EMR.Web.Utils.AgeCalculator.FormatAgePattern(f.DateOfBirth);
                                    <div class="person">
                                        <div class="av">@Initials(f.FullName)</div>
                                        <div class="flex-grow-1" style="min-width:0"><div class="fw-semibold">@f.FullName</div>
                                            <div class="small muted"><span class="mono">@f.PatientCode</span>@(string.IsNullOrEmpty(f.Gender) ? "" : $" · {f.Gender}")@(string.IsNullOrEmpty(fAge) ? "" : $" · {fAge}")</div></div>
                                        <span class="pill @(f.IsSelf ? "info" : "muted")">@(f.IsSelf ? "Head (Self)" : (f.RelationName ?? "—"))</span>
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="empty py-3"><i class="bi bi-person"></i>No other patient is registered on your mobile number.</div>
                            }
                        </div>
                    </div>
                </div>
            </section>
        </main>
    </div>

    <footer class="pp-foot">&copy; @DateTime.Now.Year @brand · Powered by eCare360Plus+</footer>

    <script src="~/lib/chartjs/chart.umd.min.js"></script>
    <script>
        (function () {
            const esc = v => String(v ?? '').replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]);
            const loginUrl = '@Url.Action("Login")';
            const loaded = {};

            // ── sections (deep link with #visits, #labs ...) ──
            function show(sec, push) {
                if (!document.getElementById('sec-' + sec)) sec = 'overview';
                document.querySelectorAll('.pp-sec').forEach(s => s.classList.toggle('active', s.id === 'sec-' + sec));
                document.querySelectorAll('.pp-nav button').forEach(b => b.classList.toggle('active', b.dataset.sec === sec));
                document.querySelector('.pp-nav button.active')?.scrollIntoView({ block: 'nearest', inline: 'center' });
                if (push) history.replaceState(null, '', '#' + sec);
                window.scrollTo({ top: 0 });
                if (sec === 'vitals') loadVitals();
                if (sec === 'visits') loadVisits();
                if (sec === 'rx') loadRx();
            }
            document.querySelectorAll('[data-sec]').forEach(b => b.addEventListener('click', () => show(b.dataset.sec, true)));
            document.querySelectorAll('[data-go]').forEach(b => b.addEventListener('click', () => show(b.dataset.go, true)));
            show(location.hash.slice(1) || 'overview', false);

            // ── copy Patient ID ──
            document.getElementById('copyId')?.addEventListener('click', e => {
                const id = '@p.PatientCode';
                navigator.clipboard?.writeText(id).then(() => {
                    const ic = e.currentTarget.querySelector('.bi-copy');
                    if (ic) { ic.className = 'bi bi-check2'; setTimeout(() => ic.className = 'bi bi-copy', 1500); }
                }).catch(() => {});
            });

            // ── lab filter ──
            document.querySelectorAll('#labFilter button').forEach(b => b.addEventListener('click', () => {
                document.querySelectorAll('#labFilter button').forEach(x => x.classList.toggle('on', x === b));
                let shown = 0;
                document.querySelectorAll('#labList .item').forEach(it => {
                    const ok = b.dataset.f === 'all' || (b.dataset.f === 'ready') === (it.dataset.ready === '1');
                    it.style.display = ok ? '' : 'none'; if (ok) shown++;
                });
                const empty = document.getElementById('labEmpty'); if (empty) empty.style.display = shown ? 'none' : '';
            }));

            async function getJson(url) {
                const res = await fetch(url);
                if (res.status === 401) { location.href = loginUrl; throw new Error('signed out'); }
                return res.json();
            }
            const palette = { brand: '#6d4bb0', pink: '#a8407a', ok: '#12805c', info: '#1d63c9', warn: '#d68a00', bad: '#c2273a' };
            const baseOpts = { responsive: true, maintainAspectRatio: false, plugins: { legend: { position: 'bottom', labels: { usePointStyle: true, boxWidth: 8 } } },
                               scales: { x: { grid: { display: false } }, y: { grid: { color: '#eef0f6' } } } };

            // ── vitals: main chart with the normal range shaded, sparklines on the cards ──
            let vitals = null, vChart = null, vMetric = 'bp';
            const METRICS = {
                bp:      { sets: [['Systolic', 'bpSystolic', '#e04563'], ['Diastolic', 'bpDiastolic', '#f0a020']], unit: 'mmHg', band: [60, 120] },
                pulse:   { sets: [['Pulse', 'pulseRate', '#12805c']], unit: 'bpm', band: [60, 100] },
                spo2:    { sets: [['SpO2', 'spO2', '#1d63c9']], unit: '%', band: [95, 100] },
                temp:    { sets: [['Temperature', 'temperature', '#d68a00']], unit: '°F', band: [97, 99.5] },
                weight:  { sets: [['Weight', 'weight', '#6d4bb0']], unit: 'kg', band: null },
                glucose: { sets: [['Glucose', 'bloodGlucose', '#a8407a']], unit: 'mg/dL', band: [70, 139] }
            };
            // shades the normal range behind the lines
            const bandPlugin = { id: 'band', beforeDatasetsDraw(c, _, o) {
                if (!o.range) return;
                const { ctx, chartArea: a, scales: { y } } = c;
                const top = y.getPixelForValue(o.range[1]), bottom = y.getPixelForValue(o.range[0]);
                ctx.save(); ctx.fillStyle = 'rgba(18,128,92,.08)'; ctx.fillRect(a.left, Math.max(top, a.top), a.right - a.left, Math.min(bottom, a.bottom) - Math.max(top, a.top));
                ctx.fillStyle = 'rgba(18,128,92,.75)'; ctx.font = '600 11px Inter, sans-serif'; ctx.fillText('Normal range', a.left + 8, Math.max(top, a.top) + 14); ctx.restore();
            } };
            async function loadVitals() {
                if (loaded.vitals) return; loaded.vitals = true;
                try { vitals = await getJson('@Url.Content("~/PatientPortal/Chart/vitals")'); } catch { vitals = []; }
                if (!vitals || !vitals.length) { document.getElementById('vitalsEmpty').style.display = ''; document.getElementById('vitalsChart').style.display = 'none'; return; }
                drawSparks(); drawVitals();
            }
            function grad(ctx, area, color) {
                const g = ctx.createLinearGradient(0, area.top, 0, area.bottom); g.addColorStop(0, color + '55'); g.addColorStop(1, color + '05'); return g;
            }
            function drawVitals() {
                const m = METRICS[vMetric];
                const single = vitals.length === 1;
                const datasets = m.sets.map(([label, key, color]) => ({
                    label: `${label} (${m.unit})`, data: vitals.map(d => d[key]), borderColor: color, borderWidth: 3, tension: .4, spanGaps: true,
                    pointRadius: single ? 7 : 4, pointHoverRadius: 8, pointBackgroundColor: '#fff', pointBorderColor: color, pointBorderWidth: 3,
                    fill: true, backgroundColor: c => c.chart.chartArea ? grad(c.chart.ctx, c.chart.chartArea, color) : color + '22'
                }));
                const vals = datasets.flatMap(d => d.data).filter(v => v != null);
                const lo = Math.min(...vals, ...(m.band || [])), hi = Math.max(...vals, ...(m.band || []));
                const pad = Math.max(2, (hi - lo) * .15);
                vChart?.destroy();
                vChart = new Chart(document.getElementById('vitalsChart'), { type: 'line', plugins: [bandPlugin],
                    data: { labels: vitals.map(d => d.recordedOn.split(',')[0]), datasets },
                    options: { ...baseOpts, layout: { padding: { left: 6, right: single ? 40 : 10, top: 6 } }, interaction: { mode: 'index', intersect: false },
                        plugins: { band: { range: m.band }, legend: { position: 'bottom', labels: { usePointStyle: true, boxWidth: 8, padding: 18 } },
                                   tooltip: { backgroundColor: '#1d1b2f', padding: 10, cornerRadius: 10, callbacks: { label: c => ` ${c.dataset.label}: ${c.formattedValue}` } } },
                        scales: { x: { grid: { display: false }, offset: single }, y: { min: Math.floor(lo - pad), max: Math.ceil(hi + pad), grid: { color: '#eef0f6' }, border: { display: false } } } } });
                document.querySelectorAll('.vcard').forEach(c => c.classList.toggle('on', c.dataset.metric === vMetric));
            }
            function drawSparks() {
                document.querySelectorAll('canvas.spark').forEach(cv => {
                    const data = vitals.map(d => d[cv.dataset.key]).filter(v => v != null);
                    if (data.length < 2) { cv.style.display = 'none'; return; }
                    const color = getComputedStyle(cv.closest('.vcard').querySelector('.ic')).color;
                    new Chart(cv, { type: 'line', data: { labels: data.map((_, i) => i), datasets: [{ data, borderColor: color, borderWidth: 2, tension: .4, pointRadius: 0, fill: false }] },
                        options: { responsive: false, animation: false, plugins: { legend: { display: false }, tooltip: { enabled: false } }, scales: { x: { display: false }, y: { display: false } } } });
                });
            }
            function pick(metric) {
                vMetric = metric;
                document.querySelectorAll('#vitalMetric button').forEach(x => x.classList.toggle('on', x.dataset.v === metric));
                if (vitals && vitals.length) drawVitals();
            }
            document.querySelectorAll('#vitalMetric button').forEach(b => b.addEventListener('click', () => pick(b.dataset.v)));
            document.querySelectorAll('.vcard').forEach(c => c.addEventListener('click', () => { pick(c.dataset.metric); document.getElementById('vitalsChart').scrollIntoView({ behavior: 'smooth', block: 'center' }); }));

            // ── visit chart ──
            let visits = null, sChart = null, sMetric = 'amount';
            async function loadVisits() {
                if (loaded.visits) return; loaded.visits = true;
                try { visits = await getJson('@Url.Content("~/PatientPortal/Chart/visits")'); } catch { visits = null; }
                if (!visits || (!visits.billData?.length && !visits.consultingData?.length)) { document.getElementById('visitsEmpty').style.display = ''; document.getElementById('visitsChart').style.display = 'none'; return; }
                drawVisits();
            }
            function drawVisits() {
                const amt = sMetric === 'amount';
                const labels = amt ? visits.billData.map(d => d.visitDate) : visits.consultingData.map(d => d.doctorName);
                const data = amt ? visits.billData.map(d => d.totalAmount) : visits.consultingData.map(d => d.consultingCount);
                sChart?.destroy();
                sChart = new Chart(document.getElementById('visitsChart'), { type: 'bar',
                    data: { labels, datasets: [{ label: amt ? 'Bill amount (₹)' : 'Visits', data, backgroundColor: amt ? palette.brand + 'cc' : palette.ok + 'cc', borderRadius: 8, maxBarThickness: 46 }] },
                    options: { ...baseOpts, plugins: { legend: { display: false } }, scales: { x: { grid: { display: false } }, y: { beginAtZero: true, grid: { color: '#eef0f6' }, ticks: { stepSize: amt ? undefined : 1, callback: v => amt ? '₹' + v : v } } } } });
            }
            document.querySelectorAll('#visitMetric button').forEach(b => b.addEventListener('click', () => {
                document.querySelectorAll('#visitMetric button').forEach(x => x.classList.toggle('on', x === b));
                sMetric = b.dataset.v; if (visits) drawVisits();
            }));

            // ── LAB bills: live workflow (the stages staff see in Audit History) ──
            const NAMES = { booked: 'Booked', payment: 'Payment', collection: 'Sample collection', transfer: 'Sent to the lab', entry: 'Testing',
                            validation: 'Checked', approval: 'Doctor approval', delivery: 'Report', cancelled: 'Cancelled' };
            const NOW = { booked: 'Booked', payment: 'Payment pending', collection: 'Sample collection', transfer: 'Sample on the way to the lab',
                          entry: 'Testing in progress', validation: 'Results being checked', approval: 'Awaiting doctor approval', delivery: 'Report ready' };
            const labIds = [...document.querySelectorAll('.lab-item')].map(e => +e.dataset.id);
            const finished = new Set();
            function closed(s, wf) { return s.state === 'done' || (s.state === 'skipped' && !wf.cancelled); }
            function applyWorkflow(wf) {
                const el = document.querySelector(`.lab-item[data-id="${wf.id}"]`);
                if (!el) return;
                const steps = wf.steps;
                const idx = wf.cancelled ? steps.findIndex(s => s.key === 'cancelled') : steps.findIndex(s => !closed(s, wf));
                const cur = idx < 0 ? steps[steps.length - 1] : steps[idx];
                const pay = steps.find(s => s.key === 'payment');
                const apr = steps.find(s => s.key === 'approval');
                const paid = !pay || pay.state === 'done';
                const approvedAny = apr && (apr.state === 'done' || (apr.state === 'current' && !/^Not started/.test(apr.detail)));
                const ready = !wf.cancelled && paid && approvedAny;

                // stage pill
                let tone = 'info', icon = 'bi-hourglass-split', text = idx < 0 ? 'Completed' : (NOW[cur.key] || cur.label);
                if (wf.cancelled) { tone = 'bad'; icon = 'bi-x-circle-fill'; text = 'Bill cancelled'; }
                else if (cur.state === 'issue') { tone = 'bad'; icon = 'bi-exclamation-circle-fill'; text = cur.key === 'collection' ? 'New sample needed' : 'Being re-checked'; }
                else if (ready) { tone = 'ok'; icon = 'bi-check-circle-fill'; text = apr.state === 'done' ? 'Report ready' : 'Partly ready'; }
                else if (approvedAny && !paid) { tone = 'warn'; icon = 'bi-wallet2'; text = 'Pay to view report'; }
                const pill = el.querySelector('[data-role=stage]');
                pill.className = 'pill ' + tone; pill.innerHTML = `<i class="bi ${icon}"></i><span>${esc(text)}</span>`;
                const tl = document.querySelector(`[data-stage-of="${wf.id}"]`);
                if (tl) { tl.className = 'pill ' + tone + ' align-self-start'; tl.textContent = text; }

                // payment pill
                if (pay) {
                    const pp = el.querySelector('[data-role=pay]');
                    pp.className = 'pill ' + (pay.state === 'done' ? 'ok' : pay.detail.startsWith('Paid') ? 'warn' : 'bad');
                    pp.textContent = pay.state === 'done' ? 'Paid' : pay.detail.startsWith('Paid') ? 'Part paid' : 'Unpaid';
                }

                // report button
                const rb = el.querySelector('[data-role=report]');
                rb.setAttribute('aria-disabled', ready ? 'false' : 'true');
                rb.title = ready ? 'Download your report' : approvedAny ? 'Available once the bill is paid' : 'Not ready yet';
                el.dataset.ready = ready ? '1' : '0';

                // the track and the stage list (the delivery stage in the patient's words)
                const say = s => s.key !== 'delivery' ? s.detail
                    : ready ? 'Ready to download' : s.state === 'done' ? 'Report delivered - you can download it any time' : s.detail;
                const box = el.querySelector('[data-role=wf]');
                const open = box.classList.contains('open');
                box.innerHTML = `<div class="wf-track">${steps.map(s => `<span class="${esc(s.state)}" title="${esc((NAMES[s.key] || s.label) + ': ' + say(s))}"></span>`).join('')}</div>
                    <div class="wf-now"><b>${idx < 0 ? 'All done' : 'Now: ' + esc(NAMES[cur.key] || cur.label)}</b><span class="muted">${esc(say(cur))}</span>
                        ${cur.at ? `<span class="when">· ${esc(cur.at)}</span>` : ''}<button type="button" class="wf-toggle ms-auto">${open ? 'Hide steps' : 'All steps'}</button></div>
                    <div class="wf-steps">${steps.map(s => `<div class="st ${esc(s.state)}"><div class="l">${esc(NAMES[s.key] || s.label)}</div><div class="d">${esc(say(s))}${s.at ? ' · ' + esc(s.at) : ''}</div></div>`).join('')}</div>`;
                box.querySelector('.wf-toggle').onclick = () => { box.classList.toggle('open'); box.querySelector('.wf-toggle').textContent = box.classList.contains('open') ? 'Hide steps' : 'All steps'; };
                if (idx < 0 || wf.cancelled) finished.add(wf.id);
            }
            async function refreshLabs(all) {
                const ids = labIds.filter(id => all || !finished.has(id));
                if (!ids.length) return;
                try {
                    const list = await getJson('@Url.Action("LabWorkflow")?ids=' + ids.join(','));
                    list.forEach(applyWorkflow);
                    const readyCount = document.querySelectorAll('.lab-item[data-ready="1"]').length;
                    const rf = document.querySelector('#labFilter [data-f=ready]'); if (rf) rf.textContent = `Ready (${readyCount})`;
                    document.getElementById('liveNote').hidden = false;
                    document.getElementById('liveAt').textContent = new Date().toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit', second: '2-digit' });
                } catch { }
            }
            if (labIds.length) {
                refreshLabs(true);
                setInterval(() => { if (!document.hidden) refreshLabs(false); }, 30000);
                document.addEventListener('visibilitychange', () => { if (!document.hidden) refreshLabs(true); });
            }

            // ── prescriptions ──
            async function loadRx() {
                if (loaded.rx) return; loaded.rx = true;
                const box = document.getElementById('rxList');
                try {
                    const list = (await getJson('@Url.Content("~/PatientPortal/Data/prescriptions")')).data || [];
                    if (!list.length) { box.innerHTML = '<div class="empty"><i class="bi bi-capsule"></i>No prescriptions yet.<div class="small mt-1">A prescription appears here once your doctor saves it after your consultation.</div></div>'; return; }
                    box.classList.remove('box');
                    box.innerHTML = '<div class="d-grid gap-3">' + list.map(p => {
                        // medicines: "id|Name|Qty|Frequency|When" per item
                        const meds = (p.medicines || '').split(',').map(x => x.split('|')).filter(m => m.length >= 2 && m[1].trim())
                            .map(m => ({ name: m[1].trim(), qty: (m[2] || '').trim(), freq: (m[3] || '').trim(), when: (m[4] || '').trim() }));
                        const d = new Date(p.consultationDate);
                        const url = '@Url.Action("Prescription")' + `?opdServiceId=${encodeURIComponent(p.opdServiceId)}&doctorId=${encodeURIComponent(p.doctorId)}`;
                        const block = (k, v, icon) => v ? `<div class="field"><div class="k"><i class="bi ${icon} me-1"></i>${k}</div><div class="v" style="white-space:pre-line">${esc(v)}</div></div>` : '';
                        return `<div class="rx box">
                            <div class="item" style="padding:0;border:0">
                                <div class="datebox"><div class="d">${d.getDate()}</div><div class="m">${esc(d.toLocaleString('en-GB', { month: 'short' }))}</div></div>
                                <div class="main"><div class="ttl">${esc(p.doctorName || 'Doctor')}</div><div class="sub">${esc(d.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }))}</div></div>
                                <a class="btn-soft primary" href="${url}" target="_blank"><i class="bi bi-printer"></i>Prescription</a>
                            </div>
                            ${meds.length ? `<div class="mt-3"><div class="small muted fw-semibold mb-2"><i class="bi bi-capsule me-1"></i>Medicines</div>
                                <div class="d-grid gap-2">${meds.map(m => `<div class="d-flex align-items-center gap-3 p-2 px-3" style="background:var(--brand-soft);border-radius:12px">
                                    <i class="bi bi-capsule-pill" style="color:var(--brand)"></i><div class="flex-grow-1"><div class="fw-semibold">${esc(m.name)}</div>
                                    <div class="small muted">${[m.qty && m.qty + ' dose', m.freq, m.when].filter(Boolean).map(esc).join(' · ')}</div></div></div>`).join('')}</div></div>` : ''}
                            <div class="grid g2 mt-3" style="gap:10px">${block('Complaint', p.complaint, 'bi-chat-left-text')}${block('Diagnosis', p.diagnosis, 'bi-clipboard2-pulse')}${block('Advice', p.advice, 'bi-lightbulb')}</div>
                        </div>`;
                    }).join('') + '</div>';
                } catch {
                    box.innerHTML = '<div class="empty"><i class="bi bi-wifi-off"></i>Prescriptions could not be loaded. Please try again.</div>';
                }
            }
        })();
    </script>
</body>
</html>
