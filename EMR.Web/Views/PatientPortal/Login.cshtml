@model EMR.Web.Models.ViewModels.PatientLoginViewModel
@{
    ViewData["Title"] = "Patient Portal Login";
    Layout = null; 
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - eCare360+</title>
    <link rel="stylesheet" href="~/css/fonts.css" />
    <link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/views/PatientPortal/Login.css" asp-append-version="true" />
</head>
<body>
    
    <div class="login-wrapper">
        <div class="login-card">
            <div class="brand-header">
                <i class="bi bi-shield-plus brand-icon"></i>
                <h2 class="brand-title">eCare360<span style="color:var(--secondary)">+</span></h2>
                <p class="brand-subtitle">Secure Patient Portal Access</p>
            </div>

            <form asp-action="Login" method="post" autocomplete="off">
                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-glass mb-4 px-3 py-2">
                        <div asp-validation-summary="ModelOnly" class="mb-0 small fw-medium"></div>
                    </div>
                }

                <div class="form-floating mb-3">
                    <input asp-for="Username" class="form-control" id="floatingInput" placeholder="Patient ID" autocomplete="off" autocorrect="off" spellcheck="false" autocapitalize="characters" />
                    <label asp-for="Username"><i class="bi bi-person-badge me-1"></i>Patient ID</label>
                    <span asp-validation-for="Username" class="text-danger small ms-1 mt-1 d-block"></span>
                </div>

                <div class="form-floating mb-4">
                    <input asp-for="Password" type="text" class="form-control pw-masked" id="floatingPassword" placeholder="Password" autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck="false" data-lpignore="true" />
                    <label asp-for="Password"><i class="bi bi-lock me-1"></i>Password</label>
                    <span asp-validation-for="Password" class="text-danger small ms-1 mt-1 d-block"></span>
                </div>

                <button type="submit" class="btn btn-login w-100 mt-2">
                    <i class="bi bi-box-arrow-in-right me-2"></i> Log In
                </button>
                <p class="text-center text-muted small mt-3 mb-0">
                    No password yet, or forgot it? Ask the hospital reception to send your portal login.
                </p>
            </form>
        </div>
        
        <div class="text-center mt-4">
            <p class="small text-white-50 fw-medium">
                &copy; @DateTime.Now.Year eCare360+ Patient Portal. All rights reserved.
            </p>
        </div>
    </div>

    <!-- Scripts -->
    <script>
        // a text box drawn with dots: the browser offers no saved passwords; without dot support it is a normal password box
        (function () { const i = document.getElementById('floatingPassword'); if (i && !(window.CSS && CSS.supports('-webkit-text-security', 'disc'))) { i.classList.remove('pw-masked'); i.type = 'password'; } })();
    </script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>
