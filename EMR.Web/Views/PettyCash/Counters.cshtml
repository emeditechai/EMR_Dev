@model EMR.Web.Models.ViewModels.AccCountersPageViewModel
@{
    ViewData["Title"] = "Petty Cash Counters";
    ViewData["AccIcon"] = "bi-safe";
    ViewData["AccSubtitle"] = "Each counter holds a fixed float. Expenses bring it down; replenishment brings it back to the float.";
    const string Page = "UTILITY.ACCOUNTS.COUNTERS";
    var active = Model.Counters.Where(c => c.IsActive).ToList();
}

<div class="container-fluid px-4 py-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div><partial name="_AccHeader" /></div>
        <button asp-permission="@(Page + ":EDIT")" type="button" class="btn btn-primary shadow-sm" data-acc-counter="new"><i class="bi bi-plus-lg me-1"></i>Add Counter</button>
    </div>
    <partial name="_AccAlerts" />

    <div class="row g-3 mb-3">
        <div class="col-md-3"><div class="card border-0 shadow-sm"><div class="card-body py-3"><div class="text-muted small text-uppercase fw-semibold">Active counters</div><div class="fs-4 fw-bold">@active.Count</div></div></div></div>
        <div class="col-md-3"><div class="card border-0 shadow-sm"><div class="card-body py-3"><div class="text-muted small text-uppercase fw-semibold">Total float</div><div class="fs-4 fw-bold">₹@active.Sum(c => c.FloatAmount).ToString("N2")</div></div></div></div>
        <div class="col-md-3"><div class="card border-0 shadow-sm"><div class="card-body py-3"><div class="text-muted small text-uppercase fw-semibold">Cash in counters</div><div class="fs-4 fw-bold text-success">₹@active.Sum(c => c.Balance).ToString("N2")</div></div></div></div>
        <div class="col-md-3"><div class="card border-0 shadow-sm"><div class="card-body py-3"><div class="text-muted small text-uppercase fw-semibold">To replenish</div><div class="fs-4 fw-bold text-warning-emphasis">₹@active.Sum(c => c.ToReplenish).ToString("N2")</div></div></div></div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light border-bottom">
                    <tr>
                        <th class="ps-4">Counter</th><th>Branch</th><th>Custodian</th><th class="text-end">Float</th><th class="text-end">Cash in Counter</th>
                        <th class="text-end">Waiting Approval</th><th class="text-end">To Replenish</th><th>Last Closed</th><th class="text-center">Status</th><th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Counters.Count == 0)
                    {
                        <tr><td colspan="10" class="text-center py-5 text-muted"><i class="bi bi-safe display-6 d-block mb-2 text-secondary"></i>No petty cash counter yet. Add one, then issue its float.</td></tr>
                    }
                    @foreach (var c in Model.Counters)
                    {
                        <tr>
                            <td class="ps-4">
                                <div class="fw-semibold">@c.CounterName</div>
                                <div class="text-muted small">@c.LedgerName</div>
                            </td>
                            <td>@c.BranchName</td>
                            <td>@(c.CustodianName ?? "-")</td>
                            <td class="text-end font-monospace">₹@c.FloatAmount.ToString("N2")</td>
                            <td class="text-end font-monospace fw-semibold @(c.IsLow ? "text-danger" : "")">
                                ₹@c.Balance.ToString("N2")
                                @if (c.IsLow) { <i class="bi bi-exclamation-triangle-fill ms-1" title="At or below the low-balance alert"></i> }
                            </td>
                            <td class="text-end font-monospace">@(c.PendingAmount > 0 ? "₹" + c.PendingAmount.ToString("N2") : "-")</td>
                            <td class="text-end font-monospace">@(c.ToReplenish > 0 ? "₹" + c.ToReplenish.ToString("N2") : "-")</td>
                            <td class="small">@(c.LastClosingDate?.ToString("dd-MMM-yyyy") ?? "-")</td>
                            <td class="text-center">
                                @if (c.IsActive) { <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3">Active</span> }
                                else { <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-3">Inactive</span> }
                            </td>
                            <td class="text-end pe-4">
                                <div class="btn-group btn-group-sm shadow-sm">
                                    <button asp-permission="@(Page + ":FLOAT")" type="button" class="btn btn-outline-success" title="Issue / replenish / return float" data-acc-float
                                            data-id="@c.CounterId" data-name="@c.CounterName" data-float="@c.FloatAmount.ToString("0.00")" data-balance="@c.Balance.ToString("0.00")" data-funding="@c.FundingLedgerId"><i class="bi bi-cash-stack"></i></button>
                                    <button type="button" class="btn btn-outline-info" title="Float history" data-acc-history data-id="@c.CounterId" data-name="@c.CounterName"><i class="bi bi-clock-history"></i></button>
                                    <a asp-controller="AccReports" asp-action="LedgerStatement" asp-route-book="PettyCashBook" asp-route-ledgerId="@c.LedgerId" asp-permission="UTILITY.ACCOUNTS.REPORTS" class="btn btn-outline-secondary" title="Petty cash book"><i class="bi bi-journal-text"></i></a>
                                    <button asp-permission="@(Page + ":EDIT")" type="button" class="btn btn-outline-primary" title="Edit" data-acc-counter="edit" data-id="@c.CounterId" data-name="@c.CounterName" data-branch="@c.BranchId"
                                            data-custodian="@c.CustodianUserId" data-float="@c.FloatAmount.ToString("0.00")" data-funding="@c.FundingLedgerId" data-low="@c.LowBalanceAlert?.ToString("0.00")" data-active="@(c.IsActive ? "1" : "0")"><i class="bi bi-pencil"></i></button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Counter -->
<div class="modal fade" id="counterModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <form asp-action="SaveCounter" method="post" class="modal-content">
            @Html.AntiForgeryToken()
            <input type="hidden" name="CounterId" id="ctId" value="0" />
            <div class="modal-header"><h5 class="modal-title" id="ctTitle">Add Petty Cash Counter</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
            <div class="modal-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label fw-semibold required-field">Branch</label>
                        <select name="BranchId" id="ctBranch" class="form-select" required>
                            @if (Model.CanPickBranch) { <option value="">-- Select --</option> }
                            @foreach (var b in Model.Branches)
                            {
                                <option value="@b.Id">@b.Name</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold required-field">Counter Name</label>
                        <input name="CounterName" id="ctName" class="form-control" maxlength="60" required autocomplete="off" placeholder="e.g. Front Desk" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold required-field">Float Amount</label>
                        <div class="input-group"><span class="input-group-text">₹</span><input name="FloatAmount" id="ctFloat" type="number" step="0.01" min="1" class="form-control" required /></div>
                        <div class="form-text">The fixed amount the counter is topped up to.</div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Low-balance Alert</label>
                        <div class="input-group"><span class="input-group-text">₹</span><input name="LowBalanceAlert" id="ctLow" type="number" step="0.01" min="0" class="form-control" placeholder="Optional" /></div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Custodian</label>
                        <select name="CustodianUserId" id="ctCustodian" class="form-select">
                            <option value="">-- Not set --</option>
                            @foreach (var u in Model.Users)
                            {
                                <option value="@u.Id">@u.Name</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Funded From</label>
                        <select name="FundingLedgerId" id="ctFunding" class="form-select">
                            <option value="">-- Chosen at each top-up --</option>
                            @foreach (var l in Model.FundingLedgers)
                            {
                                <option value="@l.Id">@l.Name</option>
                            }
                        </select>
                    </div>
                    <div class="col-12">
                        <div class="form-check form-switch">
                            <input type="hidden" name="IsActive" value="false" />
                            <input class="form-check-input" type="checkbox" role="switch" name="IsActive" id="ctActive" value="true" checked>
                            <label class="form-check-label fw-semibold" for="ctActive">Active</label>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-primary"><i class="bi bi-save me-1"></i>Save Counter</button>
            </div>
        </form>
    </div>
</div>

<!-- Float -->
<div class="modal fade" id="floatModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <form asp-action="Float" method="post" class="modal-content">
            @Html.AntiForgeryToken()
            <input type="hidden" name="CounterId" id="flId" />
            <div class="modal-header"><h5 class="modal-title">Float - <span id="flName"></span></h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
            <div class="modal-body">
                <div class="d-flex justify-content-between border rounded p-2 mb-3 bg-light small">
                    <span>Float <strong id="flFloat"></strong></span><span>In counter <strong id="flBalance"></strong></span><span>Room to add <strong id="flRoom" class="text-success"></strong></span>
                </div>
                <div class="row g-3">
                    <div class="col-12">
                        <div class="btn-group w-100" role="group">
                            <input type="radio" class="btn-check" name="Kind" id="flIssue" value="ISSUE" checked><label class="btn btn-outline-success" for="flIssue">Issue float</label>
                            <input type="radio" class="btn-check" name="Kind" id="flRepl" value="REPLENISH"><label class="btn btn-outline-success" for="flRepl">Replenish</label>
                            <input type="radio" class="btn-check" name="Kind" id="flReturn" value="RETURN"><label class="btn btn-outline-warning" for="flReturn">Return cash</label>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold required-field">Date</label>
                        <input name="TxnDate" type="date" class="form-control" value="@DateTime.Today.ToString("yyyy-MM-dd")" max="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold required-field">Amount</label>
                        <div class="input-group"><span class="input-group-text">₹</span><input name="Amount" id="flAmount" type="number" step="0.01" min="0.01" class="form-control" required /></div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold required-field" id="flSourceLabel">Paid From</label>
                        <select name="SourceLedgerId" id="flSource" class="form-select" required>
                            <option value="">-- Select --</option>
                            @foreach (var l in Model.FundingLedgers)
                            {
                                <option value="@l.Id">@l.Name</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Reference No.</label>
                        <input name="ReferenceNo" class="form-control" maxlength="100" placeholder="Cheque / transfer no." />
                    </div>
                    <div class="col-12">
                        <label class="form-label fw-semibold">Remarks</label>
                        <input name="Remarks" class="form-control" maxlength="300" />
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-success"><i class="bi bi-check2-circle me-1"></i>Post</button>
            </div>
        </form>
    </div>
</div>

<!-- History -->
<div class="modal fade" id="historyModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header"><h5 class="modal-title">Float history - <span id="hsName"></span></h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
            <div class="modal-body p-0">
                <table class="table table-sm align-middle mb-0">
                    <thead class="bg-light"><tr><th class="ps-3">Date</th><th>Kind</th><th class="text-end">Amount</th><th>From / To</th><th>Voucher</th><th>By</th><th>Remarks</th></tr></thead>
                    <tbody id="hsBody"></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var $ = function (id) { return document.getElementById(id); };
            var inr = function (n) { return '₹' + Number(n).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }); };
            var counterModal = new bootstrap.Modal($('counterModal')), floatModal = new bootstrap.Modal($('floatModal')), historyModal = new bootstrap.Modal($('historyModal'));

            document.querySelectorAll('[data-acc-counter]').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    var d = btn.dataset, edit = d.accCounter === 'edit';
                    $('ctTitle').textContent = edit ? 'Edit Petty Cash Counter' : 'Add Petty Cash Counter';
                    $('ctId').value = edit ? d.id : 0;
                    $('ctName').value = edit ? d.name : '';
                    if (edit) $('ctBranch').value = d.branch; else if ($('ctBranch').options.length > 1 && $('ctBranch').options[0].value === '') $('ctBranch').value = '';
                    $('ctFloat').value = edit ? d.float : '';
                    $('ctLow').value = edit ? (d.low || '') : '';
                    $('ctCustodian').value = edit ? (d.custodian || '') : '';
                    $('ctFunding').value = edit ? (d.funding || '') : '';
                    $('ctActive').checked = edit ? d.active === '1' : true;
                    counterModal.show();
                });
            });

            var cur = { float: 0, balance: 0 };
            function syncFloat() {
                var ret = $('flReturn').checked, room = Math.max(0, cur.float - cur.balance);
                $('flSourceLabel').textContent = ret ? 'Returned To' : 'Paid From';
                $('flAmount').max = ret ? cur.balance : room;
                if (!ret && !$('flAmount').value && room > 0) $('flAmount').value = room.toFixed(2);
            }
            document.querySelectorAll('[data-acc-float]').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    var d = btn.dataset;
                    cur = { float: parseFloat(d.float), balance: parseFloat(d.balance) };
                    $('flId').value = d.id; $('flName').textContent = d.name;
                    $('flFloat').textContent = inr(cur.float); $('flBalance').textContent = inr(cur.balance); $('flRoom').textContent = inr(Math.max(0, cur.float - cur.balance));
                    $('flSource').value = d.funding || '';
                    $('flAmount').value = '';
                    // first money into an empty counter is the float issue; afterwards a top-up is a replenishment
                    (cur.balance === 0 && cur.float > 0 ? $('flIssue') : $('flRepl')).checked = true;
                    syncFloat();
                    floatModal.show();
                });
            });
            document.querySelectorAll('input[name="Kind"]').forEach(function (r) { r.addEventListener('change', function () { $('flAmount').value = ''; syncFloat(); }); });

            document.querySelectorAll('[data-acc-history]').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    $('hsName').textContent = btn.dataset.name;
                    $('hsBody').innerHTML = '<tr><td colspan="7" class="text-center text-muted py-4">Loading...</td></tr>';
                    historyModal.show();
                    fetch('@Url.Action("FloatHistory")?counterId=' + btn.dataset.id, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
                        .then(function (r) { return r.json(); })
                        .then(function (res) {
                            var body = $('hsBody'); body.innerHTML = '';
                            if (!res.success || !res.data.length) { body.innerHTML = '<tr><td colspan="7" class="text-center text-muted py-4">' + (res.message || 'No float movement yet.') + '</td></tr>'; return; }
                            res.data.forEach(function (x) {
                                var tr = document.createElement('tr');
                                [x.date, x.kind, inr(x.amount), x.source, x.voucherNo || '', x.by || '', [x.reference, x.remarks].filter(Boolean).join(' - ')].forEach(function (v, i) {
                                    var td = document.createElement('td'); td.textContent = v;
                                    if (i === 0) td.className = 'ps-3'; if (i === 2) td.className = 'text-end font-monospace'; if (i === 4) td.className = 'font-monospace small';
                                    tr.appendChild(td);
                                });
                                body.appendChild(tr);
                            });
                        })
                        .catch(function () { $('hsBody').innerHTML = '<tr><td colspan="7" class="text-center text-danger py-4">Could not load the history.</td></tr>'; });
                });
            });
        });
    </script>
}
