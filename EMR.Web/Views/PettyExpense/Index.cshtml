@model EMR.Web.Models.ViewModels.AccPettyExpenseIndexViewModel
@using EMR.Web.Models.ViewModels
@{
    ViewData["Title"] = "Petty Expenses";
    ViewData["AccIcon"] = "bi-receipt";
    ViewData["AccSubtitle"] = "Expenses paid from a petty cash counter. An expense reaches the ledger when it is approved.";
    const string Page = "UTILITY.ACCOUNTS.PETTYEXPENSE";
    var active = Model.Counters.Where(c => c.IsActive).ToList();
    var approved = Model.Expenses.Where(e => e.Status == AccStatus.Approved).ToList();
    var waiting = Model.Expenses.Where(e => e.Status == AccStatus.Submitted).ToList();
    var query = new Dictionary<string, string?>
    {
        ["fromDate"] = Model.FromDate.ToString("yyyy-MM-dd"), ["toDate"] = Model.ToDate.ToString("yyyy-MM-dd"), ["counterId"] = Model.CounterId?.ToString(),
        ["status"] = Model.Status, ["search"] = Model.Search
    };
}

<div class="container-fluid px-4 py-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div><partial name="_AccHeader" /></div>
        <div class="d-flex gap-2">
            <a asp-permission="@(Page + ":EXPORT")" asp-action="Export" asp-all-route-data="query" class="btn btn-outline-success"><i class="bi bi-file-earmark-excel me-1"></i>Excel</a>
            <a asp-permission="@(Page + ":CREATE")" asp-action="Create" class="btn btn-primary shadow-sm"><i class="bi bi-plus-lg me-1"></i>New Petty Expense</a>
        </div>
    </div>
    <partial name="_AccAlerts" />

    @if (active.Count > 0)
    {
        <div class="row g-3 mb-3">
            @foreach (var c in active)
            {
                var pct = c.FloatAmount > 0 ? (int)Math.Clamp(c.Balance / c.FloatAmount * 100, 0, 100) : 0;
                <div class="col-xl-3 col-md-4 col-sm-6">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-body py-3">
                            <div class="d-flex justify-content-between">
                                <div class="fw-semibold">@c.CounterName <span class="text-muted small fw-normal">@c.BranchName</span></div>
                                @if (c.IsLow) { <span class="badge bg-danger-subtle text-danger border border-danger-subtle">Low</span> }
                            </div>
                            <div class="fs-4 fw-bold font-monospace @(c.IsLow ? "text-danger" : "text-success")">₹@c.Balance.ToString("N2")</div>
                            <div class="progress my-1" style="height:5px;"><div class="progress-bar @(c.IsLow ? "bg-danger" : "bg-success")" style="width:@(pct)%"></div></div>
                            <div class="d-flex justify-content-between text-muted small">
                                <span>of float ₹@c.FloatAmount.ToString("N0")</span>
                                <span>@(c.PendingAmount > 0 ? $"₹{c.PendingAmount:N2} waiting" : $"₹{c.ToReplenish:N2} to replenish")</span>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-warning shadow-sm"><i class="bi bi-safe me-2"></i>No active petty cash counter. <a asp-controller="PettyCash" asp-action="Counters" asp-permission="UTILITY.ACCOUNTS.COUNTERS" class="alert-link">Add a counter and issue its float</a> to start entering expenses.</div>
    }

    <div class="card border-0 shadow-sm mb-3">
        <div class="card-body p-3">
            <form method="get" asp-action="Index" class="row g-3 align-items-end">
                <div class="col-md-2">
                    <label class="form-label small fw-semibold text-muted">From</label>
                    <input type="date" name="fromDate" class="form-control" value="@Model.FromDate.ToString("yyyy-MM-dd")" />
                </div>
                <div class="col-md-2">
                    <label class="form-label small fw-semibold text-muted">To</label>
                    <input type="date" name="toDate" class="form-control" value="@Model.ToDate.ToString("yyyy-MM-dd")" />
                </div>
                <div class="col-md-2">
                    <label class="form-label small fw-semibold text-muted">Counter</label>
                    <select name="counterId" class="form-select">
                        <option value="">All counters</option>
                        @foreach (var c in Model.Counters)
                        {
                            <option value="@c.CounterId" selected="@(Model.CounterId == c.CounterId)">@c.CounterName (@c.BranchName)</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label small fw-semibold text-muted">Status</label>
                    <select name="status" class="form-select">
                        <option value="">All</option>
                        @foreach (var s in new[] { AccStatus.Submitted, AccStatus.Approved, AccStatus.Rejected, AccStatus.Cancelled })
                        {
                            <option value="@s" selected="@(Model.Status == s)">@AccStatus.Name(s)</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label small fw-semibold text-muted">Search</label>
                    <input type="text" name="search" class="form-control" value="@Model.Search" placeholder="Payee, voucher, bill..." />
                </div>
                <div class="col-md-2 d-flex gap-2">
                    <button type="submit" class="btn btn-secondary w-100 fw-semibold"><i class="bi bi-funnel me-1"></i>Filter</button>
                    <a asp-action="Index" class="btn btn-outline-secondary" title="Reset"><i class="bi bi-arrow-counterclockwise"></i></a>
                </div>
            </form>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white d-flex flex-wrap gap-3 small py-2">
            <span>@Model.Expenses.Count voucher(s)</span>
            <span class="text-success">Approved <strong>₹@approved.Sum(e => e.TotalAmount).ToString("N2")</strong></span>
            @if (waiting.Count > 0)
            {
                <a asp-action="Index" asp-route-fromDate="@Model.FromDate.ToString("yyyy-MM-dd")" asp-route-toDate="@Model.ToDate.ToString("yyyy-MM-dd")" asp-route-status="@AccStatus.Submitted" class="text-warning-emphasis text-decoration-none">
                    <i class="bi bi-hourglass-split"></i> @waiting.Count waiting approval <strong>₹@waiting.Sum(e => e.TotalAmount).ToString("N2")</strong>
                </a>
            }
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light border-bottom">
                    <tr>
                        <th class="ps-4">Date</th><th>Voucher No.</th><th>Counter</th><th>Payee</th><th>Expense Heads</th><th class="text-end">Amount</th>
                        <th class="text-center">Status</th><th>Entered By</th><th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Expenses.Count == 0)
                    {
                        <tr><td colspan="9" class="text-center py-5 text-muted"><i class="bi bi-inbox display-6 d-block mb-2 text-secondary"></i>No petty expenses for this period.</td></tr>
                    }
                    @foreach (var e in Model.Expenses)
                    {
                        <tr>
                            <td class="ps-4">@e.ExpenseDate.ToString("dd-MMM-yyyy")</td>
                            <td class="font-monospace small fw-semibold">@e.DisplayNo @if (e.AttachmentCount > 0) { <i class="bi bi-paperclip text-muted" title="@e.AttachmentCount bill(s) attached"></i> }</td>
                            <td>@e.CounterName <span class="text-muted small">@e.BranchName</span></td>
                            <td>@(e.PayeeName ?? "-")</td>
                            <td class="small text-truncate" style="max-width:260px;" title="@e.Heads">@e.Heads</td>
                            <td class="text-end font-monospace fw-semibold">₹@e.TotalAmount.ToString("N2")</td>
                            <td class="text-center"><span class="badge @AccStatus.Badge(e.Status) rounded-pill px-3">@AccStatus.Name(e.Status)</span></td>
                            <td class="small">@e.CreatedByName</td>
                            <td class="text-end pe-4">
                                <div class="btn-group btn-group-sm shadow-sm">
                                    <a asp-action="Details" asp-encrypted-id="@e.ExpenseId" class="btn btn-outline-info" title="View"><i class="bi bi-eye"></i></a>
                                    @if (e.Status is AccStatus.Submitted or AccStatus.Rejected)
                                    {
                                        <a asp-permission="@(Page + ":EDIT")" asp-action="Edit" asp-encrypted-id="@e.ExpenseId" class="btn btn-outline-primary" title="Edit"><i class="bi bi-pencil"></i></a>
                                    }
                                    <a asp-permission="@(Page + ":PRINT")" asp-action="Print" asp-encrypted-id="@e.ExpenseId" target="_blank" class="btn btn-outline-secondary" title="Print voucher"><i class="bi bi-printer"></i></a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
