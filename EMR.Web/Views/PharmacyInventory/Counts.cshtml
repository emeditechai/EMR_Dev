@using EMR.Web.Services
@model List<PhInvDocRow>
@{
    ViewData["Title"] = "Physical Stock Verification";
    var cats = (List<PhOption>)ViewBag.Categories;
    var stats = new List<KeyValuePair<string, int>> { new("Open", Model.Count(m => m.Status is "COUNTING" or "SUBMITTED")), new("Approved", Model.Count(m => m.Status == "APPROVED")) };
}
<link rel="stylesheet" href="~/css/pharmacy-masters.css" asp-append-version="true" />
<partial name="_PharmacyMasterHeader" model="@(new PhHeader("Physical Stock Verification", "bi-clipboard-check", "Freeze the system stock, count by rack on a blind count sheet, enter the counts, review the variance, submit; another user approves and the differences are adjusted and posted.", null, null, Stats: stats, Section: "Pharmacy", Group: "Inventory"))" />
<form method="post" asp-action="Create" asp-permission="PHARMACY.STOCKCOUNT:CREATE" class="card shadow-sm border-0 mb-3">
    @Html.AntiForgeryToken()
    <div class="card-body row g-2 align-items-end">
        @{ var cStores = ViewBag.Stores as List<EMR.Web.Services.PhStoreOption> ?? new(); }
        <div class="col-md-2"><label class="form-label small fw-semibold">Store</label><select name="storeId" class="form-select form-select-sm">@foreach (var s in cStores) { <option value="@s.StoreId" selected="@s.IsDefault">@s.StoreName</option> }</select></div>
        <div class="col-md-2"><label class="form-label small fw-semibold">Racks starting with</label><input name="rack" class="form-control form-control-sm text-uppercase" placeholder="all racks" maxlength="30" /></div>
        <div class="col-md-3"><label class="form-label small fw-semibold">Category</label><select name="categoryId" class="form-select form-select-sm"><option value="">All</option>@foreach (var c in cats) { <option value="@c.Value">@c.Text</option> }</select></div>
        <div class="col-md-2"><div class="form-check mb-1"><input type="checkbox" class="form-check-input" name="includeZero" value="true" id="z"><label class="form-check-label small" for="z">Include zero-stock batches</label></div></div>
        <div class="col-md-3"><label class="form-label small fw-semibold">Remarks</label><input name="remarks" class="form-control form-control-sm" maxlength="300" /></div>
        <div class="col-md-2"><button class="btn btn-sm btn-primary w-100"><i class="bi bi-snow me-1"></i>Freeze &amp; start</button></div>
    </div>
</form>
@{ var plan = ViewBag.CyclePlan as List<PhCycleRack> ?? new(); var due = plan.Count(r => r.IsDue); }
@if (plan.Count > 0)
{
    @* Cycle count plan (SQLScripts/2405): every rack is verified once every N days (Hospital Settings > MED) *@
    <div class="card shadow-sm border-0 mb-3">
        <div class="card-header bg-white d-flex align-items-center gap-2 py-2">
            <i class="bi bi-calendar2-check text-primary"></i><span class="fw-bold small">Cycle count plan</span>
            <span class="badge @(due > 0 ? "bg-danger" : "bg-success")">@(due > 0 ? $"{due} rack(s) due" : "All racks up to date")</span>
            <span class="small text-muted ms-auto">Each rack every @plan[0].EveryDays days</span>
        </div>
        <div class="ph-wrap" style="max-height:260px"><table class="table table-sm mb-0 ph-table">
            <thead><tr><th>Rack</th><th class="text-end">Items</th><th class="text-end">Batches</th><th class="text-end">Stock value</th><th>Last verified</th><th class="text-end">Days</th><th>State</th><th></th></tr></thead>
            <tbody>@foreach (var r in plan) {
                <tr class="@(r.IsDue ? "table-warning" : "")"><td class="fw-semibold">@r.RackNo</td><td class="text-end">@r.Items</td><td class="text-end">@r.Batches</td><td class="text-end">@r.StockValue.ToString("N2")</td>
                    <td class="small">@(r.LastCounted?.ToString("dd-MMM-yyyy") ?? "Never")</td><td class="text-end">@(r.DaysSince?.ToString() ?? "—")</td>
                    <td class="small">@if (r.OpenCount != null) { <span class="badge bg-info-subtle text-info-emphasis border">open: @r.OpenCount</span> } else if (r.IsDue) { <span class="badge bg-danger">Due</span> } else { <span class="text-success">OK</span> }</td>
                    <td class="text-end">@if (r.IsDue && r.RackNo != "(no rack)") {
                        <form method="post" asp-action="Create" asp-permission="PHARMACY.STOCKCOUNT:CREATE" class="d-inline">@Html.AntiForgeryToken()<input type="hidden" name="rack" value="@r.RackNo" /><input type="hidden" name="remarks" value="Cycle count - rack @r.RackNo" />
                            <button class="btn btn-sm btn-outline-primary py-0"><i class="bi bi-snow me-1"></i>Count now</button></form> }</td></tr> }</tbody>
        </table></div>
    </div>
}
<div class="card shadow-sm border-0"><div class="ph-wrap"><table class="table table-hover mb-0 ph-table ph-editable">
    <thead><tr><th>#</th><th>Number</th><th>Frozen at</th><th>Scope</th><th class="text-end">Batches</th><th class="text-end">Difference (cost)</th><th>By</th><th>Status</th></tr></thead>
    <tbody>@for (var i = 0; i < Model.Count; i++) { var r = Model[i];
        <tr onclick="location.href='@Url.Action("Form", new { id = r.Id })'"><td class="text-muted small">@(i + 1)</td><td class="font-monospace small fw-semibold">@r.DocNo</td><td>@r.DocDate.ToString("dd-MMM-yyyy HH:mm")</td><td class="small">@r.Party</td>
            <td class="text-end">@r.Lines</td><td class="text-end @(r.Value < 0 ? "text-danger" : "")">@r.Value.ToString("N2")</td><td class="small">@r.CreatedByName</td><td><partial name="_InvStatus" model="r.Status" /></td></tr> }</tbody>
</table>
@if (Model.Count == 0) { <div class="text-center text-muted py-5"><i class="bi bi-inbox fs-2 d-block mb-2"></i>No verification yet.</div> }</div></div>
