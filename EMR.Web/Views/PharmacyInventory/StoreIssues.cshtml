@using EMR.Web.Services
@model List<PhIssueRow>
@{
    ViewData["Title"] = "Store Issue";
    string? status = ViewBag.Status;
    var stats = new List<KeyValuePair<string, int>> { new("To issue", Model.Count(m => m.Status == "REQUESTED")), new("To receive", Model.Count(m => m.Status == "ISSUED")), new("Drafts", Model.Count(m => m.Status == "DRAFT")) };
}
<link rel="stylesheet" href="~/css/pharmacy-masters.css" asp-append-version="true" />
<partial name="_PharmacyMasterHeader" model="@(new PhHeader("Store Issue (Godown to Counter)", "bi-box-arrow-in-right", "Within this branch the counter asks a godown for stock; the godown issues batches; the counter receives them, recording any shortage. Moved at cost.", null, null, Stats: stats, Section: "Pharmacy", Group: "Inventory"))" />
<div class="card shadow-sm border-0">
    <form method="get" class="card-body py-2 ph-toolbar border-bottom d-flex flex-wrap gap-2 align-items-center">
        <select name="status" class="form-select form-select-sm" style="width:auto" onchange="this.form.submit()"><option value="">All statuses</option>@foreach (var (v, t) in new[] { ("DRAFT", "Draft"), ("REQUESTED", "Requested"), ("ISSUED", "Issued"), ("RECEIVED", "Received"), ("CANCELLED", "Cancelled") }) { <option value="@v" selected="@(v == status)">@t</option> }</select>
        <a asp-action="Form" asp-permission="PHARMACY.STOREISSUE:REQUEST" class="btn btn-sm btn-primary ms-auto"><i class="bi bi-plus-circle me-1"></i>New store request</a>
    </form>
    <div class="ph-wrap"><table class="table table-hover mb-0 ph-table ph-editable">
        <thead><tr><th>#</th><th>Number</th><th>Date</th><th>From (gives)</th><th>To (asks)</th><th class="text-end">Items</th><th class="text-end">Issued (cost)</th><th class="text-end">Short</th><th>By</th><th>Status</th></tr></thead>
        <tbody>@for (var i = 0; i < Model.Count; i++) { var r = Model[i];
            <tr onclick="location.href='@Url.Action("Form", new { id = r.Id })'"><td class="text-muted small">@(i + 1)</td><td class="font-monospace small fw-semibold">@(r.DocNo ?? "Draft #" + r.Id)</td><td class="small">@r.DocDate.ToString("dd-MMM HH:mm")</td>
                <td>@r.FromStore</td><td>@r.ToStore</td><td class="text-end">@r.Lines</td><td class="text-end">@r.CostValue.ToString("N2")</td><td class="text-end @(r.VarianceValue != 0 ? "text-danger" : "")">@(r.VarianceValue != 0 ? r.VarianceValue.ToString("N2") : "")</td>
                <td class="small">@r.CreatedByName</td><td><partial name="~/Views/PharmacyInventory/_InvStatus.cshtml" model="r.Status" /></td></tr> }</tbody>
    </table>
    @if (Model.Count == 0) { <div class="text-center text-muted py-5"><i class="bi bi-inbox fs-2 d-block mb-2"></i>No store requests.</div> }</div>
</div>
