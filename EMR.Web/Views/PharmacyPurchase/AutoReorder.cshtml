@using EMR.Web.Services
@{
    // Pharmacy > Purchase > Auto Reorder (SQLScripts/2403): sales-based suggestions, one draft PO per supplier.
    ViewData["Title"] = "Auto Reorder";
    var suppliers = (List<PhOption>)ViewBag.Suppliers;
    var categories = (List<PhOption>)ViewBag.Categories;
}
<link rel="stylesheet" href="~/css/pharmacy-masters.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/views/PharmacyPurchase/AutoReorder.css" asp-append-version="true" />
<partial name="_PharmacyMasterHeader" model="@(new PhHeader("Auto Reorder", "bi-arrow-repeat", "Order quantities worked out from average daily sales, lead time and safety stock (Hospital Settings > MED). Tick, adjust, and create one draft purchase order per supplier.", null, null, Section: "Pharmacy", Group: "Purchase"))" />

@Html.AntiForgeryToken()
<div id="arOff" class="alert alert-warning d-none">
    <i class="bi bi-toggle-off me-1"></i><b>Auto Reorder is off for this branch.</b> Turn it on in Hospital Settings &gt; MED &gt; Auto reorder, and set the sales window, safety stock and cover days.
</div>

<div class="row g-2 mb-3" id="arKpis">
    <div class="col-6 col-lg-3"><div class="ar-kpi"><div class="l">Items to order</div><div class="v" id="kItems">–</div></div></div>
    <div class="col-6 col-lg-3"><div class="ar-kpi"><div class="l">Suppliers</div><div class="v" id="kSup">–</div></div></div>
    <div class="col-6 col-lg-3"><div class="ar-kpi"><div class="l">Ticked order value (with GST)</div><div class="v text-primary" id="kValue">–</div></div></div>
    <div class="col-6 col-lg-3"><div class="ar-kpi"><div class="l">Rule in force</div><div class="small fw-semibold mt-1" id="kRule">–</div></div></div>
</div>

<div class="card shadow-sm border-0 mb-3">
    <div class="card-body py-2 ph-toolbar border-bottom d-flex flex-wrap gap-2 align-items-center">
        <div style="width:230px"><select id="fSup" class="form-select form-select-sm">
            <option value="">All suppliers</option>
            @foreach (var s in suppliers) { <option value="@s.Value">@s.Text</option> }
        </select></div>
        <div style="width:230px"><select id="fCat" class="form-select form-select-sm">
            <option value="">All categories</option>
            @foreach (var c in categories) { <option value="@c.Value">@c.Text</option> }
        </select></div>
        <div class="form-check form-switch m-0 ms-1"><input class="form-check-input" type="checkbox" id="fAll"><label class="form-check-label small" for="fAll">Show items not due</label></div>
        <div class="input-group input-group-sm" style="width:240px">
            <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
            <input type="search" id="fQ" class="form-control" placeholder="Item, generic, code" />
        </div>
        <button type="button" class="btn btn-sm btn-outline-secondary" id="btnReload"><i class="bi bi-arrow-clockwise me-1"></i>Refresh</button>
        <span class="small text-muted ms-auto" id="arCount"></span>
    </div>
    <div class="table-responsive">
        <table class="table table-sm table-hover align-middle mb-0" id="arTable">
            <thead class="table-light">
                <tr>
                    <th style="width:28px"><input class="form-check-input" type="checkbox" id="chkAll" title="Tick all due items"></th>
                    <th>Item</th>
                    <th class="num" title="Stock now, in purchase packs">Stock</th>
                    <th class="num" title="Ordered on approved purchase orders, not yet received">On order</th>
                    <th class="num" title="Average packs sold per day">Avg / day</th>
                    <th class="num" title="Days the stock lasts at the average">Days left</th>
                    <th class="num" title="Order when stock + on order falls to this">Reorder at</th>
                    <th class="num" title="Order brings stock up to this">Up to</th>
                    <th>Supplier</th>
                    <th class="num">Order qty</th>
                    <th class="num">Free</th>
                    <th class="num">Rate</th>
                    <th class="num">Disc %</th>
                    <th class="num">Value</th>
                </tr>
            </thead>
            <tbody id="arBody"><tr><td colspan="14" class="text-muted small p-3">Loading…</td></tr></tbody>
        </table>
    </div>
    <div class="ar-bar d-flex flex-wrap align-items-center gap-2 px-3 py-2">
        <span class="small" id="arSel">Nothing ticked.</span>
        <span class="small text-muted" id="arDirect"></span>
        <button type="button" class="btn btn-primary btn-sm ms-auto" id="btnCreate" disabled><i class="bi bi-file-earmark-plus me-1"></i>Create draft purchase orders</button>
    </div>
</div>

<div class="modal fade" id="arDone" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered"><div class="modal-content border-0 shadow">
        <div class="modal-header py-2"><h6 class="modal-title fw-bold"><i class="bi bi-check-circle-fill text-success me-1"></i>Draft purchase orders created</h6>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div>
        <div class="modal-body"><div class="small text-muted mb-2">Review and approve each one in Purchase Order (normal approval flow).</div><div id="arDoneList"></div></div>
        <div class="modal-footer py-2"><a class="btn btn-outline-primary btn-sm" href="@Url.Action("Index", "PhPurchaseOrders")">Open Purchase Orders</a>
            <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Close</button></div>
    </div></div>
</div>

@section Scripts {
<script>
(function () {
    const urls = { data: '@Url.Action("Data")', free: '@Url.Action("SchemeFree")', create: '@Url.Action("CreatePos")', po: '@Url.Action("Form", "PhPurchaseOrders")' };
    const canCreate = typeof emrCan !== 'function' || emrCan('PHARMACY.AUTOREORDER', 'CREATEPO');
    const suppliers = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(suppliers.Select(s => new { id = s.Value, name = s.Text })));
    const esc = s => String(s ?? '').replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
    const n2 = v => Number(v || 0).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    const n = (v, d = 2) => Number(v || 0).toLocaleString('en-IN', { maximumFractionDigits: d });
    const toast = (icon, title) => Swal.fire({ toast: true, position: 'top-end', icon, title, timer: 3000, showConfirmButton: false });
    let rows = [], settings = null;

    function lineValue(r) {
        const taxable = (r.qty || 0) * (r.rate || 0) * (1 - (r.disc || 0) / 100);
        return taxable * (1 + (r.gstPercent || 0) / 100);
    }

    function render() {
        const q = $('#fQ').val().trim().toLowerCase();
        const vis = rows.filter(r => !q || [r.itemName, r.genericName, r.itemCode].some(x => (x || '').toLowerCase().includes(q)));
        const groups = {};
        vis.forEach(r => { const k = r.supId ? String(r.supId) : ''; (groups[k] = groups[k] || []).push(r); });
        const keys = Object.keys(groups).sort((a, b) => a === '' ? 1 : b === '' ? -1 : supName(a).localeCompare(supName(b)));
        let html = '';
        keys.forEach(k => {
            const g = groups[k], val = g.filter(r => r.on).reduce((s, r) => s + lineValue(r), 0);
            html += `<tr class="ar-sup"><td colspan="13">${k ? '<i class="bi bi-truck me-1"></i>' + esc(supName(k)) : '<i class="bi bi-question-circle me-1 text-warning"></i>No earlier supplier - pick one'} <span class="text-muted fw-normal ms-1">${g.length} item(s)</span></td><td class="num">${n2(val)}</td></tr>`;
            g.forEach(r => {
                const why = r.avgDaily > 0 ? `${n(r.avgDaily, 2)}/day × ${r.leadDays}d lead` : (r.maxQty > 0 ? 'No recent sale - up to max' : 'No recent sale - reorder level');
                html += `<tr data-id="${r.itemId}" class="${r.suggestedQty > 0 ? '' : 'ar-off'}">
                    <td><input class="form-check-input ar-on" type="checkbox" ${r.on ? 'checked' : ''} ${canCreate ? '' : 'disabled'}></td>
                    <td><div class="fw-semibold">${esc(r.itemName)} <span class="text-muted fw-normal small">${esc(r.packSize || '')}</span></div>
                        <div class="ar-why">${esc(r.genericName || '')}${r.genericName ? ' · ' : ''}${esc(r.itemCode)} · ${why}</div></td>
                    <td class="num">${n(r.stockPacks)}</td>
                    <td class="num">${r.pendingPoQty > 0 ? n(r.pendingPoQty) : '<span class="text-muted">–</span>'}</td>
                    <td class="num">${r.avgDaily > 0 ? n(r.avgDaily, 2) : '<span class="text-muted">0</span>'}</td>
                    <td class="num">${r.daysOfStock == null ? '<span class="text-muted">–</span>' : `<span class="${r.daysOfStock <= r.leadDays ? 'text-danger fw-bold' : ''}">${n(r.daysOfStock, 1)}</span>`}</td>
                    <td class="num">${n(r.reorderPoint)}</td>
                    <td class="num">${n(r.orderUpTo)}</td>
                    <td><select class="form-select form-select-sm ar-sel ar-sup-sel"><option value="">— pick —</option>${suppliers.map(s => `<option value="${s.id}" ${String(r.supId) === s.id ? 'selected' : ''}>${esc(s.name)}</option>`).join('')}</select></td>
                    <td class="num"><input type="number" min="0" step="1" class="form-control form-control-sm ar-qty ar-in" data-f="qty" value="${r.qty}"> <span class="text-muted small">${esc(r.purchaseUom || '')}</span></td>
                    <td class="num">${r.free > 0 ? `<span class="badge bg-success-subtle text-success border ar-free" title="Scheme ${esc(r.scheme || '')}">+${n(r.free)} (${esc(r.scheme || '')})</span>` : '<span class="text-muted">–</span>'}</td>
                    <td class="num"><input type="number" min="0" step="0.01" class="form-control form-control-sm ar-rate ar-in" data-f="rate" value="${r.rate || ''}"></td>
                    <td class="num"><input type="number" min="0" max="100" step="0.01" class="form-control form-control-sm ar-qty ar-in" data-f="disc" value="${r.disc || 0}"></td>
                    <td class="num">${r.on ? n2(lineValue(r)) : '<span class="text-muted">–</span>'}</td>
                </tr>`;
            });
        });
        $('#arBody').html(html || `<tr><td colspan="14" class="text-center text-muted p-4"><i class="bi bi-check2-circle fs-4 d-block mb-1 text-success"></i>${settings && settings.enabled ? 'Nothing is due for reorder.' : 'Auto Reorder is off for this branch.'}</td></tr>`);
        $('#arCount').text(vis.length + ' item(s)');
        totals();
    }

    function supName(id) { return (suppliers.find(s => s.id === String(id)) || {}).name || ''; }

    function totals() {
        const on = rows.filter(r => r.on);
        const sups = new Set(on.map(r => r.supId).filter(Boolean));
        $('#kItems').text(rows.filter(r => r.suggestedQty > 0).length);
        $('#kSup').text(new Set(rows.filter(r => r.suggestedQty > 0).map(r => r.supId).filter(Boolean)).size);
        $('#kValue').text('₹' + n2(on.reduce((s, r) => s + lineValue(r), 0)));
        $('#arSel').html(on.length ? `<b>${on.length}</b> item(s) ticked → <b>${sups.size}</b> draft PO(s)` : 'Nothing ticked.');
        $('#btnCreate').prop('disabled', !canCreate || on.length === 0);
    }

    async function load() {
        $('#arBody').html('<tr><td colspan="14" class="text-muted small p-3">Loading…</td></tr>');
        const p = new URLSearchParams({ supplierId: $('#fSup').val(), categoryId: $('#fCat').val(), showAll: $('#fAll').is(':checked') });
        try {
            const r = await (await fetch(urls.data + '?' + p)).json();
            settings = r.settings;
            $('#arOff').toggleClass('d-none', !!settings.enabled);
            $('#kRule').html(`Avg of last <b>${settings.salesDays}</b> days · safety <b>${settings.safetyDays}</b> · cover <b>${settings.coverDays}</b> days`);
            $('#arDirect').text(settings.grnNotRequired ? 'GRN Not Required is on: each draft PO needs the supplier bill, batch and expiry before approval.' : '');
            rows = (r.rows || []).map(x => ({ ...x, supId: x.supplierId || null, qty: x.suggestedQty, rate: x.rate, disc: x.discPercent, free: x.freeQty, scheme: x.schemeText, on: x.suggestedQty > 0 && !!x.supplierId && x.rate > 0 }));
            render();
        } catch { $('#arBody').html('<tr><td colspan="14" class="text-danger small p-3">Could not load the suggestions.</td></tr>'); }
    }

    const timers = {};
    function refreshFree(r) {
        clearTimeout(timers[r.itemId]);
        timers[r.itemId] = setTimeout(async () => {
            if (!r.supId || !(r.qty > 0)) { r.free = 0; r.scheme = null; render(); return; }
            try {
                const f = await (await fetch(urls.free + '?' + new URLSearchParams({ supplierId: r.supId, itemId: r.itemId, qty: r.qty }))).json();
                r.free = f.freeQty || 0; r.scheme = f.schemeText; render();
            } catch { }
        }, 350);
    }

    const rowOf = el => rows.find(r => r.itemId === Number($(el).closest('tr').data('id')));
    $('#arBody').on('change', '.ar-on', function () { const r = rowOf(this); r.on = this.checked; render(); });
    $('#arBody').on('change', '.ar-sup-sel', function () { const r = rowOf(this); r.supId = this.value ? Number(this.value) : null; refreshFree(r); render(); });
    $('#arBody').on('change', '.ar-in', function () {
        const r = rowOf(this), f = this.dataset.f, v = parseFloat(this.value);
        r[f] = isNaN(v) ? 0 : v;
        if (f === 'qty') { if (r.qty > 0 && !r.on && r.supId && r.rate > 0) r.on = true; refreshFree(r); }
        render();
    });
    $('#chkAll').on('change', function () { rows.forEach(r => r.on = this.checked && r.qty > 0 && !!r.supId && r.rate > 0); render(); });
    $('#fSup, #fCat, #fAll').on('change', load);
    $('#btnReload').on('click', load);
    $('#fQ').on('input', render);

    $('#btnCreate').on('click', async function () {
        const on = rows.filter(r => r.on);
        const bad = on.find(r => !r.supId || !(r.qty > 0) || !(r.rate > 0));
        if (bad) { toast('warning', `${bad.itemName}: needs a supplier, quantity and rate.`); return; }
        const sups = new Set(on.map(r => r.supId)).size;
        if (!(await Swal.fire({ title: 'Create purchase orders', text: `Create ${sups} draft purchase order(s) for ${on.length} item(s)?`, icon: 'question', showCancelButton: true, confirmButtonText: 'Create' })).isConfirmed) return;
        const body = new FormData();
        body.append('json', JSON.stringify(on.map(r => ({ itemId: r.itemId, supplierId: r.supId, qty: r.qty, rate: r.rate, discPercent: r.disc || 0 }))));
        body.append('__RequestVerificationToken', $('input[name="__RequestVerificationToken"]').val());
        $(this).prop('disabled', true);
        try {
            const r = await (await fetch(urls.create, { method: 'POST', body })).json();
            if (!r.success) { toast('error', r.message); return; }
            $('#arDoneList').html('<ul class="list-group">' + r.created.map(c =>
                `<li class="list-group-item d-flex justify-content-between align-items-center"><span><i class="bi bi-truck me-1"></i>${esc(c.supplierName)} <span class="text-muted small">· ${c.lines} item(s)</span></span>
                 <span><b>₹${n2(c.netAmount)}</b> <a class="btn btn-sm btn-link" href="${urls.po}?id=${c.poId}">Open</a></span></li>`).join('') + '</ul>');
            bootstrap.Modal.getOrCreateInstance(document.getElementById('arDone')).show();
            load();
        } catch { toast('error', 'Could not reach the server.'); }
        finally { totals(); }
    });

    load();
})();
</script>
}
