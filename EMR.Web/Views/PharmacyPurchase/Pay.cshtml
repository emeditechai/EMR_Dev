@using EMR.Web.Services
@model List<PhPayable>
@{
    // Pharmacy > Purchase > Supplier Payments > Pay: set the payment off against the supplier's open bills, oldest first (SQLScripts/2344)
    var s = (PhSupplierInfo)ViewBag.Supplier;
    decimal returns = ViewBag.Returns;
    var dns = (List<PhOpenDebitNote>)ViewBag.DebitNotes;   // SQLScripts/2400
    var dnAvail = dns.Sum(d => d.Available);
    string pc = ViewBag.PageCode;
    ViewData["Title"] = "Pay " + s.SupplierName;
}
<link rel="stylesheet" href="~/css/pharmacy-masters.css" asp-append-version="true" />
<partial name="_PharmacyMasterHeader" model="@(new PhHeader("Supplier Payments", "bi-cash-coin", "Enter the amount paid; it is set off against the oldest bills first. You can change the split bill by bill.", null, null, "Pay " + s.SupplierName, "Pay", Url.Action("Outstanding"), Section: "Pharmacy", Group: "Purchase"))" />

<form method="post" asp-action="Save" id="payForm">
@Html.AntiForgeryToken()
<input type="hidden" name="supplierId" value="@s.SupplierId" />
<div class="card shadow-sm border-0 mb-3"><div class="card-body row g-3 align-items-end">
    <div class="col-md-2"><label class="form-label small fw-semibold req">Payment date</label><input type="date" name="paymentDate" class="form-control" value="@DateTime.Today.ToString("yyyy-MM-dd")" max="@DateTime.Today.ToString("yyyy-MM-dd")" required /></div>
    <div class="col-md-2"><label class="form-label small fw-semibold req">Mode</label><select name="mode" id="mode" class="form-select"><option value="NEFT">NEFT / RTGS</option><option value="CHEQUE">Cheque</option><option value="UPI">UPI</option><option value="CASH">Cash</option><option value="CARD">Card</option></select></div>
    <div class="col-md-3"><label class="form-label small fw-semibold" id="refLabel">Reference / UTR / cheque no.</label><input name="reference" id="reference" class="form-control" maxlength="50" /></div>
    <div class="col-md-2"><label class="form-label small fw-semibold">Amount to pay (₹)</label><input type="number" step="0.01" min="0" id="payAmount" class="form-control fw-bold" /></div>
    <div class="col-md-3"><label class="form-label small fw-semibold">Remarks</label><input name="remarks" class="form-control" maxlength="300" /></div>
    @if (dnAvail > 0)
    {
        <div class="col-12">
            <div class="alert alert-success py-2 mb-0 small d-flex flex-wrap align-items-center gap-2">
                <i class="bi bi-receipt-cutoff"></i>
                <span><b>Open debit notes ₹ @dnAvail.ToString("N2")</b> (@string.Join(", ", dns.Select(d => $"{d.ReturnNo} ₹{d.Available:N2}"))) - set them off against the bills below; you pay only the rest.</span>
                <button type="button" class="btn btn-sm btn-success ms-auto" id="btnAutoAdjust"><i class="bi bi-magic me-1"></i>Adjust oldest bills</button>
            </div>
        </div>
    }
</div></div>

<div class="card shadow-sm border-0"><div class="ph-wrap"><table class="table mb-0 ph-table">
    <thead><tr><th>#</th><th>GRN</th><th>Supplier bill</th><th>Bill date</th><th>Due</th><th class="text-end">Bill amount</th><th class="text-end">Paid / adjusted earlier</th><th class="text-end">Balance</th>@if (dnAvail > 0) { <th class="text-end" style="width:150px">Adjust debit note</th> }<th class="text-end" style="width:150px">Pay now</th></tr></thead>
    <tbody>
    @for (var i = 0; i < Model.Count; i++)
    {
        var b = Model[i];
        <tr><td class="text-muted small">@(i + 1)</td><td class="font-monospace small">@b.GrnNo</td><td>@b.InvoiceNo</td><td>@b.InvoiceDate.ToString("dd-MMM-yyyy")</td>
            <td class="@(b.DueDate < DateTime.Today ? "text-danger fw-semibold" : "")">@b.DueDate?.ToString("dd-MMM-yyyy")</td>
            <td class="text-end">@b.NetAmount.ToString("N2")</td><td class="text-end">@((b.Paid + b.Adjusted).ToString("N2"))@if (b.Adjusted > 0) { <div class="small text-success">DN @b.Adjusted.ToString("N2")</div> }</td><td class="text-end fw-semibold">@b.Balance.ToString("N2")</td>
            @if (dnAvail > 0) { <td><input type="number" step="0.01" min="0" max="@b.Balance" name="adjust[@b.GrnId]" class="form-control form-control-sm text-end adj border-success" data-bal="@b.Balance" /></td> }
            <td><input type="number" step="0.01" min="0" max="@b.Balance" name="alloc[@b.GrnId]" class="form-control form-control-sm text-end alloc" data-bal="@b.Balance" /></td></tr>
    }
    </tbody>
    <tfoot><tr><td colspan="7" class="text-end fw-bold">Total</td><td class="text-end fw-bold">@Model.Sum(b => b.Balance).ToString("N2")</td>@if (dnAvail > 0) { <td class="text-end fw-bold text-success" id="adjTotal">0.00</td> }<td class="text-end fw-bold" id="allocTotal">0.00</td></tr></tfoot>
</table></div></div>

<div class="ph-actions py-2 px-3 mt-3 d-flex gap-2 justify-content-end rounded-3" style="position:sticky;bottom:0;background:rgba(248,250,252,.96)">
    <a asp-action="Outstanding" class="btn btn-outline-secondary me-auto"><i class="bi bi-arrow-left me-1"></i>Back</a>
    <button asp-permission="@($"{pc}:SAVE")" class="btn btn-success px-4"><i class="bi bi-check2-circle me-1"></i>Record payment</button>
</div>
</form>

@section Scripts {
<script>
(function () {
    const allocs = [...document.querySelectorAll('.alloc')], adjs = [...document.querySelectorAll('.adj')];
    const dnAvail = @dnAvail.ToString(System.Globalization.CultureInfo.InvariantCulture);
    const fmt = v => v.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    const val = a => parseFloat(a.value) || 0;
    const rowOf = el => el.closest('tr');
    const adjOf = tr => tr.querySelector('.adj'), payOf = tr => tr.querySelector('.alloc');
    const left = tr => parseFloat(payOf(tr).dataset.bal) - (adjOf(tr) ? val(adjOf(tr)) : 0);   // what is still to pay on the bill
    function sum() {
        document.getElementById('allocTotal').textContent = fmt(allocs.reduce((t, a) => t + val(a), 0));
        const at = document.getElementById('adjTotal'); if (at) at.textContent = fmt(adjs.reduce((t, a) => t + val(a), 0));
    }
    // debit notes first, oldest bill first; never more than what is open
    document.getElementById('btnAutoAdjust')?.addEventListener('click', () => {
        let rest = dnAvail;
        adjs.forEach(a => { const take = Math.min(rest, parseFloat(a.dataset.bal) - val(payOf(rowOf(a)))); a.value = take > 0 ? take.toFixed(2) : ''; rest -= Math.max(take, 0); });
        sum();
    });
    document.getElementById('payAmount').addEventListener('input', e => {   // cash: oldest bill first, after its debit note
        let rest = parseFloat(e.target.value) || 0;
        allocs.forEach(a => { const take = Math.min(rest, left(rowOf(a))); a.value = take > 0 ? take.toFixed(2) : ''; rest -= Math.max(take, 0); });
        sum();
    });
    [...allocs, ...adjs].forEach(a => a.addEventListener('input', sum));
    const mode = document.getElementById('mode'), ref = document.getElementById('reference');
    const m = () => { const cash = allocs.some(a => val(a) > 0); ref.required = cash && mode.value !== 'CASH'; document.getElementById('refLabel').classList.toggle('req', ref.required); };
    mode.addEventListener('change', m); allocs.forEach(a => a.addEventListener('input', m)); m();
    document.getElementById('payForm').addEventListener('submit', async e => {
        if (e.target.dataset.ok) return;
        e.preventDefault();
        const cash = allocs.reduce((s, a) => s + val(a), 0), adj = adjs.reduce((s, a) => s + val(a), 0);
        if (cash + adj <= 0) { Swal.fire({ icon: 'info', title: 'Enter the amount paid or adjusted against at least one bill.' }); return; }
        if (adj > dnAvail + 0.001) { Swal.fire({ icon: 'warning', title: 'Only ₹ ' + fmt(dnAvail) + ' of debit notes is open.' }); return; }
        const over = allocs.find(a => val(a) + (adjOf(rowOf(a)) ? val(adjOf(rowOf(a))) : 0) > parseFloat(a.dataset.bal) + 0.001);
        if (over) { Swal.fire({ icon: 'warning', title: 'Paid + adjusted is more than a bill\'s balance.' }); over.focus(); return; }
        const r = await Swal.fire({ title: cash > 0 ? 'Record payment?' : 'Adjust debit notes?',
            html: (cash > 0 ? `Pay <b>₹ ${fmt(cash)}</b>` : 'No cash payment') + (adj > 0 ? ` · adjust debit notes <b>₹ ${fmt(adj)}</b>` : '') + ` to @Html.Raw(System.Text.Json.JsonSerializer.Serialize(s.SupplierName)[1..^1])`,
            icon: 'question', showCancelButton: true, confirmButtonText: 'Yes, record' });
        if (r.isConfirmed) { e.target.dataset.ok = '1'; e.target.submit(); }
    });
})();
</script>
}
