@using EMR.Web.Services
@model List<PhRegisterRow>
@{
    // Pharmacy > Purchase > Purchase Register (SQLScripts/2345, standard GST layout 2399): posted GRNs and debit notes (minus)
    // with supplier GSTIN / state / supply type, gross - discount = taxable, CGST / SGST / IGST, other charges, round off and
    // net; purchases / returns / net totals, a GST rate-wise summary and a supplier-wise summary.
    ViewData["Title"] = "Purchase Register";
    var (from, to, supplierId) = ((DateTime, DateTime, int?))ViewBag.Filter;
    var suppliers = (List<PhOption>)ViewBag.Suppliers;
    var gst = (List<PhGstSummaryRow>)ViewBag.Gst;
    var supSummary = (List<PhSupplierSummaryRow>)ViewBag.SupplierSummary;
    var docType = (string)ViewBag.DocType;
    var search = ViewBag.Search as string;
    var purchases = Model.Where(r => r.DocType == "Purchase").ToList();
    var returns = Model.Where(r => r.DocType != "Purchase").ToList();
    var stats = new List<KeyValuePair<string, int>> { new("GRNs", purchases.Count), new("Debit notes", returns.Count), new("Suppliers", Model.Select(r => r.SupplierName).Distinct().Count()) };
    string N(decimal v) => v.ToString("N2");
    string D(DateTime? d) => d?.ToString("dd-MMM-yyyy") ?? "";
    var missingGstin = Model.Where(r => string.IsNullOrWhiteSpace(r.Gstin)).Select(r => r.SupplierName).Distinct().ToList();
}
<link rel="stylesheet" href="~/lib/tom-select/dist/css/tom-select.bootstrap5.min.css" />
<link rel="stylesheet" href="~/css/pharmacy-masters.css" asp-append-version="true" />
<style>
    .pr-kpi { border:1px solid #e2e8f0; border-radius:10px; background:#fff; padding:.65rem .9rem; height:100%; }
    .pr-kpi .l { font-size:.66rem; font-weight:700; letter-spacing:.5px; text-transform:uppercase; color:#64748b; }
    .pr-kpi .v { font-size:1.2rem; font-weight:800; font-variant-numeric:tabular-nums; }
    .pr-kpi .s { font-size:.7rem; color:#64748b; }
    #phTable td, #phTable th { white-space:nowrap; font-size:.8rem; }
    #phTable td.num, #phTable th.num { text-align:right; font-variant-numeric:tabular-nums; }
    #phTable tr.dn td { color:#b91c1c; }
    #phTable tfoot tr.sub td { background:#f8fafc; }
    .pr-sum td, .pr-sum th { font-size:.8rem; }
</style>
<partial name="_PharmacyMasterHeader" model="@(new PhHeader("Purchase Register", "bi-journal-text", "Posted purchases (GRN) and purchase returns (debit notes, shown minus) with the GST split, for GST input (GSTR-2B / 3B) and supplier reconciliation.", null, null, Stats: stats, Section: "Pharmacy", Group: "Purchase"))" />

<div class="card shadow-sm border-0 mb-3">
    <form method="get" class="card-body py-2 ph-toolbar border-bottom d-flex flex-wrap gap-2 align-items-center">
        <div class="input-group input-group-sm" style="width:auto">
            <span class="input-group-text bg-white">From</span><input type="date" name="from" value="@from.ToString("yyyy-MM-dd")" class="form-control" data-auto />
            <span class="input-group-text bg-white">To</span><input type="date" name="to" value="@to.ToString("yyyy-MM-dd")" class="form-control" data-auto />
        </div>
        <div class="btn-group btn-group-sm" role="group" aria-label="Document type">
            @foreach (var (val, text) in new[] { ("ALL", "All"), ("PURCHASE", "Purchases"), ("RETURN", "Debit notes") })
            {
                <input type="radio" class="btn-check" name="docType" id="dt@(val)" value="@val" @(docType == val ? "checked" : "") data-auto>
                <label class="btn btn-outline-primary" for="dt@(val)">@text</label>
            }
        </div>
        <div style="width:240px"><select name="supplierId" id="phSup" class="form-select form-select-sm">
            <option value="">All suppliers</option>
            @foreach (var s in suppliers) { <option value="@s.Value" selected="@(s.Value == supplierId?.ToString())">@s.Text</option> }
        </select></div>
        <div class="input-group input-group-sm" style="width:260px">
            <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
            <input type="search" name="search" value="@search" class="form-control" placeholder="Doc no, bill no, supplier, GSTIN" />
        </div>
        <button type="submit" class="btn btn-sm btn-primary"><i class="bi bi-funnel me-1"></i>Apply</button>
        <span class="small text-muted">@Model.Count document(s)</span>
        <button type="button" class="btn btn-sm btn-outline-success ms-auto" id="phExport"><i class="bi bi-file-earmark-excel me-1"></i>Excel</button>
    </form>

    @* totals at a glance *@
    <div class="row g-2 p-2">
        <div class="col-6 col-lg"><div class="pr-kpi"><div class="l">Purchases (@purchases.Count)</div><div class="v">₹@N(purchases.Sum(r => r.Net))</div><div class="s">taxable ₹@N(purchases.Sum(r => r.Taxable)) · GST ₹@N(purchases.Sum(r => r.Gst))</div></div></div>
        <div class="col-6 col-lg"><div class="pr-kpi"><div class="l">Debit notes (@returns.Count)</div><div class="v text-danger">₹@N(returns.Sum(r => r.Net))</div><div class="s">taxable ₹@N(returns.Sum(r => r.Taxable)) · GST ₹@N(returns.Sum(r => r.Gst))</div></div></div>
        <div class="col-6 col-lg"><div class="pr-kpi"><div class="l">Net purchase</div><div class="v text-primary">₹@N(Model.Sum(r => r.Net))</div><div class="s">discount ₹@N(purchases.Sum(r => r.Discount)) · other ₹@N(Model.Sum(r => r.Other))</div></div></div>
        <div class="col-6 col-lg"><div class="pr-kpi"><div class="l">Net input GST</div><div class="v text-success">₹@N(Model.Sum(r => r.Gst))</div><div class="s">CGST ₹@N(Model.Sum(r => r.Cgst)) · SGST ₹@N(Model.Sum(r => r.Sgst)) · IGST ₹@N(Model.Sum(r => r.Igst))</div></div></div>
    </div>
    @if (missingGstin.Count > 0)
    {
        <div class="alert alert-warning py-1 px-2 mx-2 mb-2 small"><i class="bi bi-exclamation-triangle me-1"></i>No GSTIN in Supplier Master for: <b>@string.Join(", ", missingGstin)</b> - their input GST cannot be matched with GSTR-2B until it is added.</div>
    }

    <div class="ph-wrap"><table class="table table-hover mb-0 ph-table" id="phTable">
        <thead><tr>
            <th>#</th><th>Type</th><th>Doc No</th><th>Doc Date</th><th>Supplier</th><th>GSTIN</th><th>State</th><th>Supply</th>
            <th>Supplier Bill No</th><th>Bill Date</th><th>Against GRN</th><th class="num">Lines</th><th class="num">Qty</th><th class="num">Free</th>
            <th class="num">Gross</th><th class="num">Discount</th><th class="num">Taxable</th><th class="num">CGST</th><th class="num">SGST</th><th class="num">IGST</th>
            <th class="num">Total GST</th><th class="num">Other</th><th class="num">Round Off</th><th class="num">Net</th>
        </tr></thead>
        <tbody>
        @for (var i = 0; i < Model.Count; i++)
        {
            var r = Model[i];
            var url = r.DocType == "Purchase" ? Url.Action("Form", "PhGrns", new { id = r.Id }) : Url.Action("Form", "PhPurchaseReturns", new { id = r.Id });
            <tr class="@(r.DocType != "Purchase" ? "dn" : "")" style="cursor:pointer" onclick="location.href='@url'">
                <td class="text-muted">@(i + 1)</td>
                <td>@if (r.DocType == "Purchase") { <span class="badge bg-success-subtle text-success border border-success-subtle">Purchase</span> } else { <span class="badge bg-danger-subtle text-danger border border-danger-subtle">Debit note</span> }</td>
                <td class="font-monospace">@r.DocNo</td><td>@D(r.DocDate)</td><td>@r.SupplierName</td>
                <td class="font-monospace">@(string.IsNullOrWhiteSpace(r.Gstin) ? "—" : r.Gstin)</td><td>@r.StateName</td>
                <td><span class="badge @(r.SupplyType == "Inter-state" ? "bg-info-subtle text-info-emphasis" : "bg-light text-secondary") border">@r.SupplyType</span></td>
                <td>@r.InvoiceNo</td><td>@D(r.InvoiceDate)</td><td class="font-monospace">@r.RefGrnNo</td>
                <td class="num">@r.Lines</td><td class="num">@r.Qty.ToString("0.###")</td><td class="num">@(r.FreeQty != 0 ? r.FreeQty.ToString("0.###") : "")</td>
                <td class="num">@N(r.Gross)</td><td class="num">@N(r.Discount)</td><td class="num fw-semibold">@N(r.Taxable)</td>
                <td class="num">@N(r.Cgst)</td><td class="num">@N(r.Sgst)</td><td class="num">@N(r.Igst)</td><td class="num">@N(r.Gst)</td>
                <td class="num">@N(r.Other)</td><td class="num">@N(r.RoundOff)</td><td class="num fw-bold">@N(r.Net)</td>
            </tr>
        }
        </tbody>
        @if (Model.Count > 0)
        {
            <tfoot class="fw-bold">
                @foreach (var (label, set, cls) in new[] { ("Purchases", purchases, "sub"), ("Debit notes", returns, "sub text-danger"), ("Net total", Model, "") })
                {
                    if (set.Count == 0 && label != "Net total") { continue; }
                    <tr class="@cls"><td colspan="11" class="text-end">@label (@set.Count)</td>
                        <td class="num">@set.Sum(r => r.Lines)</td><td class="num">@set.Sum(r => r.Qty).ToString("0.###")</td><td class="num">@set.Sum(r => r.FreeQty).ToString("0.###")</td>
                        <td class="num">@N(set.Sum(r => r.Gross))</td><td class="num">@N(set.Sum(r => r.Discount))</td><td class="num">@N(set.Sum(r => r.Taxable))</td>
                        <td class="num">@N(set.Sum(r => r.Cgst))</td><td class="num">@N(set.Sum(r => r.Sgst))</td><td class="num">@N(set.Sum(r => r.Igst))</td><td class="num">@N(set.Sum(r => r.Gst))</td>
                        <td class="num">@N(set.Sum(r => r.Other))</td><td class="num">@N(set.Sum(r => r.RoundOff))</td><td class="num">@N(set.Sum(r => r.Net))</td></tr>
                }
            </tfoot>
        }
    </table>
    @if (Model.Count == 0) { <div class="text-center text-muted py-5"><i class="bi bi-inbox fs-2 d-block mb-2"></i>No posted purchases or debit notes in this period.</div> }
    </div>
</div>

<div class="row g-3">
    <div class="col-12 col-xl-6">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-body py-2 border-bottom fw-bold small" style="color:var(--emr-primary,#644098)"><i class="bi bi-percent me-1"></i>GST rate-wise summary (input tax)</div>
            <div class="table-responsive"><table class="table table-sm mb-0 ph-table pr-sum" id="phGst">
                <thead><tr><th>GST rate</th><th class="text-end">Purchases</th><th class="text-end">Returns</th><th class="text-end">Net taxable</th><th class="text-end">CGST</th><th class="text-end">SGST</th><th class="text-end">IGST</th><th class="text-end">Total GST</th></tr></thead>
                <tbody>@foreach (var g in gst) { <tr><td>@g.GstPercent.ToString("0.##")%</td><td class="text-end">@N(g.PurchaseTaxable)</td><td class="text-end text-danger">@N(g.ReturnTaxable)</td><td class="text-end fw-semibold">@N(g.Taxable)</td><td class="text-end">@N(g.Cgst)</td><td class="text-end">@N(g.Sgst)</td><td class="text-end">@N(g.Igst)</td><td class="text-end fw-semibold">@N(g.Gst)</td></tr> }</tbody>
                <tfoot class="fw-bold"><tr><td>Total</td><td class="text-end">@N(gst.Sum(g => g.PurchaseTaxable))</td><td class="text-end">@N(gst.Sum(g => g.ReturnTaxable))</td><td class="text-end">@N(gst.Sum(g => g.Taxable))</td><td class="text-end">@N(gst.Sum(g => g.Cgst))</td><td class="text-end">@N(gst.Sum(g => g.Sgst))</td><td class="text-end">@N(gst.Sum(g => g.Igst))</td><td class="text-end">@N(gst.Sum(g => g.Gst))</td></tr></tfoot>
            </table></div>
        </div>
    </div>
    <div class="col-12 col-xl-6">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-body py-2 border-bottom fw-bold small" style="color:var(--emr-primary,#644098)"><i class="bi bi-truck me-1"></i>Supplier-wise summary</div>
            <div class="table-responsive"><table class="table table-sm mb-0 ph-table pr-sum" id="phSupSum">
                <thead><tr><th>Supplier</th><th>GSTIN</th><th class="text-end">Purchases</th><th class="text-end">Returns</th><th class="text-end">Taxable</th><th class="text-end">GST</th><th class="text-end">Net</th></tr></thead>
                <tbody>@foreach (var s in supSummary) { <tr><td>@s.SupplierName<div class="text-muted" style="font-size:.7rem">@s.StateName</div></td><td class="font-monospace">@(string.IsNullOrWhiteSpace(s.Gstin) ? "—" : s.Gstin)</td><td class="text-end">@N(s.PurchaseAmount)<div class="text-muted" style="font-size:.7rem">@s.Purchases GRN</div></td><td class="text-end text-danger">@N(s.ReturnAmount)<div class="text-muted" style="font-size:.7rem">@s.Returns DN</div></td><td class="text-end">@N(s.Taxable)</td><td class="text-end">@N(s.Gst)</td><td class="text-end fw-semibold">@N(s.Net)</td></tr> }</tbody>
                <tfoot class="fw-bold"><tr><td colspan="2">Total</td><td class="text-end">@N(supSummary.Sum(s => s.PurchaseAmount))</td><td class="text-end">@N(supSummary.Sum(s => s.ReturnAmount))</td><td class="text-end">@N(supSummary.Sum(s => s.Taxable))</td><td class="text-end">@N(supSummary.Sum(s => s.Gst))</td><td class="text-end">@N(supSummary.Sum(s => s.Net))</td></tr></tfoot>
            </table></div>
        </div>
    </div>
</div>

@section Scripts {
<script src="~/lib/tom-select/dist/js/tom-select.complete.min.js"></script>
<script src="~/lib/xlsx/xlsx.full.min.js"></script>
<script>
(function () {
    const form = document.querySelector('form');
    form.querySelectorAll('[data-auto]').forEach(i => i.addEventListener('change', () => form.submit()));
    new TomSelect('#phSup', { allowEmptyOption: true, onChange: () => form.submit() });
    document.getElementById('phExport').addEventListener('click', () => {
        const wb = XLSX.utils.book_new();
        XLSX.utils.book_append_sheet(wb, XLSX.utils.table_to_sheet(document.getElementById('phTable'), { raw: true }), 'Register');
        XLSX.utils.book_append_sheet(wb, XLSX.utils.table_to_sheet(document.getElementById('phGst'), { raw: true }), 'GST rate-wise');
        XLSX.utils.book_append_sheet(wb, XLSX.utils.table_to_sheet(document.getElementById('phSupSum'), { raw: true }), 'Supplier-wise');
        XLSX.writeFile(wb, 'Purchase_Register_@(from.ToString("yyyyMMdd"))_@(to.ToString("yyyyMMdd")).xlsx');
    });
})();
</script>
}
