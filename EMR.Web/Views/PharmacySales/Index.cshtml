@using EMR.Web.Services
@model List<PhSaleListRow>
@{
    // Pharmacy > Sales > Sale Bills (SQLScripts/2348)
    ViewData["Title"] = "Sale Bills";
    var (status, search, from, to) = ((string, string?, DateTime?, DateTime?))ViewBag.Filter;
    var posted = Model.Where(m => m.Status == "POSTED").ToList();
    var stats = new List<KeyValuePair<string, int>> { new("Bills", posted.Count), new("On credit", posted.Count(m => m.BalanceDue > 0)), new("Cancelled", Model.Count(m => m.Status == "CANCELLED")) };
    string Badge(string s) => s switch { "POSTED" => "<span class=\"badge bg-success-subtle text-success border border-success-subtle\">Saved</span>", "HOLD" => "<span class=\"badge bg-warning-subtle text-warning-emphasis border\">Held</span>", _ => "<span class=\"badge bg-light text-secondary border\">Cancelled</span>" };
}
<link rel="stylesheet" href="~/css/pharmacy-masters.css" asp-append-version="true" />
<partial name="_PharmacyMasterHeader" model="@(new PhHeader("Sale Bills", "bi-receipt", "Counter bills of this branch: open one to print, send it by WhatsApp / e-mail, take a return or cancel it (same day, before day closing).", null, null, Stats: stats, Section: "Pharmacy", Group: "Sales"))" />
<div class="card shadow-sm border-0">
    <form method="get" id="phFilter" class="card-body py-2 ph-toolbar border-bottom d-flex flex-wrap gap-2 align-items-center">
        <div class="input-group input-group-sm" style="max-width:320px"><span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
            <input name="search" id="phSearch" value="@search" class="form-control" placeholder="Bill no., customer, mobile, doctor..." autocomplete="off" /><span class="input-group-text bg-white"><span class="ph-kbd">/</span></span></div>
        <select name="status" class="form-select form-select-sm" style="width:auto" data-auto>
            @foreach (var (v, t) in new[] { ("POSTED", "Saved"), ("DUE", "Saved with balance due"), ("HOLD", "Held"), ("CANCELLED", "Cancelled"), ("ALL", "All") }) { <option value="@v" selected="@(v == status)">@t</option> }
        </select>
        <div class="input-group input-group-sm" style="width:auto"><span class="input-group-text bg-white">From</span><input type="date" name="from" value="@from?.ToString("yyyy-MM-dd")" class="form-control" data-auto /><span class="input-group-text bg-white">To</span><input type="date" name="to" value="@to?.ToString("yyyy-MM-dd")" class="form-control" data-auto /></div>
        <span class="small text-muted">@Model.Count shown · ₹ @posted.Sum(m => m.NetAmount).ToString("N2")</span>
        <div class="ms-auto d-flex gap-2"><button type="button" class="btn btn-sm btn-outline-success" id="phExport"><i class="bi bi-file-earmark-excel me-1"></i>Excel</button>
            <a asp-action="Pos" asp-permission="PHARMACY.POS:SAVE" class="btn btn-sm btn-primary"><i class="bi bi-upc-scan me-1"></i>New sale</a></div>
    </form>
    <div class="ph-wrap"><table class="table table-hover mb-0 ph-table ph-editable" id="phTable">
        <thead><tr><th>#</th><th>Bill no.</th><th>Date</th><th>Customer</th><th>Mobile</th><th>Doctor</th><th class="text-end">Items</th><th class="text-end">Net</th><th class="text-end">Paid</th><th class="text-end">Returned</th><th class="text-end">Due</th><th>By</th><th>Status</th></tr></thead>
        <tbody>
        @for (var i = 0; i < Model.Count; i++)
        {
            var r = Model[i];
            <tr class="@(r.Status == "CANCELLED" ? "inactive" : "")" data-href="@(r.Status == "HOLD" ? Url.Action("Pos", new { recall = r.SaleId }) : Url.Action("Bill", new { id = r.SaleId }))">
                <td class="text-muted small">@(i + 1)</td><td class="font-monospace small fw-semibold">@(r.SaleNo ?? "Held: " + r.HoldLabel)</td><td class="text-nowrap small">@r.SaleDate.ToString("dd-MMM HH:mm")</td>
                <td>@r.CustomerName</td><td>@r.Mobile</td><td class="small">@r.DoctorName</td><td class="text-end">@r.Lines</td><td class="text-end fw-semibold">@r.NetAmount.ToString("N2")</td>
                <td class="text-end">@r.PaidAmount.ToString("N2")</td><td class="text-end">@(r.ReturnedAmount > 0 ? r.ReturnedAmount.ToString("N2") : "—")</td>
                <td class="text-end @(r.BalanceDue > 0 ? "text-danger fw-semibold" : "")">@(r.BalanceDue > 0 ? r.BalanceDue.ToString("N2") : "—")</td><td class="small">@r.CreatedByName</td><td>@Html.Raw(Badge(r.Status))</td></tr>
        }
        </tbody></table>
        @if (Model.Count == 0) { <div class="text-center text-muted py-5"><i class="bi bi-inbox fs-2 d-block mb-2"></i>No bills in this period.</div> }
    </div>
</div>
@section Scripts {
<script src="~/lib/xlsx/xlsx.full.min.js"></script>
<script>
(function () {
    const form = document.getElementById('phFilter'), search = document.getElementById('phSearch');
    form.querySelectorAll('[data-auto]').forEach(s => s.addEventListener('change', () => form.submit()));
    let t; search.addEventListener('input', () => { clearTimeout(t); t = setTimeout(() => form.submit(), 450); });
    if (search.value) { search.focus(); search.setSelectionRange(search.value.length, search.value.length); }
    document.querySelectorAll('#phTable tr[data-href]').forEach(tr => tr.addEventListener('click', () => location.href = tr.dataset.href));
    document.addEventListener('keydown', e => { if (e.key === '/' && !/INPUT|TEXTAREA|SELECT/.test(document.activeElement.tagName)) { e.preventDefault(); search.focus(); } });
    document.getElementById('phExport').addEventListener('click', () => { const wb = XLSX.utils.book_new(); XLSX.utils.book_append_sheet(wb, XLSX.utils.table_to_sheet(document.getElementById('phTable'), { raw: true }), 'Bills'); XLSX.writeFile(wb, 'Pharmacy_Sale_Bills.xlsx'); });
})();
</script>
}
