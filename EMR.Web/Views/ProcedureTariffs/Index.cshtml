@model IEnumerable<EMR.Web.Models.ViewModels.ProcedureTariffListItemViewModel>
@{
    ViewData["Title"] = "Procedure Tariff Master";
    var list = Model?.ToList() ?? [];
    var tariffOptions = ViewBag.TariffCategoryOptions as List<SelectListItem> ?? [];
    var procOptions = ViewBag.ProcedureOptions as List<SelectListItem> ?? [];
    int? selectedTariff = ViewBag.SelectedTariffCategoryId;
    int? selectedProc = ViewBag.SelectedProcedureId;
}

<div class="container-fluid px-0">
    <!-- Header -->
    <div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-2">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                    <li class="breadcrumb-item">Master</li>
                    <li class="breadcrumb-item">IPD Master</li>
                    <li class="breadcrumb-item active" aria-current="page">Procedure Tariff Master</li>
                </ol>
            </nav>
            <h1 class="h3 mb-0 fw-bold text-dark">
                <i class="bi bi-cash-coin me-2 text-primary"></i>Procedure Tariff Master
                <span class="badge bg-primary-subtle text-primary border border-primary-subtle fs-6 ms-2">@list.Count</span>
            </h1>
        </div>
        <div class="d-flex gap-2">
            <a asp-controller="Procedures" asp-action="Index" class="btn btn-outline-primary">
                <i class="bi bi-heart-pulse me-1"></i>Procedure Master
            </a>
            <a asp-action="Create" class="btn btn-primary">
                <i class="bi bi-plus-lg me-1"></i>Add Tariff Rate
            </a>
        </div>
    </div>

    <!-- Filter Card -->
    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-body p-3">
            <form method="get" asp-action="Index" class="row g-2 align-items-end">
                <div class="col-md-5">
                    <label class="form-label small fw-semibold text-muted mb-1">Tariff Category</label>
                    <select name="tariffCategoryId" class="form-select form-select-sm" onchange="this.form.submit()">
                        <option value="">-- All Tariff Categories --</option>
                        @foreach (var opt in tariffOptions)
                        {
                            <option value="@opt.Value" selected="@(opt.Value == selectedTariff?.ToString())">@opt.Text</option>
                        }
                    </select>
                </div>
                <div class="col-md-5">
                    <label class="form-label small fw-semibold text-muted mb-1">Procedure</label>
                    <select name="procedureId" class="form-select form-select-sm" onchange="this.form.submit()">
                        <option value="">-- All Procedures --</option>
                        @foreach (var opt in procOptions)
                        {
                            <option value="@opt.Value" selected="@(opt.Value == selectedProc?.ToString())">@opt.Text</option>
                        }
                    </select>
                </div>
                <div class="col-md-2 d-flex gap-2">
                    <button type="submit" class="btn btn-sm btn-primary flex-grow-1">
                        <i class="bi bi-filter me-1"></i>Filter
                    </button>
                    @if (selectedTariff.HasValue || selectedProc.HasValue)
                    {
                        <a asp-action="Index" class="btn btn-sm btn-outline-secondary" title="Clear Filters">
                            <i class="bi bi-x-circle"></i>
                        </a>
                    }
                </div>
            </form>
        </div>
    </div>

    <!-- Data Table -->
    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Tariff Category</th>
                            <th>Procedure Details</th>
                            <th>Fee Breakdown</th>
                            <th>Total Tariff Rate</th>
                            <th>Effective Period</th>
                            <th>Status</th>
                            <th class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (list.Count == 0)
                        {
                            <tr>
                                <td colspan="7" class="text-center py-5 text-muted">
                                    <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                                    No procedure tariff rates configured yet.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in list)
                            {
                                <tr>
                                    <td class="ps-4">
                                        <div class="fw-bold">@item.TariffCategoryName</div>
                                        @if (!string.IsNullOrWhiteSpace(item.PatientCategory))
                                        {
                                            <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">
                                                @item.PatientCategory
                                            </span>
                                        }
                                    </td>
                                    <td>
                                        <div class="fw-semibold">@item.ProcedureName</div>
                                        <div class="small text-muted">
                                            <span class="font-monospace text-primary fw-bold">@item.ProcedureCode</span>
                                            <span class="mx-1">•</span>
                                            <span>@item.DepartmentName</span>
                                            <span class="mx-1">•</span>
                                            <span>@item.SpecialityName</span>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="small">
                                            <div><span class="text-muted">Surgeon:</span> @item.SurgeonFee.ToString("C0") | <span class="text-muted">Asst:</span> @item.AssistantFee.ToString("C0") | <span class="text-muted">Anaesth:</span> @item.AnaesthetistFee.ToString("C0")</div>
                                            <div><span class="text-muted">OT:</span> @item.OtCharges.ToString("C0") | <span class="text-muted">Equip:</span> @item.EquipmentCharges.ToString("C0") | <span class="text-muted">Consumables:</span> @item.ConsumableCharges.ToString("C0")</div>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="fs-5 fw-bold text-success font-monospace">@item.TotalRate.ToString("C2")</span>
                                    </td>
                                    <td>
                                        <div><i class="bi bi-calendar-event me-1 text-muted"></i>@item.EffectiveFrom.ToString("dd MMM yyyy")</div>
                                        <small class="text-muted">
                                            @(item.EffectiveTo.HasValue ? $"to {item.EffectiveTo.Value:dd MMM yyyy}" : "Ongoing")
                                        </small>
                                    </td>
                                    <td>
                                        @if (item.IsActive)
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle">Inactive</span>
                                        }
                                    </td>
                                    <td class="text-end pe-4">
                                        <div class="btn-group btn-group-sm">
                                            <a asp-action="Details" asp-route-id="@item.ProcedureTariffId" class="btn btn-outline-info" title="View Details">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            <a asp-action="Edit" asp-route-id="@item.ProcedureTariffId" class="btn btn-outline-primary" title="Edit">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <form asp-action="ToggleStatus" asp-route-id="@item.ProcedureTariffId" method="post" class="d-inline" onsubmit="return confirm('Toggle status for this tariff rate?');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-outline-warning" title="@(item.IsActive ? "Deactivate" : "Activate")">
                                                    <i class="bi @(item.IsActive ? "bi-slash-circle" : "bi-check-circle")"></i>
                                                </button>
                                            </form>
                                            <form asp-action="Delete" asp-route-id="@item.ProcedureTariffId" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to remove this procedure tariff configuration?');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-outline-danger" title="Delete">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
