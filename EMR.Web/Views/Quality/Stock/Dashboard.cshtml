@{ ViewData["Title"] = "Stock Dashboard"; }
@* Quality & Compliance > Stock Management > Stock Dashboard (SQLScripts/2498-2500). Logic: wwwroot/js/views/Quality/qc-stock-dashboard.js *@
@section HeadStyles { <link rel="stylesheet" href="~/css/views/Quality/qc-stock.css" asp-append-version="true" /> }
<div class="container-fluid px-4 py-3">
    <div class="d-flex justify-content-between align-items-start mb-3 flex-wrap gap-2">
        <div>
            <nav aria-label="breadcrumb"><ol class="breadcrumb mb-1">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                <li class="breadcrumb-item text-muted">Quality &amp; Compliance</li>
                <li class="breadcrumb-item active">Stock Management</li></ol></nav>
            <h4 class="fw-bold mb-0 text-primary"><i class="bi bi-speedometer2 me-2"></i>Lab Stock Dashboard</h4>
            <div class="qs-sub">Reagents, kits, controls and consumables of this branch - value, expiry, reorder and work waiting.</div>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            <button type="button" class="btn btn-outline-secondary" id="btnRefresh"><i class="bi bi-arrow-clockwise me-1"></i>Refresh</button>
            <button type="button" class="btn btn-outline-primary d-none" id="btnPostCons"><i class="bi bi-journal-check me-1"></i>Post consumption to accounts</button>
            <button type="button" class="btn btn-outline-secondary d-none" id="btnSettings"><i class="bi bi-gear me-1"></i>Settings</button>
        </div>
    </div>
    <div class="alert alert-info py-2 small d-none" id="dbStart"></div>
    <div class="row g-3 mb-3" id="dbTiles"></div>
    <div class="row g-3 mb-3" id="dbTasks"></div>
    <div class="row g-3">
        <div class="col-lg-6"><div class="card border-0 shadow-sm h-100"><div class="card-body">
            <div class="d-flex justify-content-between"><h6 class="fw-bold mb-2">Expired and expiring lots</h6><a class="small" href="/QcStockEnquiry/Index?filter=NEAR">All</a></div>
            <div class="table-responsive"><table class="table table-sm mb-0"><thead><tr><th>Item</th><th>Lot</th><th>Store</th><th>Expiry</th><th class="text-end">Qty</th><th class="text-end">Value</th></tr></thead><tbody id="dbExpiry"></tbody></table></div>
        </div></div></div>
        <div class="col-lg-6"><div class="card border-0 shadow-sm h-100"><div class="card-body">
            <div class="d-flex justify-content-between"><h6 class="fw-bold mb-2">At or below reorder level</h6><a class="small" href="/QcPurchaseOrders/Index">Raise a purchase order</a></div>
            <div class="table-responsive"><table class="table table-sm mb-0"><thead><tr><th>Item</th><th class="text-end">Usable stock</th><th class="text-end">Reorder level</th></tr></thead><tbody id="dbReorder"></tbody></table></div>
        </div></div></div>
        <div class="col-lg-7"><div class="card border-0 shadow-sm h-100"><div class="card-body">
            <h6 class="fw-bold mb-1">Consumption value, last 30 days</h6>
            <div class="small text-muted mb-1"><span class="badge" style="background:#0d6efd">&nbsp;</span> tests (BOM) <span class="badge ms-2" style="background:#f59f00">&nbsp;</span> QC / calibration use</div>
            <div class="qs-bars" id="dbBars"></div>
            <div class="d-flex justify-content-between small text-muted" id="dbBarsAxis"></div>
        </div></div></div>
        <div class="col-lg-5"><div class="card border-0 shadow-sm h-100"><div class="card-body">
            <h6 class="fw-bold mb-2">Stock value by store</h6>
            <div class="table-responsive"><table class="table table-sm mb-0"><thead><tr><th>Store</th><th class="text-end">Items</th><th class="text-end">Value</th></tr></thead><tbody id="dbStores"></tbody></table></div>
        </div></div></div>
    </div>
</div>

<div class="modal fade" id="setModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content">
    <div class="modal-header py-2"><h6 class="modal-title fw-bold">Stock settings (all branches of the company)</h6><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div>
    <div class="modal-body">
        <div class="form-check form-switch mb-2"><input class="form-check-input" type="checkbox" id="sPo" /><label class="form-check-label" for="sPo">Purchase orders need approval</label></div>
        <div class="form-check form-switch mb-2"><input class="form-check-input" type="checkbox" id="sAdj" /><label class="form-check-label" for="sAdj">Adjustments / write-offs need approval</label></div>
        <div class="form-check form-switch mb-2"><input class="form-check-input" type="checkbox" id="sCnt" /><label class="form-check-label" for="sCnt">Physical counts need approval</label></div>
        <div class="form-check form-switch mb-2"><input class="form-check-input" type="checkbox" id="sLot" /><label class="form-check-label" for="sLot">New reagent / kit / control lots wait in quarantine until accepted</label></div>
        <div class="form-check form-switch mb-3"><input class="form-check-input" type="checkbox" id="sDed" /><label class="form-check-label" for="sDed">Take test consumption (BOM) out of stock</label></div>
        <label class="form-label fw-semibold" for="sNear">Near-expiry warning (days)</label><input type="number" class="form-control" id="sNear" min="1" max="365" />
        <div class="form-text">The approver is never the person who raised the document.</div>
    </div>
    <div class="modal-footer py-2"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button><button type="button" class="btn btn-primary" id="sSave"><i class="bi bi-save me-1"></i>Save</button></div>
</div></div></div>

@section Scripts {
<script>window.QcStockDash = @Html.Raw(ViewBag.Config);</script>
<script src="~/js/qc-common.js" asp-append-version="true"></script>
<script src="~/js/views/Quality/qc-stock-dashboard.js" asp-append-version="true"></script>
}
