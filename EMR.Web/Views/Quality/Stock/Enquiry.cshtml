@{ ViewData["Title"] = "Stock Enquiry"; }
@* Quality & Compliance > Stock Management > Stock Enquiry (SQLScripts/2498-2500). Logic: wwwroot/js/views/Quality/qc-stock-enquiry.js *@
@section HeadStyles { <link rel="stylesheet" href="~/css/views/Quality/qc-stock.css" asp-append-version="true" /> }
<div class="container-fluid px-4 py-3">
    <div class="d-flex justify-content-between align-items-start mb-3 flex-wrap gap-2">
        <div>
            <nav aria-label="breadcrumb"><ol class="breadcrumb mb-1">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                <li class="breadcrumb-item text-muted">Quality &amp; Compliance</li>
                <li class="breadcrumb-item"><a asp-controller="QcStockDashboard" asp-action="Index">Stock Management</a></li>
                <li class="breadcrumb-item active">Stock Enquiry</li></ol></nav>
            <h4 class="fw-bold mb-0 text-primary"><i class="bi bi-search me-2"></i>Stock Enquiry</h4>
            <div class="qs-sub">What is in stock in this branch, by item or by lot - with expiry, quarantine, opened vials and every movement.</div>
        </div>
        <div class="btn-group" role="group" aria-label="View">
            <input type="radio" class="btn-check" name="eView" id="eViewItem" value="ITEM" checked /><label class="btn btn-outline-primary" for="eViewItem"><i class="bi bi-box me-1"></i>By item</label>
            <input type="radio" class="btn-check" name="eView" id="eViewLot" value="LOT" /><label class="btn btn-outline-primary" for="eViewLot"><i class="bi bi-upc me-1"></i>By lot</label>
        </div>
    </div>
    <div class="card border-0 shadow-sm mb-3"><div class="card-body p-3">
        <div class="row g-2 align-items-end">
            <div class="col-md-3"><label class="form-label small fw-semibold text-muted" for="eStore">Store</label><select id="eStore" class="form-select"></select></div>
            <div class="col-md-2"><label class="form-label small fw-semibold text-muted" for="eFilter">Show</label>
                <select id="eFilter" class="form-select">
                    <option value="INSTOCK">In stock</option><option value="LOW">Below reorder level</option><option value="NEAR">Expiring soon</option>
                    <option value="EXPIRED">Expired</option><option value="QUARANTINE">Quarantine / blocked / rejected</option><option value="OPENED">Opened vials</option><option value="ALL">All items</option>
                </select></div>
            <div class="col-md-2"><label class="form-label small fw-semibold text-muted" for="eCategory">Category</label><select id="eCategory" class="form-select"></select></div>
            <div class="col-md-3"><label class="form-label small fw-semibold text-muted" for="eSearch">Search</label><input id="eSearch" class="form-control" placeholder="Item, code or lot..." /></div>
            <div class="col-md-2"><button type="button" class="btn btn-secondary w-100" id="eGo"><i class="bi bi-funnel me-1"></i>Show</button></div>
        </div>
    </div></div>
    <div class="card border-0 shadow-sm"><div class="card-body p-0"><div class="table-responsive">
        <table class="table table-hover align-middle mb-0"><thead class="bg-light"><tr id="eHead"></tr></thead><tbody id="eRows"></tbody><tfoot id="eFoot"></tfoot></table>
    </div></div></div>
</div>

<div class="modal fade" id="ledModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-xl modal-dialog-scrollable"><div class="modal-content">
    <div class="modal-header py-2"><h6 class="modal-title fw-bold" id="ledTitle">Stock ledger</h6><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div>
    <div class="modal-body">
        <div class="row g-2 align-items-end mb-2">
            <div class="col-md-3"><label class="form-label small fw-semibold" for="ledFrom">From</label><input type="date" id="ledFrom" class="form-control" /></div>
            <div class="col-md-3"><label class="form-label small fw-semibold" for="ledTo">To</label><input type="date" id="ledTo" class="form-control" /></div>
            <div class="col-md-2"><button type="button" class="btn btn-secondary w-100" id="ledGo">Show</button></div>
        </div>
        <div class="table-responsive qs-scroll"><table class="table table-sm small mb-0"><thead class="sticky-top bg-white"><tr><th>When</th><th>Movement</th><th>Document</th><th>Store</th><th>Lot</th>
            <th class="text-end">In</th><th class="text-end">Out</th><th class="text-end">Balance</th><th class="text-end">Unit cost</th><th>By</th></tr></thead><tbody id="ledRows"></tbody></table></div>
    </div>
</div></div></div>

@section Scripts {
<script>window.QcStockEnq = @Html.Raw(ViewBag.Config);</script>
<script src="~/js/qc-common.js" asp-append-version="true"></script>
<script src="~/js/views/Quality/qc-stock-enquiry.js" asp-append-version="true"></script>
}
