@{ ViewData["Title"] = "Lot Acceptance"; }
@* Quality & Compliance > Stock Management > Lot Acceptance (SQLScripts/2498-2500): new reagent / kit / control lots wait in
   quarantine until a lot-to-lot verification is recorded (ISO 15189 6.6.3); accepted lots can be blocked (recall, hold). *@
@section HeadStyles { <link rel="stylesheet" href="~/css/views/Quality/qc-stock.css" asp-append-version="true" /> }
<div class="container-fluid px-4 py-3">
    <div class="mb-3">
        <nav aria-label="breadcrumb"><ol class="breadcrumb mb-1">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
            <li class="breadcrumb-item text-muted">Quality &amp; Compliance</li>
            <li class="breadcrumb-item"><a asp-controller="QcStockDashboard" asp-action="Index">Stock Management</a></li>
            <li class="breadcrumb-item active">Lot Acceptance</li></ol></nav>
        <h4 class="fw-bold mb-0 text-primary"><i class="bi bi-patch-check me-2"></i>Lot Acceptance</h4>
        <div class="qs-sub">A new lot of a reagent, kit or control cannot be issued or used by tests until it is accepted with its verification result.</div>
    </div>
    <ul class="nav nav-pills mb-2" id="lTabs">
        <li class="nav-item"><a href="#" class="nav-link active" data-st="QUARANTINE">In quarantine</a></li>
        <li class="nav-item"><a href="#" class="nav-link" data-st="BLOCKED">Blocked</a></li>
        <li class="nav-item"><a href="#" class="nav-link" data-st="REJECTED">Rejected</a></li>
        <li class="nav-item"><a href="#" class="nav-link" data-st="ACCEPTED">Accepted</a></li>
        <li class="nav-item"><a href="#" class="nav-link" data-st="">All</a></li>
    </ul>
    <div class="card border-0 shadow-sm mb-3"><div class="card-body p-3"><div class="row g-2 align-items-end">
        <div class="col-md-6"><label class="form-label small fw-semibold text-muted" for="lSearch">Search</label><input id="lSearch" class="form-control" placeholder="Lot no, item or code..." /></div>
        <div class="col-md-2"><button type="button" class="btn btn-secondary w-100" id="lGo"><i class="bi bi-funnel me-1"></i>Show</button></div>
    </div></div></div>
    <div class="card border-0 shadow-sm"><div class="card-body p-0"><div class="table-responsive">
        <table class="table table-hover align-middle mb-0"><thead class="bg-light"><tr>
            <th class="ps-3">Item</th><th>Lot</th><th>Expiry</th><th>Supplier / received</th><th class="text-end">In this branch</th><th>Previous accepted lot</th><th>Status</th><th>Decision</th><th class="text-end pe-3"></th>
        </tr></thead><tbody id="lRows"></tbody></table>
    </div></div></div>
</div>
@section Scripts {
<script>window.QcStockLots = @Html.Raw(ViewBag.Config);</script>
<script src="~/js/qc-common.js" asp-append-version="true"></script>
<script src="~/js/views/Quality/qc-stock-lots.js" asp-append-version="true"></script>
}
