@{ ViewData["Title"] = "Pending Consumption"; }
@* Quality & Compliance > Stock Management > Pending Consumption (SQLScripts/2498-2500): test runs whose BOM could not be taken
   out of stock (the store was short); the result was never stopped. Retry once stock arrives, or skip with a reason. *@
@section HeadStyles { <link rel="stylesheet" href="~/css/views/Quality/qc-stock.css" asp-append-version="true" /> }
<div class="container-fluid px-4 py-3">
    <div class="d-flex justify-content-between align-items-start mb-3 flex-wrap gap-2">
        <div>
            <nav aria-label="breadcrumb"><ol class="breadcrumb mb-1">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                <li class="breadcrumb-item text-muted">Quality &amp; Compliance</li>
                <li class="breadcrumb-item"><a asp-controller="QcStockDashboard" asp-action="Index">Stock Management</a></li>
                <li class="breadcrumb-item active">Pending Consumption</li></ol></nav>
            <h4 class="fw-bold mb-0 text-primary"><i class="bi bi-hourglass-split me-2"></i>Pending Consumption</h4>
            <div class="qs-sub">Tests were reported while the store was short of a reagent. Receive or issue the stock, then take these lines out of stock.</div>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            <button type="button" class="btn btn-primary d-none" id="pRetry"><i class="bi bi-arrow-repeat me-1"></i>Take selected out of stock</button>
            <button type="button" class="btn btn-outline-danger d-none" id="pSkip"><i class="bi bi-slash-circle me-1"></i>Skip selected</button>
        </div>
    </div>
    <div class="card border-0 shadow-sm mb-3"><div class="card-body p-3"><div class="row g-2 align-items-end">
        <div class="col-md-3"><label class="form-label small fw-semibold text-muted" for="pStatus">Show</label>
            <select id="pStatus" class="form-select"><option value="PENDING">Pending</option><option value="SKIPPED">Skipped</option><option value="NOT_TRACKED">Store not tracked</option><option value="POSTED">Taken out of stock</option></select></div>
        <div class="col-md-2"><label class="form-label small fw-semibold text-muted" for="pFrom">From</label><input type="date" id="pFrom" class="form-control" /></div>
        <div class="col-md-2"><label class="form-label small fw-semibold text-muted" for="pTo">To</label><input type="date" id="pTo" class="form-control" /></div>
        <div class="col-md-2"><button type="button" class="btn btn-secondary w-100" id="pGo"><i class="bi bi-funnel me-1"></i>Show</button></div>
    </div></div></div>
    <div class="card border-0 shadow-sm"><div class="card-body p-0"><div class="table-responsive">
        <table class="table table-hover align-middle mb-0"><thead class="bg-light"><tr>
            <th class="ps-3"><input type="checkbox" class="form-check-input" id="pAll" aria-label="Select all" /></th><th>Reported</th><th>Bill</th><th>Test</th><th>Item</th>
            <th class="text-end">Needed</th><th>Store</th><th class="text-end">Usable now</th><th>Note</th>
        </tr></thead><tbody id="pRows"></tbody></table>
    </div></div></div>
</div>
@section Scripts {
<script>window.QcStockPending = @Html.Raw(ViewBag.Config);</script>
<script src="~/js/qc-common.js" asp-append-version="true"></script>
<script src="~/js/views/Quality/qc-stock-pending.js" asp-append-version="true"></script>
}
