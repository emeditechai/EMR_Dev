@{ ViewData["Title"] = "Stock Reports"; }
@* Quality & Compliance > Stock Management > Stock Reports (SQLScripts/2498-2500). Logic: wwwroot/js/views/Quality/qc-stock-reports.js *@
@section HeadStyles { <link rel="stylesheet" href="~/css/views/Quality/qc-stock.css" asp-append-version="true" /> }
<div class="container-fluid px-4 py-3">
    <div class="d-flex justify-content-between align-items-start mb-3 flex-wrap gap-2">
        <div>
            <nav aria-label="breadcrumb"><ol class="breadcrumb mb-1">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                <li class="breadcrumb-item text-muted">Quality &amp; Compliance</li>
                <li class="breadcrumb-item"><a asp-controller="QcStockDashboard" asp-action="Index">Stock Management</a></li>
                <li class="breadcrumb-item active">Stock Reports</li></ol></nav>
            <h4 class="fw-bold mb-0 text-primary"><i class="bi bi-bar-chart-line me-2"></i>Stock Reports</h4>
            <div class="qs-sub">Lab stock of this branch: valuation, movement, expiry, purchases, issues, write-offs, consumption and lot traceability.</div>
        </div>
        <button type="button" class="btn btn-success d-none" id="rExport"><i class="bi bi-file-earmark-excel me-1"></i>Export to Excel</button>
    </div>
    <div class="card border-0 shadow-sm mb-3"><div class="card-body p-3"><div class="row g-2 align-items-end" id="rFilters">
        <div class="col-md-4"><label class="form-label small fw-semibold text-muted" for="rReport">Report</label><select id="rReport" class="form-select"></select></div>
        <div class="col-md-2 rf rf-dates"><label class="form-label small fw-semibold text-muted" for="rFrom">From</label><input type="date" id="rFrom" class="form-control" /></div>
        <div class="col-md-2 rf rf-dates rf-asOn"><label class="form-label small fw-semibold text-muted" for="rTo" id="rToLabel">To</label><input type="date" id="rTo" class="form-control" /></div>
        <div class="col-md-2 rf rf-days"><label class="form-label small fw-semibold text-muted" for="rDays">Days</label><input type="number" id="rDays" class="form-control" min="1" max="3650" placeholder="default" /></div>
        <div class="col-md-2 rf rf-store"><label class="form-label small fw-semibold text-muted" for="rStore">Store</label><select id="rStore" class="form-select"></select></div>
        <div class="col-md-3 rf rf-item"><label class="form-label small fw-semibold text-muted" for="rItem">Item</label><select id="rItem" class="form-select"></select></div>
        <div class="col-md-3 rf rf-supplier"><label class="form-label small fw-semibold text-muted" for="rSupplier">Supplier</label><select id="rSupplier" class="form-select"></select></div>
        <div class="col-md-2 rf rf-category"><label class="form-label small fw-semibold text-muted" for="rCategory">Category</label><select id="rCategory" class="form-select"></select></div>
        <div class="col-md-2 rf rf-lot"><label class="form-label small fw-semibold text-muted" for="rLot">Lot no</label><input id="rLot" class="form-control" /></div>
        <div class="col-md-2"><button type="button" class="btn btn-primary w-100" id="rGo"><i class="bi bi-play-fill me-1"></i>Run</button></div>
    </div></div></div>
    <div class="card border-0 shadow-sm"><div class="card-body p-0">
        <div class="px-3 pt-2 small text-muted" id="rInfo"></div>
        <div class="table-responsive qs-scroll"><table class="table table-sm table-hover mb-0"><thead class="bg-light sticky-top"><tr id="rHead"></tr></thead><tbody id="rRows"></tbody><tfoot id="rFoot"></tfoot></table></div>
    </div></div>
</div>
@section Scripts {
<script>window.QcStockRpt = @Html.Raw(ViewBag.Config);</script>
<script src="~/js/qc-common.js" asp-append-version="true"></script>
<script src="~/js/views/Quality/qc-stock-reports.js" asp-append-version="true"></script>
}
