@{
    ViewData["Title"] = "Store / Location";
    var lookupsJson = System.Text.Json.JsonSerializer.Serialize(ViewBag.Lookups);
}
@* Quality & Compliance > Masters > Store / Location (SQLScripts/2247): one Main Store per branch (created for every branch),
   optional bench stores per LAB department. Every stock quantity belongs to one store. *@
<div class="container-fluid px-4 py-3">
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <div>
            <nav aria-label="breadcrumb"><ol class="breadcrumb mb-1">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                <li class="breadcrumb-item text-muted">Quality &amp; Compliance</li>
                <li class="breadcrumb-item active">Store / Location</li></ol></nav>
            <h4 class="fw-bold mb-0 text-primary"><i class="bi bi-building me-2"></i>Store / Location</h4>
            <div class="text-muted small">A Main Store per branch, and optional bench stores per LAB department</div>
        </div>
        <button type="button" class="btn btn-primary px-3 shadow-sm" id="btnAdd" asp-permission="QC.MASTER.STORES:ADD"><i class="bi bi-plus-lg me-1"></i>Add Store</button>
    </div>
    <div class="card border-0 shadow-sm mb-3"><div class="card-body p-3"><div class="row g-2 align-items-end">
        <div class="col-md-4"><label class="form-label small fw-semibold text-muted">Branch</label><select id="fBranch" class="form-select"></select></div>
        <div class="col-md-4"><label class="form-label small fw-semibold text-muted">Search</label><input type="text" id="fSearch" class="form-control" placeholder="Store name or code..." /></div>
        <div class="col-md-2"><label class="form-label small fw-semibold text-muted">Status</label><select id="fStatus" class="form-select"><option value="">All</option><option value="true" selected>Active</option><option value="false">Inactive</option></select></div>
        <div class="col-md-2"><button type="button" class="btn btn-secondary w-100" id="btnFilter"><i class="bi bi-funnel me-1"></i>Filter</button></div>
    </div></div></div>
    <div class="card border-0 shadow-sm"><div class="card-body p-0"><div class="table-responsive">
        <table class="table table-hover align-middle mb-0"><thead class="bg-light"><tr>
            <th class="ps-3">Code</th><th>Store</th><th>Type</th><th>Branch</th><th>Department</th><th class="text-center">Status</th><th class="text-end pe-3">Actions</th></tr></thead>
            <tbody id="rows"><tr><td colspan="7" class="text-center text-muted py-4">Loading...</td></tr></tbody></table>
    </div></div></div>
</div>

<div class="modal fade" id="stModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content">
    <div class="modal-header py-2"><h6 class="modal-title fw-bold" id="stTitle">Store</h6><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
    <div class="modal-body"><form id="stForm" autocomplete="off"><input type="hidden" name="StoreId" data-type="number" />
        <div class="row g-3">
            <div class="col-12"><label class="form-label fw-semibold">Store name <span class="text-danger">*</span></label><input name="StoreName" class="form-control" maxlength="150" /></div>
            <div class="col-md-6"><label class="form-label fw-semibold">Branch <span class="text-danger">*</span></label><select name="BranchId" data-type="number" class="form-select" id="stBranch"></select></div>
            <div class="col-md-6"><label class="form-label fw-semibold">Type <span class="text-danger">*</span></label>
                <select name="StoreType" class="form-select" id="stType"><option value="Bench">Bench store</option><option value="Main">Main store</option></select></div>
            <div class="col-12" id="stDeptBox"><label class="form-label fw-semibold">LAB department <span class="text-danger">*</span></label><select name="DepartmentId" data-type="number" class="form-select" id="stDept"></select></div>
            <div class="col-12 form-check form-switch ms-2"><input class="form-check-input" type="checkbox" name="Status" id="stStatus" /><label class="form-check-label" for="stStatus">Active</label></div>
            <div class="col-12"><label class="form-label fw-semibold">Remarks</label><textarea name="Remarks" class="form-control" rows="2" maxlength="500"></textarea></div>
        </div></form></div>
    <div class="modal-footer py-2"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button><button type="button" class="btn btn-primary" id="btnSave"><i class="bi bi-save me-1"></i>Save Store</button></div>
</div></div></div>

@section Scripts {
<script src="~/js/qc-common.js" asp-append-version="true"></script>
<script>
(function () {
    const L = @Html.Raw(lookupsJson);
    const canEdit = !!document.getElementById('btnAdd');
    const modal = new bootstrap.Modal(document.getElementById('stModal')), form = document.getElementById('stForm');
    let rows = [];
    document.getElementById('fBranch').innerHTML = QC.options(L.branches, '', 'All branches');
    document.getElementById('stBranch').innerHTML = QC.options(L.branches, '', '-- Branch --');
    document.getElementById('stDept').innerHTML = QC.options(L.departments, '', '-- Department --');
    const syncType = () => document.getElementById('stDeptBox').classList.toggle('d-none', document.getElementById('stType').value !== 'Bench');
    document.getElementById('stType').addEventListener('change', syncType);
    async function load() {
        const r = await QC.get('@Url.Action("List", "QcStores")', { branchId: document.getElementById('fBranch').value, search: document.getElementById('fSearch').value, status: document.getElementById('fStatus').value });
        const tb = document.getElementById('rows');
        if (!r.success) { tb.innerHTML = `<tr><td colspan="7" class="text-danger text-center py-4">${QC.esc(r.message)}</td></tr>`; return; }
        rows = r.data || [];
        tb.innerHTML = rows.length ? rows.map(s => `<tr>
            <td class="ps-3 font-monospace small">${QC.esc(s.StoreCode)}</td><td class="fw-semibold">${QC.esc(s.StoreName)}</td>
            <td>${s.StoreType === 'Main' ? '<span class="badge bg-primary-subtle text-primary border">Main</span>' : '<span class="badge bg-info-subtle text-info-emphasis border">Bench</span>'}</td>
            <td>${QC.esc(s.BranchName || '')}</td><td>${QC.esc(s.DepartmentName || '—')}</td>
            <td class="text-center">${canEdit && s.StoreType !== 'Main' ? `<a href="#" class="text-decoration-none act-status" data-id="${s.StoreId}" data-on="${s.Status ? 1 : 0}">${QC.statusBadge(s.Status)}</a>` : QC.statusBadge(s.Status)}</td>
            <td class="text-end pe-3 text-nowrap">${canEdit ? `<button class="btn btn-sm btn-outline-primary act-edit" data-id="${s.StoreId}"><i class="bi bi-pencil"></i></button>` : ''}
                ${canEdit && s.StoreType !== 'Main' ? `<button class="btn btn-sm btn-outline-danger act-del" data-id="${s.StoreId}"><i class="bi bi-trash"></i></button>` : ''}</td></tr>`).join('')
            : '<tr><td colspan="7" class="text-center text-muted py-4">No stores.</td></tr>';
    }
    function open(row) { form.reset(); QC.fill(form, row || { Status: true, StoreType: 'Bench' }); syncType(); document.getElementById('stTitle').textContent = row ? `Edit store ${row.StoreCode}` : 'Add store'; modal.show(); }
    document.getElementById('btnAdd')?.addEventListener('click', () => open(null));
    document.getElementById('btnFilter').addEventListener('click', load);
    document.getElementById('btnSave').addEventListener('click', async function () {
        const body = QC.formData(form);
        if (body.StoreType === 'Main') body.DepartmentId = null;
        this.disabled = true; const r = await QC.post('@Url.Action("Save", "QcStores")', body); this.disabled = false;
        if (!r.success) return QC.fail(r.message);
        modal.hide(); QC.ok('Store saved'); load();
    });
    document.getElementById('rows').addEventListener('click', async function (e) {
        const ed = e.target.closest('.act-edit'), del = e.target.closest('.act-del'), st = e.target.closest('.act-status');
        if (ed) open(rows.find(x => x.StoreId === +ed.dataset.id));
        if (st) { e.preventDefault(); const r = await QC.post('@Url.Action("SetStatus", "QcStores")', { id: +st.dataset.id, status: st.dataset.on !== '1' }); if (!r.success) return QC.fail(r.message); load(); }
        if (del && await QC.confirm('Delete this store?', '', 'Delete')) { const r = await QC.post('@Url.Action("Delete", "QcStores")', { id: +del.dataset.id }); if (!r.success) return QC.fail(r.message); QC.ok('Store deleted'); load(); }
    });
    load();
})();
</script>
}
