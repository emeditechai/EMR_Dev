@{
    ViewData["Title"] = "Supplier Master";
}
@* Quality & Compliance > Masters > Supplier Master (SQLScripts/2247): GSTIN / PAN checked, approved-supplier list (ISO 15189 6.8). *@
<div class="container-fluid px-4 py-3">
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <div>
            <nav aria-label="breadcrumb"><ol class="breadcrumb mb-1">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                <li class="breadcrumb-item text-muted">Quality &amp; Compliance</li>
                <li class="breadcrumb-item active">Supplier Master</li></ol></nav>
            <h4 class="fw-bold mb-0 text-primary"><i class="bi bi-truck me-2"></i>Supplier Master</h4>
            <div class="text-muted small">Vendors of reagents and consumables; approved suppliers are the lab's approved list</div>
        </div>
        <button type="button" class="btn btn-primary px-3 shadow-sm" id="btnAdd" asp-permission="QC.MASTER.SUPPLIERS:ADD"><i class="bi bi-plus-lg me-1"></i>Add Supplier</button>
    </div>
    <div class="card border-0 shadow-sm mb-3"><div class="card-body p-3"><div class="row g-2 align-items-end">
        <div class="col-md-5"><label class="form-label small fw-semibold text-muted">Search</label><input type="text" id="fSearch" class="form-control" placeholder="Name, code, GSTIN or phone..." /></div>
        <div class="col-md-2"><label class="form-label small fw-semibold text-muted">Approved</label><select id="fApproved" class="form-select"><option value="">All</option><option value="true">Approved</option><option value="false">Not approved</option></select></div>
        <div class="col-md-3"><label class="form-label small fw-semibold text-muted">Status</label><select id="fStatus" class="form-select"><option value="">All</option><option value="true" selected>Active</option><option value="false">Inactive</option></select></div>
        <div class="col-md-2"><button type="button" class="btn btn-secondary w-100" id="btnFilter"><i class="bi bi-funnel me-1"></i>Filter</button></div>
    </div></div></div>
    <div class="card border-0 shadow-sm"><div class="card-body p-0"><div class="table-responsive">
        <table class="table table-hover align-middle mb-0"><thead class="bg-light"><tr>
            <th class="ps-3">Code</th><th>Supplier</th><th>Contact</th><th>GSTIN / PAN</th><th class="text-center">Terms</th><th class="text-center">Approved</th><th class="text-center">Status</th><th class="text-end pe-3">Actions</th></tr></thead>
            <tbody id="rows"><tr><td colspan="8" class="text-center text-muted py-4">Loading...</td></tr></tbody></table>
    </div></div></div>
</div>

<div class="modal fade" id="supModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-lg modal-dialog-centered"><div class="modal-content">
    <div class="modal-header py-2"><h6 class="modal-title fw-bold" id="supTitle">Supplier</h6><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
    <div class="modal-body"><form id="supForm" autocomplete="off"><input type="hidden" name="SupplierId" data-type="number" />
        <div class="row g-3">
            <div class="col-md-8"><label class="form-label fw-semibold">Supplier name <span class="text-danger">*</span></label><input name="SupplierName" class="form-control" maxlength="200" /></div>
            <div class="col-md-4"><label class="form-label fw-semibold">Contact person</label><input name="ContactPerson" class="form-control" maxlength="150" /></div>
            <div class="col-md-4"><label class="form-label fw-semibold">Mobile</label><input name="Phone" class="form-control" maxlength="10" inputmode="numeric" placeholder="10 digits" /></div>
            <div class="col-md-4"><label class="form-label fw-semibold">E-mail</label><input name="Email" type="email" class="form-control" maxlength="150" /></div>
            <div class="col-md-4"><label class="form-label fw-semibold">Payment terms (days)</label><input name="PaymentTermsDays" data-type="number" type="number" min="0" max="365" class="form-control" /></div>
            <div class="col-md-6"><label class="form-label fw-semibold">GSTIN</label><input name="Gstin" class="form-control text-uppercase" maxlength="15" placeholder="e.g. 19ABCDE1234F1Z5" /></div>
            <div class="col-md-6"><label class="form-label fw-semibold">PAN</label><input name="Pan" class="form-control text-uppercase" maxlength="10" placeholder="e.g. ABCDE1234F" /></div>
            <div class="col-12"><label class="form-label fw-semibold">Address</label><textarea name="Address" class="form-control" rows="2" maxlength="500"></textarea></div>
            <div class="col-md-6 form-check form-switch ms-2"><input class="form-check-input" type="checkbox" name="IsApproved" id="supApproved" /><label class="form-check-label" for="supApproved">Approved supplier</label></div>
            <div class="col-md-5 form-check form-switch"><input class="form-check-input" type="checkbox" name="Status" id="supStatus" /><label class="form-check-label" for="supStatus">Active</label></div>
            <div class="col-12"><label class="form-label fw-semibold">Remarks</label><textarea name="Remarks" class="form-control" rows="2" maxlength="500"></textarea></div>
        </div></form></div>
    <div class="modal-footer py-2"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button><button type="button" class="btn btn-primary" id="btnSave"><i class="bi bi-save me-1"></i>Save Supplier</button></div>
</div></div></div>

@section Scripts {
<script src="~/js/qc-common.js" asp-append-version="true"></script>
<script>
(function () {
    const canEdit = !!document.getElementById('btnAdd');
    const modal = new bootstrap.Modal(document.getElementById('supModal')), form = document.getElementById('supForm');
    let rows = [];
    async function load() {
        const r = await QC.get('@Url.Action("List", "QcSuppliers")', { search: document.getElementById('fSearch').value, approved: document.getElementById('fApproved').value, status: document.getElementById('fStatus').value });
        const tb = document.getElementById('rows');
        if (!r.success) { tb.innerHTML = `<tr><td colspan="8" class="text-danger text-center py-4">${QC.esc(r.message)}</td></tr>`; return; }
        rows = r.data || [];
        tb.innerHTML = rows.length ? rows.map(s => `<tr>
            <td class="ps-3 font-monospace small">${QC.esc(s.SupplierCode)}</td>
            <td><div class="fw-semibold">${QC.esc(s.SupplierName)}</div><div class="text-muted small">${QC.esc(s.Address || '')}</div></td>
            <td class="small">${QC.esc(s.ContactPerson || '')}<div>${QC.esc(s.Phone || '')}${s.Email ? ' · ' + QC.esc(s.Email) : ''}</div></td>
            <td class="small font-monospace">${QC.esc(s.Gstin || '—')}<div>${QC.esc(s.Pan || '')}</div></td>
            <td class="text-center">${s.PaymentTermsDays != null ? s.PaymentTermsDays + ' days' : '—'}</td>
            <td class="text-center">${s.IsApproved ? `<span class="badge bg-success-subtle text-success border" title="${QC.esc((s.ApprovedByName || '') + ' ' + QC.date(s.ApprovedOn))}"><i class="bi bi-patch-check me-1"></i>Approved</span>` : '<span class="badge bg-light text-muted border">No</span>'}</td>
            <td class="text-center">${canEdit ? `<a href="#" class="text-decoration-none act-status" data-id="${s.SupplierId}" data-on="${s.Status ? 1 : 0}">${QC.statusBadge(s.Status)}</a>` : QC.statusBadge(s.Status)}</td>
            <td class="text-end pe-3 text-nowrap">${canEdit ? `<button class="btn btn-sm btn-outline-primary act-edit" data-id="${s.SupplierId}"><i class="bi bi-pencil"></i></button>
                <button class="btn btn-sm btn-outline-danger act-del" data-id="${s.SupplierId}"><i class="bi bi-trash"></i></button>` : ''}</td></tr>`).join('')
            : '<tr><td colspan="8" class="text-center text-muted py-4">No suppliers yet.</td></tr>';
    }
    function open(row) { form.reset(); QC.fill(form, row || { Status: true }); document.getElementById('supTitle').textContent = row ? `Edit supplier ${row.SupplierCode}` : 'Add supplier'; modal.show(); }
    document.getElementById('btnAdd')?.addEventListener('click', () => open(null));
    document.getElementById('btnFilter').addEventListener('click', load);
    document.getElementById('fSearch').addEventListener('keydown', e => { if (e.key === 'Enter') load(); });
    document.getElementById('btnSave').addEventListener('click', async function () {
        const body = QC.formData(form);
        if (!body.SupplierName) return QC.fail('Supplier name is required.');
        if (body.Gstin) body.Gstin = body.Gstin.toUpperCase();
        if (body.Pan) body.Pan = body.Pan.toUpperCase();
        this.disabled = true; const r = await QC.post('@Url.Action("Save", "QcSuppliers")', body); this.disabled = false;
        if (!r.success) return QC.fail(r.message);
        modal.hide(); QC.ok('Supplier saved'); load();
    });
    document.getElementById('rows').addEventListener('click', async function (e) {
        const ed = e.target.closest('.act-edit'), del = e.target.closest('.act-del'), st = e.target.closest('.act-status');
        if (ed) open(rows.find(x => x.SupplierId === +ed.dataset.id));
        if (st) { e.preventDefault(); const r = await QC.post('@Url.Action("SetStatus", "QcSuppliers")', { id: +st.dataset.id, status: st.dataset.on !== '1' }); if (!r.success) return QC.fail(r.message); load(); }
        if (del && await QC.confirm('Delete this supplier?', '', 'Delete')) { const r = await QC.post('@Url.Action("Delete", "QcSuppliers")', { id: +del.dataset.id }); if (!r.success) return QC.fail(r.message); QC.ok('Supplier deleted'); load(); }
    });
    load();
})();
</script>
}
