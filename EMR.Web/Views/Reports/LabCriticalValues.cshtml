@{
    ViewData["Title"] = "Critical & Panic Value Register";
    bool commOn = ViewBag.CriticalCommEnabled as bool? ?? false;   // Hospital Settings > LAB > Critical Value Communication Required
    ViewData["ReportSubtitle"] = commOn
        ? "results beyond a critical or panic threshold and who was informed: not yet informed first (NABL / NABH quality indicator)"
        : "results beyond a critical or panic threshold, not yet approved first (NABL / NABH quality indicator)";
    ViewData["ReportIcon"] = "bi-exclamation-octagon";
    ViewData["ReportAccent"] = "#b91c1c";
    ViewData["DateLabel"] = "result entry date";
    bool canRecord = ViewBag.CanRecordCritical as bool? ?? false;
}
<partial name="_LabReportShell" />

@section Scripts {
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.28/jspdf.plugin.autotable.min.js"></script>
<script src="~/js/lab-report.js" asp-append-version="true"></script>
@if (canRecord)
{
    <partial name="_CriticalCommunicationModal" />
}
<script>
(function () {
    const dash = '<span class="text-muted">—</span>';
    const canRecord = @(canRecord ? "true" : "false");
    const commOn = @(commOn ? "true" : "false");
    const SEV = { PANIC: ['Panic', 'bg-danger text-white border-danger'], CRITICAL: ['Critical', 'bg-warning-subtle text-warning-emphasis border-warning-subtle'] };
    const STATUS = { APPROVED: ['Approved', 'bg-success-subtle text-success border-success-subtle'], PENDING: ['Not yet approved', 'bg-danger-subtle text-danger border-danger-subtle'] };
    const COMM = { INFORMED: ['Informed', 'bg-success-subtle text-success border-success-subtle'], ATTEMPTED: ['Attempted, not reached', 'bg-warning-subtle text-warning-emphasis border-warning-subtle'],
                   NOTRECORDED: ['Not recorded', 'bg-danger-subtle text-danger border-danger-subtle'] };
    const COMM_GROUP = { 'Informed within target': 'bg-success-subtle text-success border-success-subtle', 'Informed late': 'bg-warning-subtle text-warning-emphasis border-warning-subtle',
                         'Attempted, not reached': 'bg-warning-subtle text-warning-emphasis border-warning-subtle', 'Not recorded': 'bg-danger-subtle text-danger border-danger-subtle' };
    const ROLE = { REFDOCTOR: 'referring doctor', TREATDOCTOR: 'treating doctor', PATIENT: 'patient', ATTENDANT: 'attendant', WARD: 'ward / nurse', PARTNER: 'B2B partner', OTHER: 'other' };
    const MODE = { PHONE: 'phone', INPERSON: 'in person', WHATSAPP: 'WhatsApp', SMS: 'SMS', EMAIL: 'email' };
    const pillOf = (map, v, h) => { const x = map[v] || [v, '']; return h.pill(x[0], x[1]); };
    const hrs = (v) => v === null || v === undefined ? '—' : `${Number(v).toFixed(1)} h`;
    const mins = (v) => { if (v === null || v === undefined) return '—'; const n = Number(v) || 0; return n >= 120 ? `${(n / 60).toFixed(1)} h` : `${Math.round(n)} min`; };
    const pct = (v) => v === null || v === undefined ? '—' : `${Number(v).toFixed(1)}%`;
    const arrow = d => d === 'H' ? '<i class="bi bi-arrow-up-circle-fill text-danger ms-1" title="Above the high threshold"></i>'
                     : d === 'L' ? '<i class="bi bi-arrow-down-circle-fill text-primary ms-1" title="Below the low threshold"></i>' : '';
    const msgNote = (s, h) => s === 'QUEUED' ? ' · <span class="text-info-emphasis">message sending…</span>' : (s === 'SENT' ? ' · <span class="text-success">message sent</span>' : (s === 'FAILED' ? ' · <span class="text-danger">message failed</span>' : ''));
    function commHtml(r, h) {
        if (r.CommunicationStatus === 'INFORMED')
            return pillOf(COMM, 'INFORMED', h) + ` <span class="badge border ${r.WithinTarget ? 'bg-success text-white' : 'bg-warning text-dark'}" title="Result entry to informing; target ${h.num(r.TargetMinutes)} min">${mins(r.MinutesToInform)}</span>`
                + `<div class="fs-9">${h.esc(r.InformedName)} (${h.esc(ROLE[r.InformedRole] || r.InformedRole)}) · ${h.esc(MODE[r.InformedMode] || r.InformedMode)}${r.InformedContact ? ' ' + h.esc(r.InformedContact) : ''}</div>`
                + `<div class="fs-9 text-muted">${h.fmtDT(r.InformedOn)}${r.ReadBack ? ' · read back' : ''}${r.InformedBy ? ' · by ' + h.esc(r.InformedBy) : ''}${msgNote(r.InformedMessageStatus, h)}</div>`
                + (r.ValueChangedSinceInformed ? '<div class="fs-9 text-danger">value changed since informed</div>' : '');
        if (r.CommunicationStatus === 'ATTEMPTED')
            return pillOf(COMM, 'ATTEMPTED', h) + ` <span class="fs-9 text-muted">×${h.num(r.Attempts)}</span>`
                + `<div class="fs-9">${h.esc(r.LastName)} · ${h.esc(MODE[r.LastMode] || r.LastMode)} · ${h.fmtDT(r.LastOn)}${msgNote(r.LastMessageStatus, h)}</div>`
                + (r.LastRemarks ? `<div class="fs-9 text-muted">${h.esc(r.LastRemarks)}</div>` : '');
        return pillOf(COMM, 'NOTRECORDED', h);
    }
    function commText(r, h) {
        if (r.CommunicationStatus === 'INFORMED')
            return `Informed ${r.InformedName} (${ROLE[r.InformedRole] || r.InformedRole}) by ${MODE[r.InformedMode] || r.InformedMode} at ${h.fmtDT(r.InformedOn)}, ${mins(r.MinutesToInform)}${r.ReadBack ? ', read back' : ''}`;
        if (r.CommunicationStatus === 'ATTEMPTED') return `Attempted x${r.Attempts}: ${r.LastName} at ${h.fmtDT(r.LastOn)}${r.LastRemarks ? ' - ' + r.LastRemarks : ''}`;
        return 'Not recorded';
    }
    const cols = [
        { label: 'Entered', cls: 'text-nowrap', html: (r, h) => `${h.fmtDT(r.EnteredOn)}<div class="text-muted fs-9">${h.esc(r.EnteredBy || '')}</div>`, text: (r, h) => h.fmtDT(r.EnteredOn) },
        { label: 'Bill No', html: (r, h) => `<div class="fw-semibold font-monospace">${h.esc(r.BillNo)}</div><div class="text-muted fs-9">${h.esc(r.TokenNo || '')}</div>`, text: r => r.BillNo },
        { label: 'Patient', html: (r, h) => `<div class="fw-semibold">${h.esc(r.PatientName)}</div><div class="text-muted fs-9">${h.esc(r.PatientCode)}${r.PhoneNumber ? ` · <i class="bi bi-telephone"></i> ${h.esc(r.PhoneNumber)}` : ''}${r.AgeYears !== null && r.AgeYears !== undefined ? ` · ${h.num(r.AgeYears)} y` : ''}${r.Gender ? ' ' + h.esc(r.Gender) : ''}</div>`,
          text: r => `${r.PatientName} (${r.PatientCode}) ${r.PhoneNumber || ''}` },
        { label: 'Test', html: (r, h) => `<div class="fw-semibold">${h.esc(r.TestName)}</div><div class="text-muted fs-9">${h.esc(r.ProfileName ? r.ProfileName + ' · ' : '')}${h.esc(r.Department)}</div>`, text: r => r.TestName },
        { label: 'Result', cls: 'text-nowrap', html: (r, h) => `<span class="fw-bold fs-6">${h.esc(r.TestValue)}</span> <span class="text-muted fs-9">${h.esc(r.Unit || '')}</span>${arrow(r.ThresholdDir)}`
              + `<div>${pillOf(SEV, r.Severity, h)}${r.SavedFlag && r.SavedFlag.toUpperCase() !== r.Severity ? ` <span class="text-danger fs-9" title="The flag saved with the result">saved as ${h.esc(r.SavedFlag)}</span>` : ''}</div>`,
          text: r => `${r.TestValue} ${r.Unit || ''} (${(SEV[r.Severity] || [r.Severity])[0]})` },
        { label: 'Threshold', html: (r, h) => r.Threshold ? `<span class="fs-9">${h.esc(r.Threshold)}</span>` : '<span class="text-muted fs-9">flagged on entry</span>', text: r => r.Threshold || 'flagged on entry' },
        ...(commOn ? [{ label: 'Communication', html: (r, h) => commHtml(r, h), text: (r, h) => commText(r, h) }] : []),
        { label: 'Approval', cls: 'text-nowrap', html: (r, h) => pillOf(STATUS, r.ResultStatus, h) + (r.ApprovedOn ? `<div class="text-muted fs-9">${h.fmtDT(r.ApprovedOn)}${r.ApprovedBy ? ' · ' + h.esc(r.ApprovedBy) : ''}</div>` : ''),
          text: (r, h) => (STATUS[r.ResultStatus] || [r.ResultStatus])[0] + (r.ApprovedOn ? ` ${h.fmtDT(r.ApprovedOn)} ${r.ApprovedBy || ''}` : '') }
    ];
    if (canRecord) cols.push({ label: '', cls: 'text-end no-print', noExport: true,
        html: (r) => `<button type="button" class="btn btn-sm ${r.CommunicationStatus === 'INFORMED' ? 'btn-outline-secondary' : 'btn-danger'} py-0 px-2 text-nowrap btn-cc-record"
                         data-laborder="${r.LabOrderId}" data-sample="${r.SampleId}" title="Record who was informed, a further attempt, or a correction">
                         <i class="bi bi-telephone-plus me-1"></i>${r.CommunicationStatus === 'INFORMED' ? 'Add / correct' : 'Record'}</button>` });

    LabReport.init({
        report: 'critical-values', title: 'Critical & Panic Value Register', defaultRange: 'month',
        dataUrl: '@Url.Action("GetLabReportData", "Reports")',
        seeAll: @((ViewBag.CanSeeAllCollections as bool? ?? false) ? "true" : "false"),
        branchName: '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(User.FindFirst("BranchName")?.Value ?? ""))',
        searchPlaceholder: 'Bill No, patient, mobile or test...',
        filters: [
            ...(commOn ? [{ id: 'communication', label: 'Communication', allLabel: 'All', options: [['NOTRECORDED', 'Not recorded'], ['ATTEMPTED', 'Attempted, not reached'], ['INFORMED', 'Informed'], ['LATE', 'Informed late']] }] : []),
            { id: 'severity', label: 'Severity', allLabel: 'Critical & panic', options: [['PANIC', 'Panic'], ['CRITICAL', 'Critical']] },
            { id: 'resultStatus', label: 'Approval', allLabel: 'All results', options: [['PENDING', 'Not yet approved'], ['APPROVED', 'Approved']] },
            { id: 'departmentId', label: 'Department', allLabel: 'All departments', fromOptions: 'departmentId' }
        ],
        kpis: commOn ? [
            { label: 'Flagged results', color: '#b91c1c', value: (s, h) => h.num(s.Flagged), sub: (s, h) => `${h.num(s.Panic)} panic · ${h.num(s.Critical)} critical · ${h.num(s.Patients)} patient(s)` },
            { label: 'Informed within target', color: '#15803d', value: (s) => pct(s.WithinTargetPct),
              sub: (s, h) => `${h.num(s.InformedWithinTarget)} of ${h.num(s.Flagged)} within ${h.num(s.TargetMinutes)} min of the result` },
            { label: 'Informed', color: '#0f766e', value: (s) => pct(s.InformedPct), sub: (s, h) => `${h.num(s.Informed)} informed · ${h.num(s.ReadBackCount)} read back · avg ${mins(s.AvgMinutesToInform)}` },
            { label: 'Not recorded', color: '#9f1239', value: (s, h) => h.num(s.NotRecorded), sub: (s, h) => `${h.num(s.Attempted)} attempted, not reached` },
            { label: 'Not yet approved', color: '#d97706', value: (s, h) => h.num(s.AwaitingApproval), sub: (s) => `entry → approval avg ${hrs(s.AvgHoursToApproval)}` }
        ] : [
            { label: 'Flagged results', color: '#b91c1c', value: (s, h) => h.num(s.Flagged), sub: (s, h) => `${h.num(s.Patients)} patient(s)` },
            { label: 'Panic', color: '#7f1d1d', value: (s, h) => h.num(s.Panic), sub: () => 'act immediately' },
            { label: 'Critical', color: '#d97706', value: (s, h) => h.num(s.Critical), sub: () => 'beyond the critical threshold' },
            { label: 'Not yet approved', color: '#9f1239', value: (s, h) => h.num(s.AwaitingApproval), sub: () => 'still with the bench / pathologist' },
            { label: 'Entry → approval', color: '#0e7490', value: (s) => hrs(s.AvgHoursToApproval), sub: (s, h) => `average · most often ${h.esc(s.TopTest || '—')}` }
        ],
        groups: [
            ...(commOn ? [{ key: 'byCommunication', label: 'Communication', rowField: 'CommunicationGroup', name: (r, h) => h.pill(h.esc(r.GroupName), COMM_GROUP[r.GroupName] || '') }] : []),
            { key: 'byTest', label: 'Test', rowField: 'TestName' },
            { key: 'bySeverity', label: 'Severity', rowField: 'Severity', name: (r, h) => pillOf(SEV, r.GroupName, h) },
            { key: 'byStatus', label: 'Approval', rowField: 'ResultStatus', name: (r, h) => pillOf(STATUS, r.GroupName, h) },
            { key: 'byDepartment', label: 'Department', rowField: 'DepartmentId', byId: true },
            { key: 'byDate', label: 'Entry date', rowField: 'EnteredDay', name: (r, h) => h.fmtD(r.GroupName) }
        ],
        groupCols: [
            { field: 'Flagged', label: 'Flagged', num: true, fmt: (v, h) => h.num(v) },
            { field: 'Panic', label: 'Panic', num: true, fmt: (v, h) => Number(v) ? `<span class="text-danger fw-semibold">${h.num(v)}</span>` : dash },
            { field: 'Critical', label: 'Critical', num: true, fmt: (v, h) => Number(v) ? h.num(v) : dash },
            ...(commOn ? [
                { field: 'Informed', label: 'Informed', num: true, fmt: (v, h) => Number(v) ? h.num(v) : dash },
                { field: 'InformedWithinTarget', label: 'Within target', num: true, fmt: (v, h) => Number(v) ? h.num(v) : dash },
                { field: 'NotRecorded', label: 'Not recorded', num: true, fmt: (v, h) => Number(v) ? `<span class="text-danger fw-semibold">${h.num(v)}</span>` : dash },
                { field: 'AvgMinutesToInform', label: 'Avg to inform', num: true, total: 'none', fmt: (v) => mins(v) }] : []),
            { field: 'AwaitingApproval', label: 'Not yet approved', num: true, fmt: (v, h) => Number(v) ? `<span class="text-danger fw-semibold">${h.num(v)}</span>` : dash },
            { field: 'AvgHoursToApproval', label: 'Avg to approval', num: true, total: 'none', fmt: (v) => hrs(v) }
        ],
        shareOf: 'Flagged',
        cols: cols,
        rowClass: r => (commOn ? r.CommunicationStatus === 'NOTRECORDED' : r.ResultStatus === 'PENDING') ? 'row-muted' : ''
    });

    // Record / add / correct a communication from the register, then refresh it
    $(document).on('click', '.btn-cc-record', function () {
        const $b = $(this);
        CriticalComm.open({ labOrderId: parseInt($b.data('laborder')), sampleIds: [parseInt($b.data('sample'))] })
            .then(function (saved) { if (saved) $('#lrApply').trigger('click'); });
    });
})();
</script>
}
