@{
    ViewData["Title"] = "Discount Register";
    var branchName = User.FindFirst("BranchName")?.Value ?? User.FindFirst("BranchCode")?.Value ?? "";
    bool seeAll = ViewBag.CanSeeAllCollections as bool? ?? false;
    var me = User.FindFirst("DisplayName")?.Value ?? User.Identity?.Name ?? "You";
}

@section HeadStyles {
<style>
    .dr-wrap { --dr-line:#e2e8f0; --dr-muted:#64748b; --dr-ink:#0f172a; }
    .dr-wrap .fs-8 { font-size:.78rem !important; } .dr-wrap .fs-9 { font-size:.7rem !important; }
    .dr-card { background:#fff;border:1px solid var(--dr-line);border-radius:.75rem; }
    .dr-kpi { position:relative;padding:.9rem 1rem;border-left:4px solid var(--k); }
    .dr-kpi .k-label { font-size:.66rem;font-weight:700;letter-spacing:.5px;text-transform:uppercase;color:var(--dr-muted); }
    .dr-kpi .k-val { font-size:1.4rem;font-weight:800;color:var(--dr-ink);line-height:1.2;font-variant-numeric:tabular-nums; }
    .dr-kpi .k-sub { font-size:.7rem;color:var(--dr-muted); }
    .btn-quick.active, .btn-view.active { background:#b45309;border-color:#b45309;color:#fff; }
    .dr-table thead th { position:sticky;top:0;z-index:1;background:#f8fafc;color:var(--dr-muted);font-size:.66rem;font-weight:700;
                         letter-spacing:.4px;text-transform:uppercase;white-space:nowrap;border-bottom:1px solid var(--dr-line); }
    .dr-table tbody td { font-size:.78rem;vertical-align:middle;border-color:#eef2f6; }
    .dr-table tfoot td { font-size:.8rem;font-weight:800;background:#f8fafc; }
    .amt { font-variant-numeric:tabular-nums;white-space:nowrap; }
    .tbl-scroll { max-height:60vh;overflow:auto; }
    tr.grp-row { cursor:pointer; } tr.grp-row:hover td { background:#fff7ed; }
    .reason-none { color:#b91c1c;font-style:italic; }
    .bar { height:5px;border-radius:3px;background:#f1f5f9;overflow:hidden;margin-top:3px;min-width:80px; }
    .bar > span { display:block;height:100%;background:#d97706; }
    tr.row-cancelled td { background:#fff7f7; }
    @@media print { .emr-topbar, footer, .no-print { display:none !important; } .tbl-scroll { max-height:none;overflow:visible; } }
</style>
}

<div class="container-fluid px-3 py-2 dr-wrap">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
        <div>
            <h1 class="h4 fw-bold mb-0"><i class="bi bi-percent text-warning me-2"></i>Discount Register</h1>
            <div class="text-muted fs-8">Reports &rsaquo; LAB &middot; discounted bills with reason, approver and who entered the discount
                @if (!string.IsNullOrWhiteSpace(branchName)) { <span>&middot; Branch <strong>@branchName</strong></span> }
                &middot; <span id="lblRange"></span></div>
            <div class="fs-9 mt-1">
                @if (seeAll)
                {
                    <span class="badge bg-success-subtle text-success border border-success-subtle"><i class="bi bi-shield-check me-1"></i>Administrator view &middot; all users' discounts of this branch</span>
                }
                else
                {
                    <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle"><i class="bi bi-person-lock me-1"></i>Showing only the discounts you entered (@me)</span>
                }
            </div>
        </div>
        <div class="d-flex gap-2 no-print">
            <button type="button" class="btn btn-sm btn-outline-success" id="btnExcel" disabled><i class="bi bi-file-earmark-excel me-1"></i>Excel</button>
            <button type="button" class="btn btn-sm btn-outline-danger" id="btnPdf" disabled><i class="bi bi-file-earmark-pdf me-1"></i>PDF</button>
            <button type="button" class="btn btn-sm btn-outline-secondary" id="btnPrint" disabled><i class="bi bi-printer me-1"></i>Print</button>
        </div>
    </div>

    <!-- Filters -->
    <div class="dr-card p-2 px-3 mb-2 no-print">
        <div class="row g-2 align-items-end">
            <div class="col-6 col-md-2"><label class="form-label fs-9 fw-bold text-muted text-uppercase mb-0" for="txtFrom">From (bill date)</label>
                <input type="date" id="txtFrom" class="form-control form-control-sm" autocomplete="off" /></div>
            <div class="col-6 col-md-2"><label class="form-label fs-9 fw-bold text-muted text-uppercase mb-0" for="txtTo">To</label>
                <input type="date" id="txtTo" class="form-control form-control-sm" autocomplete="off" /></div>
            <div class="col-12 col-md-4"><label class="form-label fs-9 fw-bold text-muted text-uppercase mb-0">Quick select</label>
                <div class="btn-group btn-group-sm w-100" role="group">
                    <button type="button" class="btn btn-outline-secondary btn-quick" data-range="today">Today</button>
                    <button type="button" class="btn btn-outline-secondary btn-quick" data-range="week">7 Days</button>
                    <button type="button" class="btn btn-outline-secondary btn-quick" data-range="month">This Month</button>
                    <button type="button" class="btn btn-outline-secondary btn-quick" data-range="lastmonth">Last Month</button>
                </div></div>
            <div class="col-4 col-md-1"><label class="form-label fs-9 fw-bold text-muted text-uppercase mb-0" for="selType">Billing</label>
                <select id="selType" class="form-select form-select-sm" autocomplete="off"><option value="">All</option><option>B2C</option><option>B2B</option></select></div>
            <div class="col-8 col-md-3"><label class="form-label fs-9 fw-bold text-muted text-uppercase mb-0" for="selApprover">Approved by</label>
                <select id="selApprover" class="form-select form-select-sm" autocomplete="off"><option value="">All approvers</option></select></div>
            @if (seeAll)
            {
                <div class="col-6 col-md-3"><label class="form-label fs-9 fw-bold text-muted text-uppercase mb-0" for="selEntered">Entered by</label>
                    <select id="selEntered" class="form-select form-select-sm" autocomplete="off"><option value="">All users</option></select></div>
            }
            <div class="col-12 @(seeAll ? "col-md-6" : "col-md-9")">
                <div class="input-group input-group-sm"><span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                    <input type="text" id="txtSearch" class="form-control" autocomplete="off" placeholder="Bill No, Token, Patient ID, name, mobile or reason..." /></div>
            </div>
            <div class="col-12 col-md-3 d-flex gap-2 justify-content-md-end">
                <button type="button" class="btn btn-sm btn-link text-danger text-decoration-none" id="btnReset"><i class="bi bi-x-circle me-1"></i>Reset</button>
                <button type="button" class="btn btn-sm btn-warning px-4" id="btnApply"><i class="bi bi-funnel me-1"></i>Apply</button>
            </div>
        </div>
    </div>

    <div id="stateError" class="alert alert-danger fs-8 d-none"></div>

    <!-- KPIs -->
    <div class="row g-2 mb-2">
        <div class="col-6 col-lg"><div class="dr-card dr-kpi" style="--k:#b45309;"><div class="k-label">Total discount</div><div class="k-val" id="kTotal">&mdash;</div><div class="k-sub">given on <span id="kBills">0</span> bill(s)</div></div></div>
        <div class="col-6 col-lg"><div class="dr-card dr-kpi" style="--k:#7c3aed;"><div class="k-label">Discount %</div><div class="k-val" id="kPct">&mdash;</div><div class="k-sub">of <span id="kGross">&#8377;0</span> gross on those bills</div></div></div>
        <div class="col-6 col-lg"><div class="dr-card dr-kpi" style="--k:#0f766e;"><div class="k-label">Highest discount</div><div class="k-val" id="kHigh">&mdash;</div><div class="k-sub">on a single bill</div></div></div>
        <div class="col-6 col-lg"><div class="dr-card dr-kpi" style="--k:#b91c1c;"><div class="k-label">Without reason</div><div class="k-val" id="kNoReason">&mdash;</div><div class="k-sub"><span id="kNoReasonAmt">&#8377;0</span>, given before reasons were recorded</div></div></div>
    </div>

    <!-- Summary / Detail -->
    <div class="dr-card">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 px-3 py-2 border-bottom">
            <div class="d-flex align-items-center gap-2 flex-wrap">
                <div class="btn-group btn-group-sm no-print" role="group" aria-label="View">
                    <button type="button" class="btn btn-outline-secondary btn-view active" data-view="summary">Summary</button>
                    <button type="button" class="btn btn-outline-secondary btn-view" data-view="detail">Detail</button>
                </div>
                <div id="grpBox" class="d-flex align-items-center gap-1 fs-8">
                    <label for="selGroup" class="text-muted">Group by</label>
                    <select id="selGroup" class="form-select form-select-sm" style="width:auto;">
                        <option value="byApprover">Approved by</option><option value="byReason">Reason</option>
                        @if (seeAll) { <option value="byEnteredBy">Entered by</option> }
                        <option value="byDate">Bill date</option>
                    </select>
                </div>
                <span id="drillChip" class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle d-none"></span>
            </div>
            <span class="fs-8 text-muted" id="lblCount"></span>
        </div>
        <div class="tbl-scroll">
            <table class="table table-hover mb-0 dr-table" id="tblSummary">
                <thead><tr><th class="ps-3" id="thGroup">Approved by</th><th class="text-end">Bills</th><th class="text-end">Gross</th><th class="text-end">Discount</th><th class="text-end">Discount %</th><th>Share of discount</th></tr></thead>
                <tbody id="tbSummary"></tbody>
                <tfoot><tr><td class="ps-3">Total</td><td class="text-end" id="fsBills"></td><td class="text-end amt" id="fsGross"></td><td class="text-end amt" id="fsDisc"></td><td class="text-end" id="fsPct"></td><td></td></tr></tfoot>
            </table>
            <table class="table table-hover mb-0 dr-table d-none" id="tblDetail">
                <thead><tr><th class="ps-3">#</th><th>Bill No / Token</th><th>Bill date</th><th>Patient</th><th>Type</th><th class="text-end">Gross</th><th class="text-end">Discount</th><th class="text-end">%</th><th class="text-end">Net</th><th class="text-end">Balance</th><th>Reason</th><th>Approved by</th><th>Entered by</th><th class="no-print text-center">Bill</th></tr></thead>
                <tbody id="tbDetail"></tbody>
                <tfoot><tr><td colspan="5" class="ps-3 text-end">Total (<span id="fdCount">0</span> bills)</td><td class="text-end amt" id="fdGross"></td><td class="text-end amt text-warning-emphasis" id="fdDisc"></td><td colspan="7"></td></tr></tfoot>
            </table>
        </div>
        <div id="stateEmpty" class="text-center text-muted py-5 d-none"><i class="bi bi-inbox fs-1 d-block mb-2 opacity-50"></i>No discounted bills for the selected filters.</div>
        <div id="stateLoading" class="text-center text-muted py-5 d-none"><span class="spinner-border spinner-border-sm me-2"></span>Loading discount register&hellip;</div>
    </div>
</div>

@section Scripts {
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.28/jspdf.plugin.autotable.min.js"></script>
<script>
(function () {
    const dataUrl = '@Url.Action("GetLabDiscountRegisterData", "Reports")';
    const billUrl = '@Url.Action("PrintBill", "LabOrderBooking")';
    const branchName = '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(branchName))';
    const GROUP_LABEL = { byApprover: 'Approved by', byReason: 'Reason', byEnteredBy: 'Entered by', byDate: 'Bill date' };
    let data = null, view = 'summary', drill = null, loadSeq = 0;

    const pad = n => String(n).padStart(2, '0');
    const iso = d => d.getFullYear() + '-' + pad(d.getMonth() + 1) + '-' + pad(d.getDate());
    const money = n => '₹' + (Number(n) || 0).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    const esc = s => String(s ?? '').replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
    const fmtD = s => { const d = new Date(s); return isNaN(d) ? '' : d.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }); };
    const pct = (a, b) => b > 0 ? (a * 100 / b).toFixed(1) + '%' : '—';

    function setRange(r) {
        const t = new Date(); let f = new Date(t), to = new Date(t);
        if (r === 'week') f.setDate(t.getDate() - 6);
        else if (r === 'month') f = new Date(t.getFullYear(), t.getMonth(), 1);
        else if (r === 'lastmonth') { f = new Date(t.getFullYear(), t.getMonth() - 1, 1); to = new Date(t.getFullYear(), t.getMonth(), 0); }
        $('#txtFrom').val(iso(f)); $('#txtTo').val(iso(to));
        $('.btn-quick').removeClass('active').filter(`[data-range="${r}"]`).addClass('active');
    }

    function load() {
        const seq = ++loadSeq, from = $('#txtFrom').val(), to = $('#txtTo').val();
        if (!from || !to) return;
        $('#stateError').addClass('d-none'); $('#stateLoading').removeClass('d-none'); $('#stateEmpty').addClass('d-none');
        $('#tbSummary, #tbDetail').empty(); $('#btnExcel, #btnPdf, #btnPrint').prop('disabled', true);
        $('#lblRange').text(fmtD(from) + (from === to ? '' : ' – ' + fmtD(to)));
        $.get(dataUrl, { fromDate: from, toDate: to, billingType: $('#selType').val(), approvedBy: $('#selApprover').val() || null,
                         enteredBy: $('#selEntered').val() || null, search: $('#txtSearch').val() })
        .done(res => {
            if (seq !== loadSeq) return;
            $('#stateLoading').addClass('d-none');
            if (!res || !res.success) { $('#stateError').text(res?.message || 'Unable to load the report.').removeClass('d-none'); return; }
            data = res.data; drill = null;
            fillFilters(); renderKpis(); render();
        })
        .fail(() => { if (seq !== loadSeq) return; $('#stateLoading').addClass('d-none'); $('#stateError').text('Server error while loading the report. Please try again.').removeClass('d-none'); });
    }

    function fillFilters() {
        const add = ($s, rows, idKey) => {
            const have = new Set($s.find('option').map((_, o) => o.value).get());
            rows.forEach(r => { if (r[idKey] && !have.has(String(r[idKey]))) $s.append(`<option value="${r[idKey]}">${esc(r.groupName)}</option>`); });
        };
        add($('#selApprover'), data.byApprover || [], 'approvedById');
        if ($('#selEntered').length) add($('#selEntered'), data.byEnteredBy || [], 'enteredById');
    }

    function renderKpis() {
        const s = data.summary || {};
        $('#kTotal').text(money(s.totalDiscount)); $('#kBills').text(s.billCount || 0);
        $('#kPct').text((Number(s.discountPercent) || 0).toFixed(1) + '%'); $('#kGross').text(money(s.grossOfDiscountedBills));
        $('#kHigh').text(money(s.highestDiscount));
        $('#kNoReason').text(s.withoutReasonCount || 0); $('#kNoReasonAmt').text(money(s.withoutReasonAmount));
    }

    // a bill belongs to a summary group when its key matches
    function inGroup(b, key, name) {
        if (key === 'byApprover') return (b.approvedBy || 'Not recorded') === name;
        if (key === 'byReason') return (b.discountReason || 'Not recorded') === name;
        if (key === 'byEnteredBy') return (b.enteredBy || '') === name;
        return iso(new Date(b.billDate)) === name;
    }

    function render() {
        const bills = (data?.bills || []).filter(b => !drill || inGroup(b, drill.key, drill.name));
        const empty = !(data?.bills || []).length;
        $('#stateEmpty').toggleClass('d-none', !empty);
        $('#btnExcel, #btnPdf, #btnPrint').prop('disabled', empty);
        $('#tblSummary').toggleClass('d-none', view !== 'summary' || empty);
        $('#tblDetail').toggleClass('d-none', view !== 'detail' || empty);
        $('#grpBox').toggleClass('d-none', view !== 'summary');
        $('#drillChip').toggleClass('d-none', !(view === 'detail' && drill))
            .html(drill ? `${esc(GROUP_LABEL[drill.key])}: <strong>${esc(drill.key === 'byDate' ? fmtD(drill.name) : drill.name)}</strong> <a href="#" id="clearDrill" class="ms-1 text-reset">×</a>` : '');
        if (empty) { $('#lblCount').text(''); return; }

        if (view === 'summary') {
            const key = $('#selGroup').val(), rows = data[key] || [];
            const tot = rows.reduce((a, r) => ({ b: a.b + r.billCount, g: a.g + r.grossAmount, d: a.d + r.discountAmount }), { b: 0, g: 0, d: 0 });
            $('#thGroup').text(GROUP_LABEL[key]);
            $('#tbSummary').html(rows.map(r => `<tr class="grp-row" data-name="${esc(r.groupName)}" title="Show these bills">
                <td class="ps-3 fw-semibold ${r.groupName === 'Not recorded' ? 'reason-none' : ''}">${esc(key === 'byDate' ? fmtD(r.groupName) : r.groupName)}</td>
                <td class="text-end">${r.billCount}</td><td class="text-end amt">${money(r.grossAmount)}</td>
                <td class="text-end amt fw-bold text-warning-emphasis">${money(r.discountAmount)}</td><td class="text-end">${pct(r.discountAmount, r.grossAmount)}</td>
                <td><div class="bar"><span style="width:${tot.d ? (r.discountAmount / tot.d * 100).toFixed(1) : 0}%"></span></div></td></tr>`).join(''));
            $('#fsBills').text(tot.b); $('#fsGross').text(money(tot.g)); $('#fsDisc').text(money(tot.d)); $('#fsPct').text(pct(tot.d, tot.g));
            $('#lblCount').text(`${rows.length} group(s) · click a line to see its bills`);
        } else {
            $('#tbDetail').html(bills.map((b, i) => `<tr class="${b.isBillActive ? '' : 'row-cancelled'}">
                <td class="ps-3 text-muted">${i + 1}</td>
                <td><div class="fw-semibold font-monospace">${esc(b.billNo)}</div><div class="text-muted fs-9">${esc(b.tokenNo || '')}${b.isBillActive ? '' : ' · <span class="text-danger">cancelled</span>'}</div></td>
                <td class="text-nowrap">${fmtD(b.billDate)}</td>
                <td><div class="fw-semibold">${esc(b.patientName)}</div><div class="text-muted fs-9">${esc(b.patientCode)}${b.phoneNumber ? ' · ' + esc(b.phoneNumber) : ''}</div></td>
                <td>${esc(b.billingType)}</td>
                <td class="text-end amt">${money(b.grossAmount)}</td>
                <td class="text-end amt fw-bold text-warning-emphasis">${money(b.discountAmount)}<div class="text-muted fs-9">${b.discountType === 'P' && b.discountValue ? Number(b.discountValue) + '%' : (b.discountType === 'F' ? 'fixed' : '')}</div></td>
                <td class="text-end">${(Number(b.discountPercent) || 0).toFixed(1)}%</td>
                <td class="text-end amt">${money(b.netAmount)}</td>
                <td class="text-end amt ${b.balanceDue > 0 ? 'text-danger' : 'text-muted'}">${money(b.balanceDue)}</td>
                <td>${b.discountReason ? esc(b.discountReason) : '<span class="reason-none">Not recorded</span>'}</td>
                <td>${b.approvedBy ? esc(b.approvedBy) + (b.approvedDate ? `<div class="text-muted fs-9">${fmtD(b.approvedDate)}</div>` : '') : '<span class="reason-none">Not recorded</span>'}</td>
                <td class="text-nowrap">${esc(b.enteredBy || '')}</td>
                <td class="text-center no-print"><a class="btn btn-sm btn-outline-primary py-0 px-2" target="_blank" title="Print bill" href="${billUrl}?labOrderId=${b.labOrderId}"><i class="bi bi-printer"></i></a></td>
            </tr>`).join(''));
            const g = bills.reduce((a, b) => a + (b.grossAmount || 0), 0), d = bills.reduce((a, b) => a + (b.discountAmount || 0), 0);
            $('#fdCount').text(bills.length); $('#fdGross').text(money(g)); $('#fdDisc').text(money(d));
            $('#lblCount').text(`${bills.length} bill(s)`);
        }
    }

    // ── export (whichever view is on screen) ──
    function exportRows() {
        if (view === 'summary') {
            const key = $('#selGroup').val();
            return { head: [GROUP_LABEL[key], 'Bills', 'Gross', 'Discount', 'Discount %'],
                     rows: (data[key] || []).map(r => [key === 'byDate' ? fmtD(r.groupName) : r.groupName, r.billCount, r.grossAmount, r.discountAmount, pct(r.discountAmount, r.grossAmount)]) };
        }
        const bills = (data.bills || []).filter(b => !drill || inGroup(b, drill.key, drill.name));
        return { head: ['Bill No', 'Token', 'Bill Date', 'Patient', 'Patient ID', 'Type', 'Gross', 'Discount', 'Discount %', 'Net', 'Balance', 'Reason', 'Approved By', 'Entered By'],
                 rows: bills.map(b => [b.billNo, b.tokenNo, fmtD(b.billDate), b.patientName, b.patientCode, b.billingType, b.grossAmount, b.discountAmount,
                                       (Number(b.discountPercent) || 0).toFixed(1) + '%', b.netAmount, b.balanceDue, b.discountReason || 'Not recorded', b.approvedBy || 'Not recorded', b.enteredBy]) };
    }
    const fileBase = () => `Discount_Register_${view}_${$('#txtFrom').val()}_to_${$('#txtTo').val()}`;
    $('#btnExcel').on('click', () => { const x = exportRows(); const ws = XLSX.utils.aoa_to_sheet([x.head, ...x.rows]); const wb = XLSX.utils.book_new(); XLSX.utils.book_append_sheet(wb, ws, 'Discount Register'); XLSX.writeFile(wb, fileBase() + '.xlsx'); });
    $('#btnPdf').on('click', () => {
        const x = exportRows(); const { jsPDF } = window.jspdf; const doc = new jsPDF({ orientation: 'landscape', unit: 'pt', format: 'a4' });
        doc.setFontSize(13); doc.text('Discount Register', 40, 36);
        doc.setFontSize(9); doc.text(`${branchName ? 'Branch: ' + branchName + '   ' : ''}Period: ${$('#lblRange').text()}   Total discount: ${$('#kTotal').text().replace('₹', 'Rs. ')}`, 40, 52);
        doc.autoTable({ startY: 62, head: [x.head], body: x.rows.map(r => r.map(v => typeof v === 'number' ? v.toFixed(2) : (v ?? ''))), styles: { fontSize: 7.5, cellPadding: 3 }, headStyles: { fillColor: [180, 83, 9] } });
        doc.save(fileBase() + '.pdf');
    });
    $('#btnPrint').on('click', () => window.print());

    // ── events ──
    $('.btn-quick').on('click', function () { setRange($(this).data('range')); load(); });
    $('#txtFrom, #txtTo').on('change', () => { $('.btn-quick').removeClass('active'); load(); });
    $('#selType, #selApprover, #selEntered').on('change', load);
    $('#btnApply').on('click', load);
    $('#txtSearch').on('keydown', e => { if (e.key === 'Enter') load(); });
    $('#btnReset').on('click', () => { $('#selType, #selApprover, #selEntered').val(''); $('#txtSearch').val(''); setRange('month'); load(); });
    $('.btn-view').on('click', function () { view = $(this).data('view'); $('.btn-view').removeClass('active'); $(this).addClass('active'); if (view === 'summary') drill = null; render(); });
    $('#selGroup').on('change', render);
    $('#tbSummary').on('click', 'tr.grp-row', function () {
        drill = { key: $('#selGroup').val(), name: $(this).data('name') + '' };
        view = 'detail'; $('.btn-view').removeClass('active').filter('[data-view="detail"]').addClass('active'); render();
    });
    $(document).on('click', '#clearDrill', e => { e.preventDefault(); drill = null; render(); });
    window.addEventListener('pageshow', e => { if (e.persisted) { setRange('month'); load(); } });

    setRange('month');
    load();
})();
</script>
}
