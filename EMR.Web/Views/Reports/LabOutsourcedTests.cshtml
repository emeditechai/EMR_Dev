@{
    ViewData["Title"] = "Outsourced Test Register";
    ViewData["ReportSubtitle"] = "tests sent to an outside lab, and the results still to come back";
    ViewData["ReportIcon"] = "bi-send-check";
    ViewData["ReportAccent"] = "#0e7490";
    ViewData["DateLabel"] = "bill date";
}
<partial name="_LabReportShell" />
<form id="lrOutsourceAntiForgery" class="d-none">@Html.AntiForgeryToken()</form>

<!-- Mark sent / Mark result received -->
<div class="modal fade" id="modalOutsource" tabindex="-1" aria-labelledby="modalOutsourceTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header py-2 px-3 bg-light">
                <h6 class="modal-title fs-7 fw-bold" id="modalOutsourceTitle">Outsourced test</h6>
                <button type="button" class="btn-close fs-9" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-3">
                <div class="alert alert-light border py-2 px-2 mb-3 fs-8">
                    <div class="fw-semibold" id="osTest">—</div>
                    <div class="text-muted" id="osBill">—</div>
                </div>
                <div class="os-sent">
                    <label class="form-label fs-8 fw-bold mb-1" for="osLab">Outside lab <span class="text-danger">*</span></label>
                    <input type="text" class="form-control form-control-sm mb-2" id="osLab" list="osLabList" maxlength="150" autocomplete="off" placeholder="Name of the outside lab" />
                    <datalist id="osLabList"></datalist>
                    <label class="form-label fs-8 fw-bold mb-1" for="osRef">Their reference / accession no</label>
                    <input type="text" class="form-control form-control-sm mb-2" id="osRef" maxlength="100" autocomplete="off" />
                </div>
                <label class="form-label fs-8 fw-bold mb-1" for="osWhen"><span class="os-sent">Sent on</span><span class="os-received">Result received on</span> <span class="text-danger">*</span></label>
                <input type="datetime-local" class="form-control form-control-sm mb-2" id="osWhen" />
                <label class="form-label fs-8 fw-bold mb-1" for="osRemarks">Remarks</label>
                <textarea class="form-control form-control-sm" id="osRemarks" rows="2" maxlength="500"></textarea>
                <div class="text-danger fs-8 mt-2 d-none" id="osError"></div>
            </div>
            <div class="modal-footer py-2 px-3">
                <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary btn-sm px-3" id="osSave"><span class="spinner-border spinner-border-sm me-1 d-none" id="osSpin"></span>Save</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.28/jspdf.plugin.autotable.min.js"></script>
<script src="~/js/lab-report.js" asp-append-version="true"></script>
<script>
(function () {
    const dash = '<span class="text-muted">—</span>';
    const STATUS = { AWAITING_SAMPLE: ['Awaiting sample', 'bg-secondary-subtle text-secondary border-secondary-subtle'],
                     TO_SEND: ['To send', 'bg-warning-subtle text-warning-emphasis border-warning-subtle'],
                     AWAITING_RESULT: ['Awaiting result', 'bg-info-subtle text-info-emphasis border-info-subtle'],
                     RECEIVED: ['Result received', 'bg-success-subtle text-success border-success-subtle'] };
    const pillOf = (map, v, h) => { const x = map[v] || [v, '']; return h.pill(x[0], x[1]); };
    const days = v => v === null || v === undefined ? dash : `${Number(v).toFixed(1)} d`;
    const attr = v => String(v ?? '').replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;');

    // actions of a line: who may do them is checked on the server (Settings > Security > this page)
    function actions(r) {
        const data = `data-lo="${r.LabOrderId}" data-ids="${attr(r.SampleIds)}" data-bill="${attr(r.BillNo)}" data-test="${attr(r.TestName)}"
                      data-lab="${attr(r.OutsideLab)}" data-ref="${attr(r.ExternalRefNo)}" data-sent="${attr(r.SentOn)}"`;
        if (r.OutsourceStatus === 'TO_SEND')
            return `<button type="button" class="btn btn-sm btn-outline-primary py-0 px-2 os-action" data-action="sent" data-permission="REPORTS.LABOUTSOURCED:OUTSOURCE_SEND" ${data}><i class="bi bi-send me-1"></i>Mark sent</button>`;
        if (r.OutsourceStatus === 'AWAITING_RESULT')
            return `<div class="d-flex flex-column gap-1">
                <button type="button" class="btn btn-sm btn-outline-success py-0 px-2 os-action" data-action="received" data-permission="REPORTS.LABOUTSOURCED:OUTSOURCE_RESULT" ${data}><i class="bi bi-check2-circle me-1"></i>Result received</button>
                <button type="button" class="btn btn-sm btn-link py-0 px-1 fs-9 os-action" data-action="sent" data-permission="REPORTS.LABOUTSOURCED:OUTSOURCE_SEND" ${data} title="Correct the sending details">Edit sending</button></div>`;
        return '';
    }

    LabReport.init({
        report: 'outsourced-tests', title: 'Outsourced Test Register', defaultRange: 'month',
        dataUrl: '@Url.Action("GetLabReportData", "Reports")',
        seeAll: @((ViewBag.CanSeeAllCollections as bool? ?? false) ? "true" : "false"),
        branchName: '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(User.FindFirst("BranchName")?.Value ?? ""))',
        searchPlaceholder: 'Bill No, patient, barcode, test, outside lab or ref no...',
        filters: [
            { id: 'outsourceStatus', label: 'Status', allLabel: 'All stages',
              options: [['TO_SEND', 'To send'], ['AWAITING_RESULT', 'Awaiting result'], ['OVERDUE', 'Overdue (past TAT)'], ['AWAITING_SAMPLE', 'Awaiting sample'], ['RECEIVED', 'Result received']] },
            { id: 'outsideLab', label: 'Outside lab', allLabel: 'All outside labs', fromOptions: 'labName' }
        ],
        kpis: [
            { label: 'Outsourced tests', color: '#0e7490', value: (s, h) => h.num(s.TestCount), sub: (s, h) => `${h.num(s.BillCount)} bill(s)` },
            { label: 'To send', color: '#b45309', value: (s, h) => h.num(s.ToSend), sub: (s, h) => `${h.num(s.AwaitingSample)} still awaiting the sample` },
            { label: 'Awaiting result', color: '#0891b2', value: (s, h) => h.num(s.AwaitingResult), sub: (s) => s.LongestPendingDays ? `longest ${days(s.LongestPendingDays)}` : '' },
            { label: 'Overdue', color: '#b91c1c', value: (s, h) => h.num(s.Overdue), sub: () => 'sent, past the test’s TAT' },
            { label: 'Results received', color: '#15803d', value: (s, h) => h.num(s.Received), sub: (s) => s.AvgTurnaroundDays !== null && s.AvgTurnaroundDays !== undefined ? `avg ${days(s.AvgTurnaroundDays)} sent to result` : '' }
        ],
        groups: [
            { key: 'byStatus', label: 'Stage', rowField: 'OutsourceStatus', name: (r, h) => pillOf(STATUS, r.GroupName, h) },
            { key: 'byOutsideLab', label: 'Outside lab', rowField: 'OutsideLabGroup' },
            { key: 'byTest', label: 'Test', rowField: 'TestName' },
            { key: 'byDate', label: 'Bill date', rowField: 'BillDay', name: (r, h) => h.fmtD(r.GroupName) }
        ],
        groupCols: [
            { field: 'TestCount', label: 'Tests', num: true }, { field: 'BillCount', label: 'Bills', num: true },
            { field: 'Overdue', label: 'Overdue', num: true }, { field: 'Received', label: 'Received', num: true },
            { field: 'AvgTurnaroundDays', label: 'Avg turnaround', num: true, total: 'none', fmt: v => days(v) },
            { field: 'LongestDays', label: 'Longest at stage', num: true, total: 'max', fmt: v => days(v) }
        ],
        shareOf: 'TestCount',
        rowClass: r => r.IsOverdue ? 'row-muted' : '',
        cols: [
            { label: 'Bill No / date', html: (r, h) => `<div class="fw-semibold font-monospace">${h.esc(r.BillNo)}</div><div class="text-muted fs-9">${h.fmtD(r.BillDate)}</div>`, text: (r, h) => `${r.BillNo} (${h.fmtD(r.BillDate)})` },
            { label: 'Patient', html: (r, h) => `<div class="fw-semibold">${h.esc(r.PatientName)}</div><div class="text-muted fs-9">${h.esc(r.PatientCode)}</div>`, text: r => `${r.PatientName} (${r.PatientCode})` },
            { label: 'Test', html: (r, h) => `<div class="fw-semibold">${h.esc(r.TestName)}</div><div class="text-muted fs-9">${h.esc(r.SampleType)}${r.BarcodeNo ? ' · ' + h.esc(r.BarcodeNo) : ''}${r.TatHours ? ' · TAT ' + r.TatHours + ' h' : ''}</div>`, text: r => r.TestName },
            { label: 'Stage', html: (r, h) => `${pillOf(STATUS, r.OutsourceStatus, h)}${r.IsOverdue ? ' ' + h.pill('Overdue', 'bg-danger text-white border-danger') : ''}<div class="text-muted fs-9 mt-1">${days(r.DaysAtStage)} at this stage</div>`,
              text: r => (STATUS[r.OutsourceStatus] || [r.OutsourceStatus])[0] + (r.IsOverdue ? ' (overdue)' : '') },
            { label: 'Collected', cls: 'text-nowrap', html: (r, h) => r.CollectedOn ? `${h.fmtDT(r.CollectedOn)}<div class="text-muted fs-9">${h.esc(r.CollectedBy || '')}</div>` : dash, text: (r, h) => h.fmtDT(r.CollectedOn) },
            { label: 'Outside lab', html: (r, h) => r.OutsideLab ? `<div class="fw-semibold">${h.esc(r.OutsideLab)}</div><div class="text-muted fs-9">${r.ExternalRefNo ? 'Ref ' + h.esc(r.ExternalRefNo) : ''}</div>` : '<span class="text-muted">Not sent yet</span>',
              text: r => (r.OutsideLab || '') + (r.ExternalRefNo ? ' / ' + r.ExternalRefNo : '') },
            { label: 'Sent', cls: 'text-nowrap', html: (r, h) => r.SentOn ? `${h.fmtDT(r.SentOn)}<div class="text-muted fs-9">${h.esc(r.SentBy || '')}</div>` : dash, text: (r, h) => h.fmtDT(r.SentOn) },
            { label: 'Result received', cls: 'text-nowrap', html: (r, h) => r.ReceivedOn ? `${h.fmtDT(r.ReceivedOn)}<div class="text-muted fs-9">${h.esc(r.ReceivedBy || '')}${r.TurnaroundDays !== null && r.TurnaroundDays !== undefined ? ' · ' + days(r.TurnaroundDays) : ''}</div>` : dash,
              text: (r, h) => h.fmtDT(r.ReceivedOn) },
            { label: '', cls: 'text-end no-print', noExport: true, html: r => actions(r) }
        ]
    });

    // ── Mark sent / Mark result received ──
    const modal = () => bootstrap.Modal.getOrCreateInstance(document.getElementById('modalOutsource'));
    const token = () => $('#lrOutsourceAntiForgery input[name="__RequestVerificationToken"]').val();
    const local = d => { const p = n => String(n).padStart(2, '0'); return `${d.getFullYear()}-${p(d.getMonth() + 1)}-${p(d.getDate())}T${p(d.getHours())}:${p(d.getMinutes())}`; };
    let ctx = null;

    $('#lrDetail').on('click', '.os-action', function () {
        const $b = $(this);
        ctx = { action: $b.data('action'), labOrderId: $b.data('lo'), sampleIds: String($b.data('ids')), billNo: $b.data('bill'), testName: $b.data('test') };
        const sent = ctx.action === 'sent';
        $('#modalOutsourceTitle').text(sent ? 'Mark sent to outside lab' : 'Record outside-lab result');
        $('.os-sent').toggleClass('d-none', !sent); $('.os-received').toggleClass('d-none', sent);
        $('#osTest').text(ctx.testName); $('#osBill').text('Bill ' + ctx.billNo);
        $('#osLab').val($b.data('lab') || ''); $('#osRef').val($b.data('ref') || ''); $('#osRemarks').val('');
        const sentOn = $b.data('sent') ? new Date($b.data('sent')) : null;
        $('#osWhen').val(local(sent && sentOn ? sentOn : new Date()));
        $('#osLabList').html($('#lrF_outsideLab option').map((_, o) => o.value ? `<option value="${attr(o.value)}"></option>` : '').get().join(''));
        $('#osError').addClass('d-none').text('');
        modal().show();
    });

    $('#osSave').on('click', function () {
        if (!ctx) return;
        const sent = ctx.action === 'sent';
        if (sent && !$('#osLab').val().trim()) { $('#osError').text('Enter the outside lab.').removeClass('d-none'); return; }
        if (!$('#osWhen').val()) { $('#osError').text('Enter the date and time.').removeClass('d-none'); return; }
        const $btn = $(this).prop('disabled', true); $('#osSpin').removeClass('d-none');
        $.ajax({
            url: sent ? '@Url.Action("MarkOutsourceSent", "Reports")' : '@Url.Action("MarkOutsourceReceived", "Reports")',
            type: 'POST', contentType: 'application/json', headers: { 'RequestVerificationToken': token() },
            data: JSON.stringify({ labOrderId: ctx.labOrderId, sampleIds: ctx.sampleIds, billNo: ctx.billNo, testName: ctx.testName,
                                   outsideLab: $('#osLab').val().trim(), externalRefNo: $('#osRef').val().trim(),
                                   actionOn: $('#osWhen').val(), remarks: $('#osRemarks').val().trim() })
        }).done(res => {
            if (res && res.success) { modal().hide(); window.toastr?.success?.(res.message); $('#lrApply').trigger('click'); }
            else $('#osError').text(res?.message || 'The action was not accepted.').removeClass('d-none');
        }).fail(() => $('#osError').text('Server error. Please try again.').removeClass('d-none'))
          .always(() => { $btn.prop('disabled', false); $('#osSpin').addClass('d-none'); });
    });
})();
</script>
}
