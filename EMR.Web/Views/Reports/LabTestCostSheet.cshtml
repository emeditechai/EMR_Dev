@{
    ViewData["Title"] = "Test Cost Sheet";
    ViewData["ReportSubtitle"] = "Cost of one test, split into reagent, QC share, reruns, dead volume and collection kit, against its B2C rate";
    ViewData["ReportIcon"] = "bi-receipt-cutoff";
    ViewData["ReportAccent"] = "#b45309";
    ViewData["ScopeNote"] = "Company BOM master · B2C rates of this branch · as on today";
}
@* SQLScripts/2248 #5: tests with a default BOM; open a row for its cost lines (BOM items and the sample kit) *@
<partial name="_LabReportShell" />

@section Scripts {
<partial name="_QcReportScripts" />
<script>
(function () {
    const linesOf = (r, data) => (data.lines || []).filter(l => l.TestId === r.TestId);
    LabReport.init({
        report: 'test-cost-sheet', title: 'Test Cost Sheet', noDates: true,
        dataUrl: '@Url.Action("GetLabReportData", "Reports")',
        seeAll: true,
        branchName: '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(User.FindFirst("BranchName")?.Value ?? ""))',
        searchPlaceholder: 'Test name or code...',
        filters: [
            { id: 'kind', label: 'Type', allLabel: 'Tests and profiles', options: [['Test', 'Tests'], ['Profile', 'Profile tests']] },
            { id: 'departmentId', label: 'Department', allLabel: 'All departments', fromOptions: 'departmentId' }
        ],
        kpis: [
            { label: 'Tests costed', color: '#b45309', value: (s, h) => h.num(s.Tests), sub: (s, h) => `average cost ${QcRep.money(s.AvgTotalCost, h)} per test` },
            { label: 'QC share', color: '#7c3aed', value: s => QcRep.pct(s.QcSharePct), sub: () => 'of reagent + QC material' },
            { label: 'Reruns & dead volume', color: '#1d4ed8', value: s => QcRep.pct(s.UpliftPct), sub: () => 'added on top of the items' },
            { label: 'Collection kit', color: '#0e7490', value: s => QcRep.pct(s.KitSharePct), sub: () => 'of the total cost' },
            { label: 'Average margin', color: '#15803d', value: s => QcRep.marginPct(s.AvgMarginPct), sub: () => 'at the B2C rate' }
        ],
        groups: [
            { key: 'byDept', label: 'Department', rowField: 'DepartmentId', byId: true },
            { key: 'byKind', label: 'Type', rowField: 'Kind' }
        ],
        groupCols: [
            { field: 'Tests', label: 'Tests', num: true },
            { field: 'AvgReagent', label: 'Avg reagent', money: true, total: 'none' },
            { field: 'AvgQc', label: 'Avg QC', money: true, total: 'none' },
            { field: 'AvgUplift', label: 'Avg reruns + dead', money: true, total: 'none' },
            { field: 'AvgKit', label: 'Avg kit', money: true, total: 'none' },
            { field: 'AvgTotal', label: 'Avg total', money: true, total: 'none' }
        ],
        shareOf: 'Tests',
        cols: [
            { label: 'Test', html: (r, h) => QcRep.name(r.TestName, r.TestCode, h, r.Kind === 'Profile' ? QcRep.kind('Profile', h) : ''), text: r => `${r.TestName} (${r.TestCode || ''})` },
            { label: 'Department', html: (r, h) => `<span class="fs-9">${h.esc(r.DepartmentName)}</span>`, text: r => r.DepartmentName },
            { label: 'Reagent', cls: 'text-end amt', html: (r, h) => h.money(r.ReagentCost), text: r => r.ReagentCost },
            { label: 'QC share', cls: 'text-end amt', html: (r, h) => h.money(r.QcCost), text: r => r.QcCost },
            { label: 'Reruns', cls: 'text-end amt', html: (r, h) => `${h.money(r.RerunCost)}<div class="text-muted fs-9">${QcRep.pct(r.RerunPct, 0)}</div>`, text: r => r.RerunCost },
            { label: 'Dead volume', cls: 'text-end amt', html: (r, h) => `${h.money(r.DeadVolumeCost)}<div class="text-muted fs-9">${QcRep.pct(r.DeadVolumePct, 0)}</div>`, text: r => r.DeadVolumeCost },
            { label: 'Material', cls: 'text-end amt', html: (r, h) => h.money(r.MaterialCost), text: r => r.MaterialCost },
            { label: 'Kit', cls: 'text-end amt', html: (r, h) => `${QcRep.money(r.KitCost, h)}<div class="text-muted fs-9">${h.esc(r.SampleType || '')}</div>`, text: r => r.KitCost ?? '' },
            { label: 'Total cost', cls: 'text-end amt fw-semibold', html: (r, h) => h.money(r.TotalCost), text: r => r.TotalCost },
            { label: 'B2C rate', cls: 'text-end amt', html: (r, h) => QcRep.money(r.Rate, h), text: r => r.Rate ?? '' },
            { label: 'Margin', cls: 'text-end amt', html: (r, h) => `${QcRep.margin(r.Margin, r.MarginPct, h)}<div class="fs-9">${QcRep.marginPct(r.MarginPct)}</div>`, text: r => r.Margin ?? '' }
        ],
        expand: {
            has: (r, data) => linesOf(r, data).length > 0,
            html: (r, data, h) => QcRep.lines(linesOf(r, data), [
                { label: 'Section', html: l => QcRep.pill(l.Section, l.Section === 'QC share' ? 'warn' : l.Section === 'Collection kit' ? 'info' : 'muted', h) },
                { label: 'Item', html: l => `<span class="font-monospace text-muted me-1">${h.esc(l.ItemCode)}</span>${h.esc(l.ItemName)}` },
                { label: 'Qty', cls: 'text-end', html: l => `${QcRep.qty(l.Qty)} ${h.esc(l.Unit)}` },
                { label: 'Unit cost', cls: 'text-end', html: l => QcRep.unitCost(l.UnitCost) },
                { label: 'Line cost', cls: 'text-end', html: l => QcRep.unitCost(l.LineCost) }
            ], `<td colspan="4" class="text-end">Reagent ${h.money(r.ReagentCost)} + QC ${h.money(r.QcCost)} + reruns ${h.money(r.RerunCost)} + dead volume ${h.money(r.DeadVolumeCost)} + kit ${h.money(r.KitCost || 0)}</td><td class="text-end">${h.money(r.TotalCost)}</td>`)
        },
        exportExtra: (rows, data) => ({
            sheet: 'Cost lines', title: 'Cost lines',
            head: ['Test', 'Section', 'Item code', 'Item', 'Qty', 'Unit', 'Unit cost', 'Line cost'],
            rows: rows.flatMap(r => linesOf(r, data).map(l => [r.TestName, l.Section, l.ItemCode, l.ItemName, l.Qty, l.Unit, l.UnitCost, l.LineCost]))
        })
    });
})();
</script>
}
