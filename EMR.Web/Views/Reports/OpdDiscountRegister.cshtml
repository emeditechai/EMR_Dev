@{
    ViewData["Title"] = "OPD Discount Register";
    ViewData["ReportSubtitle"] = "who gave which discount on an OPD bill, how large, why and who approved it";
    ViewData["ReportIcon"] = "bi-percent";
    ViewData["ReportAccent"] = "#b45309";
    ViewData["DateLabel"] = "bill date";
    ViewData["ReportModule"] = "OPD";
}
<partial name="_LabReportShell" />

@section Scripts {
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.28/jspdf.plugin.autotable.min.js"></script>
<script src="~/js/lab-report.js" asp-append-version="true"></script>
<script>
(function () {
    const billUrl = '@Url.Action("PrintBill", "OPD")';
    const printBtn = r => r.OPDServiceId ? `<a class="btn btn-sm btn-outline-primary py-0 px-2" target="_blank" title="Print bill" href="${billUrl}?id=${r.OPDServiceId}"><i class="bi bi-printer"></i></a>` : '';
    const COMMON = {
        dataUrl: '@Url.Action("GetOpdReportData", "Reports")',
        seeAll: @((ViewBag.CanSeeAllCollections as bool? ?? false) ? "true" : "false"),
        branchName: '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(User.FindFirst("BranchName")?.Value ?? ""))'
    };
    const dash = '<span class="text-muted">—</span>';
    const pct = v => `${Number(v || 0).toLocaleString('en-IN', { maximumFractionDigits: 1 })}%`;
    LabReport.init({ ...COMMON,
        report: 'discount-register', title: 'OPD Discount Register', defaultRange: 'month',
        searchPlaceholder: 'Bill No, Token, patient, mobile or reason...',
        filters: [
            { id: 'reasonStatus', label: 'Reason', allLabel: 'Any', options: [['MISSING', 'Reason not recorded'], ['RECORDED', 'Reason recorded']] },
            { id: 'approvedBy', label: 'Approved by', allLabel: 'Anyone', fromOptions: 'approvedBy' },
            { id: 'doctorId', label: 'Doctor', allLabel: 'All doctors', fromOptions: 'doctorId' },
            { id: 'enteredBy', label: 'Entered by', allLabel: 'All users', fromOptions: 'enteredBy', adminOnly: true }
        ],
        kpis: [
            { label: 'Total discount', color: '#b45309', value: (s, h) => h.money(s.TotalDiscount), sub: (s, h) => `${h.num(s.BillCount)} discounted bill(s)` },
            { label: 'Share of gross', color: '#475569', value: (s) => pct(s.DiscountPercent), sub: (s, h) => `of ${h.money(s.GrossOfDiscountedBills)} on these bills` },
            { label: 'Largest discount', color: '#7c3aed', value: (s, h) => h.money(s.HighestDiscount), sub: (s) => `up to ${pct(s.HighestPercent)} of a bill` },
            { label: 'No reason recorded', color: '#b91c1c', value: (s, h) => h.num(s.WithoutReasonCount), sub: (s, h) => `${h.money(s.WithoutReasonAmount)} · ${h.num(s.WithoutApproverCount)} without an approver` }
        ],
        groups: [
            { key: 'byApprover', label: 'Approved by', rowField: 'ApprovedById', byId: true },
            { key: 'byReason', label: 'Reason', rowField: 'ReasonGroup', name: (r, h) => r.GroupName === 'Not recorded' ? '<span class="text-danger fst-italic">Not recorded</span>' : h.esc(r.GroupName) },
            { key: 'byDoctor', label: 'Doctor', rowField: 'DoctorId', byId: true },
            { key: 'byDate', label: 'Bill date', rowField: 'BillDay', name: (r, h) => h.fmtD(r.GroupName) },
            { key: 'byEnteredBy', label: 'Entered by', rowField: 'EnteredById', byId: true, adminOnly: true }
        ],
        groupCols: [
            { field: 'BillCount', label: 'Bills', num: true }, { field: 'GrossAmount', label: 'Gross', money: true },
            { field: 'DiscountAmount', label: 'Discount', money: true },
            { field: 'DiscountPercent', label: '% of gross', num: true, total: 'none', fmt: v => pct(v) },
            { field: 'HighestDiscount', label: 'Largest', money: true, total: 'max' }
        ],
        shareOf: 'DiscountAmount',
        cols: [
            { label: 'Bill No / Token', html: (r, h) => `<div class="fw-semibold font-monospace">${h.esc(r.BillNo)}</div><div class="text-muted fs-9">${h.esc(r.TokenNo || '')}</div>`, text: r => r.BillNo },
            { label: 'Bill date', cls: 'text-nowrap', html: (r, h) => h.fmtDT(r.BillDate), text: (r, h) => h.fmtDT(r.BillDate) },
            { label: 'Patient', html: (r, h) => `<div class="fw-semibold">${h.esc(r.PatientName)}</div><div class="text-muted fs-9">${h.esc(r.PatientCode)}${r.PhoneNumber ? ' · ' + h.esc(r.PhoneNumber) : ''}</div>`, text: r => `${r.PatientName} (${r.PatientCode})` },
            { label: 'Doctor', html: (r, h) => h.esc(r.DoctorName), text: r => r.DoctorName },
            { label: 'Gross', cls: 'text-end amt', html: (r, h) => h.money(r.GrossAmount), text: r => r.GrossAmount, sum: 'GrossAmount' },
            { label: 'Discount', cls: 'text-end amt', html: (r, h) => `<span class="fw-semibold text-warning-emphasis">${h.money(r.DiscountAmount)}</span><div class="text-muted fs-9">${pct(r.DiscountPercent)}${r.DiscountType === 'P' && r.DiscountValue ? ' (given as ' + Number(r.DiscountValue) + '%)' : ''}</div>`, text: r => r.DiscountAmount, sum: 'DiscountAmount' },
            { label: 'Net', cls: 'text-end amt', html: (r, h) => h.money(r.NetAmount), text: r => r.NetAmount, sum: 'NetAmount' },
            { label: 'Reason', html: (r, h) => r.DiscountReason ? h.esc(r.DiscountReason) : '<span class="text-danger fst-italic">Not recorded</span>', text: r => r.DiscountReason || 'Not recorded' },
            { label: 'Approved by', cls: 'text-nowrap', html: (r, h) => r.ApprovedBy ? `${h.esc(r.ApprovedBy)}${r.ApprovedDate ? `<div class="text-muted fs-9">${h.fmtDT(r.ApprovedDate)}</div>` : ''}` : '<span class="text-danger fst-italic">Not recorded</span>', text: r => r.ApprovedBy || 'Not recorded' },
            { label: 'Entered by', cls: 'text-nowrap', html: (r, h) => h.esc(r.EnteredBy), text: r => r.EnteredBy },
            { label: 'Bill', cls: 'text-center no-print', noExport: true, html: r => printBtn(r) }
        ],
        rowClass: r => r.IsBillActive ? '' : 'row-muted'
    });
})();
</script>
}
