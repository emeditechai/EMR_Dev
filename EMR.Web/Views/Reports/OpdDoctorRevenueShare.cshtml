@{
    ViewData["Title"] = "Doctor Revenue Share";
    ViewData["ReportSubtitle"] = "management: OPD revenue and collection of each doctor, the doctor's share earned and what stays with the hospital";
    ViewData["ReportIcon"] = "bi-pie-chart";
    ViewData["ReportAccent"] = "#be185d";
    ViewData["DateLabel"] = "bill date";
    ViewData["ReportModule"] = "OPD";
}
<partial name="_LabReportShell" />

@section Scripts {
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.28/jspdf.plugin.autotable.min.js"></script>
<script src="~/js/lab-report.js" asp-append-version="true"></script>
<script>
(function () {
    const COMMON = {
        dataUrl: '@Url.Action("GetOpdReportData", "Reports")',
        seeAll: @((ViewBag.CanSeeAllCollections as bool? ?? false) ? "true" : "false"),
        branchName: '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(User.FindFirst("BranchName")?.Value ?? ""))'
    };
    const voucherUrl = '@Url.Action("Voucher", "DoctorDisbursal")';
    const dash = '<span class="text-muted">—</span>';
    const voucherBtn = (id) => id ? `<a class="btn btn-sm btn-outline-primary py-0 px-2" target="_blank" title="Print payout voucher" href="${voucherUrl}/${id}"><i class="bi bi-printer"></i></a>` : '';
    const ST = { OPEN: ['Not settled', 'bg-light text-dark border-secondary-subtle'], PREPARED: ['Awaiting approval', 'bg-warning-subtle text-warning-emphasis border-warning-subtle'],
                 APPROVED: ['Approved · to pay', 'bg-primary-subtle text-primary border-primary-subtle'], PAID: ['Paid', 'bg-success-subtle text-success border-success-subtle'],
                 REJECTED: ['Rejected', 'bg-danger-subtle text-danger border-danger-subtle'], CANCELLED: ['Cancelled', 'bg-secondary-subtle text-secondary border-secondary-subtle'],
                 NOT_SETTLED: ['Not settled', 'bg-light text-dark border-secondary-subtle'], AWAITING_APPROVAL: ['Awaiting approval', 'bg-warning-subtle text-warning-emphasis border-warning-subtle'],
                 AWAITING_PAYMENT: ['Approved · to pay', 'bg-primary-subtle text-primary border-primary-subtle'] };
    const st = (v, h) => { const s = ST[v] || [v, '']; return h.pill(s[0], s[1]); };
    const stName = (r, h) => st(r.GroupName, h);
    const LT = { SHARE: ['Share', 'text-success'], TOPUP: ['Top-up', 'text-primary'], RECOVERY: ['Recovery', 'text-danger'] };
    const lt = (v) => { const x = LT[v] || [v, '']; return `<span class="fw-semibold ${x[1]}">${x[0]}</span>`; };
    const neg = (v, h) => Number(v) < 0 ? `<span class="text-danger">-${h.money(-v)}</span>` : (Number(v) ? h.money(v) : dash);

    LabReport.init({ ...COMMON,
        report: 'doctor-revenue-share', title: 'Doctor Revenue Share', defaultRange: 'month',
        searchPlaceholder: 'Bill No, patient...',
        filters: [
            { id: 'doctorId', label: 'Doctor', allLabel: 'All doctors', fromOptions: 'doctorId' },
            { id: 'specialityId', label: 'Speciality', allLabel: 'All specialities', fromOptions: 'specialityId' },
            { id: 'ruleStatus', label: 'Rule', allLabel: 'All visits', options: [['RULE', 'With a commission rule'], ['NORULE', 'Without a rule']] }
        ],
        kpis: [
            { label: 'OPD revenue', color: '#1d4ed8', value: (s, h) => h.money(s.Revenue), sub: (s, h) => `${h.num(s.Visits)} visit(s) · ${h.num(s.Doctors)} doctor(s)` },
            { label: 'Collected', color: '#0f766e', value: (s, h) => h.money(s.Collected), sub: () => 'on these bills, so far' },
            { label: 'Doctor share', color: '#be185d', value: (s, h) => h.money(s.DoctorShare), sub: (s, h) => `${s.DoctorSharePct ?? 0}% of collection · ${h.money(s.ShareOnDues)} more when dues are collected` },
            { label: 'Hospital share', color: '#16a34a', value: (s, h) => h.money(s.HospitalShare), sub: () => 'collection less doctor share' },
            { label: 'Without a rule', color: '#b45309', value: (s, h) => h.num(s.VisitsWithoutRule), sub: () => 'visits earning no doctor share' }
        ],
        groups: [
            { key: 'byDoctor', label: 'Doctor', rowField: 'DoctorId', byId: true },
            { key: 'bySpeciality', label: 'Speciality', rowField: 'SpecialityId', byId: true },
            { key: 'byMonth', label: 'Month', rowField: 'Month', name: (r, h) => h.fmtD(r.GroupName + '-01').replace(/^\d+ /, '') }
        ],
        groupCols: [
            { field: 'Visits', label: 'Visits', num: true }, { field: 'Revenue', label: 'Revenue', money: true }, { field: 'Collected', label: 'Collected', money: true },
            { field: 'DoctorShare', label: 'Doctor share', money: true }, { field: 'HospitalShare', label: 'Hospital share', money: true },
            { field: 'DoctorSharePct', label: 'Doctor %', num: true, total: 'none', fmt: (v) => v === null || v === undefined ? '—' : Number(v) + '%' },
            { field: 'VisitsWithoutRule', label: 'No rule', num: true }
        ],
        shareOf: 'Collected',
        cols: [
            { label: 'Bill', html: (r, h) => `<div class="font-monospace">${h.esc(r.BillNo || '')}</div><div class="text-muted fs-9">${h.fmtD(r.BillDate)} · ${h.esc(r.TokenNo || '')}</div>`, text: r => r.BillNo },
            { label: 'Patient', html: (r, h) => `<div>${h.esc(r.PatientName)}</div><div class="text-muted fs-9">${h.esc(r.PatientCode || '')}</div>`, text: r => r.PatientName },
            { label: 'Doctor', html: (r, h) => `<div class="fw-semibold">${h.esc(r.DoctorName)}</div><div class="text-muted fs-9">${h.esc(r.Speciality)}</div>`, text: r => r.DoctorName },
            { label: 'Revenue', cls: 'text-end amt', html: (r, h) => h.money(r.Revenue), text: r => r.Revenue, sum: 'Revenue' },
            { label: 'Collected', cls: 'text-end amt', html: (r, h) => h.money(r.Collected), text: r => r.Collected, sum: 'Collected' },
            { label: 'Rule', html: (r, h) => r.RuleStatus === 'NORULE' ? '<span class="badge bg-warning-subtle text-warning-emphasis border">No rule</span>' : `<span class="fs-9">${h.esc(r.RuleText)}</span>`, text: r => r.RuleText },
            { label: 'Doctor share', cls: 'text-end amt fw-semibold', html: (r, h) => h.money(r.DoctorShare), text: r => r.DoctorShare, sum: 'DoctorShare' },
            { label: 'Hospital share', cls: 'text-end amt text-success', html: (r, h) => h.money(r.HospitalShare), text: r => r.HospitalShare, sum: 'HospitalShare' }
        ]
    });
})();
</script>
}
