@{
    ViewData["Title"] = "Doctor Share Register";
    ViewData["ReportSubtitle"] = "day-wise, doctor-wise: the share each doctor earned as money was collected, with recoveries, and where it stands";
    ViewData["ReportIcon"] = "bi-person-badge";
    ViewData["ReportAccent"] = "#16a34a";
    ViewData["DateLabel"] = "share date";
    ViewData["ReportModule"] = "OPD";
}
<partial name="_LabReportShell" />

@section Scripts {
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.28/jspdf.plugin.autotable.min.js"></script>
<script src="~/js/lab-report.js" asp-append-version="true"></script>
<script>
(function () {
    const COMMON = {
        dataUrl: '@Url.Action("GetOpdReportData", "Reports")',
        seeAll: @((ViewBag.CanSeeAllCollections as bool? ?? false) ? "true" : "false"),
        branchName: '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(User.FindFirst("BranchName")?.Value ?? ""))'
    };
    const voucherUrl = '@Url.Action("Voucher", "DoctorDisbursal")';
    const dash = '<span class="text-muted">—</span>';
    const voucherBtn = (id) => id ? `<a class="btn btn-sm btn-outline-primary py-0 px-2" target="_blank" title="Print payout voucher" href="${voucherUrl}/${id}"><i class="bi bi-printer"></i></a>` : '';
    const ST = { OPEN: ['Not settled', 'bg-light text-dark border-secondary-subtle'], PREPARED: ['Awaiting approval', 'bg-warning-subtle text-warning-emphasis border-warning-subtle'],
                 APPROVED: ['Approved · to pay', 'bg-primary-subtle text-primary border-primary-subtle'], PAID: ['Paid', 'bg-success-subtle text-success border-success-subtle'],
                 REJECTED: ['Rejected', 'bg-danger-subtle text-danger border-danger-subtle'], CANCELLED: ['Cancelled', 'bg-secondary-subtle text-secondary border-secondary-subtle'],
                 NOT_SETTLED: ['Not settled', 'bg-light text-dark border-secondary-subtle'], AWAITING_APPROVAL: ['Awaiting approval', 'bg-warning-subtle text-warning-emphasis border-warning-subtle'],
                 AWAITING_PAYMENT: ['Approved · to pay', 'bg-primary-subtle text-primary border-primary-subtle'] };
    const st = (v, h) => { const s = ST[v] || [v, '']; return h.pill(s[0], s[1]); };
    const stName = (r, h) => st(r.GroupName, h);
    const LT = { SHARE: ['Share', 'text-success'], TOPUP: ['Top-up', 'text-primary'], RECOVERY: ['Recovery', 'text-danger'] };
    const lt = (v) => { const x = LT[v] || [v, '']; return `<span class="fw-semibold ${x[1]}">${x[0]}</span>`; };
    const neg = (v, h) => Number(v) < 0 ? `<span class="text-danger">-${h.money(-v)}</span>` : (Number(v) ? h.money(v) : dash);

    LabReport.init({ ...COMMON,
        report: 'doctor-share', title: 'Doctor Share Register', defaultRange: 'today',
        searchPlaceholder: 'Bill No, patient, settlement no...',
        filters: [
            { id: 'settleStatus', label: 'Stage', allLabel: 'All', options: [['OPEN', 'Not settled'], ['PREPARED', 'Awaiting approval'], ['APPROVED', 'Approved · to pay'], ['PAID', 'Paid']] },
            { id: 'lineType', label: 'Type', allLabel: 'All', options: [['SHARE', 'Share'], ['TOPUP', 'Top-up (later collection)'], ['RECOVERY', 'Recovery (cancel / refund)']] },
            { id: 'doctorId', label: 'Doctor', allLabel: 'All doctors', fromOptions: 'doctorId', adminOnly: true }
        ],
        kpis: [
            { label: 'Net share', color: '#16a34a', value: (s, h) => h.money(s.NetShare), sub: (s, h) => `${h.num(s.Visits)} visit(s) · ${h.num(s.Doctors)} doctor(s) · top ${h.esc(s.TopDoctor || '—')}` },
            { label: 'Collected', color: '#1d4ed8', value: (s, h) => h.money(s.Collected), sub: () => 'the basis the share was worked out on' },
            { label: 'Recoveries', color: '#b91c1c', value: (s, h) => h.money(s.Recoveries), sub: (s, h) => `on gross share ${h.money(s.GrossShare)}` },
            { label: 'Not settled', color: '#b45309', value: (s, h) => h.money(s.OpenAmount), sub: (s, h) => `${h.money(s.InSettlement)} on settlements awaiting approval / payment` },
            { label: 'Paid', color: '#0f766e', value: (s, h) => h.money(s.PaidAmount), sub: () => 'share already paid out (before TDS)' }
        ],
        groups: [
            { key: 'byDoctor', label: 'Doctor', rowField: 'DoctorId', byId: true },
            { key: 'byDate', label: 'Share date', rowField: 'ShareDay', name: (r, h) => h.fmtD(r.GroupName) },
            { key: 'bySpeciality', label: 'Speciality', rowField: 'Speciality' },
            { key: 'byStatus', label: 'Stage', rowField: 'SettleStatus', name: stName },
            { key: 'byLineType', label: 'Type', rowField: 'LineType', name: (r) => lt(r.GroupName) }
        ],
        groupCols: [
            { field: 'Visits', label: 'Visits', num: true }, { field: 'Collected', label: 'Collected', money: true },
            { field: 'GrossShare', label: 'Share', money: true }, { field: 'Recoveries', label: 'Recoveries', money: true },
            { field: 'NetShare', label: 'Net share', money: true }, { field: 'OpenAmount', label: 'Not settled', money: true }, { field: 'PaidAmount', label: 'Paid', money: true }
        ],
        shareOf: 'NetShare',
        cols: [
            { label: 'Share date', cls: 'text-nowrap', html: (r, h) => h.fmtD(r.ShareDate), text: (r, h) => h.fmtD(r.ShareDate) },
            { label: 'Doctor', html: (r, h) => `<div class="fw-semibold">${h.esc(r.DoctorName)}</div><div class="text-muted fs-9">${h.esc(r.Speciality)}</div>`, text: r => r.DoctorName },
            { label: 'Type', html: r => lt(r.LineType), text: r => (LT[r.LineType] || [r.LineType])[0] },
            { label: 'Bill', html: (r, h) => `<div class="font-monospace">${h.esc(r.BillNo || '')}</div><div class="text-muted fs-9">${h.esc(r.TokenNo || '')} · ${h.fmtD(r.BillDate)}</div>`, text: r => r.BillNo },
            { label: 'Patient', html: (r, h) => `<div>${h.esc(r.PatientName)}</div><div class="text-muted fs-9">${h.esc(r.PatientCode || '')}</div>`, text: r => r.PatientName },
            { label: 'Collected', cls: 'text-end amt', html: (r, h) => h.money(r.Collected), text: r => r.Collected, sum: 'Collected' },
            { label: 'Rule', html: (r, h) => `<span class="fs-9">${h.esc(r.RuleText)}</span>`, text: r => r.RuleText },
            { label: 'Share', cls: 'text-end amt fw-semibold', html: (r, h) => neg(r.Share, h), text: r => r.Share, sum: 'Share' },
            { label: 'Stage', html: (r, h) => st(r.SettleStatus, h) + (r.SettlementNo ? `<div class="text-muted fs-9">${h.esc(r.SettlementNo)}${r.PaymentDate ? ' · ' + h.fmtD(r.PaymentDate) : ''}</div>` : ''), text: r => (ST[r.SettleStatus] || [r.SettleStatus])[0] },
            { label: 'Voucher', cls: 'text-center no-print', noExport: true, html: r => voucherBtn(r.SettlementId) }
        ],
        rowClass: r => r.LineType === 'RECOVERY' ? 'table-danger' : ''
    });
})();
</script>
}
