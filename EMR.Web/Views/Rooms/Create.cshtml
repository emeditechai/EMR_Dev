@model EMR.Web.Models.ViewModels.RoomFormViewModel
@{
    ViewData["Title"] = "Add IPD Room";
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h1 class="h3 mb-0 fw-bold">Add IPD Room</h1>
        <small class="text-muted">Create an inpatient room mapped to building, floor, and parent ward</small>
    </div>

    <a asp-action="Index" class="btn btn-outline-secondary btn-sm px-3">
        <i class="bi bi-arrow-left me-1"></i> Back to List
    </a>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-header bg-white border-bottom py-3">
                <h6 class="mb-0 fw-bold text-primary"><i class="bi bi-door-open me-2"></i>Room Information</h6>
            </div>
            <div class="card-body p-4">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="CompanyId" />
                    <input type="hidden" asp-for="BranchId" />

                    <div class="row g-3">
                        <!-- Building -->
                        <div class="col-md-4">
                            <label asp-for="BuildingId" class="form-label fw-semibold required-label">
                                Building <span class="text-danger">*</span>
                            </label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="bi bi-buildings text-muted"></i></span>
                                <select id="buildingSelect" asp-for="BuildingId" asp-items="Model.BuildingOptions" class="form-select" required>
                                    <option value="">-- Select Building --</option>
                                </select>
                            </div>
                            <span asp-validation-for="BuildingId" class="text-danger small d-block mt-1"></span>
                        </div>

                        <!-- Floor (Cascading) -->
                        <div class="col-md-4">
                            <label asp-for="FloorId" class="form-label fw-semibold required-label">
                                Floor <span class="text-danger">*</span>
                            </label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="bi bi-layers text-muted"></i></span>
                                <select id="floorSelect" asp-for="FloorId" asp-items="Model.FloorOptions" class="form-select" required>
                                    <option value="">-- Select Floor --</option>
                                </select>
                            </div>
                            <span asp-validation-for="FloorId" class="text-danger small d-block mt-1"></span>
                        </div>

                        <!-- Ward (Cascading) -->
                        <div class="col-md-4">
                            <label asp-for="WardId" class="form-label fw-semibold required-label">
                                Parent Ward <span class="text-danger">*</span>
                            </label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="bi bi-hospital text-muted"></i></span>
                                <select id="wardSelect" asp-for="WardId" asp-items="Model.WardOptions" class="form-select" required>
                                    <option value="">-- Select Ward --</option>
                                </select>
                            </div>
                            <span asp-validation-for="WardId" class="text-danger small d-block mt-1"></span>
                        </div>

                        <!-- Room Number -->
                        <div class="col-md-4">
                            <label asp-for="RoomNumber" class="form-label fw-semibold required-label">
                                Room Number <span class="text-danger">*</span>
                            </label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="bi bi-hash text-muted"></i></span>
                                <input asp-for="RoomNumber" class="form-control text-uppercase font-monospace"
                                       maxlength="50" placeholder="e.g. 101-A" required
                                       oninput="this.value=this.value.toUpperCase()" />
                            </div>
                            <span asp-validation-for="RoomNumber" class="text-danger small d-block mt-1"></span>
                        </div>

                        <!-- Room Type -->
                        <div class="col-md-4">
                            <label asp-for="RoomType" class="form-label fw-semibold required-label">
                                Room Type <span class="text-danger">*</span>
                            </label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="bi bi-tag text-muted"></i></span>
                                <select asp-for="RoomType" asp-items="Model.RoomTypeOptions" class="form-select" required></select>
                            </div>
                            <span asp-validation-for="RoomType" class="text-danger small d-block mt-1"></span>
                        </div>

                        <!-- Room Category -->
                        <div class="col-md-4">
                            <label asp-for="RoomCategory" class="form-label fw-semibold required-label">
                                Room Category <span class="text-danger">*</span>
                            </label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="bi bi-bookmark-star text-muted"></i></span>
                                <select asp-for="RoomCategory" asp-items="Model.RoomCategoryOptions" class="form-select" required></select>
                            </div>
                            <span asp-validation-for="RoomCategory" class="text-danger small d-block mt-1"></span>
                        </div>

                        <!-- Bed Capacity -->
                        <div class="col-md-6">
                            <label asp-for="BedCapacity" class="form-label fw-semibold required-label">
                                Bed Capacity <span class="text-danger">*</span>
                            </label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="bi bi-heart-pulse text-muted"></i></span>
                                <input asp-for="BedCapacity" type="number" min="1" max="100" class="form-control" placeholder="e.g. 1" required />
                            </div>
                            <span asp-validation-for="BedCapacity" class="text-danger small d-block mt-1"></span>
                        </div>

                        <!-- Isolation Room Toggle -->
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Isolation Room</label>
                            <div class="form-check form-switch p-2 border rounded bg-light mt-1">
                                <input class="form-check-input ms-0 me-2" type="checkbox" role="switch" asp-for="IsIsolation">
                                <label class="form-check-label fw-semibold" asp-for="IsIsolation">Isolation / Negative Pressure Room</label>
                            </div>
                        </div>

                        <!-- Description / Amenities -->
                        <div class="col-12">
                            <label asp-for="Description" class="form-label fw-semibold">Description / Amenities</label>
                            <textarea asp-for="Description" class="form-control" rows="3" placeholder="Attached bathroom, motorized bed, oxygen pipeline, TV, sofa-cum-bed for attendant..."></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>

                        <!-- Status -->
                        <div class="col-12">
                            <label class="form-label fw-semibold">Status</label>
                            <div class="form-check form-switch p-2 border rounded bg-light">
                                <input class="form-check-input ms-0 me-2" type="checkbox" role="switch" asp-for="IsActive">
                                <label class="form-check-label fw-semibold" asp-for="IsActive">Active Room</label>
                            </div>
                        </div>
                    </div>

                    <hr class="my-4" />

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-outline-secondary px-3">Cancel</a>
                        <button type="submit" class="btn btn-primary px-4 shadow-sm">
                            <i class="bi bi-floppy-fill me-1"></i> Save Room
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const buildingSelect = document.getElementById('buildingSelect');
            const floorSelect = document.getElementById('floorSelect');
            const wardSelect = document.getElementById('wardSelect');

            buildingSelect.addEventListener('change', async function () {
                const buildingId = this.value;
                floorSelect.innerHTML = '<option value="">-- Select Floor --</option>';
                wardSelect.innerHTML = '<option value="">-- Select Ward --</option>';

                if (!buildingId) return;

                try {
                    const res = await fetch(`/Rooms/GetFloorsByBuilding?buildingId=${buildingId}`);
                    if (res.ok) {
                        const floors = await res.json();
                        floors.forEach(f => {
                            const opt = document.createElement('option');
                            opt.value = f.floorId;
                            opt.textContent = `${f.floorName} (${f.floorCode})`;
                            floorSelect.appendChild(opt);
                        });
                    }
                } catch (err) {
                    console.error('Error fetching floors:', err);
                }
            });

            floorSelect.addEventListener('change', async function () {
                const floorId = this.value;
                wardSelect.innerHTML = '<option value="">-- Select Ward --</option>';

                if (!floorId) return;

                try {
                    const res = await fetch(`/Rooms/GetWardsByFloor?floorId=${floorId}`);
                    if (res.ok) {
                        const wards = await res.json();
                        wards.forEach(w => {
                            const opt = document.createElement('option');
                            opt.value = w.wardId;
                            opt.textContent = `${w.wardName} (${w.wardCode}) - ${w.wardType}`;
                            wardSelect.appendChild(opt);
                        });
                    }
                } catch (err) {
                    console.error('Error fetching wards:', err);
                }
            });
        });
    </script>
}
