@model EMR.Web.Models.ViewModels.RoomDetailsViewModel
@{
    ViewData["Title"] = $"IPD Room {Model.RoomNumber} - Details";
}

<div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-2">
    <div class="d-flex align-items-center gap-2">
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left"></i></a>
        <div>
            <h1 class="h3 mb-0 fw-bold">IPD Room @Model.RoomNumber</h1>
            <small class="text-muted">Parent Ward: <strong class="text-primary">@Model.WardName (@Model.WardCode)</strong></small>
        </div>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.RoomId" class="btn btn-outline-primary btn-sm px-3">
            <i class="bi bi-pencil me-1"></i> Edit IPD Room
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm px-3">
            <i class="bi bi-list me-1"></i> All IPD Rooms
        </a>
    </div>
</div>


<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-header bg-white border-bottom py-3">
                <h6 class="mb-0 fw-bold text-primary"><i class="bi bi-door-open me-2"></i>Room Details & Location</h6>
            </div>
            <div class="card-body p-4">
                <div class="row g-4">
                    <div class="col-md-6">
                        <p class="text-muted small mb-1 text-uppercase fw-semibold">Room Number</p>
                        <p class="fw-bold font-monospace fs-5 mb-0">
                            <span class="badge text-bg-light border text-dark">@Model.RoomNumber</span>
                        </p>
                    </div>
                    <div class="col-md-6">
                        <p class="text-muted small mb-1 text-uppercase fw-semibold">Parent Ward</p>
                        <p class="fw-semibold fs-5 mb-0">
                            <a asp-controller="Wards" asp-action="Details" asp-route-id="@Model.WardId" class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 text-decoration-none px-3 py-2">
                                <i class="bi bi-hospital me-1"></i>@Model.WardName (@Model.WardCode)
                            </a>
                        </p>
                    </div>

                    <div class="col-md-6">
                        <p class="text-muted small mb-1 text-uppercase fw-semibold">Building & Floor</p>
                        <p class="fw-semibold fs-5 mb-0 text-dark">
                            <i class="bi bi-layers text-primary me-1"></i>@Model.FloorName (@Model.FloorCode)
                            <small class="text-muted d-block mt-1"><i class="bi bi-buildings me-1"></i>@Model.BuildingName (@Model.BuildingCode)</small>
                        </p>
                    </div>

                    <div class="col-md-6">
                        <p class="text-muted small mb-1 text-uppercase fw-semibold">Room Type</p>
                        <p class="fw-semibold fs-5 mb-0 text-dark">
                            @Model.RoomType
                        </p>
                    </div>

                    <div class="col-md-6">
                        <p class="text-muted small mb-1 text-uppercase fw-semibold">Room Category</p>
                        <span class="badge bg-info bg-opacity-10 text-info border border-info border-opacity-25 fs-6 px-3 py-2">
                            @Model.RoomCategory
                        </span>
                    </div>

                    <div class="col-md-6">
                        <p class="text-muted small mb-1 text-uppercase fw-semibold">Bed Capacity</p>
                        <span class="fw-bold text-dark fs-5">@Model.BedCapacity Bed(s)</span>
                    </div>

                    <div class="col-md-6">
                        <p class="text-muted small mb-1 text-uppercase fw-semibold">Isolation Room Facility</p>
                        @if (Model.IsIsolation)
                        {
                            <span class="badge bg-warning text-dark px-3 py-2"><i class="bi bi-shield-shaded me-1"></i>Isolation / Negative Pressure</span>
                        }
                        else
                        {
                            <span class="text-muted">Standard Inpatient Room</span>
                        }
                    </div>

                    <div class="col-md-6">
                        <p class="text-muted small mb-1 text-uppercase fw-semibold">Status</p>
                        @if (Model.IsActive)
                        {
                            <span class="badge text-bg-success px-3 py-2">Active Room</span>
                        }
                        else
                        {
                            <span class="badge text-bg-secondary px-3 py-2">Inactive</span>
                        }
                    </div>

                    <div class="col-12">
                        <p class="text-muted small mb-1 text-uppercase fw-semibold">Description & Amenities</p>
                        <p class="text-dark bg-light p-3 rounded-2 mb-0">
                            @(string.IsNullOrWhiteSpace(Model.Description) ? "No description provided." : Model.Description)
                        </p>
                    </div>

                    <div class="col-12 pt-3 border-top text-muted small d-flex justify-content-between flex-wrap gap-2">
                        <div>Created: @Model.CreatedDate.ToString("dd MMM yyyy, HH:mm")</div>
                        @if (Model.ModifiedDate.HasValue)
                        {
                            <div>Last Modified: @Model.ModifiedDate.Value.ToString("dd MMM yyyy, HH:mm")</div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
