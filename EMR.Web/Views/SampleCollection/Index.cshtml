@model EMR.Web.Models.ViewModels.SampleCollectionDashboardViewModel
@{
    ViewData["Title"] = "Sample Collection Management";
}

@section HeadStyles {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" />
}

<div class="container-fluid px-2 py-1 sample-mgmt-wrapper">
    <!-- Breadcrumb & Top Bar -->
    <div class="d-flex justify-content-between align-items-center mb-1">
        <div>

            <h4 class="mb-0 fw-bold text-dark d-flex align-items-center">
                <i class="bi bi-eyedropper text-primary me-2"></i>Sample Collection Management
                <span class="badge bg-primary-subtle text-primary border border-primary-subtle ms-2 fs-8 fw-semibold">B2C Patients</span>
            </h4>
        </div>
        <div class="d-flex gap-2 align-items-center">
            <button type="button" class="btn btn-outline-primary btn-sm d-flex align-items-center justify-content-center shadow-sm" id="btnRefreshList" style="width: 32px; height: 32px;" title="Refresh">
                <i class="bi bi-arrow-clockwise"></i>
            </button>
        </div>
    </div>

    <!-- Summary Stats Cards -->
    <div class="row g-2 mb-2">
        <div class="col-6 col-md-3">
            <div class="card shadow-sm border-0 border-start border-primary border-4 rounded-3 h-100 stat-card" data-status="All" style="cursor: pointer;">
                <div class="card-body p-2 d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted fs-8 fw-semibold text-uppercase">Total Orders</span>
                        <h4 class="mb-0 fw-bold text-dark mt-1" id="statTotalOrders">@Model.Stats.TotalOrders</h4>
                    </div>
                    <div class="stat-icon bg-primary-subtle text-primary rounded-circle">
                        <i class="bi bi-journal-medical fs-5"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card shadow-sm border-0 border-start border-warning border-4 rounded-3 h-100 stat-card" data-status="Pending" style="cursor: pointer;">
                <div class="card-body p-2 d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted fs-8 fw-semibold text-uppercase">Pending</span>
                        <h4 class="mb-0 fw-bold text-warning mt-1" id="statPendingOrders">@Model.Stats.PendingOrders</h4>
                    </div>
                    <div class="stat-icon bg-warning-subtle text-warning rounded-circle">
                        <i class="bi bi-hourglass-split fs-5"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card shadow-sm border-0 border-start border-info border-4 rounded-3 h-100 stat-card" data-status="Partial" style="cursor: pointer;">
                <div class="card-body p-2 d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted fs-8 fw-semibold text-uppercase">Partially Collected</span>
                        <h4 class="mb-0 fw-bold text-info mt-1" id="statPartialOrders">@Model.Stats.PartialOrders</h4>
                    </div>
                    <div class="stat-icon bg-info-subtle text-info rounded-circle">
                        <i class="bi bi-pie-chart fs-5"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card shadow-sm border-0 border-start border-success border-4 rounded-3 h-100 stat-card" data-status="Collected" style="cursor: pointer;">
                <div class="card-body p-2 d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted fs-8 fw-semibold text-uppercase">Fully Collected</span>
                        <h4 class="mb-0 fw-bold text-success mt-1" id="statCollectedOrders">@Model.Stats.CollectedOrders</h4>
                    </div>
                    <div class="stat-icon bg-success-subtle text-success rounded-circle">
                        <i class="bi bi-check2-circle fs-5"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Filter Toolbar Card -->
    <div class="card shadow-sm border-0 rounded-3 mb-3 filter-toolbar-card">
        <div class="card-body p-2 px-3">
            <div class="row g-2 align-items-center">
                <!-- Date Filter Type -->
                <div class="col-6 col-md-2">
                    <label class="form-label fs-8 text-muted mb-1 fw-semibold">Filter By Date</label>
                    <select id="selDateFilterType" class="form-select form-select-sm">
                        <option value="BookingDate" selected="@(Model.DateFilterType == "BookingDate")">Booking Date Time</option>
                        <option value="OrderDate" selected="@(Model.DateFilterType == "OrderDate")">Order / Bill Date</option>
                    </select>
                </div>
                <!-- From Date -->
                <div class="col-6 col-md-2">
                    <label class="form-label fs-8 text-muted mb-1 fw-semibold">From Date</label>
                    <input type="date" id="txtFromDate" class="form-control form-control-sm" value="@Model.FromDate.ToString("yyyy-MM-dd")" />
                </div>
                <!-- To Date -->
                <div class="col-6 col-md-2">
                    <label class="form-label fs-8 text-muted mb-1 fw-semibold">To Date</label>
                    <input type="date" id="txtToDate" class="form-control form-control-sm" value="@Model.ToDate.ToString("yyyy-MM-dd")" />
                </div>
                <!-- Quick Date Pills -->
                <div class="col-6 col-md-3">
                    <label class="form-label fs-8 text-muted mb-1 fw-semibold">Quick Select</label>
                    <div class="btn-group btn-group-sm w-100" role="group">
                        <button type="button" class="btn btn-outline-secondary btn-quick-date" data-range="today">Today</button>
                        <button type="button" class="btn btn-outline-secondary btn-quick-date" data-range="yesterday">Yesterday</button>
                        <button type="button" class="btn btn-outline-secondary btn-quick-date" data-range="week">Last 7D</button>
                        <button type="button" class="btn btn-outline-secondary btn-quick-date" data-range="month">This Month</button>
                    </div>
                </div>
                <!-- Search Box -->
                <div class="col-12 col-md-3">
                    <label class="form-label fs-8 text-muted mb-1 fw-semibold">Search Orders / Patient</label>
                    <div class="input-group input-group-sm">
                        <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
                        <input type="text" id="txtSearch" class="form-control border-start-0" placeholder="Token, Bill, Patient, Phone... (Alt+S)" value="@Model.Search" />
                        <button class="btn btn-primary px-3" type="button" id="btnApplyFilter">Filter</button>
                    </div>
                </div>
            </div>

            <!-- Status Filter Pills -->
            <div class="d-flex flex-wrap gap-2 mt-2 pt-2 border-top align-items-center">
                <span class="fs-8 text-muted fw-semibold me-1"><i class="bi bi-funnel me-1"></i>Status:</span>
                <button type="button" class="btn btn-sm btn-filter-status @(Model.StatusFilter == "All" ? "btn-dark text-white active fw-bold shadow-sm" : "btn-outline-dark")" data-status="All">All</button>
                <button type="button" class="btn btn-sm btn-filter-status @(Model.StatusFilter == "Pending" ? "btn-warning text-dark active fw-bold shadow-sm" : "btn-outline-warning text-dark")" data-status="Pending">
                    <i class="bi bi-hourglass-split me-1"></i>Pending
                </button>
                <button type="button" class="btn btn-sm btn-filter-status @(Model.StatusFilter == "Partial" ? "btn-info text-dark active fw-bold shadow-sm" : "btn-outline-info text-dark")" data-status="Partial">
                    <i class="bi bi-pie-chart me-1"></i>Partially Collected
                </button>
                <button type="button" class="btn btn-sm btn-filter-status @(Model.StatusFilter == "Collected" ? "btn-success text-white active fw-bold shadow-sm" : "btn-outline-success")" data-status="Collected">
                    <i class="bi bi-check2-circle me-1"></i>Collected
                </button>
                <button type="button" class="btn btn-sm btn-filter-status @(Model.StatusFilter == "Re Collect" ? "btn-secondary text-white active fw-bold shadow-sm" : "btn-outline-secondary")" data-status="Re Collect">
                    <i class="bi bi-arrow-repeat me-1"></i>Re Collect
                </button>
                <button type="button" class="btn btn-sm btn-filter-status @(Model.StatusFilter == "Rejected" ? "btn-danger text-white active fw-bold shadow-sm" : "btn-outline-danger")" data-status="Rejected">
                    <i class="bi bi-x-circle me-1"></i>Rejected
                </button>
                <span class="ms-auto fs-8 text-muted fw-semibold" id="lblOrderCount">Showing @Model.Headers.Count orders</span>
            </div>
        </div>
    </div>

    <!-- MAIN DUAL-PANE SPLIT CONTAINER -->
    <div class="row g-3 dual-pane-layout">
        <!-- LEFT PANEL: Orders Header Queue (col-lg-5 col-xl-5) -->
        <div class="col-lg-5 col-xl-5 h-100">
            <div class="card shadow-sm border-0 rounded-3 h-100 master-card d-flex flex-column">
                <div class="card-header bg-white py-2 px-3 border-bottom d-flex justify-content-between align-items-center flex-shrink-0">
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge bg-primary rounded-circle p-1 d-inline-flex align-items-center justify-content-center" style="width: 20px; height: 20px;">
                            <i class="bi bi-list-task text-white fs-9"></i>
                        </span>
                        <h6 class="mb-0 fw-bold text-dark">Lab Orders &amp; Bookings</h6>
                    </div>
                    <span class="fs-9 text-muted"><i class="bi bi-hand-index me-1"></i>Click row to select</span>
                </div>
                <div class="card-body p-0 flex-grow-1 overflow-auto master-table-scroll-wrap">
                    <table class="table table-hover align-middle mb-0 master-order-table" id="tblOrderHeaders">
                        <thead class="table-light sticky-top fs-8 text-uppercase border-bottom">
                            <tr>
                                <th style="width: 25%;">Booking / Status</th>
                                <th style="width: 24%;">Token / Bill</th>
                                <th style="width: 28%;">Patient Details</th>
                                <th style="width: 23%;">Order Summary</th>
                            </tr>
                        </thead>
                        <tbody id="tblOrderHeadersBody">
                            @if (Model.Headers.Count == 0)
                            {
                                <tr>
                                    <td colspan="4" class="text-center py-5 text-muted">
                                        <i class="bi bi-inbox fs-1 d-block mb-2 text-secondary"></i>
                                        No lab orders found for the selected date range and filter criteria.
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var h in Model.Headers)
                                {
                                    var statusPatternClass = h.OverallStatus switch
                                    {
                                        "Collected" => "status-pattern-collected",
                                        "Partially Collected" => "status-pattern-partial",
                                        "Re Collect" => "status-pattern-recollect",
                                        "Rejected" => "status-pattern-rejected",
                                        _ => "status-pattern-pending"
                                    };

                                    var overallBadge = h.OverallStatus switch
                                    {
                                        "Collected" => "bg-success",
                                        "Partially Collected" => "bg-info text-dark",
                                        "Re Collect" => "bg-secondary text-white",
                                        "Rejected" => "bg-danger",
                                        _ => "bg-warning text-dark"
                                    };

                                    var payBadge = h.PaymentStatus switch
                                    {
                                        "P" => "badge-subtle-success",
                                        "Partial" => "badge-subtle-info",
                                        _ => "badge-subtle-danger"
                                    };

                                    var payText = h.PaymentStatus switch
                                    {
                                        "P" => "Paid",
                                        "Partial" => "Partial",
                                        _ => "Unpaid"
                                    };

                                    <tr class="order-header-row cursor-pointer @statusPatternClass" data-id="@h.LabOrderId" id="orderRow_@h.LabOrderId">
                                        <!-- Booking Date & Status -->
                                        <td>
                                            <div class="fw-bold text-dark fs-8">
                                                @(h.BookingDateTime.HasValue ? h.BookingDateTime.Value.ToString("dd-MMM-yyyy") : "—")
                                            </div>
                                            <div class="text-muted fs-9">
                                                <i class="bi bi-clock me-1"></i>@(h.BookingDateTime.HasValue ? h.BookingDateTime.Value.ToString("hh:mm tt") : "—")
                                            </div>
                                            <div class="mt-1">
                                                <span class="badge @overallBadge fs-9">@h.OverallStatus</span>
                                            </div>
                                        </td>

                                        <!-- Token / Bill No / Payment -->
                                        <td>
                                            <div class="fw-bold text-primary fs-8">
                                                <i class="bi bi-ticket-perforated me-1"></i>@(h.TokenNo ?? "—")
                                            </div>
                                            <div class="text-muted fs-9 text-truncate" style="max-width: 110px;" title="Bill: @h.BillNo">
                                                @h.BillNo
                                            </div>
                                            <div class="d-flex align-items-center gap-1 mt-1">
                                                <span class="custom-badge @payBadge fs-9">@payText</span>
                                                <span class="fs-9 text-muted fw-bold">₹@h.TotalAmount.ToString("N0")</span>
                                            </div>
                                        </td>

                                        <!-- Patient Details -->
                                        <td>
                                            <div class="fw-bold text-dark fs-8 text-truncate" style="max-width: 140px;" title="@h.PatientName">
                                                @h.PatientName
                                            </div>
                                            <div class="fs-9 text-muted">
                                                <span class="badge bg-light text-dark border me-1">@h.PatientCode</span>
                                                @if (h.Age.HasValue) { <span>@h.Age Y</span> }
                                                @if (!string.IsNullOrEmpty(h.Gender)) { <span>/@h.Gender</span> }
                                            </div>
                                            @if (!string.IsNullOrEmpty(h.PhoneNumber))
                                            {
                                                <div class="fs-9 text-muted text-truncate" style="max-width: 130px;">
                                                    <i class="bi bi-telephone me-1"></i>@h.PhoneNumber
                                                </div>
                                            }
                                        </td>

                                        <!-- Order Summary & Progress (Containers removed from Header!) -->
                                        <td>
                                            <div class="fw-bold text-dark fs-8">
                                                <i class="bi bi-card-checklist me-1 text-primary"></i>@h.TotalTests Tests
                                            </div>
                                            <div class="fs-9 text-muted mt-1 fw-semibold">
                                                <span class="badge @overallBadge fs-9">@h.CollectedCount/@h.TotalTests Collected</span>
                                            </div>
                                            <div class="mt-1">
                                                @if (h.CollectionType?.ToLower().Contains("home") == true)
                                                {
                                                    <span class="badge bg-purple-subtle text-purple border border-purple fs-9">
                                                        <i class="bi bi-house-door-fill me-1"></i>Home
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-light text-secondary border fs-9">
                                                        <i class="bi bi-building me-1"></i>Center
                                                    </span>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- RIGHT PANEL: Collection Workspace (col-lg-7 col-xl-7) -->
        <div class="col-lg-7 col-xl-7 h-100">
            <div class="card shadow-sm border-0 rounded-3 h-100 workspace-card d-flex flex-column">
                <!-- Pinned Workspace Header -->
                <div class="card-header bg-white py-2 px-3 border-bottom d-flex justify-content-between align-items-center flex-shrink-0">
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge bg-success rounded-circle p-1 d-inline-flex align-items-center justify-content-center" style="width: 22px; height: 22px;">
                            <i class="bi bi-clipboard2-pulse text-white fs-8"></i>
                        </span>
                        <div>
                            <h6 class="mb-0 fw-bold text-dark">Collection Workspace</h6>
                            <span class="fs-9 text-muted" id="lblWorkspaceSubtitle">Select an order from the list</span>
                        </div>
                    </div>
                    <div id="workspaceActionButtons" class="d-none d-flex gap-2">
                        <button type="button" class="btn btn-outline-primary btn-sm d-flex align-items-center shadow-sm" id="btnViewAllBarcodes" title="View all scannable barcodes">
                            <i class="bi bi-upc-scan me-1"></i> View Barcodes
                        </button>
                        <button type="button" class="btn btn-outline-dark btn-sm d-flex align-items-center shadow-sm" id="btnPrintAllLabels" title="Print Barcode Labels for all vials">
                            <i class="bi bi-printer me-1"></i> Print Labels
                        </button>
                        <button type="button" class="btn btn-success btn-sm d-flex align-items-center shadow-sm fw-semibold" id="btnCollectAll">
                            <i class="bi bi-check-all me-1"></i> Collect All
                        </button>
                    </div>
                </div>

                <!-- Scrollable Workspace Body -->
                <div class="card-body p-3 flex-grow-1 overflow-auto workspace-scroll-body" id="workspaceContent">
                    <!-- Placeholder State (When no order selected) -->
                    <div id="workspacePlaceholder" class="text-center py-5">
                        <div class="empty-icon-wrap bg-light text-primary rounded-circle d-inline-flex p-4 mb-3">
                            <i class="bi bi-eyedropper fs-1"></i>
                        </div>
                        <h5 class="fw-bold text-dark">No Order Selected</h5>
                        <p class="text-muted fs-8 mx-auto" style="max-width: 320px;">
                            Click any order from the left list to review required sample containers, collection statuses, and print barcodes.
                        </p>
                    </div>

                    <!-- Loading Spinner -->
                    <div id="workspaceLoader" class="text-center py-5 d-none">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Loading order details...</span>
                        </div>
                        <p class="text-muted fs-8 mt-2">Loading sample collection details...</p>
                    </div>

                    <!-- Populated Workspace Area -->
                    <div id="workspaceDetails" class="d-none">
                        <!-- Patient & Order Header Hero Box -->
                        <div class="patient-hero-card p-3 rounded-3 mb-3 border shadow-xs">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <div class="d-flex align-items-center gap-2">
                                    <div class="avatar-circle bg-primary text-white rounded-circle fw-bold d-flex align-items-center justify-content-center shadow-sm" id="lblPatientAvatar">
                                        PT
                                    </div>
                                    <div>
                                        <div class="d-flex align-items-center gap-2">
                                            <h6 class="mb-0 fw-bold text-dark fs-7" id="lblPatientName">—</h6>
                                            <span class="badge bg-secondary-subtle text-secondary border fs-9" id="lblPatientCode">—</span>
                                        </div>
                                        <div class="fs-9 text-muted mt-1">
                                            <span id="lblPatientAgeGender">—</span>
                                            <span class="mx-1">•</span>
                                            <i class="bi bi-telephone me-1"></i><span id="lblPatientPhone">—</span>
                                        </div>
                                    </div>
                                </div>
                                <div class="text-end">
                                    <span class="badge bg-primary fs-7 shadow-xs" id="lblTokenNo">—</span>
                                    <div class="fs-9 text-muted mt-1" id="lblBillNo">—</div>
                                </div>
                            </div>
                            <div class="row g-2 pt-2 border-top fs-8">
                                <div class="col-sm-3 col-6">
                                    <span class="text-muted fs-9 d-block">Booking Time</span>
                                    <strong class="text-dark fs-8" id="lblBookingDateTime">—</strong>
                                </div>
                                <div class="col-sm-3 col-6">
                                    <span class="text-muted fs-9 d-block">Collection Type</span>
                                    <span id="lblCollectionTypeBadge" class="badge bg-light text-secondary border fs-9">Lab</span>
                                </div>
                                <div class="col-sm-3 col-6" id="rowPhlebotomist">
                                    <span class="text-muted fs-9 d-block">Phlebotomist</span>
                                    <strong class="text-dark fs-8 text-truncate d-block" id="lblPhlebotomist">—</strong>
                                </div>
                                <div class="col-sm-3 col-6 text-sm-end">
                                    <span class="text-muted fs-9 d-block">Payment Status</span>
                                    <span id="lblPaymentStatus" class="badge bg-success fs-9">Paid</span>
                                </div>
                            </div>

                            <!-- Visual Collection Progress -->
                            <div class="mt-2 pt-2 border-top">
                                <div class="d-flex justify-content-between align-items-center fs-9 mb-1">
                                    <span class="fw-semibold text-dark">
                                        <i class="bi bi-check2-all text-primary me-1"></i>Collection Progress: <span id="lblProgressText" class="fw-bold">0/0 Collected</span>
                                    </span>
                                    <span class="text-primary fw-bold" id="lblProgressPercent">0%</span>
                                </div>
                                <div class="progress" style="height: 6px; border-radius: 3px; background-color: #e2e8f0;">
                                    <div id="lblProgressBar" class="progress-bar bg-success progress-bar-striped progress-bar-animated" role="progressbar" style="width: 0%;"></div>
                                </div>
                            </div>
                        </div>

                        <!-- Booking Date Restriction Alert Banner -->
                        <div id="alertDateRestriction" class="alert alert-warning py-2 px-3 mb-3 d-flex align-items-center rounded-3 fs-8 border-warning-subtle shadow-xs d-none">
                            <i class="bi bi-exclamation-triangle-fill text-warning fs-5 me-2 flex-shrink-0"></i>
                            <div>
                                <strong>Sample Collection Restricted:</strong> 
                                Sample collection is only permitted when the <strong>Booking Date</strong> equals the <strong>Current Date</strong>. 
                                This order is booked for <span id="alertRestrictedDate" class="fw-bold"></span> (Today is <span id="alertTodayDate" class="fw-bold"></span>). 
                                Save buttons are disabled for these records.
                            </div>
                        </div>

                        <!-- INVESTIGATIONS TABLE (CONTAINER IN DETAILS BASED ON INVESTIGATION) -->
                        <div class="card border rounded-3 overflow-hidden shadow-xs">
                            <div class="table-responsive">
                                <table class="table table-sm align-middle mb-0 fs-8" id="tblWorkspaceTests">
                                    <thead class="table-light fs-9 text-uppercase text-secondary border-bottom">
                                        <tr>
                                            <th style="width: 3%;" class="text-center">#</th>
                                            <th style="width: 27%;">Investigation / Test Details</th>
                                            <th style="width: 17%;">Container &amp; Specimen</th>
                                            <th style="width: 6%;" class="text-center">Fasting</th>
                                            <th style="width: 18%;">Barcode</th>
                                            <th style="width: 12%;">Status</th>
                                            <th style="width: 17%;">Collection Time &amp; Action</th>
                                        </tr>
                                    </thead>
                                    <tbody id="tblWorkspaceTestsBody">
                                        <!-- Populated dynamically via JS -->
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal: Scannable Vector Barcode Visualizer (Grid View of Distinct Barcodes) -->
<div class="modal fade" id="barcodeVisualizerModal" tabindex="-1" aria-labelledby="barcodeVisualizerModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow">
            <div class="modal-header py-2 px-3 bg-light border-bottom">
                <div class="d-flex align-items-center gap-2">
                    <span class="badge bg-primary text-white rounded-circle p-1"><i class="bi bi-upc-scan fs-8"></i></span>
                    <h6 class="modal-title fw-bold text-dark" id="barcodeVisualizerModalLabel">Generated Barcodes</h6>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-3 bg-light-subtle" style="max-height: 70vh; overflow-y: auto;">
                <div id="barcodeVisualizerContent" class="row g-3">
                    <!-- Populated dynamically with distinct barcode cards -->
                </div>
            </div>
            <div class="modal-footer py-2 px-3 border-top bg-white">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn btn-primary btn-sm" id="btnModalPrintAll">
                    <i class="bi bi-printer me-1"></i> Print All Labels
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Modal: Barcode Label Print Preview (Iframe) -->
<div class="modal fade" id="barcodePrintModal" tabindex="-1" aria-labelledby="barcodePrintModalLabel" aria-hidden="true">
