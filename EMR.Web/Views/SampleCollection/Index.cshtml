@section Scripts {
    <!-- JsBarcode CDN for real scannable vector barcode rendering -->
    <script src="https://cdn.jsdelivr.net/npm/jsbarcode@3.11.5/dist/JsBarcode.all.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>

    <script>
        function showNotify(msg, type = 'success') {
            if (typeof Swal !== 'undefined') {
                Swal.fire({
                    toast: true,
                    position: 'top-end',
                    icon: type,
                    title: msg,
                    showConfirmButton: false,
                    timer: 3000,
                    timerProgressBar: true
                });
            } else if (typeof toastr !== 'undefined') {
                toastr.options = {
                    closeButton: true,
                    progressBar: true,
                    positionClass: "toast-top-right",
                    timeOut: "3000"
                };
                if (type === 'error') toastr.error(msg);
                else if (type === 'info') toastr.info(msg);
                else toastr.success(msg);
            } else {
                alert(msg);
            }
        }

        if (typeof window.toastr === 'undefined') {
            window.toastr = {
                success: function(m) { showNotify(m, 'success'); },
                error: function(m) { showNotify(m, 'error'); },
                info: function(m) { showNotify(m, 'info'); },
                warning: function(m) { showNotify(m, 'warning'); }
            };
        }

        $(document).ready(function () {
            let activeOrderId = null;
            let currentDetailData = null;
            let statusMasterList = [];

            // ── 1. Row Selection Click ──────────────────────────────────────────
            $(document).on('click', '.order-header-row', function () {
                const orderId = $(this).data('id');
                selectOrder(orderId);
            });

            function selectOrder(orderId) {
                activeOrderId = orderId;
                $('.order-header-row').removeClass('order-selected');
                $(`#orderRow_${orderId}`).addClass('order-selected');

                $('#workspacePlaceholder').addClass('d-none');
                $('#workspaceDetails').addClass('d-none');
                $('#workspaceActionButtons').addClass('d-none');
                $('#workspaceLoader').removeClass('d-none');

                $.ajax({
                    url: '@Url.Action("GetDetailJson", "SampleCollection")',
                    type: 'GET',
                    data: { labOrderId: orderId },
                    success: function (res) {
                        $('#workspaceLoader').addClass('d-none');
                        if (res.success && res.detail) {
                            currentDetailData = res.detail;
                            statusMasterList = res.statuses || [];
                            renderWorkspaceDetails(res.detail, statusMasterList);
                        } else {
                            $('#workspacePlaceholder').removeClass('d-none');
                            showNotify(res.message || 'Failed to load order details.', 'error');
                        }
                    },
                    error: function () {
                        $('#workspaceLoader').addClass('d-none');
                        $('#workspacePlaceholder').removeClass('d-none');
                        showNotify('Error fetching sample collection details.', 'error');
                    }
                });
            }

            // ── 2. Render Workspace Details (Containers Based on Investigation) ─
            function renderWorkspaceDetails(detail, statuses) {
                $('#workspaceDetails').removeClass('d-none');
                $('#workspaceActionButtons').removeClass('d-none');

                const rawBookingDate = detail.bookingDateTime || detail.orderDate;
                const isAllowedToday = isDateToday(rawBookingDate);

                // Date Restriction Banner
                if (!isAllowedToday) {
                    const bookingDateFormatted = formatDate(rawBookingDate);
                    const todayFormatted = formatDate(new Date().toISOString());
                    $('#alertRestrictedDate').text(bookingDateFormatted);
                    $('#alertTodayDate').text(todayFormatted);
                    $('#alertDateRestriction').removeClass('d-none');
                } else {
                    $('#alertDateRestriction').addClass('d-none');
                }

                // Header Subtitle
                $('#lblWorkspaceSubtitle').text(`${detail.tokenNo || ''} — ${detail.patientName || ''}`);

                // Patient Demographics
                $('#lblPatientName').text(detail.patientName || '—');
                $('#lblPatientCode').text(detail.patientCode || '—');
                const ageGender = (detail.age ? detail.age + ' Yrs' : '') + (detail.gender ? ' / ' + detail.gender : '');
                $('#lblPatientAgeGender').text(ageGender || '—');
                $('#lblPatientPhone').text(detail.phoneNumber || 'No phone');

                const initials = (detail.patientName || 'PT')
                    .split(' ')
                    .filter(Boolean)
                    .map(x => x[0])
                    .join('')
                    .substring(0, 2)
                    .toUpperCase();
                $('#lblPatientAvatar').text(initials);

                $('#lblTokenNo').text(detail.tokenNo || 'NO TOKEN');
                $('#lblBillNo').text(detail.billNo || '—');
                $('#lblBookingDateTime').text(detail.bookingDateTime ? formatDateTime(detail.bookingDateTime) : '—');

                // Collection Type
                if (detail.collectionType && detail.collectionType.toLowerCase().includes('home')) {
                    $('#lblCollectionTypeBadge').removeClass('bg-light text-secondary').addClass('bg-purple-subtle text-purple border border-purple').html('<i class="bi bi-house-door-fill me-1"></i>Home Collection');
                } else {
                    $('#lblCollectionTypeBadge').removeClass('bg-purple-subtle text-purple border border-purple').addClass('bg-light text-secondary border').html('<i class="bi bi-building me-1"></i>Lab Center');
                }

                if (detail.phlebotomistName) {
                    $('#rowPhlebotomist').show();
                    $('#lblPhlebotomist').text(detail.phlebotomistName);
                } else {
                    $('#rowPhlebotomist').hide();
                }

                // Payment Status
                const payBadge = detail.paymentStatus === 'P'
                    ? '<span class="badge bg-success">Paid</span>'
                    : (detail.paymentStatus === 'Partial'
                        ? '<span class="badge bg-info text-dark">Partial</span>'
                        : '<span class="badge bg-danger">Unpaid</span>');
                $('#lblPaymentStatus').html(payBadge);

                // Collection Progress & Pending Check
                const items = detail.items || [];
                const totalTests = items.length;
                const collectedCount = items.filter(x => x.collectionstatusID === 2).length;
                const pendingCount = items.filter(x => x.collectionstatusID !== 2).length;
                const hasPending = pendingCount > 0;
                const progressPct = totalTests > 0 ? Math.round((collectedCount / totalTests) * 100) : 0;

                $('#lblProgressText').text(`${collectedCount}/${totalTests} Tests Collected`);
                $('#lblProgressPercent').text(`${progressPct}%`);
                $('#lblProgressBar').css('width', `${progressPct}%`);

                // Update Print Labels button text with count of collected barcodes
                const distinctCollectedBarcodes = new Set(items.filter(x => x.barcodeNo && x.collectionstatusID === 2).map(x => x.barcodeNo)).size;
                if (distinctCollectedBarcodes > 0) {
                    $('#btnPrintAllLabels').html(`<i class="bi bi-printer me-1"></i> Print Labels <span class="badge bg-light text-dark ms-1">${distinctCollectedBarcodes}</span>`);
                } else {
                    $('#btnPrintAllLabels').html(`<i class="bi bi-printer me-1"></i> Print Labels`);
                }

                // Collect All Button State based on Date & Pending items
                if (!isAllowedToday) {
                    const bookingDateFormatted = formatDate(rawBookingDate);
                    $('#btnCollectAll')
                        .prop('disabled', true)
                        .removeClass('btn-success')
                        .addClass('btn-secondary')
                        .attr('title', `Sample collection is only permitted on the booking date (${bookingDateFormatted})`);
                } else if (!hasPending) {
                    $('#btnCollectAll')
                        .prop('disabled', true)
                        .removeClass('btn-success')
                        .addClass('btn-secondary')
                        .attr('title', 'All samples for this order are already collected');
                } else {
                    $('#btnCollectAll')
                        .prop('disabled', false)
                        .removeClass('btn-secondary')
                        .addClass('btn-success')
                        .attr('title', `Collect all ${pendingCount} pending sample(s) for this order`);
                }

                // Group items by Profile / Package or Standalone
                // Profile items sharing profileId share the same barcode
                const groups = [];
                const profileGroupsMap = {};
                const standaloneTests = [];

                items.forEach(item => {
                    const profileKey = item.profileId ? `PRF_${item.profileId}` : (item.profileName ? `PRFN_${item.profileName}` : null);
                    const packageKey = item.packageId ? `PKG_${item.packageId}` : null;

                    if (profileKey) {
                        if (!profileGroupsMap[profileKey]) {
                            profileGroupsMap[profileKey] = {
                                type: 'Profile',
                                name: item.profileName || item.profileOrPackageName || 'Profile',
                                profileId: item.profileId,
                                packageName: item.packageName,
                                items: []
                            };
                            groups.push(profileGroupsMap[profileKey]);
                        }
                        profileGroupsMap[profileKey].items.push(item);
                    } else if (packageKey) {
                        // Standalone test within a package
                        if (!profileGroupsMap[packageKey]) {
                            profileGroupsMap[packageKey] = {
                                type: 'Package',
                                name: item.packageName || item.profileOrPackageName || 'Package',
                                packageId: item.packageId,
                                items: []
                            };
                            groups.push(profileGroupsMap[packageKey]);
                        }
                        profileGroupsMap[packageKey].items.push(item);
                    } else {
                        standaloneTests.push(item);
                    }
                });

                if (standaloneTests.length > 0) {
                    groups.push({
                        type: 'Standalone',
                        name: 'Individual Investigations',
                        items: standaloneTests
                    });
                }

                // Render Table Rows with Container Details per Investigation
                let rowsHtml = '';
                let rowNum = 0;
                let grpIndex = 0;

                groups.forEach(grp => {
                    grpIndex++;
                    const isProfile = (grp.type === 'Profile');
                    const isPkg = (grp.type === 'Package');
                    const grpId = `grp_${grpIndex}`;

                    let headerIcon = 'bi-card-checklist';
                    let headerBadge = 'Individual Tests';
                    let headerClass = 'table-light text-secondary';

                    if (isProfile) {
                        headerIcon = 'bi-folder2-open';
                        headerBadge = 'Profile Test';
                        headerClass = 'table-primary-subtle text-primary';
                    } else if (isPkg) {
                        headerIcon = 'bi-box-seam';
                        headerBadge = 'Package';
                        headerClass = 'table-info-subtle text-info-emphasis';
                    }

                    // Shared Profile Barcode info if collected
                    const sharedBarcode = isProfile ? grp.items.find(x => x.barcodeNo)?.barcodeNo : null;

                    // Common status among items in this profile (if all are same, show that; otherwise default to Pending or first item status)
                    const firstStatus = grp.items[0]?.collectionstatusID || 1;
                    const allSameStatus = grp.items.every(x => x.collectionstatusID === firstStatus);
                    const groupSelectedStatus = allSameStatus ? firstStatus : 1;

                    // Is entire profile collected?
                    const isAllProfileCollected = isProfile && grp.items.length > 0 && grp.items.every(x => x.collectionstatusID === 2);

                    let profileStatusOptionsHtml = '';
                    statuses.forEach(st => {
                        const isSelected = (st.statusID === groupSelectedStatus) ? 'selected' : '';
                        profileStatusOptionsHtml += `<option value="${st.statusID}" ${isSelected}>${escapeHtml(st.statusName)}</option>`;
                    });

                    // First item's collection date/time for profile default
                    const firstDate = grp.items[0]?.samplecollectiondate;
                    const firstTime = grp.items[0]?.samplecollectiontime;
                    const defaultProfileDt = getFormattedDateTimeForInput(firstDate, firstTime);

                    rowsHtml += `
                        <tr class="${headerClass} group-header-row" id="groupHeader_${grpId}">
                            <td colspan="7" class="py-2 px-3 fw-bold">
                                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                                    <div class="d-flex align-items-center profile-collapse-toggle" data-target="${grpId}" title="Click to Expand/Collapse">
                                        <i class="bi bi-chevron-down me-2 profile-collapse-icon text-primary fs-7" id="icon_${grpId}"></i>
                                        <i class="bi ${headerIcon} me-2 fs-7"></i>
                                        <span class="fs-8 text-dark fw-bold">${escapeHtml(grp.name)}</span>
                                        <span class="badge bg-white text-dark border ms-2 fs-9">${grp.items.length} Test(s)</span>
                                        ${sharedBarcode ? `
                                            <span class="badge bg-success-subtle text-success border border-success-subtle fs-9 ms-2 d-inline-flex align-items-center gap-1">
                                                <i class="bi bi-upc-scan"></i> Tube Barcode: <strong>${escapeHtml(sharedBarcode)}</strong>
                                                <button type="button" class="btn btn-link p-0 text-success ms-1 btn-copy-barcode" data-barcode="${escapeHtml(sharedBarcode)}" title="Copy Barcode to Clipboard"><i class="bi bi-clipboard"></i></button>
                                            </span>
                                        ` : ''}
                                    </div>
                                    ${isProfile ? (
                                        isAllProfileCollected ? `
                                        <div class="d-flex align-items-center gap-2 profile-action-controls">
                                            <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1 fs-9 fw-semibold">
                                                <i class="bi bi-check2-all me-1"></i>Profile Collected
                                            </span>
                                            <span class="fs-9 text-muted d-none d-md-inline">
                                                <i class="bi bi-clock me-1"></i>${formatCollectionDateTime(firstDate, firstTime)}
                                            </span>
                                            <button type="button" class="btn btn-outline-secondary btn-sm py-0 px-2 fs-9 btn-toggle-profile-edit" data-grpid="${grpId}" ${!isAllowedToday ? 'disabled' : ''} title="Change Profile collection status">
                                                <i class="bi bi-pencil-square me-1"></i>Edit
                                            </button>
                                            <div class="profile-edit-wrapper d-none d-inline-flex align-items-center gap-2 ms-1 ps-2 border-start" id="profileEdit_${grpId}">
                                                <select class="form-select form-select-sm fs-9 py-0 sel-profile-status" style="width: auto; height: 28px;" data-grpid="${grpId}" ${!isAllowedToday ? 'disabled' : ''}>
                                                    ${profileStatusOptionsHtml}
                                                </select>
                                                <input type="datetime-local" class="form-control form-control-sm fs-9 py-0 txt-profile-datetime" style="width: 165px; height: 28px;"
                                                       data-grpid="${grpId}" value="${defaultProfileDt}" ${!isAllowedToday ? 'disabled' : ''} />
                                                <button type="button" class="btn btn-sm ${isAllowedToday ? 'btn-success' : 'btn-secondary'} py-0 px-2 fs-9 btn-save-profile" style="height: 28px;"
                                                        data-grpid="${grpId}"
                                                        data-profileid="${grp.profileId || ''}"
                                                        data-profilename="${escapeHtml(grp.name)}"
                                                        ${!isAllowedToday ? 'disabled' : ''}
                                                        title="${isAllowedToday ? 'Save collection status for all tests in this Profile' : `Sample collection is only permitted on the booking date (${formatDate(rawBookingDate)})`}">
                                                    <i class="bi ${isAllowedToday ? 'bi-check-all' : 'bi-lock-fill'} me-1"></i> Save Profile
                                                </button>
                                            </div>
                                        </div>
                                        ` : `
                                        <div class="d-flex align-items-center gap-2 profile-action-controls">
                                            <span class="fs-9 text-muted fw-normal me-1 d-none d-sm-inline">Profile Status:</span>
                                            <select class="form-select form-select-sm fs-9 py-0 sel-profile-status" style="width: auto; height: 28px;" data-grpid="${grpId}" ${!isAllowedToday ? 'disabled' : ''}>
                                                ${profileStatusOptionsHtml}
                                            </select>
                                            <input type="datetime-local" class="form-control form-control-sm fs-9 py-0 txt-profile-datetime" style="width: 165px; height: 28px;"
                                                   data-grpid="${grpId}" value="${defaultProfileDt}" ${!isAllowedToday ? 'disabled' : ''} />
                                            <button type="button" class="btn btn-sm ${isAllowedToday ? 'btn-success' : 'btn-secondary'} py-0 px-2 fs-9 btn-save-profile" style="height: 28px;"
                                                    data-grpid="${grpId}"
                                                    data-profileid="${grp.profileId || ''}"
                                                    data-profilename="${escapeHtml(grp.name)}"
                                                    ${!isAllowedToday ? 'disabled' : ''}
                                                    title="${isAllowedToday ? 'Save collection status for all tests in this Profile' : `Sample collection is only permitted on the booking date (${formatDate(rawBookingDate)})`}">
                                                <i class="bi ${isAllowedToday ? 'bi-check-all' : 'bi-lock-fill'} me-1"></i> Save Profile
                                            </button>
                                        </div>
                                        `
                                    ) : ''}
                                </div>
                            </td>
                        </tr>
                    `;

                    grp.items.forEach(test => {
                        rowNum++;

                        // Container badge styling based on investigation
                        const cTypeLower = (test.containerType || '').toLowerCase();
                        const sTypeLower = (test.sampleTypeName || '').toLowerCase();

                        let capBadgeClass = 'cap-badge-grey';
                        if (cTypeLower.includes('yellow') || cTypeLower.includes('sst') || sTypeLower.includes('serum')) {
                            capBadgeClass = 'cap-badge-yellow';
                        } else if (cTypeLower.includes('purple') || cTypeLower.includes('edta') || sTypeLower.includes('blood')) {
                            capBadgeClass = 'cap-badge-purple';
                        } else if (cTypeLower.includes('blue') || cTypeLower.includes('citrate')) {
                            capBadgeClass = 'cap-badge-blue';
                        } else if (cTypeLower.includes('grey') || cTypeLower.includes('gray') || cTypeLower.includes('fluoride')) {
                            capBadgeClass = 'cap-badge-grey';
                        } else if (cTypeLower.includes('red') || cTypeLower.includes('plain')) {
                            capBadgeClass = 'cap-badge-red';
                        } else if (cTypeLower.includes('green') || cTypeLower.includes('heparin')) {
                            capBadgeClass = 'cap-badge-green';
                        }

                        const fastingBadge = test.isFastingRequired
                            ? '<span class="badge bg-danger-subtle text-danger border border-danger-subtle fs-9"><i class="bi bi-exclamation-circle me-1"></i>Yes</span>'
                            : '<span class="badge bg-light text-muted border fs-9">No</span>';

                        const barcodeCellHtml = (test.barcodeNo && test.collectionstatusID === 2)
                            ? `<div class="d-flex align-items-center gap-1">
                                 <span class="barcode-display-badge" title="Barcode">${escapeHtml(test.barcodeNo)}</span>
                                 <button type="button" class="btn btn-outline-secondary btn-sm py-0 px-1 btn-copy-barcode" data-barcode="${escapeHtml(test.barcodeNo)}" title="Copy Barcode to Clipboard"><i class="bi bi-clipboard"></i></button>
                                 <button type="button" class="btn btn-outline-secondary btn-sm py-0 px-1 btn-preview-barcode" data-barcode="${escapeHtml(test.barcodeNo)}" data-name="${escapeHtml(test.testName)}" title="View Barcode"><i class="bi bi-upc-scan"></i></button>
                                 <button type="button" class="btn btn-outline-dark btn-sm py-0 px-1 btn-print-single-label" data-barcode="${escapeHtml(test.barcodeNo)}" title="Print Thermal Label"><i class="bi bi-printer"></i></button>
                               </div>`
                            : `<span class="badge bg-warning-subtle text-dark border border-warning-subtle fs-9"><i class="bi bi-hourglass-split me-1"></i>Pending</span>`;

                        let statusOptionsHtml = '';
                        statuses.forEach(st => {
                            const isSelected = (test.collectionstatusID === st.statusID) ? 'selected' : '';
                            statusOptionsHtml += `<option value="${st.statusID}" ${isSelected}>${escapeHtml(st.statusName)}</option>`;
                        });

                        const isCollected = (test.collectionstatusID === 2);
                        let statusCellHtml = '';
                        let actionCellHtml = '';

                        if (isCollected) {
                            statusCellHtml = `
                                <div class="d-flex align-items-center">
                                    <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1 fs-9 fw-semibold">
                                        <i class="bi bi-check2-circle me-1"></i>Collected
                                    </span>
                                </div>
                                <div class="row-edit-status d-none mt-1">
                                    <select class="form-select form-select-sm fs-8 sel-collection-status" data-id="${test.samplecollectionID}" ${!isAllowedToday ? 'disabled' : ''}>
                                        ${statusOptionsHtml}
                                    </select>
                                </div>
                            `;

                            actionCellHtml = `
                                <div class="d-flex align-items-center justify-content-between gap-1 row-collected-view">
                                    <div class="lh-sm">
                                        <div class="fs-9 text-dark fw-semibold">${formatDate(test.samplecollectiondate)}</div>
                                        <div class="fs-9 text-muted"><i class="bi bi-clock me-1"></i>${formatTime(test.samplecollectiontime || test.samplecollectiondate)}</div>
                                    </div>
                                    <button type="button" class="btn btn-outline-secondary btn-sm py-0 px-1 fs-9 btn-toggle-row-edit" data-id="${test.samplecollectionID}" title="Edit collection time or status" ${!isAllowedToday ? 'disabled' : ''}>
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                </div>
                                <div class="row-edit-action d-none mt-1">
                                    <div class="d-flex flex-column gap-1">
                                        <input type="datetime-local" class="form-control form-control-sm fs-9 txt-collection-datetime" 
                                               data-id="${test.samplecollectionID}" 
                                               value="${getFormattedDateTimeForInput(test.samplecollectiondate, test.samplecollectiontime)}"
                                               ${!isAllowedToday ? 'disabled' : ''} />
                                        <button type="button" class="btn btn-sm ${isAllowedToday ? 'btn-primary' : 'btn-secondary'} py-0 px-2 fs-9 btn-save-sample" 
                                                data-id="${test.samplecollectionID}"
                                                ${!isAllowedToday ? 'disabled' : ''}
                                                title="${isAllowedToday ? 'Save sample status' : `Sample collection is only permitted on the booking date (${formatDate(rawBookingDate)})`}">
                                            <i class="bi ${isAllowedToday ? 'bi-check2' : 'bi-lock-fill'} me-1"></i> Save
                                        </button>
                                    </div>
                                </div>
                            `;
                        } else {
                            statusCellHtml = `
                                <select class="form-select form-select-sm fs-8 sel-collection-status" data-id="${test.samplecollectionID}" ${!isAllowedToday ? 'disabled' : ''}>
                                    ${statusOptionsHtml}
                                </select>
                            `;

                            actionCellHtml = `
                                <div class="d-flex flex-column gap-1">
                                    <input type="datetime-local" class="form-control form-control-sm fs-9 txt-collection-datetime" 
                                           data-id="${test.samplecollectionID}" 
                                           value="${getFormattedDateTimeForInput(test.samplecollectiondate, test.samplecollectiontime)}"
                                           ${!isAllowedToday ? 'disabled' : ''} />
                                    <button type="button" class="btn btn-sm ${isAllowedToday ? 'btn-primary' : 'btn-secondary'} py-0 px-2 fs-9 btn-save-sample" 
                                            data-id="${test.samplecollectionID}"
                                            ${!isAllowedToday ? 'disabled' : ''}
                                            title="${isAllowedToday ? 'Save sample status' : `Sample collection is only permitted on the booking date (${formatDate(rawBookingDate)})`}">
                                        <i class="bi ${isAllowedToday ? 'bi-check2' : 'bi-lock-fill'} me-1"></i> Save
                                    </button>
                                </div>
                            `;
                        }

                        rowsHtml += `
                            <tr id="testRow_${test.samplecollectionID}" class="test-item-row row-group-${grpId}" data-id="${test.samplecollectionID}" data-grpid="${grpId}">
                                <td class="text-center text-muted fw-bold fs-9">${rowNum}</td>
                                <td>
                                    <div class="fw-bold text-dark fs-8">${escapeHtml(test.testName)}</div>
                                    <div class="fs-9 text-muted mt-1">
                                        <span class="badge bg-light text-dark border me-1">${escapeHtml(test.testCode)}</span>
                                        ${test.profileName && test.profileName !== '—'
                                            ? `<span class="badge bg-primary-subtle text-primary border border-primary-subtle me-1"><i class="bi bi-folder2 me-1"></i>${escapeHtml(test.profileName)}</span>`
                                            : ''}
                                        ${test.packageName && test.packageName !== '—'
                                            ? `<span class="badge bg-info-subtle text-info border border-info-subtle"><i class="bi bi-box-seam me-1"></i>${escapeHtml(test.packageName)}</span>`
                                            : ''}
                                    </div>
                                </td>
                                <!-- Container & Specimen based on Investigation -->
                                <td>
                                    <span class="badge ${capBadgeClass} fs-9 text-truncate" style="max-width: 150px;">
                                        <i class="bi bi-droplet-fill me-1"></i>${escapeHtml(test.containerType || 'Standard Tube')}
                                    </span>
                                    <div class="fs-9 text-muted mt-1 fw-semibold">
                                        ${escapeHtml(test.sampleTypeName || 'Specimen')}
                                    </div>
                                </td>
                                <td class="text-center">${fastingBadge}</td>
                                <td>${barcodeCellHtml}</td>
                                <td>${statusCellHtml}</td>
                                <td>${actionCellHtml}</td>
                            </tr>
                        `;
                    });
                });

                $('#tblWorkspaceTestsBody').html(rowsHtml);
            }

            // ── 3. Barcode Visualizer Modal (Distinct Barcodes Only!) ──────────
            $('#btnViewAllBarcodes').on('click', function () {
                if (!activeOrderId || !currentDetailData) return;
                const collectedItems = (currentDetailData.items || []).filter(x => x.barcodeNo && x.collectionstatusID === 2);
                if (collectedItems.length === 0) {
                    showNotify('No samples have been collected yet. Barcodes are generated upon sample collection.', 'warning');
                    return;
                }
                showBarcodeModalWithItems(collectedItems);
            });

            $(document).on('click', '.btn-preview-barcode', function () {
                const barcode = $(this).data('barcode');
                const items = (currentDetailData?.items || []).filter(x => x.barcodeNo === barcode);
                if (items.length > 0) {
                    showBarcodeModalWithItems(items);
                }
            });

            function showBarcodeModalWithItems(items) {
                // Group by distinct barcode
                const distinctBarcodes = {};
                items.forEach(it => {
                    if (!distinctBarcodes[it.barcodeNo]) {
                        distinctBarcodes[it.barcodeNo] = {
                            barcodeNo: it.barcodeNo,
                            title: it.profileName || it.packageName || it.testName,
                            sampleTypeName: it.sampleTypeName,
                            containerType: it.containerType,
                            isProfile: Boolean(it.profileName),
                            tests: []
                        };
                    }
                    distinctBarcodes[it.barcodeNo].tests.push(it);
                });

                const distinctKeys = Object.keys(distinctBarcodes);

                $('#barcodeVisualizerModalLabel').html(`
                    <span class="fw-bold">${currentDetailData?.tokenNo || 'LAB'}</span> — 
                    <span class="text-secondary fs-7">${currentDetailData?.patientName || ''}</span> 
                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle fs-8 ms-1">${distinctKeys.length} Tube Barcode(s)</span>
                `);

                let gridHtml = '';
                distinctKeys.forEach((bCode, idx) => {
                    const bGroup = distinctBarcodes[bCode];
                    const testCount = bGroup.tests.length;

                    gridHtml += `
                    <div class="col-md-6 col-12">
                        <div class="card h-100 border shadow-xs rounded-3 p-3 bg-white text-center">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <span class="fs-8 fw-bold text-dark text-truncate" style="max-width: 200px;" title="${escapeHtml(bGroup.title)}">
                                    ${escapeHtml(bGroup.title)}
                                </span>
                                <button type="button" class="btn btn-outline-secondary btn-sm py-0 px-2 fs-9 btn-print-single-label" data-barcode="${escapeHtml(bCode)}" title="Print Thermal Label">
                                    <i class="bi bi-printer me-1"></i> Print
                                </button>
                            </div>
                            <div class="fs-9 text-muted mb-2 text-start">
                                <span class="badge bg-light text-dark border me-1">${escapeHtml(bGroup.containerType)}</span>
                                <span>${escapeHtml(bGroup.sampleTypeName)}</span>
                                ${testCount > 1 ? `<span class="badge bg-primary-subtle text-primary ms-1">${testCount} Tests in this Tube</span>` : ''}
                            </div>
                            <div class="p-2 bg-light rounded border d-flex justify-content-center">
                                <svg class="modal-barcode-svg" id="modalSvg_${idx}" data-barcode="${escapeHtml(bCode)}"></svg>
                            </div>
                        </div>
                    </div>
                    `;
                });

                $('#barcodeVisualizerContent').html(gridHtml);
                $('#barcodeVisualizerModal').modal('show');

                // Render barcodes with JsBarcode
                setTimeout(() => {
                    $('.modal-barcode-svg').each(function () {
                        const code = $(this).attr('data-barcode');
                        if (code) {
                            try {
                                JsBarcode(this, code, {
                                    format: "CODE128",
                                    width: 1.5,
                                    height: 40,
                                    displayValue: true,
                                    fontSize: 11,
                                    margin: 4
                                });
                            } catch (e) {
                                console.warn('JsBarcode error in modal:', e);
                            }
                        }
                    });
                }, 150);
            }

            $('#btnModalPrintAll').on('click', function () {
                if (!activeOrderId) return;
                openBarcodeModal(activeOrderId, null, null);
            });

            // ── 3b. Inline Row & Profile Edit Toggles ───────────────────────────
            $(document).on('click', '.btn-toggle-row-edit', function (e) {
                e.stopPropagation();
                const row = $(this).closest('tr');
                const editStatus = row.find('.row-edit-status');
                const editAction = row.find('.row-edit-action');
                const collectedView = row.find('.row-collected-view');

                if (editStatus.hasClass('d-none')) {
                    editStatus.removeClass('d-none');
                    editAction.removeClass('d-none');
                    collectedView.addClass('d-none');
                } else {
                    editStatus.addClass('d-none');
                    editAction.addClass('d-none');
                    collectedView.removeClass('d-none');
                }
            });

            $(document).on('click', '.btn-toggle-profile-edit', function (e) {
                e.stopPropagation();
                const grpId = $(this).data('grpid');
                $(`#profileEdit_${grpId}`).toggleClass('d-none');
            });

            // ── 3c. One-Click Copy Barcode to Clipboard ─────────────────────────
            $(document).on('click', '.btn-copy-barcode', function (e) {
                e.stopPropagation();
                const code = $(this).data('barcode');
                if (!code) return;

                if (navigator.clipboard && navigator.clipboard.writeText) {
                    navigator.clipboard.writeText(String(code)).then(() => {
                        showNotify(`Barcode "${code}" copied to clipboard`, 'success');
                    }).catch(() => {
                        copyFallback(code);
                    });
                } else {
                    copyFallback(code);
                }
            });

            function copyFallback(text) {
                const ta = document.createElement('textarea');
                ta.value = text;
                ta.style.position = 'fixed';
                ta.style.opacity = '0';
                document.body.appendChild(ta);
                ta.select();
                try {
                    document.execCommand('copy');
                    showNotify(`Barcode "${text}" copied to clipboard`, 'success');
                } catch (err) {
                    showNotify('Failed to copy barcode', 'error');
                }
                document.body.removeChild(ta);
            }

            // ── 3d. Keyboard Shortcut (Alt + S) for Search Box ──────────────────
            $(document).on('keydown', function (e) {
                if (e.altKey && (e.key === 's' || e.key === 'S')) {
                    e.preventDefault();
                    $('#txtSearch').focus().select();
                }
            });

            // ── 4. Status Dropdown Change -> Auto-fill current date/time if "Collected" ──
            $(document).on('change', '.sel-collection-status', function () {
                const statusId = parseInt($(this).val());
                const row = $(this).closest('tr');
                const dtInput = row.find('.txt-collection-datetime');

                if (statusId === 2) { // Collected
                    if (!dtInput.val()) {
                        const now = new Date();
                        now.setMinutes(now.getMinutes() - now.getTimezoneOffset());
                        dtInput.val(now.toISOString().slice(0, 16));
                    }
                } else if (statusId === 1) { // Pending
                    dtInput.val('');
                }
            });

            // ── 4b. Profile Collapse / Expand Toggle ────────────────────────────
            $(document).on('click', '.profile-collapse-toggle', function () {
                const grpId = $(this).data('target');
                const rows = $(`.row-group-${grpId}`);
                const icon = $(`#icon_${grpId}`);

                if (rows.is(':visible')) {
                    rows.hide();
                    icon.addClass('collapsed');
                } else {
                    rows.show();
                    icon.removeClass('collapsed');
                }
            });

            // ── 4c. Profile Status Dropdown Change -> Auto-fill date & cascade to rows ──
            $(document).on('change', '.sel-profile-status', function () {
                const grpId = $(this).data('grpid');
                const statusId = parseInt($(this).val());
                const dtInput = $(`.txt-profile-datetime[data-grpid="${grpId}"]`);

                if (statusId === 2) { // Collected
                    if (!dtInput.val()) {
                        const now = new Date();
                        now.setMinutes(now.getMinutes() - now.getTimezoneOffset());
                        dtInput.val(now.toISOString().slice(0, 16));
                    }
                } else if (statusId === 1) { // Pending
                    dtInput.val('');
                }

                // Synchronize child test rows in this profile
                const dtVal = dtInput.val();
                $(`.row-group-${grpId}`).each(function () {
                    $(this).find('.sel-collection-status').val(statusId);
                    if (statusId === 2 && dtVal) {
                        $(this).find('.txt-collection-datetime').val(dtVal);
                    } else if (statusId === 1) {
                        $(this).find('.txt-collection-datetime').val('');
                    }
                });
            });

            $(document).on('change', '.txt-profile-datetime', function () {
                const grpId = $(this).data('grpid');
                const dtVal = $(this).val();
                if (dtVal) {
                    $(`.row-group-${grpId}`).find('.txt-collection-datetime').val(dtVal);
                }
            });

            // ── 4d. Save Profile at once (All tests in this Profile) ───────────────
            $(document).on('click', '.btn-save-profile', function () {
                if (!activeOrderId || !currentDetailData) return;

                const rawBookingDate = currentDetailData.bookingDateTime || currentDetailData.orderDate;
                if (!isDateToday(rawBookingDate)) {
                    showNotify(`Sample collection is only permitted on the booking date (${formatDate(rawBookingDate)}).`, 'warning');
                    return;
                }

                const btn = $(this);
                const grpId = btn.data('grpid');
                const profileIdRaw = btn.data('profileid');
                const profileId = profileIdRaw ? parseInt(profileIdRaw) : null;
                const profileName = btn.data('profilename') || null;

                const statusId = parseInt($(`.sel-profile-status[data-grpid="${grpId}"]`).val());
                const dtVal = $(`.txt-profile-datetime[data-grpid="${grpId}"]`).val();

                let datePart = null;
                let timePart = null;

                if (dtVal) {
                    const dt = new Date(dtVal);
                    datePart = dt.toISOString().split('T')[0];
                    timePart = dtVal.split('T')[1] ? dtVal.split('T')[1] + ':00' : '00:00:00';
                }

                btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-1"></span> Saving...');

                $.ajax({
                    url: '@Url.Action("UpdateProfileStatusJson", "SampleCollection")',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({
                        LabOrderId: activeOrderId,
                        ProfileId: profileId,
                        ProfileName: profileName,
                        CollectionstatusID: statusId,
                        SampleCollectionDate: datePart,
                        SampleCollectionTime: timePart
                    }),
                    success: function (res) {
                        btn.prop('disabled', false).html('<i class="bi bi-check-all me-1"></i> Save Profile');
                        if (res.success) {
                            showNotify(res.message || 'Profile samples updated successfully.', 'success');
                            refreshOrderData(activeOrderId);
                        } else {
                            showNotify(res.message || 'Failed to update profile samples.', 'error');
                        }
                    },
                    error: function () {
                        btn.prop('disabled', false).html('<i class="bi bi-check-all me-1"></i> Save Profile');
                        showNotify('Error occurred while updating profile samples.', 'error');
                    }
                });
            });

            // ── 5. Save Single Sample Status ────────────────────────────────────
            $(document).on('click', '.btn-save-sample', function () {
                if (!activeOrderId || !currentDetailData) return;

                const rawBookingDate = currentDetailData.bookingDateTime || currentDetailData.orderDate;
                if (!isDateToday(rawBookingDate)) {
                    showNotify(`Sample collection is only permitted on the booking date (${formatDate(rawBookingDate)}).`, 'warning');
                    return;
                }

                const sampleId = $(this).data('id');
                const row = $(`#testRow_${sampleId}`);
                const statusId = parseInt(row.find('.sel-collection-status').val());
                const dtVal = row.find('.txt-collection-datetime').val();

                let datePart = null;
                let timePart = null;

                if (dtVal) {
                    const dt = new Date(dtVal);
                    datePart = dt.toISOString().split('T')[0];
                    timePart = dtVal.split('T')[1] ? dtVal.split('T')[1] + ':00' : '00:00:00';
                }

                const btn = $(this);
                btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm"></span>');

                $.ajax({
                    url: '@Url.Action("UpdateStatusJson", "SampleCollection")',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({
                        SampleCollectionId: sampleId,
                        LabOrderId: activeOrderId,
                        CollectionstatusID: statusId,
                        SampleCollectionDate: datePart,
                        SampleCollectionTime: timePart
                    }),
                    success: function (res) {
                        btn.prop('disabled', false).html('<i class="bi bi-check2"></i> Save');
                        if (res.success) {
                            showNotify('Sample status updated successfully.', 'success');
                            refreshOrderData(activeOrderId);
                        } else {
                            showNotify(res.message || 'Failed to update sample.', 'error');
                        }
                    },
                    error: function () {
                        btn.prop('disabled', false).html('<i class="bi bi-check2"></i> Save');
                        showNotify('Error occurred while updating sample.', 'error');
                    }
                });
            });

            // ── 6. Collect All Button Click ─────────────────────────────────────
            $('#btnCollectAll').on('click', function () {
                if (!activeOrderId || !currentDetailData) return;

                const items = currentDetailData.items || [];
                const pendingCount = items.filter(x => x.collectionstatusID !== 2).length;
                if (pendingCount === 0) {
                    showNotify('All samples for this order are already collected.', 'info');
                    return;
                }

                const rawBookingDate = currentDetailData.bookingDateTime || currentDetailData.orderDate;
                if (!isDateToday(rawBookingDate)) {
                    showNotify(`Sample collection is only permitted on the booking date (${formatDate(rawBookingDate)}).`, 'warning');
                    return;
                }

                const proceedCollectAll = function () {
                    const btn = $('#btnCollectAll');
                    btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-1"></span> Processing...');

                    $.ajax({
                        url: '@Url.Action("CollectAllJson", "SampleCollection")',
                        type: 'POST',
                        contentType: 'application/json',
                        data: JSON.stringify({ LabOrderId: activeOrderId }),
                        success: function (res) {
                            btn.prop('disabled', false).html('<i class="bi bi-check-all me-1"></i> Collect All');
                            if (res.success) {
                                showNotify(res.message || 'All samples marked as Collected.', 'success');
                                refreshOrderData(activeOrderId);
                            } else {
                                showNotify('Failed to update all samples.', 'error');
                            }
                        },
                        error: function () {
                            btn.prop('disabled', false).html('<i class="bi bi-check-all me-1"></i> Collect All');
                            showNotify('Error occurred while collecting samples.', 'error');
                        }
                    });
                };

                if (typeof Swal !== 'undefined') {
                    Swal.fire({
                        title: 'Collect All Samples?',
                        text: 'Are you sure you want to mark all pending samples for this order as Collected?',
                        icon: 'question',
                        showCancelButton: true,
                        confirmButtonColor: '#16a34a',
                        cancelButtonColor: '#64748b',
                        confirmButtonText: '<i class="bi bi-check-all me-1"></i> Yes, Collect All',
                        cancelButtonText: 'Cancel',
                        focusCancel: true,
                        customClass: {
                            confirmButton: 'btn btn-success px-3',
                            cancelButton: 'btn btn-outline-secondary px-3 ms-2'
                        },
                        buttonsStyling: false
                    }).then((result) => {
                        if (result.isConfirmed) {
                            proceedCollectAll();
                        }
                    });
                } else {
                    if (confirm('Are you sure you want to mark all pending samples for this order as Collected?')) {
                        proceedCollectAll();
                    }
                }
            });

            // ── 7. Print Barcode Labels Modal ───────────────────────────────────
            $('#btnPrintAllLabels').on('click', function () {
                if (!activeOrderId) return;
                const anyBarcodes = (currentDetailData?.items || []).some(x => x.barcodeNo && x.collectionstatusID === 2);
                if (!anyBarcodes) {
                    showNotify('No samples have been collected yet. Barcodes are generated upon sample collection.', 'warning');
                    return;
                }
                openBarcodeModal(activeOrderId, null, null);
            });

            $(document).on('click', '.btn-print-single-label', function () {
                if (!activeOrderId) return;
                const barcode = $(this).data('barcode');
                if (!barcode) {
                    showNotify('Barcode has not been generated for this sample yet.', 'warning');
                    return;
                }
                openBarcodeModal(activeOrderId, barcode, null);
            });

            function openBarcodeModal(orderId, barcodeNo, sampleTypeId) {
                let url = `@Url.Action("PrintBarcode", "SampleCollection")?labOrderId=${orderId}`;
                if (barcodeNo) {
                    url += `&barcodeNo=${encodeURIComponent(barcodeNo)}`;
                }
                if (sampleTypeId) {
                    url += `&sampleTypeId=${sampleTypeId}`;
                }
                $('#barcodePrintFrame').attr('src', url);
                $('#barcodePrintModal').modal('show');
            }

            $('#btnTriggerPrint').on('click', function () {
                const frame = document.getElementById('barcodePrintFrame');
                if (frame && frame.contentWindow) {
                    frame.contentWindow.focus();
                    frame.contentWindow.print();
                }
            });

            // ── 8. Filter & Search Handlers (Status Wise Filtering) ─────────────
            function setStatusFilter(status) {
                $('.btn-filter-status').each(function () {
                    const s = $(this).data('status');
                    const isActive = (s.toLowerCase() === status.toLowerCase());
                    $(this).removeClass('active btn-dark btn-warning btn-info btn-success btn-secondary btn-danger btn-outline-dark btn-outline-warning btn-outline-info btn-outline-success btn-outline-secondary btn-outline-danger text-dark text-white fw-bold shadow-sm');

                    if (s === 'All') {
                        $(this).addClass(isActive ? 'btn-dark text-white active fw-bold shadow-sm' : 'btn-outline-dark');
                    } else if (s === 'Pending') {
                        $(this).addClass(isActive ? 'btn-warning text-dark active fw-bold shadow-sm' : 'btn-outline-warning text-dark');
                    } else if (s === 'Partial') {
                        $(this).addClass(isActive ? 'btn-info text-dark active fw-bold shadow-sm' : 'btn-outline-info text-dark');
                    } else if (s === 'Collected') {
                        $(this).addClass(isActive ? 'btn-success text-white active fw-bold shadow-sm' : 'btn-outline-success');
                    } else if (s === 'Re Collect') {
                        $(this).addClass(isActive ? 'btn-secondary text-white active fw-bold shadow-sm' : 'btn-outline-secondary');
                    } else if (s === 'Rejected') {
                        $(this).addClass(isActive ? 'btn-danger text-white active fw-bold shadow-sm' : 'btn-outline-danger');
                    }
                });
            }

            $('#btnApplyFilter, #btnRefreshList').on('click', function () {
                reloadHeaderList();
            });

            $('#txtSearch').on('keypress', function (e) {
                if (e.which === 13) {
                    reloadHeaderList();
                }
            });

            $('.btn-filter-status').on('click', function () {
                const status = $(this).data('status');
                setStatusFilter(status);
                reloadHeaderList();
            });

            $('.stat-card').on('click', function () {
                const status = $(this).data('status');
                setStatusFilter(status);
                reloadHeaderList();
            });

            $('.btn-quick-date').on('click', function () {
                const range = $(this).data('range');
                const now = new Date();
                let from = new Date();
                let to = new Date();

                if (range === 'today') {
                    // today
                } else if (range === 'yesterday') {
                    from.setDate(now.getDate() - 1);
                    to.setDate(now.getDate() - 1);
                } else if (range === 'week') {
                    from.setDate(now.getDate() - 6);
                } else if (range === 'month') {
                    from = new Date(now.getFullYear(), now.getMonth(), 1);
                }

                $('#txtFromDate').val(from.toISOString().split('T')[0]);
                $('#txtToDate').val(to.toISOString().split('T')[0]);
                reloadHeaderList();
            });

            function reloadHeaderList() {
                const fromDate = $('#txtFromDate').val();
                const toDate = $('#txtToDate').val();
                const dateFilterType = $('#selDateFilterType').val();
                const statusFilter = $('.btn-filter-status.active').data('status') || 'All';
                const search = $('#txtSearch').val();

                $.ajax({
                    url: '@Url.Action("GetHeadersJson", "SampleCollection")',
                    type: 'GET',
                    data: {
                        fromDate: fromDate,
                        toDate: toDate,
                        dateFilterType: dateFilterType,
                        statusFilter: statusFilter,
                        search: search
                    },
                    success: function (res) {
                        if (res.success) {
                            updateStatsCards(res.stats);
                            renderHeaderRows(res.headers);
                            if (activeOrderId) {
                                $(`#orderRow_${activeOrderId}`).addClass('order-selected');
                            }
                        }
                    },
                    error: function () {
                        showNotify('Failed to refresh order list.', 'error');
                    }
                });
            }

            function refreshOrderData(orderId) {
                reloadHeaderList();
                if (orderId) {
                    selectOrder(orderId);
                }
            }

            function updateStatsCards(stats) {
                if (!stats) return;
                $('#statTotalOrders').text(stats.totalOrders || 0);
                $('#statPendingOrders').text(stats.pendingOrders || 0);
                $('#statPartialOrders').text(stats.partialOrders || 0);
                $('#statCollectedOrders').text(stats.collectedOrders || 0);
            }

            function renderHeaderRows(headers) {
                $('#lblOrderCount').text(`Showing ${headers.length} orders`);
                const tbody = $('#tblOrderHeadersBody');
                tbody.empty();

                if (!headers || headers.length === 0) {
                    tbody.html(`
                        <tr>
                            <td colspan="4" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-1 d-block mb-2 text-secondary"></i>
                                No lab orders found for the selected date range and filter criteria.
                            </td>
                        </tr>
                    `);
                    return;
                }

                headers.forEach(h => {
                    let statusPatternClass = 'status-pattern-pending';
                    let overallBadge = 'bg-warning text-dark';
                    if (h.overallStatus === 'Collected') {
                        statusPatternClass = 'status-pattern-collected';
                        overallBadge = 'bg-success';
                    } else if (h.overallStatus === 'Partially Collected') {
                        statusPatternClass = 'status-pattern-partial';
                        overallBadge = 'bg-info text-dark';
                    } else if (h.overallStatus === 'Re Collect') {
                        statusPatternClass = 'status-pattern-recollect';
                        overallBadge = 'bg-secondary text-white';
                    } else if (h.overallStatus === 'Rejected') {
                        statusPatternClass = 'status-pattern-rejected';
                        overallBadge = 'bg-danger';
                    }

                    let payBadge = 'badge-subtle-danger';
                    let payText = 'Unpaid';
                    if (h.paymentStatus === 'P') { payBadge = 'badge-subtle-success'; payText = 'Paid'; }
                    else if (h.paymentStatus === 'Partial') { payBadge = 'badge-subtle-info'; payText = 'Partial'; }

                    let typeBadge = (h.collectionType && h.collectionType.toLowerCase().includes('home'))
                        ? '<span class="badge bg-purple-subtle text-purple border border-purple fs-9"><i class="bi bi-house-door-fill me-1"></i>Home</span>'
                        : '<span class="badge bg-light text-secondary border fs-9"><i class="bi bi-building me-1"></i>Center</span>';

                    const rowHtml = `
                        <tr class="order-header-row cursor-pointer ${statusPatternClass}" data-id="${h.labOrderId}" id="orderRow_${h.labOrderId}">
                            <td>
                                <div class="fw-bold text-dark fs-8">${h.bookingDateTime ? formatDate(h.bookingDateTime) : '—'}</div>
                                <div class="text-muted fs-9"><i class="bi bi-clock me-1"></i>${h.bookingDateTime ? formatTime(h.bookingDateTime) : '—'}</div>
                                <div class="mt-1"><span class="badge ${overallBadge} fs-9">${escapeHtml(h.overallStatus)}</span></div>
                            </td>
                            <td>
                                <div class="fw-bold text-primary fs-8"><i class="bi bi-ticket-perforated me-1"></i>${escapeHtml(h.tokenNo || '—')}</div>
                                <div class="text-muted fs-9 text-truncate" style="max-width: 110px;" title="Bill: ${escapeHtml(h.billNo)}">${escapeHtml(h.billNo)}</div>
                                <div class="d-flex align-items-center gap-1 mt-1">
                                    <span class="custom-badge ${payBadge} fs-9">${payText}</span>
                                    <span class="fs-9 text-muted fw-bold">₹${Number(h.totalAmount || 0).toLocaleString()}</span>
                                </div>
                            </td>
                            <td>
                                <div class="fw-bold text-dark fs-8 text-truncate" style="max-width: 140px;" title="${escapeHtml(h.patientName)}">${escapeHtml(h.patientName)}</div>
                                <div class="fs-9 text-muted">
                                    <span class="badge bg-light text-dark border me-1">${escapeHtml(h.patientCode)}</span>
                                    ${h.age ? `<span>${h.age} Y</span>` : ''}
                                    ${h.gender ? `<span>/${escapeHtml(h.gender)}</span>` : ''}
                                </div>
                                ${h.phoneNumber ? `<div class="fs-9 text-muted text-truncate" style="max-width: 130px;"><i class="bi bi-telephone me-1"></i>${escapeHtml(h.phoneNumber)}</div>` : ''}
                            </td>
                            <!-- Order Summary & Progress (No Containers in Header!) -->
                            <td>
                                <div class="fw-bold text-dark fs-8">
                                    <i class="bi bi-card-checklist me-1 text-primary"></i>${h.totalTests} Tests
                                </div>
                                <div class="fs-9 text-muted mt-1 fw-semibold">
                                    <span class="badge ${overallBadge} fs-9">${h.collectedCount}/${h.totalTests} Collected</span>
                                </div>
                                <div class="mt-1">
                                    ${typeBadge}
                                </div>
                            </td>
                        </tr>
                    `;
                    tbody.append(rowHtml);
                });
            }

            // ── 9. Utility Functions ────────────────────────────────────────────
            function formatDate(str) {
                if (!str) return '—';
                if (typeof str === 'string' && str.length >= 10 && str.charAt(4) === '-' && str.charAt(7) === '-') {
                    const parts = str.substring(0, 10).split('-');
                    const months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
                    const mIdx = parseInt(parts[1], 10) - 1;
                    return `${parts[2]}-${months[mIdx] || parts[1]}-${parts[0]}`;
                }
                const d = new Date(str);
                if (isNaN(d.getTime())) return str || '—';
                return d.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });
            }

            function formatTime(str) {
                if (!str) return '—';
                if (typeof str === 'string') {
                    let timePart = str;
                    if (timePart.includes('T')) timePart = timePart.split('T')[1];
                    if (timePart.includes(' ')) timePart = timePart.split(' ')[1];
                    if (timePart.includes(':')) {
                        const tParts = timePart.split(':');
                        let h = parseInt(tParts[0], 10);
                        const m = tParts[1] || '00';
                        if (!isNaN(h)) {
                            const ampm = h >= 12 ? 'PM' : 'AM';
                            h = h % 12;
                            if (h === 0) h = 12;
                            const hh = String(h).padStart(2, '0');
                            return `${hh}:${m} ${ampm}`;
                        }
                    }
                }
                const d = new Date(str);
                if (isNaN(d.getTime())) return str || '—';
                return d.toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit' });
            }

            function formatDateTime(str) {
                if (!str) return '—';
                return formatDate(str) + ' ' + formatTime(str);
            }

            function formatCollectionDateTime(dStr, tStr) {
                if (!dStr) return '—';
                const fDate = formatDate(dStr);
                const fTime = formatTime(tStr || dStr);
                return `${fDate} ${fTime}`.trim();
            }

            function isDateToday(rawDateStr) {
                if (!rawDateStr) return false;
                let bDateYMD = '';
                if (typeof rawDateStr === 'string' && rawDateStr.length >= 10 && rawDateStr.charAt(4) === '-' && rawDateStr.charAt(7) === '-') {
                    bDateYMD = rawDateStr.substring(0, 10);
                } else {
                    const d = new Date(rawDateStr);
                    if (isNaN(d.getTime())) return false;
                    const y = d.getFullYear();
                    const m = String(d.getMonth() + 1).padStart(2, '0');
                    const day = String(d.getDate()).padStart(2, '0');
                    bDateYMD = `${y}-${m}-${day}`;
                }

                const now = new Date();
                const curY = now.getFullYear();
                const curM = String(now.getMonth() + 1).padStart(2, '0');
                const curD = String(now.getDate()).padStart(2, '0');
                const todayYMD = `${curY}-${curM}-${curD}`;

                return bDateYMD === todayYMD;
            }

            function getFormattedDateTimeForInput(dStr, tStr) {
                if (!dStr) return '';
                const datePart = dStr.substring(0, 10);
                const timePart = tStr ? tStr.substring(0, 5) : '00:00';
                return `${datePart}T${timePart}`;
            }

            function escapeHtml(str) {
                if (!str) return '';
                return $('<div>').text(str).html();
            }

            // Auto-select first order if list is not empty
            const firstRow = $('.order-header-row').first();
            if (firstRow.length > 0) {
                const firstId = firstRow.data('id');
                selectOrder(firstId);
            }
        });
    </script>
}
