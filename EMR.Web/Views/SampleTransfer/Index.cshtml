@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
    <script>
        $(document).ready(function () {
            toastr.options = {
                closeButton: true,
                progressBar: true,
                positionClass: "toast-top-right",
                timeOut: "3500"
            };

            let currentSamples = [];
            let currentStatusFilter = '@Model.TransferStatusFilter' || 'Ready';
            let searchTimeout = null;
            let pendingTransferIds = [];

            // Helper: Format Date
            function formatDate(dtStr) {
                if (!dtStr) return '—';
                const d = new Date(dtStr);
                if (isNaN(d.getTime())) return dtStr;
                return d.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });
            }

            // Helper: Format Time
            function formatTime(dtStr) {
                if (!dtStr) return '';
                const d = new Date(dtStr);
                if (isNaN(d.getTime())) return '';
                return d.toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit', hour12: true });
            }

            // Helper: Escape HTML
            function escapeHtml(text) {
                if (!text) return '';
                return String(text)
                    .replace(/&/g, "&amp;")
                    .replace(/</g, "&lt;")
                    .replace(/>/g, "&gt;")
                    .replace(/"/g, "&quot;")
                    .replace(/'/g, "&#039;");
            }

            // Tube Cap CSS mapper
            function getTubeCapClass(containerType) {
                if (!containerType) return 'cap-badge-grey';
                const c = containerType.toLowerCase();
                if (c.includes('sst') || c.includes('yellow') || c.includes('gel')) return 'cap-badge-yellow';
                if (c.includes('edta') || c.includes('purple') || c.includes('lavender')) return 'cap-badge-purple';
                if (c.includes('citrate') || c.includes('blue')) return 'cap-badge-blue';
                if (c.includes('fluoride') || c.includes('grey') || c.includes('gray')) return 'cap-badge-grey';
                if (c.includes('red') || c.includes('plain') || c.includes('clot')) return 'cap-badge-red';
                if (c.includes('heparin') || c.includes('green')) return 'cap-badge-green';
                return 'cap-badge-grey';
            }

            // ── 1. Fetch and Render Samples ────────────────────────────────
            function loadSamples() {
                $('#loadingSamplesState').removeClass('d-none');
                $('#emptySamplesState').addClass('d-none');
                $('#tblSamplesBody').empty();
                $('#chkSelectAll').prop('checked', false);
                updateSelectedCount();

                const params = {
                    fromDate: $('#txtFromDate').val(),
                    toDate: $('#txtToDate').val(),
                    dateFilterType: $('#selDateFilterType').val(),
                    transferStatusFilter: currentStatusFilter,
                    search: $('#txtSearch').val(),
                    departmentId: $('#ddlDepartment').val() || null,
                    categoryId: $('#ddlCategory').val() || null,
                    subCategoryId: $('#ddlSubCategory').val() || null
                };

                $.get('@Url.Action("GetEligibleSamplesJson", "SampleTransfer")', params)
                    .done(function (res) {
                        $('#loadingSamplesState').addClass('d-none');
                        if (res.success && res.data) {
                            currentSamples = res.data.items || [];
                            updateStats(res.data.stats);
                            renderSamplesTable(currentSamples);
                        } else {
                            toastr.error('Failed to load eligible samples.');
                        }
                    })
                    .fail(function () {
                        $('#loadingSamplesState').addClass('d-none');
                        toastr.error('Server error while loading sample list.');
                    });
            }

            function updateStats(stats) {
                if (!stats) return;
                $('#statReadyCount').text(stats.readyCount);
                $('#statTransferredToday').text(stats.transferredTodayCount);
                $('#statTargetBranches').text(stats.targetBranchesCount);
                $('#badgeTabCount').text(stats.readyCount);
            }

            function renderSamplesTable(items) {
                const $tbody = $('#tblSamplesBody');
                $tbody.empty();

                if (!items || items.length === 0) {
                    $('#emptySamplesState').removeClass('d-none');
                    return;
                }

                $('#emptySamplesState').addClass('d-none');

                let html = '';
                items.forEach((item, idx) => {
                    const capClass = getTubeCapClass(item.containerType);
                    const isTransferred = item.isTransferred;
                    const canSelect = !isTransferred;
                    const chkHtml = item.isTransferred 
                        ? `<span class="text-success fs-7" title="Already Transferred"><i class="bi bi-check-circle-fill"></i></span><input type="hidden" class="hidden-sample-id" value="${item.sampleCollectionId}" />`
                        : `<input type="checkbox" class="form-check-input chk-sample-item" value="${item.sampleCollectionId}" data-transferred="false" />`;

                    let statusBadgeHtml = '';
                    if (isTransferred) {
                        statusBadgeHtml = `
                            <span class="badge bg-success-subtle text-success border border-success-subtle fs-9">
                                <i class="bi bi-check-all me-1"></i>Transferred to ${escapeHtml(item.targetBranchName || 'Target Lab')}
                            </span>
                            <div class="fs-9 text-muted mt-0.5">${formatDate(item.transferredDate)} ${formatTime(item.transferredDate)}</div>
                            <div class="fs-9 text-secondary font-monospace">${escapeHtml(item.reportStatusName || 'Pending Entry')}</div>
                        `;
                    } else {
                        statusBadgeHtml = `
                            <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle fs-9">
                                <i class="bi bi-hourglass-split me-1"></i>Ready for Transfer
                            </span>
                            <div class="fs-9 text-muted mt-0.5">Collected In-House</div>
                        `;
                    }

                    let actionHtml = '';
                    if (isTransferred) {
                        actionHtml = `<span class="badge bg-light text-success border border-success-subtle py-1 px-2 fs-9 fw-semibold"><i class="bi bi-shield-check me-1"></i>Transferred</span>`;
                    } else {
                        actionHtml = `<button type="button" class="btn btn-outline-warning btn-sm py-0.5 px-2 fs-9 fw-semibold btn-single-transfer" data-id="${item.sampleCollectionId}">
                                           <i class="bi bi-send me-1"></i>Transfer
                                       </button>`;
                    }

                    html += `
                        <tr id="sampleRow_${item.sampleCollectionId}" class="${isTransferred ? 'table-light opacity-75' : ''}">
                            <td class="ps-3 text-center">${chkHtml}</td>
                            <td>
                                <div class="fw-bold font-monospace text-primary fs-8">${escapeHtml(item.tokenNo || 'LAB')}</div>
                                <div class="fs-9 text-muted font-monospace">${escapeHtml(item.billNo || '—')}</div>
                            </td>
                            <td>
                                <div class="fw-bold text-dark fs-8">${escapeHtml(item.patientName)}</div>
                                <div class="fs-9 text-muted">
                                    <span class="badge bg-light text-dark border me-1">${escapeHtml(item.patientCode)}</span>
                                    ${item.age ? item.age + ' Y / ' : ''}${escapeHtml(item.gender || '—')}
                                    ${item.phoneNumber ? ' | ' + escapeHtml(item.phoneNumber) : ''}
                                </div>
                            </td>
                            <td>
                                <div class="d-flex align-items-center gap-1.5 flex-wrap">
                                    <span class="barcode-badge"><i class="bi bi-upc me-1"></i>${escapeHtml(item.barcodeNo || 'No Barcode')}</span>
                                    <span class="badge fs-9 ${capClass}">${escapeHtml(item.containerType || 'Tube')}</span>
                                </div>
                                <div class="fs-9 text-muted mt-0.5">${escapeHtml(item.sampleTypeName || 'Specimen')}</div>
                            </td>
                            <td>
                                <div class="fw-bold text-dark fs-8">${escapeHtml(item.testName)}</div>
                                <div class="fs-9 text-muted">
                                    <span class="badge bg-secondary-subtle text-secondary me-1">${escapeHtml(item.testCode)}</span>
                                    ${item.profilePackageName ? `<span class="badge bg-info-subtle text-info">${escapeHtml(item.profilePackageName)}</span>` : ''}
                                    ${item.departmentName ? `<span class="ms-1 text-muted">(${escapeHtml(item.departmentName)})</span>` : ''}
                                </div>
                            </td>
                            <td>
                                <div class="text-dark">${formatDate(item.collectionDate || item.orderDate)}</div>
                                <div class="fs-9 text-muted">${formatTime(item.collectionDate || item.orderDate)}</div>
                            </td>
                            <td class="text-center">${statusBadgeHtml}</td>
                            <td class="text-end pe-3">${actionHtml}</td>
                        </tr>
                    `;
                });

                $tbody.html(html);
                
                // Update Transfer Action Bar visibility
                const transferStatus = $('#selTransferStatus').val() || 'Pending';
                if (transferStatus === 'Transferred') {
                    $('#btnExecuteTransfer').addClass('d-none');
                    $('#btnPrintTransferSelected').html('<i class="bi bi-printer"></i><span>Print All</span>');
                    $('#chkSelectAll').addClass('d-none');
                } else {
                    $('#btnExecuteTransfer').removeClass('d-none');
                    $('#btnPrintTransferSelected').html('<i class="bi bi-printer"></i><span>Print Selected</span>');
                    $('#chkSelectAll').removeClass('d-none');
                }
            }

            // ── 2. Selection Handling ─────────────────────────────────────
            function updateSelectedCount() {
                const count = $('.chk-sample-item:checked').length;
                $('#selectedCountBadge').text(`${count} Selected`);
                if (count > 0) {
                    $('#selectedCountBadge').removeClass('bg-secondary').addClass('bg-warning text-dark');
                } else {
                    $('#selectedCountBadge').removeClass('bg-warning text-dark').addClass('bg-secondary text-white');
                }
            }

            $('#chkSelectAll').on('change', function () {
                const isChecked = $(this).is(':checked');
                $('.chk-sample-item').prop('checked', isChecked);
                updateSelectedCount();
            });

            $(document).on('change', '.chk-sample-item', function () {
                updateSelectedCount();
                const total = $('.chk-sample-item').length;
                const checked = $('.chk-sample-item:checked').length;
                $('#chkSelectAll').prop('checked', total > 0 && total === checked);
            });

            // ── 3. Filter Interactions ────────────────────────────────────
            $('#cardReadyFilter').on('click', function () {
                $('#dispatchKpiCards .stat-card').removeClass('active-card');
                $(this).addClass('active-card');
                currentStatusFilter = 'Ready';
                $('#selTransferStatus').val('Ready');
                if ($('#selDateFilterType').val() === 'TransferDate') {
                    $('#selDateFilterType').val('CollectionDate');
                }
                loadSamples();
            });

            $('#cardTransferredFilter').on('click', function () {
                $('#dispatchKpiCards .stat-card').removeClass('active-card');
                $(this).addClass('active-card');
                currentStatusFilter = 'Transferred';
                $('#selTransferStatus').val('Transferred');
                $('#selDateFilterType').val('TransferDate');
                const todayIso = formatIsoDate(new Date());
                $('#txtFromDate').val(todayIso);
                $('#txtToDate').val(todayIso);
                loadSamples();
            });

            $('#selTransferStatus').on('change', function () {
                currentStatusFilter = $(this).val();
                $('#dispatchKpiCards .stat-card').removeClass('active-card');
                if (currentStatusFilter === 'Ready') {
                    $('#cardReadyFilter').addClass('active-card');
                    if ($('#selDateFilterType').val() === 'TransferDate') {
                        $('#selDateFilterType').val('CollectionDate');
                    }
                }
                if (currentStatusFilter === 'Transferred') {
                    $('#cardTransferredFilter').addClass('active-card');
                    $('#selDateFilterType').val('TransferDate');
                }
                loadSamples();
            });

            $('#txtFromDate, #txtToDate, #selDateFilterType').on('change', function () {
                loadSamples();
            });

            $('#btnRefreshList').on('click', function () {
                if ($('#receive-tab').hasClass('active')) {
                    loadReceivableSamples();
                } else if ($('#history-tab').hasClass('active')) {
                    loadHistory();
                } else {
                    loadSamples();
                }
            });

            $('#txtSearch').on('input', function () {
                clearTimeout(searchTimeout);
                searchTimeout = setTimeout(loadSamples, 350);
            });

            $('#btnClearSearch').on('click', function () {
                $('#txtSearch').val('');
                loadSamples();
            });

            // ── Quick Date Range Selectors ──
            $('.btn-quick-date').on('click', function () {
                const range = $(this).data('range');
                const today = new Date();
                let from = new Date();
                let to = new Date();

                if (range === 'today') {
                    from = today;
                    to = today;
                } else if (range === 'yesterday') {
                    from.setDate(today.getDate() - 1);
                    to.setDate(today.getDate() - 1);
                } else if (range === 'week') {
                    from.setDate(today.getDate() - 7);
                    to = today;
                } else if (range === 'month') {
                    from = new Date(today.getFullYear(), today.getMonth(), 1);
                    to = today;
                }

                $('#txtFromDate').val(formatIsoDate(from));
                $('#txtToDate').val(formatIsoDate(to));
                loadSamples();
            });

            function formatIsoDate(d) {
                const year = d.getFullYear();
                const month = String(d.getMonth() + 1).padStart(2, '0');
                const day = String(d.getDate()).padStart(2, '0');
                return `${year}-${month}-${day}`;
            }

            // ── Department, Category & Sub Category Cascading Filters ──
            function checkFilterResetVisibility() {
                var d = $('#ddlDepartment').val();
                var c = $('#ddlCategory').val();
                var s = $('#ddlSubCategory').val();
                if (d || c || s) {
                    $('#btnResetFilters').show();
                } else {
                    $('#btnResetFilters').hide();
                }
            }

            $('#btnResetFilters').on('click', function () {
                $('#ddlDepartment').val('');
                $('#ddlCategory').empty().append('<option value="">-- All Categories --</option>').val('');
                $('#ddlSubCategory').empty().append('<option value="">-- All Sub Categories --</option>').val('');
                $(this).hide();
                loadSamples();
            });

            $('#ddlDepartment').on('change', function () {
                checkFilterResetVisibility();
                var deptId = $(this).val();
                
                var $cat = $('#ddlCategory');
                $cat.empty().append('<option value="">-- All Categories --</option>');
                
                var $subCat = $('#ddlSubCategory');
                $subCat.empty().append('<option value="">-- All Sub Categories --</option>');

                var catUrl = '@Url.Action("GetCategoriesForDropdown", "SampleTransfer")' + (deptId ? '?departmentId=' + deptId : '');
                $.get(catUrl, function (data) {
                    if (data && data.length) {
                        data.forEach(function (item) {
                            $cat.append(new Option(item.text, item.value));
                        });
                    }
                    $cat.val('');
                    $subCat.val('');
                    loadSamples();
                });
            });

            $('#ddlCategory').on('change', function () {
                checkFilterResetVisibility();
                var catId = $(this).val();
                
                var $subCat = $('#ddlSubCategory');
                $subCat.empty().append('<option value="">-- All Sub Categories --</option>');
                
                var subCatUrl = '@Url.Action("GetSubCategoriesForDropdown", "SampleTransfer")' + (catId ? '?categoryId=' + catId : '');
                $.get(subCatUrl, function (data) {
                    if (data && data.length) {
                        data.forEach(function (item) {
                            $subCat.append(new Option(item.text, item.value));
                        });
                    }
                    $subCat.val('');
                    loadSamples();
                });
            });

            $('#ddlSubCategory').on('change', function () {
                checkFilterResetVisibility();
                loadSamples();
            });

            checkFilterResetVisibility();

            // ── 4. Transfer Execution ─────────────────────────────────────
            function triggerTransferModal(ids) {
                if (!ids || ids.length === 0) {
                    toastr.warning('Please select at least one sample to transfer.');
                    return;
                }

                const targetBranchId = $('#ddlTargetBranch').val();
                if (!targetBranchId) {
                    toastr.warning('Please select a destination/target branch first.');
                    $('#ddlTargetBranch').focus();
                    return;
                }

                const targetBranchText = $('#ddlTargetBranch option:selected').text();
                const remarks = $('#txtTransferRemarks').val().trim();

                pendingTransferIds = ids;
                $('#modalTargetBranchText').text(targetBranchText);
                $('#modalSamplesSummary').text(`${ids.length} sample(s) queued for transfer`);
                $('#modalRemarksText').text(remarks || 'No remarks provided');

                const modal = new bootstrap.Modal(document.getElementById('modalConfirmTransfer'));
                modal.show();
            }

            // Bulk Transfer Button
            $('#btnExecuteTransfer').on('click', function () {
                const selectedIds = [];
                let hasTransferred = false;
                $('.chk-sample-item:checked').each(function () {
                    if ($(this).attr('data-transferred') === 'true') hasTransferred = true;
                    selectedIds.push(parseInt($(this).val()));
                });

                if (selectedIds.length === 0) {
                    toastr.warning('No samples selected. Check the boxes next to the samples you want to transfer.');
                    return;
                }

                if (hasTransferred) {
                    toastr.error('You cannot transfer samples that have already been transferred. Please uncheck them.');
                    return;
                }

                triggerTransferModal(selectedIds);
            });

            // Single Row Transfer Button
            $(document).on('click', '.btn-single-transfer', function () {
                const sampleId = parseInt($(this).data('id'));
                // Check if target branch is picked
                if (!$('#ddlTargetBranch').val()) {
                    toastr.info('Select a Destination Branch from the top bar before initiating transfer.');
                    $('#ddlTargetBranch').focus();
                    return;
                }
                triggerTransferModal([sampleId]);
            });

            // Submit Transfer in Modal
            $('#btnConfirmTransferSubmit').on('click', function () {
                const targetBranchId = parseInt($('#ddlTargetBranch').val());
                const remarks = $('#txtTransferRemarks').val().trim();

                if (!pendingTransferIds || pendingTransferIds.length === 0 || !targetBranchId) {
                    toastr.error('Invalid transfer parameters.');
                    return;
                }

                const $btn = $(this);
                $btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>Transferring...');

                const payload = {
                    sampleCollectionIds: pendingTransferIds,
                    targetBranchId: targetBranchId,
                    transferRemarks: remarks
                };

                $.ajax({
                    url: '@Url.Action("ExecuteTransferJson", "SampleTransfer")',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(payload),
                    success: function (res) {
                        $btn.prop('disabled', false).html('<i class="bi bi-send-check me-1"></i>Proceed Transfer');
                        const modalEl = document.getElementById('modalConfirmTransfer');
                        const modalInstance = bootstrap.Modal.getInstance(modalEl) || bootstrap.Modal.getOrCreateInstance(modalEl);
                        if (modalInstance) modalInstance.hide();

                        if (res.success) {
                            toastr.success(res.message || `Successfully transferred ${res.transferredCount} sample(s)!`);
                            $('#txtTransferRemarks').val('');
                            loadSamples();
                            refreshReceiveStats();
                            
                            // Automatically popup print worksheet
                            if (res.processedIds) {
                                openPrintWorksheet(res.processedIds, 'Transfer');
                            }
                        } else {
                            toastr.error(res.message || 'Transfer failed.');
                        }
                    },
                    error: function (xhr) {
                        $btn.prop('disabled', false).html('<i class="bi bi-send-check me-1"></i>Proceed Transfer');
                        let errMsg = 'Error occurred while executing sample transfer.';
                        if (xhr.responseJSON && xhr.responseJSON.message) {
                            errMsg = xhr.responseJSON.message;
                        } else if (xhr.responseText) {
                            try {
                                const parsed = JSON.parse(xhr.responseText);
                                if (parsed.message) errMsg = parsed.message;
                                else errMsg = xhr.responseText;
                            } catch (e) {
                                errMsg = xhr.responseText;
                            }
                        }
                        toastr.error(errMsg);
                    }
                });
            });

            
            // ── 1.5 Fetch and Render Receivable Samples ─────────────────────
            let pendingReceiveIds = [];
            
            function updateReceiveStats(stats) {
                if (!stats) return;
                const pending = stats.pendingReceiveCount ?? 0;
                const receivedToday = stats.receivedTodayCount ?? 0;
                const sourceBranches = stats.sourceBranchesCount ?? 0;

                $('#statPendingReceiveCount').text(pending);
                $('#statReceivedTodayCount').text(receivedToday);
                $('#statSourceBranchesCount').text(sourceBranches);

                if (pending > 0) {
                    $('#badgeReceiveTabCount').text(pending).show();
                } else {
                    $('#badgeReceiveTabCount').hide();
                }
            }

            function refreshReceiveStats() {
                $.get('/SampleTransfer/GetReceivableSamplesJson')
                    .done(function (res) {
                        if (res.success && res.data && res.data.stats) {
                            updateReceiveStats(res.data.stats);
                        }
                    });
            }

            function loadReceivableSamples() {
                $('#loadingReceiveState').removeClass('d-none');
                $('#emptyReceiveState').addClass('d-none');
                $('#tblReceiveSamplesBody').empty();
                $('#chkReceiveSelectAll').prop('checked', false);
                updateSelectedReceiveCount();

                const receiveStatus = $('#selReceiveStatus').val() || 'Pending';
                const dateFilterType = $('#selReceiveDateFilterType').val() || 'ReceivedDate';
                const fromDate = $('#txtReceiveFromDate').val();
                const toDate = $('#txtReceiveToDate').val();

                // Always show receiveActionBar so Print button is available
                $('#receiveActionBar').removeClass('d-none');
                
                if (receiveStatus === 'Received') {
                    $('#btnExecuteReceive').addClass('d-none');
                    $('#btnPrintReceiveSelected').html('<i class="bi bi-printer"></i><span>Print All</span>');
                    $('#chkSelectAllReceive').addClass('d-none');
                } else {
                    $('#btnExecuteReceive').removeClass('d-none');
                    $('#btnPrintReceiveSelected').html('<i class="bi bi-printer"></i><span>Print Selected</span>');
                    $('#chkSelectAllReceive').removeClass('d-none');
                }

                const params = {
                    receiveStatusFilter: receiveStatus,
                    dateFilterType: dateFilterType,
                    fromDate: fromDate,
                    toDate: toDate,
                    search: $('#txtReceiveSearch').val()
                };

                $.get('/SampleTransfer/GetReceivableSamplesJson', params)
                    .done(function (res) {
                        $('#loadingReceiveState').addClass('d-none');
                        if (res.success && res.data) {
                            const items = res.data.items || [];
                            const stats = res.data.stats;
                            
                            updateReceiveStats(stats);
                            renderReceivableTable(items);
                        } else {
                            toastr.error('Failed to load incoming samples.');
                        }
                    })
                    .fail(function () {
                        $('#loadingReceiveState').addClass('d-none');
                        toastr.error('Server error while loading incoming sample list.');
                    });
            }

            function renderReceivableTable(items) {
                const $tbody = $('#tblReceiveSamplesBody');
                $tbody.empty();

                if (!items || items.length === 0) {
                    const statusVal = $('#selReceiveStatus').val() || 'Pending';
                    if (statusVal === 'Received') {
                        $('#emptyReceiveState .fs-6').text('No Received Samples Found');
                        $('#emptyReceiveState .text-muted.fs-8').text('No samples have been received for the selected date range.');
                    } else {
                        $('#emptyReceiveState .fs-6').text('No Incoming Samples');
                        $('#emptyReceiveState .text-muted.fs-8').text('There are no pending samples dispatched to this branch.');
                    }
                    $('#emptyReceiveState').removeClass('d-none');
                    return;
                }

                $('#emptyReceiveState').addClass('d-none');

                let html = '';
                items.forEach((item) => {
                    const capClass = getTubeCapClass(item.containerType);
                    
                    let actionHtml = '';
                    let statusHtml = '';

                    let chkHtml = item.isReceived 
                        ? `<span class="text-success fs-7" title="Already Received"><i class="bi bi-check-circle-fill"></i></span><input type="hidden" class="hidden-receive-id" value="${item.sampleCollectionId}" />`
                        : `<input type="checkbox" class="form-check-input chk-receive-item" value="${item.sampleCollectionId}" data-received="false" />`;


                    if (item.isReceived) {
                        statusHtml = `
                            <span class="badge bg-success-subtle text-success border border-success-subtle py-1 px-2">
                                <i class="bi bi-check2-all me-1"></i>Received
                            </span>
                            <div class="fs-9 text-muted mt-1">
                                <div><i class="bi bi-calendar-check me-1"></i>${formatDate(item.receivedDate)} ${formatTime(item.receivedDate)}</div>
                                ${item.receivedByName ? `<div><i class="bi bi-person me-1"></i>${escapeHtml(item.receivedByName)}</div>` : ''}
                            </div>
                        `;
                        actionHtml = `<span class="badge bg-light text-success border border-success-subtle py-1 px-2 fs-9 fw-semibold"><i class="bi bi-shield-check me-1"></i>Acknowledged</span>`;
                    } else {
                        statusHtml = `
                            <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle py-1 px-2">
                                <i class="bi bi-hourglass-split me-1"></i>Pending Receipt
                            </span>
                        `;
                        actionHtml = `<button type="button" class="btn btn-outline-success btn-sm py-0.5 px-2 fs-9 fw-semibold btn-single-receive" data-id="${item.sampleCollectionId}">
                                           <i class="bi bi-check me-1"></i>Receive
                                       </button>`;
                    }

                    html += `
                        <tr>
                            <td class="ps-3 text-center">${chkHtml}</td>
                            <td>
                                <div class="fw-bold font-monospace text-primary fs-8">${escapeHtml(item.tokenNo || 'LAB')}</div>
                                <div class="fs-9 text-muted font-monospace">${escapeHtml(item.billNo || '—')}</div>
                            </td>
                            <td>
                                <div class="fw-bold text-dark fs-8">${escapeHtml(item.patientName)}</div>
                                <div class="fs-9 text-muted">
                                    <span class="badge bg-light text-dark border me-1">${escapeHtml(item.patientCode)}</span>
                                    ${item.age ? item.age + ' Y / ' : ''}${escapeHtml(item.gender || '—')}
                                </div>
                            </td>
                            <td>
                                <div class="d-flex align-items-center gap-1.5 flex-wrap">
                                    <span class="barcode-badge"><i class="bi bi-upc me-1"></i>${escapeHtml(item.barcodeNo || 'No Barcode')}</span>
                                    <span class="badge fs-9 ${capClass}">${escapeHtml(item.containerType || 'Tube')}</span>
                                </div>
                                <div class="fs-9 text-muted mt-0.5">${escapeHtml(item.sampleTypeName || 'Specimen')}</div>
                            </td>
                            <td>
                                <div class="fw-bold text-dark fs-8">${escapeHtml(item.testName)}</div>
                                <div class="fs-9 text-muted">
                                    <span class="badge bg-secondary-subtle text-secondary me-1">${escapeHtml(item.testCode)}</span>
                                </div>
                            </td>
                            <td>
                                <span class="badge bg-info-subtle text-info border border-info-subtle fs-9">
                                    ${escapeHtml(item.sourceBranchName)}
                                </span>
                            </td>
                            <td>
                                <div class="text-dark">${formatDate(item.transferredDate)} ${formatTime(item.transferredDate)}</div>
                                <div class="fs-9 text-muted">By: ${escapeHtml(item.transferredByName || 'System')}</div>
                            </td>
                            <td class="text-center">${statusHtml}</td>
                            <td class="text-end pe-3">${actionHtml}</td>
                        </tr>
                    `;
                });
                $tbody.html(html);
            }

            function updateSelectedReceiveCount() {
                const count = $('.chk-receive-item:checked').length;
                $('#selectedReceiveCountBadge').text(`${count} Selected`);
            }

            $('#chkReceiveSelectAll').on('change', function () {
                $('.chk-receive-item').prop('checked', $(this).is(':checked'));
                updateSelectedReceiveCount();
            });

            $(document).on('change', '.chk-receive-item', function () {
                updateSelectedReceiveCount();
                const total = $('.chk-receive-item').length;
                const checked = $('.chk-receive-item:checked').length;
                $('#chkReceiveSelectAll').prop('checked', total > 0 && total === checked);
            });

            $('#btnRefreshReceive').on('click', loadReceivableSamples);

            $('#txtReceiveFromDate, #txtReceiveToDate, #selReceiveDateFilterType').on('change', function () {
                loadReceivableSamples();
            });

            $('#selReceiveStatus').on('change', function () {
                const val = $(this).val();
                $('#receiveKpiCards .stat-card').removeClass('active-card');
                if (val === 'Pending') {
                    $('#cardPendingReceive').addClass('active-card');
                } else if (val === 'Received') {
                    $('#cardReceivedToday').addClass('active-card');
                    $('#selReceiveDateFilterType').val('ReceivedDate');
                }
                loadReceivableSamples();
            });

            $('.btn-quick-receive-date').on('click', function () {
                const range = $(this).data('range');
                const today = new Date();
                let from = new Date();
                let to = new Date();

                if (range === 'today') {
                    from = today;
                    to = today;
                } else if (range === 'yesterday') {
                    from.setDate(today.getDate() - 1);
                    to.setDate(today.getDate() - 1);
                } else if (range === 'week') {
                    from.setDate(today.getDate() - 7);
                    to = today;
                } else if (range === 'month') {
                    from = new Date(today.getFullYear(), today.getMonth(), 1);
                    to = today;
                }

                $('#txtReceiveFromDate').val(formatIsoDate(from));
                $('#txtReceiveToDate').val(formatIsoDate(to));
                loadReceivableSamples();
            });

            let receiveSearchTimeout = null;
            $('#txtReceiveSearch').on('input', function () {
                clearTimeout(receiveSearchTimeout);
                receiveSearchTimeout = setTimeout(loadReceivableSamples, 350);
            });

            $('#btnClearReceiveSearch').on('click', function () {
                $('#txtReceiveSearch').val('');
                loadReceivableSamples();
            });

            $('#receive-tab').on('shown.bs.tab', function () {
                switchKpiCards('receive');
                loadReceivableSamples();
            });
            
            $('#dispatch-tab').on('shown.bs.tab', function () {
                switchKpiCards('dispatch');
                loadSamples();
            });
            
            function triggerReceiveModal(ids) {
                if (!ids || ids.length === 0) {
                    toastr.warning('Please select at least one sample to receive.');
                    return;
                }
                
                const remarks = $('#txtReceiveRemarks').val().trim();
                pendingReceiveIds = ids;
                
                $('#modalReceiveSamplesSummary').text(`${ids.length} sample(s) queued for receipt`);
                $('#modalReceiveRemarksText').text(remarks || 'No remarks provided');
                
                new bootstrap.Modal(document.getElementById('modalConfirmReceive')).show();
            }

            $('#btnExecuteReceive').on('click', function () {
                const selectedIds = [];
                let hasReceived = false;
                $('.chk-receive-item:checked').each(function () {
                    if ($(this).attr('data-received') === 'true') hasReceived = true;
                    selectedIds.push(parseInt($(this).val()));
                });
                
                if (selectedIds.length === 0) {
                    toastr.warning('No samples selected. Check the boxes next to the samples you want to receive.');
                    return;
                }

                if (hasReceived) {
                    toastr.error('You cannot receive samples that have already been received. Please uncheck them.');
                    return;
                }

                triggerReceiveModal(selectedIds);
            });
            
            $(document).on('click', '.btn-single-receive', function () {
                triggerReceiveModal([parseInt($(this).data('id'))]);
            });

            $('#btnConfirmReceiveSubmit').on('click', function () {
                const remarks = $('#txtReceiveRemarks').val().trim();
                if (!pendingReceiveIds || pendingReceiveIds.length === 0) return;
                
                const $btn = $(this);
                $btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>Receiving...');

                $.ajax({
                    url: '/SampleTransfer/ExecuteReceiveJson',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({
                        sampleCollectionIds: pendingReceiveIds,
                        receiveRemarks: remarks
                    }),
                    success: function (res) {
                        $btn.prop('disabled', false).html('<i class="bi bi-check-circle me-1"></i>Confirm Receive');
                        const modalEl = document.getElementById('modalConfirmReceive');
                        const modalInstance = bootstrap.Modal.getInstance(modalEl) || bootstrap.Modal.getOrCreateInstance(modalEl);
                        if (modalInstance) modalInstance.hide();
                        
                        if (res.success) {
                            toastr.success(res.message || `Successfully received ${res.receivedCount} sample(s)!`);
                            $('#txtReceiveRemarks').val('');
                            loadReceivableSamples();
                            loadSamples();

                            // Automatically popup print worksheet
                            if (res.processedIds) {
                                openPrintWorksheet(res.processedIds, 'Receive');
                            }
                        } else {
                            toastr.error(res.message || 'Receive failed.');
                        }
                    },
                    error: function (xhr) {
                        $btn.prop('disabled', false).html('<i class="bi bi-check-circle me-1"></i>Confirm Receive');
                        let errMsg = 'Error occurred while receiving samples.';
                        if (xhr.responseJSON && xhr.responseJSON.message) {
                            errMsg = xhr.responseJSON.message;
                        } else if (xhr.responseText) {
                            try {
                                const parsed = JSON.parse(xhr.responseText);
                                if (parsed.message) errMsg = parsed.message;
                                else errMsg = xhr.responseText;
                            } catch (e) {
                                errMsg = xhr.responseText;
                            }
                        }
                        toastr.error(errMsg);
                    }
                });
            });

            // ── 5. Audit & History ────────────────────────────────────────

            function loadHistory() {
                $('#loadingHistoryState').removeClass('d-none');
                $('#emptyHistoryState').addClass('d-none');
                $('#tblHistoryBody').empty();

                const mode = $('input[name="radHistoryMode"]:checked').val() || 'Outgoing';
                const params = {
                    mode: mode,
                    fromDate: $('#txtHistoryFromDate').val(),
                    toDate: $('#txtHistoryToDate').val(),
                    search: $('#txtHistorySearch').val()
                };

                $.get('@Url.Action("GetHistoryJson", "SampleTransfer")', params)
                    .done(function (res) {
                        $('#loadingHistoryState').addClass('d-none');
                        if (res.success && res.data) {
                            renderHistoryTable(res.data);
                        } else {
                            toastr.error('Failed to load transfer history.');
                        }
                    })
                    .fail(function () {
                        $('#loadingHistoryState').addClass('d-none');
                        toastr.error('Server error loading transfer audit history.');
                    });
            }

            function renderHistoryTable(items) {
                const $tbody = $('#tblHistoryBody');
                $tbody.empty();

                if (!items || items.length === 0) {
                    $('#emptyHistoryState').removeClass('d-none');
                    return;
                }

                $('#emptyHistoryState').addClass('d-none');

                let html = '';
                items.forEach((item, idx) => {
                    html += `
                        <tr>
                            <td class="ps-3 text-muted fw-bold">${idx + 1}</td>
                            <td>
                                <div class="text-dark fw-bold">${formatDate(item.transferredDate)}</div>
                                <div class="fs-9 text-muted">${formatTime(item.transferredDate)}</div>
                            </td>
                            <td>
                                <span class="barcode-badge"><i class="bi bi-upc me-1"></i>${escapeHtml(item.barcodeNo || 'No Barcode')}</span>
                                <div class="fs-9 text-muted font-monospace mt-0.5">${escapeHtml(item.billNo || '—')}</div>
                            </td>
                            <td>
                                <div class="fw-bold text-dark fs-8">${escapeHtml(item.patientName)}</div>
                                <div class="fs-9 text-muted">${escapeHtml(item.patientCode)}</div>
                            </td>
                            <td>
                                <div class="fw-bold text-dark fs-8">${escapeHtml(item.testName)}</div>
                                <div class="fs-9 text-muted">${escapeHtml(item.testCode || '')} (${escapeHtml(item.sampleTypeName || '')})</div>
                            </td>
                            <td>
                                <div class="d-flex align-items-center gap-1">
                                    <span class="badge bg-secondary-subtle text-secondary fs-9">${escapeHtml(item.sourceBranchName)}</span>
                                    <i class="bi bi-arrow-right text-muted fs-8"></i>
                                    <span class="badge bg-primary-subtle text-primary fs-9">${escapeHtml(item.targetBranchName)}</span>
                                </div>
                            </td>
                            <td>
                                <div class="text-dark fw-semibold fs-9"><i class="bi bi-person me-1"></i>${escapeHtml(item.transferredByName || 'System')}</div>
                                <div class="fs-9 text-muted font-italic">${escapeHtml(item.transferRemarks || 'No remarks')}</div>
                            </td>
                            <td class="text-center">
                                <span class="badge bg-info-subtle text-info border border-info-subtle fs-9">
                                    ${escapeHtml(item.reportStatusName || 'Pending Entry')}
                                </span>
                            </td>
                        </tr>
                    `;
                });

                $tbody.html(html);
            }

            // ── Dynamic KPI Card Switching ──────────────────────────────
            function switchKpiCards(tabKey) {
                if (tabKey === 'receive') {
                    $('#dispatchKpiCards').addClass('d-none');
                    $('#receiveKpiCards').removeClass('d-none');
                } else {
                    $('#receiveKpiCards').addClass('d-none');
                    $('#dispatchKpiCards').removeClass('d-none');
                }
            }

            $('#history-tab').on('shown.bs.tab', function () {
                const mode = $('input[name="radHistoryMode"]:checked').val() || 'Outgoing';
                switchKpiCards(mode === 'Incoming' ? 'receive' : 'dispatch');
                loadHistory();
            });

            $('input[name="radHistoryMode"]').on('change', function () {
                if ($('#history-tab').hasClass('active')) {
                    const mode = $(this).val();
                    switchKpiCards(mode === 'Incoming' ? 'receive' : 'dispatch');
                }
            });

            $('#btnFilterHistory').on('click', function () {
                loadHistory();
            });

            // Receive KPI Card click interactions
            $('#cardPendingReceive').on('click', function () {
                const receiveTabTrigger = document.querySelector('#receive-tab');
                if (receiveTabTrigger && !$('#receive-tab').hasClass('active')) {
                    bootstrap.Tab.getOrCreateInstance(receiveTabTrigger).show();
                }
                $('#receiveKpiCards .stat-card').removeClass('active-card');
                $(this).addClass('active-card');
                $('#selReceiveStatus').val('Pending');
                loadReceivableSamples();
            });

            $('#cardReceivedToday').on('click', function () {
                const receiveTabTrigger = document.querySelector('#receive-tab');
                if (receiveTabTrigger && !$('#receive-tab').hasClass('active')) {
                    bootstrap.Tab.getOrCreateInstance(receiveTabTrigger).show();
                }
                $('#receiveKpiCards .stat-card').removeClass('active-card');
                $(this).addClass('active-card');
                $('#selReceiveStatus').val('Received');
                $('#selReceiveDateFilterType').val('ReceivedDate');
                const todayIso = formatIsoDate(new Date());
                $('#txtReceiveFromDate').val(todayIso);
                $('#txtReceiveToDate').val(todayIso);
                loadReceivableSamples();
            });

            // Initial load
            loadSamples();
            refreshReceiveStats();
            
            // ── 6. Print Worksheet Functions ──────────────────────────────
            function openPrintWorksheet(ids, mode) {
                if (!ids) return;
                const url = `@Url.Action("PrintWorksheet", "SampleTransfer")?ids=${encodeURIComponent(ids)}&mode=${encodeURIComponent(mode)}`;
                $('#printWorksheetFrame').attr('src', url);
                new bootstrap.Modal(document.getElementById('modalPrintWorksheet')).show();
            }

            $('#btnPrintTransferSelected').on('click', function () {
                const transferStatus = $('#selTransferStatus').val() || 'Pending';
                const selectedIds = [];
                
                if (transferStatus === 'Transferred') {
                    $('.hidden-sample-id').each(function() {
                        selectedIds.push(parseInt($(this).val()));
                    });
                } else {
                    $('.chk-sample-item:checked').each(function () {
                        selectedIds.push(parseInt($(this).val()));
                    });
                }
                
                if (selectedIds.length === 0) {
                    toastr.warning(transferStatus === 'Transferred' ? 'No transferred samples found to print.' : 'Please select at least one sample to print.');
                    return;
                }
                
                if (transferStatus !== 'Transferred') {
                    toastr.error('Worksheets can only be printed for samples that have already been transferred.');
                    return;
                }
                
                openPrintWorksheet(selectedIds.join(','), 'Transfer');
            });

            $('#btnPrintReceiveSelected').on('click', function () {
                const receiveStatus = $('#selReceiveStatus').val() || 'Pending';
                const selectedIds = [];
                
                if (receiveStatus === 'Received') {
                    $('.hidden-receive-id').each(function() {
                        selectedIds.push(parseInt($(this).val()));
                    });
                } else {
                    $('.chk-receive-item:checked').each(function () {
                        selectedIds.push(parseInt($(this).val()));
                    });
                }
                
                if (selectedIds.length === 0) {
                    toastr.warning(receiveStatus === 'Received' ? 'No received samples found to print.' : 'Please select at least one sample to print.');
                    return;
                }
                
                if (receiveStatus !== 'Received') {
                    toastr.error('Worksheets can only be printed for samples that have already been received.');
                    return;
                }
                
                openPrintWorksheet(selectedIds.join(','), 'Receive');
            });
        });
    </script>
}
