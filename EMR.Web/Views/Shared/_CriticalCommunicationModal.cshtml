@* Critical value communication form (NABL; SQLScripts/2202), shared by Pathologist Dashboard sign-off, Report Entry
   approval and Reports > LAB > Critical & Panic Value Register. Driven by wwwroot/js/critical-communication.js:
   CriticalComm.ensure({ labOrderId, sampleIds, context }) before a sign-off, CriticalComm.open({ labOrderId, sampleIds })
   from the register. Render it inside the page's Scripts section (after jQuery / Bootstrap). *@
<style>
    #critCommModal .cc-table td, #critCommModal .cc-table th { font-size:.78rem; vertical-align:middle; }
    #critCommModal .cc-table th { font-size:.66rem; text-transform:uppercase; letter-spacing:.4px; color:#64748b; background:#f8fafc; }
    #critCommModal .cc-pick .btn { font-size:.74rem; }
    #critCommModal .cc-pick .btn.active { background:#b91c1c; border-color:#b91c1c; color:#fff; }
    #critCommModal .cc-outcome .btn.active[data-outcome="INFORMED"] { background:#15803d; border-color:#15803d; color:#fff; }
    #critCommModal .cc-outcome .btn.active[data-outcome="ATTEMPTED"] { background:#b45309; border-color:#b45309; color:#fff; }
    #critCommModal .form-label { font-size:.68rem; font-weight:700; text-transform:uppercase; letter-spacing:.4px; color:#64748b; margin-bottom:2px; }
    #critCommModal .cc-history { font-size:.74rem; }
    #critCommModal .cc-history .inactive { text-decoration:line-through; color:#94a3b8; }
</style>
<div class="modal fade" id="critCommModal" tabindex="-1" aria-labelledby="critCommTitle" aria-hidden="true" data-bs-backdrop="static"
     data-pending-url="@Url.Action("Pending", "LabCriticalCommunication")" data-record-url="@Url.Action("Record", "LabCriticalCommunication")">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content border-0 shadow">
            <div class="modal-header py-2 px-3" style="background:#fef2f2;">
                <div>
                    <h6 class="modal-title fw-bold mb-0 text-danger" id="critCommTitle"><i class="bi bi-exclamation-octagon-fill me-2"></i>Critical value communication</h6>
                    <div class="fs-8 text-muted" id="ccBill"></div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body px-3 py-2">
                <div class="alert alert-warning py-2 px-3 fs-8 mb-2" id="ccIntro"></div>
                <div class="table-responsive mb-2">
                    <table class="table table-sm mb-0 cc-table">
                        <thead><tr><th style="width:28px;"></th><th>Result</th><th>Value</th><th>Limit</th><th>Communication</th></tr></thead>
                        <tbody id="ccResults"></tbody>
                    </table>
                </div>

                <div class="border rounded-3 p-2 px-3" id="ccForm">
                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
                        <div class="btn-group btn-group-sm cc-outcome" role="group" aria-label="Outcome">
                            <button type="button" class="btn btn-outline-secondary active" data-outcome="INFORMED"><i class="bi bi-telephone-inbound me-1"></i>Informed</button>
                            <button type="button" class="btn btn-outline-secondary" data-outcome="ATTEMPTED"><i class="bi bi-telephone-x me-1"></i>Attempted, not reachable</button>
                        </div>
                        <div class="btn-group btn-group-sm cc-pick flex-wrap" role="group" aria-label="Who" id="ccPick"></div>
                    </div>
                    <div class="row g-2">
                        <div class="col-12 col-md-5">
                            <label class="form-label" for="ccName" id="ccNameLabel">Person informed *</label>
                            <input type="text" class="form-control form-control-sm" id="ccName" maxlength="150" autocomplete="off" />
                        </div>
                        <div class="col-6 col-md-3">
                            <label class="form-label" for="ccRole">Who is this *</label>
                            <select class="form-select form-select-sm" id="ccRole">
                                <option value="REFDOCTOR">Referring doctor</option>
                                <option value="TREATDOCTOR">Treating doctor</option>
                                <option value="PATIENT">Patient</option>
                                <option value="ATTENDANT">Attendant / relative</option>
                                <option value="WARD">Ward / nurse</option>
                                <option value="PARTNER">B2B partner</option>
                                <option value="OTHER">Other</option>
                            </select>
                        </div>
                        <div class="col-6 col-md-4">
                            <label class="form-label" for="ccMode">How *</label>
                            <select class="form-select form-select-sm" id="ccMode">
                                <option value="PHONE">Phone call</option>
                                <option value="INPERSON">In person</option>
                                <option value="WHATSAPP">WhatsApp</option>
                                <option value="SMS">SMS</option>
                                <option value="EMAIL">Email</option>
                            </select>
                        </div>
                        <div class="col-12 col-md-5">
                            <label class="form-label" for="ccContact" id="ccContactLabel">Number called *</label>
                            <input type="text" class="form-control form-control-sm" id="ccContact" maxlength="150" autocomplete="off" />
                        </div>
                        <div class="col-12 col-md-4">
                            <label class="form-label" for="ccOn" id="ccOnLabel">Informed at *</label>
                            <input type="datetime-local" class="form-control form-control-sm" id="ccOn" />
                        </div>
                        <div class="col-12 col-md-3 d-flex align-items-end">
                            <div class="form-check mb-1" id="ccReadBackBox">
                                <input class="form-check-input" type="checkbox" id="ccReadBack" />
                                <label class="form-check-label fs-8" for="ccReadBack" title="The person repeated the value back and it was confirmed">Value read back</label>
                            </div>
                        </div>
                        <div class="col-12 d-none" id="ccSendBox">
                            <div class="form-check form-switch mb-0">
                                <input class="form-check-input" type="checkbox" role="switch" id="ccSend" checked />
                                <label class="form-check-label fs-8" for="ccSend" id="ccSendLabel">Send this message now from eClinicPlus</label>
                            </div>
                            <div class="fs-9 text-muted">Uses the branch's existing WhatsApp / email set-up. If it can't be sent, the record becomes "Attempted" with the reason.</div>
                        </div>
                        <div class="col-12">
                            <label class="form-label" for="ccRemarks" id="ccRemarksLabel">Remarks</label>
                            <input type="text" class="form-control form-control-sm" id="ccRemarks" maxlength="500" autocomplete="off" />
                        </div>
                        <div class="col-12 d-none" id="ccCorrectBox">
                            <div class="form-check mb-0">
                                <input class="form-check-input" type="checkbox" id="ccCorrect" />
                                <label class="form-check-label fs-8" for="ccCorrect">This corrects the existing "Informed" record of the ticked result(s) (the old record stays in the history)</label>
                            </div>
                        </div>
                    </div>
                </div>

                <details class="mt-2 d-none" id="ccHistoryBox">
                    <summary class="fs-8 fw-semibold text-secondary">Earlier records</summary>
                    <div class="cc-history mt-1" id="ccHistory"></div>
                </details>
                <div class="alert alert-danger py-2 px-3 fs-8 mt-2 mb-0 d-none" id="ccError"></div>
            </div>
            <div class="modal-footer py-2 px-3">
                <button type="button" class="btn btn-sm btn-light" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-sm btn-outline-secondary d-none" id="ccSkip">Skip, record later</button>
                <button type="button" class="btn btn-sm btn-danger px-3" id="ccSave"><i class="bi bi-check2-circle me-1"></i><span>Save</span></button>
            </div>
        </div>
    </div>
</div>
<script src="~/js/critical-communication.js" asp-append-version="true"></script>
