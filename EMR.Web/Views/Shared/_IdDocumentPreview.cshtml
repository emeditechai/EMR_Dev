@*
    The uploaded ID document of a patient (PatientMaster.IdentificationFilePath): a Preview button under "Upload ID Document"
    that opens the image / PDF in a viewer. Used by B2C / B2B LAB booking and OPD Patient Registration.
      <div id="idDocExisting" class="id-doc-existing" data-path="@Model.IdentificationFilePath"></div>   (the slot; filled on load)
      IdDocPreview.set('idDocExisting', path)    (after an existing patient is loaded; '' hides it)
*@
<link rel="stylesheet" href="~/css/views/Shared/_IdDocumentPreview.css" asp-append-version="true" />

<div class="modal fade" id="idDocPreviewModal" tabindex="-1" aria-labelledby="idDocPreviewLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header py-2">
                <h6 class="modal-title fw-semibold" id="idDocPreviewLabel"><i class="bi bi-shield-check me-2"></i>Uploaded ID Document</h6>
                <a id="idDocPreviewOpen" href="#" target="_blank" rel="noopener" class="btn btn-sm btn-outline-secondary ms-auto me-2">
                    <i class="bi bi-box-arrow-up-right me-1"></i>Open in new tab
                </a>
                <button type="button" class="btn-close ms-0" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-0 text-center bg-dark" style="min-height:70vh">
                <img id="idDocPreviewImg" src="" alt="Uploaded ID document" class="img-fluid" style="display:none;max-height:80vh;object-fit:contain" />
                <iframe id="idDocPreviewFrame" src="" title="Uploaded ID document" style="display:none;width:100%;height:80vh;border:0"></iframe>
                <div id="idDocPreviewFallback" style="display:none" class="p-5 text-light">
                    <i class="bi bi-file-earmark-x display-4 d-block mb-3"></i>
                    <p>Preview is not available for this file type.</p>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="~/js/views/Shared/_IdDocumentPreview.js" asp-append-version="true"></script>
