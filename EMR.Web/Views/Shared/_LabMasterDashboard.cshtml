@model EMR.Web.Models.ViewModels.LabMasterDashboardViewModel

<div class="row g-3 mb-4">
    <!-- Test Categories -->
    <div class="col-xl-2 col-md-4 col-sm-6">
        <div class="card border-0 shadow-sm h-100 @(Model.ActiveModule == "LabTestCategories" ? "border-start border-4 border-primary bg-primary-subtle" : "")">
            <div class="card-body p-3 d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small fw-semibold text-uppercase d-block">Categories</span>
                    <h3 class="fw-bold mb-0 text-primary">@Model.TotalCategories</h3>
                    <span class="badge bg-success-subtle text-success mt-1">@Model.ActiveCategories Active</span>
                </div>
                <div class="bg-primary text-white rounded-3 p-3 shadow-sm d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                    <i class="bi bi-tags fs-4"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Test Sub Categories -->
    <div class="col-xl-2 col-md-4 col-sm-6">
        <div class="card border-0 shadow-sm h-100 @(Model.ActiveModule == "LabTestSubCategories" ? "border-start border-4 border-info bg-info-subtle" : "")">
            <div class="card-body p-3 d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small fw-semibold text-uppercase d-block">Sub Categories</span>
                    <h3 class="fw-bold mb-0 text-info">@Model.TotalSubCategories</h3>
                    <span class="badge bg-success-subtle text-success mt-1">@Model.ActiveSubCategories Active</span>
                </div>
                <div class="bg-info text-white rounded-3 p-3 shadow-sm d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                    <i class="bi bi-tag-fill fs-4"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Sample Types -->
    <div class="col-xl-2 col-md-4 col-sm-6">
        <div class="card border-0 shadow-sm h-100 @(Model.ActiveModule == "LabSampleTypes" ? "border-start border-4 border-danger bg-danger-subtle" : "")">
            <div class="card-body p-3 d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small fw-semibold text-uppercase d-block">Sample Types</span>
                    <h3 class="fw-bold mb-0 text-danger">@Model.TotalSampleTypes</h3>
                    <span class="badge bg-success-subtle text-success mt-1">@Model.ActiveSampleTypes Active</span>
                </div>
                <div class="bg-danger text-white rounded-3 p-3 shadow-sm d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                    <i class="bi bi-droplet-half fs-4"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Test Methods -->
    <div class="col-xl-3 col-md-6 col-sm-6">
        <div class="card border-0 shadow-sm h-100 @(Model.ActiveModule == "LabTestMethods" ? "border-start border-4 border-warning bg-warning-subtle" : "")">
            <div class="card-body p-3 d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small fw-semibold text-uppercase d-block">Test Methods</span>
                    <h3 class="fw-bold mb-0 text-warning">@Model.TotalTestMethods</h3>
                    <span class="badge bg-success-subtle text-success mt-1">@Model.ActiveTestMethods Active</span>
                </div>
                <div class="bg-warning text-dark rounded-3 p-3 shadow-sm d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                    <i class="bi bi-gear-wide-connected fs-4"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Lab Units -->
    <div class="col-xl-2 col-md-4 col-sm-6">
        <div class="card border-0 shadow-sm h-100 @(Model.ActiveModule == "LabUnits" ? "border-start border-4 border-success bg-success-subtle" : "")">
            <div class="card-body p-3 d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small fw-semibold text-uppercase d-block">Lab Units</span>
                    <h3 class="fw-bold mb-0 text-success">@Model.TotalUnits</h3>
                    <span class="badge bg-success-subtle text-success mt-1">@Model.ActiveUnits Active</span>
                </div>
                <div class="bg-success text-white rounded-3 p-3 shadow-sm d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                    <i class="bi bi-rulers fs-4"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Sample Rejections -->
    <div class="col-xl-2 col-md-4 col-sm-6">
        <div class="card border-0 shadow-sm h-100 @(Model.ActiveModule == "LabSampleRejections" ? "border-start border-4 border-dark bg-secondary-subtle" : "")">
            <div class="card-body p-3 d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small fw-semibold text-uppercase d-block">Sample Rejections</span>
                    <h3 class="fw-bold mb-0 text-dark">@Model.TotalSampleRejections</h3>
                    <span class="badge bg-success-subtle text-success mt-1">@Model.ActiveSampleRejections Active</span>
                </div>
                <div class="bg-dark text-white rounded-3 p-3 shadow-sm d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                    <i class="bi bi-x-circle fs-4"></i>
                </div>
            </div>
        </div>
    </div>
</div>
