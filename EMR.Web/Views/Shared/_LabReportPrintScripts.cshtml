@* Script for _LabReportPrintModal. Render inside @section Scripts, after jQuery/Bootstrap/SweetAlert. *@
<script>
        // Report PDF preview / print (QuestPDF report streamed by LabReporting/PrintReportPdf)
        (function () {
            let labOrderId = 0;
            // Lab Report Entry by default; Microbiology Report Entry prints its own (Template) report
            const pdfUrl = '@Url.Action("PrintReportPdf", ViewData["ReportPrintController"] as string ?? "LabReporting")';
            const logUrl = '@Url.Action("LogReportPrintedJson", ViewData["ReportPrintController"] as string ?? "LabReporting")';
            // A screen that prints one report (Lab / Microbiology Report Entry) fixes it. Elsewhere the server prints the
            // report the bill has ("auto": the Lab Report first) and names the others, so the modal can switch between them.
            const AUTO_TYPE = @(ViewData["ReportPrintController"] == null ? "true" : "false");
            let reportType = AUTO_TYPE ? 'auto' : '';
            const REPORT_TITLES = { Numeric: 'Lab Report', Template: 'Microbiology Report' };
            let blobUrl = null;
            let fileName = 'LabReport.pdf';
            let printScope = 'all';   // all | approved | pending

            const $frame = $('#reportPrintFrame'), $loading = $('#printLoading'), $error = $('#printError');
            const $actions = $('#btnReportPrintNow, #btnReportDownload, #btnReportNewTab');

            function reset() {
                if (blobUrl) { URL.revokeObjectURL(blobUrl); blobUrl = null; }
                $frame.addClass('d-none').attr('src', 'about:blank');
                $error.addClass('d-none').text('');
                $('#printStatusChip').addClass('d-none');
                $('#printSubtitle').text('Preparing report\u2026');
                $actions.prop('disabled', true);
                $loading.removeClass('d-none');
            }

            function fail(message) {
                $loading.addClass('d-none');
                $error.text(message).removeClass('d-none');
                $('#printSubtitle').text('Report unavailable');
            }

            async function load() {
                reset();
                try {
                    const res = await fetch(pdfUrl + '?labOrderId=' + labOrderId + '&scope=' + printScope
                        + (reportType ? '&reportingType=' + reportType : '') + '&_=' + Date.now(), { credentials: 'same-origin', cache: 'no-store' });
                    const type = res.headers.get('content-type') || '';

                    if (!res.ok) {
                        let msg = 'Unable to generate the report.';
                        try { msg = (await res.json()).message || msg; } catch (e) { /* keep default */ }
                        return fail(msg);
                    }
                    if (res.redirected || type.indexOf('pdf') === -1) {
                        return fail('Your session may have expired. Please refresh the page and sign in again.');
                    }

                    // which report this is, and (auto) which others the bill has
                    const servedType = res.headers.get('X-Report-Type');
                    if (AUTO_TYPE && servedType) {
                        const available = (res.headers.get('X-Report-Available') || '').split(',').filter(Boolean);
                        if (available.length) $('#printReportSwitch').data('available', available);
                        const offered = $('#printReportSwitch').data('available') || [];
                        $('#printReportSwitch').toggleClass('d-none', offered.length < 2)
                            .find('[data-report-type]').each(function () {
                                const t = $(this).attr('data-report-type');
                                $(this).toggleClass('d-none', offered.indexOf(t) === -1)
                                       .toggleClass('active', t === servedType);
                            });
                        reportType = servedType;
                    }
                    $('#printReportTitle').text(REPORT_TITLES[servedType] || 'Lab Report');

                    const watermark = res.headers.get('X-Report-Watermark') === '1';
                    const status = res.headers.get('X-Report-Status');
                    const tests = res.headers.get('X-Report-Tests');
                    const disp = res.headers.get('Content-Disposition') || '';
                    const m = /filename="?([^";]+)"?/i.exec(disp);
                    if (m) fileName = m[1];

                    blobUrl = URL.createObjectURL(await res.blob());
                    $frame.attr('src', blobUrl + '#toolbar=1&navpanes=0').removeClass('d-none');
                    $loading.addClass('d-none');
                    $actions.prop('disabled', false);

                    $('#printStatusChip')
                        .attr('class', 'badge fs-9 ' + (watermark
                            ? 'bg-warning-subtle text-warning-emphasis border border-warning-subtle'
                            : (status === 'final' ? 'bg-success-subtle text-success border border-success-subtle'
                                                  : 'bg-primary-subtle text-primary border border-primary-subtle')))
                        .text(watermark ? 'NOT APPROVED copy' : (status === 'final' ? 'Final Report' : (printScope === 'approved' ? 'Approved tests' : 'Provisional Report')));
                    const what = printScope === 'approved' ? 'approved' : (printScope === 'pending' ? 'validated (not approved)' : 'validated/approved');
                    $('#printSubtitle').text(tests + ' ' + what + ' test(s) on this report'
                        + (watermark ? ' \u2022 watermarked until every printed test is approved' : ''));
                } catch (e) {
                    fail('Server error while generating the report. Please try again.');
                }
            }

            function logPrinted() {
                $.post(logUrl + '?labOrderId=' + labOrderId + '&scope=' + printScope + (reportType && reportType !== 'auto' ? '&reportingType=' + reportType : ''));
            }

            $(function () {
                const modalEl = document.getElementById('modalReportPrint');
                if (!modalEl) return;

                // Any button with .btn-print-report opens the preview for its own bill / scope.
                $(document).on('click', '.btn-print-report', function () {
                    printScope = $(this).attr('data-scope') || 'all';
                    labOrderId = parseInt($(this).attr('data-laborderid')) || labOrderId;
                    if (AUTO_TYPE) {
                        reportType = 'auto';
                        $('#printReportSwitch').addClass('d-none').removeData('available');
                    }
                    const bill = $(this).attr('data-bill');
                    if (bill) $('#printBillChip').text(bill);
                    bootstrap.Modal.getOrCreateInstance(modalEl).show();
                });
                $(modalEl).on('shown.bs.modal', load);
                $(modalEl).on('hidden.bs.modal', reset);

                $('#btnReportPrintNow').on('click', function () {
                    if (!blobUrl) return;
                    try {
                        const w = $frame[0].contentWindow;
                        w.focus();
                        w.print();
                    } catch (e) {
                        window.open(blobUrl, '_blank'); // viewer refused: open it so the browser's own Print works
                    }
                    logPrinted();
                });
                $('#btnReportDownload').on('click', function () {
                    if (!blobUrl) return;
                    const a = document.createElement('a');
                    a.href = blobUrl; a.download = fileName;
                    document.body.appendChild(a); a.click(); a.remove();
                    logPrinted();
                });
                $('#btnReportNewTab').on('click', function () { if (blobUrl) window.open(blobUrl, '_blank'); });
                $('#printReportSwitch').on('click', '[data-report-type]', function () {
                    const t = $(this).attr('data-report-type');
                    if (t === reportType) return;
                    reportType = t;
                    load();
                });
            });
        })();
    </script>
