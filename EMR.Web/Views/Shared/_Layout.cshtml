@inject EMR.Web.Services.IAskAiFeatures AskAi
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - eClinicPlus+</title>
    <script type="importmap"></script>
    <emr-permission-script />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/sweetalert2/dist/sweetalert2.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/help.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/EMR.Web.styles.css" asp-append-version="true" />
    @await RenderSectionAsync("HeadStyles", required: false)
</head>
<body>
    <header class="emr-topbar shadow-sm">
        <nav class="navbar navbar-expand-xl navbar-dark container-fluid px-2 px-xl-3 py-1">
            <a class="navbar-brand fw-bold emr-brand" asp-area="" asp-controller="Dashboard" asp-action="Index">
                <i class="bi bi-hospital me-2"></i><span class="brand-eclinic">eCare360</span><span class="brand-plus">Plus</span><span class="brand-plussign">+</span>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav"
                    aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="mainNav">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    @* the top menu: MenuMaster / PageMaster (Settings > Security), shown per the user's permissions *@
                    @await Component.InvokeAsync("DatabaseNav")

                    <div class="d-flex align-items-center gap-1.5 ms-auto emr-top-actions">
                        @* the bell: the signed-in user's notifications, pushed live (SQLScripts/2263, wwwroot/js/notifications.js) *@
                        <div class="dropdown emr-bell" id="emrBell">
                            <button type="button" class="btn btn-sm emr-icon-btn position-relative" id="emrBellBtn" data-bs-toggle="dropdown" data-bs-auto-close="outside"
                                    aria-expanded="false" aria-label="Notifications" title="Notifications">
                                <i class="bi bi-bell-fill"></i>
                                <span class="emr-bell-badge d-none" id="emrBellBadge" aria-live="polite"></span>
                            </button>
                            <div class="dropdown-menu dropdown-menu-end emr-bell-menu p-0 shadow" aria-labelledby="emrBellBtn">
                                <div class="emr-bell-head">
                                    <span class="fw-semibold">Notifications</span>
                                    <span class="emr-bell-live" id="emrBellLive" title="Live updates"></span>
                                    <button type="button" class="emr-bell-sound" id="emrBellSound" title="Notification sound: on" aria-label="Notification sound: on" aria-pressed="true"><i class="bi bi-volume-up-fill"></i></button>
                                    <button type="button" class="btn btn-link btn-sm ms-auto p-0 text-decoration-none" id="emrBellReadAll">Mark all as read</button>
                                </div>
                                <div class="emr-bell-tabs">
                                    <button type="button" class="active" data-filter="all">All</button>
                                    <button type="button" data-filter="unread">Unread</button>
                                </div>
                                <div class="emr-bell-list" id="emrBellList"><div class="emr-bell-empty">Loading…</div></div>
                                <div class="emr-bell-foot">
                                    <a asp-controller="Notifications" asp-action="Index" class="text-decoration-none small fw-semibold">View all notifications</a>
                                </div>
                            </div>
                        </div>
                        <span class="emr-branch-pill"><i class="bi bi-building me-1"></i>@(User.FindFirst("BranchCode")?.Value ?? User.FindFirst("BranchName")?.Value)</span>

                        <div class="dropdown">
                            <button class="btn emr-profile-btn dropdown-toggle" type="button" id="profileMenu" data-bs-toggle="dropdown" aria-expanded="false">
                                @if (User.FindFirst("ProfilePicturePath")?.Value is { Length: > 0 } profilePicturePath)
                                {
                                    <img src="@profilePicturePath" alt="Profile" class="emr-avatar-img" onerror="this.style.display='none';this.nextElementSibling.style.display='inline-flex';" />
                                    <span class="emr-avatar" style="display:none">@((User.FindFirst("DisplayName")?.Value ?? "U").Substring(0, 1).ToUpper())</span>
                                }
                                else
                                {
                                    <span class="emr-avatar">@((User.FindFirst("DisplayName")?.Value ?? "U").Substring(0, 1).ToUpper())</span>
                                }
                                <span class="text-start">
                                    <strong>@User.FindFirst("DisplayName")?.Value</strong>
                                    <small>@(User.GetActiveRole() is { Length: > 0 } r ? r : "—")</small>
                                </span>
                            </button>
                            <div class="dropdown-menu dropdown-menu-end emr-profile-card" aria-labelledby="profileMenu">
                                <div class="px-3 pt-2 pb-3 border-bottom">
                                    <h5 class="mb-0">@User.FindFirst("DisplayName")?.Value</h5>
                                    <div class="text-muted small">@User.Identity?.Name</div>
                                    <div class="d-flex gap-1 flex-wrap mt-2">
                                        <span class="badge bg-dark border text-light"><i class="bi bi-buildings me-1 text-info"></i>@(User.FindFirst("CompanyName")?.Value ?? "Primary Healthcare Network")</span>
                                        <span class="badge bg-primary"><i class="bi bi-geo-alt-fill me-1"></i>@User.FindFirst("BranchName")?.Value</span>
                                    </div>
                                    @if (User.GetActiveRole() is { Length: > 0 } activeRole) {
                                        <div class="text-uppercase fw-semibold small mt-2" style="color:var(--emr-primary)">Active Role</div>
                                        <div class="h5 mb-0">@activeRole</div>
                                    }
                                </div>

                                <div class="p-3 d-grid gap-2">
                                    @if (!int.TryParse(User.FindFirst("BranchCount")?.Value, out var branchCount) || branchCount > 1)
                                    {
                                        <a asp-controller="Account" asp-action="SwitchBranch" class="btn btn-light text-start"><i class="bi bi-building-gear me-2"></i>Switch Branch</a>
                                    }
                                    <a asp-controller="Account" asp-action="SwitchRole" class="btn btn-light text-start"><i class="bi bi-arrow-left-right me-2"></i>Switch Role</a>
                                    <a asp-controller="Account" asp-action="ChangePassword" class="btn btn-light text-start"><i class="bi bi-key-fill me-2"></i>Change Password</a>
                                    <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-light text-start w-100"><i class="bi bi-box-arrow-right me-2"></i>Logout</button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </nav>
    </header>

    @* SweetAlert2 TempData values for JS *@
    @{
        var _swalSuccess = TempData["Success"] as string;
        var _swalError   = TempData["Error"]   as string;
        var _swalWarning = TempData["Warning"] as string;
    }

    <div class="container-fluid px-3 px-lg-4 py-3 py-lg-4" style="flex:1 0 auto;">
        <main role="main">
            @await Component.InvokeAsync("LicenseBanner")
            @RenderBody()
        </main>
    </div>

    <footer class="emr-footer">
        <div class="emr-footer-inner">
            <div class="emr-footer-brand">
                <i class="bi bi-hospital-fill me-2"></i><span class="brand-eclinic">eCare360</span><span class="brand-plus">Plus</span><span class="brand-plussign">+</span>
            </div>
            <div class="emr-footer-copy">
                &copy; 2026 &mdash; Sponsored &amp; Marketed by <strong>Emeditech Plus</strong>
            </div>
            <div class="emr-footer-links">
                <a href="#" class="emr-footer-link">Privacy Policy</a>
                <span class="emr-footer-divider">|</span>
                <a href="#" class="emr-footer-link">Terms of Service</a>
                <span class="emr-footer-version">v 2.1.5</span>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js" asp-append-version="true"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js" asp-append-version="true"></script>
    <script src="~/lib/sweetalert2/dist/sweetalert2.all.min.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/emr-authz.js" asp-append-version="true"></script>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <script src="~/lib/microsoft-signalr/signalr.min.js" asp-append-version="true"></script>
        <script src="~/js/notifications.js" asp-append-version="true"></script>
        @* Hospital Settings > LAB > Enable Ask AI Features (per branch, SQLScripts/2302): the assistant panel and the Home button *@
        @if (await AskAi.IsEnabledAsync(Context))
        {
            @* the help drawer: the AI Help Assistant on top, help for this screen below (Utility > Help Center, SQLScripts/2300) *@
            <div class="offcanvas offcanvas-end hp hp-drawer" tabindex="-1" id="emrHelpDrawer" aria-labelledby="emrHelpDrawerTitle"
                 data-controller="@ViewContext.RouteData.Values["controller"]" data-action="@ViewContext.RouteData.Values["action"]">
                <div class="offcanvas-header">
                    <div>
                        <h5 class="offcanvas-title" id="emrHelpDrawerTitle"><i class="bi bi-stars me-2"></i>AI Help Assistant</h5>
                        <div class="hp-drawer-sub">Knows the order of work - ask what to do next</div>
                    </div>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas" aria-label="Close"></button>
                </div>
                <div class="offcanvas-body">
                    <div class="hp-drawer-ask"></div>
                    <div class="hp-section-title mt-3"><i class="bi bi-life-preserver"></i>Help for this page</div>
                    <div class="hp-drawer-body"><div class="hp-muted"><span class="spinner-border spinner-border-sm me-2"></span>Loading help...</div></div>
                    <div class="mt-3 pt-2 border-top"><a asp-controller="Help" asp-action="Index" class="small"><i class="bi bi-book me-1"></i>Open the Help Center</a></div>
                    <div id="emrHelpToken">@Html.AntiForgeryToken()</div>
                </div>
            </div>
            @* the floating Ask AI button: on the Home dashboard only *@
            @if (string.Equals(ViewContext.RouteData.Values["controller"]?.ToString(), "Dashboard", StringComparison.OrdinalIgnoreCase)
                 && string.Equals(ViewContext.RouteData.Values["action"]?.ToString(), "Index", StringComparison.OrdinalIgnoreCase))
            {
                <button type="button" class="emr-ask-fab" id="emrAskFab" aria-label="Ask the AI Help Assistant" title="Ask the AI Help Assistant">
                    <i class="bi bi-stars"></i><span>Ask eMedi</span>
                </button>
            }
        }
        <script src="~/js/help.js" asp-append-version="true"></script>
    }
    <script>
        // Nested submenu: hover on desktop, click on mobile
        document.querySelectorAll('.dropdown-submenu').forEach(function (el) {
            var toggle = el.querySelector('.dropdown-submenu-toggle');
            var menu   = el.querySelector('.dropdown-submenu-menu');
            if (!toggle || !menu) return;

            function positionSubmenu() {
                menu.style.top = '0px';
                // open to the left when the flyout would run past the right edge (menus near the end of the bar)
                menu.classList.remove('open-left');
                var vw = window.innerWidth || document.documentElement.clientWidth;
                if (menu.getBoundingClientRect().right > vw - 8) menu.classList.add('open-left');
                var rect = menu.getBoundingClientRect();
                var vh = window.innerHeight || document.documentElement.clientHeight;
                if (rect.bottom > vh - 15) {
                    var overflow = rect.bottom - (vh - 15);
                    menu.style.top = '-' + Math.max(0, overflow) + 'px';
                }
            }

            // Desktop: hover
            el.addEventListener('mouseenter', function () {
                document.querySelectorAll('.dropdown-submenu-menu.show').forEach(function (m) { m.classList.remove('show'); });
                menu.classList.add('show');
                positionSubmenu();
            });
            el.addEventListener('mouseleave', function () {
                menu.classList.remove('show', 'open-left');
                menu.style.top = '0px';
            });

            // Mobile / click fallback
            toggle.addEventListener('click', function (e) {
                e.preventDefault();
                e.stopPropagation();
                var wasOpen = menu.classList.contains('show');
                document.querySelectorAll('.dropdown-submenu-menu.show').forEach(function (m) { m.classList.remove('show'); });
                if (!wasOpen) {
                    menu.classList.add('show');
                    positionSubmenu();
                }
            });
        });

        // Close submenus when parent dropdown closes
        document.querySelectorAll('[data-bs-toggle="dropdown"]').forEach(function (btn) {
            btn.addEventListener('hidden.bs.dropdown', function () {
                document.querySelectorAll('.dropdown-submenu-menu.show').forEach(function (m) { m.classList.remove('show'); });
            });
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
    <script>
        // SweetAlert2 — auto-fire TempData notifications
        (function () {
            var success = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(_swalSuccess));
            var error   = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(_swalError));
            var warning = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(_swalWarning));

            var toastMixin = Swal.mixin({
                toast: true,
                position: 'top-end',
                showConfirmButton: false,
                timerProgressBar: true,
                didOpen: function (toast) {
                    toast.addEventListener('mouseenter', Swal.stopTimer);
                    toast.addEventListener('mouseleave', Swal.resumeTimer);
                }
            });

            if (success) {
                toastMixin.fire({ icon: 'success', title: success, timer: 3500 });
            }
            if (warning) {
                toastMixin.fire({ icon: 'warning', title: warning, timer: 4500 });
            }
            if (error) {
                Swal.fire({
                    icon: 'error',
                    title: 'Error',
                    text: error,
                    confirmButtonColor: '#dc3545',
                    confirmButtonText: 'OK'
                });
            }
        })();
    </script>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <script>
            (function () {
                // Idle sign-out after 60 minutes without activity in ANY tab of this login (activity is shared via localStorage).
                var idleLimitMs = 60 * 60 * 1000;
                var activityKey = '__emr_last_activity';
                var lastActivityAt = Date.now();
                var idleExceeded = false;
                var redirecting = false;
                var logoutUrl = '@Url.Action("SessionTimeoutLogout", "Account")';
                window.emrIdle = { limitMs: idleLimitMs, activityKey: activityKey };   // read by the Home dashboard countdown

                function sharedLastActivity() {
                    var shared = 0;
                    try { shared = +(localStorage.getItem(activityKey) || 0); } catch (e) {}
                    return Math.max(lastActivityAt, shared);
                }
                function markActivity(now) {
                    lastActivityAt = now;
                    try { localStorage.setItem(activityKey, String(now)); } catch (e) {}
                }

                function handleInteraction() {
                    if (redirecting) return;

                    var now = Date.now();
                    if (idleExceeded || (now - sharedLastActivity()) >= idleLimitMs) {
                        redirecting = true;
                        window.location.href = logoutUrl;
                        return;
                    }

                    markActivity(now);
                }

                markActivity(Date.now());   // opening a page is activity
                setInterval(function () {
                    idleExceeded = (Date.now() - sharedLastActivity()) >= idleLimitMs;
                }, 1000);

                ['click', 'keydown', 'mousedown', 'touchstart'].forEach(function (evt) {
                    document.addEventListener(evt, handleInteraction, true);
                });
            })();
        </script>
        <script>
            // Sign-out when the browser is closed - but one login works in every tab.
            // Each signed-in tab carries a marker in sessionStorage (per tab), keeps a shared heartbeat in localStorage
            // and answers "anyone here?" on a BroadcastChannel. A tab without the marker (a new tab, or the browser
            // reopened) joins the session when another signed-in tab is open; only when none is open is the session ended.
            (function () {
                var tabKey = '__emr_tab_session', beatKey = '__emr_tab_heartbeat', beatEvery = 10000, beatFresh = 90000;
                var logoutUrl = '@Url.Action("SessionTimeoutLogout", "Account")';
                var channel = null;
                try { channel = 'BroadcastChannel' in window ? new BroadcastChannel('emr-tab-session') : null; } catch (e) { channel = null; }

                function beat() { try { localStorage.setItem(beatKey, String(Date.now())); } catch (e) {} }
                function joined() {
                    try { sessionStorage.setItem(tabKey, '1'); } catch (e) {}
                    beat();
                    setInterval(beat, beatEvery);
                    document.addEventListener('visibilitychange', function () { if (!document.hidden) beat(); });
                    if (channel) channel.onmessage = function (e) { if (e.data === 'who') { channel.postMessage('here'); beat(); } };
                }

                try {
                    if (sessionStorage.getItem(tabKey)) { joined(); return; }                     // this tab is already signed in
                    if (document.cookie.indexOf('__emr_fresh_login=') !== -1) {                   // the tab that just logged in
                        document.cookie = '__emr_fresh_login=; path=/; expires=Thu, 01 Jan 1970 00:00:00 GMT';
                        joined(); return;
                    }
                    var last = +(localStorage.getItem(beatKey) || 0);
                    if (last && Date.now() - last < beatFresh) { joined(); return; }              // another tab was active just now
                    if (!channel) { window.location.href = logoutUrl; return; }

                    // ask the open tabs; no answer = no signed-in tab is open (the browser was closed)
                    var answered = false;
                    channel.onmessage = function (e) { if (e.data === 'here' && !answered) { answered = true; joined(); } };
                    channel.postMessage('who');
                    setTimeout(function () { if (!answered) window.location.href = logoutUrl; }, 1200);
                } catch (e) { }
            })();
        </script>
        <script>
            // Shortcut keys for the Doctor IP screens, which are not in the menu:
            //   Alt + Shift + D  Doctor IP (commission configuration)
            //   Alt + Shift + C  Doctor IP Commission, to run the calculation manually (Hospital Settings mode Manual / Both)
            document.addEventListener('keydown', function (e) {
                if (!e.altKey || !e.shiftKey || e.ctrlKey || e.metaKey) return;
                var url = e.code === 'KeyD' ? '@Url.Action("Index", "DoctorIp")'
                        : e.code === 'KeyC' ? '@Url.Action("Index", "DoctorIpCommission")?manual=true' : null;
                if (!url) return;
                e.preventDefault();
                window.location.href = url;
            });
        </script>
    }
</body>
</html>
