@*
    _PaymentModal.cshtml  –  Reusable payment collection modal.
    Include in any view via:  <partial name="_PaymentModal" />

    Required ViewData (set BEFORE the <partial> tag in the calling view):
      "PaymentModuleCode"     → string  e.g. "OPD"
      "PaymentModuleRefId"    → int     the bill/service primary key
      "PaymentSuccessModalId" → string  id of the success modal to open after save/skip

    Bootstrap 5 JS is loaded by _Layout – no extra script needed.
    Script is inline (NOT in @section Scripts which is invalid in partials).
*@
@{
    string pmCode    = ViewData["PaymentModuleCode"]     as string ?? "OPD";
    int    pmRefId   = (int)(ViewData["PaymentModuleRefId"] ?? 0);
    string pmSuccess = ViewData["PaymentSuccessModalId"] as string ?? "bookingSuccessModal";
}

<style>
.btn-close-red {
    background-color: #fee2e2 !important;
    border-radius: 50% !important;
    opacity: 0.9 !important;
    padding: 0.5rem !important;
    filter: invert(27%) sepia(85%) saturate(7024%) hue-rotate(352deg) brightness(97%) contrast(92%) !important;
    transition: all 0.2s ease-in-out;
}
.btn-close-red:hover {
    background-color: #fecaca !important;
    opacity: 1 !important;
    transform: scale(1.1);
}
</style>

<div class="modal fade" id="paymentModal" tabindex="-1"
     data-bs-backdrop="static" data-bs-keyboard="false" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg" style="max-width:680px">
        <div class="modal-content border-0 shadow-lg overflow-hidden">

            <div style="height:5px;background:linear-gradient(90deg,#0d6efd 0%,#6f42c1 100%)"></div>

            <div class="modal-header border-0 pb-0 px-4 pt-3">
                <div>
                    <h5 class="modal-title fw-bold mb-0">
                        <i class="bi bi-cash-coin me-2 text-primary"></i>Collect Payment
                    </h5>
                    <div id="pmPatientLine" class="text-muted small mt-1"></div>
                </div>
                <button type="button" id="btnPaymentSkip" class="btn-close btn-close-red ms-auto" aria-label="Close" title="Cancel & Close"></button>
            </div>

            <div class="modal-body px-4 py-3">

                <!-- Loading spinner -->
                <div id="pmLoader" class="text-center py-5">
                    <div class="spinner-border text-primary" role="status"></div>
                    <p class="mt-2 text-muted small">Loading bill details…</p>
                </div>
                <div id="pmError" class="alert alert-danger d-none py-2 mb-2"></div>

                <!-- Main form (hidden until AJAX data loaded) -->
                <div id="pmForm" class="d-none">

                    <!-- Bill info boxes (Bill No, Token, Total) -->
                    <div class="d-flex flex-wrap gap-2 mb-3" id="pmInfoBoxes"></div>

                    <!-- Line items table -->
                    <div class="table-responsive mb-3">
                        <table class="table table-sm table-bordered mb-0" style="font-size:.84rem">
                            <thead class="table-light">
                                <tr>
                                    <th style="width:40px">#</th>
                                    <th>Item</th>
                                    <th style="width:110px">Type</th>
                                    <th style="width:80px" class="text-end d-none d-sm-table-cell">CGST</th>
                                    <th style="width:80px" class="text-end d-none d-sm-table-cell">SGST</th>
                                    <th style="width:110px" class="text-end">Amount (₹)</th>
                                </tr>
                            </thead>
                            <tbody id="pmLineItemsTbody"></tbody>
                            <tfoot>
                                <tr class="fw-semibold table-light">
                                    <td colspan="3" class="text-end">Sub Total</td>
                                    <td class="text-end" id="pmSubTotal">0.00</td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>

                    <!-- Header-level discount -->
                    <div class="card border rounded-3 mb-3 p-3" style="background:#fafafa">
                        <div class="row g-2 align-items-center">
                            <div class="col-12 col-sm-auto">
                                <label class="form-label fw-semibold mb-0 small text-uppercase text-muted">Discount</label>
                            </div>
                            <div class="col-12 col-sm-auto">
                                <div class="btn-group btn-group-sm" role="group" id="pmDiscTypeGroup">
                                    <input type="radio" class="btn-check" name="pmDiscType" id="pmDiscTypeP" value="P" autocomplete="off">
                                    <label class="btn btn-outline-secondary" for="pmDiscTypeP">%</label>
                                    <input type="radio" class="btn-check" name="pmDiscType" id="pmDiscTypeF" value="F" autocomplete="off">
                                    <label class="btn btn-outline-secondary" for="pmDiscTypeF">₹ Fixed</label>
                                </div>
                            </div>
                            <div class="col-6 col-sm-3">
                                <div class="input-group input-group-sm">
                                    <input type="number" id="pmDiscValue" class="form-control"
                                           min="0" step="0.01" placeholder="0" />
                                    <span class="input-group-text" id="pmDiscSymbol">%</span>
                                </div>
                            </div>
                            <div class="col-6 col-sm-auto text-end text-sm-start">
                                <span class="text-muted small">Discount amt: </span>
                                <span class="fw-semibold text-danger" id="pmDiscAmt">₹0.00</span>
                            </div>
                        </div>
                        <div class="mt-2 pt-1 d-flex justify-content-between align-items-center" id="pmDiscEligibilityRow" style="font-size:0.75rem;display:none;">
                            <span class="text-muted">Eligible for Discount: <strong class="text-dark" id="pmDiscEligibleAmt">₹0.00</strong> <span class="text-secondary" id="pmDiscNonEligibleAmt">(Non-discountable: ₹0.00)</span></span>
                            <span id="pmDiscWarning" class="text-danger small fw-semibold" style="display:none;"></span>
                        </div>
                        <div class="mt-2 pt-2 d-flex justify-content-between align-items-center">
                            <span class="text-muted small">Total Tax (GST)</span>
                            <span class="fw-semibold text-danger" id="pmTotalTax">₹0.00</span>
                        </div>
                        <div class="mt-1 d-flex justify-content-between align-items-center" id="pmRoundOffRow" style="display:none;">
                            <span class="text-muted small">Round Off</span>
                            <span class="fw-semibold text-secondary" id="pmRoundOffAmt">₹0.00</span>
                        </div>
                        <div class="mt-2 border-top pt-2 d-flex justify-content-between align-items-center">
                            <span class="fw-bold">Net Payable</span>
                            <span class="fw-bold fs-5 text-primary" id="pmNetAmount">₹0.00</span>
                        </div>
                    </div>

                    <!-- Partial payment notice (shown when a previous payment exists) -->
                    <div id="pmExistingPaySection" class="d-none alert alert-info py-2 mb-3">
                        <span class="small">
                            <i class="bi bi-info-circle me-1"></i>
                            Already paid: <strong id="pmAlreadyPaid"></strong> |
                            Balance due: <strong id="pmBalanceDue"></strong>
                        </span>
                    </div>

                    <!-- Payment method controls (hidden if net is 0) -->
                    <div id="pmPaymentMethodsSection">
                        <!-- Payment method rows injected by JS -->
                        <div id="pmMethodRows"></div>

                        <div class="d-flex gap-2 mt-1">
                            <button type="button" class="btn btn-sm btn-outline-primary" id="btnAddPayMethod">
                                <i class="bi bi-plus-circle me-1"></i>Add Payment Method
                            </button>
                        </div>

                        <!-- Running total of amounts entered -->
                        <div class="mt-3 border-top pt-2 d-flex justify-content-between align-items-center">
                            <span class="text-muted small">Total entering now:</span>
                            <span class="fw-bold text-success fs-6" id="pmEnteringTotal">₹0.00</span>
                        </div>
                    </div>

                </div>
            </div>

            <div class="modal-footer border-0 px-4 pb-4 pt-0" id="pmFooter" style="display:none!important">
                <button type="button" class="btn btn-outline-secondary" id="btnPaymentSkip2">
                    <i class="bi bi-skip-forward me-1"></i>Skip Payment
                </button>
                <button type="button" class="btn btn-primary px-4 fw-semibold" id="btnSavePayment">
                    <i class="bi bi-check2-circle me-2"></i>Save Payment
                </button>
            </div>

        </div>
    </div>
</div>

<script>
@* Inline script – @section Scripts is NOT valid in partial views. *@
document.addEventListener('DOMContentLoaded', function () {
(function () {
    'use strict';

    /* ── server-side values ── */
    var _moduleCode    = '@Html.Raw(pmCode)';
    var _moduleRefId   = @pmRefId;
    var _successModal  = '@Html.Raw(pmSuccess)';

    /* ── state ── */
    var _summary = null, _methods = [], _rowIdx = 0, _onSuccess = null, _onCancel = null, _onSkip = null, _onSave = null, _isPreSave = false;
    var _isSubmitting = false;
    var _roundOffAmount = 0, _roundedNetAmount = 0;

    var pmModal   = new bootstrap.Modal(document.getElementById('paymentModal'), {backdrop:'static'});
    var pmLoader  = document.getElementById('pmLoader');
    var pmError   = document.getElementById('pmError');
    var pmForm    = document.getElementById('pmForm');
    var pmFooter  = document.getElementById('pmFooter');

    // ─── Auto-open when triggered ─────────────────────────────────────────────
    if (_moduleRefId > 0) {
        pmModal.show();
        fetchData();
    }

    // Top Red cross icon → Cancel without saving anything
    document.getElementById('btnPaymentSkip')?.addEventListener('click', cancelPayment);
    // Skip Payment button in footer
    document.getElementById('btnPaymentSkip2')?.addEventListener('click', skipPayment);
    // Save Payment button in footer
    document.getElementById('btnSavePayment')?.addEventListener('click', savePayment);
    document.getElementById('btnAddPayMethod')?.addEventListener('click', addMethodRow);

    function cancelPayment() {
        pmModal.hide();
        if (typeof _onCancel === 'function') {
            _onCancel();
        }
    }

    async function skipPayment() {
        if (typeof Swal !== 'undefined') {
            const result = await Swal.fire({
                title: 'Skip Payment Confirmation',
                html: `
                    <div class="text-start">
                        <p class="mb-2 text-dark">Are you sure you want to <strong>Skip Payment</strong>?</p>
                        <div class="alert alert-warning py-2 px-3 mb-0 small border-warning-subtle text-dark">
                            <i class="bi bi-exclamation-triangle-fill me-1 text-warning"></i>
                            This will create the bill with <strong>Full Due Amount</strong> (Payment Status: <strong>Unpaid</strong>).
                        </div>
                    </div>
                `,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#0d6efd',
                cancelButtonColor: '#6c757d',
                confirmButtonText: '<i class="bi bi-check2-circle me-1"></i> Yes, Skip & Save Due',
                cancelButtonText: '<i class="bi bi-x-lg me-1"></i> No, Return',
                reverseButtons: true,
                focusCancel: true
            });

            if (!result.isConfirmed) {
                return;
            }
        } else {
            if (!confirm('Are you sure you want to skip payment? This will save the bill with full due amount (Unpaid).')) {
                return;
            }
        }

        await executeSkipPayment();
    }

    async function executeSkipPayment() {
        if (_isPreSave) {
            const discType  = document.querySelector('input[name="pmDiscType"]:checked')?.value ?? null;
            const discVal   = parseFloat(document.getElementById('pmDiscValue').value) || 0;
            const discAmt   = parseFloat(document.getElementById('pmDiscAmt').textContent.replace('₹','')) || 0;
            const net       = getNetAmount();
            const lineItems = (_summary.items || []).map(li => ({
                moduleLineRefId: li.lineRefId,
                itemDescription: li.itemName,
                serviceType: li.serviceType,
                originalAmount: li.originalAmount,
                lineDiscountType: discType,
                lineDiscountValue: 0,
                lineDiscountAmount: li.lineDiscountAmount || 0,
                netLineAmount: li.netLineAmount || li.originalAmount,
                isDiscountAllowed: li.isDiscountAllowed !== false,
                isGstRequired: li.isGstRequired || false,
                gstPercentage: li.gstPercentage || 0,
                cgstAmount: li.cgstAmount || 0,
                sgstAmount: li.sgstAmount || 0,
                igstAmount: li.igstAmount || 0
            }));

            const payload = {
                headerDiscountType:   discType,
                headerDiscountValue:  discVal,
                headerDiscountAmount: discAmt,
                netAmount:            net,
                payments:             [],
                lineItems:            lineItems,
                isSkipped:            true
            };

            const btn = document.getElementById('btnPaymentSkip2');
            if (btn) {
                btn.disabled = true;
                btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Saving…';
            }

            try {
                if (typeof _onSkip === 'function') {
                    await _onSkip(payload);
                }
            } catch (err) {
                showError(err.message || 'Failed to save booking.');
            } finally {
                if (btn) {
                    btn.disabled = false;
                    btn.innerHTML = '<i class="bi bi-skip-forward me-1"></i>Skip Payment';
                }
            }
            return;
        }

        pmModal.hide();
        var sm = document.getElementById(_successModal);
        if (sm) new bootstrap.Modal(sm).show();
    }

    // ─── Fetch payment methods + summary in parallel ───────────────────────────
    async function fetchData() {
        try {
            const [methodsRes, summaryRes] = await Promise.all([
                fetch('/OPD/GetPaymentMethods'),
                fetch(`/OPD/GetPaymentSummary?moduleCode=${_moduleCode}&moduleRefId=${_moduleRefId}`)
            ]);
            _methods = await methodsRes.json();
            const summaryJson = await summaryRes.json();
            if (!summaryJson.success) throw new Error(summaryJson.error || 'Failed to load bill.');
            _summary = summaryJson.data;
            renderForm();
        } catch (e) {
            pmLoader.classList.add('d-none');
            pmError.textContent = e.message;
            pmError.classList.remove('d-none');
        }
    }

    // ─── Render form ──────────────────────────────────────────────────────────
    function renderForm() {
        pmLoader.classList.add('d-none');

        // Patient line
        document.getElementById('pmPatientLine').textContent =
            `${_summary.patientName ?? ''} · ${_summary.patientCode ?? ''} · ${_summary.patientPhone ?? ''}`;

        // Info boxes
        const boxes = document.getElementById('pmInfoBoxes');
        boxes.innerHTML = infoBox('Bill No', _summary.opdBillNo, '#f0fff4', 'text-success') +
                          infoBox('Token',   _summary.tokenNo,   '#fffbeb', 'text-warning-emphasis');

        // Line items
        const tbody = document.getElementById('pmLineItemsTbody');
        // Line items are rendered dynamically in recalcDiscount
        document.getElementById('pmSubTotal').textContent = '₹' + fmt(_summary.subTotal);

        // Existing payment info
        if (_summary.hasExistingPayment) {
            document.getElementById('pmAlreadyPaid').textContent = '₹' + fmt(_summary.totalPaid);
            document.getElementById('pmBalanceDue').textContent  = '₹' + fmt(_summary.balanceDue);
            document.getElementById('pmExistingPaySection').classList.remove('d-none');
        }

        // Discount inputs
        document.querySelectorAll('input[name="pmDiscType"]').forEach(r =>
            r.addEventListener('change', recalcDiscount));
        document.getElementById('pmDiscValue').addEventListener('input', recalcDiscount);

        // Trigger calculation to include GST initially
        recalcDiscount();

        // Clear and add exactly one payment method row by default
        document.getElementById('pmMethodRows').innerHTML = '';
        _rowIdx = 0;
        addMethodRow();

        pmForm.classList.remove('d-none');
        pmFooter.style.removeProperty('display');
    }

    function infoBox(label, val, bg, cls) {
        return `<div class="border rounded px-3 py-2 text-center" style="min-width:108px;background:${bg}">
            <div class="text-muted fw-bold" style="font-size:.62rem;letter-spacing:.07em;text-transform:uppercase">${label}</div>
            <div class="fw-bold font-monospace ${cls}" style="font-size:.95rem">${esc(val??'—')}</div>
        </div>`;
    }

    // ─── Discount recalc ──────────────────────────────────────────────────────
    function recalcDiscount() {
        const type  = document.querySelector('input[name="pmDiscType"]:checked')?.value;
        const discSym = document.getElementById('pmDiscSymbol');
        if (discSym) discSym.textContent = type === 'F' ? '₹' : '%';

        const raw   = parseFloat(document.getElementById('pmDiscValue').value) || 0;
        const base  = _summary.hasExistingPayment ? _summary.balanceDue : _summary.subTotal;

        // Calculate discountable vs non-discountable base
        let discountableBase = 0;
        let nonDiscountableBase = 0;
        let hasRestrictions = false;

        if (_summary.items && _summary.items.length > 0) {
            _summary.items.forEach(it => {
                let amt = parseFloat(it.originalAmount) || 0;
                let isAllowed = it.isDiscountAllowed !== false;
                if (!isAllowed) hasRestrictions = true;
                if (isAllowed) discountableBase += amt;
                else nonDiscountableBase += amt;
            });
        } else {
            discountableBase = base;
        }

        let effectiveBase = hasRestrictions ? discountableBase : base;

        // Update eligibility row
        const rowEligible = document.getElementById('pmDiscEligibilityRow');
        const elEligible = document.getElementById('pmDiscEligibleAmt');
        const elNonEligible = document.getElementById('pmDiscNonEligibleAmt');
        const elWarning = document.getElementById('pmDiscWarning');

        if (rowEligible) {
            if (hasRestrictions) {
                rowEligible.style.display = 'flex';
                if (elEligible) elEligible.textContent = '₹' + fmt(discountableBase);
                if (elNonEligible) elNonEligible.textContent = `(Non-discountable: ₹${fmt(nonDiscountableBase)})`;
            } else {
                rowEligible.style.display = 'none';
            }
        }

        let discAmt = 0;
        if (effectiveBase <= 0) {
            discAmt = 0;
            if (raw > 0 && elWarning) {
                elWarning.textContent = 'No discount allowed on selected items.';
                elWarning.style.display = '';
            } else if (elWarning) {
                elWarning.style.display = 'none';
            }
        } else {
            if (type === 'P') {
                discAmt = Math.min(effectiveBase, effectiveBase * raw / 100);
                if (elWarning) elWarning.style.display = 'none';
            } else if (type === 'F') {
                if (raw > effectiveBase && elWarning) {
                    elWarning.textContent = `Max discountable is ₹${fmt(effectiveBase)}.`;
                    elWarning.style.display = '';
                } else if (elWarning) {
                    elWarning.style.display = 'none';
                }
                discAmt = Math.min(effectiveBase, raw);
            }
        }
        discAmt = parseFloat(discAmt.toFixed(2));
        document.getElementById('pmDiscAmt').textContent = '₹' + fmt(discAmt);
        
        let totalCgst = 0;
        let totalSgst = 0;

        const tbody = document.getElementById('pmLineItemsTbody');
        tbody.innerHTML = '';

        if (!_summary.hasExistingPayment && _summary.items) {
            // Allocate discount among eligible items
            let eligibleItems = _summary.items.filter(it => it.isDiscountAllowed !== false);
            let runningAlloc = 0;
            eligibleItems.forEach((item, idx) => {
                if (idx === eligibleItems.length - 1) {
                    item.lineDiscountAmount = parseFloat(Math.max(0, discAmt - runningAlloc).toFixed(2));
                } else {
                    let prop = effectiveBase > 0 ? (item.originalAmount / effectiveBase) : 0;
                    item.lineDiscountAmount = parseFloat((discAmt * prop).toFixed(2));
                    runningAlloc += item.lineDiscountAmount;
                }
                item.netLineAmount = Math.max(0, item.originalAmount - item.lineDiscountAmount);
            });

            _summary.items.filter(it => it.isDiscountAllowed === false).forEach(item => {
                item.lineDiscountAmount = 0;
                item.netLineAmount = item.originalAmount;
            });

            _summary.items.forEach((item, i) => {
                item.cgstAmount = 0;
                item.sgstAmount = 0;
                item.igstAmount = 0;

                if (item.isGstRequired && item.gstPercentage) {
                    let tax = item.netLineAmount * (item.gstPercentage / 100.0);
                    item.cgstAmount = parseFloat((tax / 2).toFixed(2));
                    item.sgstAmount = parseFloat((tax / 2).toFixed(2));
                    totalCgst += item.cgstAmount;
                    totalSgst += item.sgstAmount;
                }

                let isEligible = item.isDiscountAllowed !== false;
                let discBadge = isEligible
                    ? `<span class="badge bg-success-subtle text-success border border-success-subtle ms-1" style="font-size:0.67rem;padding:0.18rem 0.4rem;font-weight:600;"><i class="bi bi-tag-fill me-1"></i>Discountable</span>`
                    : `<span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle ms-1" style="font-size:0.67rem;padding:0.18rem 0.4rem;font-weight:600;"><i class="bi bi-slash-circle me-1"></i>Non-discountable</span>`;

                let discDetailsHtml = '';
                if (item.lineDiscountAmount > 0) {
                    discDetailsHtml = `<div class="text-success small fw-semibold" style="font-size:0.73rem;margin-top:2px;"><i class="bi bi-arrow-down-short"></i>Disc: -₹${fmt(item.lineDiscountAmount)} (Net: ₹${fmt(item.netLineAmount)})</div>`;
                }

                const tr = document.createElement('tr');
                tr.innerHTML = `<td>${i+1}</td>
                                <td>
                                    <div class="d-flex align-items-center flex-wrap gap-1">
                                        <span class="fw-semibold text-dark">${esc(item.itemName)}</span>
                                        ${discBadge}
                                    </div>
                                    ${discDetailsHtml}
                                </td>
                                <td class="text-muted">${esc(item.serviceType??'')}</td>
                                <td class="text-end text-muted d-none d-sm-table-cell" style="font-size:0.8rem">${item.cgstAmount > 0 ? '₹'+fmt(item.cgstAmount) : '—'}</td>
                                <td class="text-end text-muted d-none d-sm-table-cell" style="font-size:0.8rem">${item.sgstAmount > 0 ? '₹'+fmt(item.sgstAmount) : '—'}</td>
                                <td class="text-end font-monospace">₹${fmt(item.originalAmount)}</td>`;
                tbody.appendChild(tr);
            });
        } else if (_summary.hasExistingPayment && _summary.items) {
            _summary.items.forEach((item, i) => {
                let isEligible = item.isDiscountAllowed !== false;
                let discBadge = isEligible
                    ? `<span class="badge bg-success-subtle text-success border border-success-subtle ms-1" style="font-size:0.67rem;padding:0.18rem 0.4rem;font-weight:600;"><i class="bi bi-tag-fill me-1"></i>Discountable</span>`
                    : `<span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle ms-1" style="font-size:0.67rem;padding:0.18rem 0.4rem;font-weight:600;"><i class="bi bi-slash-circle me-1"></i>Non-discountable</span>`;

                const tr = document.createElement('tr');
                tr.innerHTML = `<td>${i+1}</td>
                                <td>
                                    <div class="d-flex align-items-center flex-wrap gap-1">
                                        <span class="fw-semibold text-dark">${esc(item.itemName)}</span>
                                        ${discBadge}
                                    </div>
                                </td>
                                <td class="text-muted">${esc(item.serviceType??'')}</td>
                                <td class="text-end text-muted d-none d-sm-table-cell" style="font-size:0.8rem">${(item.cgstAmount && item.cgstAmount > 0) ? '₹'+fmt(item.cgstAmount) : '—'}</td>
                                <td class="text-end text-muted d-none d-sm-table-cell" style="font-size:0.8rem">${(item.sgstAmount && item.sgstAmount > 0) ? '₹'+fmt(item.sgstAmount) : '—'}</td>
                                <td class="text-end font-monospace">₹${fmt(item.originalAmount)}</td>`;
                tbody.appendChild(tr);
                totalCgst += (item.cgstAmount || 0);
                totalSgst += (item.sgstAmount || 0);
            });
        }
        
        let totalTax = totalCgst + totalSgst;
        let elTax = document.getElementById('pmTotalTax');
        if (elTax) elTax.textContent = '₹' + fmt(totalTax);

        let unroundedNet = Math.max(0, base - discAmt + totalTax);
        let roundedNet = Math.round(unroundedNet);
        let roundOff = parseFloat((roundedNet - unroundedNet).toFixed(2));

        _roundOffAmount = roundOff;
        _roundedNetAmount = roundedNet;

        let roundOffRow = document.getElementById('pmRoundOffRow');
        let roundOffEl = document.getElementById('pmRoundOffAmt');
        if (roundOffRow && roundOffEl) {
            if (roundOff !== 0) {
                roundOffRow.style.display = 'flex';
                roundOffEl.textContent = (roundOff > 0 ? '+₹' : '-₹') + fmt(Math.abs(roundOff));
                roundOffEl.className = 'fw-semibold ' + (roundOff > 0 ? 'text-primary' : 'text-danger');
            } else {
                roundOffRow.style.display = 'none';
                roundOffEl.textContent = '₹0.00';
            }
        }

        updateNetAmount(roundedNet);
    }

    function updateNetAmount(net) {
        document.getElementById('pmNetAmount').textContent = '₹' + fmt(net);
        
        // Hide payment method controls if nothing to pay
        const section = document.getElementById('pmPaymentMethodsSection');
        if (section) {
            section.style.display = net > 0 ? '' : 'none';
        }

        // If only one payment row exists, always sync its amount to the net payable
        var allAmtFields = document.querySelectorAll('.pm-paid-amount');
        if (allAmtFields.length === 1) {
            allAmtFields[0].value = fmt(net);
        }
        recalcTotal();
    }

    function getNetAmount() {
        if (_roundedNetAmount > 0) return _roundedNetAmount;
        const text = document.getElementById('pmNetAmount')?.textContent || '0';
        return parseFloat(text.replace(/[^\d.-]/g, '')) || 0;
    }

    // ─── Payment method rows ──────────────────────────────────────────────────
    function addMethodRow() {
        const idx = _rowIdx++;
        const container = document.getElementById('pmMethodRows');
        const div = document.createElement('div');
        div.className = 'border rounded p-3 mb-2 pm-method-row';
        div.dataset.idx = idx;

        // Build options
        const opts = _methods.map(m =>
            `<option value="${m.paymentMethodId}" data-code="${esc(m.methodCode)}"
              data-ref="${m.requiresRef?1:0}"
              data-cheque="${m.requiresChequeNo?1:0}"
              data-bank="${m.requiresBankName?1:0}"
              data-upi="${m.requiresUPIRef?1:0}"
              data-card="${m.requiresCardLast4?1:0}">${esc(m.methodName)}</option>`
        ).join('');

        div.innerHTML = `
          <div class="row g-2 align-items-start">
            <div class="col-12 col-sm-4">
              <label class="form-label small fw-semibold mb-1 text-muted text-uppercase" style="font-size:.7rem">Payment Method</label>
              <select class="form-select form-select-sm pm-method-select" data-idx="${idx}">
                <option value="">— Select —</option>${opts}
              </select>
            </div>
            <div class="col-6 col-sm-4">
              <label class="form-label small fw-semibold mb-1 text-muted text-uppercase" style="font-size:.7rem">Amount (₹)</label>
              <input type="number" class="form-control form-control-sm pm-paid-amount font-monospace"
                     min="0" step="0.01" placeholder="0.00" data-idx="${idx}" />
            </div>
            <div class="col-6 col-sm-4 d-flex align-items-end pb-1 gap-1 flex-wrap pm-extra-fields" data-idx="${idx}">
              ${idx > 0 ? `<button type="button" class="btn btn-sm btn-outline-danger ms-auto mt-1 pm-remove-row" data-idx="${idx}"><i class="bi bi-trash3"></i></button>` : ''}
            </div>
          </div>
          <div class="row g-2 mt-1 pm-cond-fields" data-idx="${idx}" style="display:none"></div>`;

        container.appendChild(div);

        div.querySelector(`.pm-method-select`).addEventListener('change', function () {
            renderConditionalFields(this, idx);
        });
        div.querySelector('.pm-paid-amount')?.addEventListener('input', recalcTotal);
        div.querySelector('.pm-remove-row')?.addEventListener('click', function () {
            div.remove();
            // If only one row remains after removal, sync it to the full net amount
            var remaining = document.querySelectorAll('.pm-paid-amount');
            if (remaining.length === 1) remaining[0].value = fmt(getNetAmount());
            recalcTotal();
        });

        // Auto-fill: first row gets full net; subsequent rows get what's still unpaid
        var net = getNetAmount();
        var othersFilled = [...document.querySelectorAll('.pm-paid-amount')]
            .reduce((sum, el) => sum + (parseFloat(el.value) || 0), 0);
        div.querySelector('.pm-paid-amount').value = fmt(Math.max(0, net - othersFilled));
        recalcTotal();
    }

    function renderConditionalFields(select, idx) {
        const opt = select.options[select.selectedIndex];
        const condRow = document.querySelector(`.pm-cond-fields[data-idx="${idx}"]`);
        if (!condRow) return;
        condRow.innerHTML = '';
        const needRef   = opt.dataset.ref   === '1';
        const needCheq  = opt.dataset.cheque === '1';
        const needBank  = opt.dataset.bank   === '1';
        const needUpi   = opt.dataset.upi    === '1';
        const needCard  = opt.dataset.card   === '1';

        if (needUpi)   condRow.appendChild(field(idx, 'upiRefNo', 'UPI UTR / VPA', 'text'));
        if (needCard)  condRow.appendChild(field(idx, 'cardLast4', 'Card Last 4', 'text', 4));
        if (needRef)   condRow.appendChild(field(idx, 'transactionRef', 'Transaction Ref', 'text'));
        if (needCheq)  condRow.appendChild(field(idx, 'chequeNo', 'Cheque No', 'text'));
        if (needBank)  condRow.appendChild(field(idx, 'bankName', 'Bank Name', 'text'));

        const hasAny = needRef || needCheq || needBank || needUpi || needCard;
        condRow.style.display = hasAny ? '' : 'none';
    }

    function field(idx, name, label, type, maxLen) {
        const col = document.createElement('div');
        col.className = 'col-6 col-sm-4';
        col.innerHTML = `<label class="form-label small fw-semibold mb-1 text-muted text-uppercase" style="font-size:.7rem">${label}</label>
          <input type="${type}" class="form-control form-control-sm pm-cond-input"
                 data-idx="${idx}" data-field="${name}" placeholder="${label}"
                 ${maxLen ? `maxlength="${maxLen}"` : ''} />`;
        return col;
    }

    function recalcTotal() {
        const total = [...document.querySelectorAll('.pm-paid-amount')]
            .reduce((sum, el) => sum + (parseFloat(el.value) || 0), 0);
        const net = getNetAmount();
        const totalEl = document.getElementById('pmEnteringTotal');
        if (totalEl) {
            totalEl.textContent = '₹' + fmt(total);
            if (total > net + 0.001) {
                totalEl.classList.remove('text-primary');
                totalEl.classList.add('text-danger', 'fw-bold');
            } else {
                totalEl.classList.remove('text-danger', 'fw-bold');
                totalEl.classList.add('text-primary');
            }
        }
        const saveBtn = document.getElementById('btnSavePayment');
        if (saveBtn && !_isSubmitting) {
            if (total > net + 0.001) {
                saveBtn.disabled = true;
                saveBtn.title = 'Paid amount cannot exceed payable amount of ₹' + fmt(net);
            } else {
                saveBtn.disabled = false;
                saveBtn.removeAttribute('title');
            }
        }
    }

    // ─── Save ─────────────────────────────────────────────────────────────────
    async function savePayment() {
        if (_isSubmitting) return;

        const btn = document.getElementById('btnSavePayment');
        const originalBtnHtml = '<i class="bi bi-check2-circle me-2"></i>Save Payment';

        try {
            const discType  = document.querySelector('input[name="pmDiscType"]:checked')?.value ?? null;
            const discVal   = parseFloat(document.getElementById('pmDiscValue').value) || 0;
            const discAmt   = parseFloat(document.getElementById('pmDiscAmt').textContent.replace(/[^\d.-]/g, '')) || 0;
            const net       = getNetAmount();

            const payments = [];
            if (net > 0) {
                document.querySelectorAll('.pm-method-row').forEach(row => {
                    const idx    = parseInt(row.dataset.idx);
                    const sel    = row.querySelector('.pm-method-select');
                    const amt    = parseFloat(row.querySelector('.pm-paid-amount')?.value) || 0;
                    const mId    = parseInt(sel?.value) || 0;
                    if (!mId || amt <= 0) return;

                    const extra = {};
                    row.querySelectorAll('.pm-cond-input').forEach(inp => {
                        extra[inp.dataset.field] = inp.value || null;
                    });
                    payments.push({ paymentMethodId: mId, paidAmount: amt, ...extra });
                });

                if (!payments.length) {
                    showError('Please enter at least one payment method and amount.');
                    return;
                }

                const totalEntering = payments.reduce((sum, p) => sum + (parseFloat(p.paidAmount) || 0), 0);
                if (totalEntering > net + 0.001) {
                    showError(`Total paid amount (₹${fmt(totalEntering)}) cannot exceed the payable amount of ₹${fmt(net)}.`);
                    return;
                }
            }

            _isSubmitting = true;
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Saving…';

            const lineItems = (_summary.items || []).map(li => ({
                moduleLineRefId: li.lineRefId,
                itemDescription: li.itemName,
                serviceType: li.serviceType,
                originalAmount: li.originalAmount,
                lineDiscountType: discType,
                lineDiscountValue: 0,
                lineDiscountAmount: li.lineDiscountAmount || 0,
                netLineAmount: li.netLineAmount || li.originalAmount,
                isDiscountAllowed: li.isDiscountAllowed !== false,
                isGstRequired: li.isGstRequired || false,
                gstPercentage: li.gstPercentage || 0,
                cgstAmount: li.cgstAmount || 0,
                sgstAmount: li.sgstAmount || 0,
                igstAmount: li.igstAmount || 0
            }));

            let roundedNet = _roundedNetAmount > 0 ? _roundedNetAmount : net;
            let roundOff = _roundOffAmount;

            const payload = {
                moduleCode:           _moduleCode,
                moduleRefId:          _summary?.moduleRefId ?? _moduleRefId,
                opdServiceId:         _summary?.opdServiceId ?? _moduleRefId,
                patientId:            _summary?.patientId ?? 0,
                branchId:             _summary?.branchId ?? 0,
                subTotal:             _summary?.subTotal ?? 0,
                headerDiscountType:   discType,
                headerDiscountValue:  discVal,
                headerDiscountAmount: discAmt,
                roundOffAmount:       roundOff,
                netAmount:            roundedNet,
                payments,
                lineItems
            };

            if (_isPreSave) {
                if (typeof _onSave === 'function') {
                    try {
                        await _onSave(payload);
                    } catch (err) {
                        btn.disabled = false;
                        btn.innerHTML = originalBtnHtml;
                        _isSubmitting = false;
                        showError(err.message || 'Failed to save booking');
                    }
                }
                return;
            }

            const res  = await fetch('/OPD/SavePayment', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });
            const data = await res.json();

            if (!data.success) {
                showError(data.error || 'Failed to save payment.');
                btn.disabled = false;
                btn.innerHTML = originalBtnHtml;
                _isSubmitting = false;
                return;
            }

            pmModal.hide();

            // ── If full payment → assign the token number into the success modal ──
            if (data.paymentStatus === 'P' && data.tokenNo) {
                const tokenEl  = document.getElementById('successTokenNo');
                const tokenBox = document.getElementById('successTokenBox');
                if (tokenEl) {
                    // Replace the "Pending Payment" content with the real token
                    tokenEl.innerHTML = '';
                    tokenEl.className = 'fw-bold text-success mb-0 font-monospace';
                    tokenEl.style.fontSize = '';
                    tokenEl.textContent = data.tokenNo;
                }
                if (tokenBox) {
                    tokenBox.classList.remove('alert-warning');
                    tokenBox.classList.add('alert-success');
                }
            }

            if (typeof _onSuccess === 'function') {
                _onSuccess(data);
            } else {
                var sm = document.getElementById(_successModal);
                if (sm) new bootstrap.Modal(sm).show();
            }
        } catch (err) {
            showError(err.message || 'Failed to process payment.');
            btn.disabled = false;
            btn.innerHTML = originalBtnHtml;
            _isSubmitting = false;
        }
    }

    function showError(msg) {
        if (typeof Swal !== 'undefined') {
            Swal.fire({
                icon: 'error',
                title: 'Payment Error',
                text: msg
            });
        }
        if (pmError) {
            pmError.textContent = msg;
            pmError.classList.remove('d-none');
            pmError.scrollIntoView({ behavior: 'smooth', block: 'center' });
            setTimeout(() => pmError?.classList.add('d-none'), 8000);
        }
    }

    // ─── Helpers ──────────────────────────────────────────────────────────────
    function fmt(n)  { return (parseFloat(n) || 0).toFixed(2); }
    function esc(s)  { const d = document.createElement('div'); d.textContent = s; return d.innerHTML; }

    // ─── Public API ─────────────────────────────────────────────────────────────
    // Trigger this payment modal for any service from other JS contexts
    window.pmOpenFor = function (svcId, onSuccessCb, moduleCode) {
        _isPreSave = false;
        _summary = null; _methods = []; _rowIdx = 0;
        _moduleRefId = svcId;
        if (moduleCode) {
            _moduleCode = moduleCode;
        }
        _onSuccess   = onSuccessCb || null;
        _onCancel    = null;
        _onSkip      = null;
        _onSave      = null;
        pmLoader.classList.remove('d-none');
        pmError.classList.add('d-none');
        pmForm.classList.add('d-none');
        pmFooter.style.display = 'none';
        document.getElementById('pmMethodRows').innerHTML = '';
        document.getElementById('pmDiscValue').value = '';
        document.getElementById('pmDiscAmt').textContent = '₹0.00';
        document.querySelectorAll('input[name="pmDiscType"]').forEach(function (r) { r.checked = r.value === 'P'; });
        fetchData();
        pmModal.show();
    };

    window.pmOpenPreSave = function (config) {
        _isPreSave = true;
        _summary = {
            patientName: config.patientName,
            patientCode: config.patientCode,
            patientPhone: config.patientPhone,
            opdBillNo: '—',
            tokenNo: '—',
            subTotal: config.subTotal,
            totalPaid: 0,
            balanceDue: config.subTotal,
            hasExistingPayment: false,
            items: config.items || []
        };
        _moduleCode = config.moduleCode || 'LAB';
        _onSave     = config.onSave;
        _onSkip     = config.onSkip || config.onSave;
        _onCancel   = config.onCancel;
        _onSuccess  = config.onSuccess;

        pmLoader.classList.remove('d-none');
        pmError.classList.add('d-none');
        pmForm.classList.add('d-none');
        pmFooter.style.display = 'none';
        document.getElementById('pmMethodRows').innerHTML = '';
        document.getElementById('pmDiscValue').value = '';
        document.getElementById('pmDiscAmt').textContent = '₹0.00';
        document.querySelectorAll('input[name="pmDiscType"]').forEach(function (r) { r.checked = r.value === 'P'; });

        fetch('/OPD/GetPaymentMethods')
            .then(res => res.json())
            .then(methods => {
                _methods = methods;
                renderForm();
                pmModal.show();
            })
            .catch(err => {
                pmLoader.classList.add('d-none');
                pmError.textContent = err.message || 'Failed to load payment methods';
                pmError.classList.remove('d-none');
                pmModal.show();
            });
    };
})();
}); // DOMContentLoaded
</script>
