#paymentModal .pm-approval { border:1px dashed #f59e0b; background:#fffbeb; border-radius:10px; padding:10px 12px; }
#paymentModal .pm-reason-chip { font-size:.7rem; padding:1px 8px; border-radius:999px; }
#paymentModal .pm-reason-chip.active { background:#0f766e; border-color:#0f766e; color:#fff; }
#paymentModal .pm-badge-nd { font-size:.62rem; font-weight:600; padding:1px 6px; border-radius:999px; background:#f1f5f9; color:#64748b; border:1px solid #e2e8f0; }
@@media (max-width: 991.98px) {
    #paymentModal .pm-left { border-right:0; border-bottom:1px solid var(--pm-line); }
}
/* department-wise discount (B2C LAB): summary chip in the Discount card and the popup over the dialog */
#paymentModal .pm-dept-sum { display:flex; flex-wrap:wrap; align-items:center; gap:6px; padding:8px 10px; border-radius:10px;
                             background:#eef2ff; border:1px solid #c7d2fe; color:#312e81; font-size:.78rem; }
#paymentModal .pm-dept-sum .pm-dept-chip { background:#fff; border:1px solid #c7d2fe; border-radius:999px; padding:2px 8px; font-weight:600; white-space:nowrap; }
#paymentModal .pm-dept-popup { position:absolute; inset:0; z-index:1060; background:rgba(15,23,42,.45); display:flex;
                               align-items:flex-start; justify-content:center; padding:48px 16px; overflow:auto; }
#paymentModal .pm-dept-panel { background:#fff; border-radius:14px; box-shadow:0 20px 50px rgba(15,23,42,.3); width:100%; max-width:760px; padding:16px 18px; }
#paymentModal .pm-dept-panel table th { font-size:.7rem; text-transform:uppercase; letter-spacing:.04em; color:var(--pm-muted); }
#paymentModal .pm-dept-type .btn { padding:2px 9px; font-size:.75rem; }
#paymentModal .pm-dept-nd { font-size:.7rem; color:#94a3b8; }
</style>

<div class="modal fade" id="paymentModal" tabindex="-1"
     data-bs-backdrop="static" data-bs-keyboard="false" aria-hidden="true" aria-labelledby="pmTitle">
    <div class="modal-dialog modal-dialog-centered modal-xl modal-dialog-scrollable" style="max-width:1040px">
        <div class="modal-content border-0 shadow-lg overflow-hidden">

            <!-- Department-wise discount popup (B2C LAB) -->
            <div id="pmDeptPopup" class="pm-dept-popup d-none" role="dialog" aria-modal="true" aria-labelledby="pmDeptTitle">
                <div class="pm-dept-panel">
                    <div class="d-flex align-items-start justify-content-between gap-2 mb-2">
                        <div>
                            <div class="fw-bold" id="pmDeptTitle"><i class="bi bi-diagram-3 me-1 text-primary"></i>Department-wise discount</div>
                            <div class="small text-muted">A department's discount applies to all its tests; packages have their own discount head.
                                Only tests allowed a discount in the rate card are discounted.</div>
                        </div>
                        <button type="button" class="btn-close" id="pmDeptClose" aria-label="Close"></button>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-sm align-middle mb-2">
                            <thead><tr>
                                <th>Discount head</th><th class="text-end">Eligible</th><th class="text-center">Type</th>
                                <th style="width:120px">Value</th><th class="text-end">Discount</th><th class="text-end">Net</th>
                            </tr></thead>
                            <tbody id="pmDeptRows"></tbody>
                            <tfoot><tr>
                                <td colspan="4" class="text-end fw-semibold">Total discount</td>
                                <td class="text-end fw-bold text-danger amt" id="pmDeptTotal">₹0.00</td><td></td>
                            </tr></tfoot>
                        </table>
                    </div>
                    <div id="pmDeptMsg" class="small text-danger fw-semibold d-none mb-2"></div>
                    <div class="d-flex gap-2 justify-content-end">
                        <button type="button" class="btn btn-sm btn-outline-secondary" id="pmDeptClearAll"><i class="bi bi-eraser me-1"></i>Clear all</button>
                        <button type="button" class="btn btn-sm btn-light border" id="pmDeptCancel">Cancel</button>
                        <button type="button" class="btn btn-sm btn-primary" id="pmDeptApply"><i class="bi bi-check2 me-1"></i>Apply</button>
                    </div>
                </div>
            </div>

            <!-- Header: who is paying, and bill / token once they exist -->
            <div class="pm-head d-flex align-items-center gap-3">
                <div class="rounded-3 d-flex align-items-center justify-content-center flex-shrink-0" style="width:38px;height:38px;background:#eff6ff;color:#0d6efd;">
                    <i class="bi bi-cash-coin fs-5"></i>
                </div>
                <div class="flex-grow-1 min-w-0">
                    <div class="pm-title" id="pmTitle">Collect Payment</div>
                    <div class="d-flex flex-wrap gap-1 mt-1" id="pmPatientLine"></div>
                </div>
                <div class="d-none d-md-flex flex-wrap gap-1 justify-content-end" id="pmInfoBoxes"></div>
                <button type="button" id="btnPaymentSkip" class="pm-close ms-2" aria-label="Close" title="Cancel & close (Esc)"><i class="bi bi-x-lg"></i></button>
            </div>

            <div class="modal-body pm-body">

                <!-- Loading spinner -->
                <div id="pmLoader" class="text-center py-5">
                    <div class="spinner-border text-primary" role="status"></div>
                    <p class="mt-2 text-muted small">Loading bill details…</p>
                </div>
                <div id="pmLoadError" class="alert alert-danger d-none m-3"></div>

                <!-- Main form (hidden until data loaded) -->
                <div id="pmForm" class="d-none">
                    <div class="row g-0">

                        <!-- ═════ LEFT: bill summary, discount, totals ═════ -->
                        <div class="col-lg-6 pm-pane pm-left">
                            <div class="pm-sec"><i class="bi bi-receipt me-1"></i>Bill summary</div>
                            <div class="pm-items mb-3">
                                <div class="table-responsive">
                                    <table class="table table-sm">
                                        <thead id="pmItemsHead"></thead>
                                        <tbody id="pmLineItemsTbody"></tbody>
                                        <tfoot>
                                            <tr>
                                                <td id="pmSubTotalLabel" class="text-end">Sub Total</td>
                                                <td class="text-end amt" id="pmSubTotal">₹0.00</td>
                                            </tr>
                                        </tfoot>
                                    </table>
                                </div>
                            </div>

                            <!-- Discount -->
                            <div class="pm-card mb-3">
                                <div class="d-flex flex-wrap align-items-center gap-2">
                                    <span class="pm-sec mb-0"><i class="bi bi-tag me-1"></i>Discount</span>
                                    <div class="btn-group btn-group-sm" role="group" id="pmDiscTypeGroup">
                                        <input type="radio" class="btn-check" name="pmDiscType" id="pmDiscTypeP" value="P" autocomplete="off" disabled="@(!pmCanDiscount)">
                                        <label class="btn btn-outline-secondary" for="pmDiscTypeP">%</label>
                                        <input type="radio" class="btn-check" name="pmDiscType" id="pmDiscTypeF" value="F" autocomplete="off" disabled="@(!pmCanDiscount)">
                                        <label class="btn btn-outline-secondary" for="pmDiscTypeF">₹ Fixed</label>
                                    </div>
                                    <div class="input-group input-group-sm" style="width:120px">
                                        <input type="number" id="pmDiscValue" class="form-control" disabled="@(!pmCanDiscount)"
                                               min="0" step="0.01" placeholder="0" autocomplete="off" />
                                        <span class="input-group-text" id="pmDiscSymbol">%</span>
                                    </div>
                                    <span class="ms-auto small text-muted">Discount <strong class="text-danger amt" id="pmDiscAmt">₹0.00</strong></span>
                                </div>
                                @if (pmCanDiscount)
                                {
                                    <div class="pm-quick d-flex flex-wrap gap-1 mt-2" id="pmDiscQuick">
                                        <button type="button" class="btn btn-outline-secondary" data-pct="5">5%</button>
                                        <button type="button" class="btn btn-outline-secondary" data-pct="10">10%</button>
                                        <button type="button" class="btn btn-outline-secondary" data-pct="15">15%</button>
                                        <button type="button" class="btn btn-outline-secondary" data-pct="20">20%</button>
                                        <button type="button" class="btn btn-outline-danger" data-pct="0" title="Remove the discount"><i class="bi bi-x"></i> Clear</button>
                                    </div>
                                    <!-- B2C LAB: a % or ₹ per department (and one for packages) instead of one discount for the bill -->
                                    <div class="mt-2 d-none" id="pmDeptDiscWrap">
                                        <button type="button" class="btn btn-sm btn-outline-primary" id="pmDeptDiscBtn">
                                            <i class="bi bi-diagram-3 me-1"></i>Department-wise discount
                                        </button>
                                    </div>
                                    <div class="mt-2 d-none" id="pmDeptDiscSummary"></div>
                                }
                                <div class="mt-2 small d-none" id="pmDiscEligibilityRow">
                                    <span class="text-muted">Eligible for discount: <strong class="text-dark amt" id="pmDiscEligibleAmt">₹0.00</strong>
                                        <span class="text-secondary" id="pmDiscNonEligibleAmt">(Non-discountable: ₹0.00)</span></span>
                                </div>
                                <div id="pmDiscWarning" class="mt-1 small text-danger fw-semibold d-none"></div>

                                <!-- Discount approval, inline: reason + who approved it (required for every discount) -->
                                <div class="pm-approval mt-2 d-none" id="pmDiscApprovalBox">
                                    <div class="d-flex align-items-center gap-1 mb-1 small fw-semibold text-warning-emphasis">
                                        <i class="bi bi-shield-exclamation"></i>Discount approval required
                                    </div>
                                    <label class="pm-lbl" for="pmDiscReason">Reason <span class="text-danger">*</span></label>
                                    <div class="d-flex flex-wrap gap-1 mb-1" id="pmReasonChips"></div>
                                    <textarea id="pmDiscReason" class="form-control form-control-sm" rows="2" maxlength="250" placeholder="Why is this discount given?"></textarea>
                                    <label class="pm-lbl mt-2" for="pmDiscApprover">Approved by <span class="text-danger">*</span></label>
                                    <select id="pmDiscApprover" class="form-select form-select-sm"><option value="">-- Select the approving person --</option></select>
                                </div>
                                <div class="mt-2 small d-none" id="pmDiscApprovalInfo"></div>
                                <!-- a bill is discounted only once: an existing discount is shown here and the controls are locked -->
                                <div class="mt-2 small alert alert-secondary py-2 px-2 mb-0 d-none" id="pmDiscLocked"></div>
                                @if (!pmCanDiscount)
                                {
                                    <div class="mt-2 small text-muted"><i class="bi bi-lock-fill me-1"></i>You do not have permission to give a discount on this screen.</div>
                                }
                            </div>

                            <!-- Totals -->
                            <div class="pm-card pm-totals">
                                <div class="row-t"><span>Sub total</span><span class="amt" id="pmTotSub">₹0.00</span></div>
                                <div class="row-t d-none" id="pmTotDiscRow"><span>Discount</span><span class="amt text-danger" id="pmTotDisc">−₹0.00</span></div>
                                <div class="row-t d-none" id="pmMemDiscRow"><span id="pmMemDiscLabel">Membership discount</span><span class="amt text-danger" id="pmMemDisc">−₹0.00</span></div>
                                <div class="row-t d-none" id="pmTaxRow"><span>GST</span><span class="amt" id="pmTotalTax">₹0.00</span></div>
                                <div class="row-t d-none" id="pmRoundOffRow"><span>Round off</span><span class="amt" id="pmRoundOffAmt">₹0.00</span></div>
                                <div class="row-t row-net"><span class="fw-bold text-dark">Net payable</span><span class="pm-net amt" id="pmNetAmount">₹0.00</span></div>
                            </div>
                        </div>

                        <!-- ═════ RIGHT: payment ═════ -->
                        <div class="col-lg-6 pm-pane">
                            <div class="pm-due-card mb-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
                                <div>
                                    <div class="pm-sec mb-1">Amount due now</div>
                                    <div class="pm-due-amt amt" id="pmDueNow">₹0.00</div>
                                </div>
                                <div id="pmExistingPaySection" class="d-none text-end small">
                                    <div class="text-muted">Already paid <strong class="text-success amt" id="pmAlreadyPaid"></strong></div>
                                    <div class="text-muted">Balance due <strong class="text-danger amt" id="pmBalanceDue"></strong></div>
                                </div>
                            </div>

                            <div id="pmError" class="alert alert-danger d-none py-2 px-3 small d-flex align-items-start gap-2" role="alert"></div>

                            <!-- Membership points (B2C LAB; SQLScripts/2236): card of the bill's patient, found by patient or phone -->
                            <div id="pmMemPanel" class="pm-mem mb-3 d-none">
                                <div class="d-flex justify-content-between align-items-start gap-2">
                                    <div class="min-w-0">
                                        <div class="pm-sec mb-1"><i class="bi bi-award me-1"></i>Membership points</div>
                                        <div class="small" id="pmMemCard"></div>
                                    </div>
                                    <div class="text-end">
                                        <div class="fw-bold amt" id="pmMemBal"></div>
                                        <div class="small text-muted amt" id="pmMemBalRs"></div>
                                    </div>
                                </div>
                                <div id="pmMemRedeemBox" class="mt-2">
                                    <div class="input-group input-group-sm">
                                        <span class="input-group-text">Redeem</span>
                                        <input type="number" min="1" step="1" class="form-control" id="pmMemPoints" placeholder="points" autocomplete="off" />
                                        <span class="input-group-text amt" id="pmMemPointsRs">= ₹0.00</span>
                                        <button class="btn btn-outline-primary" type="button" id="pmMemSendOtp"><i class="bi bi-shield-lock me-1"></i>Send OTP</button>
                                    </div>
                                    <div class="small text-muted mt-1" id="pmMemHint"></div>
                                    <div id="pmMemOtpBox" class="d-none mt-2">
                                        <div class="input-group input-group-sm">
                                            <span class="input-group-text">OTP</span>
                                            <input type="text" inputmode="numeric" maxlength="6" class="form-control font-monospace" id="pmMemOtp" placeholder="6-digit code from the card holder" autocomplete="one-time-code" />
                                            <button class="btn btn-outline-secondary" type="button" id="pmMemCancel" title="Do not redeem points">Remove</button>
                                        </div>
                                        <div class="small text-success mt-1" id="pmMemOtpInfo"></div>
                                    </div>
                                </div>
                                <div class="small text-muted mt-1" id="pmMemEarn"></div>
                            </div>

                            <!-- Payment lines (hidden if net is 0) -->
                            <div id="pmPaymentMethodsSection">
                                <div class="pm-sec"><i class="bi bi-wallet2 me-1"></i>Payment mode</div>
                                <div id="pmMethodRows"></div>
                                <button type="button" class="btn btn-sm btn-link text-decoration-none px-0 mt-2" id="btnAddPayMethod">
                                    <i class="bi bi-plus-circle me-1"></i>Split payment (add another mode)
                                </button>

                                <div class="mt-2" id="pmStatus"></div>
                                <div class="d-flex justify-content-between align-items-center mt-2 small text-muted">
                                    <span>Total entering now</span>
                                    <span class="fw-bold text-primary amt fs-6" id="pmEnteringTotal">₹0.00</span>
                                </div>
                            </div>
                            <div id="pmNothingToPay" class="alert alert-success py-2 small d-none mb-0"><i class="bi bi-check-circle me-1"></i>Nothing to collect on this bill.</div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="pm-foot d-flex flex-wrap align-items-center gap-2" id="pmFooter" style="display:none!important">
                <button type="button" class="btn btn-outline-secondary" id="btnPaymentSkip2" title="Save the bill now; collect the amount later">
                    <i class="bi bi-clock-history me-1"></i>Pay later (save as due)
                </button>
                <span class="small text-muted ms-auto d-none d-md-inline"><kbd>Enter</kbd> to collect · <kbd>Esc</kbd> to cancel</span>
                <button type="button" class="btn btn-primary pm-collect" id="btnSavePayment">
                    <i class="bi bi-check2-circle me-2"></i><span id="pmCollectLabel">Save Payment</span>
                </button>
            </div>

        </div>
    </div>
</div>

<script>
@* Inline script – @section Scripts is NOT valid in partial views. *@
document.addEventListener('DOMContentLoaded', function () {
(function () {
    'use strict';

    /* ── server-side values ── */
    var _moduleCode    = '@Html.Raw(pmCode)';
    var _moduleRefId   = @pmRefId;
    var _successModal  = '@Html.Raw(pmSuccess)';
    var _canDiscount   = @(pmCanDiscount ? "true" : "false");

    /* ── state ── */
    var _mem = null, _memRedeem = null;   // membership card of the bill's patient; points being redeemed (after the OTP is sent)
    var _summary = null, _methods = [], _rowIdx = 0, _onSuccess = null, _onCancel = null, _onSkip = null, _onSave = null, _isPreSave = false;
    var _isSubmitting = false;
    var _roundOffAmount = 0, _roundedNetAmount = 0;
    var _discAmt = 0;   // discount amount as calculated (kept as a number, the shown text is formatted)

    var pmModalEl = document.getElementById('paymentModal');
    var pmModal   = new bootstrap.Modal(pmModalEl, {backdrop:'static'});

    // ─── Payment-mode cards: colour + icon per method code ────────────────────
    var MODE_STYLE = {
        CASH:   { c:'#15803d', cb:'#f0fdf4', i:'bi-cash-stack' },
        UPI:    { c:'#7c3aed', cb:'#f5f3ff', i:'bi-qr-code-scan' },
        CARD:   { c:'#2563eb', cb:'#eff6ff', i:'bi-credit-card-2-front' },
        NEFT:   { c:'#0f766e', cb:'#f0fdfa', i:'bi-bank' },
        RTGS:   { c:'#0f766e', cb:'#f0fdfa', i:'bi-bank' },
        CHEQUE: { c:'#b45309', cb:'#fffbeb', i:'bi-journal-check' },
        WALLET: { c:'#db2777', cb:'#fdf2f8', i:'bi-wallet2' }
    };
    function modeStyle(code) {
        var k = String(code || '').toUpperCase();
        return MODE_STYLE[k] || { c:'#475569', cb:'#f1f5f9', i:'bi-credit-card' };
    }

    // ─── Discount approval: every discount records its reason and who approved it ─────────
    var _discApproval = null;   // { amount, reason, approvedBy, approvedByName } captured in this dialog
    var _approvers = null;      // users who may approve a discount, loaded once per module
    var _approversFor = null;
    const DISCOUNT_REASONS = ['Senior citizen', 'Staff / staff family', 'Referred by doctor', 'Health camp',
                              'Regular patient', 'Financial hardship', 'Management approval'];

    async function loadApprovers() {
        // per module: a LAB bill lists only Administrator / Manager users
        if (_approvers && _approversFor === _moduleCode) return _approvers;
        _approversFor = _moduleCode;
        try { const r = await fetch('/OPD/GetDiscountApprovers?moduleCode=' + encodeURIComponent(_moduleCode || '')); _approvers = r.ok ? await r.json() : []; }
        catch (e) { _approvers = []; }
        return _approvers;
    }

    // An unchanged discount that already has its reason on record is not asked again (e.g. collecting a due later).
    function discountAlreadyApproved(discAmt) {
        const exAmt = parseFloat(_summary?.existingHeaderDiscountAmount) || 0;
        return !!(_summary?.hasExistingPayment && _summary?.existingDiscountReason && _summary?.existingDiscountApprovedBy
                  && Math.abs(discAmt - exAmt) < 0.01);
    }

    // Fill the inline approval box once: reason chips and the approver list (with the earlier choice pre-selected)
    var _approvalBoxReady = false;
    async function prepareApprovalBox() {
        if (_approvalBoxReady) return;
        _approvalBoxReady = true;
        const prevReason = _discApproval?.reason ?? _summary?.existingDiscountReason ?? '';
        const prevBy = _discApproval?.approvedBy ?? _summary?.existingDiscountApprovedBy ?? '';
        document.getElementById('pmReasonChips').innerHTML = DISCOUNT_REASONS.map(r =>
            `<button type="button" class="btn btn-sm btn-outline-secondary pm-reason-chip">${esc(r)}</button>`).join('');
        const ta = document.getElementById('pmDiscReason');
        if (!ta.value) ta.value = prevReason || '';
        const approvers = await loadApprovers();
        const sel = document.getElementById('pmDiscApprover');
        sel.innerHTML = '<option value="">-- Select the approving person --</option>' + approvers.map(u =>
            `<option value="${u.id}" ${String(u.id) === String(prevBy) ? 'selected' : ''}>${esc(u.name)}${u.role ? ' (' + esc(u.role) + ')' : ''}</option>`).join('');
    }

    function renderDiscApprovalInfo(discAmt) {
        const info = document.getElementById('pmDiscApprovalInfo');
        const box = document.getElementById('pmDiscApprovalBox');
        if (!info || !box) return;
        if (!(discAmt > 0)) { info.classList.add('d-none'); box.classList.add('d-none'); return; }
        if (discountAlreadyApproved(discAmt)) {
            // an unchanged discount approved earlier: shown, not asked again
            box.classList.add('d-none');
            info.innerHTML = `<span class="text-success"><i class="bi bi-shield-check me-1"></i>Reason: <strong>${esc(_summary.existingDiscountReason)}</strong> &middot; Approved by <strong>${esc(_summary.existingDiscountApprovedByName || '')}</strong></span>`;
            info.classList.remove('d-none');
            return;
        }
        info.classList.add('d-none');
        box.classList.remove('d-none');
        prepareApprovalBox();
    }

    // Resolves to { reason, approvedBy } (nulls when there is no discount), or null when the approval is incomplete.
    async function ensureDiscountApproval(discAmt) {
        if (!(discAmt > 0)) return { reason: null, approvedBy: null };
        if (discountAlreadyApproved(discAmt))
            return { reason: _summary.existingDiscountReason, approvedBy: _summary.existingDiscountApprovedBy };

        await prepareApprovalBox();
        const ta = document.getElementById('pmDiscReason');
        const sel = document.getElementById('pmDiscApprover');
        const reason = (ta.value || '').trim();
        ta.classList.toggle('is-invalid', reason.length < 3);
        sel.classList.toggle('is-invalid', !sel.value);
        if (reason.length < 3) { showError('Enter the reason for the discount.'); ta.focus(); return null; }
        if (!sel.value) { showError('Select who approved the discount.'); sel.focus(); return null; }
        _discApproval = { amount: discAmt, reason, approvedBy: parseInt(sel.value), approvedByName: sel.options[sel.selectedIndex].text.replace(/ \(.*\)$/, '') };
        return _discApproval;
    }

    var pmLoader  = document.getElementById('pmLoader');
    var pmError   = document.getElementById('pmError');
    var pmForm    = document.getElementById('pmForm');
    var pmFooter  = document.getElementById('pmFooter');

    // ─── Auto-open when triggered ─────────────────────────────────────────────
    if (_moduleRefId > 0) {
        pmModal.show();
        fetchData();
    }

    // Top close icon → Cancel without saving anything
    document.getElementById('btnPaymentSkip')?.addEventListener('click', cancelPayment);
    // Pay later button in footer
    document.getElementById('btnPaymentSkip2')?.addEventListener('click', skipPayment);
    // Collect button in footer
    document.getElementById('btnSavePayment')?.addEventListener('click', savePayment);
    document.getElementById('btnAddPayMethod')?.addEventListener('click', function () { addMethodRow(); });

    // Discount: type, value, quick percentages
    document.querySelectorAll('input[name="pmDiscType"]').forEach(r => r.addEventListener('change', function () { if (_summary) recalcDiscount(); }));
    document.getElementById('pmDiscValue').addEventListener('input', function () { if (_summary) recalcDiscount(); });
    document.getElementById('pmDiscQuick')?.addEventListener('click', function (e) {
        const b = e.target.closest('button[data-pct]'); if (!b || !_summary) return;
        const pct = parseFloat(b.dataset.pct) || 0;
        document.getElementById('pmDiscTypeP').checked = true;
        document.getElementById('pmDiscValue').value = pct > 0 ? pct : '';
        recalcDiscount();
    });
    // Department-wise discount: open, edit, remove, popup controls
    document.getElementById('pmDeptDiscBtn')?.addEventListener('click', openDeptPopup);
    document.getElementById('pmDeptDiscSummary')?.addEventListener('click', function (e) {
        if (e.target.closest('#pmDeptEdit')) openDeptPopup();
        else if (e.target.closest('#pmDeptRemove')) removeDeptDiscount();
    });
    document.getElementById('pmDeptClose')?.addEventListener('click', closeDeptPopup);
    document.getElementById('pmDeptCancel')?.addEventListener('click', closeDeptPopup);
    document.getElementById('pmDeptApply')?.addEventListener('click', applyDeptPopup);
    document.getElementById('pmDeptClearAll')?.addEventListener('click', function () {
        if (!_deptDraft) return; _deptDraft.forEach(r => r.value = ''); renderDeptRows();
    });
    document.getElementById('pmDeptRows')?.addEventListener('input', function (e) {
        const inp = e.target.closest('.pm-dept-val'); if (!inp || !_deptDraft) return;
        _deptDraft[parseInt(inp.closest('tr').dataset.i)].value = inp.value;
        updateDeptTotals();
    });
    document.getElementById('pmDeptRows')?.addEventListener('click', function (e) {
        const b = e.target.closest('.pm-dept-type button[data-type]'); if (!b || !_deptDraft) return;
        const row = _deptDraft[parseInt(b.closest('tr').dataset.i)];
        if (row.type !== b.dataset.type) { row.type = b.dataset.type; row.value = ''; renderDeptRows(); }
    });

    // Reason chips fill the reason box
    document.getElementById('pmReasonChips')?.addEventListener('click', function (e) {
        const b = e.target.closest('.pm-reason-chip'); if (!b) return;
        const ta = document.getElementById('pmDiscReason');
        ta.value = b.textContent; ta.classList.remove('is-invalid'); ta.focus(); hideError();
        this.querySelectorAll('.pm-reason-chip').forEach(x => x.classList.toggle('active', x === b));
    });
    // fixing a flagged field clears its mark and the message
    document.getElementById('pmDiscApprovalBox')?.addEventListener('input', function (e) { e.target.classList?.remove('is-invalid'); hideError(); });
    document.getElementById('pmDiscApprovalBox')?.addEventListener('change', function (e) { e.target.classList?.remove('is-invalid'); hideError(); });
    document.getElementById('pmMethodRows')?.addEventListener('input', function () { hideError(); });

    // membership points: changing the points after the OTP was sent needs a new OTP
    document.getElementById('pmMemPoints')?.addEventListener('input', function () {
        hideError();
        if (_memRedeem) { _memRedeem = null; document.getElementById('pmMemOtpBox')?.classList.add('d-none'); updateNetAmount(getBillNet()); }
        else renderMemHint();
    });
    document.getElementById('pmMemSendOtp')?.addEventListener('click', sendMemOtp);
    document.getElementById('pmMemCancel')?.addEventListener('click', function () {
        _memRedeem = null;
        const pts = document.getElementById('pmMemPoints'); if (pts) pts.value = '';
        document.getElementById('pmMemOtp').value = '';
        document.getElementById('pmMemOtpBox')?.classList.add('d-none');
        updateNetAmount(getBillNet());
    });

    // Keyboard: Enter collects (not inside a text area / button / select), Esc cancels
    pmModalEl.addEventListener('keydown', function (e) {
        if (document.querySelector('.swal2-container')) return;   // a confirmation is open on top
        if (e.key === 'Escape') { e.preventDefault(); cancelPayment(); return; }
        if (e.key === 'Enter') {
            const t = e.target;
            if (t && (t.tagName === 'TEXTAREA' || t.tagName === 'BUTTON' || t.tagName === 'SELECT')) return;
            if (t && t.tagName === 'INPUT' && !t.classList.contains('pm-paid-amount')) return;   // discount, references: no accidental collect
            if (pmForm.classList.contains('d-none')) return;
            e.preventDefault();
            const btn = document.getElementById('btnSavePayment');
            if (btn && !btn.disabled) savePayment();
        }
    });

    function cancelPayment() {
        pmModal.hide();
        if (typeof _onCancel === 'function') {
            _onCancel();
        }
    }

    async function skipPayment() {
        if (typeof Swal !== 'undefined') {
            const result = await Swal.fire({
                title: 'Pay later?',
                html: `
                    <div class="text-start">
                        <p class="mb-2 text-dark">The bill will be saved <strong>without collecting payment now</strong>.</p>
                        <div class="alert alert-warning py-2 px-3 mb-0 small border-warning-subtle text-dark">
                            <i class="bi bi-exclamation-triangle-fill me-1 text-warning"></i>
                            The <strong>full amount stays due</strong> (Payment Status: <strong>Unpaid</strong>).
                        </div>
                    </div>
                `,
                icon: 'warning',
                target: pmModalEl,
                showCancelButton: true,
                confirmButtonColor: '#0d6efd',
                cancelButtonColor: '#6c757d',
                confirmButtonText: '<i class="bi bi-check2-circle me-1"></i> Yes, save as due',
                cancelButtonText: '<i class="bi bi-arrow-left me-1"></i> Back',
                reverseButtons: true,
                focusCancel: true
            });

            if (!result.isConfirmed) {
                return;
            }
        } else {
            if (!confirm('Save the bill without payment? The full amount stays due (Unpaid).')) {
                return;
            }
        }

        await executeSkipPayment();
    }

    async function executeSkipPayment() {
        if (_isPreSave) {
            const discType  = currentDiscType();
            const discVal   = currentDiscValue();
            const discAmt   = _discAmt;
            const net       = getBillNet();
            const approval  = await ensureDiscountApproval(discAmt);
            if (!approval) return;   // approval incomplete: the fields are highlighted
            const lineItems = (_summary.items || []).map(li => ({
                moduleLineRefId: li.lineRefId,
                itemDescription: li.itemName,
                serviceType: li.serviceType,
                originalAmount: li.originalAmount,
                lineDiscountType: discType,
                lineDiscountValue: 0,
                lineDiscountAmount: Math.max(0, (li.lineDiscountAmount || 0) - (li.membershipDiscount || 0)),   // the membership part is worked out by the server
                netLineAmount: li.netLineAmount || li.originalAmount,
                isDiscountAllowed: li.isDiscountAllowed !== false,
                isGstRequired: li.isGstRequired || false,
                gstPercentage: li.gstPercentage || 0,
                cgstAmount: li.cgstAmount || 0,
                sgstAmount: li.sgstAmount || 0,
                igstAmount: li.igstAmount || 0
            }));

            const payload = {
                headerDiscountType:   discType,
                headerDiscountValue:  discVal,
                headerDiscountAmount: discAmt,
                departmentDiscounts:  currentDeptDiscounts(),
                discountReason:       approval.reason,
                discountApprovedBy:   approval.approvedBy,
                netAmount:            net,
                payments:             [],
                lineItems:            lineItems,
                isSkipped:            true
            };

            const btn = document.getElementById('btnPaymentSkip2');
            const btnHtml = btn ? btn.innerHTML : '';
            if (btn) {
                btn.disabled = true;
                btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Saving…';
            }

            try {
                if (typeof _onSkip === 'function') {
                    await _onSkip(payload);
                }
            } catch (err) {
                showError(err.message || 'Failed to save booking.');
            } finally {
                if (btn) {
                    btn.disabled = false;
                    btn.innerHTML = btnHtml;
                }
            }
            return;
        }

        pmModal.hide();
        var sm = document.getElementById(_successModal);
        if (sm) new bootstrap.Modal(sm).show();
    }

    // ─── Fetch payment methods + summary in parallel ───────────────────────────
    async function fetchData() {
        try {
            const [methodsRes, summaryRes] = await Promise.all([
                fetch('/OPD/GetPaymentMethods'),
                fetch(`/OPD/GetPaymentSummary?moduleCode=${_moduleCode}&moduleRefId=${_moduleRefId}`)
            ]);
            _methods = await methodsRes.json();
            const summaryJson = await summaryRes.json();
            if (!summaryJson.success) throw new Error(summaryJson.error || 'Failed to load bill.');
            _summary = summaryJson.data;
            renderForm();
        } catch (e) {
            pmLoader.classList.add('d-none');
            showLoadError(e.message);
        }
    }

    // ─── Render form ──────────────────────────────────────────────────────────
    function renderForm() {
        pmLoader.classList.add('d-none');
        pmError.classList.add('d-none');

        // Patient line as chips
        const chips = [];
        if (_summary.patientName) chips.push(`<span class="pm-chip"><i class="bi bi-person"></i>${esc(_summary.patientName)}</span>`);
        if (_summary.patientCode) chips.push(`<span class="pm-chip">${esc(_summary.patientCode)}</span>`);
        if (_summary.patientPhone) chips.push(`<span class="pm-chip"><i class="bi bi-telephone"></i>${esc(_summary.patientPhone)}</span>`);
        document.getElementById('pmPatientLine').innerHTML = chips.join('');

        // Bill No / Token only once they exist (not during booking)
        const real = v => v && String(v).trim() && String(v).trim() !== '—';
        document.getElementById('pmInfoBoxes').innerHTML =
            (real(_summary.opdBillNo) ? `<span class="pm-chip" style="background:#f0fdf4;border-color:#bbf7d0;color:#166534"><i class="bi bi-receipt"></i>Bill ${esc(_summary.opdBillNo)}</span>` : '') +
            (real(_summary.tokenNo) ? `<span class="pm-chip" style="background:#fffbeb;border-color:#fde68a;color:#92400e"><i class="bi bi-ticket-perforated"></i>Token ${esc(_summary.tokenNo)}</span>` : '');

        document.getElementById('pmSubTotal').textContent = '₹' + fmtIN(_summary.subTotal);
        document.getElementById('pmTotSub').textContent = '₹' + fmtIN(_summary.subTotal);

        // Existing payment info
        if (_summary.hasExistingPayment) {
            document.getElementById('pmAlreadyPaid').textContent = '₹' + fmtIN(_summary.totalPaid);
            document.getElementById('pmBalanceDue').textContent  = '₹' + fmtIN(_summary.balanceDue);
            document.getElementById('pmExistingPaySection').classList.remove('d-none');
        } else {
            document.getElementById('pmExistingPaySection').classList.add('d-none');
        }

        // A bill is discounted only once: an earlier discount locks the discount controls
        applyDiscountLock();
        // B2C LAB: department-wise discount heads (the button shows once they are loaded)
        _deptDisc = null;
        loadDeptHeads();
        // B2C LAB: the patient's membership card and points
        loadMembership();
        loadMemberBenefits();

        // Trigger calculation to include GST initially
        recalcDiscount();

        // Clear and add exactly one payment line by default
        document.getElementById('pmMethodRows').innerHTML = '';
        _rowIdx = 0;
        addMethodRow();

        pmForm.classList.remove('d-none');
        pmFooter.style.removeProperty('display');
        setTimeout(() => document.querySelector('#pmMethodRows .pm-paid-amount')?.focus(), 250);
    }

    // ─── One discount per bill ─────────────────────────────────────────────────
    // A bill that already carries a discount (given at billing or at an earlier payment) cannot get another one:
    // the controls are locked and the earlier discount is shown. The server refuses a second discount as well.
    function existingBillDiscount() {
        if (!_summary?.hasExistingPayment) return 0;
        // the membership benefit (SQLScripts/2241) is not a manual discount
        return Math.max(parseFloat(_summary.existingHeaderDiscountAmount) || 0,
                        (parseFloat(_summary.existingLineDiscountTotal) || 0) - (parseFloat(_summary.membershipDiscountAmount) || 0));
    }
    function applyDiscountLock() {
        const given = existingBillDiscount();
        const memLock = memBlocksManual();
        const locked = given > 0 || memLock;
        ['pmDiscTypeP', 'pmDiscTypeF', 'pmDiscValue'].forEach(id => {
            const el = document.getElementById(id);
            if (el) el.disabled = locked || !_canDiscount;
        });
        if (locked) document.getElementById('pmDiscValue').value = '';
        document.getElementById('pmDiscQuick')?.classList.toggle('d-none', locked);
        const box = document.getElementById('pmDiscLocked');
        if (!box) return;
        if (!locked) { box.classList.add('d-none'); box.innerHTML = ''; return; }
        if (memLock && !(given > 0)) {
            const card = _memBen?.cardNo ? ` (card <span class="font-monospace">${esc(_memBen.cardNo)}</span>${_memBen.planName ? ', ' + esc(_memBen.planName) : ''})` : '';
            box.innerHTML = `<i class="bi bi-award-fill me-1"></i>Membership benefit applied${card}. A manual discount cannot be added to this bill.`;
            box.classList.remove('d-none');
            return;
        }
        const who = _summary.existingDiscountReason
            ? ` &middot; ${esc(_summary.existingDiscountReason)}${_summary.existingDiscountApprovedByName ? ', approved by ' + esc(_summary.existingDiscountApprovedByName) : ''}`
            : '';
        box.innerHTML = `<i class="bi bi-lock-fill me-1"></i>A discount of <strong>₹${fmtIN(given)}</strong> was already given on this bill${who}. `
                      + `A bill can be discounted only once.`;
        box.classList.remove('d-none');
    }

    // ─── Department-wise discount (B2C LAB) ────────────────────────────────────
    // Each discount head - a department on the bill, or Packages - takes its own % (default) or ₹. A % discounts each
    // eligible test by round(price × % / 100, 2); a ₹ amount is spread over the head's eligible tests in proportion to
    // price, the last test taking the remainder. The server recalculates the same way from the saved bill.
    var _deptHeads = null;   // { isB2B, heads:[{key,name,isPackages,tests,eligibleAmount,nonEligibleAmount}], lines:[...] }
    var _deptDisc = null;    // applied: { rows:[{key,name,type,value,amount}], total, per:[amount by line] }
    var _deptDraft = null;   // the popup's working rows
    var _isB2CHint = false;  // the booking screen says this is a B2C bill

    const round2 = n => Math.round((n + Number.EPSILON) * 100) / 100;

    // ─── Membership points (B2C LAB) ─────────────────────────────────────────
    // The server (usp_Membership_RedeemOnBill) checks every plan rule again; the screen only previews them.
    async function loadMembership() {
        _mem = null; _memRedeem = null; _memBen = null;
        const panel = document.getElementById('pmMemPanel');
        panel?.classList.add('d-none');
        if (_moduleCode !== 'LAB') return;
        let url;
        if (_isPreSave) {
            const phone = (_summary?.patientPhone || '').trim();
            if (!_isB2CHint || !phone) return;
            url = '/LabOrderBooking/MembershipForBilling?phone=' + encodeURIComponent(phone);
        } else {
            const id = _summary?.moduleRefId ?? _moduleRefId;
            if (!(id > 0)) return;
            url = '/LabOrderBooking/MembershipForBilling?labOrderId=' + encodeURIComponent(id);
        }
        try {
            const r = await fetch(url);
            if (!r.ok) return;
            const d = await r.json();
            const c = d && (d.data !== undefined ? d.data : d);
            if (!c || !(c.CardId > 0)) return;
            _mem = c;
        } catch (e) { return; }
        renderMem();
    }

    function memNum(v) { return parseFloat(v) || 0; }

    // the most points this bill may take: the plan's Max Redeem % of the bill, the money still due, the balance
    function memMaxPoints() {
        if (!_mem) return 0;
        const pv = memNum(_mem.PointValue), maxPct = memNum(_mem.MaxRedeemPercent);
        if (pv <= 0 || maxPct <= 0) return 0;
        const billNet = _summary?.hasExistingPayment && memNum(_summary.netAmount) > 0 ? memNum(_summary.netAmount) : getBillNet();
        const capRs = Math.min(billNet * maxPct / 100, getBillNet());
        return Math.max(0, Math.min(Math.floor(memNum(_mem.PointsBalance)), Math.floor((capRs + 0.0001) / pv)));
    }

    function memBlockReason() {
        if (!_mem) return 'No membership card.';
        if (memNum(_mem.PointValue) <= 0 || memNum(_mem.MaxRedeemPercent) <= 0) return 'This plan does not allow redeeming points.';
        if (memNum(_mem.PointsBalance) < 1) return 'No points to redeem yet.';
        const billNet = _summary?.hasExistingPayment && memNum(_summary.netAmount) > 0 ? memNum(_summary.netAmount) : getBillNet();
        const minBill = memNum(_mem.MinRedeemBillAmount);
        if (minBill > 0 && billNet + 0.001 < minBill) return `Points can be redeemed on bills of ₹${fmtIN(minBill)} or more.`;
        if (getBillNet() <= 0) return 'Nothing is due on this bill.';
        if (memMaxPoints() < 1) return 'This bill cannot take any points.';
        return null;
    }

    function renderMem() {
        const panel = document.getElementById('pmMemPanel');
        if (!panel || !_mem) return;
        const vt = _mem.ValidTo ? new Date(_mem.ValidTo) : null;
        document.getElementById('pmMemCard').innerHTML =
            `<span class="fw-semibold font-monospace">${esc(_mem.CardNo)}</span> &middot; ${esc(_mem.PlanName || _mem.PlanCode || '')}`
            + (vt && !isNaN(vt) ? ` &middot; <span class="text-muted">valid till ${vt.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' })}</span>` : '')
            + (_mem.PrimaryName ? `<div class="text-muted">Card holder: ${esc(_mem.PrimaryName)}${_mem.PrimaryPhoneMasked ? ' (' + esc(_mem.PrimaryPhoneMasked) + ')' : ''}</div>` : '');
        document.getElementById('pmMemBal').textContent = `${Math.floor(memNum(_mem.PointsBalance)).toLocaleString('en-IN')} pts`;
        document.getElementById('pmMemBalRs').textContent = `worth ₹${fmtIN(memNum(_mem.PointsValue))}`;
        // points expire on their own date (Points Expire After, set on the plan); the next lot is shown
        const nx = _mem.NextExpiryDate ? new Date(_mem.NextExpiryDate) : null;
        if (nx && !isNaN(nx) && memNum(_mem.NextExpiryPoints) > 0)
            document.getElementById('pmMemBalRs').textContent += ` · ${Math.floor(memNum(_mem.NextExpiryPoints)).toLocaleString('en-IN')} expire ${nx.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' })}`;
        panel.classList.remove('d-none');
        renderMemHint();
    }

    // the redeem box, the "max" hint and the points this bill earns
    function renderMemHint() {
        if (!_mem) return;
        const pv = memNum(_mem.PointValue);
        const ptsEl = document.getElementById('pmMemPoints');
        const pts = Math.floor(memNum(ptsEl?.value));
        const block = memBlockReason();
        const max = memMaxPoints();
        const box = document.getElementById('pmMemRedeemBox');
        const hint = document.getElementById('pmMemHint');
        const sendBtn = document.getElementById('pmMemSendOtp');
        if (block && !_memRedeem) {
            if (ptsEl) { ptsEl.disabled = true; ptsEl.value = ''; }
            if (sendBtn) sendBtn.disabled = true;
            hint.className = 'small text-muted mt-1';
            hint.textContent = block;
        } else {
            if (ptsEl) { ptsEl.disabled = !!_memRedeem; ptsEl.max = String(max); }
            if (sendBtn) sendBtn.disabled = !!_memRedeem || !(pts >= 1 && pts <= max);
            const over = pts > max;
            hint.className = 'small mt-1 ' + (over ? 'text-danger' : 'text-muted');
            hint.innerHTML = `Up to <a href="#" class="pm-mem-max">${max.toLocaleString('en-IN')} points</a> (₹${fmtIN(max * pv)}) on this bill`
                + ` &middot; 1 point = ₹${fmtIN(pv)}` + (memNum(_mem.MaxRedeemPercent) > 0 ? ` &middot; max ${memNum(_mem.MaxRedeemPercent)}% of the bill` : '')
                + (over ? ' &middot; <b>too many points</b>' : '');
            hint.querySelector('.pm-mem-max')?.addEventListener('click', function (e) {
                e.preventDefault(); if (_memRedeem || !ptsEl) return; ptsEl.value = max; renderMemHint();
            });
        }
        document.getElementById('pmMemPointsRs').textContent = '= ₹' + fmtIN((_memRedeem ? _memRedeem.points : pts) * pv);
        box?.classList.toggle('d-none', false);

        // earning: the plan's earn % of the money paid (not of the points), when the bill is fully paid
        const earnPct = memNum(_mem.PointsEarnPercent);
        const earnEl = document.getElementById('pmMemEarn');
        if (earnPct > 0 && pv > 0) {
            const money = Math.max(0, getBillNet() - memPointsValue());
            const earn = Math.floor((money * earnPct / 100) / pv + 0.0001);
            earnEl.innerHTML = earn > 0 ? `<i class="bi bi-stars me-1"></i>This bill earns about <b>${earn.toLocaleString('en-IN')}</b> points (${earnPct}%) once it is fully paid.` : '';
        } else earnEl.textContent = '';
    }

    async function sendMemOtp() {
        if (!_mem || _memRedeem) return;
        hideError();
        const pts = Math.floor(memNum(document.getElementById('pmMemPoints')?.value));
        const max = memMaxPoints();
        const block = memBlockReason();
        if (block) { showError(block); return; }
        if (!(pts >= 1)) { showError('Enter the points to redeem (whole points).'); return; }
        if (pts > max) { showError(`At most ${max} points can be redeemed on this bill.`); return; }
        const btn = document.getElementById('pmMemSendOtp');
        const html = btn.innerHTML;
        btn.disabled = true; btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Sending…';
        try {
            const r = await fetch('/LabOrderBooking/MembershipSendRedeemOtp', {
                method: 'POST', headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ cardId: _mem.CardId, points: pts })
            });
            const d = await r.json().catch(() => null);
            if (!r.ok || !d || !d.success) { showError(d?.message || d?.error || 'Could not send the OTP.'); return; }
            _memRedeem = { points: pts, otpId: d.otpId, value: parseFloat((pts * memNum(_mem.PointValue)).toFixed(2)) };
            const ch = Array.isArray(d.channels) ? d.channels.join(' and ') : (d.channels || '');
            document.getElementById('pmMemOtpInfo').textContent =
                `OTP sent${ch ? ' by ' + ch : ''}${d.sentTo ? ' to ' + d.sentTo : ''}. Valid for ${Math.round((d.expiresInSeconds || 600) / 60)} minutes.`;
            document.getElementById('pmMemOtpBox')?.classList.remove('d-none');
            const otp = document.getElementById('pmMemOtp'); otp.value = ''; otp.focus();
            updateNetAmount(getBillNet());
        } catch (e) {
            showError('Could not send the OTP.');
        } finally {
            btn.innerHTML = html;
            renderMemHint();
        }
    }

    // what the save sends for the points (null = none)
    function currentPointsRedeem() {
        if (!_mem || !_memRedeem) return null;
        return { cardId: _mem.CardId, points: _memRedeem.points, otpId: _memRedeem.otpId,
                 otpCode: (document.getElementById('pmMemOtp')?.value || '').trim() };
    }

    // ─── Membership benefits (B2C LAB, SQLScripts/2241) ─────────────────────────
    // A member's new bill: the plan's benefit rules on tests and Free Home Collection on Home Collection charges. The
    // server works them out again when the bill is saved; a benefit on tests means no manual discount on this bill.
    var _memBen = null;   // { cardNo, planName, testDiscount, miscDiscount, total }
    function memBlocksManual() {
        if (_summary?.hasExistingPayment) return (parseFloat(_summary.membershipTestDiscount) || 0) > 0;
        return !!(_memBen && _memBen.testDiscount > 0);
    }
    async function loadMemberBenefits() {
        _memBen = null;
        (_summary?.items || []).forEach(it => { it.membershipDiscount = 0; it.membershipRule = null; });
        if (!_isPreSave || _moduleCode !== 'LAB' || !_isB2CHint || !((_summary?.patientId || 0) > 0)) return;
        const items = (_summary.items || []).map((it, i) => ({
            key: 'L' + i,
            kind: it.serviceType === 'Misc' ? 'M' : (it.isPackage ? 'P' : 'T'),
            itemId: parseInt(it.lineRefId) || 0,
            price: parseFloat(it.originalAmount) || 0
        }));
        try {
            const r = await fetch('/LabOrderBooking/MembershipBenefitPreview', {
                method: 'POST', headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ patientId: _summary.patientId, items })
            });
            const d = r.ok ? await r.json() : null;
            const b = d && d.data;
            if (!b || !(b.total > 0)) { _memBen = b ? { cardNo: b.cardNo, planName: b.planName, testDiscount: 0, miscDiscount: 0, total: 0 } : null; }
            else {
                _memBen = { cardNo: b.cardNo, planName: b.planName, testDiscount: b.testDiscount, miscDiscount: b.miscDiscount, total: b.total };
                const byKey = Object.fromEntries((b.lines || []).map(l => [l.key, l]));
                (_summary.items || []).forEach((it, i) => {
                    const l = byKey['L' + i];
                    it.membershipDiscount = l ? Math.min(parseFloat(l.discount) || 0, parseFloat(it.originalAmount) || 0) : 0;
                    it.membershipRule = l ? l.rule : null;
                });
            }
        } catch (e) { _memBen = null; }
        if (memBlocksManual()) { document.getElementById('pmDiscValue').value = ''; _deptDisc = null; }
        applyDiscountLock();
        refreshDeptUi();
        recalcDiscount();
    }

    function deptAvailable() {
        return _moduleCode === 'LAB' && _canDiscount && existingBillDiscount() === 0 && !memBlocksManual() && !!_deptHeads && !_deptHeads.isB2B
            && (_deptHeads.heads || []).some(h => h.eligibleAmount > 0);
    }

    async function loadDeptHeads() {
        _deptHeads = null;
        refreshDeptUi();
        if (_moduleCode !== 'LAB' || !_canDiscount || existingBillDiscount() > 0) return;
        let body;
        if (_isPreSave) {
            if (!_isB2CHint) return;
            // misc charges (serviceType 'Misc') are not tests: they never belong to a department head
            body = { items: (_summary.items || []).filter(it => it.serviceType !== 'Misc').map(it => ({ investigationId: parseInt(it.lineRefId) || 0, isPackage: !!it.isPackage, price: parseFloat(it.originalAmount) || 0 })) };
        } else {
            body = { labOrderId: _summary?.moduleRefId ?? _moduleRefId };
        }
        try {
            const r = await fetch('/LabOrderBooking/DiscountHeads', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
            if (r.ok) _deptHeads = await r.json();
        } catch (e) { _deptHeads = null; }
        refreshDeptUi();
    }

    // discount of every line (same order as _deptHeads.lines) for the given rows
    function deptCompute(rows) {
        const lines = _deptHeads?.lines || [];
        const per = lines.map(() => 0);
        (rows || []).forEach(r => {
            const v = parseFloat(r.value) || 0;
            if (v <= 0) return;
            const idx = lines.map((l, i) => i).filter(i => lines[i].eligible && lines[i].price > 0 && lines[i].groupKey === r.key);
            if (!idx.length) return;
            if (r.type === 'P') {
                idx.forEach(i => per[i] = round2(lines[i].price * Math.min(v, 100) / 100));
            } else {
                const tot = idx.reduce((sum, i) => sum + lines[i].price, 0);
                const amt = Math.min(v, tot);
                let alloc = 0;
                idx.forEach((i, k) => {
                    const share = k === idx.length - 1 ? Math.max(0, round2(amt - alloc)) : round2(amt * lines[i].price / tot);
                    alloc = round2(alloc + share);
                    per[i] = Math.min(share, lines[i].price);
                });
            }
        });
        return { per, total: round2(per.reduce((sum, a) => sum + a, 0)) };
    }

    // the applied department discount of one bill line of the dialog (matched by order line, then by test)
    function deptLineDiscount(item, itemIndex) {
        if (!_deptDisc || !_deptHeads) return 0;
        if (item.serviceType === 'Misc' || (parseInt(item.lineRefId) || 0) < 0) return 0;   // a misc charge takes no department discount
        const lines = _deptHeads.lines || [];
        let k = _isPreSave ? lines.findIndex(l => l.index === itemIndex) : -1;
        if (k < 0) k = lines.findIndex(l => l.labOrderItemId > 0 && l.labOrderItemId === parseInt(item.lineRefId));
        if (k < 0) k = lines.findIndex(l => l.investigationId === parseInt(item.lineRefId));
        return k >= 0 ? (_deptDisc.per[k] || 0) : 0;
    }

    function setOverallDiscountEnabled(on) {
        const allow = on && _canDiscount && existingBillDiscount() === 0 && !memBlocksManual();
        ['pmDiscTypeP', 'pmDiscTypeF', 'pmDiscValue'].forEach(id => { const el = document.getElementById(id); if (el) el.disabled = !allow; });
        document.getElementById('pmDiscQuick')?.classList.toggle('d-none', !allow);
    }

    function refreshDeptUi() {
        const wrap = document.getElementById('pmDeptDiscWrap');
        const sum = document.getElementById('pmDeptDiscSummary');
        if (!wrap || !sum) return;
        if (_deptDisc) {
            wrap.classList.add('d-none');
            sum.innerHTML = `<div class="pm-dept-sum"><span class="fw-semibold"><i class="bi bi-diagram-3 me-1"></i>Department-wise:</span>` +
                _deptDisc.rows.map(r => `<span class="pm-dept-chip">${esc(r.name)} ${r.type === 'P' ? Number(r.value) + '%' : '₹' + fmtIN(r.value)} · −₹${fmtIN(r.amount)}</span>`).join('') +
                `<span class="ms-auto d-flex gap-1"><button type="button" class="btn btn-sm btn-outline-primary py-0" id="pmDeptEdit"><i class="bi bi-pencil me-1"></i>Edit</button>` +
                `<button type="button" class="btn btn-sm btn-outline-danger py-0" id="pmDeptRemove"><i class="bi bi-x me-1"></i>Remove</button></span></div>`;
            sum.classList.remove('d-none');
            setOverallDiscountEnabled(false);
        } else {
            sum.classList.add('d-none'); sum.innerHTML = '';
            wrap.classList.toggle('d-none', !deptAvailable());
            setOverallDiscountEnabled(true);
        }
    }

    function openDeptPopup() {
        if (!deptAvailable()) return;
        const applied = Object.fromEntries((_deptDisc?.rows || []).map(r => [r.key, r]));
        _deptDraft = (_deptHeads.heads || []).map(h => ({
            key: h.key, name: h.name, tests: h.tests, eligible: h.eligibleAmount, nonEligible: h.nonEligibleAmount,
            type: applied[h.key]?.type || 'P', value: applied[h.key]?.value ?? ''
        }));
        renderDeptRows();
        document.getElementById('pmDeptMsg').classList.add('d-none');
        document.getElementById('pmDeptPopup').classList.remove('d-none');
        setTimeout(() => document.querySelector('#pmDeptRows input:not([disabled])')?.focus(), 50);
    }
    function closeDeptPopup() { document.getElementById('pmDeptPopup').classList.add('d-none'); _deptDraft = null; }

    function renderDeptRows() {
        document.getElementById('pmDeptRows').innerHTML = _deptDraft.map((r, i) => {
            const off = !(r.eligible > 0);
            return `<tr data-i="${i}">
                <td><div class="fw-semibold">${r.key === 'PKG' ? '<i class="bi bi-box-seam me-1 text-secondary"></i>' : ''}${esc(r.name)}</div>
                    <div class="pm-dept-nd">${r.tests} item${r.tests === 1 ? '' : 's'}${r.nonEligible > 0 ? ' · ₹' + fmtIN(r.nonEligible) + ' not discountable' : ''}</div></td>
                <td class="text-end amt">₹${fmtIN(r.eligible)}</td>
                <td class="text-center"><div class="btn-group pm-dept-type" role="group">
                    <button type="button" class="btn ${r.type === 'P' ? 'btn-secondary' : 'btn-outline-secondary'}" data-type="P" ${off ? 'disabled' : ''}>%</button>
                    <button type="button" class="btn ${r.type === 'F' ? 'btn-secondary' : 'btn-outline-secondary'}" data-type="F" ${off ? 'disabled' : ''}>₹</button></div></td>
                <td><input type="number" class="form-control form-control-sm pm-dept-val" min="0" step="0.01" ${r.type === 'P' ? 'max="100"' : ''}
                           value="${r.value === '' ? '' : r.value}" placeholder="${off ? 'not discountable' : (r.type === 'P' ? '%' : '₹')}" ${off ? 'disabled' : ''} /></td>
                <td class="text-end amt text-danger pm-dept-amt">—</td>
                <td class="text-end amt fw-semibold pm-dept-net">—</td></tr>`;
        }).join('');
        updateDeptTotals();
    }

    function updateDeptTotals() {
        const { per } = deptCompute(_deptDraft);
        const lines = _deptHeads.lines || [];
        let total = 0, bad = '';
        _deptDraft.forEach((r, i) => {
            const amt = round2(lines.reduce((sum, l, k) => sum + (l.groupKey === r.key ? per[k] : 0), 0));
            total = round2(total + amt);
            const tr = document.querySelector(`#pmDeptRows tr[data-i="${i}"]`);
            if (!tr) return;
            tr.querySelector('.pm-dept-amt').textContent = amt > 0 ? '−₹' + fmtIN(amt) : '—';
            tr.querySelector('.pm-dept-net').textContent = '₹' + fmtIN(r.eligible + r.nonEligible - amt);
            const v = parseFloat(r.value) || 0;
            if (r.type === 'P' && v > 100) bad = `${r.name}: a % discount cannot be more than 100%.`;
            if (r.type === 'F' && v > r.eligible + 0.001) bad = bad || `${r.name}: at most ₹${fmtIN(r.eligible)} can be discounted.`;
        });
        document.getElementById('pmDeptTotal').textContent = '₹' + fmtIN(total);
        const msg = document.getElementById('pmDeptMsg');
        msg.textContent = bad; msg.classList.toggle('d-none', !bad);
        return total;
    }

    function applyDeptPopup() {
        const total = updateDeptTotals();
        const msg = document.getElementById('pmDeptMsg');
        if (_deptDraft.some(r => r.type === 'P' && (parseFloat(r.value) || 0) > 100)) return;
        if (!(total > 0)) { msg.textContent = 'Enter a discount for at least one department.'; msg.classList.remove('d-none'); return; }
        const { per } = deptCompute(_deptDraft);
        const lines = _deptHeads.lines || [];
        const rows = _deptDraft.filter(r => (parseFloat(r.value) || 0) > 0).map(r => ({
            key: r.key, name: r.name, type: r.type,
            value: r.type === 'F' ? Math.min(parseFloat(r.value), r.eligible) : parseFloat(r.value),
            amount: round2(lines.reduce((sum, l, k) => sum + (l.groupKey === r.key ? per[k] : 0), 0))
        })).filter(r => r.amount > 0);
        _deptDisc = { rows, total, per };
        document.getElementById('pmDiscValue').value = '';   // the overall discount is replaced
        closeDeptPopup();
        refreshDeptUi();
        recalcDiscount();
    }

    function removeDeptDiscount() { _deptDisc = null; refreshDeptUi(); recalcDiscount(); }

    // what the save request carries for the discount
    function currentDiscType() { return _deptDisc ? 'D' : (document.querySelector('input[name="pmDiscType"]:checked')?.value ?? null); }
    function currentDiscValue() { return _deptDisc ? _deptDisc.total : (parseFloat(document.getElementById('pmDiscValue').value) || 0); }
    function currentDeptDiscounts() { return _deptDisc ? _deptDisc.rows.map(r => ({ groupKey: r.key, type: r.type, value: r.value })) : null; }

    // ─── Discount recalc (calculation unchanged) ──────────────────────────────
    function recalcDiscount() {
        const type  = document.querySelector('input[name="pmDiscType"]:checked')?.value;
        const discSym = document.getElementById('pmDiscSymbol');
        if (discSym) discSym.textContent = type === 'F' ? '₹' : '%';

        const raw   = parseFloat(document.getElementById('pmDiscValue').value) || 0;
        const base  = _summary.hasExistingPayment ? _summary.balanceDue : _summary.subTotal;

        // Calculate discountable vs non-discountable base
        let discountableBase = 0;
        let nonDiscountableBase = 0;
        let hasRestrictions = false;

        if (_summary.items && _summary.items.length > 0) {
            _summary.items.forEach(it => {
                let amt = parseFloat(it.originalAmount) || 0;
                let isAllowed = it.isDiscountAllowed !== false && !(it.membershipDiscount > 0);   // a line with a membership benefit takes no manual share
                if (!isAllowed) hasRestrictions = true;
                if (isAllowed) discountableBase += amt;
                else nonDiscountableBase += amt;
            });
        } else {
            discountableBase = base;
        }

        // a saved bill (due collection): the discount is taken on the balance due, at most on the bill's discountable
        // amount - the same rule the server applies (PaymentService.SavePaymentAsync)
        let effectiveBase = _summary.hasExistingPayment
            ? Math.min(base, hasRestrictions ? discountableBase : base)
            : (hasRestrictions ? discountableBase : base);

        // Eligibility line: only when some items cannot be discounted
        const rowEligible = document.getElementById('pmDiscEligibilityRow');
        const elEligible = document.getElementById('pmDiscEligibleAmt');
        const elNonEligible = document.getElementById('pmDiscNonEligibleAmt');
        const elWarning = document.getElementById('pmDiscWarning');
        const setWarn = (msg) => { if (!elWarning) return; elWarning.textContent = msg || ''; elWarning.classList.toggle('d-none', !msg); };

        if (rowEligible) {
            rowEligible.classList.toggle('d-none', !hasRestrictions);
            if (hasRestrictions) {
                if (elEligible) elEligible.textContent = '₹' + fmtIN(discountableBase);
                if (elNonEligible) elNonEligible.textContent = `(Non-discountable: ₹${fmtIN(nonDiscountableBase)})`;
            }
        }

        let discAmt = 0;
        if (effectiveBase <= 0) {
            discAmt = 0;
            setWarn(raw > 0 ? 'No discount allowed on selected items.' : '');
        } else {
            if (type === 'P') {
                discAmt = Math.min(effectiveBase, effectiveBase * raw / 100);
                setWarn('');
            } else if (type === 'F') {
                setWarn(raw > effectiveBase ? `Max discountable is ₹${fmtIN(effectiveBase)}.` : '');
                discAmt = Math.min(effectiveBase, raw);
            }
        }
        if (_deptDisc) { discAmt = _deptDisc.total; setWarn(''); }   // department-wise replaces the overall discount
        discAmt = parseFloat(discAmt.toFixed(2));
        _discAmt = discAmt;
        document.getElementById('pmDiscAmt').textContent = '₹' + fmtIN(discAmt);
        document.getElementById('pmTotDisc').textContent = '−₹' + fmtIN(discAmt);
        document.getElementById('pmTotDiscRow').classList.toggle('d-none', !(discAmt > 0));
        document.querySelectorAll('#pmDiscQuick button[data-pct]').forEach(b => {
            const pct = parseFloat(b.dataset.pct) || 0;
            b.classList.toggle('active', pct > 0 && type === 'P' && Math.abs(raw - pct) < 0.0001);
        });
        renderDiscApprovalInfo(discAmt);

        let totalCgst = 0;
        let totalSgst = 0;

        if (!_summary.hasExistingPayment && _summary.items) {
            // Allocate discount among eligible items
            let eligibleItems = _deptDisc ? [] : _summary.items.filter(it => it.isDiscountAllowed !== false && !(it.membershipDiscount > 0));
            if (_deptDisc) {
                _summary.items.forEach((item, i) => {
                    item.lineDiscountAmount = deptLineDiscount(item, i);
                    item.netLineAmount = Math.max(0, item.originalAmount - item.lineDiscountAmount);
                });
            }
            let runningAlloc = 0;
            eligibleItems.forEach((item, idx) => {
                if (idx === eligibleItems.length - 1) {
                    item.lineDiscountAmount = parseFloat(Math.max(0, discAmt - runningAlloc).toFixed(2));
                } else {
                    let prop = effectiveBase > 0 ? (item.originalAmount / effectiveBase) : 0;
                    item.lineDiscountAmount = parseFloat((discAmt * prop).toFixed(2));
                    runningAlloc += item.lineDiscountAmount;
                }
                item.netLineAmount = Math.max(0, item.originalAmount - item.lineDiscountAmount);
            });

            _summary.items.filter(it => !_deptDisc && (it.isDiscountAllowed === false || it.membershipDiscount > 0)).forEach(item => {
                item.lineDiscountAmount = 0;
                item.netLineAmount = item.originalAmount;
            });
            // membership benefit on its lines (before GST)
            _summary.items.filter(it => it.membershipDiscount > 0).forEach(item => {
                item.lineDiscountAmount = Math.min(item.originalAmount, (item.lineDiscountAmount || 0) + item.membershipDiscount);
                item.netLineAmount = Math.max(0, item.originalAmount - item.lineDiscountAmount);
            });

            _summary.items.forEach(item => {
                item.cgstAmount = 0;
                item.sgstAmount = 0;
                item.igstAmount = 0;

                if (item.isGstRequired && item.gstPercentage) {
                    // CGST = SGST = ROUND(net x % / 200, 2) - exactly as the server (PaymentService / LabMiscCharges)
                    const half = Math.round((item.netLineAmount * item.gstPercentage / 200 + Number.EPSILON) * 100) / 100;
                    item.cgstAmount = half;
                    item.sgstAmount = half;
                    totalCgst += item.cgstAmount;
                    totalSgst += item.sgstAmount;
                }
            });
        } else if (_summary.hasExistingPayment && _summary.items) {
            _summary.items.forEach(item => {
                totalCgst += (item.cgstAmount || 0);
                totalSgst += (item.sgstAmount || 0);
            });
        }
        renderItems(hasRestrictions);

        let totalTax = totalCgst + totalSgst;
        let elTax = document.getElementById('pmTotalTax');
        if (elTax) elTax.textContent = '₹' + fmtIN(totalTax);
        document.getElementById('pmTaxRow').classList.toggle('d-none', !(totalTax > 0));

        // membership benefit (new bill): its own row; a saved bill's balance already has it
        const memTotal = _summary.hasExistingPayment ? 0 : (_summary.items || []).reduce((t, it) => t + (it.membershipDiscount || 0), 0);
        const memRow = document.getElementById('pmMemDiscRow');
        if (memRow) {
            memRow.classList.toggle('d-none', !(memTotal > 0));
            document.getElementById('pmMemDisc').textContent = '−₹' + fmtIN(memTotal);
            document.getElementById('pmMemDiscLabel').textContent = 'Membership discount' + (_memBen?.cardNo ? ` (${_memBen.cardNo})` : '')
                + (_memBen && _memBen.miscDiscount > 0 ? ' · free home collection' : '');
        }
        let unroundedNet = Math.max(0, base - discAmt - memTotal + totalTax);
        let roundedNet = Math.round(unroundedNet);
        let roundOff = parseFloat((roundedNet - unroundedNet).toFixed(2));

        _roundOffAmount = roundOff;
        _roundedNetAmount = roundedNet;

        let roundOffRow = document.getElementById('pmRoundOffRow');
        let roundOffEl = document.getElementById('pmRoundOffAmt');
        if (roundOffRow && roundOffEl) {
            roundOffRow.classList.toggle('d-none', roundOff === 0);
            roundOffEl.textContent = roundOff === 0 ? '₹0.00' : (roundOff > 0 ? '+₹' : '−₹') + fmtIN(Math.abs(roundOff));
        }

        updateNetAmount(roundedNet);
    }

    // Bill lines: item + type, MRP, discount, net; GST columns only when an item carries GST
    function renderItems(hasRestrictions) {
        const items = _summary.items || [];
        const hasGst = items.some(it => (it.cgstAmount || 0) > 0 || (it.sgstAmount || 0) > 0 || (it.isGstRequired && it.gstPercentage));
        const showNet = !_summary.hasExistingPayment;
        document.getElementById('pmItemsHead').innerHTML = `<tr><th>Item</th><th class="text-end">MRP</th>` +
            (showNet ? '<th class="text-end">Disc.</th>' : '') +
            (hasGst ? '<th class="text-end">CGST</th><th class="text-end">SGST</th>' : '') +
            (showNet ? '<th class="text-end">Net</th>' : '') + '</tr>';
        const cols = 2 + (showNet ? 2 : 0) + (hasGst ? 2 : 0);
        document.getElementById('pmSubTotalLabel').colSpan = cols - 1;

        document.getElementById('pmLineItemsTbody').innerHTML = items.map(item => {
            const nd = item.isDiscountAllowed === false;
            const lineDisc = item.lineDiscountAmount || 0;
            return `<tr>
                <td><div class="fw-semibold text-dark">${esc(item.itemName)}</div>
                    <div class="text-muted" style="font-size:.7rem">${esc(item.serviceType ?? '')}${nd && hasRestrictions ? ' <span class="pm-badge-nd ms-1"><i class="bi bi-slash-circle me-1"></i>No discount</span>' : ''}${item.membershipRule ? ` <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle ms-1"><i class="bi bi-award me-1"></i>${esc(item.membershipRule)}</span>` : ''}</div></td>
                <td class="text-end amt">₹${fmtIN(item.originalAmount)}</td>` +
                (showNet ? `<td class="text-end amt ${lineDisc > 0 ? 'text-danger' : 'text-muted'}">${lineDisc > 0 ? '−₹' + fmtIN(lineDisc) : '—'}</td>` : '') +
                (hasGst ? `<td class="text-end amt text-muted">${(item.cgstAmount || 0) > 0 ? '₹' + fmtIN(item.cgstAmount) : '—'}</td>
                           <td class="text-end amt text-muted">${(item.sgstAmount || 0) > 0 ? '₹' + fmtIN(item.sgstAmount) : '—'}</td>` : '') +
                (showNet ? `<td class="text-end amt fw-semibold">₹${fmtIN(item.netLineAmount ?? item.originalAmount)}</td>` : '') +
                `</tr>`;
        }).join('');
    }

    function updateNetAmount(net) {
        document.getElementById('pmNetAmount').textContent = '₹' + fmtIN(net);
        renderMemHint();
        net = getNetAmount();   // what is collected in money (membership points pay the rest)
        document.getElementById('pmDueNow').textContent = '₹' + fmtIN(net);

        // Hide payment controls if nothing to pay
        const section = document.getElementById('pmPaymentMethodsSection');
        if (section) section.style.display = net > 0 ? '' : 'none';
        document.getElementById('pmNothingToPay')?.classList.toggle('d-none', net > 0);

        // If only one payment line exists, always sync its amount to the net payable
        var allAmtFields = document.querySelectorAll('.pm-paid-amount');
        if (allAmtFields.length === 1) {
            allAmtFields[0].value = fmt(net);
            updateChange(allAmtFields[0].closest('.pm-method-row'));
        }
        recalcTotal();
    }

    // the bill (after discount / round-off) ...
    function getBillNet() {
        return _roundedNetAmount > 0 ? _roundedNetAmount : 0;
    }
    // ... and what is collected in money now: the bill less any membership points being redeemed
    function memPointsValue() { return _memRedeem ? Number(_memRedeem.value) || 0 : 0; }
    function getNetAmount() {
        return Math.max(0, parseFloat((getBillNet() - memPointsValue()).toFixed(2)));
    }

    // ─── Payment lines: mode cards + amount + mode-specific fields ─────────────
    // The payment screen always opens on Cash; a split line takes the next mode not used yet
    function defaultMethodId(excludeIds) {
        const ok = m => !excludeIds.includes(String(m.paymentMethodId));
        const cash = _methods.find(m => String(m.methodCode).toUpperCase() === 'CASH' && ok(m));
        if (cash) return String(cash.paymentMethodId);
        const first = _methods.find(ok);
        return first ? String(first.paymentMethodId) : '';
    }

    function addMethodRow() {
        const idx = _rowIdx++;
        const container = document.getElementById('pmMethodRows');
        const div = document.createElement('div');
        div.className = 'pm-line pm-method-row';
        div.dataset.idx = idx;

        // hidden select keeps the method id and what each method requires
        const opts = _methods.map(m =>
            `<option value="${m.paymentMethodId}" data-code="${esc(m.methodCode)}"
              data-ref="${m.requiresRef?1:0}"
              data-cheque="${m.requiresChequeNo?1:0}"
              data-bank="${m.requiresBankName?1:0}"
              data-upi="${m.requiresUPIRef?1:0}"
              data-card="${m.requiresCardLast4?1:0}">${esc(m.methodName)}</option>`
        ).join('');
        const tiles = _methods.map(m => {
            const s = modeStyle(m.methodCode);
            return `<div class="pm-tile" role="radio" tabindex="0" aria-checked="false" data-id="${m.paymentMethodId}"
                         style="--c:${s.c};--cb:${s.cb}" title="${esc(m.methodName)}"><i class="bi ${s.i}"></i><span>${esc(m.methodName)}</span></div>`;
        }).join('');

        div.innerHTML = `
          ${idx > 0 ? `<div class="d-flex justify-content-between align-items-center mb-2"><span class="pm-lbl mb-0">Payment ${document.querySelectorAll('.pm-method-row').length + 1}</span>
                         <button type="button" class="btn btn-sm btn-link text-danger text-decoration-none p-0 pm-remove-row" data-idx="${idx}"><i class="bi bi-trash3 me-1"></i>Remove</button></div>` : ''}
          <select class="d-none pm-method-select" data-idx="${idx}" aria-hidden="true"><option value="">— Select —</option>${opts}</select>
          <div class="pm-tiles" role="radiogroup" aria-label="Payment mode">${tiles}</div>
          <div class="row g-2 mt-2 align-items-end">
            <div class="col-7">
              <div class="pm-lbl">Amount</div>
              <div class="input-group">
                <span class="input-group-text">₹</span>
                <input type="number" class="form-control pm-paid-amount pm-amount-input" min="0" step="0.01" placeholder="0.00" data-idx="${idx}" />
              </div>
            </div>
            <div class="col-5 d-grid">
              <button type="button" class="btn btn-outline-primary pm-full-due" title="Fill the remaining amount"><i class="bi bi-arrow-repeat me-1"></i>Full due</button>
            </div>
          </div>
          <div class="row g-2 mt-1 pm-cash-box" data-idx="${idx}" style="display:none">
            <div class="col-7">
              <div class="pm-lbl">Cash received <span class="text-muted text-lowercase fw-normal">(optional)</span></div>
              <div class="input-group input-group-sm"><span class="input-group-text">₹</span>
                <input type="number" class="form-control pm-cash-received" min="0" step="0.01" placeholder="e.g. 500" /></div>
            </div>
            <div class="col-5 d-flex align-items-end"><div class="pm-change w-100 text-end"></div></div>
          </div>
          <div class="row g-2 mt-1 pm-cond-fields" data-idx="${idx}" style="display:none"></div>`;

        container.appendChild(div);

        const select = div.querySelector('.pm-method-select');
        const pick = (id) => {
            select.value = id || '';
            div.querySelectorAll('.pm-tile').forEach(t => {
                const on = String(t.dataset.id) === String(id);
                t.classList.toggle('active', on);
                t.setAttribute('aria-checked', on ? 'true' : 'false');
            });
            renderConditionalFields(select, idx);
            updateChange(div);
        };
        div.querySelectorAll('.pm-tile').forEach(t => {
            t.addEventListener('click', () => pick(t.dataset.id));
            t.addEventListener('keydown', e => { if (e.key === ' ' || e.key === 'Enter') { e.preventDefault(); e.stopPropagation(); pick(t.dataset.id); } });
        });
        div.querySelector('.pm-paid-amount')?.addEventListener('input', function () { updateChange(div); recalcTotal(); });
        div.querySelector('.pm-cash-received')?.addEventListener('input', function () { updateChange(div); });
        div.querySelector('.pm-full-due')?.addEventListener('click', function () {
            const others = [...document.querySelectorAll('.pm-method-row')].filter(r => r !== div)
                .reduce((sum, r) => sum + (parseFloat(r.querySelector('.pm-paid-amount')?.value) || 0), 0);
            div.querySelector('.pm-paid-amount').value = fmt(Math.max(0, getNetAmount() - others));
            updateChange(div); recalcTotal();
        });
        div.querySelector('.pm-remove-row')?.addEventListener('click', function () {
            div.remove();
            // If only one line remains after removal, sync it to the full net amount
            var remaining = document.querySelectorAll('.pm-paid-amount');
            if (remaining.length === 1) remaining[0].value = fmt(getNetAmount());
            document.querySelectorAll('.pm-method-row').forEach(r => updateChange(r));
            recalcTotal();
        });

        // Auto-fill: first line gets full net; further lines get what's still unpaid
        var net = getNetAmount();
        var othersFilled = [...document.querySelectorAll('.pm-paid-amount')]
            .reduce((sum, el) => sum + (parseFloat(el.value) || 0), 0);
        div.querySelector('.pm-paid-amount').value = fmt(Math.max(0, net - othersFilled));

        // Pre-select a mode: Cash; a split line takes a different mode
        const used = [...document.querySelectorAll('.pm-method-select')].filter(s => s !== select).map(s => String(s.value)).filter(Boolean);
        pick(defaultMethodId(used));
        recalcTotal();
    }

    // Cash: received vs amount → change to return (on screen only; the saved amount is the line amount)
    function updateChange(row) {
        if (!row) return;
        const sel = row.querySelector('.pm-method-select');
        const code = sel?.options[sel.selectedIndex]?.dataset.code || '';
        const box = row.querySelector('.pm-cash-box');
        const isCash = String(code).toUpperCase() === 'CASH';
        if (box) box.style.display = isCash ? '' : 'none';
        if (!isCash) return;
        const amt = parseFloat(row.querySelector('.pm-paid-amount')?.value) || 0;
        const rec = parseFloat(row.querySelector('.pm-cash-received')?.value);
        const out = row.querySelector('.pm-change');
        if (!out) return;
        if (isNaN(rec) || rec <= 0) { out.innerHTML = ''; return; }
        const change = rec - amt;
        out.innerHTML = change >= 0
            ? `<span class="text-muted">Change to return</span><div class="fw-bold text-success fs-6 amt">₹${fmtIN(change)}</div>`
            : `<span class="text-danger fw-semibold">₹${fmtIN(-change)} short</span>`;
    }

    function renderConditionalFields(select, idx) {
        const opt = select.options[select.selectedIndex];
        const condRow = document.querySelector(`.pm-cond-fields[data-idx="${idx}"]`);
        if (!condRow) return;
        condRow.innerHTML = '';
        if (!opt || !opt.value) { condRow.style.display = 'none'; return; }
        const needRef   = opt.dataset.ref   === '1';
        const needCheq  = opt.dataset.cheque === '1';
        const needBank  = opt.dataset.bank   === '1';
        const needUpi   = opt.dataset.upi    === '1';
        const needCard  = opt.dataset.card   === '1';

        if (needUpi)   condRow.appendChild(field(idx, 'upiRefNo', 'UPI UTR / VPA', 'text'));
        if (needCard)  condRow.appendChild(field(idx, 'cardLast4', 'Card Last 4', 'text', 4));
        if (needRef)   condRow.appendChild(field(idx, 'transactionRef', 'Transaction Ref', 'text'));
        if (needCheq)  condRow.appendChild(field(idx, 'chequeNo', 'Cheque No', 'text'));
        if (needBank)  condRow.appendChild(field(idx, 'bankName', 'Bank Name', 'text'));

        const hasAny = needRef || needCheq || needBank || needUpi || needCard;
        condRow.style.display = hasAny ? '' : 'none';
    }

    function field(idx, name, label, type, maxLen) {
        const col = document.createElement('div');
        col.className = 'col-6';
        col.innerHTML = `<div class="pm-lbl">${label}</div>
          <input type="${type}" class="form-control form-control-sm pm-cond-input"
                 data-idx="${idx}" data-field="${name}" placeholder="${label}"
                 ${maxLen ? `maxlength="${maxLen}"` : ''} />`;
        return col;
    }

    function recalcTotal() {
        const total = [...document.querySelectorAll('.pm-paid-amount')]
            .reduce((sum, el) => sum + (parseFloat(el.value) || 0), 0);
        const net = getNetAmount();
        const totalEl = document.getElementById('pmEnteringTotal');
        if (totalEl) {
            totalEl.textContent = '₹' + fmtIN(total);
            totalEl.classList.toggle('text-danger', total > net + 0.001);
            totalEl.classList.toggle('text-primary', !(total > net + 0.001));
        }

        // live status of this collection
        const st = document.getElementById('pmStatus');
        if (st) {
            let cls, html;
            if (total > net + 0.001) { cls = 'over'; html = `<i class="bi bi-exclamation-octagon-fill"></i>₹${fmtIN(total - net)} more than the payable ₹${fmtIN(net)}`; }
            else if (net > 0 && Math.abs(total - net) <= 0.001) { cls = 'full'; html = '<i class="bi bi-check-circle-fill"></i>Fully paid'; }
            else if (total > 0) { cls = 'partial'; html = `<i class="bi bi-hourglass-split"></i>Partial payment &middot; balance ₹${fmtIN(net - total)} stays due`; }
            else { cls = 'none'; html = '<i class="bi bi-info-circle"></i>Enter an amount, or use Pay later'; }
            st.innerHTML = `<div class="pm-status ${cls}">${html}</div>`;
        }

        // the main button says what will happen
        const label = document.getElementById('pmCollectLabel');
        if (label) label.textContent = net > 0 ? (total > 0 ? `Collect ₹${fmtIN(total)}` : 'Collect payment') : 'Save';

        const saveBtn = document.getElementById('btnSavePayment');
        if (saveBtn && !_isSubmitting) {
            if (total > net + 0.001) {
                saveBtn.disabled = true;
                saveBtn.title = 'Paid amount cannot exceed payable amount of ₹' + fmtIN(net);
            } else {
                saveBtn.disabled = false;
                saveBtn.removeAttribute('title');
            }
        }
    }

    // ─── Save ─────────────────────────────────────────────────────────────────
    async function savePayment() {
        if (_isSubmitting) return;

        const btn = document.getElementById('btnSavePayment');
        const originalBtnHtml = btn.innerHTML;
        hideError();

        try {
            const discType  = currentDiscType();
            const discVal   = currentDiscValue();
            const discAmt   = _discAmt;
            const net       = getNetAmount();

            const pointsRedeem = currentPointsRedeem();
            if (pointsRedeem && !/^\d{4,8}$/.test(pointsRedeem.otpCode)) {
                showError('Enter the OTP sent to the card holder to redeem the points, or remove the points.');
                document.getElementById('pmMemOtp')?.focus();
                return;
            }
            const memEntered = Math.floor(memNum(document.getElementById('pmMemPoints')?.value));
            if (!pointsRedeem && _mem && memEntered > 0) {
                showError('Send the OTP for the points entered, or clear the points.');
                return;
            }

            const approval = await ensureDiscountApproval(discAmt);
            if (!approval) return;   // approval incomplete: the fields are highlighted

            const payments = [];
            let missingMode = false;
            if (net > 0) {
                document.querySelectorAll('.pm-method-row').forEach(row => {
                    const sel    = row.querySelector('.pm-method-select');
                    const amt    = parseFloat(row.querySelector('.pm-paid-amount')?.value) || 0;
                    const mId    = parseInt(sel?.value) || 0;
                    if (amt > 0 && !mId) missingMode = true;
                    if (!mId || amt <= 0) return;

                    const extra = {};
                    row.querySelectorAll('.pm-cond-input').forEach(inp => {
                        extra[inp.dataset.field] = inp.value || null;
                    });
                    payments.push({ paymentMethodId: mId, paidAmount: amt, ...extra });
                });

                if (missingMode) {
                    showError('Choose a payment mode for every amount entered.');
                    return;
                }
                if (!payments.length) {
                    showError('Please enter at least one payment method and amount.');
                    return;
                }

                const totalEntering = payments.reduce((sum, p) => sum + (parseFloat(p.paidAmount) || 0), 0);
                if (totalEntering > net + 0.001) {
                    showError(`Total paid amount (₹${fmtIN(totalEntering)}) cannot exceed the payable amount of ₹${fmtIN(net)}.`);
                    return;
                }
            }

            _isSubmitting = true;
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Saving…';

            const lineItems = (_summary.items || []).map(li => ({
                moduleLineRefId: li.lineRefId,
                itemDescription: li.itemName,
                serviceType: li.serviceType,
                originalAmount: li.originalAmount,
                lineDiscountType: discType,
                lineDiscountValue: 0,
                lineDiscountAmount: Math.max(0, (li.lineDiscountAmount || 0) - (li.membershipDiscount || 0)),   // the membership part is worked out by the server
                netLineAmount: li.netLineAmount || li.originalAmount,
                isDiscountAllowed: li.isDiscountAllowed !== false,
                isGstRequired: li.isGstRequired || false,
                gstPercentage: li.gstPercentage || 0,
                cgstAmount: li.cgstAmount || 0,
                sgstAmount: li.sgstAmount || 0,
                igstAmount: li.igstAmount || 0
            }));

            let roundedNet = _roundedNetAmount > 0 ? _roundedNetAmount : getBillNet();
            let roundOff = _roundOffAmount;

            const payload = {
                moduleCode:           _moduleCode,
                moduleRefId:          _summary?.moduleRefId ?? _moduleRefId,
                opdServiceId:         _summary?.opdServiceId ?? _moduleRefId,
                patientId:            _summary?.patientId ?? 0,
                branchId:             _summary?.branchId ?? 0,
                subTotal:             _summary?.subTotal ?? 0,
                headerDiscountType:   discType,
                headerDiscountValue:  discVal,
                headerDiscountAmount: discAmt,
                departmentDiscounts:  currentDeptDiscounts(),
                discountReason:       approval.reason,
                discountApprovedBy:   approval.approvedBy,
                roundOffAmount:       roundOff,
                netAmount:            roundedNet,
                // double-payment guard (payment on a saved bill): what the bill had received when this screen opened;
                // the server refuses the payment if another one was saved meanwhile. A booking's first payment is not checked.
                expectedTotalPaid:    _isPreSave ? null : expectedPaidForGuard(),
                pointsRedeem,
                payments,
                lineItems
            };

            if (_isPreSave) {
                if (typeof _onSave === 'function') {
                    try {
                        await _onSave(payload);
                    } catch (err) {
                        btn.disabled = false;
                        btn.innerHTML = originalBtnHtml;
                        _isSubmitting = false;
                        showError(err.message || 'Failed to save booking');
                    }
                }
                return;
            }

            const res  = await fetch('/OPD/SavePayment', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });
            const data = await res.json();

            if (!data.success) {
                showError(data.error || 'Failed to save payment.');
                btn.disabled = false;
                btn.innerHTML = originalBtnHtml;
                _isSubmitting = false;
                return;
            }

            pmModal.hide();
            btn.disabled = false;
            btn.innerHTML = originalBtnHtml;
            _isSubmitting = false;

            // ── If full payment → assign the token number into the success modal ──
            if (data.paymentStatus === 'P' && data.tokenNo) {
                const tokenEl  = document.getElementById('successTokenNo');
                const tokenBox = document.getElementById('successTokenBox');
                if (tokenEl) {
                    // Replace the "Pending Payment" content with the real token
                    tokenEl.innerHTML = '';
                    tokenEl.className = 'fw-bold text-success mb-0 font-monospace';
                    tokenEl.style.fontSize = '';
                    tokenEl.textContent = data.tokenNo;
                }
                if (tokenBox) {
                    tokenBox.classList.remove('alert-warning');
                    tokenBox.classList.add('alert-success');
                }
            }

            // Due collection (the bill was already saved with a balance) → offer the A5 Money Receipt before the page moves on
            if (!_isPreSave && _summary?.hasExistingPayment && data.receiptNo) {
                await offerMoneyReceipt(data);
            }

            if (typeof _onSuccess === 'function') {
                _onSuccess(data);
            } else {
                var sm = document.getElementById(_successModal);
                if (sm) new bootstrap.Modal(sm).show();
            }
        } catch (err) {
            showError(err.message || 'Failed to process payment.');
            btn.disabled = false;
            btn.innerHTML = originalBtnHtml;
            _isSubmitting = false;
        }
    }

    // Double-payment guard: what the bill had received (its receipts) when this screen opened. Only sent when the
    // summary carries that figure - without it the server's other checks (lock, over-payment) still apply.
    function expectedPaidForGuard() {
        if (!_summary?.hasExistingPayment) return 0;
        const v = _summary.paidFromReceipts;
        return (v === null || v === undefined || v === '' || isNaN(Number(v))) ? null : Number(v);
    }

    // Money Receipt of a due collection (MoneyReceipt/Print, SQLScripts/2204). The tab is opened from the button's own
    // click so the browser does not block it. Never throws: the payment is already saved.
    async function offerMoneyReceipt(data) {
        const url = '/MoneyReceipt/Print?receiptNo=' + encodeURIComponent(data.receiptNo);
        const openIt = () => { window.open(url, '_blank'); };
        try {
            if (typeof Swal === 'undefined') {
                if (confirm('Payment collected. Receipt ' + data.receiptNo + '.\n\nPrint the Money Receipt now?')) openIt();
                return;
            }
            const balance = Number(data.balanceDue) || 0;
            await Swal.fire({
                icon: 'success',
                title: 'Payment collected',
                html: `<div class="text-center">
                           <div class="text-muted small">Receipt No</div>
                           <div class="fw-bold font-monospace fs-5 text-primary">${esc(data.receiptNo)}</div>
                           <div class="small mt-1 ${balance > 0 ? 'text-danger' : 'text-success'}">
                               ${balance > 0 ? 'Balance still due: ₹' + fmtIN(balance) : 'Bill fully paid'}
                           </div>
                       </div>`,
                showCancelButton: true,
                confirmButtonText: '<i class="bi bi-printer me-1"></i> Print Money Receipt',
                cancelButtonText: 'Done',
                confirmButtonColor: '#1e3a8a',
                cancelButtonColor: '#6c757d',
                reverseButtons: true,
                focusConfirm: true,
                allowOutsideClick: false,
                preConfirm: () => { openIt(); return true; }
            });
        } catch (e) { /* the receipt can be reprinted later; never hold up the page */ }
    }

    // One clear error banner inside the dialog
    function showError(msg) {
        if (!pmError) { if (typeof Swal !== 'undefined') Swal.fire({ icon: 'error', title: 'Payment Error', text: msg }); return; }
        pmError.innerHTML = `<i class="bi bi-exclamation-octagon-fill mt-1"></i><span>${esc(msg)}</span>`;
        pmError.classList.remove('d-none');
        pmError.scrollIntoView({ behavior: 'smooth', block: 'center' });
        clearTimeout(showError._t);
        showError._t = setTimeout(() => pmError?.classList.add('d-none'), 10000);
    }
    function hideError() { pmError?.classList.add('d-none'); }
    function showLoadError(msg) {
        const el = document.getElementById('pmLoadError');
        if (!el) return;
        el.innerHTML = `<i class="bi bi-exclamation-octagon-fill me-2"></i>${esc(msg)}`;
        el.classList.remove('d-none');
    }

    // ─── Helpers ──────────────────────────────────────────────────────────────
    function fmt(n)  { return (parseFloat(n) || 0).toFixed(2); }                       // values written into inputs
    function fmtIN(n) { return (parseFloat(n) || 0).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }); }  // display
    function esc(s)  { const d = document.createElement('div'); d.textContent = s ?? ''; return d.innerHTML; }

    function resetDialog() {
        pmLoader.classList.remove('d-none');
        pmError.classList.add('d-none');
        document.getElementById('pmLoadError')?.classList.add('d-none');
        pmForm.classList.add('d-none');
        pmFooter.style.display = 'none';
        document.getElementById('pmMethodRows').innerHTML = '';
        document.getElementById('pmDiscValue').value = '';
        document.getElementById('pmDiscAmt').textContent = '₹0.00';
        document.querySelectorAll('input[name="pmDiscType"]').forEach(function (r) { r.checked = r.value === 'P'; });
        // fresh approval box for this bill
        _approvalBoxReady = false;
        const ta = document.getElementById('pmDiscReason'); if (ta) { ta.value = ''; ta.classList.remove('is-invalid'); }
        const ap = document.getElementById('pmDiscApprover'); if (ap) ap.classList.remove('is-invalid');
        document.getElementById('pmDiscApprovalBox')?.classList.add('d-none');
        document.getElementById('pmDiscApprovalInfo')?.classList.add('d-none');
        _discAmt = 0; _roundedNetAmount = 0; _roundOffAmount = 0; _isSubmitting = false;
        _deptDisc = null; _deptHeads = null; _deptDraft = null;
        _mem = null; _memRedeem = null; _memBen = null;
        document.getElementById('pmMemPanel')?.classList.add('d-none');
        document.getElementById('pmDeptPopup')?.classList.add('d-none');
        document.getElementById('pmDeptDiscWrap')?.classList.add('d-none');
        document.getElementById('pmDeptDiscSummary')?.classList.add('d-none');
        const btn = document.getElementById('btnSavePayment');
        if (btn) { btn.disabled = false; btn.innerHTML = '<i class="bi bi-check2-circle me-2"></i><span id="pmCollectLabel">Save Payment</span>'; }
    }

    // ─── Public API (unchanged) ───────────────────────────────────────────────
    // Trigger this payment modal for any service from other JS contexts
    window.pmOpenFor = function (svcId, onSuccessCb, moduleCode) {
        _isPreSave = false;
        _isB2CHint = false;   // an existing bill: the server says whether it is B2C
        _summary = null; _methods = []; _rowIdx = 0; _discApproval = null;
        _moduleRefId = svcId;
        if (moduleCode) {
            _moduleCode = moduleCode;
        }
        _onSuccess   = onSuccessCb || null;
        _onCancel    = null;
        _onSkip      = null;
        _onSave      = null;
        resetDialog();
        fetchData();
        pmModal.show();
    };

    window.pmOpenPreSave = function (config) {
        _isPreSave = true;
        _discApproval = null;
        _summary = {
            patientName: config.patientName,
            patientCode: config.patientCode,
            patientPhone: config.patientPhone,
            patientId: parseInt(config.patientId) || 0,
            opdBillNo: '—',
            tokenNo: '—',
            subTotal: config.subTotal,
            totalPaid: 0,
            balanceDue: config.subTotal,
            hasExistingPayment: false,
            items: config.items || []
        };
        _moduleCode = config.moduleCode || 'LAB';
        _isB2CHint  = config.isB2C === true;
        _onSave     = config.onSave;
        _onSkip     = config.onSkip || config.onSave;
        _onCancel   = config.onCancel;
        _onSuccess  = config.onSuccess;

        resetDialog();

        fetch('/OPD/GetPaymentMethods')
            .then(res => res.json())
            .then(methods => {
                _methods = methods;
                renderForm();
                pmModal.show();
            })
            .catch(err => {
                pmLoader.classList.add('d-none');
                showLoadError(err.message || 'Failed to load payment methods');
                pmModal.show();
            });
    };
})();
}); // DOMContentLoaded
</script>
