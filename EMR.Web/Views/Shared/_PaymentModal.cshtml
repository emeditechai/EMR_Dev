@inject EMR.Shared.Security.IActionPermissionGuard PermissionGuard
@*
    _PaymentModal.cshtml  –  Reusable payment collection modal (OPD and LAB).
    Include in any view via:  <partial name="_PaymentModal" />

    Required ViewData (set BEFORE the <partial> tag in the calling view):
      "PaymentModuleCode"     → string  e.g. "OPD"
      "PaymentModuleRefId"    → int     the bill/service primary key
      "PaymentSuccessModalId" → string  id of the success modal to open after save/skip

    Public API (unchanged): window.pmOpenFor(svcId, onSuccess, moduleCode) for an existing bill,
    window.pmOpenPreSave(config) while booking. The payload sent to /OPD/SavePayment or to onSave / onSkip is
    unchanged; only the layout and flow of the dialog were redesigned (two panels, payment-mode cards, inline
    discount approval, split payment, cash change helper).

    Bootstrap 5 JS is loaded by _Layout – no extra script needed.
    Script is inline (NOT in @section Scripts which is invalid in partials).
*@
@{
    string pmCode    = ViewData["PaymentModuleCode"]     as string ?? "OPD";
    int    pmRefId   = (int)(ViewData["PaymentModuleRefId"] ?? 0);
    string pmSuccess = ViewData["PaymentSuccessModalId"] as string ?? "bookingSuccessModal";

    // Giving a discount is its own control on the billing screen (Settings > Security > DISCOUNT).
    var pmScreen = EMR.Web.Services.DiscountPermission.ScreenFor(
        ViewContext.RouteData.Values["controller"]?.ToString(), ViewContext.RouteData.Values["action"]?.ToString());
    bool pmCanDiscount = pmScreen is null
        || await PermissionGuard.ShowsAsync(Context, pmScreen, EMR.Shared.Security.PermissionControls.Discount);
}

<style>
