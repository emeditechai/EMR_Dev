#paymentModal .pm-pane { padding:16px 20px; }
#paymentModal .pm-left { background:var(--pm-soft); border-right:1px solid var(--pm-line); }
#paymentModal .pm-sec { font-size:.66rem; font-weight:700; letter-spacing:.6px; text-transform:uppercase; color:var(--pm-muted); margin-bottom:8px; }
#paymentModal .pm-items { background:#fff; border:1px solid var(--pm-line); border-radius:10px; overflow:hidden; }
#paymentModal .pm-items table { margin:0; font-size:.8rem; }
#paymentModal .pm-items thead th { background:#f1f5f9; color:var(--pm-muted); font-size:.64rem; font-weight:700; letter-spacing:.4px; text-transform:uppercase;
                                   border-bottom:1px solid var(--pm-line); padding:6px 10px; white-space:nowrap; }
#paymentModal .pm-items td { padding:7px 10px; vertical-align:top; border-color:#eef2f6; }
#paymentModal .pm-items tfoot td { background:#f8fafc; font-weight:700; }
#paymentModal .amt { font-variant-numeric:tabular-nums; white-space:nowrap; }
#paymentModal .pm-card { background:#fff; border:1px solid var(--pm-line); border-radius:10px; padding:12px 14px; }
#paymentModal .pm-quick .btn { font-size:.72rem; padding:2px 9px; border-radius:999px; }
#paymentModal .pm-totals .row-t { display:flex; justify-content:space-between; align-items:center; font-size:.82rem; padding:3px 0; color:#334155; }
#paymentModal .pm-totals .row-net { border-top:1px dashed #cbd5e1; margin-top:6px; padding-top:8px; }
#paymentModal .pm-net { font-size:1.45rem; font-weight:800; color:var(--pm-brand); }
#paymentModal .pm-due-card { border-radius:12px; padding:12px 16px; background:linear-gradient(135deg,#eff6ff,#f5f3ff); border:1px solid #dbeafe; }
#paymentModal .pm-due-amt { font-size:1.6rem; font-weight:800; color:var(--pm-ink); line-height:1.1; }
#paymentModal .pm-line { border:1px solid var(--pm-line); border-radius:12px; padding:12px; background:#fff; }
#paymentModal .pm-line + .pm-line { margin-top:10px; }
#paymentModal .pm-tiles { display:grid; grid-template-columns:repeat(auto-fill,minmax(88px,1fr)); gap:8px; }
#paymentModal .pm-tile { --c:#475569; --cb:#f1f5f9; border:1.5px solid var(--pm-line); background:#fff; border-radius:10px; padding:8px 6px 7px;
                         display:flex; flex-direction:column; align-items:center; gap:3px; cursor:pointer; transition:.12s; font-size:.72rem;
                         font-weight:600; color:#334155; text-align:center; line-height:1.15; user-select:none; }
#paymentModal .pm-tile i { font-size:1.15rem; color:var(--c); }
#paymentModal .pm-tile:hover { border-color:var(--c); background:var(--cb); }
#paymentModal .pm-tile.active { border-color:var(--c); background:var(--cb); color:var(--pm-ink); box-shadow:0 0 0 3px color-mix(in srgb, var(--c) 18%, transparent); }
#paymentModal .pm-tile.active::after { content:'\2713'; position:absolute; }
