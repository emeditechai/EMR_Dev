#paymentModal .pm-tiles { display:grid; grid-template-columns:repeat(auto-fill,minmax(88px,1fr)); gap:8px; }
#paymentModal .pm-tile { --c:#475569; --cb:#f1f5f9; border:1.5px solid var(--pm-line); background:#fff; border-radius:10px; padding:8px 6px 7px;
                         display:flex; flex-direction:column; align-items:center; gap:3px; cursor:pointer; transition:.12s; font-size:.72rem;
                         font-weight:600; color:#334155; text-align:center; line-height:1.15; user-select:none; }
#paymentModal .pm-tile i { font-size:1.15rem; color:var(--c); }
