#paymentModal .pm-amount-input { font-size:1.05rem; font-weight:700; font-variant-numeric:tabular-nums; }
#paymentModal .pm-change { font-size:.8rem; }
#paymentModal .pm-status { display:flex; align-items:center; gap:8px; border-radius:10px; padding:8px 12px; font-size:.8rem; font-weight:600; }
#paymentModal .pm-status.full { background:#dcfce7; color:#166534; }
#paymentModal .pm-status.partial { background:#fef3c7; color:#92400e; }
#paymentModal .pm-status.none { background:#f1f5f9; color:#475569; }
