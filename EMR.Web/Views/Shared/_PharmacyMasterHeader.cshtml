@model EMR.Web.Services.PhHeader
@* Pharmacy pages (masters and transactions): the same header everywhere - title, description and count tiles. *@
<div class="ph-head mb-3 d-flex flex-wrap justify-content-between align-items-center gap-3">
    <div>
        <nav aria-label="breadcrumb"><ol class="breadcrumb mb-1 small"><li class="breadcrumb-item">@Model.Section</li><li class="breadcrumb-item">@Model.Group</li>
            @if (Model.Crumb != null) { <li class="breadcrumb-item"><a href="@Model.ListUrl">@Model.Title</a></li><li class="breadcrumb-item active text-white">@Model.Crumb</li> }
            else { <li class="breadcrumb-item active text-white">@Model.Title</li> }
        </ol></nav>
        <h1 class="mb-1 fw-bold"><i class="bi @Model.Icon me-2"></i>@(Model.Heading ?? Model.Title)</h1>
        <div class="small" style="max-width:760px;opacity:.9">@Model.Description</div>
    </div>
    @if (Model.Stats != null)
    {
        <div class="d-flex flex-wrap gap-2">
            @foreach (var s in Model.Stats) { <div class="ph-stat"><b>@s.Value</b><span>@s.Key</span></div> }
        </div>
    }
    else if (Model.Total != null)
    {
        <div class="d-flex gap-2">
            <div class="ph-stat"><b>@Model.Total</b><span>Total</span></div>
            @if (Model.Active != null) { <div class="ph-stat"><b>@Model.Active</b><span>Active</span></div><div class="ph-stat"><b>@(Model.Total - Model.Active)</b><span>Inactive</span></div> }
        </div>
    }
</div>
