@model EMR.Web.Models.ViewModels.ShiftMasterListItemViewModel
@{
    ViewData["Title"] = "Shift Details";
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h1 class="h3 mb-0 fw-bold">@Model.ShiftName</h1>
        <small class="text-muted">Shift Code: <span class="font-monospace fw-bold">@Model.ShiftCode</span> | Scoped Branch: <span class="fw-semibold text-dark">@(Model.BranchName ?? "Main Branch")</span></small>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.ShiftMaster_ID" class="btn btn-primary btn-sm px-3 shadow-sm">
            <i class="bi bi-pencil me-1"></i> Edit Shift
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm px-3">
            <i class="bi bi-arrow-left me-1"></i> Back to List
        </a>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm rounded-3 mb-4">
            <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
                <h6 class="mb-0 fw-bold text-primary"><i class="bi bi-clock-history me-2"></i>Shift Configuration</h6>
                <div>
                    @if (Model.Status)
                    {
                        <span class="badge text-bg-success px-3 py-2">Active</span>
                    }
                    else
                    {
                        <span class="badge text-bg-secondary px-3 py-2">Inactive</span>
                    }
                </div>
            </div>
            <div class="card-body p-4">
                <div class="row g-4">
                    <div class="col-sm-6">
                        <label class="text-muted small fw-semibold">Shift Code</label>
                        <div>
                            <span class="badge bg-light text-dark border font-monospace fs-6">
                                @Model.ShiftCode
                            </span>
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <label class="text-muted small fw-semibold">Shift Category</label>
                        <div>
                            @if (Model.IsNightShift)
                            {
                                <span class="badge bg-purple bg-opacity-10 text-purple border border-purple border-opacity-25 fs-6 px-3 py-1">
                                    <i class="bi bi-moon-stars-fill me-1"></i>Night / Cross-Midnight Shift
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-warning bg-opacity-10 text-dark border border-warning border-opacity-25 fs-6 px-3 py-1">
                                    <i class="bi bi-sun-fill me-1 text-warning"></i>Standard Day Shift
                                </span>
                            }
                        </div>
                    </div>
                    <div class="col-12">
                        <label class="text-muted small fw-semibold">Shift Name / Description</label>
                        <div class="fs-5 fw-bold text-dark">@Model.ShiftName</div>
                    </div>

                    <div class="col-sm-6">
                        <div class="p-3 bg-light rounded-3 border">
                            <label class="text-muted small fw-semibold d-block">Shift Hours</label>
                            <div class="fs-4 fw-bold text-primary font-monospace">
                                @Model.FormattedTimeRange
                            </div>
                            <small class="text-muted">Start: @Model.StartTime.ToString(@"hh\:mm") | End: @Model.EndTime.ToString(@"hh\:mm")</small>
                        </div>
                    </div>

                    <div class="col-sm-6">
                        <div class="p-3 bg-light rounded-3 border">
                            <label class="text-muted small fw-semibold d-block">Grace & Break Duration</label>
                            <div class="fs-4 fw-bold text-dark font-monospace">
                                @Model.GraceTimeMinutes m <span class="fs-6 fw-normal text-muted">/ @Model.BreakDurationMinutes m break</span>
                            </div>
                            <small class="text-muted">Late punch grace allowance</small>
                        </div>
                    </div>

                    <div class="col-12">
                        <label class="text-muted small fw-semibold">Housekeeping Staff Currently Assigned</label>
                        <div>
                            <span class="badge bg-info bg-opacity-10 text-dark border border-info border-opacity-25 fs-6 px-3 py-2">
                                <i class="bi bi-people me-1"></i>@Model.AssignedStaffCount Active Personnel
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-header bg-white border-bottom py-3">
                <h6 class="mb-0 fw-bold text-primary"><i class="bi bi-clock me-2"></i>Audit Details</h6>
            </div>
            <div class="card-body p-3">
                <ul class="list-group list-group-flush small">
                    <li class="list-group-item px-0 py-2 border-0 d-flex justify-content-between">
                        <span class="text-muted">Shift ID:</span>
                        <span class="fw-bold font-monospace">#@Model.ShiftMaster_ID</span>
                    </li>
                    <li class="list-group-item px-0 py-2 border-0 d-flex justify-content-between">
                        <span class="text-muted">Created On:</span>
                        <span class="fw-medium">@Model.CreatedDate.ToString("dd MMM yyyy, hh:mm tt")</span>
                    </li>
                    @if (Model.ModifiedDate.HasValue)
                    {
                        <li class="list-group-item px-0 py-2 border-0 d-flex justify-content-between">
                            <span class="text-muted">Last Modified:</span>
                            <span class="fw-medium">@Model.ModifiedDate.Value.ToString("dd MMM yyyy, hh:mm tt")</span>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </div>
</div>
