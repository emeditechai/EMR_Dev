@model EMR.Web.Models.ViewModels.ShiftMasterIndexViewModel
@{
    ViewData["Title"] = "Shift Master";
    var total = Model.ShiftList.Count;
    var active = Model.ShiftList.Count(x => x.Status);
    var nightShifts = Model.ShiftList.Count(x => x.IsNightShift);
    var totalStaffAssigned = Model.ShiftList.Sum(x => x.AssignedStaffCount);
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h1 class="h3 mb-0 fw-bold">Shift Master</h1>
        <small class="text-muted">Manage hospital operational work shifts, timings, grace period, and break durations</small>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Create" class="btn btn-primary shadow-sm">
            <i class="bi bi-plus-lg me-1"></i>Add Shift
        </a>
    </div>
</div>

<!-- Stat Cards -->
<div class="row g-3 mb-4">
    <div class="col-12 col-sm-6 col-lg-3">
        <div class="stat-card stat-blue">
            <div class="stat-icon"><i class="bi bi-clock-history"></i></div>
            <div>
                <div class="stat-value">@total</div>
                <div class="stat-label">Total Defined Shifts</div>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-lg-3">
        <div class="stat-card stat-green">
            <div class="stat-icon"><i class="bi bi-check-circle-fill"></i></div>
            <div>
                <div class="stat-value">@active</div>
                <div class="stat-label">Active Shifts</div>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-lg-3">
        <div class="stat-card stat-purple">
            <div class="stat-icon"><i class="bi bi-moon-stars-fill"></i></div>
            <div>
                <div class="stat-value">@nightShifts</div>
                <div class="stat-label">Night / Overnight Shifts</div>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-lg-3">
        <div class="stat-card stat-cyan">
            <div class="stat-icon"><i class="bi bi-people-fill"></i></div>
            <div>
                <div class="stat-value">@totalStaffAssigned</div>
                <div class="stat-label">Total Assigned Staff</div>
            </div>
        </div>
    </div>
</div>

<!-- Filter Bar -->
<div class="card border-0 shadow-sm rounded-3 mb-4">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-auto">
                <label class="form-label mb-0 fw-semibold text-muted small"><i class="bi bi-funnel me-1"></i>Filters:</label>
            </div>
            <div class="col-md-3">
                <select name="status" class="form-select form-select-sm" onchange="this.form.submit()">
                    <option value="">-- All Status --</option>
                    @foreach (var opt in Model.StatusOptions)
                    {
                        <option value="@opt.Value" selected="@opt.Selected">@opt.Text</option>
                    }
                </select>
            </div>
            <div class="col-md-6">
                <div class="input-group input-group-sm">
                    <input type="text" name="search" class="form-control" placeholder="Search by shift code or shift name..." value="@Model.SearchTerm" />
                    <button class="btn btn-outline-primary" type="submit"><i class="bi bi-search"></i> Search</button>
                </div>
            </div>
            @if (Model.SelectedStatus.HasValue || !string.IsNullOrWhiteSpace(Model.SearchTerm))
            {
                <div class="col-auto">
                    <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Clear</a>
                </div>
            }
        </form>
    </div>
</div>

<!-- Data Table -->
<div class="dashboard-panel table-responsive shadow-sm border rounded-3 bg-white">
    <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
            <tr>
                <th style="width: 40px;">#</th>
                <th>Shift Code</th>
                <th>Shift Name / Description</th>
                <th>Operational Timing</th>
                <th>Grace & Breaks</th>
                <th>Type</th>
                <th>Allocated Staff</th>
                <th>Status</th>
                <th class="text-end" style="width: 150px;">Actions</th>
            </tr>
        </thead>
        <tbody>
            @{int i = 1;}
            @foreach (var item in Model.ShiftList)
            {
                <tr>
                    <td class="text-muted small">@(i++)</td>
                    <td>
                        <span class="badge bg-light text-dark border font-monospace fw-bold">
                            @item.ShiftCode
                        </span>
                    </td>
                    <td>
                        <div class="fw-semibold text-dark">@item.ShiftName</div>
                    </td>
                    <td>
                        <div class="fw-bold text-primary font-monospace">
                            <i class="bi bi-clock me-1 text-muted"></i>@item.FormattedTimeRange
                        </div>
                    </td>
                    <td>
                        <div class="small text-muted">
                            <span><i class="bi bi-hourglass-split me-1 text-warning"></i>Grace: @item.GraceTimeMinutes m</span>
                            <span class="mx-1">•</span>
                            <span><i class="bi bi-cup-hot me-1 text-info"></i>Break: @item.BreakDurationMinutes m</span>
                        </div>
                    </td>
                    <td>
                        @if (item.IsNightShift)
                        {
                            <span class="badge bg-purple bg-opacity-10 text-purple border border-purple border-opacity-25">
                                <i class="bi bi-moon-stars-fill me-1"></i>Night Shift
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-warning bg-opacity-10 text-dark border border-warning border-opacity-25">
                                <i class="bi bi-sun-fill me-1 text-warning"></i>Day Shift
                            </span>
                        }
                    </td>
                    <td>
                        <span class="badge bg-light text-dark border">
                            <i class="bi bi-people me-1"></i>@item.AssignedStaffCount Staff
                        </span>
                    </td>
                    <td>
                        @if (item.Status)
                        {
                            <span class="badge text-bg-success">Active</span>
                        }
                        else
                        {
                            <span class="badge text-bg-secondary">Inactive</span>
                        }
                    </td>
                    <td class="text-end">
                        <a asp-action="Details" asp-route-id="@item.ShiftMaster_ID"
                           class="btn btn-sm btn-outline-secondary me-1" title="View Details">
                            <i class="bi bi-eye"></i>
                        </a>
                        <a asp-action="Edit" asp-route-id="@item.ShiftMaster_ID"
                           class="btn btn-sm btn-outline-primary me-1" title="Edit">
                            <i class="bi bi-pencil"></i>
                        </a>
                        <form asp-action="Delete" asp-route-id="@item.ShiftMaster_ID" method="post" class="d-inline"
                              onsubmit="return confirm('Are you sure you want to delete @item.ShiftName?');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete">
                                <i class="bi bi-trash"></i>
                            </button>
                        </form>
                    </td>
                </tr>
            }
            @if (!Model.ShiftList.Any())
            {
                <tr>
                    <td colspan="9" class="text-center text-muted py-5">
                        <i class="bi bi-clock-history fs-1 d-block mb-2 opacity-50"></i>
                        No Shifts found. <a asp-action="Create" class="fw-bold">Create your first Shift.</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
