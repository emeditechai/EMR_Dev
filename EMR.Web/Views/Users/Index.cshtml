@model EMR.Web.Models.ViewModels.UserListPageViewModel
@{
    ViewData["Title"] = "User Master";
    // one page of users from the server (SQLScripts/2314); the KPI cards count every user this login may see
    var users = Model.Items;
    var total = Model.TotalUsers;
    var active = Model.ActiveUsers;
    var inactive = Model.InactiveUsers;
    var pathologists = Model.Pathologists;
    var signed = Model.PathologistsSigned;
    var labTechs = Model.LabTechnicians;
    var firstRow = Model.FilteredCount == 0 ? 0 : (Model.Page - 1) * Model.PageSize + 1;
    var lastRow = Math.Min(Model.Page * Model.PageSize, Model.FilteredCount);
    // links keep the filter
    string PageUrl(int p, int? size = null) => Url.Action("Index", new { search = Model.Search, userType = Model.UserType, status = Model.Status, role = Model.Role, page = p, pageSize = size ?? Model.PageSize })!;
    var avatarColors = new[] { "#2563eb", "#7c3aed", "#0d9488", "#d97706", "#db2777", "#0891b2" };
}

<style>
    .um-avatar { width: 40px; height: 40px; border-radius: 50%; flex-shrink: 0; display: inline-flex; align-items: center; justify-content: center; color: #fff; font-weight: 700; font-size: .85rem; object-fit: cover; box-shadow: 0 1px 3px rgba(15,23,42,.18); }
    .um-name { font-weight: 600; color: #0f172a; line-height: 1.2; }
    .um-sub { font-size: .76rem; color: #64748b; }
    .um-role { font-size: .7rem; font-weight: 600; border: 1px solid transparent; }
    .um-chip { display: inline-flex; align-items: center; gap: .25rem; font-size: .74rem; background: #f1f5f9; color: #334155; border: 1px solid #e2e8f0; border-radius: 1rem; padding: .1rem .55rem; margin: 0 .2rem .2rem 0; white-space: nowrap; }
    .um-table thead th { background: #f8fafc; font-size: .72rem; text-transform: uppercase; letter-spacing: .05em; color: #64748b; font-weight: 700; border-bottom: 1px solid #e2e8f0; white-space: nowrap; }
    .um-table tbody tr { transition: background .12s; }
    .um-table tbody tr.um-inactive td { opacity: .62; }
    .um-table tbody tr.um-inactive td:last-child { opacity: 1; }
    .um-kpi { border: 0; border-left: 4px solid var(--k); border-radius: .75rem; }
    .um-kpi .um-kpi-icon { width: 46px; height: 46px; border-radius: .75rem; background: var(--kb); color: var(--k); display: flex; align-items: center; justify-content: center; font-size: 1.35rem; }
    .um-kpi .um-kpi-num { font-size: 1.75rem; font-weight: 800; line-height: 1; color: var(--k); }
    .um-pager .page-link { min-width: 2.25rem; text-align: center; }
    .um-loading { opacity: .55; pointer-events: none; transition: opacity .15s; }
</style>

<div class="container-fluid px-4 py-3">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                    <li class="breadcrumb-item text-muted">Settings</li>
                    <li class="breadcrumb-item active" aria-current="page">User Master</li>
                </ol>
            </nav>
            <h4 class="fw-bold mb-0 text-primary"><i class="bi bi-people-fill me-2"></i>User Master</h4>
            @if (ViewBag.BranchName is string bn)
            {
                <div class="text-muted small mt-1"><i class="bi bi-building me-1"></i>Branch: <strong class="text-dark">@bn</strong></div>
            }
        </div>
        <a asp-permission="SETTINGS.USERS:ADD" asp-action="Create" class="btn btn-primary px-3 shadow-sm"><i class="bi bi-person-plus-fill me-1"></i> Add User</a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- KPI cards -->
    <div class="row g-3 mb-4">
        <div class="col-xl col-md-4 col-6">
            <div class="card shadow-sm um-kpi h-100" style="--k:#2563eb;--kb:#dbeafe;"><div class="card-body p-3 d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small fw-semibold text-uppercase d-block mb-1">Total Users</span>
                    <div class="um-kpi-num">@total</div>
                </div>
                <div class="um-kpi-icon"><i class="bi bi-people-fill"></i></div>
            </div></div>
        </div>
        <div class="col-xl col-md-4 col-6">
            <div class="card shadow-sm um-kpi h-100" style="--k:#16a34a;--kb:#dcfce7;"><div class="card-body p-3 d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small fw-semibold text-uppercase d-block mb-1">Active</span>
                    <div class="um-kpi-num">@active</div>
                </div>
                <div class="um-kpi-icon"><i class="bi bi-person-check-fill"></i></div>
            </div></div>
        </div>
        <div class="col-xl col-md-4 col-6">
            <div class="card shadow-sm um-kpi h-100" style="--k:#dc2626;--kb:#fee2e2;"><div class="card-body p-3 d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small fw-semibold text-uppercase d-block mb-1">Inactive</span>
                    <div class="um-kpi-num">@inactive</div>
                </div>
                <div class="um-kpi-icon"><i class="bi bi-person-x-fill"></i></div>
            </div></div>
        </div>
        <div class="col-xl col-md-6 col-6">
            <div class="card shadow-sm um-kpi h-100" style="--k:#7c3aed;--kb:#ede9fe;"><div class="card-body p-3 d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small fw-semibold text-uppercase d-block mb-1">Pathologists</span>
                    <div class="um-kpi-num">@pathologists</div>
                    <span class="badge mt-1" style="background:#ede9fe;color:#5b21b6;">@signed with signature</span>
                </div>
                <div class="um-kpi-icon"><i class="bi bi-file-earmark-medical-fill"></i></div>
            </div></div>
        </div>
        <div class="col-xl col-md-6 col-6">
            <div class="card shadow-sm um-kpi h-100" style="--k:#0d9488;--kb:#ccfbf1;"><div class="card-body p-3 d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small fw-semibold text-uppercase d-block mb-1">Lab Technicians</span>
                    <div class="um-kpi-num">@labTechs</div>
                </div>
                <div class="um-kpi-icon"><i class="bi bi-eyedropper"></i></div>
            </div></div>
        </div>
    </div>

    <!-- Filters (applied on the server: the lists drop-downs apply at once, the search after a short pause) -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-3">
            <form method="get" asp-action="Index" id="umFilter" class="row g-3 align-items-end">
                <input type="hidden" name="pageSize" value="@Model.PageSize" />
                <div class="col-md-3">
                    <label class="form-label small fw-semibold text-muted mb-1">Search</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
                        <input type="text" id="umSearch" name="search" value="@Model.Search" class="form-control border-start-0" placeholder="Name, username, email, employee code, department or branch..." autocomplete="off" />
                    </div>
                </div>
                <div class="col-md-2 col-6">
                    <label class="form-label small fw-semibold text-muted mb-1">User Type</label>
                    <select id="umType" name="userType" class="form-select">
                        @foreach (var (v, t) in new[] { ("", "All types"), ("U", "General user"), ("D", "Doctor"), ("F", "Franchise"), ("C", "Company") })
                        {
                            <option value="@v" selected="@((Model.UserType ?? "") == v)">@t</option>
                        }
                    </select>
                </div>
                <div class="col-md-2 col-6">
                    <label class="form-label small fw-semibold text-muted mb-1">Status</label>
                    <select id="umStatus" name="status" class="form-select">
                        @foreach (var (v, t) in new[] { ("", "All statuses"), ("active", "Active"), ("inactive", "Inactive") })
                        {
                            <option value="@v" selected="@((Model.Status ?? "") == v)">@t</option>
                        }
                    </select>
                </div>
                <div class="col-md-3 col-6">
                    <label class="form-label small fw-semibold text-muted mb-1">Role / Designation</label>
                    <select id="umRole" name="role" class="form-select">
                        @foreach (var (v, t) in new[] { ("", "All roles"), ("nurse", "Nurse"), ("phlebotomist", "Phlebotomist"), ("pathologist", "Pathologist"), ("labtech", "Lab Technician"), ("logistics", "Logistics Boy") })
                        {
                            <option value="@v" selected="@((Model.Role ?? "") == v)">@t</option>
                        }
                    </select>
                </div>
                <div class="col-md-2 d-flex gap-2">
                    <a href="@Url.Action("Index", new { pageSize = Model.PageSize })" id="umReset" class="btn btn-outline-secondary w-100"><i class="bi bi-arrow-counterclockwise me-1"></i>Reset</a>
                </div>
            </form>
        </div>
    </div>

    <!-- Users table -->
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
            <span class="fw-bold text-dark"><i class="bi bi-list-ul text-primary me-2"></i>Users</span>
            <span class="text-muted small" id="umCount">
                @if (Model.FilteredCount == 0)
                {
                    <text>No users</text>
                }
                else
                {
                    <text>Showing <strong>@firstRow&ndash;@lastRow</strong> of <strong>@Model.FilteredCount</strong>@(Model.HasFilter ? $" matching (of {total})" : "")</text>
                }
            </span>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 um-table" id="umTable">
                    <thead>
                        <tr>
                            <th class="ps-4">User</th>
                            <th>Roles</th>
                            <th>Email</th>
                            <th>Department(s)</th>
                            <th>Branches</th>
                            <th class="text-center">Status</th>
                            <th class="text-end pe-4" style="width:120px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in users)
                        {
                            var initials = string.Concat((item.FullName ?? item.Username).Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(w => char.ToUpperInvariant(w[0])));
                            if (string.IsNullOrEmpty(initials)) { initials = "?"; }
                            var color = avatarColors[item.Id % avatarColors.Length];
                            var roles = new List<string>();
                            if (item.IsNursingStaff) { roles.Add("nurse"); }
                            if (item.IsPhlebotomist) { roles.Add("phlebotomist"); }
                            if (item.IsPathologist) { roles.Add("pathologist"); }
                            if (item.IsLabTechnician) { roles.Add("labtech"); }
                            if (item.IsLogisticsBoy) { roles.Add("logistics"); }
                            var depts = (item.DepartmentNames ?? string.Empty).Split(", ", StringSplitOptions.RemoveEmptyEntries);
                            var branches = (item.Branches ?? string.Empty).Split(", ", StringSplitOptions.RemoveEmptyEntries);

                            <tr class="@(item.IsActive ? "" : "um-inactive")">
                                <td class="ps-4">
                                    <div class="d-flex align-items-center gap-3">
                                        @if (!string.IsNullOrWhiteSpace(item.ProfilePicturePath))
                                        {
                                            <img class="um-avatar" src="@item.ProfilePicturePath" alt="@item.FullName" />
                                        }
                                        else
                                        {
                                            <span class="um-avatar" style="background:@color">@initials</span>
                                        }
                                        <div style="min-width:0;">
                                            <div class="um-name">@item.FullName</div>
                                            <div class="um-sub">
                                                <span class="font-monospace">@item.Username</span>
                                                @if (!string.IsNullOrWhiteSpace(item.EmployeeCode))
                                                {
                                                    <span class="mx-1">&middot;</span><span class="font-monospace">@item.EmployeeCode</span>
                                                }
                                            </div>
                                            <div class="mt-1">
                                                <partial name="_UserTypeBadge" model="@(new EMR.Web.Models.ViewModels.UserTypeBadgeModel(item.UserType, item.ReferenceUserId, item.ReferenceName))" />
                                            </div>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div class="d-flex flex-wrap gap-1">
                                        @if (item.IsNursingStaff)
                                        {
                                            <span class="badge um-role" style="background:#dbeafe;color:#1d4ed8;border-color:#bfdbfe;"><i class="bi bi-heart-pulse-fill me-1"></i>Nurse</span>
                                        }
                                        @if (item.IsPhlebotomist)
                                        {
                                            <span class="badge um-role" style="background:#fee2e2;color:#b91c1c;border-color:#fecaca;"><i class="bi bi-droplet-fill me-1"></i>Phlebotomist</span>
                                        }
                                        @if (item.IsPathologist)
                                        {
                                            <span class="badge um-role" style="background:#f3e8ff;color:#6b21a8;border-color:#d8b4fe;"><i class="bi bi-file-earmark-medical-fill me-1"></i>Pathologist</span>
                                            if (item.HasSignature)
                                            {
                                                <span class="badge um-role" style="background:#ede9fe;color:#5b21b6;border-color:#ddd6fe;" title="Signature uploaded"><i class="bi bi-pen-fill me-1"></i>Signed</span>
                                            }
                                            else
                                            {
                                                <span class="badge um-role" style="background:#fff7ed;color:#c2410c;border-color:#fed7aa;" title="No signature uploaded yet"><i class="bi bi-pen me-1"></i>No signature</span>
                                            }
                                        }
                                        @if (item.IsLabTechnician)
                                        {
                                            <span class="badge um-role" style="background:#ccfbf1;color:#0f766e;border-color:#99f6e4;"><i class="bi bi-eyedropper me-1"></i>Lab Tech</span>
                                        }
                                        @if (item.IsLogisticsBoy)
                                        {
                                            <span class="badge um-role" style="background:#fef3c7;color:#92400e;border-color:#fde68a;"><i class="bi bi-truck me-1"></i>Logistics</span>
                                        }
                                        @if (roles.Count == 0)
                                        {
                                            <span class="text-muted small">—</span>
                                        }
                                    </div>
                                </td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(item.Email))
                                    {
                                        <a href="mailto:@item.Email" class="text-decoration-none text-dark small">@item.Email</a>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">—</span>
                                    }
                                </td>
                                <td>
                                    @if (depts.Length > 0)
                                    {
                                        foreach (var d in depts.Take(2))
                                        {
                                            <span class="um-chip"><i class="bi bi-diagram-2 text-primary"></i>@d</span>
                                        }
                                        if (depts.Length > 2)
                                        {
                                            <span class="um-chip" title="@string.Join(", ", depts.Skip(2))">+@(depts.Length - 2)</span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted small">—</span>
                                    }
                                </td>
                                <td>
                                    @if (branches.Length > 0)
                                    {
                                        foreach (var b in branches.Take(2))
                                        {
                                            <span class="um-chip"><i class="bi bi-building text-secondary"></i>@b</span>
                                        }
                                        if (branches.Length > 2)
                                        {
                                            <span class="um-chip" title="@string.Join(", ", branches.Skip(2))">+@(branches.Length - 2)</span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted small">—</span>
                                    }
                                </td>
                                <td class="text-center">
                                    @if (item.IsActive)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-1 rounded-pill"><i class="bi bi-check-circle-fill me-1"></i>Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-3 py-1 rounded-pill"><i class="bi bi-x-circle-fill me-1"></i>Inactive</span>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    <div class="btn-group btn-group-sm shadow-sm" role="group">
                                        <a asp-permission="SETTINGS.USERS:DETAILS" asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-info" title="View Details"><i class="bi bi-eye"></i></a>
                                        <a asp-permission="SETTINGS.USERS:EDIT" asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-primary" title="Edit User"><i class="bi bi-pencil"></i></a>
                                    </div>
                                </td>
                            </tr>
                        }
                        @if (!users.Any())
                        {
                            <tr id="umEmpty">
                                <td colspan="7" class="text-center py-5 text-muted">
                                    <i class="bi bi-people display-6 d-block mb-2 text-secondary"></i>
                                    <span id="umEmptyText">@(Model.HasFilter ? "No users match your filters." : "No users found.")</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        @if (Model.FilteredCount > 0)
        {
            <div class="card-footer bg-white border-top py-2 px-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
                <div class="d-flex align-items-center gap-2 small text-muted">
                    <span>Rows per page</span>
                    <select class="form-select form-select-sm" style="width:auto;" id="umPageSize" aria-label="Rows per page">
                        @foreach (var size in new[] { 10, 25, 50, 100 })
                        {
                            <option value="@PageUrl(1, size)" selected="@(Model.PageSize == size)">@size</option>
                        }
                    </select>
                    <span class="ms-2">Page <strong>@Model.Page</strong> of <strong>@Model.TotalPages</strong></span>
                </div>
                @if (Model.TotalPages > 1)
                {
                    var startPage = Math.Max(1, Model.Page - 2);
                    var endPage = Math.Min(Model.TotalPages, startPage + 4);
                    startPage = Math.Max(1, endPage - 4);
                    <nav aria-label="User pages">
                        <ul class="pagination pagination-sm mb-0 um-pager">
                            <li class="page-item @(Model.Page == 1 ? "disabled" : "")"><a class="page-link" href="@PageUrl(1)" title="First page"><i class="bi bi-chevron-double-left"></i></a></li>
                            <li class="page-item @(Model.Page == 1 ? "disabled" : "")"><a class="page-link" href="@PageUrl(Math.Max(1, Model.Page - 1))" title="Previous page"><i class="bi bi-chevron-left"></i></a></li>
                            @for (var p = startPage; p <= endPage; p++)
                            {
                                <li class="page-item @(p == Model.Page ? "active" : "")"><a class="page-link" href="@PageUrl(p)">@p</a></li>
                            }
                            <li class="page-item @(Model.Page == Model.TotalPages ? "disabled" : "")"><a class="page-link" href="@PageUrl(Math.Min(Model.TotalPages, Model.Page + 1))" title="Next page"><i class="bi bi-chevron-right"></i></a></li>
                            <li class="page-item @(Model.Page == Model.TotalPages ? "disabled" : "")"><a class="page-link" href="@PageUrl(Model.TotalPages)" title="Last page"><i class="bi bi-chevron-double-right"></i></a></li>
                        </ul>
                    </nav>
                }
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            // filters run on the server: the drop-downs submit at once, the search after a short pause (from page 1)
            const form = document.getElementById('umFilter');
            const search = document.getElementById('umSearch');
            const table = document.getElementById('umTable');
            let timer = null;
            function submit() { if (table) table.classList.add('um-loading'); form.submit(); }
            ['umType', 'umStatus', 'umRole'].forEach(id => document.getElementById(id).addEventListener('change', submit));
            search.addEventListener('input', () => {
                clearTimeout(timer);
                const v = search.value.trim();
                if (v.length === 1) return;          // wait for at least two characters (or an empty box)
                timer = setTimeout(submit, 550);
            });
            search.addEventListener('keydown', e => { if (e.key === 'Enter') { e.preventDefault(); clearTimeout(timer); submit(); } });
            // keep the caret at the end of the search box after the page reloads
            if (search.value) { search.focus(); const n = search.value.length; search.setSelectionRange(n, n); }
            const size = document.getElementById('umPageSize');
            if (size) size.addEventListener('change', () => { if (table) table.classList.add('um-loading'); location.href = size.value; });
        })();
    </script>
}
