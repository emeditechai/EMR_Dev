<script>
// ── Custom multi-select dropdown with Auto-Suggest Search ────
function toggleCms(wrapId) {
    const wrap = document.getElementById(wrapId);
    const isOpen = wrap.classList.contains('cms-open');
    // close all
    document.querySelectorAll('.cms-wrap.cms-open').forEach(w => w.classList.remove('cms-open'));
    if (!isOpen) {
        wrap.classList.add('cms-open');
        const input = wrap.querySelector('.cms-search-box input');
        if (input) {
            setTimeout(() => input.focus(), 60);
        }
    }
}

document.addEventListener('click', function (e) {
    document.querySelectorAll('.cms-wrap.cms-open').forEach(wrap => {
        if (!wrap.contains(e.target)) wrap.classList.remove('cms-open');
    });
});

function filterCmsOptions(dropdownId, query, noResultsId) {
    const term = (query || '').toLowerCase().trim();
    const dropdown = document.getElementById(dropdownId);
    if (!dropdown) return;

    const options = dropdown.querySelectorAll('.cms-option');
    let visibleCount = 0;
    options.forEach(opt => {
        const text = opt.dataset.searchText || opt.textContent.toLowerCase();
        if (!term || text.includes(term)) {
            opt.style.display = 'flex';
            visibleCount++;
        } else {
            opt.style.display = 'none';
        }
    });

    const noResults = document.getElementById(noResultsId);
    if (noResults) {
        noResults.style.display = visibleCount === 0 ? 'block' : 'none';
    }
}

function filterRoleOptions(query) {
    const term = (query || '').toLowerCase().trim();
    const dropdown = document.getElementById('roleDropdown');
    if (!dropdown) return;

    let totalVisible = 0;
    dropdown.querySelectorAll('.cms-group').forEach(grp => {
        // if group is hidden by branch selection, keep it hidden
        if (grp.style.display === 'none') return;

        let groupVisibleCount = 0;
        grp.querySelectorAll('.cms-option').forEach(opt => {
            const text = opt.textContent.toLowerCase();
            if (!term || text.includes(term)) {
                opt.style.display = 'flex';
                groupVisibleCount++;
                totalVisible++;
            } else {
                opt.style.display = 'none';
            }
        });
        const header = grp.querySelector('.cms-group-header');
        if (header) {
            header.style.display = groupVisibleCount > 0 ? '' : 'none';
        }
    });

    const noResults = document.getElementById('roleNoResults');
    if (noResults) {
        noResults.style.display = totalVisible === 0 ? 'block' : 'none';
    }
}

// ── Branch change handler ────────────────────────────────────
function onBranchChange() {
    const checkedBranches = [...document.querySelectorAll('input[name="SelectedBranchIds"]:checked')]
        .map(cb => parseInt(cb.value));

    // Show/hide role groups
    document.querySelectorAll('.cms-group[data-branch-id]').forEach(group => {
        const bid = parseInt(group.dataset.branchId);
        const visible = checkedBranches.includes(bid);
        group.style.display = visible ? '' : 'none';
        if (!visible) {
            group.querySelectorAll('input[type="checkbox"]').forEach(cb => cb.checked = false);
        }
    });

    updateBranchLabel();
    updateRoleLabel();
}

function updateBranchLabel() {
    const checked = [...document.querySelectorAll('input[name="SelectedBranchIds"]:checked')];
    const lbl = document.getElementById('branchLabel');
    if (checked.length === 0) {
        lbl.textContent = 'Select branches...';
    } else {
        lbl.textContent = checked.map(cb => cb.nextElementSibling.textContent.trim()).join(', ');
    }
}

function updateDeptLabel() {
    const checked = [...document.querySelectorAll('input[name="SelectedDepartmentIds"]:checked')];
    const lbl = document.getElementById('deptLabel');
    if (!lbl) return;
    if (checked.length === 0) {
        lbl.textContent = 'Select departments...';
    } else if (checked.length <= 2) {
        lbl.textContent = checked.map(cb => cb.nextElementSibling.textContent.trim()).join(', ');
    } else {
        lbl.textContent = checked.length + ' department(s) selected';
    }
}

function updateRoleLabel() {
    const checked = [...document.querySelectorAll('input[name="SelectedRoleIds"]:checked')];
    const lbl = document.getElementById('roleLabel');
    lbl.textContent = checked.length === 0 ? 'Select branch-wise roles' : checked.length + ' role(s) selected';
}

// ── Password eye toggle ──────────────────────────────────────
function togglePwd(inputId, iconId) {
    const inp = document.getElementById(inputId);
    const ico = document.getElementById(iconId);
    if (inp.type === 'password') {
        inp.type = 'text';
        ico.classList.replace('bi-eye', 'bi-eye-slash');
    } else {
        inp.type = 'password';
        ico.classList.replace('bi-eye-slash', 'bi-eye');
    }
}

function previewProfilePicture(input) {
    const preview = document.getElementById('profilePreview');
    if (!preview || !input.files || !input.files[0]) return;
    const reader = new FileReader();
    reader.onload = e => preview.src = e.target.result;
    reader.readAsDataURL(input.files[0]);
}

// ── Dependable Cascading Geography (Country -> State -> City -> Area) ──
const ddlCountry = document.getElementById('ddlCountry');
const ddlState = document.getElementById('ddlState');
const ddlCity = document.getElementById('ddlCity');
const ddlAssignedZone = document.getElementById('ddlAssignedZone');

if (ddlCountry) {
    ddlCountry.addEventListener('change', async function () {
        const countryId = this.value;
        if (ddlState) ddlState.innerHTML = '<option value="">-- Select State --</option>';
        if (ddlCity) ddlCity.innerHTML = '<option value="">-- Select City --</option>';
        if (ddlAssignedZone) ddlAssignedZone.innerHTML = '<option value="">-- Select Assigned Zone (Area Master) --</option>';
        
        if (!countryId) return;

        if (ddlState) {
            ddlState.disabled = true;
            ddlState.innerHTML = '<option value="">Loading states...</option>';
        }

        try {
            const resp = await fetch(`/Users/GetStatesByCountry?countryId=${encodeURIComponent(countryId)}`);
            if (resp.ok) {
                const states = await resp.json();
                if (ddlState) {
                    ddlState.innerHTML = '<option value="">-- Select State --</option>';
                    states.forEach(s => {
                        const opt = document.createElement('option');
                        opt.value = s.stateId;
                        opt.textContent = s.stateName;
                        ddlState.appendChild(opt);
                    });
                }
            } else if (ddlState) {
                ddlState.innerHTML = '<option value="">-- Select State --</option>';
            }
        } catch (e) {
            console.error('Error fetching states:', e);
            if (ddlState) ddlState.innerHTML = '<option value="">-- Select State --</option>';
        } finally {
            if (ddlState) ddlState.disabled = false;
        }
    });
}

if (ddlState) {
    ddlState.addEventListener('change', async function () {
        const stateId = this.value;
        if (ddlCity) ddlCity.innerHTML = '<option value="">-- Select City --</option>';
        if (ddlAssignedZone) ddlAssignedZone.innerHTML = '<option value="">-- Select Assigned Zone (Area Master) --</option>';
        
        if (!stateId) return;

        if (ddlCity) {
            ddlCity.disabled = true;
            ddlCity.innerHTML = '<option value="">Loading cities...</option>';
        }

        try {
            const resp = await fetch(`/Users/GetCitiesByState?stateId=${encodeURIComponent(stateId)}`);
            if (resp.ok) {
                const cities = await resp.json();
                if (ddlCity) {
                    ddlCity.innerHTML = '<option value="">-- Select City --</option>';
                    cities.forEach(c => {
                        const opt = document.createElement('option');
                        opt.value = c.cityId;
                        opt.textContent = c.cityName;
                        ddlCity.appendChild(opt);
                    });
                }
            } else if (ddlCity) {
                ddlCity.innerHTML = '<option value="">-- Select City --</option>';
            }
        } catch (e) {
            console.error('Error fetching cities:', e);
            if (ddlCity) ddlCity.innerHTML = '<option value="">-- Select City --</option>';
        } finally {
            if (ddlCity) ddlCity.disabled = false;
        }
    });
}

if (ddlCity) {
    ddlCity.addEventListener('change', async function () {
        const cityId = this.value;
        loadAreasForCity(cityId);
    });
}

async function loadAreasForCity(cityId, preserveSelectedId) {
    if (!ddlAssignedZone) return;
    const currentSelected = preserveSelectedId || ddlAssignedZone.value;
    ddlAssignedZone.innerHTML = '<option value="">-- Select Assigned Zone (Area Master) --</option>';

    if (!cityId) return;

    ddlAssignedZone.disabled = true;
    try {
        const resp = await fetch(`/Users/GetAreasByCity?cityId=${encodeURIComponent(cityId)}`);
        if (resp.ok) {
            const areas = await resp.json();
            ddlAssignedZone.innerHTML = '<option value="">-- Select Assigned Zone (Area Master) --</option>';
            areas.forEach(a => {
                const opt = document.createElement('option');
                opt.value = a.areaId;
                opt.textContent = a.areaCode ? `${a.areaName} (${a.areaCode})` : a.areaName;
                if (currentSelected && a.areaId.toString() === currentSelected.toString()) {
                    opt.selected = true;
                }
                ddlAssignedZone.appendChild(opt);
            });
        }
    } catch (e) {
        console.error('Error fetching areas:', e);
    } finally {
        ddlAssignedZone.disabled = false;
        updatePhlebotomistSummary();
    }
}

// ── Phlebotomist Modal & Logic ───────────────────────────────
let phlebotomistModalInstance = null;

function getPhlebotomistModal() {
    if (!phlebotomistModalInstance) {
        const el = document.getElementById('phlebotomistModal');
        if (el && window.bootstrap && window.bootstrap.Modal) {
            phlebotomistModalInstance = new bootstrap.Modal(el);
        }
    }
    return phlebotomistModalInstance;
}

function openPhlebotomistModal() {
    const modal = getPhlebotomistModal();
    if (modal) {
        document.getElementById('certNoErrorMsg').style.display = 'none';
        modal.show();
        setTimeout(() => {
            const txt = document.getElementById('txtCertificationNo');
            if (txt) txt.focus();
        }, 400);
    }
}

function savePhlebotomistModal() {
    const certInput = document.getElementById('txtCertificationNo');
    const errDiv = document.getElementById('certNoErrorMsg');
    if (!certInput || !certInput.value.trim()) {
        if (errDiv) errDiv.style.display = 'block';
        if (certInput) certInput.focus();
        return;
    }

    if (errDiv) errDiv.style.display = 'none';
    const modal = getPhlebotomistModal();
    if (modal) {
        modal.hide();
    }
    updatePhlebotomistSummary();
}

function updatePhlebotomistSummary() {
    const isPhlebotomist = document.getElementById('isPhlebotomistToggle')?.checked;
    const container = document.getElementById('phlebotomistBadgeContainer');
    const badgeText = document.getElementById('phlebotomistBadgeText');
    const detailsContainer = document.getElementById('phlebotomistSummaryDetails');
    const card = document.getElementById('phlebotomistCard');

    if (!container) return;

    if (!isPhlebotomist) {
        container.style.display = 'none';
        if (card) {
            card.style.borderColor = '#e2e8f0';
            card.style.background = '#ffffff';
        }
        return;
    }

    container.style.display = '';
    if (card) {
        card.style.borderColor = '#fca5a5';
        card.style.background = 'linear-gradient(180deg, #ffffff 0%, #fffbfb 100%)';
    }

    const cert = document.getElementById('txtCertificationNo')?.value.trim();
    if (badgeText) {
        badgeText.innerHTML = `<i class="bi bi-patch-check-fill me-1"></i>${cert ? 'Cert: ' + cert : '<span class="text-danger fw-bold">Cert Required</span>'}`;
    }

    const shiftSelect = document.getElementById('ddlShiftSlot');
    const shiftText = shiftSelect && shiftSelect.selectedIndex > 0 ? shiftSelect.options[shiftSelect.selectedIndex].text : '';

    const zoneSelect = document.getElementById('ddlAssignedZone');
    const zoneText = zoneSelect && zoneSelect.selectedIndex > 0 ? zoneSelect.options[zoneSelect.selectedIndex].text : '';

    const targetVal = document.getElementById('txtDailyTarget')?.value;

    const chips = [];
    if (shiftText) chips.push(`<span class="role-chip"><i class="bi bi-clock-history text-danger"></i>${shiftText}</span>`);
    if (zoneText) chips.push(`<span class="role-chip"><i class="bi bi-geo-alt-fill text-danger"></i>${zoneText}</span>`);
    if (targetVal && parseFloat(targetVal) > 0) chips.push(`<span class="role-chip text-success fw-bold"><i class="bi bi-cash-stack"></i>Target: ₹${parseFloat(targetVal).toLocaleString('en-IN')}/day</span>`);

    if (detailsContainer) {
        detailsContainer.innerHTML = chips.length > 0
            ? `<div class="d-flex flex-wrap gap-1 mt-2">${chips.join('')}</div>`
            : '<div class="text-muted small mt-1" style="font-size:0.75rem;">Click Configure to assign shift, zone area & target</div>';
    }
}

const isPhlebotomistToggle = document.getElementById('isPhlebotomistToggle');
if (isPhlebotomistToggle) {
    isPhlebotomistToggle.addEventListener('change', function () {
        if (this.checked) {
            updatePhlebotomistSummary();
            openPhlebotomistModal();
        } else {
            updatePhlebotomistSummary();
        }
    });
}

// ── Lab Technician Modal & Logic ─────────────────────────────
let labTechnicianModalInstance = null;

function getLabTechnicianModal() {
    if (!labTechnicianModalInstance) {
        const el = document.getElementById('labTechnicianModal');
        if (el && window.bootstrap && window.bootstrap.Modal) {
            labTechnicianModalInstance = new bootstrap.Modal(el);
        }
    }
    return labTechnicianModalInstance;
}

function openLabTechnicianModal() {
    const modal = getLabTechnicianModal();
    if (modal) {
        modal.show();
    }
}

function saveLabTechnicianModal() {
    const modal = getLabTechnicianModal();
    if (modal) {
        modal.hide();
    }
    updateLabTechnicianSummary();
}

function updateLabTechnicianSummary() {
    const isLabTech = document.getElementById('isLabTechnicianToggle')?.checked;
    const container = document.getElementById('labTechnicianBadgeContainer');
    const badgeText = document.getElementById('labTechnicianBadgeText');
    const detailsContainer = document.getElementById('labTechnicianSummaryDetails');
    const card = document.getElementById('labTechnicianCard');

    if (!container) return;

    if (!isLabTech) {
        container.style.display = 'none';
        if (card) {
            card.style.borderColor = '#e2e8f0';
            card.style.background = '#ffffff';
        }
        return;
    }

    container.style.display = '';
    if (card) {
        card.style.borderColor = '#99f6e4';
        card.style.background = 'linear-gradient(180deg, #ffffff 0%, #fbfdfd 100%)';
    }

    const analyzerSelect = document.getElementById('ddlAnalyzerTrainedOn');
    const analyzer = analyzerSelect && analyzerSelect.selectedIndex > 0 ? analyzerSelect.options[analyzerSelect.selectedIndex].text : '';

    if (badgeText) {
        badgeText.innerHTML = `<i class="bi bi-cpu-fill me-1"></i>${analyzer ? 'Configured' : 'Analyzer Not Set'}`;
    }

    const shiftSelect = document.getElementById('ddlLabShiftSlot');
    const shiftText = shiftSelect && shiftSelect.selectedIndex > 0 ? shiftSelect.options[shiftSelect.selectedIndex].text : '';

    const chips = [];
    if (shiftText) chips.push(`<span class="role-chip"><i class="bi bi-clock-history" style="color:#0d9488;"></i>${shiftText}</span>`);
    if (analyzer) chips.push(`<span class="role-chip fw-semibold" style="color:#0f766e;"><i class="bi bi-cpu" style="color:#0d9488;"></i>${analyzer}</span>`);

    if (detailsContainer) {
        detailsContainer.innerHTML = chips.length > 0
            ? `<div class="d-flex flex-wrap gap-1 mt-2">${chips.join('')}</div>`
            : '<div class="text-muted small mt-1" style="font-size:0.75rem;">Click Configure to set lab shift & analyzer training</div>';
    }
}

const isLabTechnicianToggle = document.getElementById('isLabTechnicianToggle');
if (isLabTechnicianToggle) {
    isLabTechnicianToggle.addEventListener('change', function () {
        if (this.checked) {
            updateLabTechnicianSummary();
            openLabTechnicianModal();
        } else {
            updateLabTechnicianSummary();
        }
    });
}

// ── Pathologist Modal & Logic ─────────────────────────────────
let pathologistModalInstance = null;

function getPathologistModal() {
    if (!pathologistModalInstance) {
        const el = document.getElementById('pathologistModal');
        if (el && window.bootstrap && window.bootstrap.Modal) {
            pathologistModalInstance = new bootstrap.Modal(el);
        }
    }
    return pathologistModalInstance;
}

function openPathologistModal() {
    const modal = getPathologistModal();
    if (modal) {
        const errDiv = document.getElementById('pathoRegNoErrorMsg');
        if (errDiv) errDiv.style.display = 'none';
        modal.show();
        setTimeout(() => {
            const txt = document.getElementById('txtRegistrationNo');
            if (txt) txt.focus();
        }, 400);
    }
}

function savePathologistModal() {
    const regInput = document.getElementById('txtRegistrationNo');
    const errDiv = document.getElementById('pathoRegNoErrorMsg');
    if (!regInput || !regInput.value.trim()) {
        if (errDiv) errDiv.style.display = 'block';
        if (regInput) regInput.focus();
        return;
    }

    if (errDiv) errDiv.style.display = 'none';
    const modal = getPathologistModal();
    if (modal) {
        modal.hide();
    }
    updatePathologistSummary();
}

function updatePathologistSummary() {
    const isPatho = document.getElementById('isPathologistToggle')?.checked;
    const container = document.getElementById('pathologistBadgeContainer');
    const badgeText = document.getElementById('pathologistBadgeText');
    const detailsContainer = document.getElementById('pathologistSummaryDetails');
    const card = document.getElementById('pathologistCard');

    if (!container) return;

    if (!isPatho) {
        container.style.display = 'none';
        if (card) {
            card.style.borderColor = '#e2e8f0';
            card.style.background = '#ffffff';
        }
        return;
    }

    container.style.display = '';
    if (card) {
        card.style.borderColor = '#d8b4fe';
        card.style.background = 'linear-gradient(180deg, #ffffff 0%, #faf5ff 100%)';
    }

    const regNo = document.getElementById('txtRegistrationNo')?.value.trim();
    if (badgeText) {
        badgeText.innerHTML = `<i class="bi bi-patch-check-fill me-1"></i>${regNo ? 'Reg: ' + regNo : '<span class="text-danger fw-bold">Reg Required</span>'}`;
    }

    if (detailsContainer) {
        detailsContainer.innerHTML = regNo
            ? `<div class="d-flex flex-wrap gap-1 mt-2"><span class="role-chip" style="color:#6b21a8;"><i class="bi bi-person-badge-fill" style="color:#7c3aed;"></i>${regNo}</span></div>`
            : '<div class="text-muted small mt-1" style="font-size:0.75rem;">Click Configure to enter Registration No</div>';
    }
}

const isPathologistToggle = document.getElementById('isPathologistToggle');
if (isPathologistToggle) {
    isPathologistToggle.addEventListener('change', function () {
        if (this.checked) {
            updatePathologistSummary();
            openPathologistModal();
        } else {
            updatePathologistSummary();
        }
    });
}

// ── Init on load ─────────────────────────────────────────────
(function () {
    onBranchChange(); // set initial visibility of role groups
    updateBranchLabel();
    updateDeptLabel();
    updateRoleLabel();
    updatePathologistSummary();
    updatePhlebotomistSummary();
    updateLabTechnicianSummary();
})();
</script>
