@model EMR.Web.Models.ViewModels.UserFormViewModel


<div class="uf-section mb-3">
    <div class="uf-section-header">
        <i class="bi bi-shield-lock-fill me-2"></i>Account Information
    </div>
    <div class="uf-section-body">
        <div class="row g-3">
            <div class="col-md-4">
                <label class="form-label fw-semibold">Username <span class="text-danger">*</span></label>
                <div class="input-icon-wrap">
                    <i class="bi bi-person input-icon"></i>
                    <input asp-for="Username" class="form-control ps-icon" placeholder="Enter username" autocomplete="off" />
                </div>
                <span asp-validation-for="Username" class="text-danger small"></span>
            </div>
            <div class="col-md-4">
                <label class="form-label fw-semibold">Employee Code</label>
                <div class="input-icon-wrap">
                    <i class="bi bi-upc-scan input-icon"></i>
                    <input asp-for="EmployeeCode" class="form-control ps-icon text-uppercase" placeholder="Enter employee code" oninput="this.value=this.value.toUpperCase()" />
                </div>
                <span asp-validation-for="EmployeeCode" class="text-danger small"></span>
            </div>
            <div class="col-md-4">
                <label class="form-label fw-semibold">Email</label>
                <div class="input-icon-wrap">
                    <i class="bi bi-envelope input-icon"></i>
                    <input asp-for="Email" class="form-control ps-icon" placeholder="user@example.com" />
                </div>
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>
        </div>
    </div>
</div>


<div class="uf-section mb-3">
    <div class="uf-section-header">
        <i class="bi bi-person-lines-fill me-2"></i>Personal & Professional Details
    </div>
    <div class="uf-section-body">
        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label fw-semibold">First Name <span class="text-danger">*</span></label>
                <div class="input-icon-wrap">
                    <i class="bi bi-layout-text-sidebar input-icon"></i>
                    <input asp-for="FirstName" class="form-control ps-icon" placeholder="Enter first name" />
                </div>
                <span asp-validation-for="FirstName" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label class="form-label fw-semibold">Last Name <span class="text-danger">*</span></label>
                <div class="input-icon-wrap">
                    <i class="bi bi-layout-text-sidebar input-icon"></i>
                    <input asp-for="LastName" class="form-control ps-icon" placeholder="Enter last name" />
                </div>
                <span asp-validation-for="LastName" class="text-danger small"></span>
            </div>
            <div class="col-md-4">
                <label class="form-label fw-semibold">Phone Number</label>
                <div class="input-icon-wrap">
                    <i class="bi bi-telephone input-icon"></i>
                    <input asp-for="PhoneNumber" class="form-control ps-icon" placeholder="Enter phone number" />
                </div>
                <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
            </div>
            <div class="col-md-4">
                <label class="form-label fw-semibold">Date of Birth</label>
                <div class="input-icon-wrap">
                    <i class="bi bi-calendar-heart input-icon"></i>
                    <input asp-for="DateOfBirth" type="date" class="form-control ps-icon" />
                </div>
                <span asp-validation-for="DateOfBirth" class="text-danger small"></span>
            </div>
            <div class="col-md-4">
                <label class="form-label fw-semibold">Date of Joining</label>
                <div class="input-icon-wrap">
                    <i class="bi bi-calendar-check input-icon"></i>
                    <input asp-for="DateOfJoining" type="date" class="form-control ps-icon" />
                </div>
                <span asp-validation-for="DateOfJoining" class="text-danger small"></span>
            </div>
            <div class="col-md-12">
                <label class="form-label fw-semibold">Profile Picture</label>
                <div class="d-flex align-items-center gap-3 p-2 border rounded-3 bg-light">
                    <div>
                        <img id="profilePreview"
                             src="@(string.IsNullOrWhiteSpace(Model.ExistingProfilePicturePath) ? "/Images/default-avatar.svg" : Model.ExistingProfilePicturePath)"
                             alt="Profile"
                             style="width:64px;height:64px;border-radius:50%;object-fit:cover;border:2px solid #d8e4f5;"
                             onerror="this.src='/Images/default-avatar.svg'" />
                    </div>
                    <div class="flex-grow-1">
                        <input asp-for="ProfilePictureFile" type="file" accept=".jpg,.jpeg,.png,.webp" class="form-control" onchange="previewProfilePicture(this)" />
                        <input asp-for="ExistingProfilePicturePath" type="hidden" />
                        <small class="text-muted">JPG, JPEG, PNG, WEBP (max 2 MB)</small>
                        <div><span asp-validation-for="ProfilePictureFile" class="text-danger small"></span></div>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <label class="form-label fw-semibold">Branch Access <span class="text-danger">*</span></label>
                <div class="cms-wrap" id="branchWrap">
                    <div class="cms-trigger" id="branchTrigger" onclick="toggleCms('branchWrap')">
                        <span id="branchLabel">Select branches...</span>
                        <i class="bi bi-chevron-down cms-arrow"></i>
                    </div>
                    <div class="cms-dropdown" id="branchDropdown">
                        <div class="cms-search-box p-2 border-bottom bg-white">
                            <div class="input-group input-group-sm">
                                <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
                                <input type="text" id="branchSearchInput" class="form-control border-start-0 ps-0" placeholder="Search branches..." autocomplete="off" oninput="filterCmsOptions('branchDropdown', this.value, 'branchNoResults')" onclick="event.stopPropagation()">
                            </div>
                        </div>
                        <div class="cms-options-container">
                            @foreach (var branch in Model.BranchOptions)
                            {
                                <label class="cms-option" data-search-text="@branch.Text.ToLowerInvariant()">
                                    <input type="checkbox" name="SelectedBranchIds" value="@branch.Value"
                                        @(Model.SelectedBranchIds.Contains(int.Parse(branch.Value)) ? "checked" : "")
                                        onchange="onBranchChange()">
                                    <span>@branch.Text</span>
                                </label>
                            }
                            <div id="branchNoResults" class="text-muted small px-3 py-2 text-center" style="display:none;">
                                <i class="bi bi-search me-1"></i>No matching branches found.
                            </div>
                        </div>
                    </div>
                </div>
                <small class="text-muted">Select one or more branches from the dropdown</small>
                <div><span asp-validation-for="SelectedBranchIds" class="text-danger small"></span></div>
            </div>
            <div class="col-md-6">
                <label class="form-label fw-semibold">Department Access</label>
                <div class="cms-wrap" id="deptWrap">
                    <div class="cms-trigger" id="deptTrigger" onclick="toggleCms('deptWrap')">
                        <span id="deptLabel">Select departments...</span>
                        <i class="bi bi-chevron-down cms-arrow"></i>
                    </div>
                    <div class="cms-dropdown" id="deptDropdown">
                        <div class="cms-search-box p-2 border-bottom bg-white">
                            <div class="input-group input-group-sm">
                                <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
                                <input type="text" id="deptSearchInput" class="form-control border-start-0 ps-0" placeholder="Type to search department..." autocomplete="off" oninput="filterCmsOptions('deptDropdown', this.value, 'deptNoResults')" onclick="event.stopPropagation()">
                            </div>
                        </div>
                        <div class="cms-options-container">
                            @foreach (var dept in Model.DepartmentOptions)
                            {
                                <label class="cms-option" data-search-text="@dept.Text.ToLowerInvariant()">
                                    <input type="checkbox" name="SelectedDepartmentIds" value="@dept.Value"
                                        @(Model.SelectedDepartmentIds.Contains(int.Parse(dept.Value)) ? "checked" : "")
                                        onchange="updateDeptLabel()">
                                    <span>@dept.Text</span>
                                </label>
                            }
                            <div id="deptNoResults" class="text-muted small px-3 py-2 text-center" style="display:none;">
                                <i class="bi bi-search me-1"></i>No matching departments found.
                            </div>
                            @if (!Model.DepartmentOptions.Any())
                            {
                                <div class="text-muted small px-3 py-2">No active departments available.</div>
                            }
                        </div>
                    </div>
                </div>
                <small class="text-muted">Select one or more hospital departments</small>
                <div><span asp-validation-for="SelectedDepartmentIds" class="text-danger small"></span></div>
            </div>
        </div>
    </div>
</div>


<div class="uf-section mb-3">
    <div class="uf-section-header">
        <i class="bi bi-geo-alt-fill me-2"></i>Address & Geography Details
    </div>
    <div class="uf-section-body">
        <div class="row g-3">
            <div class="col-md-8">
                <label class="form-label fw-semibold">Address</label>
                <div class="input-icon-wrap">
                    <i class="bi bi-house-door input-icon"></i>
                    <input asp-for="Address" class="form-control ps-icon" placeholder="Enter residential / residential address" />
                </div>
                <span asp-validation-for="Address" class="text-danger small"></span>
            </div>
            <div class="col-md-4">
                <label class="form-label fw-semibold">Pincode</label>
                <div class="input-icon-wrap">
                    <i class="bi bi-geo input-icon"></i>
                    <input asp-for="Pincode" class="form-control ps-icon" placeholder="e.g. 700001" maxlength="20" />
                </div>
                <span asp-validation-for="Pincode" class="text-danger small"></span>
            </div>
            <div class="col-md-4">
                <label class="form-label fw-semibold">Country</label>
                <div class="input-icon-wrap">
                    <i class="bi bi-globe input-icon"></i>
                    <select asp-for="CountryId" id="ddlCountry" class="form-select ps-icon" asp-items="Model.CountryOptions">
                        <option value="">-- Select Country --</option>
                    </select>
                </div>
                <span asp-validation-for="CountryId" class="text-danger small"></span>
            </div>
            <div class="col-md-4">
                <label class="form-label fw-semibold">State</label>
                <div class="input-icon-wrap">
                    <i class="bi bi-map input-icon"></i>
                    <select asp-for="StateId" id="ddlState" class="form-select ps-icon" asp-items="Model.StateOptions">
                        <option value="">-- Select State --</option>
                    </select>
                </div>
                <span asp-validation-for="StateId" class="text-danger small"></span>
            </div>
            <div class="col-md-4">
                <label class="form-label fw-semibold">City</label>
                <div class="input-icon-wrap">
                    <i class="bi bi-buildings input-icon"></i>
                    <select asp-for="CityId" id="ddlCity" class="form-select ps-icon" asp-items="Model.CityOptions">
                        <option value="">-- Select City --</option>
                    </select>
                </div>
                <span asp-validation-for="CityId" class="text-danger small"></span>
            </div>
        </div>
    </div>
</div>


<div class="uf-section mb-3">
    <div class="uf-section-header">
        <i class="bi bi-diagram-3-fill me-2"></i>Branch-wise Roles
    </div>
    <div class="uf-section-body">
        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label fw-semibold">Assign Roles</label>
                <div class="cms-wrap" id="roleWrap">
                    <div class="cms-trigger" id="roleTrigger" onclick="toggleCms('roleWrap')">
                        <span id="roleLabel">Select branch-wise roles</span>
                        <i class="bi bi-chevron-down cms-arrow"></i>
                    </div>
                    <div class="cms-dropdown" id="roleDropdown">
                        <div class="cms-search-box p-2 border-bottom bg-white">
                            <div class="input-group input-group-sm">
                                <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
                                <input type="text" id="roleSearchInput" class="form-control border-start-0 ps-0" placeholder="Search roles..." autocomplete="off" oninput="filterRoleOptions(this.value)" onclick="event.stopPropagation()">
                            </div>
                        </div>
                        <div class="cms-options-container">
                            @foreach (var group in Model.BranchRoleGroups)
                            {
                                <div class="cms-group" data-branch-id="@group.BranchId">
                                    <div class="cms-group-header">@group.BranchName</div>
                                    @foreach (var role in group.Roles)
                                    {
                                        <label class="cms-option ps-3" data-search-text="@role.Name.ToLowerInvariant()">
                                            <input type="checkbox" name="SelectedRoleIds" value="@role.Id"
                                                @(Model.SelectedRoleIds.Contains(role.Id) ? "checked" : "")
                                                onchange="updateRoleLabel()">
                                            <span>@role.Name</span>
                                        </label>
                                    }
                                </div>
                            }
                            <div id="roleNoResults" class="text-muted small px-3 py-2 text-center" style="display:none;">
                                <i class="bi bi-search me-1"></i>No matching roles found.
                            </div>
                            @if (!Model.BranchRoleGroups.Any())
                            {
                                <div class="text-muted small px-3 py-2">No roles available. Add roles in Branch Master first.</div>
                            }
                        </div>
                    </div>
                </div>
                <small class="text-muted">Select role(s) for each selected branch</small>
            </div>
        </div>
    </div>
</div>


<div class="uf-section mb-3">
    <div class="uf-section-header">
        <i class="bi bi-lock-fill me-2"></i>Security
    </div>
    <div class="uf-section-body">
        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label fw-semibold">
                    Password @(Model.Id == 0 ? Html.Raw("<span class=\"text-danger\">*</span>") : Html.Raw("<small class=\"text-muted fw-normal\">(leave blank to keep current)</small>"))
                </label>
                <div class="input-icon-wrap">
                    <i class="bi bi-lock input-icon"></i>
                    <input asp-for="Password" class="form-control ps-icon pe-eye" id="pwdInput" 
                           placeholder="Enter password" autocomplete="new-password" />
                    <button type="button" class="eye-btn" onclick="togglePwd('pwdInput','eyePwd')" tabindex="-1">
                        <i class="bi bi-eye" id="eyePwd"></i>
                    </button>
                </div>
                <span asp-validation-for="Password" class="text-danger small"></span>
                @if (Model.Id == 0)
                {
                    <small class="text-muted">Min 8 characters</small>
                }
            </div>
            <div class="col-md-6">
                <label class="form-label fw-semibold">Confirm Password @(Model.Id == 0 ? Html.Raw("<span class=\"text-danger\">*</span>") : "")</label>
                <div class="input-icon-wrap">
                    <i class="bi bi-lock input-icon"></i>
                    <input asp-for="ConfirmPassword" class="form-control ps-icon pe-eye" id="cpwdInput"
                           placeholder="Re-enter password" autocomplete="new-password" />
                    <button type="button" class="eye-btn" onclick="togglePwd('cpwdInput','eyeCpwd')" tabindex="-1">
                        <i class="bi bi-eye" id="eyeCpwd"></i>
                    </button>
                </div>
                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
            </div>
        </div>
    </div>
</div>


<div class="uf-section mb-3">
    <div class="uf-section-header">
        <i class="bi bi-person-gear me-2"></i>Clinical Roles & Status
    </div>
    <div class="uf-section-body">
        <div class="row g-3">
            <!-- Row 1: Base & Nursing Status (2-col balanced) -->
            <div class="col-md-6">
                <div class="emr-role-card h-100">
                    <div class="d-flex align-items-center justify-content-between">
                        <div class="d-flex align-items-center gap-3">
                            <div class="emr-role-icon bg-success bg-opacity-10 text-success">
                                <i class="bi bi-check-circle-fill"></i>
                            </div>
                            <div>
                                <div class="fw-semibold text-dark">Account Active</div>
                                <div class="text-muted small" style="font-size:0.78rem;">User system login status & access</div>
                            </div>
                        </div>
                        <div class="form-check form-switch mb-0">
                            <input asp-for="IsActive" class="form-check-input uf-big-toggle" id="isActiveToggle" role="switch">
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="emr-role-card h-100">
                    <div class="d-flex align-items-center justify-content-between">
                        <div class="d-flex align-items-center gap-3">
                            <div class="emr-role-icon bg-primary bg-opacity-10 text-primary">
                                <i class="bi bi-heart-pulse-fill"></i>
                            </div>
                            <div>
                                <div class="fw-semibold text-primary">Is Nursing Staff</div>
                                <div class="text-muted small" style="font-size:0.78rem;">Clinical nursing & inpatient care personnel</div>
                            </div>
                        </div>
                        <div class="form-check form-switch mb-0">
                            <input asp-for="IsNursingStaff" class="form-check-input uf-big-toggle" id="isNursingStaffToggle" role="switch">
                        </div>
                    </div>
                </div>
            </div>

            <!-- Row 2: Specialized Diagnostic & Lab Roles (3-col balanced) -->
            <!-- 1. Pathologist -->
            <div class="col-md-4">
                <div class="emr-role-card h-100" id="pathologistCard">
                    <div class="d-flex align-items-center justify-content-between">
                        <div class="d-flex align-items-center gap-3">
                            <div class="emr-role-icon bg-purple bg-opacity-10" style="color:#6f42c1;background:#faf5ff;">
                                <i class="bi bi-microscope"></i>
                            </div>
                            <div>
                                <div class="fw-semibold" style="color:#6f42c1;">Is Pathologist</div>
                                <div class="text-muted small" style="font-size:0.78rem;">Diagnostic pathologist</div>
                            </div>
                        </div>
                        <div class="form-check form-switch mb-0">
                            <input asp-for="IsPathologist" class="form-check-input uf-big-toggle" id="isPathologistToggle" role="switch">
                        </div>
                    </div>

                    <div id="pathologistBadgeContainer" class="role-config-drawer" style="@(Model.IsPathologist ? "" : "display:none;")">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="badge" style="background:#f3e8ff;color:#6b21a8;border:1px solid #e9d5ff;max-width:240px;" id="pathologistBadgeText">
                                <i class="bi bi-patch-check-fill me-1"></i>Reg: @(string.IsNullOrWhiteSpace(Model.RegistrationNo) ? "Not Set" : Model.RegistrationNo)
                            </span>
                            <button type="button" class="btn btn-sm rounded-pill shadow-none" style="font-size:0.75rem;background:#f3e8ff;color:#6b21a8;border:1px solid #e9d5ff;" onclick="openPathologistModal()">
                                <i class="bi bi-gear-fill me-1"></i>Configure
                            </button>
                        </div>
                        <div id="pathologistSummaryDetails"></div>
                    </div>
                </div>
            </div>

            <!-- 2. Phlebotomist -->
            <div class="col-md-4">
                <div class="emr-role-card h-100" id="phlebotomistCard">
                    <div class="d-flex align-items-center justify-content-between">
                        <div class="d-flex align-items-center gap-3">
                            <div class="emr-role-icon bg-danger bg-opacity-10 text-danger">
                                <i class="bi bi-droplet-fill"></i>
                            </div>
                            <div>
                                <div class="fw-semibold text-danger">Is Phlebotomist</div>
                                <div class="text-muted small" style="font-size:0.78rem;">Sample collection specialist</div>
                            </div>
                        </div>
                        <div class="form-check form-switch mb-0">
                            <input asp-for="IsPhlebotomist" class="form-check-input uf-big-toggle" id="isPhlebotomistToggle" role="switch">
                        </div>
                    </div>

                    <div id="phlebotomistBadgeContainer" class="role-config-drawer" style="@(Model.IsPhlebotomist ? "" : "display:none;")">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="badge" style="background:#fee2e2;color:#991b1b;border:1px solid #fecaca;max-width:240px;" id="phlebotomistBadgeText">
                                <i class="bi bi-patch-check-fill me-1"></i>Cert: @(string.IsNullOrWhiteSpace(Model.CertificationNo) ? "Not Set" : Model.CertificationNo)
                            </span>
                            <button type="button" class="btn btn-sm btn-outline-danger py-0 px-2 rounded-pill shadow-none" style="font-size:0.75rem;" onclick="openPhlebotomistModal()">
                                <i class="bi bi-gear-fill me-1"></i>Configure
                            </button>
                        </div>
                        <div id="phlebotomistSummaryDetails"></div>
                    </div>
                </div>
            </div>

            <!-- 3. Lab Technician -->
            <div class="col-md-4">
                <div class="emr-role-card h-100" id="labTechnicianCard">
                    <div class="d-flex align-items-center justify-content-between">
                        <div class="d-flex align-items-center gap-3">
                            <div class="emr-role-icon text-teal" style="background:#f0fdfa;color:#0d9488;">
                                <i class="bi bi-eyedropper"></i>
                            </div>
                            <div>
                                <div class="fw-semibold" style="color:#0d9488;">Is Lab Technician</div>
                                <div class="text-muted small" style="font-size:0.78rem;">Diagnostics technician</div>
                            </div>
                        </div>
                        <div class="form-check form-switch mb-0">
                            <input asp-for="IsLabTechnician" class="form-check-input uf-big-toggle" id="isLabTechnicianToggle" role="switch">
                        </div>
                    </div>

                    <div id="labTechnicianBadgeContainer" class="role-config-drawer" style="@(Model.IsLabTechnician ? "" : "display:none;")">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="badge" style="background:#ccfbf1;color:#0f766e;border:1px solid #99f6e4;max-width:240px;" id="labTechnicianBadgeText">
                                <i class="bi bi-cpu-fill me-1"></i>@(string.IsNullOrWhiteSpace(Model.AnalyzerTrainedOn) ? "Analyzer Not Configured" : "Configured")
                            </span>
                            <button type="button" class="btn btn-sm py-0 px-2 rounded-pill shadow-none" style="font-size:0.75rem;background:#ccfbf1;color:#0f766e;border:1px solid #99f6e4;" onclick="openLabTechnicianModal()">
                                <i class="bi bi-gear-fill me-1"></i>Configure
                            </button>
                        </div>
                        <div id="labTechnicianSummaryDetails"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal: Pathologist Configuration -->
<div class="modal fade" id="pathologistModal" tabindex="-1" aria-labelledby="pathologistModalLabel" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="modal-header text-white" style="background: linear-gradient(135deg, #7c3aed 0%, #6d28d9 100%);">
                <div class="d-flex align-items-center gap-2">
                    <div class="rounded-circle bg-white bg-opacity-25 p-2 d-flex align-items-center justify-content-center" style="width:36px;height:36px;">
                        <i class="bi bi-microscope fs-5 text-white"></i>
                    </div>
                    <div>
                        <h5 class="modal-title fw-bold mb-0" id="pathologistModalLabel">Pathologist Configuration</h5>
                        <small class="text-white-50">Specify medical registration credentials</small>
                    </div>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <div class="alert d-flex align-items-center gap-2 mb-3 py-2 px-3 small border" style="background:#faf5ff;color:#6b21a8;border-color:#f3e8ff !important;">
                    <i class="bi bi-info-circle-fill fs-5 flex-shrink-0"></i>
