@model EMR.Web.Models.ViewModels.UserTypeBadgeModel
@* User type (Users.User_Type) and, for a login created from another master, the record it belongs to *@
@switch (Model.UserType)
{
    case "D":
        <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle" title="Login created from Doctor Master">
            <i class="bi bi-person-vcard me-1"></i>Doctor login
        </span>
        @if (Model.ReferenceUserId.HasValue)
        {
            <a class="small text-decoration-none ms-1" asp-controller="Doctors" asp-action="Details" asp-route-id="@Model.ReferenceUserId">@(Model.ReferenceName ?? $"Doctor #{Model.ReferenceUserId}")</a>
        }
        break;
    case "F":
        <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle"><i class="bi bi-shop me-1"></i>Franchise login</span>
        <span class="small text-muted ms-1">@(Model.ReferenceName ?? $"Franchise #{Model.ReferenceUserId}")</span>
        break;
    case "C":
        <span class="badge bg-primary-subtle text-primary border border-primary-subtle"><i class="bi bi-buildings me-1"></i>Company login</span>
        <span class="small text-muted ms-1">@(Model.ReferenceName ?? $"Company #{Model.ReferenceUserId}")</span>
        break;
    default:
        <span class="badge bg-light text-secondary border"><i class="bi bi-person me-1"></i>General user</span>
        break;
}
