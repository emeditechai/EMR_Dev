@model List<EMR.Web.Models.Entities.VideoSystemConfig>
@{
    ViewData["Title"] = "Video Consultation Config";
}

<div class="container-fluid px-4 py-3">
    @* Header *@
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h3 class="fw-bold mb-0"><i class="bi bi-camera-video-fill text-primary me-2"></i>Video Consultation Config</h3>
            <p class="text-muted small mb-0">Manage Whereby API settings for video consultations</p>
        </div>
        <div class="d-flex gap-2">
            <button asp-permission="SETTINGS.VIDEOCONFIG:TEST" class="btn btn-outline-success" id="btnTestConnection">
                <i class="bi bi-wifi me-1"></i>Test Connection
            </button>
            <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addConfigModal">
                <i class="bi bi-plus-lg me-1"></i>Add Config
            </button>
        </div>
    </div>

    @* Status Banner *@
    <div id="statusBanner" class="d-none mb-3"></div>

    @* Config Cards Grid *@
    <div class="row g-3" id="configCardsContainer">
        @foreach (var cfg in Model)
        {
            <div class="col-12 col-lg-6" id="card-@cfg.ConfigId">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body p-0">
                        <div class="d-flex align-items-center px-4 py-3 border-bottom">
                            <div class="flex-grow-1">
                                <span class="badge text-bg-primary font-monospace fs-6 me-2">@cfg.ConfigKey</span>
                                @if (!cfg.IsActive)
                                {
                                    <span class="badge text-bg-secondary">Inactive</span>
                                }
                            </div>
                            <div class="form-check form-switch mb-0 me-3">
                                <input class="form-check-input cfg-active-toggle" type="checkbox"
                                       data-key="@cfg.ConfigKey" @(cfg.IsActive ? "checked" : "") />
                            </div>
                            <button asp-permission="SETTINGS.VIDEOCONFIG:DELETE" class="btn btn-sm btn-outline-danger" onclick="deleteConfig(@cfg.ConfigId)">
                                <i class="bi bi-trash3"></i>
                            </button>
                        </div>
                        <div class="p-4">
                            <div class="mb-3">
                                <label class="form-label fw-semibold text-muted small mb-1">Config Value</label>
                                @if (cfg.ConfigKey == "WherebyApiKey")
                                {
                                    <div>
                                        <textarea class="form-control font-monospace cfg-value-input"
                                                  data-key="@cfg.ConfigKey"
                                                  id="val-@cfg.ConfigId"
                                                  rows="4"
                                                  placeholder="Paste full Whereby API key (JWT token — all 3 parts required)"
                                                  oninput="updateKeyHint('val-@cfg.ConfigId', 'hint-@cfg.ConfigId')"
                                                  style="font-size:0.75rem;word-break:break-all;">@cfg.ConfigValue</textarea>
                                        <div id="hint-@cfg.ConfigId" class="mt-1"></div>
                                    </div>
                                }
                                else
                                {
                                    <input type="text" class="form-control cfg-value-input"
                                           data-key="@cfg.ConfigKey" value="@cfg.ConfigValue" />
                                }
                            </div>
                            @if (cfg.MeetingCreationUrl != null || cfg.ConfigKey == "WherebyBaseUrl")
                            {
                                <div class="mb-3">
                                    <label class="form-label fw-semibold text-muted small mb-1">Meeting Creation URL</label>
                                    <input type="text" class="form-control cfg-url-input"
                                           data-key="@cfg.ConfigKey"
                                           value="@cfg.MeetingCreationUrl"
                                           placeholder="e.g. https://api.whereby.dev/v1/meetings" />
                                </div>
                            }
                            <div class="d-flex align-items-center justify-content-between">
                                <small class="text-muted">
                                    <i class="bi bi-clock me-1"></i>
                                    Updated: @(cfg.ModifiedDate?.ToString("dd-MMM-yyyy HH:mm") ?? cfg.CreatedDate.ToString("dd-MMM-yyyy HH:mm"))
                                    @if (!string.IsNullOrWhiteSpace(cfg.ModifiedBy)) { <span>by @cfg.ModifiedBy</span> }
                                </small>
                                <button asp-permission="SETTINGS.VIDEOCONFIG:EDIT" class="btn btn-sm btn-primary" onclick="saveConfig('@cfg.ConfigKey')">
                                    <i class="bi bi-check-lg me-1"></i>Save
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
        @if (!Model.Any())
        {
            <div class="col-12">
                <div class="alert alert-info">
                    <i class="bi bi-info-circle me-2"></i>No video config entries found. Click <strong>Add Config</strong> to create one.
                </div>
            </div>
        }
    </div>

    @* Failed Video Bookings Panel *@
    <div class="card border-0 shadow-sm mt-4" id="failedVideoPanel">
        <div class="card-header bg-danger text-white d-flex align-items-center justify-content-between py-3">
            <div>
                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                <strong>Failed Video Room Creations</strong>
                <span class="badge bg-white text-danger ms-2" id="failedCount">...</span>
            </div>
            <div class="d-flex gap-2">
                <button asp-permission="SETTINGS.VIDEOCONFIG:RETRIGGER" class="btn btn-sm btn-warning fw-bold" id="btnRetryAll" onclick="retryAllFailed()">
                    <i class="bi bi-arrow-repeat me-1"></i>Retry All Failed
                </button>
                <button class="btn btn-sm btn-outline-light" onclick="loadFailedBookings()">
                    <i class="bi bi-arrow-clockwise me-1"></i>Refresh
                </button>
            </div>
        </div>

        <div class="card-body p-0">
            <div id="failedBookingsContainer" class="p-3 text-muted text-center">
                <span class="spinner-border spinner-border-sm me-2"></span> Loading...
            </div>
        </div>
    </div>
</div>


<div class="modal fade" id="addConfigModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title"><i class="bi bi-plus-circle me-2"></i>Add Config Entry</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <div class="mb-3">
                    <label class="form-label fw-semibold">Config Key</label>
                    <input type="text" id="newConfigKey" class="form-control" placeholder="e.g. WherebyApiKey" />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Config Value</label>
                    <textarea id="newConfigValue" class="form-control font-monospace" rows="3" placeholder="Value..."></textarea>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Meeting Creation URL <span class="text-muted small">(optional)</span></label>
                    <input type="text" id="newMeetingUrl" class="form-control" placeholder="https://api.whereby.dev/v1/meetings" />
                </div>
                <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" id="newIsActive" checked />
                    <label class="form-check-label fw-semibold" for="newIsActive">Active</label>
                </div>
            </div>
            <div class="modal-footer border-0 bg-light">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button asp-permission="SETTINGS.VIDEOCONFIG:ADD" type="button" class="btn btn-primary" id="btnSaveNewConfig">
                    <i class="bi bi-plus-lg me-1"></i>Add
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script src="~/js/views/VideoConfig/Index.js" asp-append-version="true"></script>
}
