@model IEnumerable<EMR.Web.Models.ViewModels.WardListItemViewModel>
@{
    ViewData["Title"] = "Ward Master";
    var total = Model.Count();
    var active = Model.Count(x => x.IsActive);
    var inactive = total - active;
    var totalCapacity = Model.Sum(x => x.Capacity);
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h1 class="h3 mb-0 fw-bold">Ward Master</h1>
        <small class="text-muted">Manage hospital inpatient wards, bed capacities, isolation units, and floor mappings</small>
    </div>
    <div class="d-flex gap-2">
        <a asp-controller="NursingStations" asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-person-workspace me-1"></i>Nursing Stations
        </a>
        <a asp-action="Create" asp-route-floorId="@ViewBag.FloorId" asp-route-departmentId="@ViewBag.DepartmentId" class="btn btn-primary shadow-sm">
            <i class="bi bi-plus-lg me-1"></i>Add Ward
        </a>
    </div>
</div>

<!-- Stat Cards -->
<div class="row g-3 mb-4">
    <div class="col-12 col-sm-6 col-lg-3">
        <div class="stat-card stat-blue">
            <div class="stat-icon"><i class="bi bi-hospital"></i></div>
            <div>
                <div class="stat-value">@total</div>
                <div class="stat-label">Total Wards</div>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-lg-3">
        <div class="stat-card stat-green">
            <div class="stat-icon"><i class="bi bi-check-circle-fill"></i></div>
            <div>
                <div class="stat-value">@active</div>
                <div class="stat-label">Active Wards</div>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-lg-3">
        <div class="stat-card stat-red">
            <div class="stat-icon"><i class="bi bi-x-circle-fill"></i></div>
            <div>
                <div class="stat-value">@inactive</div>
                <div class="stat-label">Inactive</div>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-lg-3">
        <div class="stat-card stat-cyan">
            <div class="stat-icon"><i class="bi bi-heart-pulse-fill"></i></div>
            <div>
                <div class="stat-value">@totalCapacity</div>
                <div class="stat-label">Total Bed Capacity</div>
            </div>
        </div>
    </div>
</div>

<!-- Filter Bar -->
<div class="card border-0 shadow-sm rounded-3 mb-4">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-auto">
                <label class="form-label mb-0 fw-semibold text-muted small"><i class="bi bi-funnel me-1"></i>Filters:</label>
            </div>
            <div class="col-md-3">
                <select name="floorId" class="form-select form-select-sm" onchange="this.form.submit()">
                    <option value="">-- All Floors --</option>
                    @if (ViewBag.FloorOptions != null)
                    {
                        foreach (var opt in (IEnumerable<SelectListItem>)ViewBag.FloorOptions)
                        {
                            <option value="@opt.Value" selected="@(opt.Value == (ViewBag.FloorId?.ToString()))">@opt.Text</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-3">
                <select name="departmentId" class="form-select form-select-sm" onchange="this.form.submit()">
                    <option value="">-- All IPD Departments --</option>
                    @if (ViewBag.DepartmentOptions != null)
                    {
                        foreach (var opt in (IEnumerable<SelectListItem>)ViewBag.DepartmentOptions)
                        {
                            <option value="@opt.Value" selected="@(opt.Value == (ViewBag.DepartmentId?.ToString()))">@opt.Text</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-3">
                <select name="wardType" class="form-select form-select-sm" onchange="this.form.submit()">
                    <option value="">-- All Ward Types --</option>
                    @if (ViewBag.WardTypeOptions != null)
                    {
                        foreach (var opt in (IEnumerable<SelectListItem>)ViewBag.WardTypeOptions)
                        {
                            <option value="@opt.Value" selected="@(opt.Value == (ViewBag.WardType?.ToString()))">@opt.Text</option>
                        }
                    }
                </select>
            </div>
            @if (ViewBag.FloorId != null || ViewBag.DepartmentId != null || !string.IsNullOrWhiteSpace(ViewBag.WardType?.ToString()))
            {
                <div class="col-auto">
                    <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Clear Filters</a>
                </div>
            }
        </form>
    </div>
</div>

<!-- Data Table -->
<div class="dashboard-panel table-responsive shadow-sm border rounded-3 bg-white">
    <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
            <tr>
                <th style="width: 50px;">#</th>
                <th>Ward Code</th>
                <th>Ward Name</th>
                <th>Floor / Location</th>
                <th>Department</th>
                <th>Ward Type</th>
                <th>Gender</th>
                <th>Capacity</th>
                <th>Status</th>
                <th class="text-end" style="width: 140px;">Actions</th>
            </tr>
        </thead>
        <tbody>
            @{int i = 1;}
            @foreach (var item in Model)
            {
                <tr>
                    <td class="text-muted small">@(i++)</td>
                    <td>
                        <span class="badge text-bg-light border text-dark font-monospace fs-6">
                            @item.WardCode
                        </span>
                    </td>
                    <td class="fw-semibold">
                        <i class="bi bi-hospital text-primary me-2"></i>@item.WardName
                        @if (item.IsIsolationWard)
                        {
                            <span class="badge bg-warning bg-opacity-10 text-dark border border-warning ms-1" title="Isolation Ward">
                                <i class="bi bi-shield-shaded me-1"></i>Isolation
                            </span>
                        }
                    </td>
                    <td>
                        <span class="badge bg-secondary bg-opacity-10 text-dark border">
                            <i class="bi bi-layers me-1"></i>@item.FloorName
                        </span>
                        @if (!string.IsNullOrWhiteSpace(item.BuildingName))
                        {
                            <small class="text-muted d-block">@item.BuildingName</small>
                        }
                    </td>
                    <td>
                        <span class="text-dark small">@item.DepartmentName</span>
                    </td>
                    <td>
                        <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 px-2 py-1">
                            @item.WardType
                        </span>
                    </td>
                    <td class="small text-muted">@item.Gender</td>
                    <td>
                        <span class="fw-bold text-dark fs-6">@item.Capacity Beds</span>
                        @if (item.TotalNursingStations > 0)
                        {
                            <a asp-controller="NursingStations" asp-action="Index" asp-route-wardId="@item.WardId" class="badge bg-info bg-opacity-10 text-info text-decoration-none d-block mt-1">
                                @item.TotalNursingStations Stations
                            </a>
                        }
                    </td>
                    <td>
                        @if (item.IsActive)
                        {
                            <span class="badge text-bg-success">Active</span>
                        }
                        else
                        {
                            <span class="badge text-bg-secondary">Inactive</span>
                        }
                    </td>
                    <td class="text-end">
                        <a asp-action="Details" asp-route-id="@item.WardId"
                           class="btn btn-sm btn-outline-secondary me-1" title="View Details">
                            <i class="bi bi-eye"></i>
                        </a>
                        <a asp-action="Edit" asp-route-id="@item.WardId"
                           class="btn btn-sm btn-outline-primary me-1" title="Edit">
                            <i class="bi bi-pencil"></i>
                        </a>
                        <form asp-action="Delete" asp-route-id="@item.WardId" method="post" class="d-inline"
                              onsubmit="return confirm('Are you sure you want to delete @item.WardName?');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete">
                                <i class="bi bi-trash"></i>
                            </button>
                        </form>
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="10" class="text-center text-muted py-5">
                        <i class="bi bi-hospital fs-1 d-block mb-2 opacity-50"></i>
                        No wards found. <a asp-action="Create" class="fw-bold">Add your first ward.</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
