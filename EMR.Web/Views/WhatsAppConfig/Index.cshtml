@model EMR.Web.Models.ViewModels.WhatsAppConfigViewModel
@{
    ViewData["Title"] = "WhatsApp Configuration";
}

@section HeadStyles {
    <style>
        .wa-hero-card {
            background: linear-gradient(135deg, #075e54 0%, #128c7e 50%, #25d366 100%);
            border-radius: 16px;
            padding: 2rem 2.5rem;
            color: #ffffff;
            box-shadow: 0 10px 30px rgba(18, 140, 126, 0.2);
            position: relative;
            overflow: hidden;
            border: none;
        }

        .wa-hero-card::after {
            content: '';
            position: absolute;
            right: -5%;
            top: -20%;
            width: 350px;
            height: 350px;
            background: radial-gradient(circle, rgba(255,255,255,0.12) 0%, rgba(255,255,255,0) 70%);
            border-radius: 50%;
            pointer-events: none;
        }

        .wa-icon-box {
            width: 52px;
            height: 52px;
            background: rgba(255, 255, 255, 0.2);
            backdrop-filter: blur(8px);
            border: 1px solid rgba(255, 255, 255, 0.3);
            border-radius: 14px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 1.8rem;
            color: #ffffff;
        }

        .config-card {
            background: #ffffff;
            border: 1px solid #e2e8f0;
            border-radius: 16px;
            box-shadow: 0 4px 18px rgba(15, 23, 42, 0.04);
            margin-bottom: 1.5rem;
            overflow: hidden;
        }

        .config-card-header {
            padding: 1.25rem 1.5rem;
            background: #f8fafc;
            border-bottom: 1px solid #e2e8f0;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .config-card-header h5 {
            margin: 0;
            font-size: 1.05rem;
            font-weight: 700;
            color: #0f172a;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .config-card-body {
            padding: 1.5rem;
        }

        .tag-chip {
            background: #e0f2fe;
            color: #0369a1;
            border: 1px solid #bae6fd;
            border-radius: 6px;
            font-size: 0.78rem;
            font-weight: 600;
            padding: 0.2rem 0.5rem;
            cursor: pointer;
            transition: all 0.15s;
            display: inline-block;
            margin: 2px;
        }

        .tag-chip:hover {
            background: #0284c7;
            color: #ffffff;
            border-color: #0284c7;
        }

        .test-widget-card {
            background: #f0fdf4;
            border: 1px solid #bbf7d0;
            border-radius: 16px;
            padding: 1.5rem;
            margin-bottom: 1.5rem;
        }
    </style>
}

<div class="container-fluid px-4 py-3">

    @* Hero Banner *@
    <div class="wa-hero-card mb-4">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 position-relative" style="z-index: 1;">
            <div>
                <div class="d-flex align-items-center gap-3 mb-2">
                    <div class="wa-icon-box"><i class="bi bi-whatsapp"></i></div>
                    <div>
                        <h1 class="h3 fw-bold mb-0">WhatsApp Notification Configuration</h1>
                        <p class="mb-0 opacity-90 small">Automate patient WhatsApp messages for OPD &amp; LAB bills via WaSender API</p>
                    </div>
                </div>
            </div>
            <div class="d-flex align-items-center gap-2">
                <span class="badge bg-white bg-opacity-25 border border-white border-opacity-25 px-3 py-2 fs-6">
                    <i class="bi bi-geo-alt-fill me-1"></i>Branch: <strong>@Model.BranchName</strong>
                </span>
                @if (Model.IsEnabled)
                {
                    <span class="badge bg-success px-3 py-2 fs-6"><i class="bi bi-check-circle-fill me-1"></i>Active</span>
                }
                else
                {
                    <span class="badge bg-danger px-3 py-2 fs-6"><i class="bi bi-x-circle-fill me-1"></i>Disabled</span>
                }
                @if (Model.IsHOBranch)
                {
                    <button type="button" class="btn btn-warning px-3 py-2 fw-bold text-dark shadow-sm d-flex align-items-center gap-1" data-bs-toggle="modal" data-bs-target="#copyConfigModal" title="Copy configuration to target branches">
                        <i class="bi bi-copy"></i> Copy to Branch
                    </button>
                }
            </div>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row g-4">

        @* Left Column: Configuration Form *@
        <div class="col-12 col-lg-7">
            <form method="post" asp-action="Save">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="BranchId" />
                <input type="hidden" asp-for="BranchName" />

                <!-- API Credentials -->
                <div class="config-card">
                    <div class="config-card-header">
                        <h5><i class="bi bi-key-fill text-success"></i> WaSender API Credentials</h5>
                        <span class="badge bg-success-subtle text-success">REST API</span>
                    </div>
                    <div class="config-card-body">
                        <div class="row g-3">
                            <div class="col-12 col-md-6">
                                <label asp-for="ConfigName" class="form-label small fw-bold text-muted"></label>
                                <input asp-for="ConfigName" class="form-control" />
                                <span asp-validation-for="ConfigName" class="text-danger small"></span>
                            </div>

                            <div class="col-12 col-md-6">
                                <label asp-for="DefaultCountryCode" class="form-label small fw-bold text-muted"></label>
                                <input asp-for="DefaultCountryCode" class="form-control font-monospace" placeholder="+91" />
                                <small class="text-muted" style="font-size: 0.75rem;">Prefixed to 10-digit mobile numbers</small>
                            </div>

                            <div class="col-12">
                                <label asp-for="ApiUrl" class="form-label small fw-bold text-muted"></label>
                                <input asp-for="ApiUrl" class="form-control font-monospace" />
                                <span asp-validation-for="ApiUrl" class="text-danger small"></span>
                            </div>

                            <div class="col-12">
                                <label asp-for="ApiKey" class="form-label small fw-bold text-muted"></label>
                                <div class="input-group">
                                    <input asp-for="ApiKey" id="apiKeyInput" type="password" class="form-control font-monospace" placeholder="Paste your WaSender Bearer Token here..." />
                                    <button class="btn btn-outline-secondary" type="button" onclick="toggleTokenVisibility()">
                                        <i class="bi bi-eye" id="toggleTokenIcon"></i>
                                    </button>
                                </div>
                                <span asp-validation-for="ApiKey" class="text-danger small"></span>
                                <small class="text-muted" style="font-size: 0.75rem;">Bearer Token authenticated against wasenderapi.com</small>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Notification Triggers & Toggles -->
                <div class="config-card">
                    <div class="config-card-header">
                        <h5><i class="bi bi-toggles text-primary"></i> Notification Trigger Settings</h5>
                    </div>
                    <div class="config-card-body">
                        <div class="d-flex flex-column gap-3">
                            <div class="form-check form-switch p-0 d-flex justify-content-between align-items-center">
                                <div>
                                    <label class="form-check-label fw-bold text-dark d-block" for="IsEnabled">Master WhatsApp Service</label>
                                    <small class="text-muted">Master switch to globally enable or pause WhatsApp message dispatching</small>
                                </div>
                                <input class="form-check-input ms-3" type="checkbox" role="switch" asp-for="IsEnabled" style="width: 2.8em; height: 1.4em;" />
                            </div>
                            <hr class="my-1" />
                            <div class="form-check form-switch p-0 d-flex justify-content-between align-items-center">
                                <div>
                                    <label class="form-check-label fw-bold text-dark d-block" for="OpdNotificationEnabled">OPD Bill WhatsApp Notifications</label>
                                    <small class="text-muted">Automatically send WhatsApp message to patient when an OPD consultation bill is created</small>
                                </div>
                                <input class="form-check-input ms-3" type="checkbox" role="switch" asp-for="OpdNotificationEnabled" style="width: 2.8em; height: 1.4em;" />
                            </div>
                            <hr class="my-1" />
                            <div class="form-check form-switch p-0 d-flex justify-content-between align-items-center">
                                <div>
                                    <label class="form-check-label fw-bold text-dark d-block" for="LabNotificationEnabled">LAB Bill WhatsApp Notifications</label>
                                    <small class="text-muted">Automatically send WhatsApp message to patient when a Laboratory bill is created</small>
                                </div>
                                <input class="form-check-input ms-3" type="checkbox" role="switch" asp-for="LabNotificationEnabled" style="width: 2.8em; height: 1.4em;" />
                            </div>
                            <hr class="my-1" />
                            <div class="form-check form-switch p-0 d-flex justify-content-between align-items-center">
                                <div>
                                    <label class="form-check-label fw-bold text-dark d-block" for="VideoNotificationEnabled">Video Consultation WhatsApp Notifications</label>
                                    <small class="text-muted">Automatically send WhatsApp message to Patient and Doctor when a Video Consultation is booked</small>
                                </div>
                                <input class="form-check-input ms-3" type="checkbox" role="switch" asp-for="VideoNotificationEnabled" style="width: 2.8em; height: 1.4em;" />
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Message Templates -->
                <div class="config-card">
                    <div class="config-card-header">
                        <h5><i class="bi bi-chat-dots-fill text-indigo"></i> Message Templates &amp; Placeholders</h5>
                    </div>
                    <div class="config-card-body">
                        
                        <!-- OPD Template -->
                        <div class="mb-4">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <div>
                                    <label asp-for="OpdMessageTemplate" class="form-label small fw-bold text-dark mb-0">OPD Bill Message Template</label>
                                    <span class="badge bg-primary-subtle text-primary border ms-2"><i class="bi bi-paperclip me-1"></i>OPD Bill PDF is attached automatically</span>
                                </div>
                            </div>
                            <div class="mb-2">
                                <span class="small text-muted me-1">Click to insert:</span>
                                <span class="tag-chip" onclick="insertTag('OpdMessageTemplate', '{PatientName}')">{PatientName}</span>
                                <span class="tag-chip" onclick="insertTag('OpdMessageTemplate', '{HospitalName}')">{HospitalName}</span>
                                <span class="tag-chip" onclick="insertTag('OpdMessageTemplate', '{BillNo}')">{BillNo}</span>
                                <span class="tag-chip" onclick="insertTag('OpdMessageTemplate', '{TokenNo}')">{TokenNo}</span>
                                <span class="tag-chip" onclick="insertTag('OpdMessageTemplate', '{DoctorName}')">{DoctorName}</span>
                                <span class="tag-chip" onclick="insertTag('OpdMessageTemplate', '{Amount}')">{Amount}</span>
                            </div>
                            <textarea asp-for="OpdMessageTemplate" id="OpdMessageTemplate" rows="4" class="form-control font-monospace" style="font-size: 0.88rem;"></textarea>
                        </div>

                        <!-- LAB Template -->
                        <div>
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <div>
                                    <label asp-for="LabMessageTemplate" class="form-label small fw-bold text-dark mb-0">LAB Bill Message Template</label>
                                    <span class="badge bg-primary-subtle text-primary border ms-2"><i class="bi bi-paperclip me-1"></i>Lab Bill PDF is attached automatically</span>
                                </div>
                            </div>
                            <div class="mb-2">
                                <span class="small text-muted me-1">Click to insert:</span>
                                <span class="tag-chip" onclick="insertTag('LabMessageTemplate', '{PatientName}')">{PatientName}</span>
                                <span class="tag-chip" onclick="insertTag('LabMessageTemplate', '{HospitalName}')">{HospitalName}</span>
                                <span class="tag-chip" onclick="insertTag('LabMessageTemplate', '{BillNo}')">{BillNo}</span>
                                <span class="tag-chip" onclick="insertTag('LabMessageTemplate', '{TokenNo}')">{TokenNo}</span>
                                <span class="tag-chip" onclick="insertTag('LabMessageTemplate', '{Amount}')">{Amount}</span>
                            </div>
                            <textarea asp-for="LabMessageTemplate" id="LabMessageTemplate" rows="4" class="form-control font-monospace" style="font-size: 0.88rem;"></textarea>
                        </div>

                        <!-- Video Consultation Patient Template -->
                        <div class="mt-4">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <div>
                                    <label asp-for="VideoPatientMessageTemplate" class="form-label small fw-bold text-dark mb-0">Video Consultation Patient Message Template</label>
                                </div>
                            </div>
                            <div class="mb-2">
                                <span class="small text-muted me-1">Click to insert:</span>
                                <span class="tag-chip" onclick="insertTag('VideoPatientMessageTemplate', '{PatientName}')">{PatientName}</span>
                                <span class="tag-chip" onclick="insertTag('VideoPatientMessageTemplate', '{DoctorName}')">{DoctorName}</span>
                                <span class="tag-chip" onclick="insertTag('VideoPatientMessageTemplate', '{Date}')">{Date}</span>
                                <span class="tag-chip" onclick="insertTag('VideoPatientMessageTemplate', '{Time}')">{Time}</span>
                                <span class="tag-chip" onclick="insertTag('VideoPatientMessageTemplate', '{Link}')">{Link}</span>
                            </div>
                            <textarea asp-for="VideoPatientMessageTemplate" id="VideoPatientMessageTemplate" rows="4" class="form-control font-monospace" style="font-size: 0.88rem;"></textarea>
                        </div>

                        <!-- Video Consultation Doctor Template -->
                        <div class="mt-4">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <div>
                                    <label asp-for="VideoDoctorMessageTemplate" class="form-label small fw-bold text-dark mb-0">Video Consultation Doctor Message Template</label>
                                </div>
                            </div>
                            <div class="mb-2">
                                <span class="small text-muted me-1">Click to insert:</span>
                                <span class="tag-chip" onclick="insertTag('VideoDoctorMessageTemplate', '{DoctorName}')">{DoctorName}</span>
                                <span class="tag-chip" onclick="insertTag('VideoDoctorMessageTemplate', '{PatientName}')">{PatientName}</span>
                                <span class="tag-chip" onclick="insertTag('VideoDoctorMessageTemplate', '{Date}')">{Date}</span>
                                <span class="tag-chip" onclick="insertTag('VideoDoctorMessageTemplate', '{Time}')">{Time}</span>
                                <span class="tag-chip" onclick="insertTag('VideoDoctorMessageTemplate', '{Link}')">{Link}</span>
                            </div>
                            <textarea asp-for="VideoDoctorMessageTemplate" id="VideoDoctorMessageTemplate" rows="4" class="form-control font-monospace" style="font-size: 0.88rem;"></textarea>
                        </div>

                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 mb-4">
                    @if (Model.IsHOBranch)
                    {
                        <button type="button" class="btn btn-outline-warning px-4 py-2 fw-semibold shadow-sm text-dark" data-bs-toggle="modal" data-bs-target="#copyConfigModal">
                            <i class="bi bi-copy me-1"></i> Copy to Target Branch
                        </button>
                    }
                    <button type="submit" class="btn btn-success px-4 py-2 fw-semibold shadow-sm">
                        <i class="bi bi-save me-1"></i> Save Configuration
                    </button>
                </div>
            </form>
        </div>

        @* Right Column: Live Testing Widget & Logs *@
        <div class="col-12 col-lg-5">

            <!-- Live Test Widget -->
            <div class="test-widget-card">
                <div class="d-flex align-items-center gap-2 mb-3">
                    <div class="bg-success text-white rounded-circle p-2 d-flex align-items-center justify-content-center" style="width: 36px; height: 36px;">
                        <i class="bi bi-send-fill fs-6"></i>
                    </div>
                    <div>
                        <h5 class="mb-0 fw-bold text-success-emphasis">Send Test WhatsApp</h5>
                        <small class="text-muted">Verify live connectivity with WaSender API</small>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label small fw-bold text-dark">Recipient Mobile Number</label>
                    <input type="text" id="testPhone" class="form-control font-monospace" placeholder="+9007524092 or 9007524092" value="+9007524092" />
                    <small class="text-muted" style="font-size: 0.75rem;">Can be entered with or without country code.</small>
                </div>

                <div class="mb-3">
                    <label class="form-label small fw-bold text-dark">Test Message</label>
                    <textarea id="testMessage" rows="2" class="form-control" style="font-size: 0.88rem;">Hello from EMR! This is a test WhatsApp message verifying your configuration.</textarea>
                </div>

                <div class="d-grid">
                    <button type="button" id="btnSendTest" class="btn btn-success fw-semibold shadow-sm" onclick="sendTestWhatsApp()">
                        <i class="bi bi-whatsapp me-1"></i> Send Test Message
                    </button>
                </div>

                <!-- Test Result Alert -->
                <div id="testResultBox" class="mt-3" style="display: none;"></div>
            </div>

            <!-- Recent Message Logs -->
            <div class="config-card">
                <div class="config-card-header">
                    <h5><i class="bi bi-clock-history text-secondary"></i> Recent Message Logs</h5>
                    <button type="button" class="btn btn-sm btn-outline-secondary" onclick="location.reload();" title="Refresh Logs">
                        <i class="bi bi-arrow-clockwise"></i>
                    </button>
                </div>
                <div class="config-card-body p-0">
                    <div class="table-responsive" style="max-height: 480px; overflow-y: auto;">
                        <table class="table table-sm align-middle mb-0" style="font-size: 0.82rem;">
                            <thead class="table-light sticky-top">
                                <tr>
                                    <th>Time</th>
                                    <th>Module</th>
                                    <th>Recipient</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.RecentLogs != null && Model.RecentLogs.Any())
                                {
                                    foreach (var log in Model.RecentLogs)
                                    {
                                        <tr>
                                            <td>
                                                <div class="fw-semibold">@log.SentDate.ToString("hh:mm tt")</div>
                                                <small class="text-muted">@log.SentDate.ToString("dd MMM")</small>
                                            </td>
                                            <td>
                                                <span class="badge @(log.ModuleCode == "OPD" ? "bg-primary-subtle text-primary border" : log.ModuleCode == "LAB" ? "bg-info-subtle text-info border" : "bg-secondary-subtle text-secondary border")">
                                                    @log.ModuleCode
                                                </span>
                                            </td>
                                            <td>
                                                <div class="font-monospace fw-semibold">@log.RecipientPhone</div>
                                                <small class="text-truncate d-block text-muted" style="max-width: 140px;" title="@log.MessageText">
                                                    @log.MessageText
                                                </small>
                                            </td>
                                            <td>
                                                @if (log.IsSuccess)
                                                {
                                                    <span class="badge bg-success-subtle text-success border border-success-subtle">
                                                        <i class="bi bi-check2"></i> @(log.Status ?? "Sent")
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle" title="@log.ErrorMessage">
                                                        <i class="bi bi-x"></i> Failed
                                                    </span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="4" class="text-center py-4 text-muted">
                                            <i class="bi bi-inbox d-block mb-1 fs-5"></i>
                                            <span>No messages sent yet.</span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

        </div>

    </div>

</div>

@if (Model.IsHOBranch)
{
    <!-- Modal: Copy Configuration to Target Branch -->
    <div class="modal fade" id="copyConfigModal" tabindex="-1" aria-labelledby="copyConfigModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
                <form asp-action="CopyToBranch" method="post" id="copyConfigForm">
                    @Html.AntiForgeryToken()
                    <div class="modal-header bg-gradient bg-primary text-white px-4 py-3 border-0">
                        <div class="d-flex align-items-center gap-2">
                            <div class="bg-white bg-opacity-25 rounded-circle p-2 d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                                <i class="bi bi-copy fs-5 text-white"></i>
                            </div>
                            <div>
                                <h5 class="modal-title fw-bold mb-0" id="copyConfigModalLabel">Copy WhatsApp Configuration</h5>
                                <p class="text-white text-opacity-75 small mb-0">Replicate Head Office (HO) WhatsApp settings to target branches</p>
                            </div>
                        </div>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body p-4">
                        <div class="alert alert-info border-0 rounded-3 d-flex align-items-start gap-3 mb-4">
                            <i class="bi bi-info-circle-fill fs-4 text-info flex-shrink-0 mt-1"></i>
                            <div class="small">
                                <strong>Head Office Synchronization:</strong> You are copying the active WhatsApp configuration from <strong>@Model.BranchName (HO)</strong>. This will duplicate API credentials (API URL, Bearer Token, Country Code), module switches (OPD &amp; LAB), and message templates to the chosen target branch.
                            </div>
                        </div>

                        <!-- Target Branch Selector -->
                        <div class="mb-4">
                            <label class="form-label fw-bold text-dark">Target Branch <span class="text-danger">*</span></label>
                            <div class="mb-3">
                                <div class="form-check form-check-inline me-4">
                                    <input class="form-check-input" type="radio" name="copyScope" id="scopeSpecific" value="specific" checked onchange="toggleScope(false)">
                                    <label class="form-check-label fw-semibold" for="scopeSpecific">Specific Target Branch</label>
                                </div>
                                <div class="form-check form-check-inline">
                                    <input class="form-check-input" type="radio" name="copyScope" id="scopeAll" value="all" onchange="toggleScope(true)">
                                    <label class="form-check-label fw-semibold text-primary" for="scopeAll">All Other Branches</label>
                                </div>
                            </div>

                            <input type="hidden" name="copyToAll" id="copyToAllInput" value="false" />

                            <div id="targetBranchDropdownWrap">
                                <select name="targetBranchId" id="targetBranchSelect" class="form-select form-select-lg rounded-3 shadow-none" required>
                                    @if (Model.TargetBranches != null && Model.TargetBranches.Any())
                                    {
                                        <option value="">-- Select Target Branch --</option>
                                        @foreach (var tb in Model.TargetBranches)
                                        {
                                            <option value="@tb.Value">@tb.Text</option>
                                        }
                                    }
                                    else
                                    {
                                        <option value="" disabled>No other active branches available</option>
                                    }
                                </select>
                                <span class="text-danger small d-none" id="branchValidationMsg">Please select a target branch.</span>
                            </div>

                            <div id="allBranchesNotice" class="alert alert-warning border-0 rounded-3 py-2 px-3 small d-none mt-2">
                                <i class="bi bi-exclamation-triangle-fill me-1"></i> This will overwrite or create WhatsApp settings for <strong>all other active branches</strong> in the organization.
                            </div>
                        </div>

                        <!-- Preview of what will be copied -->
                        <div class="card bg-light border-0 rounded-3 p-3 mb-3">
                            <h6 class="fw-bold text-dark mb-2 small text-uppercase" style="letter-spacing: 0.5px;">Configuration Preview to be Copied:</h6>
                            <div class="row g-2 small text-muted">
                                <div class="col-sm-6">
                                    <div><i class="bi bi-check2 text-success me-1"></i><strong>API Endpoint:</strong> @Model.ApiUrl</div>
                                </div>
                                <div class="col-sm-6">
                                    <div><i class="bi bi-check2 text-success me-1"></i><strong>Country Code:</strong> @Model.DefaultCountryCode</div>
                                </div>
                                <div class="col-sm-6">
                                    <div><i class="bi bi-check2 text-success me-1"></i><strong>Bearer Token:</strong> @(string.IsNullOrEmpty(Model.ApiKey) ? "Not set" : "●●●●●●●●●●●● (Configured)")</div>
                                </div>
                                <div class="col-sm-6">
                                    <div><i class="bi bi-check2 text-success me-1"></i><strong>Notifications:</strong> OPD (@(Model.OpdNotificationEnabled ? "Enabled" : "Disabled")), LAB (@(Model.LabNotificationEnabled ? "Enabled" : "Disabled")), Video (@(Model.VideoNotificationEnabled ? "Enabled" : "Disabled"))</div>
                                </div>
                                <div class="col-12">
                                    <div><i class="bi bi-check2 text-success me-1"></i><strong>Message Templates:</strong> OPD Bill, LAB Bill, and Video Consultation templates</div>
                                </div>
                            </div>
                        </div>

                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="confirmOverwrite" required>
                            <label class="form-check-label small text-secondary" for="confirmOverwrite">
                                I understand that this will overwrite any existing WhatsApp configuration in the target branch(es).
                            </label>
                        </div>
                    </div>
                    <div class="modal-footer bg-light px-4 py-3 border-top-0">
                        <button type="button" class="btn btn-secondary px-3" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary px-4 fw-semibold" id="btnConfirmCopy">
                            <i class="bi bi-copy me-1"></i> Confirm &amp; Copy Configuration
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        function toggleScope(isAll) {
            document.getElementById('copyToAllInput').value = isAll ? 'true' : 'false';
            const ddWrap = document.getElementById('targetBranchDropdownWrap');
            const allNotice = document.getElementById('allBranchesNotice');
            const select = document.getElementById('targetBranchSelect');
            
            if (isAll) {
                ddWrap.classList.add('d-none');
                allNotice.classList.remove('d-none');
                select.removeAttribute('required');
            } else {
                ddWrap.classList.remove('d-none');
                allNotice.classList.add('d-none');
                select.setAttribute('required', 'required');
            }
        }

        document.getElementById('copyConfigForm')?.addEventListener('submit', function(e) {
            const isAll = document.getElementById('copyToAllInput').value === 'true';
            const select = document.getElementById('targetBranchSelect');
            const valMsg = document.getElementById('branchValidationMsg');
            
            if (!isAll && (!select.value || select.value === '')) {
                e.preventDefault();
                valMsg.classList.remove('d-none');
                select.focus();
                return false;
            }
            valMsg?.classList.add('d-none');
        });

        function toggleTokenVisibility() {
            var input = document.getElementById('apiKeyInput');
            var icon = document.getElementById('toggleTokenIcon');
            if (input.type === 'password') {
                input.type = 'text';
                icon.classList.remove('bi-eye');
                icon.classList.add('bi-eye-slash');
            } else {
                input.type = 'password';
                icon.classList.remove('bi-eye-slash');
                icon.classList.add('bi-eye');
            }
        }

        function insertTag(textareaId, tag) {
            var textarea = document.getElementById(textareaId);
            var start = textarea.selectionStart;
            var end = textarea.selectionEnd;
            var text = textarea.value;
            textarea.value = text.substring(0, start) + tag + text.substring(end);
            textarea.focus();
            textarea.selectionEnd = start + tag.length;
        }

        async function sendTestWhatsApp() {
            var phone = document.getElementById('testPhone').value.trim();
            var message = document.getElementById('testMessage').value.trim();
            var resultBox = document.getElementById('testResultBox');
            var btn = document.getElementById('btnSendTest');

            if (!phone) {
                alert('Please enter a recipient phone number.');
                return;
            }

            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span> Sending...';
            resultBox.style.display = 'none';

            try {
                var response = await fetch('/WhatsAppConfig/SendTestMessage', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({
                        toPhone: phone,
                        messageText: message
                    })
                });

                var res = await response.json();
                resultBox.style.display = 'block';

                if (res.success) {
                    resultBox.className = 'alert alert-success mt-3 p-3 rounded-3';
                    resultBox.innerHTML = '<strong><i class="bi bi-check-circle-fill me-1"></i> Success!</strong> ' + res.message +
                        '<div class="mt-1 small font-monospace">MsgID: ' + (res.msgId || 'N/A') + ' | Status: ' + (res.status || 'in_progress') + '</div>';
                } else {
                    resultBox.className = 'alert alert-danger mt-3 p-3 rounded-3';
                    resultBox.innerHTML = '<strong><i class="bi bi-x-circle-fill me-1"></i> Failed:</strong> ' + res.message;
                }
            } catch (err) {
                resultBox.style.display = 'block';
                resultBox.className = 'alert alert-danger mt-3 p-3 rounded-3';
                resultBox.innerHTML = '<strong>Error:</strong> ' + err.message;
            } finally {
                btn.disabled = false;
                btn.innerHTML = '<i class="bi bi-whatsapp me-1"></i> Send Test Message';
            }
        }
    </script>
}
