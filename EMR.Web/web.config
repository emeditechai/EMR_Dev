<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- IIS: allow uploads up to 300 MB (Hospital Settings > App (APK) Upload, SQLScripts/2393). IIS refuses larger
       request bodies (its default is about 30 MB) before ASP.NET Core sees them; each action keeps its own lower limit. -->
  <system.webServer>
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="315621376" />
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
