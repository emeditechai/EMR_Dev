#!/bin/sh
# Data dictionary auto-refresh (installed by Tools/datadictionary/install_hooks.sh).
# After a commit that touches SQLScripts/ or Tools/datadictionary/, re-reads the database schema and, when the
# data dictionary changed, commits the refreshed Docs/DataDictionary in a follow-up commit.
# Skip once with:  DD_SKIP=1 git commit ...
[ -n "$DD_HOOK_RUNNING" ] && exit 0
[ -n "$DD_SKIP" ] && exit 0
ROOT=$(git rev-parse --show-toplevel) || exit 0
cd "$ROOT" || exit 0
[ -f Tools/datadictionary/update_data_dictionary.py ] || exit 0
git diff-tree --no-commit-id --name-only -r HEAD | grep -qE '^(SQLScripts/|Tools/datadictionary/)' || exit 0

echo "data dictionary: checking the database schema ..."
# First Python that has the updater's packages (pymssql, python-docx, Pillow); set DD_PYTHON to force one.
PY=""
for p in "$DD_PYTHON" "$(command -v python3)" /usr/local/bin/python3 /opt/homebrew/bin/python3 \
         /Library/Frameworks/Python.framework/Versions/Current/bin/python3 /usr/bin/python3 "$(command -v python)"; do
    [ -n "$p" ] && [ -x "$p" ] && "$p" -c "import pymssql, docx, PIL" 2>/dev/null && { PY="$p"; break; }
done
[ -n "$PY" ] || { echo "data dictionary: no Python with pymssql, python-docx and Pillow found (pip install -r Tools/datadictionary/requirements.txt); not refreshed."; exit 0; }
"$PY" Tools/datadictionary/update_data_dictionary.py --quiet || { echo "data dictionary: not refreshed (see message above)."; exit 0; }

git add Docs/DataDictionary
if ! git diff --cached --quiet -- Docs/DataDictionary; then
    DD_HOOK_RUNNING=1 git -c user.name="$(git log -1 --format=%an)" -c user.email="$(git log -1 --format=%ae)" \
        commit --no-verify -q -m "Docs: data dictionary refreshed (auto)" -- Docs/DataDictionary \
        && echo "data dictionary: refreshed and committed."
fi
exit 0
